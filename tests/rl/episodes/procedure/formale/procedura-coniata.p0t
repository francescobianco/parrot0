# id:        procedure/formale/procedura-coniata
# famiglia:  procedure
# dominio:   formale / matematica
# gradino:   1
# vettore:   profondita 2  distanza 1  ambiguita 0  composizione 2
#            rumore 0  apertura 0  novita 3
# lavoro:    imparare nel dialogo una procedura mai vista e applicarla a un
#            numero che non e' quello dell'esempio
# difficile: la procedura ha due passi ordinati; farli in ordine inverso da' un
#            risultato plausibile ma sbagliato (5*3+1 = 16, (5+1)*3 = 18)
# origine:   sonda gen412
# verifica:  V2 (il numero giusto) + V4 (mai il numero dell'ordine sbagliato)

[test impara la procedura e la applica]
!set PARROT0_SESSION=
!reset
> to zibble a number means to multiply it by 3 and then add 1
> zibble 5
<~ 16

# V4 — l'ordine dei passi non e' un dettaglio: 18 e' la risposta di chi ha
# capito le operazioni e non la sequenza.
[test non inverte i due passi]
<! 18

[test la procedura vale anche su un altro numero]
> zibble 10
<~ 31
