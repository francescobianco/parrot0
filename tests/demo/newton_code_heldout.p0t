[mock live]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_PROFILE=kb/profiles/agi.p0
!set PARROT0_LANG=en
!reset

[test r01]
!timeout 15
> Write a Python script to calculate force using Newton's second law
<~ def force
[test r02]
!timeout 15
> Could you show me how to implement Newton's second law in Python?
<~ def force
