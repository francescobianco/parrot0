# Migrated from tests/research_learn.sh.
# The fixture is local and disposable; the expected responses intentionally keep
# the known historical assertions from the shell regression.

[test research_learn]
!exec rm -f kb/learning/pages/foo.md learned.p0
!exec sh -c 'printf "%s\n" "# Foo" "" "- Domain: \`testing\`" "" "## Learned Concept" "" "small deterministic test concept" "" "## Extract" "" "Foo is a fixture used by the parrot0 research learner test." > kb/learning/pages/foo.md'
!set PARROT0_BASE=
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=0
!set PARROT0_PROFILE=
!set PARROT0_LANG=en
!set PARROT0_WIKI_DIR=
!set PARROT0_LEARN_KB=learned.p0
!reset

> tell me about foo
< I didn't know about foo, so I just read it up: small deterministic test concept.
> tell me about foo
< foo is small deterministic test concept.
!filehas learned.p0 wiki_concept(foo, testing, "small deterministic test concept").
!exec sh -c 'test "$(grep -c "wiki_concept(foo," learned.p0)" = "1"'
!exec rm -f kb/learning/pages/foo.md learned.p0
