# Focused KB-first round eleven ratchets.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

[test lexical_strong_sequencer_is_kb]
!query strong_sequencer("and then")
!assert strong_sequencer("zorp next")
!query strong_sequencer("zorp next")
!forget strong_sequencer("zorp next")
!query! strong_sequencer("zorp next")

[test lexical_clause_filler_is_kb]
!query clause_filler(please)
!assert clause_filler(zorpfill)
!query clause_filler(zorpfill)
!forget clause_filler(zorpfill)
!query! clause_filler(zorpfill)

[test domain_adapter_invention]
!query domain_relation(invention, invented_object)
!forget domain_relation(invention, invented_object)
!query! domain_relation(invention, invented_object)
!assert domain_relation(invention, invented_object)

[test voice_composed_with_caveat]
!query response_template(composed_with_caveat, "I composed `{name}` but {note}.")

[test semantic_family_rename]
!query response_template(steps_shape_learned, _)
!query! response_template(learned_those_steps_describe_the_x_structure, _)
