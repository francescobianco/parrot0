# Audit conversazionale costruttivo (sostituisce i casi utente ad alto valore
# di basicchat.sh). Le shell legacy restano solo adapter di misura; il
# comportamento riproducibile vive qui, nel test-engine .p0t.

[mock live]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_LANG=it
!reset

[dialogo italiano — nessun muro sui casi di ingresso]
> ti piacciono gli scacchi?
<~ preferenze personali
<~ conosco scacchi
<~ giocatori
<~ scacco
<~ insieme
> ti piace la dama?
<~ conosco dama
<~ pedine
<~ obbligatoria
<~ insieme
> come si gioca a scacchi?
<~ giocatori
<~ mossa legale
<~ scacco
> cosa sai degli scacchi?
<~ scacchi
> come stai?
<~ parrot0
> che cosa possiamo fare insieme?
<~ insieme
> che ne pensi?
<~ opinioni personali

[conoscenza trasferibile fra lingue]
!set PARROT0_LANG=en
!reset
> what do you know about chess?
<~ chess
> what is pi?
<~ 3.14159
> what causes the seasons?
<~ tilt
> what do you think?
<~ personal opinions
> make a plan to learn chess
<~ My derived plan for chess learning
<~ [wikipedia]

[forma insegnata: un atto, tre usi successivi]
!reset
> what is your designation
<~ don't know
> teach "what is your designation" as ask my name
<~ Got it
> what is your designation
<~ name
> what is your designation
<~ name

[forma ritratta: l'ablazione riapre il limite]
!forget intent_phrase(ask_name, "what is your designation")
> what is your designation
<~ don't understand

[operatore di piano insegnato a runtime]
!reset
> teach "build me a roadmap" as a plan request
<~ Got it
> build me a roadmap to learn chess
<~ chess learning
<~ wikipedia
<~ cost 1
!forget intent_cue(plan_request, "build me a roadmap")
> build me a roadmap to learn chess
<~ don't understand

[continuità del goal fra turni]
!reset
> fai un piano
<~ obiettivo
> imparare gli scacchi
<~ piano derivato
<~ wikipedia

[piano di compensazione]
!reset
> fai un piano per compensare un passo mancante
<~ compensation recovery
<~ costo totale 4
<~ wikipedia

[tre campagne di trasferimento dialogico]
!reset
> teach "let's team up" as a collaboration offer
<~ Got it
> let's team up
<~ question
> teach "your take" as an opinion request
<~ Got it
> your take
<~ personal opinions
!forget intent_cue(collaboration_offer, "lets team up")
!forget intent_cue(opinion_request, "your take")
> lets team up
<~ don't understand
> your take
<~ don't understand
