# L'emettitore e' guidato dalla KB: nel C non c'e' piu' nessun corpo di funzione.
#
# Prima `code_synth_from_shape` era una catena di strcmp con il corpo scritto
# come stringa C dentro src/code.c: un solo caso dopo quattro generazioni, e
# ogni algoritmo nuovo costava una generazione di C.
#
# Ora l'ALGORITMO (code_shape_step/code_shape_slot) e la LINGUA (lang_syntax)
# sono due conoscenze separate, e il C fa solo la meccanica: risolvi i figli,
# ordinali, sostituisci gli slot, annida le graffe.
# Disegno: docs/plans/kb-code-emitter.md
#
# ⭐ La prova che conta e' la SECONDA forma: `sum_over_array` e' dichiarata solo
# in kb/experts/programming/code_shapes.p0, e non e' costata una riga di C.

[test emitter_from_kb]
!sandbox
!timeout 30

# La forma che PRIMA era il template letterale, ora ri-derivata dalla KB.
!mcp code.synth_shape {"shape":"nested_loop_compare_swap","name":"mysort"}
!expect mcp void mysort(int a[], int n) { for (int i = 0; i < n; i++) { for (int j = 0; j + 1 < n - i; j++) { if (a[j] > a[j + 1]) { int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; } } } }

# …e cio' che ha emesso lo dispone l'ORACOLO, non noi: ordinato E permutazione.
!mcp code.check_sort {"source":"void mysort(int a[], int n) { for (int i = 0; i < n; i++) { for (int j = 0; j + 1 < n - i; j++) { if (a[j] > a[j + 1]) { int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; } } } }","function":"mysort"}
!expect mcp "verdict":1

# Il legame {cmp} arriva davvero fino allo slot: col verso opposto la stessa
# forma emette il decrescente, e l'oracolo del crescente lo RIFIUTA.
!mcp code.synth_shape {"shape":"nested_loop_compare_swap","name":"mysort","comparator":"<"}
!expect mcp if (a[j] < a[j + 1])

!mcp code.check_sort {"source":"void mysort(int a[], int n) { for (int i = 0; i < n; i++) { for (int j = 0; j + 1 < n - i; j++) { if (a[j] < a[j + 1]) { int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; } } } }","function":"mysort"}
!expect mcp "verdict":0

# ⭐ Una forma NUOVA, dichiarata solo in KB, con tre operazioni nuove che sono
# una riga di lang_syntax ciascuna. Zero righe di C.
!mcp code.synth_shape {"shape":"sum_over_array","name":"total"}
!expect mcp int total(int a[], int n) { int s = 0; for (int i = 0; i < n; i++) { s = s + a[i]; } return s; }

# Una forma non dichiarata non si inventa.
!mcp code.synth_shape {"shape":"no_such_shape","name":"x"}
!expect mcp "error"

# ── M3: le operazioni che servono a soddisfare un CONTRATTO ─────────────────
# Allocare, controllare il trabocco PRIMA di allocare, copiare, terminare.
# La forma `concat_two` e' l'algoritmo da manuale e non e' il compito di nessun
# banco: la si dichiara per avere le operazioni, non per avere una risposta.
!mcp code.synth_shape {"shape":"concat_two","name":"concat"}
!expect mcp char *concat(const char *a, const char *b) { size_t la = strlen(a); size_t lb = strlen(b); if (la > (size_t)-1 - lb - 1) { return NULL; } char *out = malloc(la + lb + 1); if (out == NULL) { return NULL; } memcpy(out, a, la); memcpy(out + la, b, lb); out[la + lb] = 0; return out; }

# E qui non si crede alla stringa: la si COMPILA con le stesse bandiere che un
# compito reale pretende, e la si ESEGUE. Il testo e' lo stesso che l'emettitore
# ha appena prodotto — se cambia, l'asserzione qui sopra cade per prima.
!exec rm -rf /tmp/p0t-emit && mkdir -p /tmp/p0t-emit
!exec printf '#include <stdlib.h>\n#include <string.h>\nchar *concat(const char *a, const char *b) { size_t la = strlen(a); size_t lb = strlen(b); if (la > (size_t)-1 - lb - 1) { return NULL; } char *out = malloc(la + lb + 1); if (out == NULL) { return NULL; } memcpy(out, a, la); memcpy(out + la, b, lb); out[la + lb] = 0; return out; }\n' > /tmp/p0t-emit/concat.c
!exec printf '#include <stdio.h>\n#include <string.h>\n#include <stdlib.h>\nchar *concat(const char *a, const char *b);\nint main(void){ char *r = concat("ab","cde"); if(!r) return 1; int ok = strcmp(r,"abcde")==0; free(r); return !ok; }\n' > /tmp/p0t-emit/main.c
!exec cc -std=c11 -Wall -Wextra -Werror -O2 -o /tmp/p0t-emit/t /tmp/p0t-emit/concat.c /tmp/p0t-emit/main.c
!exec /tmp/p0t-emit/t
!exec rm -rf /tmp/p0t-emit

!sandbox off

# ── M5: LA SECONDA LINGUA, che serviva a FALSIFICARE il taglio ─────────────
# La stessa forma `sum_over_array` — lo stesso albero di passi, gli stessi slot,
# non toccati — resa in Python. Il conto che il piano si era impegnato a
# rispettare: una lingua nuova costa UNA RIGA PER OPERAZIONE.
#
# ⭐ E la falsificazione ha trovato una riga sbagliata, che e' il suo mestiere:
# le graffe erano scritte nel C e chiamate «meccanica». Non lo sono — un blocco
# si segna con due parentesi o con un rientro, e quale delle due e' una
# proprieta' della LINGUA (`lang_block/3`, `lang_layout/2`).
!mcp code.synth_shape {"shape":"sum_over_array","name":"total","lang":"python"}
!expect mcp def total(a):

# E anche qui non si crede alla stringa: la si ESEGUE.
!exec rm -rf /tmp/p0t-emit-py && mkdir -p /tmp/p0t-emit-py
!exec printf 'def total(a):\n    s = 0\n    for i in range(0, len(a)):\n        s = s + a[i]\n    return s\nassert total([1,2,3,4]) == 10\n' > /tmp/p0t-emit-py/t.py
!exec python3 /tmp/p0t-emit-py/t.py
!exec rm -rf /tmp/p0t-emit-py
