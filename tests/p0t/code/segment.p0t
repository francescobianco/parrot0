# Migrated from tests/segment.sh (gen330).
# The executable assertions deliberately keep the original compiler-claim
# predicate: an honest ambiguity is not itself a syntax finding.

[test harness]
!exec sh -c 'got=$(printf "%s\n" "fix this code: int f(int x) { return x }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); test -n "$got"'

[test correct_code_no_false_positives]
!exec sh -c 'got=$(printf "%s\n" "fix this code: int absval(int x) { if (x < 0) { return -x; } return x; } It should return the absolute value but it returns a negative number for x = -5" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int absval(int x) { if (x < 0) { return -x; } return x; } The expected output is 5 for x = -5" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "what is wrong with this: int absval(int x) { if (x < 0) { return -x; } return x; } it gives the wrong answer on negatives" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "what is wrong with this code: int add(int a, int b) { return a + b; } it should add but the result is off by one" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int add(int a, int b) { return a + b; } Expected: add(2,3) = 5. Observed: 6." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } the sum of 1..n is wrong for n = 0" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "can you fix this: int absval(int x) { if (x < 0) { return -x; } return x; } it must handle INT_MIN as well" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "please fix this code: int add(int a, int b) { return a + b; } without using recursion" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "sistema questo codice: int absval(int x) { if (x < 0) { return -x; } return x; } Dovrebbe restituire il valore assoluto ma per x = -5 restituisce un numero negativo" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "correggi questo codice: int add(int a, int b) { return a + b; } Il risultato atteso e 5 ma ottengo 6" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "cosa c'\''e che non va in questo codice: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } la somma e sbagliata per n = 0" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "sistema questo codice: int add(int a, int b) { return a + b; } senza usare la ricorsione" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int absval(int x) { if (x < 0) { return -x; } return x; } This is used in a hot loop, so it must not allocate." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int add(int a, int b) { return a + b; } Note: the caller passes negative values too." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "what is wrong with this: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } It should return 15 for n = 5. It returns 10." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int absval(int x) { if (x < 0) { return -x; } return x; } The bug appeared after we changed the sign handling." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int add(int a, int b) { return a + b; } It works for positive numbers. It fails for zero." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "what is wrong with this: int absval(int x) { if (x < 0) { return -x; } return x; } Constraint: do not use the abs() function." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } Expected 15, got 10, for n = 5. Do not change the signature." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "correggi questo codice: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } Deve restituire 15 per n = 5, invece restituisce 10." | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'

[test broken_code_true_positives]
!exec sh -c 'got=$(printf "%s\n" "fix this code: int f(int x) { return x }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int g(void) { int y = 1 return y; }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "what is wrong with this: int x = 5" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int h(int a) { if (a > 0 { return 1; } return 0; }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int f(int x) { return x } It should return x but it does not compile" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'

[test ambiguity]
!exec sh -c 'got=$(printf "%s\n" "fix this code: int f(int x) { if (x) { return 1; }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -q "ambiguous_input"'
!exec sh -c 'got=$(printf "%s\n" "fix this code: int f(int x) { if (x) { return 1; }" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); ! printf "%s" "$got" | grep -qiE "semicolon|unclosed string|unbalanced|paren|compiler rejects|issue found"'

[test code_span]
!exec sh -c 'got=$(printf "%s\n" "explain what this does: int sum(int n) { int s = 0; for (int i = 1; i <= n; i++) { s += i; } return s; } It should return 15 for n = 5" | PARROT0_SESSION= ./bin/parrot0 2>/dev/null); printf "%s" "$got" | grep -qiE "loop|return|C code"'
