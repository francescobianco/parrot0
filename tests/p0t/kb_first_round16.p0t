# Focused KB-first round sixteen: symbolic and code vocabularies are teachable.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=0
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

!query solfege_note(do)
!query code_keyword(python, while)
!query code_keyword(c, int)
!query code_pattern(c, return_statement, "return ")
!query code_pattern(c, int_assignment, "int ")
!query code_pattern(c, char_pointer_assignment, "char *")
!assert code_pattern(c, taught_assignment, "widget ")
!query code_pattern(c, taught_assignment, "widget ")
!forget code_pattern(c, taught_assignment, "widget ")
!query! code_pattern(c, taught_assignment, "widget ")
!query function_call_word(call)
!query function_link_word(to)
!query goal_filler(the)
!query function_name_marker(function)
!query entailment_copula(is)
!query entailment_article(the)
!query entailment_relation_preposition(of)
!query universal_copula(are)
!assert universal_copula(were)
!query universal_copula(were)
!forget universal_copula(were)
!query! universal_copula(were)
!assert function_call_word(invoca)
!query function_call_word(invoca)
!forget function_call_word(invoca)
!query! function_call_word(invoca)
!assert solfege_note(ut)
!query solfege_note(ut)
!forget solfege_note(ut)
!query! solfege_note(ut)
