# Focused KB-first round sixteen: symbolic and code vocabularies are teachable.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=0
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

!query solfege_note(do)
!query code_keyword(python, while)
!query code_keyword(c, int)
!query code_pattern(c, return_statement, "return ")
!query code_pattern(c, int_assignment, "int ")
!query code_pattern(c, char_pointer_assignment, "char *")
!query code_pattern(c, sort_return_type, "void ")
!query code_pattern(c, sort_array_marker, "[]")
!query code_pattern(c, sort_integer_marker, "int")
!query code_pattern(c, loop_for_call, "for(")
!query code_pattern(c, loop_while_call, "while(")
!query code_pattern(c, python_print_call, "print(")
!assert code_pattern(c, taught_assignment, "widget ")
!query code_pattern(c, taught_assignment, "widget ")
!forget code_pattern(c, taught_assignment, "widget ")
!query! code_pattern(c, taught_assignment, "widget ")
!query function_call_word(call)
!query function_link_word(to)
!query agent_parity_marker(even, "even")
!query agent_parity_marker(even, "pari")
!query agent_parity_marker(odd, "odd")
!query agent_parity_marker(odd, "dispari")
!assert agent_parity_marker(even, "parità")
!query agent_parity_marker(even, "parità")
!forget agent_parity_marker(even, "parità")
!query! agent_parity_marker(even, "parità")
!query goal_filler(the)
!query function_name_marker(function)
!query operator_symbol(plus, "+")
!query operator_symbol(minus, "-")
!query operator_symbol(times, "*")
!query operator_symbol(divide, "/")
!assert operator_symbol(modulo, "%")
!query operator_symbol(modulo, "%")
!forget operator_symbol(modulo, "%")
!query! operator_symbol(modulo, "%")
!query entailment_copula(is)
!query entailment_article(the)
!query entailment_relation_preposition(of)
!query universal_copula(are)
!query induce_query_phrase("continue from", continue)
!query induce_query_phrase("what comes after", next)
!query induce_query_phrase("what is the rule", rule)
!assert induce_query_phrase("prosegui da", continue)
!query induce_query_phrase("prosegui da", continue)
!forget induce_query_phrase("prosegui da", continue)
!query! induce_query_phrase("prosegui da", continue)
!assert universal_copula(were)
!query universal_copula(were)
!forget universal_copula(were)
!query! universal_copula(were)
!assert function_call_word(invoca)
!query function_call_word(invoca)
!forget function_call_word(invoca)
!query! function_call_word(invoca)
!assert solfege_note(ut)
!query solfege_note(ut)
!forget solfege_note(ut)
!query! solfege_note(ut)
