# Focused KB-first round seven ratchets.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

[test output_phrase_for_family_acknowledgement]
!assert response_template(family_acknowledged, "Thanks for telling me about your family -- I'll keep that in mind.")
!query response_template(family_acknowledged, "Thanks for telling me about your family -- I'll keep that in mind.")

[test lexical_topic_preposition_growth_and_ablation]
!assert topic_preposition(zorp)
!query topic_preposition(zorp)
!forget topic_preposition(zorp)
!query! topic_preposition(zorp)

[test domain_adapter_content_kind]
!assert content_kind(poem)
!assert domain_relation(content, content_kind)
!query domain_relation(content, content_kind)
!query content_kind(poem)
!forget domain_relation(content, content_kind)
!query! domain_relation(content, content_kind)

[test semantic_family_rename]
!query response_template(sudden_continuation, "Suddenly, {text}.")
!query! response_template(suddenly_x, "Suddenly, {text}.")
