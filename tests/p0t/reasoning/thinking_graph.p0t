# R1 — LE BASI DEL REASONING: il grafo è conoscenza, e si può falsificare.
#
# Piano: `docs/plans/reasoning.md`, Parte II. Questo file esegue E1 (lo schema è
# conoscenza) ed E2 (il grafo non è una catena), che sono i due esperimenti che
# il piano vuole per primi — perché se non passano, tutto il resto è
# architettura senza fondamenta.
#
# ⛔ LA COSA CHE CONTA È LA FALSIFICAZIONE, non il verde. In E2b **invertire
# l'arco deve invertire il rango**: se l'ordine non cambiasse, l'esecutore
# starebbe usando l'indice e il grafo sarebbe decorativo. In E2c un ciclo deve
# rendere il grafo NON pronto: un ragionamento che gira per sempre non è
# profondo, è rotto.
#
# ⚠ Nota di metodo: la prima versione di E2b era mal progettata — toglievo UN
# arco su tre e pretendevo che il rango della sintesi scendesse, mentre gli
# altri due la tenevano su. L'esperimento ha trovato l'errore MIO, ed è
# esattamente a questo che serve.
#
# Tutto è dichiarato a runtime: nessuno di questi schemi esiste nella KB curata.

[mock live]

!set PARROT0_SESSION=
!set PARROT0_LANG=en
!reset
[test E2 — il grafo non e' una catena]
!timeout 15
!assert thinking_scheme(triage, "three views then one")
!clause thinking_step(triage, a, step(op_a, none, ra, meta(1, local))).
!clause thinking_step(triage, b, step(op_b, none, rb, meta(1, local))).
!clause thinking_step(triage, c, step(op_c, none, rc, meta(1, local))).
!clause thinking_step(triage, s, step(op_s, none, rs, meta(1, local))).
!assert thinking_after(triage, a, s)
!assert thinking_after(triage, b, s)
!assert thinking_after(triage, c, s)
!query thinking_rank(triage, a, 0)
!query thinking_rank(triage, b, 0)
!query thinking_rank(triage, c, 0)
!query thinking_rank(triage, s, 1)
!query thinking_ready(triage)

[test E2b — invertire gli archi inverte l'ordine]
!timeout 15
!assert thinking_scheme(pair, "two steps")
!clause thinking_step(pair, p, step(op_p, none, rp, meta(1, local))).
!clause thinking_step(pair, q, step(op_q, none, rq, meta(1, local))).
!assert thinking_after(pair, p, q)
!query thinking_rank(pair, p, 0)
!query thinking_rank(pair, q, 1)
# FALSIFICAZIONE: invertito l'arco, i ranghi si scambiano
!forget thinking_after(pair, p, q)
!assert thinking_after(pair, q, p)
!query thinking_rank(pair, q, 0)
!query thinking_rank(pair, p, 1)

[test E2c — un ciclo si dichiara malato, non gira per sempre]
!timeout 15
!assert thinking_after(pair, p, q)
!query thinking_cycle(pair)
!query! thinking_ready(pair)

[test H5 — il rientro e' la primitiva, e lo specchio e' una guardia]
!timeout 12

# `process(P)` e' la pipeline di parrot0 rientrata: nessuna intelligenza
# esterna, solo lo stesso motore su un turno che il grafo ha costruito.
!query meta_prompt(ingest, $P)
!clause thinking_step(rev, 1, step(reenter(ingest), r0, c0, meta(2, local))).
!query thinking_reentry(rev, 1, ingest)

# ⛔ IL LOOP DI SPECCHIO. Criticare la propria risposta con la STESSA conoscenza
# che l'ha prodotta puo' solo confermarla: non e' teatro che non cambia niente,
# e' teatro che si da' ragione. Senza una fonte dichiarata il nodo NON e'
# ammissibile — la guardia viene prima dell'esecutore, non dopo.
!query reentry_mirror_risk(rev, 1)
!query! reentry_admissible(rev, 1)

# Dichiarata la conoscenza che il rientro porta di nuovo, diventa eseguibile.
!assert reentry_brings(rev, 1, code_finding)
# La fonte deve specificare anche il delta: nominare un finding senza dire
# quale novità produce lascerebbe passare un loop di specchio più verboso.
!assert thinking_feedback(rev, 1, code_finding, fact_delta)
!query thinking_feedback_ready(rev, 1)
!query reentry_admissible(rev, 1)
!query! reentry_mirror_risk(rev, 1)

# E ritirandola torna inammissibile: la guardia e' conoscenza, non un controllo.
!forget thinking_feedback(rev, 1, code_finding, fact_delta)
!query! thinking_feedback_ready(rev, 1)
!query! reentry_admissible(rev, 1)
!query reentry_mirror_risk(rev, 1)
!forget reentry_brings(rev, 1, code_finding)
!query reentry_mirror_risk(rev, 1)

# Un gap è utile solo se porta un'azione informativa, non se è una risposta
# finale travestita da thinking.
!assert reentry_brings(gap_review, 1, code_finding)
!clause thinking_step(gap_review, 1, step(reenter(recall), r0, gap, meta(1, local))).
!assert thinking_feedback(gap_review, 1, code_finding, gap_with_action)
!query! thinking_feedback_ready(gap_review, 1)
!assert thinking_feedback_action(gap_review, 1, inspect_callers)
!query thinking_feedback_ready(gap_review, 1)
!forget thinking_feedback_action(gap_review, 1, inspect_callers)
!query! thinking_feedback_ready(gap_review, 1)

[test A0 — un rientro senza delta o che produce una domanda non peggiora]
!set PARROT0_THINKING=1
!reset
!timeout 12

> what is photosynthesis
<~ I don't know much about photosynthesis yet
<! Learned 0 fact
<! What number should I use
!query thinking_stop_reached(second_thought, budget_exhausted)
!query thinking_prompt_issue(second_thought, 1, no_delta)
!query thinking_prompt_issue(second_thought, 2, clarification)

# La decisione di propagare è policy KB: ablata la guardia, lo stesso motore
# lascia passare la domanda. La falsificazione dimostra che A0 non è un if
# scritto apposta per photosynthesis.
!forget thinking_outcome_policy(clarification, hold)
!assert thinking_outcome_policy(clarification, propagate)
> what is photosynthesis
<~ What number should I use
!forget thinking_outcome_policy(clarification, propagate)
!assert thinking_outcome_policy(clarification, hold)

[test E3 — l'effetto dichiarato chiude davvero la pipeline]
!timeout 12
> the heart pumps blood through the body
<~ pumps(heart, blood)
!query thinking_stop_reached(second_thought, final_answer)

[test E7 — la preferenza fra schemi applicabili cambia a runtime]
!timeout 12
!assert thinking_scheme(choice_a, "choice a")
!assert thinking_scheme(choice_b, "choice b")
!assert thinking_for(choice_a, uc_scheme_cue)
!assert thinking_for(choice_b, uc_scheme_cue)
!assert intent_cue(uc_scheme_cue, "what is photosynthesis")
!assert thinking_scheme_priority(choice_a, 1)
!assert thinking_scheme_priority(choice_b, 2)
> what is photosynthesis
!query thinking_selected_scheme(choice_b)

!forget thinking_scheme_priority(choice_a, 1)
!assert thinking_scheme_priority(choice_a, 3)
> what is photosynthesis
!query thinking_selected_scheme(choice_a)
