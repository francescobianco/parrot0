# M2 — la derivazione prodotta dalla ricerca che decide
# (docs/plans/lettura-della-prosa.md, HANDOFF «contenuti, atti e giudizi»).
#
# kb_prove_support riferiva la PRIMA prova trovata da un secondo risolutore:
# nel caso Zelvo aggiungere una conoscenza vera cambiava il verdetto. Qui la
# prova e' raccolta dentro `solve`: kb_derivation(D, Goal, I, Dip), con le
# alternative sul backtracking (OR) e le dipendenze congiunte (AND).
#
# I nomi abstraction_* sono inventati e provano SOLO la meccanica (MANTRA: un
# test non inventa la conoscenza che dichiara di scoprire). L'ultimo blocco
# legge una prova su conoscenza VERA della KB viva.
[mock live]
!set PARROT0_SESSION=
!set PARROT0_LANG=en
!set PARROT0_PROFILE=kb/profiles/agi.p0
!reset

[test two_ways_to_the_same_goal]
# un fatto diretto E una regola: due derivazioni, non una
!assert abstraction_target(x)
!assert abstraction_seed(x)
!clause abstraction_target($X) :- abstraction_seed($X)
!query kb_derivation($D, abstraction_target(x), 0, 1)
!query kb_derivation($D, abstraction_target(x), 0, 2)
!query derivation_alternative(abstraction_target(x), $A, $B)
# la derivazione torna alle clausole giuste: il fatto seme e la regola
!clause abstraction_via_seed(yes) :- kb_derivation($D, abstraction_target(x), 0, 2), derivation_depends_on($D, $C), kb_clause($C, app(abstraction_seed, cons(atom(x), nil)), 0, 0)
!query abstraction_via_seed(yes)
!clause abstraction_via_rule(yes) :- kb_derivation($D, abstraction_target(x), 0, 2), derivation_uses_clause($D, $C), kb_clause($C, app(abstraction_target, cons(var(0), nil)), 1, app(abstraction_seed, cons(var(0), nil)))
!query abstraction_via_rule(yes)
!clause abstraction_complete(yes) :- kb_derivation($D, abstraction_target(x), 0, 2), derivation_complete($D)
!query abstraction_complete(yes)
# e la prova sa dire su che cosa poggia
!clause abstraction_rests(yes) :- kb_derivation($D, abstraction_target(x), 0, 2), derivation_rests_on($D, abstraction_seed)
!query abstraction_rests(yes)

[test retracting_one_support_keeps_the_other_way]
!forget abstraction_target(x)
!query! kb_derivation($D, abstraction_target(x), 0, 1)
!query kb_derivation($D, abstraction_target(x), 0, 2)
!query derivation_of(abstraction_target(x), $D)
# togliere la premessa fa cadere QUELLA derivazione
!forget abstraction_seed(x)
!query! derivation_of(abstraction_target(x), $D)

[test insertion_order_does_not_decide]
# ora il fatto diretto arriva DOPO la regola: le due vie ci sono lo stesso
!assert abstraction_seed(x)
!assert abstraction_target(x)
!query kb_derivation($D, abstraction_target(x), 0, 2)
!query kb_derivation($D, abstraction_target(x), 0, 1)

[test machinery_hides_nothing_from_a_derivation]
!assert machinery(abstraction_seed)
!query kb_derivation($D, abstraction_target(x), 0, 2)
!clause abstraction_still_rests(yes) :- kb_derivation($D, abstraction_target(x), 0, 2), derivation_rests_on($D, abstraction_seed)
!query abstraction_still_rests(yes)
!forget machinery(abstraction_seed)

[test the_inverse_rule_is_the_rule_used]
!assert abstraction_edge(a, b)
!clause abstraction_path($X, $Y) :- abstraction_edge($X, $Y)
!clause abstraction_path($X, $Y) :- abstraction_edge($Y, $X)
!clause abstraction_inverse_used(yes) :- kb_derivation($D, abstraction_path(b, a), 0, 2), derivation_uses_clause($D, $C), kb_clause($C, app(abstraction_path, cons(var(0), cons(var(1), nil))), 1, app(abstraction_edge, cons(var(1), cons(var(0), nil))))
!query abstraction_inverse_used(yes)
!clause abstraction_direct_in($D) :- derivation_uses_clause($D, $C), kb_clause($C, app(abstraction_path, cons(var(0), cons(var(1), nil))), 1, app(abstraction_edge, cons(var(0), cons(var(1), nil))))
!clause abstraction_direct_not_used(yes) :- kb_derivation($D, abstraction_path(b, a), 0, 2), naf(abstraction_direct_in($D))
!query abstraction_direct_not_used(yes)

[test absence_is_a_declared_dependency]
!assert abstraction_thing(x)
!clause abstraction_lonely($X) :- abstraction_thing($X), naf(abstraction_edge($X, x))
!query kb_derivation($D, abstraction_lonely(x), $I, absent(app(abstraction_edge, cons(atom(x), cons(atom(x), nil)))))
!clause abstraction_absent_named(yes) :- kb_derivation($D, abstraction_lonely(x), 0, $N), derivation_needs_absent($D, app(abstraction_edge, cons(atom(x), cons(atom(x), nil))))
!query abstraction_absent_named(yes)
# e la dipendenza e' vera: tolta l'assenza, la prova cade
!assert abstraction_edge(x, x)
!query! derivation_of(abstraction_lonely(x), $D)
!forget abstraction_edge(x, x)
!query derivation_of(abstraction_lonely(x), $D)

[test no_proof_no_derivation_and_a_bound_id_reads_the_store]
!query! kb_derivation($D, abstraction_nothing(x), 0, $N)
!clause abstraction_reread(yes) :- kb_derivation($D, abstraction_lonely(x), 0, $N), kb_derivation($D, $Goal, 0, $N), kb_derivation($D, abstraction_lonely(x), 1, $Dip)
!query abstraction_reread(yes)
!query! kb_derivation(derivation_999999, $Goal, 0, $N)

[test a_proof_on_real_knowledge]
# man(plato) e mortal($X) :- man($X) sono nella KB viva (kb/core/base.p0)
!clause abstraction_plato(yes) :- kb_derivation($D, mortal(plato), 0, 2), derivation_uses_clause($D, $C), kb_clause($C, app(man, cons(atom(plato), nil)), 0, 0)
!query abstraction_plato(yes)
!clause abstraction_plato_rule(yes) :- kb_derivation($D, mortal(plato), 0, 2), derivation_uses_clause($D, $C), kb_clause($C, app(mortal, cons(var(0), nil)), 1, app(man, cons(var(0), nil)))
!query abstraction_plato_rule(yes)
!clause abstraction_plato_rests(yes) :- kb_derivation($D, mortal(plato), 0, 2), derivation_rests_on($D, man), derivation_rests_on($D, mortal)
!query abstraction_plato_rests(yes)

[test one_content_two_acts]
# M2, la seconda meta': lo stesso contenuto entrato per due vie ha DUE atti.
# Il contenuto resta uno — e' la stessa proposizione — ma ritirarne uno lascia
# vivo l'altro. Prima il secondo atto era invisibile e ritirare l'ipotesi
# portava via anche cio' che la sessione sapeva.
!assert abstraction_shared(x)
!query content_act(content(abstraction_shared, $P), session)
!query! content_act(content(abstraction_shared, $P), hypothetical)
!suppose abstraction_shared(x)
!query content_act(content(abstraction_shared, $P), session)
!query content_act(content(abstraction_shared, $P), hypothetical)
!query content_entered_twice(content(abstraction_shared, $P))
# ritirare l'ipotesi toglie QUELL'atto, non il contenuto
!forget @hypothetical
!query content_act(content(abstraction_shared, $P), session)
!query! content_act(content(abstraction_shared, $P), hypothetical)
!query abstraction_shared(x)

[test a_content_only_supposed_falls_with_its_act]
!suppose abstraction_supposed(y)
!query content_act(content(abstraction_supposed, $P), hypothetical)
!query content_only_supposed(content(abstraction_supposed, $P))
!query abstraction_supposed(y)
!forget @hypothetical
!query! abstraction_supposed(y)
!query! content_act(content(abstraction_supposed, $P), hypothetical)

[test a_cache_is_not_a_free_axiom]
# Una vista materializzata congela le soluzioni di una regola. Il fatto
# congelato e' conoscenza vecchia in forma veloce, non un assioma in piu':
# la prova che ci poggia deve poterlo DIRE, non ereditarlo di nascosto.
# (Nota: `content(Pred, $P)` con l'impronta libera nomina un PREDICATO, non un
# contenuto — qui la regola e il fatto congelato sono due contenuti diversi
# con la stessa testa, e i loro atti sono diversi.)
!assert abstraction_base(x)
!clause abstraction_cached($X) :- abstraction_base($X)
!assert materialized_view(abstraction_cached, 1)
!query abstraction_cached(x)
!clause abstraction_frozen($Id) :- kb_clause($Id, app(abstraction_cached, cons(atom(x), nil)), 0, 0)
!query abstraction_frozen($Id)
!clause abstraction_cache_act(yes) :- abstraction_frozen($Id), content_act($Id, derived)
!query abstraction_cache_act(yes)
# il contenuto congelato non si spaccia per una cosa detta
!clause abstraction_cache_not_said(yes) :- abstraction_frozen($Id), naf(content_act($Id, session))
!query abstraction_cache_not_said(yes)
# e la regola da cui viene, che e' un altro contenuto, invece e' stata detta
!clause abstraction_rule_said(yes) :- kb_clause($Id, app(abstraction_cached, cons(var(0), nil)), 0, 1), content_act($Id, session)
!query abstraction_rule_said(yes)
# la prova che poggia sulla cache lo sa dire di se'
!clause abstraction_cache_seen(yes) :- kb_derivation($D, abstraction_cached(x), 0, $N), derivation_rests_on_cache($D)
!query abstraction_cache_seen(yes)

[test the_dependency_set_says_what_must_hold_not_how_often]
# Una catena a->b->c->d usa la regola transitiva DUE volte. L'insieme delle
# dipendenze risponde a «che cosa deve valere perche' la prova stia in piedi»,
# non a «quanti passi ha fatto»: la stessa clausola usata due volte e' una
# dipendenza sola, perche' ritirarla fa cadere la prova una volta sola.
# E' una proprieta' DICHIARATA della rappresentazione, non un proof-tree
# mancato: l'albero completo dei passi sarebbe un'altra cosa, e si chiedera'
# quando qualcuno ne avra' bisogno.
!assert abstraction_link(a, b)
!assert abstraction_link(b, c)
!assert abstraction_link(c, d)
!clause abstraction_reach($X, $Y) :- abstraction_link($X, $Y)
!clause abstraction_reach($X, $Y) :- abstraction_link($X, $Z), abstraction_reach($Z, $Y)
# due regole + tre archi = cinque dipendenze, non sei
!query kb_derivation($D, abstraction_reach(a, d), 0, 5)
!query! kb_derivation($D, abstraction_reach(a, d), 0, 6)
# e ritirare UN arco fa cadere quella prova
!forget abstraction_link(b, c)
!query! derivation_of(abstraction_reach(a, d), $D)
!query derivation_of(abstraction_reach(a, b), $D)

[test the_zelvo_shape_a_taught_conclusion_does_not_erase_the_premise_proof]
# M3, primo passo — il difetto misurato dal piano: il sillogismo rispondeva
# Yes, si insegnava separatamente la conclusione, e rispondeva No. Non perche'
# il verdetto fosse sbagliato, ma perche' si giudicava la PRIMA prova trovata
# invece di cercarne una AMMISSIBILE. Qui la ricerca continua dopo una prova
# dal mondo non sufficiente, e la conoscenza in piu' non toglie niente.
#
# Il mondo non sa ancora nulla di zelvo: si suppongono le premesse.
!suppose abstraction_narp(zelvo).
!suppose abstraction_vorn($X) :- abstraction_narp($X).
!query abstraction_vorn(zelvo)
!query supported_from_premises(abstraction_vorn(zelvo))
!query! supported_from_world(abstraction_vorn(zelvo))

# Ora si INSEGNA la conclusione come fatto del mondo. La prova diretta esiste,
# ed e' piu' corta: e' quella che il vecchio circuito trovava per prima.
!assert abstraction_vorn(zelvo)
!query supported_from_world(abstraction_vorn(zelvo))
# la prova dalle premesse c'e' ancora, e si trova tornando indietro
!query supported_from_premises(abstraction_vorn(zelvo))

# Ritirando il solo fatto insegnato resta la prova dalle premesse
!forget abstraction_vorn(zelvo)
!query supported_from_premises(abstraction_vorn(zelvo))
!query! supported_from_world(abstraction_vorn(zelvo))

[test with_a_premise_really_missing_nothing_is_invented]
# l'altra meta': se una premessa manca davvero, non si inventa l'implicazione
!suppose abstraction_zorb($X) :- abstraction_quib($X).
!query! supported_from_premises(abstraction_zorb(nobody))
!query! abstraction_zorb(nobody)
# e appena la premessa c'e', la prova dalle premesse compare
!suppose abstraction_quib(nobody).
!query supported_from_premises(abstraction_zorb(nobody))
# ritirando le supposizioni cade tutto, e nessun contenuto resta appeso
!forget @hypothetical
!query! abstraction_zorb(nobody)
!query! supported_from_premises(abstraction_zorb(nobody))
