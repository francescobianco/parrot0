# Focused KB-first round eight ratchets.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

[test output_phrase_for_induced_rule]
!assert response_template(induced_rule_statement, "The rule is {rule}.")
!query response_template(induced_rule_statement, "The rule is {rule}.")
> 2 -> 5, 3 -> 7, 5 -> 11. what is the rule?
< The rule is f(n) = 2n + 1.

[test lexical_social_pattern_type_growth_and_ablation]
!assert social_pattern_type(zorp)
!query social_pattern_type(zorp)
!forget social_pattern_type(zorp)
!query! social_pattern_type(zorp)

[test domain_adapter_role_trait]
!assert trait(zorp, chirp)
!assert domain_relation(role_trait, trait)
!query domain_relation(role_trait, trait)
!query trait(zorp, chirp)
!forget domain_relation(role_trait, trait)
!query! domain_relation(role_trait, trait)

[test semantic_family_rename]
!query response_template(induction_rule_unavailable, "Those examples don't all follow one rule I can express yet.")
!query! response_template(those_examples_don_t_all_follow_one_rule_i_c, "Those examples don't all follow one rule I can express yet.")
