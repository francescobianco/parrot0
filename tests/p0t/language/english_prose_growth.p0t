# Prima fogliata, 19 settembre 2026. PREPARATO, NON ESEGUITO in questa sessione:
# F. ha rinviato gli esperimenti. Contratti meccanici sulla KB agi completa.
# I nodi artificiali dimostrano solo matcher e crescita, NON comprensione di
# Wikipedia. Non contengono fatti del mondo e non alimentano semantic_binding.

[mock live]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/profiles/agi.p0
!set PARROT0_LANG=en
!reset

[test expression teaching and withdrawal change the same retained IR]
!timeout 1
!assert document_unit_token(prose_growth_unit, 1, token("perchance", range(0, 9)))
!query! prose_evidence(document(prose_growth_unit), span(1, 1), modality, possible)
> the expression perchance marks epistemic possibility
<~ Learned the grammatical reading
!query prose_evidence(document(prose_growth_unit), span(1, 1), modality, possible)
!query prose_local_policy(document(prose_growth_unit), span(1, 1), possible, do_not_assert_actual)
> forget that the expression perchance marks epistemic possibility
<~ Forgotten that grammatical reading
!query! prose_evidence(document(prose_growth_unit), span(1, 1), modality, possible)
!query document_unit_token(prose_growth_unit, 1, token("perchance", range(0, 9)))

[test multiword evidence respects token order and punctuation]
!timeout 1
!assert document_unit_token(prose_phrase_unit, 1, token("as", range(0, 2)))
!assert document_unit_token(prose_phrase_unit, 2, token("a", range(3, 1)))
!assert document_unit_token(prose_phrase_unit, 3, token("result", range(5, 6)))
!query prose_evidence(document(prose_phrase_unit), span(1, 3), discourse, consequence)
!forget prose_expression("as a result", discourse_consequence)
!query! prose_evidence(document(prose_phrase_unit), span(1, 3), discourse, consequence)
!assert prose_expression("as a result", discourse_consequence)
!query prose_evidence(document(prose_phrase_unit), span(1, 3), discourse, consequence)
# Change just the observed gap: 'as a, result' cannot be the same expression.
!forget document_unit_token(prose_phrase_unit, 3, token("result", range(5, 6)))
!assert document_unit_token(prose_phrase_unit, 3, token("result", range(6, 6)))
!query! prose_evidence(document(prose_phrase_unit), span(1, 3), discourse, consequence)

[test productive morphology grows and retracts with the lemma]
!timeout 1
!query! prose_verb_form(zorbify, zorbified, past_participle)
> zorbify is an english verb lemma
<~ Learned
!query prose_verb_form(zorbify, zorbifies, present_third)
!query prose_verb_form(zorbify, zorbified, past)
!query prose_verb_form(zorbify, zorbified, past_participle)
!query prose_verb_form(zorbify, zorbifying, present_participle)
!query! prose_verb_form(zorbify, zorbifys, present_third)
> forget that zorbify is an english verb lemma
<~ Forgotten
!query! prose_verb_form(zorbify, zorbified, past_participle)

[test typed forms distinguish tense participle and auxiliary chain]
!timeout 1
!query prose_verb_form(write, wrote, past)
!query prose_verb_form(write, written, past_participle)
!query! prose_verb_form(write, wrote, past_participle)
!query prose_verb_form(stop, stopping, present_participle)
!query prose_verb_form(tie, tying, present_participle)
!assert document_unit_token(prose_chain_unit, 1, token("has", range(0, 3)))
!assert document_unit_token(prose_chain_unit, 2, token("written", range(4, 7)))
!query prose_local_chain(document(prose_chain_unit), span(1, 2), perfect, write)
!forget prose_chain_shape(perfect, past_participle, perfect)
!query! prose_local_chain(document(prose_chain_unit), span(1, 2), perfect, write)
!assert prose_chain_shape(perfect, past_participle, perfect)
!query prose_local_chain(document(prose_chain_unit), span(1, 2), perfect, write)

[test grammatical evidence does not assert its possible proposition]
!timeout 1
!assert document_unit_token(prose_modal_unit, 1, token("may", range(0, 3)))
!query prose_evidence(document(prose_modal_unit), span(1, 1), modality, possible)
!query prose_evidence(document(prose_modal_unit), span(1, 1), modality, permission)
!query prose_scope_requirement(document(prose_modal_unit), span(1, 1), modality, possible)
# Both readings survive. No arbitrary first-reading commitment is licensed.
!query! semantic_binding(binary(may), prose_modal_unit, object(permission))
