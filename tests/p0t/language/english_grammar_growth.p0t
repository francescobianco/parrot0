# Prima fogliata, 19 settembre 2026. PREPARATO, NON ESEGUITO in questa sessione:
# F. ha rinviato gli esperimenti. Contratti meccanici sulla KB agi completa.
# I nodi artificiali dimostrano solo matcher e crescita, NON comprensione di
# Wikipedia. Non contengono fatti del mondo e non alimentano semantic_binding.

[mock live]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/profiles/agi.p0
!set PARROT0_LANG=en
!reset

[test expression teaching and withdrawal change the same retained IR]
!timeout 1
!assert document_unit_token(grammar_growth_unit, 1, token("perchance", range(0, 9)))
!query! grammatical_cue(document(grammar_growth_unit), span(1, 1), modality, possible)
> the expression perchance marks epistemic possibility
<~ Learned the grammatical reading
!query grammatical_cue(document(grammar_growth_unit), span(1, 1), modality, possible)
!query commitment_at(document(grammar_growth_unit), span(1, 1), possible, do_not_assert_actual)
> forget that the expression perchance marks epistemic possibility
<~ Forgotten that grammatical reading
!query! grammatical_cue(document(grammar_growth_unit), span(1, 1), modality, possible)
!query document_unit_token(grammar_growth_unit, 1, token("perchance", range(0, 9)))

[test multiword evidence respects token order and punctuation]
!timeout 1
!assert document_unit_token(grammar_phrase_unit, 1, token("as", range(0, 2)))
!assert document_unit_token(grammar_phrase_unit, 2, token("a", range(3, 1)))
!assert document_unit_token(grammar_phrase_unit, 3, token("result", range(5, 6)))
!query grammatical_cue(document(grammar_phrase_unit), span(1, 3), discourse, consequence)
!forget expression_reading("as a result", discourse_consequence)
!query! grammatical_cue(document(grammar_phrase_unit), span(1, 3), discourse, consequence)
!assert expression_reading("as a result", discourse_consequence)
!query grammatical_cue(document(grammar_phrase_unit), span(1, 3), discourse, consequence)
# Change just the observed gap: 'as a, result' cannot be the same expression.
!forget document_unit_token(grammar_phrase_unit, 3, token("result", range(5, 6)))
!assert document_unit_token(grammar_phrase_unit, 3, token("result", range(6, 6)))
!query! grammatical_cue(document(grammar_phrase_unit), span(1, 3), discourse, consequence)

[test productive morphology grows and retracts with the lemma]
!timeout 1
!query! verb_form(zorbify, zorbified, past_participle)
> zorbify is an english verb lemma
<~ Learned
!query verb_form(zorbify, zorbifies, present_third)
!query verb_form(zorbify, zorbified, past)
!query verb_form(zorbify, zorbified, past_participle)
!query verb_form(zorbify, zorbifying, present_participle)
!query! verb_form(zorbify, zorbifys, present_third)
> forget that zorbify is an english verb lemma
<~ Forgotten
!query! verb_form(zorbify, zorbified, past_participle)

[test typed forms distinguish tense participle and auxiliary chain]
!timeout 1
!query verb_form(write, wrote, past)
!query verb_form(write, written, past_participle)
!query! verb_form(write, wrote, past_participle)
!query verb_form(stop, stopping, present_participle)
!query verb_form(tie, tying, present_participle)
!assert document_unit_token(grammar_chain_unit, 1, token("has", range(0, 3)))
!assert document_unit_token(grammar_chain_unit, 2, token("written", range(4, 7)))
!query auxiliary_chain(document(grammar_chain_unit), span(1, 2), perfect, write)
!forget auxiliary_chain_shape(perfect, past_participle, perfect)
!query! auxiliary_chain(document(grammar_chain_unit), span(1, 2), perfect, write)
!assert auxiliary_chain_shape(perfect, past_participle, perfect)
!query auxiliary_chain(document(grammar_chain_unit), span(1, 2), perfect, write)

[test grammatical evidence does not assert its possible proposition]
!timeout 1
!assert document_unit_token(grammar_modal_unit, 1, token("may", range(0, 3)))
!query grammatical_cue(document(grammar_modal_unit), span(1, 1), modality, possible)
!query grammatical_cue(document(grammar_modal_unit), span(1, 1), modality, permission)
!query scope_requirement(document(grammar_modal_unit), span(1, 1), modality, possible)
# Both readings survive. No arbitrary first-reading commitment is licensed.
!query! semantic_binding(binary(may), grammar_modal_unit, object(permission))

# ── LA PORTA META-LINGUISTICA (19 settembre 2026) ────────────────────────────
# F.: «lo scoping sui predicati produce predicati non agganciabili dalla meta
# linguistica». Il lettore dell'appartenenza interroga il predicato che porta il
# NOME PRONUNCIATO con arita' 1: una distinzione tenuta solo in una relazione a
# due o tre argomenti c'e' ma non si puo' nominare. Le facce di naming.p0 sono
# regole su quelle relazioni, non copie; questi casi sono la prova che la
# conoscenza della fogliata si raggiunge PARLANDO.

[test the distinctions of the sheet have a face one can say]
!timeout 1
> is water a mass noun?
< Yes.
> is comprise a transitive verb?
< Yes.
> is comprise a verb of constitution?
< Yes.
> is dissolve a verb of chemistry?
< Yes.
> is my a possessive determiner?
< Yes.
> what does however mark?
<~ marks contrast

[test a reading taught by speaking can then be asked about by speaking]
!timeout 1
> what does perchance mark?
<~ I don't know about perchance
> the expression perchance marks epistemic possibility
<~ Learned the grammatical reading
> what does perchance mark?
< «perchance» marks epistemic possibility.
> forget that the expression perchance marks epistemic possibility
<~ Forgotten that grammatical reading
> what does perchance mark?
<~ I don't know about perchance
