# universal-input.p0t — l'oracolo di docs/plans/universal-input.md (U1-U8).
# Convertito da tests/universal-input.sh (gen444).
#
# UN SOLO processo tiene UNA sola KB viva, cosi' assert -> segment ->
# retract prova la crescita a RUNTIME invece di misurare per sbaglio tre
# binari diversi. Per questo e' una sezione sola e senza `!reset` in mezzo:
# resettare qui vorrebbe dire perdere esattamente cio' che si sta provando.
#
# Le asserzioni dello script guardavano il formato di TRASPORTO — il payload
# viaggia come stringa JSON dentro l'envelope JSON-RPC, con le virgolette
# protette. `!mcp` restituisce il payload grezzo, quindi qui i backslash non
# ci sono. E' la sola differenza vera fra le due forme.

[test universal_input]
!set PARROT0_SESSION=
!set PARROT0_LANG=en
!reset
!timeout 30

!mcp input.segment {"text":"fix: int f(void) { return 1; } a condizione che sia veloce"}
# unknown role cue uses the declared after-default
!expect mcp "role":"expected"

!mcp kb.assert {"pred":"segment_role","args":["constraint","a condizione che"]}

!mcp input.segment {"text":"fix: int f(void) { return 1; } a condizione che sia veloce"}
# a runtime fact changes segmentation without rebuild
!expect mcp "role":"constraint"
# constraint span cites its exact supporting fact
!expect mcp segment_role(constraint

!mcp kb.assert {"pred":"segment_role","args":["repro","per ricreare"]}

!mcp input.segment {"text":"fix: int f(void) { return 1; } per ricreare usa -1"}
# an open runtime role crosses the C API unchanged
!expect mcp "role":"repro"
# open role carries provenance
!expect mcp segment_role(repro

!mcp kb.retract {"pred":"segment_role","args":["repro","per ricreare"]}

!mcp input.segment {"text":"fix: int f(void) { return 1; } per ricreare usa -1"}
# retraction changes the next segmentation
!expect mcp "role":"expected"
# retracted role is not cached
!expect! mcp "role":"repro"

!mcp input.segment {"text":"inspect: {\"answer\": 42} expected 42"}
# JSON is isolated by KB delimiter/evidence facts
!expect mcp "register":"json"
# faculty_for routes the typed JSON span
!expect mcp "faculty":"structured_reader"

!mcp input.segment {"text":"fix this:\ndef f(x):\n    return x\nIt should return x"}
# indentation closes Python before dedented prose
!expect mcp "register":"python"
# dedented prose remains a separate role span
!expect mcp "role":"expected"

!mcp input.segment {"text":"pytest output:\nE   assert 1 == 2\nFAILED test_x.py::test_x"}
# pytest output is a non-source typed register
!expect mcp "register":"pytest"
# pytest span is consumable without a parser branch
!expect mcp "faculty":"verdict_builder"

!mcp input.segment {"text":"inspect: {}"}
# equal C/JSON evidence produces ambiguous_input
!expect mcp "ambiguous":true
# ambiguity proof names the tied support
!expect mcp c=4 because register_evidence

!mcp input.segment {"text":"the sky is blue"}
# ordinary prose stays prose
!expect mcp "role":"prose"
# common prose words do not imply Python
!expect! mcp "register":"python"

!mcp input.segment {"text":"settings.conf"}
# .conf is not classified as .c
!expect mcp "role":"prose"
# extension matching is exact
!expect! mcp "register":"c"

!mcp kb.assert {"pred":"register_evidence","args":["notice","line_prefix(NOTICE:)"]}

!mcp input.segment {"text":"NOTICE: hello"}
# a new line register works from one runtime fact
!expect mcp "register":"notice"
# new register cites its runtime evidence
!expect mcp register_evidence(notice

!mcp kb.assert {"pred":"delim_pair","args":["angle","<",">"]}

!mcp kb.assert {"pred":"code_register","args":["anglelang","angle"]}

!mcp kb.assert {"pred":"register_evidence","args":["anglelang","balanced(angle)"]}

!mcp kb.assert {"pred":"faculty_for","args":["code(anglelang)","custom_reader"]}

!mcp input.segment {"text":"inspect: <outer <inner>> after"}
# an arbitrary nested delimiter pair needs zero C
!expect mcp "register":"anglelang"
# runtime faculty routing is honored
!expect mcp "faculty":"custom_reader"

!mcp kb.assert {"pred":"intent_cue","args":["alpha_intent","same cue"]}

!mcp kb.assert {"pred":"intent_cue","args":["beta_intent","same cue"]}

!mcp input.classify {"relation":"intent_cue","text":"please use same cue now","candidates":["alpha_intent","beta_intent"]}
# intent hypotheses use the no-tiebreak scorer
!expect mcp "status":"ambiguous"
# intent ambiguity has the same proof shape
!expect mcp ambiguous_hypothesis(intent_cue)

!mcp kb.retract {"pred":"intent_cue","args":["beta_intent","same cue"]}

!mcp input.classify {"relation":"intent_cue","text":"please use same cue now","candidates":["alpha_intent","beta_intent"]}
# ablating one intent support leaves the survivor
!expect mcp "status":"winner"
# winner is derived, not fact-order selected
!expect mcp "hypothesis":"alpha_intent"

!mcp kb.retract {"pred":"intent_cue","args":["alpha_intent","same cue"]}

!mcp input.classify {"relation":"intent_cue","text":"please use same cue now","candidates":["alpha_intent","beta_intent"]}
# ablating all intent evidence produces a typed Gap
!expect mcp "status":"gap"
# intent Gap mirrors register-evidence Gap
!expect mcp gap(intent_cue)

!mcp input.segment {"text":"patch:\ndiff --git a/a.c b/a.c\n@@ -1 +1 @@\n-old\n+new"}
# diff is isolated by line evidence
!expect mcp "register":"diff"
# diff routes to its declarative consumer
!expect mcp "faculty":"patch_reader"

!mcp input.segment {"text":"compiler:\nmain.c:3:5: error: expected ; before }"}
# compiler diagnostics use the same line engine
!expect mcp "register":"cc"

!mcp input.segment {"text":"failure:\nTraceback (most recent call last):\n  File \"x.py\", line 1\nValueError: bad"}
# tracebacks use the same line engine
!expect mcp "register":"traceback"

!mcp gen.respond {"input":"fix this code: int f(void) { return 1; } without recursion"}

!mcp gen.respond {"input":"how do you know?"}
# a conversational why cites the role fact
!expect mcp segment_role(constraint

!mcp input.segment {"text":"explain:\n```c\nint f(void) { return 1; }\n```\nIt should return 1"}
# explicit fences use the same register scorer
!expect mcp "register":"c"
# prose after a fence remains a separate span
!expect mcp "role":"expected"

!mcp kb.retract {"pred":"register_evidence","args":["notice","line_prefix(NOTICE:)"]}

!mcp input.classify {"relation":"register_evidence","text":"NOTICE: hello","candidates":["notice"]}
# ablating register evidence produces the same Gap status
!expect mcp "status":"gap"
# register Gap mirrors intent-cue Gap
!expect mcp gap(register_evidence)

!mcp input.segment {"text":"fix this code\nint f(void) { return 1; } It should return 1"}
# a structured head does not absorb prose from the previous line
!expect mcp "start":14
# the no-colon multiline source remains a C span
!expect mcp "register":"c"

!mcp gen.respond {"input":"fix this code\nint f(void) { return 1; } It should return 1"}
# the compiler receives only the no-colon source span
!expect mcp I compiled it
# preceding prose is never compiled as a C type
!expect! mcp unknown type name

!mcp input.segment {"text":"```\n```"}
# an untyped empty fence remains explicitly ambiguous
!expect mcp "ambiguous":true
# an empty ambiguous span stays within the raw byte stream
!expect mcp "start":4,"len":0

!mcp input.segment {"text":"```c\nconst char *s = \"```\";\n```"}
# backticks inside a fenced literal do not close the fence
!expect mcp "ambiguous":false
# the real line fence still closes the C span
!expect mcp "register":"c"

!mcp input.segment {"text":"fix this:\n{\"expected\":1}\nint f(void){return 1;}"}
# adjacent JSON is classified independently
!expect mcp "register":"json"
# adjacent C is not merged into the JSON span
!expect mcp "register":"c"

!mcp input.segment {"text":"inspect: {\"answer\":42"}
# an unclosed object is ambiguous even before balanced evidence can fire
!expect mcp "ambiguous":true
# unclosed-object proof cites the delimiter fact
!expect mcp delim_pair(brace, {, })

!mcp input.segment {"text":"inspect: [1,2"}
# an unclosed array is ambiguous
!expect mcp "ambiguous":true

!mcp kb.assert {"pred":"segment_role","args":["alpha","foo bar"]}

!mcp kb.assert {"pred":"segment_role","args":["beta","bar baz"]}

!mcp input.segment {"text":"foo bar baz tail"}
# equal overlapping role cues compete instead of truncating provenance
!expect mcp "ambiguous":true
# overlap ambiguity cites the first role fact
!expect mcp segment_role(alpha
# overlap ambiguity cites the second role fact
!expect mcp segment_role(beta

!mcp gen.respond {"input":"what functions does this define: int f(void) {"}
# structural code questions preserve segmentation ambiguity
!expect mcp ambiguous_input
# codeast does not replace an unclosed span with a generic guess
!expect! mcp looks like a snippet

!mcp input.segment {"text":"don\u0027t touch:\nint f(void) { return 1; }"}
# an apostrophe in preceding prose does not hide a structured span
!expect mcp "register":"c"

!mcp kb.assert {"pred":"delim_pair","args":["pipe","|","|"]}

!mcp kb.assert {"pred":"code_register","args":["pipelang","pipe"]}

!mcp kb.assert {"pred":"register_evidence","args":["pipelang","balanced(pipe)"]}

!mcp kb.assert {"pred":"faculty_for","args":["code(pipelang)","pipe_reader"]}

!mcp input.segment {"text":"inspect: | \"a|b\" | after"}
# a symmetric delimiter pair is facts-only
!expect mcp "register":"pipelang"
# a symmetric runtime register reaches its declared consumer
!expect mcp "faculty":"pipe_reader"

!mcp kb.assert {"pred":"quoted_default_test","args":["q","\"default\""]}

!mcp input.classify {"relation":"quoted_default_test","text":"unrelated","candidates":["q"]}
# quoted default is not the fallback sentinel
!expect mcp "status":"gap"

!mcp input.classify {"relation":"quoted_default_test","text":"the default value","candidates":["q"]}
# quoted default remains ordinary surface evidence
!expect mcp "status":"winner"

!mcp kb.assert {"pred":"default_test","args":["a","default"]}

!mcp kb.assert {"pred":"default_test","args":["a","hit"]}

!mcp kb.assert {"pred":"default_test","args":["b","hit"]}

!mcp input.classify {"relation":"default_test","text":"hit","candidates":["a","b"]}
# bare default does not inflate a specifically supported hypothesis
!expect mcp "status":"ambiguous"

!mcp input.classify {"relation":"register_evidence","text":"{} then {\"x\":1}","candidates":["json"]}
# paired evidence scans beyond the first balanced block
!expect mcp paired_contains(brace

!mcp kb.assert {"pred":"malformed_evidence_test","args":["m","keyword(x)junk"]}

!mcp input.classify {"relation":"malformed_evidence_test","text":"x","candidates":["m"]}
# malformed compound evidence is opaque, not executable structure
!expect mcp "status":"gap"
