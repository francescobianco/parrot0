# arith_guard.p0t — contratto di crescita dell'instradamento aritmetico
# "plan-first". Convertito da tests/arith_guard_growth.sh (gen444).
#
# Il verso qui e' INVERTITO rispetto agli altri contratti di crescita: la cue
# asserita non aggiunge una capacita', ne SOSPENDE una. Dichiarare che la frase
# appartiene a uno schema a catena deve impedire all'aritmetica scalare di
# rispondere 12 come se nulla fosse — e ritrattandola l'aritmetica torna.

[test arith_guard_growth]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=1
!reset

# prima: nessuno schema dichiarato, l'aritmetica scalare risponde
!mcp gen.respond {"input":"What is 8 plus 4 guard-alpha?"}
<~ 12

# dichiarare lo schema mette la guardia: la somma da sola non e' piu' la risposta
!mcp kb.assert {"pred":"intent_cue","args":["discount_chain_schema","guard-alpha"]}
!mcp gen.respond {"input":"What is 8 plus 4 guard-alpha?"}
<! 12

# ritratta la dichiarazione, torna l'aritmetica
!mcp kb.retract {"pred":"intent_cue","args":["discount_chain_schema","guard-alpha"]}
!mcp gen.respond {"input":"What is 8 plus 4 guard-alpha?"}
<~ 12
