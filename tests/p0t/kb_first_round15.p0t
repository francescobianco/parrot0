# KB viva del profilo: caricamento completo. Le precedenti misure con KB
# ridotta sono obsolete; le attese legacy richiedono rivalidazione semantica.
# Focused KB-first round fifteen: knowledge-question heads are runtime data.
[mock live]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

!query knowledge_head("what is a ", strong)
!query knowledge_head("what is ", weak)
!assert knowledge_head("define ", strong)
!query knowledge_head("define ", strong)
!forget knowledge_head("define ", strong)
!query! knowledge_head("define ", strong)
