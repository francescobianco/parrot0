[test profiles]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/profiles/programming/coder.p0
!reset

# coder: C code recognized
> what language is this code: int x;
< This looks like C code.

# coder: Python code recognized
