# experts.p0t — converted from tests/experts.sh.
#
# gen150b: verify expert domain files load correctly. The three expectations
# that were failures in the shell test remain exact failing expectations here.

[test experts_c]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/experts/programming/c.p0
!reload
> what language is this code: int x
< This looks like C code.

