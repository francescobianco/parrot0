# Focused KB-first round six ratchets.
[mock hermetic]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_WORLD_FACTS=1
!set PARROT0_LANG=en
!set PARROT0_TOOLS=1
!reset

[test output_phrase_for_concise_explanation]
!assert response_template(concise_explanation, "{text}.")
!query response_template(concise_explanation, "{text}.")

[test lexical_calendar_kind_growth_and_ablation]
!assert calendar_question_kind(zorp)
!query calendar_question_kind(zorp)
!forget calendar_question_kind(zorp)
!query! calendar_question_kind(zorp)

[test domain_adapter_narrative_completion]
!assert continuation_template(rainfall, "rings widen where each drop lands")
!assert domain_relation(narrative_completion, continuation_template)
!query domain_relation(narrative_completion, continuation_template)
!query continuation_template(rainfall, "rings widen where each drop lands")
!forget domain_relation(narrative_completion, continuation_template)
!query! domain_relation(narrative_completion, continuation_template)

[test semantic_family_rename]
!query response_template(sentence_continuation, "{text}.")
!query! response_template(continuation_x, "{text}.")
