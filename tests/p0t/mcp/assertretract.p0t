# assertretract.p0t — convertito da tests/assertretract.sh (gen444).
#
# gen335+ — assert and retract from rule bodies.
# Rules can create and remove facts as part of inference — dynamic clause
# generation without a C edit. Non-backtrackable (like Prolog).

[test assertretract_0]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=0
!reset
!assert has_hair(dog)
!clause derive_warm_blooded($X) :- has_hair($X), assert(warm_blooded, $X)

!mcp kb.query {"pred":"warm_blooded","args":["dog"]}
<~ provable":false

!mcp kb.query {"pred":"derive_warm_blooded","args":["dog"]}
<~ provable":true

!mcp kb.query {"pred":"warm_blooded","args":["dog"]}
<~ provable":true

[test assertretract_1]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=0
!reset
!assert is_active(alice)
!clause cleanup($X) :- is_active($X), retract(is_active, $X)

!mcp kb.query {"pred":"is_active","args":["alice"]}
<~ provable":true

!mcp kb.query {"pred":"cleanup","args":["alice"]}
<~ provable":true

!mcp kb.query {"pred":"is_active","args":["alice"]}
<~ provable":false

[test assertretract_2]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=0
!reset
!assert edge(a, b)
!clause materialize($X, $Y) :- edge($X, $Y), assert(reaches, $X, $Y)

!mcp kb.query {"pred":"reaches","args":["a","b"]}
<~ provable":false

!mcp kb.query {"pred":"materialize","args":["a","b"]}
<~ provable":true

!mcp kb.query {"pred":"reaches","args":["a","b"]}
<~ provable":true

[test assertretract_3]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=
!set PARROT0_WORLD_FACTS=0
!reset
!assert color(sky, blue)

!mcp kb.assert_clause {"head":{"pred":"cache_color","args":["$X","$Y"]},"body":[{"pred":"color","args":["$X","$Y"]},{"pred":"assert","args":["known_color","$X","$Y"]}]}
<~ "ok":true

!mcp kb.query {"pred":"cache_color","args":["sky","blue"]}
<~ provable":true

!mcp kb.query {"pred":"known_color","args":["sky","blue"]}
<~ provable":true

