% expert: chess
expert(chess).
expert_domain(chess, games).
expert_description(chess, "chess rules, pieces, objectives and practical play").
means(chess, "a two-player strategy board game in which each side protects its king and attacks the opposing king").
game_players(chess, 2).
game_goal(chess, "checkmate the opposing king so it is attacked and has no legal escape").
game_setup(chess, "place each side's major pieces on its back rank and eight pawns on the rank in front, with the queen on her own color").
game_play(chess, "players alternate one legal move; pieces move in distinct ways, captures remove opposing pieces, and a king may never remain in check").
game_end(chess, "the game ends by checkmate, resignation, draw agreement, stalemate, repetition, the fifty-move rule, or insufficient mating material").
game_tip(chess, "develop pieces, contest the center, castle the king, and check the opponent's threats before moving").
category_surface(chess, chess_piece).
category_member(chess_piece, king).
category_member(chess_piece, queen).
category_member(chess_piece, rook).
category_member(chess_piece, bishop).
category_member(chess_piece, knight).
category_member(chess_piece, pawn).
% ── gen389: LA COMPOSIZIONE, da cui i conteggi si DERIVANO ──────────────────
%
% «Quanti pezzi ci sono negli scacchi» non ha UNA risposta: 32 (tutti), 16 (per
% giocatore), 6 (tipi distinti). Scriverle come tre numeri a mano sarebbe fissare
% l'istanza; qui si dichiara la COMPOSIZIONE e le tre letture si derivano da lei
% con una procedura che non parla di scacchi (procedures.p0).
%
% `part_count/3` e' la relazione GENERALE delle collezioni con parti contate, non
% una relazione degli scacchi: una collezione nuova — un mazzo, un servizio da te'
% — usa la stessa e le tre letture le eredita.
%
% La composizione ha un secondo pregio, ed e' quello che la sonda all'oracolo ha
% isolato come mossa migliore: esporla rende il numero VERIFICABILE e contiene
% implicitamente le altre letture, cosi' chi chiedeva un'altra cosa se la trova
% gia' davanti senza dover ridomandare.
part_count(chess, king, 1).
part_count(chess, queen, 1).
part_count(chess, rook, 2).
part_count(chess, bishop, 2).
part_count(chess, knight, 2).
part_count(chess, pawn, 8).
sides(chess, 2).
% L'unita' della collezione: e' la parola che il turno deve nominare perche' la
% risposta sui pezzi sia pertinente. Senza, «quanti GIOCATORI ci sono a scacchi»
% riceveva il conteggio dei pezzi — disambiguare cio' che non e' ambiguo e'
% peggio che non disambiguare (la quinta mossa isolata dalla sonda).
collection_unit(chess, pieces).

chess_piece($Piece) :- category_member(chess_piece, $Piece).
game_component(chess, $Piece) :- chess_piece($Piece).

% ── I NOMI DEI PEZZI IN ITALIANO, E IL REGISTRO FSI ──────────────────────────
% gen382b. Il nome di un pezzo in italiano NON e' la traduzione della sua parola
% inglese, ed e' la ragione per cui questo strato esiste invece di una tabella
% parola->parola: `knight` tradotto e' "cavaliere", ma il pezzo e' il CAVALLO;
% `bishop` e' "vescovo", ma il pezzo e' l'ALFIERE. Tradurre i letterali darebbe
% risposte giuste parola per parola e sbagliate come conoscenza.
%
% Il REGISTRO e' una dimensione, non un'eccezione: nella notazione della
% Federazione Scacchistica Italiana la regina e' la DONNA, simbolo D. Non e'
% l'errore dell'uso comune ne' viceversa — sono due strati di conoscenza
% intermedia, e la KB li tiene entrambi. Chi vuole il registro tecnico dichiara
% preferred_register(fsi) e la stessa domanda risponde con l'altro strato.
% Sono MACCHINERIA di presentazione: il nome con cui si rende un concetto e il
% simbolo di una notazione non sono fatti sul mondo, e non devono contare fra le
% cose che parrot0 dice di sapere.
machinery(concept_label).
machinery(concept_symbol).
concept_label(king, it, common, re).
concept_label(queen, it, common, regina).
concept_label(rook, it, common, torre).
concept_label(bishop, it, common, alfiere).
concept_label(knight, it, common, cavallo).
concept_label(pawn, it, common, pedone).

% Registro FSI: cambia il nome della sola donna, e gli altri ricadono sull'uso
% comune — la ricaduta e' del motore, non va ripetuta qui.
concept_label(queen, it, fsi, donna).

% I simboli della notazione algebrica, per lingua e registro. Stessa forma: il
% simbolo di un pezzo e' un nome breve, non una parola tradotta.
concept_symbol(king, it, fsi, "R").
concept_symbol(queen, it, fsi, "D").
concept_symbol(rook, it, fsi, "T").
concept_symbol(bishop, it, fsi, "A").
concept_symbol(knight, it, fsi, "C").
concept_symbol(king, en, algebraic, "K").
concept_symbol(queen, en, algebraic, "Q").
concept_symbol(rook, en, algebraic, "R").
concept_symbol(bishop, en, algebraic, "B").
concept_symbol(knight, en, algebraic, "N").
