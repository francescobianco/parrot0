% --- rules ---
chess_king_option($State, $Side, a1, a2) :- chess_piece_at($State, piece($Side, king), a1), chess_destination_open($State, $Side, a2), naf(chess_attacked_by_opponent($State, $Side, a2)).
chess_king_option($State, $Side, a1, b1) :- chess_piece_at($State, piece($Side, king), a1), chess_destination_open($State, $Side, b1), naf(chess_attacked_by_opponent($State, $Side, b1)).
chess_king_option($State, $Side, a1, b2) :- chess_piece_at($State, piece($Side, king), a1), chess_destination_open($State, $Side, b2), naf(chess_attacked_by_opponent($State, $Side, b2)).
chess_knight_option($State, $Side, a1, b3) :- chess_piece_at($State, piece($Side, knight), a1), chess_destination_open($State, $Side, b3).
chess_knight_option($State, $Side, a1, c2) :- chess_piece_at($State, piece($Side, knight), a1), chess_destination_open($State, $Side, c2).
chess_king_option($State, $Side, a2, a1) :- chess_piece_at($State, piece($Side, king), a2), chess_destination_open($State, $Side, a1), naf(chess_attacked_by_opponent($State, $Side, a1)).
chess_king_option($State, $Side, a2, a3) :- chess_piece_at($State, piece($Side, king), a2), chess_destination_open($State, $Side, a3), naf(chess_attacked_by_opponent($State, $Side, a3)).
