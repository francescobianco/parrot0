% expert: poker, using standard high-hand ranking
expert(poker).
expert_domain(poker, games).
expert_description(poker, "poker hand ranks, betting, position and showdown").
means(poker, "a family of card games where players wager on hands whose strength may be shown or represented by betting").
game_players(poker, "commonly two to ten, depending on the variant").
game_goal(poker, "win pots by holding the best hand at showdown or by making every opponent fold").
game_setup(poker, "choose a variant, dealer position, stakes and blind or ante structure, then deal according to that variant").
game_play(poker, "betting rounds let players check, bet, call, raise or fold; remaining hands are compared at showdown").
game_end(poker, "a hand ends when one player remains or the showdown awards the pot").
game_tip(poker, "play fewer weak starting hands, value position, track pot odds, and treat bluffing as one part of a balanced strategy").
% gen382q — l'arco che mancava: il dato sulle carte c'era gia' in
% quantity(deck, cards, 52), ma niente collegava questo gioco al mazzo.
requires(poker, deck).

category_surface(poker, poker_hand).
category_member(poker_hand, high_card).
category_member(poker_hand, one_pair).
category_member(poker_hand, two_pair).
category_member(poker_hand, three_of_a_kind).
category_member(poker_hand, straight).
category_member(poker_hand, flush).
category_member(poker_hand, full_house).
category_member(poker_hand, four_of_a_kind).
category_member(poker_hand, straight_flush).
% gen382l — i ranghi erano detti in un DIALETTO PRIVATO.
%
% `poker_hand_rank/2` diceva esattamente cio' che `magnitude(Dim, Item, Rank)`
% dice per ogni altra grandezza confrontabile del sistema — la lunghezza dei
% fiumi, la distanza dei pianeti — ma sotto un nome che solo questo file capisce.
% Risultato: il motore generale di confronto non poteva vedere i ranghi, e "e'
% piu' forte il full o il poker" andava a muro mentre "quale fiume e' piu' lungo"
% rispondeva. Non mancava una capacita': mancava che il dato fosse detto nella
% lingua comune (mantra #3, astrai fino al punto fisso).
%
% Le righe `poker_hand_rank/2` restano perche' `poker_hand_beats/2` le usa e le
% strutture secondarie non si potano (keep-secondary-structures); ma la verita'
% confrontabile e' qui sotto, dove tutti la leggono.
magnitude(hand_rank, high_card, 1).
magnitude(hand_rank, one_pair, 2).
magnitude(hand_rank, two_pair, 3).
magnitude(hand_rank, three_of_a_kind, 4).
magnitude(hand_rank, straight, 5).
magnitude(hand_rank, flush, 6).
magnitude(hand_rank, full_house, 7).
magnitude(hand_rank, four_of_a_kind, 8).
magnitude(hand_rank, straight_flush, 9).

% Le parole con cui si chiede quel confronto, e i nomi italiani delle mani —
% che NON sono la traduzione delle parole inglesi ("full house" e' il "full",
% "four of a kind" e' il "poker"), esattamente come il cavallo degli scacchi.
% La forma canonica italiana: "piu' forte" arriva al dispatch come "strong",
% perche' il comparativo italiano si costruisce con "piu'" e la canonicalizzazione
% lascia l'aggettivo nudo. Dichiarare anche la forma base e' il rimedio locale;
% quello GENERALE — un comparative_marker/1 che valga per ogni aggettivo e ogni
% dimensione — e' segnato in KB_TODO, perche' questa riga risolve il poker e non
% risolve la classe.
magnitude_cue(strong, hand_rank, max).
magnitude_cue(weak, hand_rank, min).
magnitude_cue(stronger, hand_rank, max).
magnitude_cue(strongest, hand_rank, max).
magnitude_cue(weaker, hand_rank, min).
magnitude_cue(weakest, hand_rank, min).

concept_label(full_house, it, common, full).
concept_label(four_of_a_kind, it, common, poker).
concept_label(straight_flush, it, common, scala_reale).
concept_label(three_of_a_kind, it, common, tris).
concept_label(two_pair, it, common, doppia_coppia).
concept_label(one_pair, it, common, coppia).
concept_label(straight, it, common, scala).
concept_label(flush, it, common, colore).

poker_hand_rank(high_card, 1).
poker_hand_rank(one_pair, 2).
poker_hand_rank(two_pair, 3).
poker_hand_rank(three_of_a_kind, 4).
poker_hand_rank(straight, 5).
poker_hand_rank(flush, 6).
poker_hand_rank(full_house, 7).
poker_hand_rank(four_of_a_kind, 8).
poker_hand_rank(straight_flush, 9).
poker_hand_beats($A, $B) :- poker_hand_rank($A, $RA), poker_hand_rank($B, $RB), gt($RA, $RB).
