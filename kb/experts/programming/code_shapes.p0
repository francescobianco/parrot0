% code_shapes.p0 — LE FORME DEL CODICE, E LA LINGUA IN CUI SI SCRIVONO (gen503).
%
% Disegno completo: docs/plans/kb-code-emitter.md
%
% Prima di questo file `code_synth_from_shape` era una catena di strcmp con IL
% CORPO DELLA FUNZIONE scritto come stringa C dentro src/code.c: un caso, dopo
% quattro generazioni, e ogni algoritmo nuovo costava una generazione di C.
%
% Il taglio: l'ALGORITMO non e' la LINGUA.
%
%   che cosa fa          scorri, confronta, scambia, accumula, restituisci
%   come si scrive in C  "for (int {0} = {1}; {0} < {2}; {0}++)"
%
%   un algoritmo nuovo con operazioni note  -> righe qui, ZERO C
%   un'operazione nuova                     -> una riga per lingua
%   una lingua nuova                        -> una riga per operazione,
%                                              e nessun algoritmo riscritto
%
% Regola di composizione, unica: un nodo con figli si emette come
% `TEMPLATE { figli }`, una foglia come `TEMPLATE`. Graffe e spaziatura non sono
% conoscenza, sono meccanica. Negli slot `{0}`, `{1}`, … sono gli argomenti
% dell'operazione; `{name}` e `{cmp}` i legami che il chiamante passa.

:- file_attribute(machinery).

machinery(code_shape_step).
machinery(code_shape_order).
machinery(code_shape_slot).
machinery(code_shape_signature).
machinery(lang_syntax).
machinery(lang_block).
machinery(lang_layout).

% ── COME UNA LINGUA SEGNA UN BLOCCO ────────────────────────────────────────
% La prima stesura scriveva le graffe nel C e le chiamava meccanica. Provando ad
% aggiungere Python e' venuto fuori subito che non lo sono: un blocco si puo'
% segnare con due parentesi o con un rientro, e quale delle due e' una proprieta'
% della LINGUA. E' la falsificazione che il piano (§5 M5) chiedeva, ed e' andata
% come deve andare una falsificazione utile: ha trovato una riga sbagliata.
lang_block(c, "{", "}").
lang_block(python, ":", "").
lang_layout(python, indented).

% ── LA LINGUA C ─────────────────────────────────────────────────────────────
% Ogni riga qui e' un'operazione generale, non un pezzo di un algoritmo: sono
% le stesse che servono a qualunque funzione su array.
lang_syntax(c, loop_up,         "for (int {0} = {1}; {0} < {2}; {0}++)").
lang_syntax(c, loop_up_bounded, "for (int {0} = {1}; {0} + 1 < {2}; {0}++)").
lang_syntax(c, if_compare,      "if ({0} {1} {2})").
lang_syntax(c, swap_via_temp,   "int {2} = {0}; {0} = {1}; {1} = {2};").
lang_syntax(c, declare_int,     "int {0} = {1};").
lang_syntax(c, accumulate,      "{0} = {0} + {1};").
lang_syntax(c, return_value,    "return {0};").

% ── M3: le operazioni che servono a soddisfare un CONTRATTO ─────────────────
% Allocare, controllare un trabocco PRIMA di allocare, copiare, terminare con
% NUL. Sono idiomi generali del C, non pezzi di un compito: la stessa riga
% serve a qualunque funzione che restituisca memoria che chi chiama libera.
lang_syntax(c, declare_size,    "size_t {0} = {1};").
lang_syntax(c, if_cond,         "if ({0})").
lang_syntax(c, return_null,     "return NULL;").
lang_syntax(c, alloc_bytes,     "char *{0} = malloc({1});").
lang_syntax(c, copy_bytes,      "memcpy({0}, {1}, {2});").
lang_syntax(c, set_index,       "{0}[{1}] = {2};").

% ── FORMA 1: due cicli annidati, confronta e scambia ────────────────────────
% E' la forma che `algo_shape(bubblesort, nested_loop_compare_swap)` nomina, ed
% era l'unico caso scritto nel C. Il verso del confronto resta un legame del
% chiamante (`{cmp}`), perche' la stessa forma serve crescente e decrescente.
code_shape_signature(nested_loop_compare_swap, c, "void {name}(int a[], int n)").

code_shape_step(nested_loop_compare_swap, nlcs_1, root,   loop_up).
code_shape_step(nested_loop_compare_swap, nlcs_2, nlcs_1, loop_up_bounded).
code_shape_step(nested_loop_compare_swap, nlcs_3, nlcs_2, if_compare).
code_shape_step(nested_loop_compare_swap, nlcs_4, nlcs_3, swap_via_temp).

code_shape_order(nested_loop_compare_swap, nlcs_1, 1).
code_shape_order(nested_loop_compare_swap, nlcs_2, 1).
code_shape_order(nested_loop_compare_swap, nlcs_3, 1).
code_shape_order(nested_loop_compare_swap, nlcs_4, 1).

code_shape_slot(nlcs_1, 0, "i").
code_shape_slot(nlcs_1, 1, "0").
code_shape_slot(nlcs_1, 2, "n").
code_shape_slot(nlcs_2, 0, "j").
code_shape_slot(nlcs_2, 1, "0").
code_shape_slot(nlcs_2, 2, "n - i").
code_shape_slot(nlcs_3, 0, "a[j]").
code_shape_slot(nlcs_3, 1, "{cmp}").
code_shape_slot(nlcs_3, 2, "a[j + 1]").
code_shape_slot(nlcs_4, 0, "a[j]").
code_shape_slot(nlcs_4, 1, "a[j + 1]").
code_shape_slot(nlcs_4, 2, "t").

% ── FORMA 2: la somma di un array ───────────────────────────────────────────
% Dichiarata SOLO qui, senza toccare una riga di C: e' la prova che il taglio
% regge. Usa `loop_up` che gia' esisteva piu' tre operazioni nuove, che sono
% una riga di `lang_syntax` ciascuna e valgono per qualunque altra forma.
code_shape_signature(sum_over_array, c, "int {name}(int a[], int n)").

code_shape_step(sum_over_array, soa_1, root,  declare_int).
code_shape_step(sum_over_array, soa_2, root,  loop_up).
code_shape_step(sum_over_array, soa_3, soa_2, accumulate).
code_shape_step(sum_over_array, soa_4, root,  return_value).

code_shape_order(sum_over_array, soa_1, 1).
code_shape_order(sum_over_array, soa_2, 2).
code_shape_order(sum_over_array, soa_3, 1).
code_shape_order(sum_over_array, soa_4, 3).

code_shape_slot(soa_1, 0, "s").
code_shape_slot(soa_1, 1, "0").
code_shape_slot(soa_2, 0, "i").
code_shape_slot(soa_2, 1, "0").
code_shape_slot(soa_2, 2, "n").
code_shape_slot(soa_3, 0, "s").
code_shape_slot(soa_3, 1, "a[i]").
code_shape_slot(soa_4, 0, "s").

% ── FORMA 3: concatenare due stringhe in memoria fresca ─────────────────────
% Dichiarata solo in KB, con le sei operazioni di M3. E' l'algoritmo da manuale
% — la stessa forma che sta dietro `strcat` non distruttivo, `String +` e
% qualunque `concat` — e non e' il compito di nessun banco: la si scrive per
% avere le operazioni, non per avere una risposta.
%
% Le due meta' che rendono onesta la forma, e che un template letterale non
% costringeva a nominare:
%   il trabocco si controlla PRIMA di allocare, non dopo
%   il puntatore nullo di malloc e' un caso, non una svista
code_shape_signature(concat_two, c, "char *{name}(const char *a, const char *b)").

code_shape_step(concat_two, ct_1, root,  declare_size).
code_shape_step(concat_two, ct_2, root,  declare_size).
code_shape_step(concat_two, ct_3, root,  if_cond).
code_shape_step(concat_two, ct_4, ct_3,  return_null).
code_shape_step(concat_two, ct_5, root,  alloc_bytes).
code_shape_step(concat_two, ct_6, root,  if_cond).
code_shape_step(concat_two, ct_7, ct_6,  return_null).
code_shape_step(concat_two, ct_8, root,  copy_bytes).
code_shape_step(concat_two, ct_9, root,  copy_bytes).
code_shape_step(concat_two, ct_10, root, set_index).
code_shape_step(concat_two, ct_11, root, return_value).

code_shape_order(concat_two, ct_1, 1).
code_shape_order(concat_two, ct_2, 2).
code_shape_order(concat_two, ct_3, 3).
code_shape_order(concat_two, ct_4, 1).
code_shape_order(concat_two, ct_5, 4).
code_shape_order(concat_two, ct_6, 5).
code_shape_order(concat_two, ct_7, 1).
code_shape_order(concat_two, ct_8, 6).
code_shape_order(concat_two, ct_9, 7).
code_shape_order(concat_two, ct_10, 8).
code_shape_order(concat_two, ct_11, 9).

code_shape_slot(ct_1, 0, "la").
code_shape_slot(ct_1, 1, "strlen(a)").
code_shape_slot(ct_2, 0, "lb").
code_shape_slot(ct_2, 1, "strlen(b)").
% il trabocco: la somma non deve superare quello che size_t puo' tenere, e il
% controllo sta PRIMA della malloc perche' dopo sarebbe gia' troppo tardi
code_shape_slot(ct_3, 0, "la > (size_t)-1 - lb - 1").
code_shape_slot(ct_5, 0, "out").
code_shape_slot(ct_5, 1, "la + lb + 1").
code_shape_slot(ct_6, 0, "out == NULL").
code_shape_slot(ct_8, 0, "out").
code_shape_slot(ct_8, 1, "a").
code_shape_slot(ct_8, 2, "la").
code_shape_slot(ct_9, 0, "out + la").
code_shape_slot(ct_9, 1, "b").
code_shape_slot(ct_9, 2, "lb").
code_shape_slot(ct_10, 0, "out").
code_shape_slot(ct_10, 1, "la + lb").
code_shape_slot(ct_10, 2, "0").
code_shape_slot(ct_11, 0, "out").

% ── M5: LA SECONDA LINGUA ───────────────────────────────────────────────────
% Il conto che il piano si era impegnato a rispettare: una lingua nuova costa
% UNA RIGA PER OPERAZIONE, e nessun algoritmo si riscrive. Qui sotto ci sono le
% operazioni che servono a `sum_over_array`, e la sua forma — l'albero dei passi
% e gli slot — non e' stata toccata di una virgola.
code_shape_signature(sum_over_array, python, "def {name}(a)").
lang_syntax(python, loop_up,      "for {0} in range({1}, len(a))").
lang_syntax(python, declare_int,  "{0} = {1}").
lang_syntax(python, accumulate,   "{0} = {0} + {1}").
lang_syntax(python, return_value, "return {0}").
