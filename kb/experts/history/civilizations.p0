% --- reusable inferences ---
civilization_topic($Polity) :- historical_polity($Polity, $Region, $Period, $Institution).
polity_in_region($Polity, $Region) :- historical_region($Polity, $Region).
polity_in_period($Polity, $Period) :- historical_period($Polity, $Period).
shares_historical_region($A, $B) :- historical_region($A, $Region), historical_region($B, $Region), dif($A, $B).
shares_historical_period($A, $B) :- historical_period($A, $Period), historical_period($B, $Period), dif($A, $B).
historical_institution($Polity, $Institution) :- historical_polity($Polity, $Region, $Period, $Institution).
historical_contribution($Polity, $Innovation) :- historical_innovation($Polity, $Innovation).
