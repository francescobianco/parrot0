% --- reusable inferences ---
anthropology_topic($Topic) :- anthropology_concept($Topic, $Domain).
concept_in_domain($Concept, $Domain) :- anthropology_concept($Concept, $Domain).
anthropologist_studies($Thinker, $Concept) :- anthropological_concept($Thinker, $Concept).
shares_anthropological_school($A, $B) :- anthropological_school($A, $School), anthropological_school($B, $School), dif($A, $B).
exchange_institution($Concept) :- anthropology_concept($Concept, exchange).
