% --- reusable inferences ---
visual_artwork($Work) :- artwork($Work, $Artist, $Movement, $Medium).
artwork_by($Work, $Artist) :- artist_of($Artist, $Work).
artist_in_movement($Artist, $Movement) :- artwork($Work, $Artist, $Movement, $Medium).
shares_art_movement($A, $B) :- artwork($A, $ArtistA, $Movement, $MediumA), artwork($B, $ArtistB, $Movement, $MediumB), dif($A, $B).
shares_art_medium($A, $B) :- artwork($A, $ArtistA, $MovementA, $Medium), artwork($B, $ArtistB, $MovementB, $Medium), dif($A, $B).
art_theme_in_work($Theme, $Work) :- artwork_theme($Work, $Theme).
