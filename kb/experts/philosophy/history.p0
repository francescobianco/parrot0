% --- reusable inferences ---
thinker_in_school($Thinker, $School) :- philosophical_school($Thinker, $School).
shares_philosophical_period($A, $B) :- philosophical_period($A, $Period), philosophical_period($B, $Period), dif($A, $B).
shares_philosophical_school($A, $B) :- philosophical_school($A, $School), philosophical_school($B, $School), dif($A, $B).
concept_by($Concept, $Thinker) :- philosophical_concept($Thinker, $Concept).
work_by_philosopher($Work, $Thinker) :- philosophical_work($Thinker, $Work).
ancient_philosopher($Thinker) :- philosophical_period($Thinker, ancient_greece).
ancient_philosopher($Thinker) :- philosophical_period($Thinker, ancient_china).
ancient_philosopher($Thinker) :- philosophical_period($Thinker, ancient_india).
modern_philosopher($Thinker) :- philosophical_period($Thinker, modern).
contemporary_philosopher($Thinker) :- philosophical_period($Thinker, contemporary).
