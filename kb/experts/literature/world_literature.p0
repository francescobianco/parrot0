% --- reusable inferences ---
literature_topic($Work) :- literary_work($Work, $Author, $Tradition, $Form).
work_by($Work, $Author) :- author_of($Author, $Work).
same_literary_tradition($A, $B) :- literary_work($A, $AuthorA, $Tradition, $FormA), literary_work($B, $AuthorB, $Tradition, $FormB), dif($A, $B).
shares_literary_theme($A, $B, $Theme) :- literary_theme($A, $Theme), literary_theme($B, $Theme), dif($A, $B).
epic_work($Work) :- literary_work($Work, $Author, $Tradition, epic).
novel_work($Work) :- literary_work($Work, $Author, $Tradition, novel).
translated_literature($Work) :- literary_work($Work, $Author, $Tradition, $Form), dif($Tradition, english).
author_in_tradition($Author, $Tradition) :- literary_work($Work, $Author, $Tradition, $Form).
