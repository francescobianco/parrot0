% laws.p0 — LE LEGGI FISICHE IN DUE FORME (gen505h).
%
% Missione: le connessioni fertili fra domini (LEARN_TODO). Il punto da
% dimostrare e' il passaggio dal SIGNIFICATO della legge al CALCOLO — e F. ha
% fissato il vincolo: **tutte e due le forme devono esistere**.
%
%   - la PROSA SINTETICA (`law_prose/2`) e' cio' che si puo' DIRE, e da cui il
%     thinking puo' rientrare come IR nella memoria;
%   - la STRUTTURA (`law_formula/3`) e' cio' che si puo' PERCORRERE: e' il
%     percorso di risoluzione, ed e' l'unica che risponde a «in quale formula e'
%     coinvolta la massa?». Dalla stringa quella domanda non e' inferibile, per
%     quanto la stringa sia ben scritta: nella prosa la massa e' una PAROLA, qui
%     e' un NODO.
%
% Le due non si duplicano a caso: sono legate dallo stesso nome di legge, e la
% prosa dice a parole cio' che l'albero dice a nodi. Se un giorno divergono, e'
% un difetto — non due opinioni.
%
% ⚠ Niente di quanto segue e' un'invenzione: sono le tre leggi elementari che
% ogni testo di fisica enuncia allo stesso modo. Le unita' sono SI.

% ⚠ NIENTE `file_attribute(machinery)` qui: dichiarerebbe macchineria OGNI testa
% del file, leggi comprese, e le nasconderebbe a «che cosa sai di X?» — cioe' al
% modo in cui una lezione si verifica. Solo le due viste derivate sono
% macchineria, e lo dicono da se'.

% ⚠ IL MARCATORE SEGUE LA DISTINZIONE DI F., NON LA COMODITA'.
%
% La STRUTTURA e' «il percorso neurale nella risoluzione»: si percorre, non si
% dice. Marcarla `machinery/1` non la nasconde al solutore — `law_involves` ci
% cammina sopra lo stesso — la toglie soltanto da cio' che parrot0 RACCONTA di
% sapere, ed e' giusto: a chi chiede «che cos'e' la legge di Ohm» non si risponde
% «law_formula(ohms_law, voltage, product(current, resistance))».
%
% La PROSA, le unita' e i simboli restano conoscenza del mondo: sono cio' che si
% dice, e cio' su cui si verifica una lezione.
%
% (Prima avevo messo `file_attribute(machinery)` in testa: dichiarava macchineria
% OGNI testa del file, prosa compresa, e la legge diventava irraggiungibile da
% «che cosa sai di X?». Una dichiarazione difensiva costa una capacita'.) Una legge, la sua formulazione e le unita'
% di una grandezza sono conoscenza del MONDO: dichiararle macchineria le nasconde
% a «che cosa sai di X?» — che e' proprio il modo in cui si verifica una lezione
% — e le toglie dal conteggio di cio' che parrot0 sa. Ci sono cascato scrivendo
% questo file: la dichiarazione difensiva costa una capacita'.
machinery(law_involves).
machinery(expr_uses).
machinery(law_formula).
machinery(law_defines).
machinery(law_surface).   % e' un indice per la domanda, non un fatto sul mondo

% ── 1. LA STRUTTURA — l'espressione e' un ALBERO, non un testo ─────────────
law_defines(newtons_second_law, force).
law_formula(newtons_second_law, force, product(mass, acceleration)).

law_defines(ohms_law, voltage).
law_formula(ohms_law, voltage, product(current, resistance)).

law_defines(kinetic_energy_law, kinetic_energy).
law_formula(kinetic_energy_law, kinetic_energy, product(half, product(mass, square(velocity)))).

law_defines(density_law, density).
law_formula(density_law, density, quotient(mass, volume)).

% ── 2. LA PROSA — cio' che si puo' dire, e da cui si puo' rientrare ────────
law_prose(newtons_second_law, "the law that force equals mass times acceleration").
law_prose(ohms_law, "the law that voltage equals current times resistance").
law_prose(kinetic_energy_law, "the law that kinetic energy equals half of mass times velocity squared").
law_prose(density_law, "the law that density equals mass divided by volume").

% Apprese in conversazione il 2026-09-06 con «learn italian definition of ...»
% e /save; ricollocate qui dalla ricaduta learned.p0, senza cambiarne il testo.
% Per Ohm: OpenStax, University Physics Volume 2, 9.4 (formulazione nostra).
% https://openstax.org/books/university-physics-volume-2/pages/9-4-ohms-law
italian_description(ohms_law, "La legge di Ohm lega tensione corrente e resistenza nei conduttori ohmici a temperatura costante: V = I * R. La tensione si misura in volt, la corrente in ampere e la resistenza in ohm").
italian_description(newtons_second_law, "La seconda legge di Newton lega la forza risultante alla massa e alla accelerazione: F = m * a, per massa costante in un sistema inerziale").
italian_description(kinetic_energy_law, "La energia cinetica di un corpo di massa m e velocita v vale E = 0.5 * m * v * v nel regime non relativistico").
italian_description(density_law, "La densita media di un corpo si calcola dividendo la massa per il volume: rho = m / V. Il volume deve essere positivo").

law_surface(newtons_second_law, "newtons second law").
law_surface(ohms_law, "ohms law").
law_surface(kinetic_energy_law, "kinetic energy law").
law_surface(density_law, "density law").

% L'indice delle leggi alimenta il risolutore comune dei nomi: la legge intera
% precede le traduzioni/definizioni di una singola parola al suo interno.
entity_alias($Surface, $Law) :- law_surface($Law, $Surface).

% ── 3. IL PERCORSO — che cosa una legge COINVOLGE ──────────────────────────
% E' la vista che risponde alla domanda di F., e non e' inferibile dalla prosa:
% richiede che la grandezza sia un nodo dell'albero.
% gen513 — l'algebra delle espressioni e' in kb/core/model-bridge.p0: non
% parlava di fisica, parlava di alberi, e finche' e' stata qui nessun altro
% dominio ha potuto usarla. Qui resta la sola cosa che e' davvero di fisica:
% in questo dominio una VARIABILE di un modello e' una grandezza che ha
% un'unita'.
model_variable($Q) :- quantity_unit($Q, $U).

law_involves($Law, $Q) :- law_defines($Law, $Q).
law_involves($Law, $Q) :- law_formula($Law, $Out, $Expr), expr_uses($Expr, $Q).

% ── 3-bis. LE SUPERFICI DELLA DOMANDA — fatti, non rami ────────────────────
% `answer_frame(Superficie, Relazione)`: una domanda che contiene la superficie
% interroga la relazione. E' il meccanismo che cresce per FATTI (grammar.p0:771
% lo deriva perfino dalle relazioni insegnate a voce), quindi una domanda nuova
% su queste leggi non costa un ramo in C.
answer_frame(involves, law_involves).
answer_frame(involve, law_involves).
answer_frame("coinvolge", law_involves).
answer_frame("says", law_prose).
answer_frame("states", law_prose).
answer_frame("dice", law_prose).
answer_frame("computes", law_defines).
answer_frame("calculates", law_defines).
answer_frame("calcola", law_defines).
% gen505h — la superficie che chiede il CALCOLO invece del significato.
answer_frame("expression", law_expression).
answer_frame("expression_of", law_expression).
answer_frame("espressione", law_expression).

% ── 4. LE GRANDEZZE — unita' e simbolo, in SI ──────────────────────────────
quantity_unit(force, newton).            quantity_symbol(force, "F").
quantity_unit(mass, kilogram).           quantity_symbol(mass, "m").
quantity_unit(acceleration, metre_per_second_squared). quantity_symbol(acceleration, "a").
quantity_unit(voltage, volt).            quantity_symbol(voltage, "V").
quantity_unit(current, ampere).          quantity_symbol(current, "I").
quantity_unit(resistance, ohm).          quantity_symbol(resistance, "R").
quantity_unit(kinetic_energy, joule).    quantity_symbol(kinetic_energy, "E").
quantity_unit(velocity, metre_per_second). quantity_symbol(velocity, "v").
quantity_unit(density, kilogram_per_cubic_metre). quantity_symbol(density, "rho").
quantity_unit(volume, cubic_metre).      quantity_symbol(volume, "V").

% ── 5. IL PONTE VERSO IL CODICE (gen505h) ──────────────────────────────────
%
% Il punto della missione: dal SIGNIFICATO della legge al CALCOLO. E il ponte non
% e' una seconda macchineria — e' un fold sull'albero che gia' c'e', con gli
% operatori che gia' esistono (`code_operator/2`, kb/experts/programming/
% compose.p0, dove `product` vale gia' `*`).
%
% Una legge nuova non costa una riga di codice: costa i suoi fatti, e da quel
% momento e' insieme spiegabile, calcolabile e SCRIVIBILE. Un operatore nuovo e'
% un fatto in `compose.p0`, e vale per tutte le leggi che lo usano.
machinery(code_expr).
machinery(law_expression).
machinery(law_signature).

% gen513 — `code_expr/2`, `code_binary/4`, `code_infix/4` sono in
% kb/core/model-bridge.p0. La sola costante di questo dominio resta qui.
code_literal(half, "0.5").

% L'espressione di una legge, pronta da mettere dopo un `return`.
law_expression($Law, $T) :- law_formula($Law, $Out, $E), code_expr($E, $T).

% ── 6. DAL CALCOLO AL CODICE MOSTRATO (gen512) ──────────────────────────────
%
% «show me the python code that computes newtons second law»: il lettore delle
% richieste di artefatti (60-agent-tools.c) risolve la cosa nominata e chiede
% qui due cose generali, che non sanno niente di fisica ne' di Python:
%   `artifact_shape_for(Cosa, Forma)`  — quale forma di codice la calcola;
%   `artifact_binding(Cosa, Buco, V)`  — i valori dei buchi di quella forma
%                                        (piu' valori per lo stesso buco: una lista).
% La forma e la sua resa in ogni lingua stanno in code_shapes.p0. Una legge
% nuova diventa codice mostrabile nel momento in cui ha la sua formula.
% ⛔ gen513 — QUESTE QUATTRO RIGHE SAPEVANO IL NOME `law_formula`, ED E' PER
% QUESTO CHE NESSUN ALTRO DOMINIO POTEVA DIVENTARE CODICE. Adesso il ponte sta
% in kb/core/model-bridge.p0 e non conosce nessun predicato: chiede alla KB
% quali portano un modello. Di fisica qui resta UN FATTO.
%
%   (era: artifact_shape_for($Law, formula_function) :- law_formula($Law,…).
%         artifact_binding($Law, name, $Out) :- law_defines($Law, $Out).  …)
machinery(model_carrier).
machinery(model_variable).
model_carrier(law_formula).
machinery(artifact_description).
% Una cosa senza formula si sa comunque DIRE: l'arresto lo dice.
artifact_description($Law, $P) :- law_prose($Law, $P).

% ── 7. LE ALTRE LEGGI DI NEWTON (gen512) ────────────────────────────────────
% Chi chiede «il codice della legge di Newton» puo' intendere una qualunque
% delle tre leggi del moto o la gravitazione universale. Sono gli enunciati di
% ogni testo di fisica (formulazione nostra; SI).
%
% La prima legge (inerzia) non ha una grandezza da calcolare: si sa dire, non
% scrivere come funzione, e l'arresto lo spiega invece di inventarne una.
law_prose(newtons_first_law, "the law that a body stays at rest or keeps moving at constant velocity unless a net force acts on it").
law_surface(newtons_first_law, "newtons first law").
%
% La terza legge: la forza di reazione e' uguale e opposta a quella d'azione.
law_defines(newtons_third_law, reaction_force).
law_formula(newtons_third_law, reaction_force, negation(action_force)).
law_prose(newtons_third_law, "the law that for every action force there is an equal and opposite reaction force").
law_surface(newtons_third_law, "newtons third law").
quantity_unit(reaction_force, newton).
quantity_unit(action_force, newton).
%
% La gravitazione universale: F = G * m1 * m2 / r^2, con G costante.
law_defines(newtons_law_of_universal_gravitation, gravitational_force).
law_formula(newtons_law_of_universal_gravitation, gravitational_force, quotient(product(gravitational_constant, product(mass_1, mass_2)), square(distance))).
law_prose(newtons_law_of_universal_gravitation, "the law that two masses attract each other with a force equal to G times the product of the masses divided by the square of their distance").
law_surface(newtons_law_of_universal_gravitation, "newtons law of universal gravitation").
law_surface(newtons_law_of_universal_gravitation, "law of universal gravitation").
quantity_unit(gravitational_force, newton).   quantity_symbol(gravitational_force, "F").
quantity_unit(mass_1, kilogram).              quantity_symbol(mass_1, "m1").
quantity_unit(mass_2, kilogram).              quantity_symbol(mass_2, "m2").
quantity_unit(distance, metre).               quantity_symbol(distance, "r").
code_literal(gravitational_constant, "6.674e-11").
%
% ── I NOMI con cui le leggi si chiedono, nelle lingue in cui si chiedono ────
% Sono nomi veri, non parafrasi inventate. Le chiavi si scrivono senza apostrofo
% («newtons»): il lettore delle richieste prova anche la parola senza apostrofo
% e senza possessivo, quindi «newton's», «newton’s» e «newton» ci arrivano.
% ⚠ SCELTA DICHIARATA: «newton's law» / «legge di newton» senza numero vale la
% SECONDA legge (F = m·a), che e' l'uso comune; la gravitazione ha i suoi nomi.
law_surface(newtons_second_law, "newtons law").
law_surface(newtons_second_law, "newton law").
law_surface(newtons_second_law, "second law of motion").
law_surface(newtons_second_law, "newtons second law of motion").
law_surface(newtons_second_law, "second law of newton").
law_surface(newtons_second_law, "fundamental law of dynamics").
law_surface(newtons_second_law, "seconda legge di newton").
law_surface(newtons_second_law, "secondo principio della dinamica").
law_surface(newtons_second_law, "seconda legge della dinamica").
law_surface(newtons_second_law, "legge fondamentale della dinamica").
law_surface(newtons_second_law, "legge di newton").
law_surface(newtons_second_law, "segunda ley de newton").
law_surface(newtons_second_law, "ley de newton").
law_surface(newtons_second_law, "deuxième loi de newton").
law_surface(newtons_second_law, "deuxieme loi de newton").
law_surface(newtons_second_law, "loi de newton").
law_surface(newtons_second_law, "principe fondamental de la dynamique").
law_surface(newtons_second_law, "zweites newtonsches gesetz").
law_surface(newtons_second_law, "zweite newtonsche gesetz").
law_surface(newtons_second_law, "zweiten newtonschen gesetz").
law_surface(newtons_second_law, "newtonsches gesetz").
law_surface(newtons_second_law, "segunda lei de newton").
law_surface(newtons_second_law, "newton second law").
% Le forme con l'apostrofo, dritto e tipografico: il risolutore delle richieste
% prova le varianti da se', ma le cue di superficie del frame del turno si
% cercano come sono scritte.
law_surface(newtons_second_law, "newton's second law").
law_surface(newtons_second_law, "newton’s second law").
law_surface(newtons_second_law, "newton's law").
law_surface(newtons_second_law, "newton’s law").
law_surface(newtons_second_law, "newton's 2nd law").
law_surface(newtons_first_law, "newton's first law").
law_surface(newtons_third_law, "newton's third law").
law_surface(newtons_law_of_universal_gravitation, "newton's law of universal gravitation").
law_surface(newtons_second_law, "newtons 2nd law").
law_surface(newtons_second_law, "newton 2nd law").
law_surface(newtons_second_law, "2nd law of motion").
% La forza di gravita' si chiede anche per GRANDEZZA, e per grandezze
% «forza» porterebbe alla seconda legge: il nome composto la porta dove deve.
law_surface(newtons_law_of_universal_gravitation, "gravitational force").
law_surface(newtons_law_of_universal_gravitation, "force of gravity").
law_surface(newtons_law_of_universal_gravitation, "gravity force").
law_surface(newtons_law_of_universal_gravitation, "forza di gravità").
law_surface(newtons_law_of_universal_gravitation, "forza di gravita").
law_surface(newtons_law_of_universal_gravitation, "forza gravitazionale").
law_surface(newtons_law_of_universal_gravitation, "fuerza de gravedad").
law_surface(newtons_law_of_universal_gravitation, "force de gravitation").
law_surface(newtons_first_law, "first law of motion").
law_surface(newtons_first_law, "law of inertia").
law_surface(newtons_first_law, "prima legge di newton").
law_surface(newtons_first_law, "principio di inerzia").
law_surface(newtons_first_law, "primera ley de newton").
law_surface(newtons_first_law, "première loi de newton").
law_surface(newtons_first_law, "premiere loi de newton").
law_surface(newtons_first_law, "erstes newtonsches gesetz").
law_surface(newtons_third_law, "third law of motion").
law_surface(newtons_third_law, "terza legge di newton").
law_surface(newtons_third_law, "principio di azione e reazione").
law_surface(newtons_third_law, "tercera ley de newton").
law_surface(newtons_third_law, "troisième loi de newton").
law_surface(newtons_third_law, "troisieme loi de newton").
law_surface(newtons_third_law, "drittes newtonsches gesetz").
law_surface(newtons_law_of_universal_gravitation, "newtons law of gravitation").
law_surface(newtons_law_of_universal_gravitation, "law of gravitation").
law_surface(newtons_law_of_universal_gravitation, "universal gravitation").
law_surface(newtons_law_of_universal_gravitation, "legge di gravitazione universale").
law_surface(newtons_law_of_universal_gravitation, "gravitazione universale").
law_surface(newtons_law_of_universal_gravitation, "ley de gravitacion universal").
law_surface(newtons_law_of_universal_gravitation, "ley de gravitación universal").
law_surface(newtons_law_of_universal_gravitation, "loi de la gravitation universelle").
law_surface(newtons_law_of_universal_gravitation, "gravitationsgesetz").
law_surface(ohms_law, "legge di ohm").
law_surface(kinetic_energy_law, "energia cinetica").
law_surface(density_law, "legge della densità").
law_surface(density_law, "densità").

% Una richiesta di codice che non nomina la lingua: si scrive in Python.
machinery(artifact_default_language).
artifact_default_language(python).

% L'opposto di una grandezza: una forma nuova dell'albero, resa e percorsa.
code_expr(negation($A), $T) :- code_expr($A, $TA), concat_atoms("(-", $TA, $X), concat_atoms($X, ")", $T).
expr_uses(negation($A), $Q) :- expr_uses($A, $Q).
