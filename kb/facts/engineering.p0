% engineering.p0 — LA TECNICA: elettronica, materiali, meccanica, produzione.
%
% Nata il 23 settembre 2026 dalla ricaduta di learned.p0: fatti insegnati
% parlando nelle iterazioni di riferimento (docs/labs/reference-iterations/,
% RI-012..RI-014 — «Capacitors block direct current.», «Austenitic stainless
% steel is a steel.», «Pumps move fluid.») e nella lettura della prosa tecnica,
% che nessun parente nell'albero sapeva ospitare. L'asse e' la materia, come per
% minerals.p0 e units.p0.

block(capacitors, direct_current).
pass(capacitors, alternating_current).
produce(rectifiers, direct_current).
supply(batteries, direct_current).
limits(kanban, work_in_progress).
steel(austenitic_stainless_steel).
magnetic(ferritic_stainless_steel).
process(shielded_metal_arc_welding).
move(pumps, fluid).
part(plate).
carry(plates, load).

% 23 settembre 2026 — lezioni dette parlando, prima in kb/learning/ (un file
% per canale di provenienza); qui accanto ai loro simili (F.: «per similarita'
% piu' che per storia»). La provenienza resta nei fatti di provenienza.
% 23 settembre 2026, dalla ricaduta di learned.p0: le negazioni, che /save scrive sempre
% nella ricaduta (kb_save_routed non le instrada; vedi learned.p0).
not(magnetic(austenitic_stainless_steel)).
class_surface(process, process).
class_surface(part, part).

% RI-016 (23 settembre 2026) — chi alza e chi abbassa la tensione. Il flyback
% di un CRT porta la tensione anodica a decine di kV; un convertitore buck
% abbassa una tensione continua. (F.: «esistono anche trasformatori step up»:
% «a transformer steps down the voltage» come verita' generale e' falsa.)
step_up(flyback_transformer, voltage).
step_down(buck_converter, voltage).
step_down(step-down_transformer, voltage).

% RI-017 (23 settembre 2026) — termini tecnici col trattino, letti interi dopo
% la lezione «"-" is a word joiner». Un interruttore bipolare apre entrambi i
% conduttori; un guanto resistente al calore protegge la mano.
disconnect(double-pole_switch, both_conductors).
protects(heat-resistant_glove, hand).

% 26 settembre 2026 — live teaching, sicurezza sui cantieri
% (docs/sessions/live/2026-09-26-cantieri.log): i dispositivi di protezione
% detti con il loro complemento («a hard hat protects the head from falling
% objects»); il complemento resta leggibile («What does a hard hat protect the
% head from?» → Falling objects). «safety boots protect» e «guardrails protect»
% erano usciti dal /save come protect/2: qui una sola relazione (mantra #3).
protects(hard_hat, head).
protects(hearing_protection, ears).
protects(safety_boots, feet).
protects(guardrails, workers).

% RI-018 (23 settembre 2026) — valori nominali, insegnati con la forma «the R of
% X is V» dopo «operating voltage / rated current is a relation»: la porta USB
% (5 V), la batteria d'auto (12 V), il fusibile di una spina britannica (13 A).
operating_voltage_of(usb_port, 5_volts).
operating_voltage_of(car_battery, 12_volts).
rated_current_of(plug_fuse, 13_amperes).

% RI-019 (24 settembre 2026) — valori di scheda tecnica il cui nome di relazione
% finisce con una parola che e' anche un verbo («point», «load»), insegnati con
% «flash point / working load is a relation» e poi «the R of X is V»: il punto
% di infiammabilita' del Jet A (38 °C, ASTM D1655), il carico di lavoro di un
% golfare M10 (230 kg, DIN 580).
flash_point_of(jet_a_fuel, 38_degrees_celsius).
working_load_of(m10_eye_bolt, 230_kilograms).

% 26 settembre 2026 — live teaching, sicurezza sui cantieri: l'altezza minima
% sopra cui serve la protezione anticaduta (2 m: D.Lgs. 81/2008 art. 107, lavoro
% in quota), insegnata con «the minimum height of fall protection is 2 meters»
% (con «for» la forma non legge). «Workers need fall protection above 2 meters»
% ha perso il complemento: resta il fatto nudo. Interrogabile («What is the
% minimum height of fall protection?» → 2 meters); NON ancora confrontabile
% («Is fall protection required at 3 meters?»): il comparatore non vede le
% quantita' con unita' — vedi docs/sessions/2026-09-26-live-cantieri.md.
minimum_height_of(fall_protection, 2_meters).
need(workers, fall_protection).
