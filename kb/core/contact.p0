% contact.p0 — L3: imparare una lettura per contatto (docs/plans/l3-upgrade.md §21).
%
% Nessuna forma, nessun marcatore. Dopo la risposta la KB guarda il turno e
% chiede: c'e' una relazione R(S, O) che la KB gia' tiene, i cui due ruoli il
% turno nomina, e che cosa resta NON SPIEGATO una volta tolti i ruoli, le parole
% funzionali e le parole con cui la KB gia' legge R? Se entrambi i ruoli
% ricompaiono (O ripetuto, S ripreso da un riferimento) e resta una parola piena
% sola, N, nasce un EPISODIO: «N potrebbe nominare R». Il connettivo («so», «;»,
% «and»), l'ordine delle porzioni e la forma della seconda non contano.
%
% Un episodio e' un'ipotesi, non un fatto: la lettura resta qualificata.
% Il conteggio distingue episodi, NON certifica indipendenza (§26 del piano).
% Letture concorrenti restano visibili ma sospese; il ritiro e' uno strato
% che si aggiunge (§19), non una cancellazione.

:- file_attribute(machinery).

machinery(contact_episode).
machinery(contact_episode_here).
machinery(contact_residual).
machinery(contact_unexplained).
machinery(contact_relation_word).
machinery(contact_refers_here).
machinery(contact_bridge).
machinery(contact_bridge_withdrawn).
machinery(contact_support).
machinery(contact_gloss).
% (prima il contabile della provenienza: l'osservazione di un episodio puo'
% cosi' vedere quali fatti del turno sono stati letti con un'ipotesi)
after_reply_bookkeeper(contact_reading).
after_reply_bookkeeper(contact).

% ── L'OSSERVAZIONE, dopo la risposta ───────────────────────────────────────
turn_after_reply($T, contact) :-
    contact_episode_here($T, $N, $R, $E), contact_store($T, $N, $R, $E).
machinery(contact_store).
contact_store($T, $N, $R, $E) :-
    naf(contact_negated($T)),
    naf(contact_episode($N, $R, $E)),
    contact_independent_here($T, $N, $R),
    assert(contact_episode, $N, $R, $E),
    contact_store_shape($T, $N, $R, $E),
    contact_note_via($T, $N, $R, $E).
% ⛔ §14.4 — L'USO NON E' CONFERMA. Un episodio sostiene «N nomina R» solo se
% R(S, O) nel turno non puo' essere il prodotto di quella stessa ipotesi.
% «The Geburtsort of Kant is Konigsberg, so his Geburtsort is Konigsberg» e'
% letto attraverso il ponte, scrive born_in(kant, konigsberg), e poi lo
% ritrovava come ancora: un secondo sostegno fabbricato da se' (audit-crescita).
% L'ancora e' indipendente se l'ipotesi non esisteva ancora (allora il fatto
% non poteva venire da lei), o se il turno dice R anche con una parola piena
% che la KB leggeva come R per altra via («born» in «was born in»).
% Limite dichiarato: senza la provenienza per fatto, un fatto che la KB aveva
% gia' prima del turno, ripetuto col solo N, non conta (prudenza, non verita').
% L'uso resta visibile come tale: `contact_use/3`, mai contato.
machinery(contact_independent_here).
machinery(contact_independent_word).
machinery(contact_use).
contact_independent_here($T, $N, $R) :- naf(contact_proposed_word($N, $R)).
contact_independent_here($T, $N, $R) :- contact_independent_word($T, $R, $W).
contact_independent_word($T, $R, $W) :-
    contact_token($T, $I, $W), naf(word_is_function_word($W)), contact_explained_before($R, $W).
contact_store($T, $N, $R, $E) :-
    naf(contact_negated($T)),
    naf(contact_independent_here($T, $N, $R)),
    naf(contact_use($N, $R, $E)),
    assert(contact_use, $N, $R, $E).
% LA FORMA in cui la parola e' comparsa decide in quale conoscenza della lingua
% entra (§24): dopo un possessivo che riferisce e' un NOME di relazione («his
% Geburtsort is Ulm»); dopo un soggetto che riferisce e' un VERBO, con le parole
% fino al valore («he hails from Ulm» → «@S hails from @O»). Una forma che non si
% riconosce lascia l'episodio senza lessico: un'ipotesi che non parla, dichiarata.
machinery(contact_shape).
machinery(contact_store_shape).
machinery(contact_shape_here).
machinery(contact_span_to).
contact_store_shape($T, $N, $R, ep($S, $O, $Of)) :-
    contact_shape_here($T, $N, $O, $Shape0), contact_shape_known($R, $Shape0, $Shape),
    naf(contact_shape($N, $R, $Shape)),
    assert(contact_shape, $N, $R, $Shape).
contact_store_shape($T, $N, $R, ep($S, $O, $Of)) :-
    contact_shape_here($T, $N, $O, $Shape0), contact_shape_known($R, $Shape0, $Shape),
    contact_shape($N, $R, $Shape).
% La lettura nota di R si prende QUI, all'osservazione, e si conserva dentro la
% forma del verbo. Chiesta dentro `construction_frame/3` faceva leggere a
% `extract_frame` se stessa mentre si definiva: un cortocircuito che rifiutava
% cinque viste e bloccava il boot (§25). Chi osserva sta fuori da ogni vista.
machinery(contact_shape_known).
contact_shape_known($R, noun, noun).
contact_shape_known($R, verb($Mid), verb($Mid, $K)) :- contact_known_frame($R, $K).
contact_store_shape($T, $N, $R, ep($S, $O, $Of)) :-
    naf(contact_some_shape_here($T, $N, $O)).
machinery(contact_some_shape_here).
contact_some_shape_here($T, $N, $O) :- contact_shape_here($T, $N, $O, $Shape).
contact_shape_here($T, $N, $O, noun) :-
    contact_token($T, $I, $N), input_node_next($T, $P, $I),
    contact_token($T, $P, $Ref), referring_possessive($Ref).
contact_shape_here($T, $N, $O, verb($Mid)) :-
    contact_token($T, $I, $N), input_node_next($T, $P, $I),
    contact_token($T, $P, $Ref), entity_pronoun($Ref), naf(referring_possessive($Ref)),
    atom_words($O, $OWs), contact_last_word($OWs, $OW),
    contact_span_to($T, $I, $OW, $Mid).
contact_span_to($T, $I, $OW, nil) :- contact_token($T, $I, $OW).
contact_span_to($T, $I, $OW, cons($W, $Rest)) :-
    contact_token($T, $I, $W), dif($W, $OW),
    input_node_next($T, $I, $J), contact_span_to($T, $J, $OW, $Rest).
% LA POLARITA' (ritiro per contatto, §21.7a). Lo stesso allineamento in un turno
% che NEGA non e' un sostegno: e' un controesempio. «Milan is in Italy, but Milan
% is not its capital» dice che la coppia per cui R vale NON e' N: l'ipotesi «N
% nomina R» cade. Non c'e' una forma per «no» o per «but»: la negazione e' la
% classe che la KB gia' conosce (`negation_marker/1`), o una contrazione che la
% KB sa espandere in una negazione (`function_word("isn't", "is not")`).
% Il controesempio si AGGIUNGE (§19): gli episodi restano, e restano leggibili.
% (si chiede DOPO l'allineamento: provata a ogni turno, prima del cancello,
% costava 2 s sul soft-test — misurato)
contact_store($T, $N, $R, $E) :-
    contact_negated($T),
    naf(contact_counter($N, $R, $E)),
    assert(contact_counter, $N, $R, $E).
machinery(contact_negated).
machinery(contact_counter).
machinery(contact_contraction).
machinery(contact_contraction_part).
contact_contraction_part($T, $I) :- contact_contraction($T, $I, $J, $E).
contact_contraction_part($T, $J) :- contact_contraction($T, $I, $J, $E).
contact_negated($T) :- contact_token($T, $I, $W), negation_marker($W).
contact_negated($T) :- contact_contraction($T, $I, $J, $E), atom_words($E, $Ws), member($M, $Ws), negation_marker($M).
% «isn't» arriva alla IR come due token, `isn` e `t`: sono una contrazione se la
% KB ne conosce l'espansione.
contact_contraction($T, $I, $J, $E) :-
    contact_token($T, $J, t), input_node_next($T, $I, $J), input_node_atom($T, $I, $W),
    concat_atoms($W, "'t", $F), function_word($F0, $E), concat_atoms($F0, "", $F).
% (si enumera e si confronta il testo: un argomento legato non combacia con un
% fatto scritto fra virgolette, `function_word("isn't", …)`)

% I ruoli: due entita' della IR del turno per cui la KB tiene gia' R(S, O).
% Le relazioni candidate sono quelle che la KB sa leggere (`extract_frame/2`):
% una relazione senza lettura non ha niente da allineare.
contact_episode_here($T, $N, $R, $E) :-
    contact_alignment_here($T, $R, $E, $Ws), eq_list_one($Ws, $N).
% L'allineamento (ruoli, relazione tenuta, residuo) e' separato dalla scelta del
% residuo: con una parola e' un episodio; con piu' parole e' un contatto QUASI
% riuscito, che si conserva (I5, piu' sotto).
machinery(contact_alignment_here).
contact_alignment_here($T, $R, ep($S, $O, $Of), $Ws) :-
    contact_refers_here($T), contact_repeated_word($T, $W),
    input_scope_language($T, $L),
    findall($E, input_entity_node($T, $L, $I, $E), $Es),
    contact_role_pair($Es, $W, pair($S, $O), $Of), contact_readable_relation($R),
    kb_fact($R, cons($S, cons($O, nil))),
    contact_residual($T, rel($R, $S, $O), $Ws).
% Le relazioni che la KB sa leggere. Cambiano solo quando cambiano i lettori,
% quindi si congelano come `extract_frame/2` (grammar.p0): raccolte a ogni turno
% costavano 200 ms, ricalcolate per ogni coppia di ruoli 1 s (misurato). Si
% enumerano, non si raccolgono: una lista di ~400 nomi dentro la sostituzione
% esauriva i legami, e la composizione «non trovava niente» (pezzi verdi uno a uno).
% ⚠ Si chiede il FATTO (`kb_fact/2`, il solo bucket della relazione), non la
% prova: `apply/2` su ~400 relazioni, alcune definite da regole profonde, costava
% 5 s su «Marie Curie was born in Warsaw; …» (misurato). Limite dichiarato: una
% relazione che la KB DERIVA e non tiene come fatto non fa ancora da ancora.
machinery(contact_readable_relation).
contact_readable_relation($R) :- extract_frame($P, $R).
materialized_view(contact_readable_relation, 1).
view_depends(contact_readable_relation, extract_frame).
machinery(eq_list_one).
eq_list_one(cons($N, nil), $N).

% ENTRAMBI i ruoli ricompaiono: un ruolo nominato due volte (la parola ripetuta
% e' la sua ultima), l'altro nominato e ripreso da una parola che riferisce. Il
% possessore del nome e' quello ripreso. Una sola menzione per ruolo («Einstein,
% a physicist, was born in Ulm») non e' un contatto: l'inciso non ripete la
% relazione. Le entita' si raccolgono UNA volta: `input_entity_node/4` e' cara, e
% rivalutata dentro un doppio ciclo costava 45 s a turno (misurato).
machinery(contact_role_pair).
machinery(contact_entity_ends).
contact_role_pair($Es, $W, pair($S, $O), s) :-
    member($O, $Es), contact_entity_ends($O, $W), member($S, $Es), dif($S, $O).
contact_role_pair($Es, $W, pair($S, $O), o) :-
    member($S, $Es), contact_entity_ends($S, $W), member($O, $Es), dif($S, $O).
contact_entity_ends($E, $W) :- atom_words($E, $Ws), contact_last_word($Ws, $W).
machinery(contact_token).
contact_token($T, $I, $W) :- input_node($T, $I, node(token, token, $P), $R), input_node_atom($T, $I, $W).
machinery(contact_last_word).
contact_last_word(cons($W, nil), $W).
contact_last_word(cons($A, cons($B, $R)), $W) :- contact_last_word(cons($B, $R), $W).
% il cancello economico, prima di enumerare le relazioni: una parola piena che
% il turno dice due volte
machinery(contact_repeated_word).
contact_repeated_word($T, $W) :-
    contact_token($T, $I, $W), contact_token($T, $J, $W), lt($I, $J),
    naf(word_is_function_word($W)).
contact_refers_here($T) :- contact_token($T, $I, $W), referring_possessive($W).
contact_refers_here($T) :- contact_token($T, $I, $W), entity_pronoun($W).

% Il residuo: le parole piene del turno che niente spiega.
contact_residual($T, rel($R, $S, $O), $Ws) :-
    findall($W, contact_unexplained($T, rel($R, $S, $O), $W), $Ws).
contact_unexplained($T, rel($R, $S, $O), $W) :-
    contact_token($T, $I, $W),
    naf(contact_contraction_part($T, $I)),
    naf(word_is_function_word($W)), naf(word_is_number($W)),
    naf(referring_possessive($W)), naf(entity_pronoun($W)),
    atom_words($S, $SW), naf(member($W, $SW)),
    atom_words($O, $OW), naf(member($W, $OW)),
    naf(contact_explained_before($R, $W)),
    naf(contact_instrument_word($W)).
% Una parola che la KB legge come R SOLO perche' un contatto l'ha proposta non e'
% «gia' saputa»: ritrovarla in un contatto nuovo e' una CONFERMA, non una
% spiegazione. Senza questa distinzione, dopo il §24 (l'ipotesi entra nel
% lessico) il secondo episodio non nasceva e l'ipotesi restava qualificata per
% sempre.
machinery(contact_explained_before).
machinery(contact_proposed_word).
contact_explained_before($R, $W) :- contact_relation_word($R, $W), naf(contact_proposed_word($W, $R)).
contact_proposed_word($W, $R) :- contact_episode($W, $R, $E).
% Le parole con cui la KB legge gia' R: se il nome e' fra queste, il ponte c'e'
% gia' e il contatto non insegna niente.
contact_relation_word($R, $W) :- extract_frame($P, $R), atom_words($P, $Ws), member($W, $Ws).

% ── L'IPOTESI E IL SUO USO ─────────────────────────────────────────────────
% Proporre non e' scegliere. Due significati della stessa superficie possono
% essere polisemia o un allineamento sbagliato: senza contesto discriminante
% nessuno dei due autorizza un ponte GLOBALE. Prima, il lettore sceglieva per
% ordine e la premessa poteva dire «was born in» davanti a «wood pulp».
% Le alternative non si cancellano: un controesempio pertinente sospende una
% candidata e rende di nuovo usabile l'altra, nello stesso lessico condiviso.
machinery(contact_candidate).
machinery(contact_competing).
contact_candidate($N, $R) :-
    contact_episode($N, $R, $E), naf(contact_bridge_withdrawn($N, $R)),
    naf(contact_countered($N, $R)).
contact_competing($N, $R) :- contact_candidate($N, $Other), dif($Other, $R).
contact_bridge($N, $R) :- contact_candidate($N, $R), naf(contact_competing($N, $R)).
% Una domanda sulla parola sospesa deve nominare l'incertezza, non fingere
% che gli episodi siano spariti. Le affermazioni restano osservabili: possono
% proprio portare il controesempio che distingue le letture.
machinery(turn_contact_ambiguous).
turn_contact_ambiguous($T) :-
    contact_candidate($N, $R), contact_competing($N, $R),
    turn_illocution($T, question), input_node_atom($T, $I, $W), contact_word_form($N, $W).
turn_plan_candidate($T) :- turn_contact_ambiguous($T).
turn_priority_response($T, $Text) :-
    turn_contact_ambiguous($T), current_language($L), response_template(contact_ambiguous, $L, $Text).
response_template(contact_ambiguous, en, "I have competing readings for that word. Can you give an example that distinguishes them?").
response_template(contact_ambiguous, it, "Ho letture concorrenti per quella parola. Puoi dare un esempio che le distingua?").
% Un controesempio basta a sospendere l'ipotesi, qualunque sia il numero dei
% sostegni: una coincidenza ripetuta resta una coincidenza (§16.2).
machinery(contact_countered).
contact_countered($N, $R) :- contact_counter($N, $R, $E).
contact_support($N, $R, $K) :-
    findall($E, contact_episode($N, $R, $E), $Es), list_len($Es, $K).

% ⛔ §24 (critica di F.) — CIO' CHE IL CONTATTO CONCLUDE E' LINGUA, NON UNA NOTA
% SULLA LINGUA. La prima versione aveva un consumatore suo (una clausola di
% `holds/3`): la parola appresa rispondeva a «what is the N of X» e a nient'altro
% — non leggeva un'affermazione, non entrava in una polare nuova. Ora il contatto
% conclude la STESSA conoscenza che una lezione avrebbe scritto,
% `relation_noun(Relazione, Nome)`, e ogni lettore che gia' la consulta (domanda,
% polare, affermazione, stipulazione) la usa senza sapere del contatto. Lo stato
% di ipotesi sta nella condizione: sostegni, controesempi e ritiro (§19).
% Il verso di `relation_noun/2` e' «X is the N of Y» = R(Y, X): vale quando il
% possessore osservato e' il soggetto di R. Il verso inverso (possessore = oggetto,
% «Rome is its capital») non ha ancora una forma della lingua in cui entrare
% senza cambiare il verso di tutti i nomi di R: resta episodio, non lessico.
relation_noun($R, $N) :-
    contact_bridge($N, $R), contact_shape($N, $R, noun), contact_episode($N, $R, ep($S, $O, s)).
% E un VERBO entra dove entrano i verbi: la cornice che legge le affermazioni
% (`construction_frame/3`, la stessa di una lezione «X means Y») e la parola che
% sceglie la relazione nelle domande (`answer_frame/2`), alla radice e com'e' detta.
construction_frame($Obs, $Known, $R) :-
    contact_shape($N, $R, verb($Mid, $Known)), contact_bridge($N, $R),
    words_joined($Mid, $MidText), concat_atoms("@S ", $MidText, $A), concat_atoms($A, " @O", $Obs).
answer_frame($N, $R) :- contact_bridge($N, $R), contact_shape($N, $R, verb($Mid, $K)).
answer_frame($Root, $R) :-
    contact_bridge($N, $R), contact_shape($N, $R, verb($Mid, $K)), finite_present_of($Root, $N),
    dif($Root, $N).
% la lettura nota di R da cui la cornice nuova prende il significato: la prima
% che comincia dal soggetto e finisce sull'oggetto
machinery(contact_known_frame).
contact_known_frame($R, $K) :-
    kb_fact(extract_frame, cons($K, cons($R, nil))),
    concat_atoms("@S ", $Rest, $K), concat_atoms($Mid, " @O", $Rest).
% Le viste congelate che derivano da questa conoscenza si rifanno quando cambia.
view_depends(extract_frame, contact_episode).
view_depends(extract_frame, contact_shape).
view_depends(extract_frame, contact_counter).
view_depends(extract_frame, contact_bridge_withdrawn).
view_depends(construction_claims, contact_shape).

% La risposta dice come ha letto il nome in OGNI turno che lo nomina.
% Due tuple diverse non sono due prove indipendenti: una puo' essere stata
% letta grazie all'ipotesi stessa (audit-crescita.p0t). Finche' non esiste una
% verifica delle dipendenze, nessun conteggio toglie questa riserva. La lettura
% e il trasferimento restano disponibili; non si spaccia l'uso per conferma.
turn_reply_qualifies($T, $W, $G) :-
    contact_bridge($N, $R),
    input_node_atom($T, $I, $W), contact_word_form($N, $W), contact_gloss($R, $G).
% la parola nel turno e' quella appresa, o la sua radice («hail» per «hails»)
machinery(contact_word_form).
contact_word_form($N, $N).
contact_word_form($N, $W) :- finite_present_of($W, $N), dif($W, $N).
contact_gloss($R, $G) :-
    extract_frame($P, $R), atom_words($P, cons($A, $Ws)), contact_drop_last($Ws, $Mid),
    words_joined($Mid, $G).
machinery(contact_drop_last).
contact_drop_last(cons($W, nil), nil).
contact_drop_last(cons($A, cons($B, $R)), cons($A, $T)) :- contact_drop_last(cons($B, $R), $T).

% ── LA PROVENIENZA DELL'IPOTESI NEI FATTI LETTI (§14.6, §19) ───────────────
% Una lettura fatta CON un'ipotesi porta l'ipotesi come dipendenza. Prima
% «The Geburtsort of Kant is Konigsberg» scriveva born_in(kant, konigsberg) e,
% ritirato il ponte, il fatto restava dimostrabile senza fonte (conseguenza
% orfana); e «Marie Curie was born in Warsaw, but Warsaw is not her Geburtsort»
% salvava not(born_in(marie_curie, warsaw)): la seconda porzione era letta con
% l'ipotesi che stava smentendo. Ora dopo la risposta ogni fatto che il turno ha
% scritto (`kb_turn_act/4`) e che viene dalla parola di contatto riceve un
% sostegno `read_support(fact(R, S, O, Pol), hypothesis(N, R))`; un atto diretto
% sullo stesso contenuto aggiunge `direct`. Il motore rende invisibile un fatto
% di cui la KB dice `fact_withheld/1` — uno STRATO, niente si cancella: il fatto,
% i suoi sostegni e la loro storia restano leggibili e si salvano.
% Un fatto che la KB sapeva gia' (base o letto per altra via), riaffermato con la
% sola parola nuova, NON riceve il sostegno d'ipotesi: non viene da lei.
machinery(read_support).
machinery(fact_withheld).
machinery(read_support_in_force).
machinery(contact_reading_support).
machinery(contact_word_here).
machinery(contact_through).
machinery(contact_through_now).
machinery(contact_independent_reading).
machinery(contact_support_store_all).
machinery(contact_support_store_one).
turn_after_reply($T, contact_reading) :-
    findall($P, contact_reading_pair($T, $P), $L), contact_support_store_all($L).
% (il template di findall dev'essere una variabile: il termine nasce qui)
machinery(contact_reading_pair).
contact_reading_pair($T, sup($F, $V)) :- contact_reading_support($T, $F, $V).
contact_reading_support($T, fact($R, $S, $O, $Pol), hypothesis($N, $R)) :-
    contact_word_here($T, $N, $R),
    kb_turn_act($R, cons($S, cons($O, nil)), $Pol, $K),
    contact_through($T, fact($R, $S, $O, $Pol), $K).
contact_reading_support($T, fact($R, $S, $O, $Pol), direct) :-
    read_support(fact($R, $S, $O, $Pol), hypothesis($N, $R)),
    kb_turn_act($R, cons($S, cons($O, nil)), $Pol, $K),
    naf(contact_through_now($T, fact($R, $S, $O, $Pol))).
contact_word_here($T, $N, $R) :-
    contact_episode($N, $R, $E), contact_token($T, $I, $W), contact_word_form($N, $W).
contact_through_now($T, fact($R, $S, $O, $Pol)) :-
    contact_word_here($T, $N, $R), kb_turn_act($R, cons($S, cons($O, nil)), $Pol, $K),
    contact_through($T, fact($R, $S, $O, $Pol), $K).
% Il turno non dice R per nessun'altra via: il fatto nuovo viene dalla parola.
contact_through($T, fact($R, $S, $O, $Pol), new) :- naf(contact_independent_reading($T, $R)).
% Gia' letto con l'ipotesi, riletto con lei: lo stesso sostegno, non uno nuovo.
contact_through($T, fact($R, $S, $O, $Pol), again) :-
    read_support(fact($R, $S, $O, $Pol), hypothesis($N, $R)), naf(contact_independent_reading($T, $R)).
% Un turno che NEGA R(S, O) mentre R(S, O) vale: la negazione non puo' venire
% dalla lettura indipendente di R (che lo afferma); viene dalla parola.
contact_through($T, fact($R, $S, $O, neg), $K) :-
    contact_negated($T), kb_fact($R, cons($S, cons($O, nil))).
contact_independent_reading($T, $R) :- contact_independent_word($T, $R, $W).
contact_support_store_all(nil).
contact_support_store_all(cons(sup($F, $V), $L)) :-
    contact_support_store_one($F, $V), contact_support_store_all($L).
contact_support_store_one($F, $V) :- read_support($F, $V).
contact_support_store_one($F, $V) :- naf(read_support($F, $V)), assert(read_support, $F, $V).
% Lo strato: un fatto con sostegni di lettura vale finche' uno e' in forza.
fact_withheld($F) :- read_support($F, $V), naf(read_support_in_force($F)).
read_support_in_force($F) :- read_support($F, direct).
read_support_in_force($F) :- read_support($F, hypothesis($N, $R)), contact_bridge($N, $R).

% ── «PERCHE' NON LO SAI PIU'?» (§19.3) ─────────────────────────────────────
% Un fatto sospeso non e' un vuoto: la KB sa da quale lettura veniva e che cosa
% l'ha fatta cadere. Prima «Where was Kant born?» cadeva nel fallback («I don't
% understand that yet.»), come se Kant non fosse mai stato nominato. Ora una
% domanda che nomina il soggetto e la relazione di un fatto sospeso riceve il
% perche': la parola attraverso cui l'aveva letto, la lettura caduta e la sua
% ragione (controesempio, ritiro, letture concorrenti) — e la maniglia per
% ridarglielo: un atto diretto e' un sostegno che lo rimette in forza.
% Le parole stanno qui, per lingua: nessuna frase nel C.
machinery(turn_contact_withheld).
machinery(contact_names_all).
machinery(contact_tokens_all).
machinery(contact_asks_relation).
machinery(contact_spoken).
machinery(contact_why_text).
machinery(contact_why_reason).
machinery(contact_why_phrase).
turn_contact_withheld($T, fact($R, $S, $O, pos), $N) :-
    read_support(fact($R, $S, $O, pos), hypothesis($N, $R)),
    fact_withheld(fact($R, $S, $O, pos)),
    turn_illocution($T, question), contact_names_all($T, $S), contact_asks_relation($T, $R).
contact_names_all($T, $S) :- atom_words($S, $Ws), contact_tokens_all($T, $Ws).
contact_tokens_all($T, nil).
contact_tokens_all($T, cons($W, $Rest)) :- contact_token($T, $I, $W), contact_tokens_all($T, $Rest).
% la domanda nomina R: con una parola che sceglie R nelle domande, con una
% parola piena di una sua lettura, o con la parola di contatto stessa
contact_asks_relation($T, $R) :- contact_token($T, $I, $W), answer_frame($W, $R).
contact_asks_relation($T, $R) :-
    contact_token($T, $I, $W), naf(word_is_function_word($W)), contact_relation_word($R, $W).
contact_asks_relation($T, $R) :-
    contact_token($T, $I, $W), contact_word_form($N, $W), contact_episode($N, $R, $E).
turn_plan_candidate($T) :- turn_contact_withheld($T, $F, $N).
turn_priority_response($T, $Text) :-
    turn_contact_withheld($T, $F, $N), current_language($L), contact_why_text($L, $F, $N, $Text).
contact_spoken($A, $Text) :- atom_words($A, $Ws), words_joined($Ws, $Text).
contact_why_text($L, fact($R, $S, $O, pos), $N, $Text) :-
    contact_prop_text($R, $S, $O, $Prop), contact_gloss($R, $G),
    contact_why_reason($L, $N, $R, $Why),
    contact_why_phrase($L, lead, $P1), contact_why_phrase($L, through, $P2),
    contact_why_phrase($L, no_longer, $P3), contact_why_phrase($L, as, $P4),
    contact_why_phrase($L, close, $P5), contact_why_phrase($L, handle, $P6),
    concat_atoms($P1, $Prop, $A1), concat_atoms($A1, $P2, $A2), concat_atoms($A2, $N, $A3),
    concat_atoms($A3, $P3, $A4), concat_atoms($A4, $N, $A5), concat_atoms($A5, $P4, $A6),
    contact_why_tail($A6, parts($G, $P5, $Why, $P6), $Text).
machinery(contact_why_tail).
machinery(contact_prop_text).
contact_why_tail($Head, parts($G, $Close, $Why, $Handle), $Text) :-
    concat_atoms($Head, $G, $A1), concat_atoms($A1, $Close, $A2),
    concat_atoms($A2, $Why, $A3), concat_atoms($A3, $Handle, $Text).
% «S G O» con le parole della lettura nota di R («kant was born in konigsberg»)
contact_prop_text($R, $S, $O, $Text) :-
    contact_gloss($R, $G), contact_spoken($S, $SS), contact_spoken($O, $OS),
    concat_atoms($SS, " ", $A1), concat_atoms($A1, $G, $A2), concat_atoms($A2, " ", $A3),
    concat_atoms($A3, $OS, $Text).
% la ragione per cui la lettura e' caduta, dalla piu' informativa
contact_why_reason($L, $N, $R, $Why) :-
    contact_counter($N, $R, ep($S2, $O2, $Of)), contact_prop_text($R, $S2, $O2, $Prop),
    contact_why_phrase($L, countered, $C1), contact_why_phrase($L, countered_not, $C2),
    contact_why_phrase($L, close, $C3),
    concat_atoms($C1, $Prop, $B1), concat_atoms($B1, $C2, $B2),
    concat_atoms($B2, $N, $B3), concat_atoms($B3, $C3, $Why).
contact_why_reason($L, $N, $R, $Why) :-
    naf(contact_countered($N, $R)), contact_bridge_withdrawn($N, $R),
    contact_why_phrase($L, withdrawn, $Why).
contact_why_reason($L, $N, $R, $Why) :-
    naf(contact_countered($N, $R)), naf(contact_bridge_withdrawn($N, $R)),
    contact_competing($N, $R), contact_why_phrase($L, competing, $C1),
    contact_why_phrase($L, competing_tail, $C2),
    concat_atoms($C1, $N, $B1), concat_atoms($B1, $C2, $Why).
contact_why_phrase(en, lead, "I no longer hold «").
contact_why_phrase(en, through, "»: I had read it only through «").
contact_why_phrase(en, no_longer, "», and I no longer read «").
contact_why_phrase(en, as, "» as «").
contact_why_phrase(en, close, "».").
contact_why_phrase(en, countered, " You gave me a counterexample: «").
contact_why_phrase(en, countered_not, "», and that is not «").
contact_why_phrase(en, withdrawn, " That reading was withdrawn.").
contact_why_phrase(en, competing, " «").
contact_why_phrase(en, competing_tail, "» now has competing readings.").
contact_why_phrase(en, handle, " If it is true, tell me in other words and I will hold it again.").
contact_why_phrase(it, lead, "Non tengo piu' «").
contact_why_phrase(it, through, "»: l'avevo letto solo attraverso «").
contact_why_phrase(it, no_longer, "», e non leggo piu' «").
contact_why_phrase(it, as, "» come «").
contact_why_phrase(it, close, "».").
contact_why_phrase(it, countered, " Mi hai dato un controesempio: «").
contact_why_phrase(it, countered_not, "», e quello non e' «").
contact_why_phrase(it, withdrawn, " Quella lettura e' stata ritirata.").
contact_why_phrase(it, competing, " «").
contact_why_phrase(it, competing_tail, "» ha ora letture concorrenti.").
contact_why_phrase(it, handle, " Se e' vero, dimmelo con altre parole e lo terro' di nuovo.").
% E la PAROLA che non legge piu': «What is the Geburtsort of Napoleon?» dopo il
% controesempio diceva «I don't know about geburtsort», come se la parola non
% fosse mai stata incontrata. Ora dice quale lettura aveva e perche' e' caduta.
% (Un fatto sospeso nominato nella stessa domanda ha la precedenza: dice di piu'.
% Le letture concorrenti hanno gia' la loro risposta, `turn_contact_ambiguous`.)
machinery(turn_contact_dropped).
machinery(contact_word_live).
machinery(turn_has_withheld).
contact_word_live($N) :- contact_bridge($N, $R).
turn_has_withheld($T) :- turn_contact_withheld($T, $F, $N).
turn_contact_dropped($T, $N, $R) :-
    contact_episode($N, $R, $E), naf(contact_word_live($N)), naf(contact_competing($N, $R)),
    naf(contact_word_native($N)),
    turn_illocution($T, question), contact_token($T, $I, $W), contact_word_form($N, $W),
    naf(turn_has_withheld($T)).
% una parola che la lingua gia' legge per un'altra via («capital») non e' caduta:
% e' caduta solo la lettura che il contatto le aveva proposto
machinery(contact_word_native).
contact_word_native($N) :- contact_explained_before($R, $N).
contact_word_native($N) :- answer_frame($N, $R).
contact_word_native($N) :- relation_noun($R, $N).
turn_plan_candidate($T) :- turn_contact_dropped($T, $N, $R).
turn_priority_response($T, $Text) :-
    turn_contact_dropped($T, $N, $R), current_language($L), contact_why_reason($L, $N, $R, $Why),
    contact_gloss($R, $G), contact_why_phrase($L, dropped, $P1), contact_why_phrase($L, as, $P2),
    contact_why_phrase($L, close, $P3), contact_why_phrase($L, dropped_handle, $P4),
    concat_atoms($P1, $N, $A1), concat_atoms($A1, $P2, $A2), concat_atoms($A2, $G, $A3),
    concat_atoms($A3, $P3, $A4), concat_atoms($A4, $Why, $A5), concat_atoms($A5, $P4, $A6),
    concat_atoms($A6, $G, $A7), concat_atoms($A7, $P3, $Text).
contact_why_phrase(en, dropped, "I no longer read «").
% (la maniglia deve essere vera: un nuovo esempio NON riattiva un'ipotesi smentita,
% §16.2; la relazione invece resta chiedibile con le sue parole)
contact_why_phrase(en, dropped_handle, " You can still ask me with «").
contact_why_phrase(it, dropped, "Non leggo piu' «").
contact_why_phrase(it, dropped_handle, " Puoi ancora chiedermelo con «").

% ── I5 — GLI STRUMENTI DEL CONTATTO SI IMPARANO PER CONTATTO (§1-bis n. 4) ──
% «Einstein was born in Ulm; in other words, his Geburtsort is Ulm.» non
% insegnava niente: «other» e «words» restavano nel residuo accanto al nome, e
% la condizione vuole una parola sola. Nessuna riga dice che cosa sia «in other
% words» (sarebbe L2+, §1-bis): il contatto quasi riuscito si CONSERVA, e quando
% due contatti su relazioni DIVERSE lasciano le stesse parole in piu', quelle
% parole compaiono qualunque sia la relazione, quindi non ne nominano nessuna:
% nasce l'ipotesi che siano uno strumento del contatto. Il resto di ciascun
% residuo e' il nome; i due contatti in sospeso si rileggono ed entrano come
% episodi. Da li' le parole dello strumento non contano nel residuo, anche per
% una relazione mai vista.
% La CONDIZIONE APPRESA si corregge con lo stesso circuito: uno strumento vale
% finche' almeno un episodio nato attraverso di lui regge. Se i controesempi
% ordinari li smentiscono tutti, lo strumento cade (uno strato: resta leggibile).
% Residuo dichiarato (G1): la regola d'induzione (intersezione fra relazioni
% diverse, fino a quattro parole) e la politica di credito sono scritte qui.
after_reply_bookkeeper(contact_near).
machinery(contact_near).
machinery(contact_near_here).
machinery(contact_near_size).
machinery(contact_stored_now).
machinery(contact_near_store_all).
machinery(contact_near_store_one).
machinery(contact_near_shape).
machinery(contact_near_shape_any).
machinery(contact_near_shapes).
machinery(contact_near_shape_one).
machinery(contact_near_shape_possible).
machinery(contact_instrument).
machinery(contact_instrument_pair).
machinery(contact_instrument_store_all).
machinery(contact_instrument_store_one).
machinery(contact_instrument_word).
machinery(contact_instrument_in_force).
machinery(contact_instrument_credited).
machinery(contact_instrument_discredited).
machinery(contact_episode_via).
machinery(contact_note_via).
machinery(contact_note_via_one).
machinery(contact_instrument_here).
machinery(contact_common).
machinery(contact_common_member).
machinery(contact_minus).
machinery(contact_minus_member).
machinery(contact_reread).
machinery(contact_reread_shape).
machinery(contact_tokens_all_words).
turn_after_reply($T, contact_near) :-
    naf(contact_negated($T)), naf(contact_stored_now($T)),
    findall($A, contact_near_here($T, $A), $L), contact_near_store_all($T, $L).
% il contabile dell'episodio ha gia' scritto in questo turno: niente da conservare
contact_stored_now($T) :- kb_turn_act(contact_episode, $A, pos, new).
contact_stored_now($T) :- kb_turn_act(contact_counter, $A, pos, new).
contact_stored_now($T) :- kb_turn_act(contact_use, $A, pos, new).
contact_near_here($T, near($R, $E, $Ws)) :-
    contact_alignment_here($T, $R, $E, $Ws), contact_near_size($Ws).
contact_near_size(cons($A, cons($B, nil))).
contact_near_size(cons($A, cons($B, cons($C, nil)))).
contact_near_size(cons($A, cons($B, cons($C, cons($D, nil))))).
contact_near_store_all($T, nil).
contact_near_store_all($T, cons(near($R, $E, $Ws), $L)) :-
    contact_near_store_one($T, $R, $E, $Ws), contact_near_store_all($T, $L).
contact_near_store_one($T, $R, $E, $Ws) :- contact_near($R, $E, $Ws).
contact_near_store_one($T, $R, $E, $Ws) :-
    naf(contact_near($R, $E, $Ws)), assert(contact_near, $R, $E, $Ws),
    contact_near_shapes($T, $R, $E, $Ws),
    findall($P, contact_instrument_pair($R, $E, $Ws, $P), $Ps), contact_instrument_store_all($Ps).
% la forma di ciascuna parola candidata si prende ora: dopo, la IR del turno non c'e' piu'
contact_near_shapes($T, $R, $E, nil).
contact_near_shapes($T, $R, $E, cons($W, $Rest)) :-
    contact_near_shape_one($T, $W, $R, $E), contact_near_shapes($T, $R, $E, $Rest).
contact_near_shape_any($W, $R, $E) :- contact_near_shape($W, $R, sh($E, $Sh)).
contact_near_shape_possible($T, $W, $R, ep($S, $O, $Of)) :-
    contact_shape_here($T, $W, $O, $Sh0), contact_shape_known($R, $Sh0, $Sh).
contact_near_shape_one($T, $W, $R, $E) :- contact_near_shape_any($W, $R, $E).
contact_near_shape_one($T, $W, $R, ep($S, $O, $Of)) :-
    naf(contact_near_shape_any($W, $R, ep($S, $O, $Of))),
    contact_shape_here($T, $W, $O, $Sh0), contact_shape_known($R, $Sh0, $Sh),
    assert(contact_near_shape, $W, $R, sh(ep($S, $O, $Of), $Sh)).
contact_near_shape_one($T, $W, $R, $E) :-
    naf(contact_near_shape_any($W, $R, $E)), naf(contact_near_shape_possible($T, $W, $R, $E)).
% L'INDUZIONE: stesse parole in piu' su relazioni diverse, e un nome solo per parte.
contact_instrument_pair($R1, $E1, $Ws1, pair($C, a($N1, $R1, $E1), a($N2, $R2, $E2))) :-
    contact_near($R2, $E2, $Ws2), dif($R1, $R2),
    contact_common($Ws1, $Ws2, $C), dif($C, nil),
    contact_minus($Ws1, $C, $D1), eq_list_one($D1, $N1),
    contact_minus($Ws2, $C, $D2), eq_list_one($D2, $N2).
contact_common($Ws1, $Ws2, $C) :- findall($W, contact_common_member($Ws1, $Ws2, $W), $C).
contact_common_member($Ws1, $Ws2, $W) :- member($W, $Ws1), member($W, $Ws2).
contact_minus($Ws, $C, $D) :- findall($W, contact_minus_member($Ws, $C, $W), $D).
contact_minus_member($Ws, $C, $W) :- member($W, $Ws), naf(member($W, $C)).
contact_instrument_store_all(nil).
contact_instrument_store_all(cons($P, $L)) :-
    contact_instrument_store_one($P), contact_instrument_store_all($L).
contact_instrument_store_one(pair($C, a($N1, $R1, $E1), a($N2, $R2, $E2))) :-
    naf(contact_instrument_known_bad($C)), contact_instrument($C, from($E1, $E2)),
    contact_reread($N1, $R1, $E1, $C), contact_reread($N2, $R2, $E2, $C).
contact_instrument_store_one(pair($C, a($N1, $R1, $E1), a($N2, $R2, $E2))) :-
    naf(contact_instrument_known_bad($C)),
    naf(contact_instrument($C, from($E1, $E2))), assert(contact_instrument, $C, from($E1, $E2)),
    contact_reread($N1, $R1, $E1, $C), contact_reread($N2, $R2, $E2, $C).
% uno strumento gia' smentito non rinasce da una coppia nuova di contatti in
% sospeso: la correzione vale per lo strumento, non per la coppia che l'aveva indotto
contact_instrument_store_one(pair($C, $A1, $A2)) :- contact_instrument_known_bad($C).
machinery(contact_instrument_known_bad).
contact_instrument_known_bad($C) :- contact_instrument($C, $F), contact_instrument_discredited($C).
% rileggere un contatto in sospeso con lo strumento: l'episodio, la sua forma,
% e attraverso quale strumento e' nato
contact_reread($N, $R, $E, $C) :-
    naf(contact_episode($N, $R, $E)), assert(contact_episode, $N, $R, $E),
    contact_reread_shape($N, $R, $E), assert(contact_episode_via, $N, $R, via($E, $C)).
contact_reread($N, $R, $E, $C) :- contact_episode($N, $R, $E).
contact_reread_shape($N, $R, $E) :-
    contact_near_shape($N, $R, sh($E, $Sh)), naf(contact_shape($N, $R, $Sh)),
    assert(contact_shape, $N, $R, $Sh).
contact_reread_shape($N, $R, $E) :- contact_near_shape($N, $R, sh($E, $Sh)), contact_shape($N, $R, $Sh).
contact_reread_shape($N, $R, $E) :- naf(contact_near_shape_any($N, $R, $E)).
% un episodio nato mentre le parole di uno strumento in forza stavano nel turno
% gli da' credito (o glielo toglie, se poi viene smentito)
contact_note_via($T, $N, $R, $E) :-
    findall($C, contact_instrument_here($T, $C), $Cs), contact_note_via_one($N, $R, $E, $Cs).
contact_instrument_here($T, $C) :-
    contact_instrument($C, $F), contact_instrument_in_force($C), contact_tokens_all($T, $C).
contact_note_via_one($N, $R, $E, nil).
contact_note_via_one($N, $R, $E, cons($C, $Cs)) :-
    assert(contact_episode_via, $N, $R, via($E, $C)), contact_note_via_one($N, $R, $E, $Cs).
% la trasparenza: le parole di uno strumento in forza non spiegano ne' nominano
contact_instrument_word($W) :-
    contact_instrument($C, $F), member($W, $C), contact_instrument_in_force($C).
contact_instrument_in_force($C) :- contact_instrument($C, $F), naf(contact_instrument_discredited($C)).
contact_instrument_discredited($C) :- naf(contact_instrument_credited($C)).
contact_instrument_credited($C) :- contact_episode_via($N, $R, via($E, $C)), naf(contact_countered($N, $R)).
view_depends(extract_frame, contact_episode_via).
