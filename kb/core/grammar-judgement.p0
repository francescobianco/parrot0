% grammar-judgement.p0 — LA GRAMMATICA GIRATA VERSO IL GIUDIZIO (gen505i).
%
% Obiettivo di F. (LEARN_TODO): parrot0 deve saper dire DOVE e' l'errore, non
% solo leggere. Il reperto che rende il passo corto: oltre centoventi fatti di
% grammatica inglese sono gia' in KB — copule, copule plurali, radici verbali,
% plurali irregolari, suffissi — e servivano SOLO a leggere.
%
% ⛔ REGOLA DI QUESTO FILE: qui non nasce nessuna classe nuova di parole. La
% conoscenza che GIUDICA e' la STESSA che LEGGE, altrimenti le due divergono al
% primo cambiamento e parrot0 giudicherebbe con regole che lui stesso non segue.
% Qui ci sono solo VISTE sopra `clause_copula/1`, `plural_copula/1`,
% `plural_of/2` e `plural_suffix/2`.

:- file_attribute(machinery).

% ── 1. IL NUMERO, COME VISTA ───────────────────────────────────────────────
% Il plurale e' dichiarato (irregolari) o portato da un suffisso: la stessa
% coppia di fonti che il lettore usa per singolarizzare.
plural_noun($W) :- plural_of($W, $S).
plural_noun($W) :- plural_suffix($Suf, $End), chars($Suf, $SC), chars($W, $WC), app($StemC, $SC, $WC).
singular_noun($W) :- naf(plural_noun($W)).

% Il singolare della copula non e' una lista nuova: e' cio' che resta.
singular_copula($C) :- clause_copula($C), naf(plural_copula($C)).

% ── 1-bis. IL SOGGETTO ESISTENZIALE (gen505q) ──────────────────────────────
%
% Trovato dal `cefr-bench` nelle prime dodici frasi: «there are four games in the
% series» veniva dichiarata sbagliata perche' «there» sembra singolare e «are» e'
% plurale. Ma nella costruzione ESISTENZIALE «there» non e' il soggetto: e' un
% segnaposto, e il verbo concorda con il nome che SEGUE. Applicare l'accordo li'
% e' sovra-applicare una regola vera.
%
% Non si cura togliendo la regola: si cura dicendo dove non vale. Un segnaposto
% nuovo (o di un'altra lingua) e' un fatto.
machinery(expletive_subject).
expletive_subject(there).
expletive_subject(here).
expletive_subject(ci).      % «ci sono quattro giochi»
expletive_subject(vi).

% ── 2. L'ACCORDO, E IL SUO FALLIMENTO ──────────────────────────────────────
% Due fatti che non possono valere insieme. E' la stessa figura di
% `class_excludes/2` (gen505): un «no» guadagnato, non un giudizio inventato.
% ⚠ La regola NON si applica a un soggetto esistenziale: li' l'accordo guarda
% altrove, e giudicare senza saperlo sarebbe un falso positivo detto con
% sicurezza — peggio di un muro.
agreement_holds($Subj, $Cop) :- naf(expletive_subject($Subj)), singular_noun($Subj), singular_copula($Cop).
agreement_holds($Subj, $Cop) :- naf(expletive_subject($Subj)), plural_noun($Subj), plural_copula($Cop).
agreement_error($Subj, $Cop) :- naf(expletive_subject($Subj)), singular_noun($Subj), plural_copula($Cop).
agreement_error($Subj, $Cop) :- naf(expletive_subject($Subj)), plural_noun($Subj), singular_copula($Cop).

% La forma attesa: la copula dell'altro numero — ma dello STESSO TEMPO.
% Senza il tempo, «my name are» veniva corretto in «my name am»: giusto di
% numero e assurdo di tempo. Il tempo di una copula e' conoscenza come il numero,
% e vale per ogni regola che ne avra' bisogno.
machinery(copula_tense).
copula_tense(am, present).   copula_tense(is, present).   copula_tense(are, present).
copula_tense(was, past).     copula_tense(were, past).
copula_tense(sono, present). copula_tense(è, present).    copula_tense(e', present).
copula_tense(era, past).     copula_tense(erano, past).

% E la persona: «I am» non e' «I is». Solo la prima persona e' marcata, il resto
% e' la forma non marcata — dirlo cosi' evita una tabella.
machinery(first_person_copula).
first_person_copula(am).

expected_copula($Subj, $Cop, $Good) :-
    singular_noun($Subj), plural_copula($Cop), singular_copula($Good),
    naf(first_person_copula($Good)), copula_tense($Cop, $T), copula_tense($Good, $T).
expected_copula($Subj, $Cop, $Good) :-
    plural_noun($Subj), singular_copula($Cop), plural_copula($Good),
    copula_tense($Cop, $T), copula_tense($Good, $T).

% ── 3. IL NUMERO DETTO A PAROLE, per la spiegazione ────────────────────────
number_name(singular, en, "singular").   number_name(plural, en, "plural").
number_name(singular, it, "singolare").  number_name(plural, it, "plurale").
word_number($W, singular) :- singular_noun($W).
word_number($W, plural) :- plural_noun($W).
copula_number($C, plural) :- plural_copula($C).
copula_number($C, singular) :- singular_copula($C).

% ── 4. LA DOMANDA E LA RISPOSTA ────────────────────────────────────────────
% Le superfici con cui si chiede una correzione sono conoscenza: una lingua o
% una formulazione nuova e' un fatto.
machinery(error_check_cue).
error_check_cue("where is the error here").
error_check_cue("where is the error in").
error_check_cue("what is wrong with").
error_check_cue("what's wrong with").
error_check_cue("is this correct").
error_check_cue("dove è l'errore qui").
error_check_cue("dove e' l'errore qui").
error_check_cue("cosa c'è di sbagliato in").

% ── 5. I DUE GIRI DI THINKING, COME CIPOLLA (gen505m) ──────────────────────
%
% F.: «sarebbe bellissimo se attraverso il thinking si chiedesse che lingua e', e
% poi se la frase e' corretta». Non e' una pipeline da cablare: e' esattamente la
% forma dell'inferenza compositiva — ogni giro e' uno STADIO che dimostra la
% propria tesi e avvolge il precedente, e se non regge SPARISCE invece di
% mentire. Il prodotto non e' un verdetto: e' un ragionamento leggibile.
%
% I sensori (`judged_language/2`, `judged_subject/2`, `judged_copula/2`) sono
% depositati dal motore al momento del giudizio, come `turn_goal/3`: il turno
% diventa un oggetto su cui la KB puo' ragionare.
machinery(judged_language).
machinery(judged_subject).
machinery(judged_copula).
machinery(turn_has_judgement).
machinery(turn_agreement_fails).
machinery(turn_agreement_holds).

turn_has_judgement($T) :- judged_subject($T, $S).
turn_agreement_fails($T) :- judged_subject($T, $S), judged_copula($T, $C), agreement_error($S, $C).
turn_agreement_holds($T) :- judged_subject($T, $S), judged_copula($T, $C), agreement_holds($S, $C).

% PRIMO GIRO — che lingua e'. E' il nucleo: se non si riesce a dirlo, la cipolla
% comincia dal giro dopo, piu' corta e non sbagliata.
stage_text(gj_language, $L, $T) :-
    judged_language(current_turn, $Lang), language_name($Lang, $Name),
    lang_intro($L, $Pre), concat_atoms($Pre, $Name, $T).
stage_claim(gj_language, turn_has_judgement(current_turn)).
lang_intro(en, "That is ").
lang_intro(it, "Questa è in ").

% SECONDO GIRO — e' ben formata? Due stadi con tesi esclusive: solo uno esiste.
stage_wraps(gj_verdict_bad, gj_language).
stage_claim(gj_verdict_bad, turn_agreement_fails(current_turn)).
stage_relation(gj_verdict_bad, qualifies).
stage_side(gj_verdict_bad, after).
stage_text(gj_verdict_bad, en, "It is not well formed").
stage_text(gj_verdict_bad, it, "Non è ben formata").

stage_wraps(gj_verdict_ok, gj_verdict_bad).
stage_claim(gj_verdict_ok, turn_agreement_holds(current_turn)).
stage_relation(gj_verdict_ok, qualifies).
stage_side(gj_verdict_ok, after).
stage_text(gj_verdict_ok, en, "It is well formed").
stage_text(gj_verdict_ok, it, "È ben formata").

% TERZO GIRO — dove, e perche'. Esiste solo se c'e' un errore: quando la frase e'
% corretta non c'e' niente da localizzare, e lo stadio non compare.
stage_wraps(gj_detail, gj_verdict_ok).
stage_claim(gj_detail, turn_agreement_fails(current_turn)).
stage_relation(gj_detail, causes).
stage_side(gj_detail, after).
% ⚠ IL LIMITE VERO E' L'ARIETA', NON IL NUMERO DI VARIABILI (misurato al
% gen505q leggendo `src/kb.h`). Il caricatore ha due soffitti dichiarati:
%   KB_MAX_ARGS = 4  — un predicato con 5+ argomenti non si parsa
%   KB_MAX_BODY = 8  — un corpo con 9+ goal non si parsa
% Il primo e' quello in cui si cade: un goal di arieta' 6 nel CORPO fa cadere
% l'INTERA regola, e il messaggio dice soltanto «bad rule, dropped». La versione
% precedente di questo blocco passava per un `gj_clash/6`, quindi non veniva
% caricata affatto — lo stadio del dettaglio non esisteva. La cura non e' «meno
% variabili»: e' «meno argomenti per goal», cioe' dare un nome ai pezzi
% intermedi (qui `judged_side/3`) invece di passarli tutti insieme.
stage_text(gj_detail, $L, $T) :-
    judged_subject(current_turn, $S), judged_side($L, $S, $Lft),
    judged_copula(current_turn, $C), judged_side($L, $C, $Rgt),
    gj_join($L, $Lft, $Rgt, $T).
gj_side($L, $W, $N, $T) :- gj_is($L, $Is), concat_atoms($W, $Is, $A), concat_atoms($A, $N, $T).
gj_join($L, $Left, $Right, $T) :- gj_and($L, $And), concat_atoms($Left, $And, $X), concat_atoms($X, $Right, $T).
gj_is(en, " is ").   gj_and(en, " and ").
gj_is(it, " è ").    gj_and(it, " e ").

% ── 6. I PASSI DEL THINKING, DETTI A PAROLE (gen505n) ──────────────────────
% Ogni operatore dello schema `grammar_check` e' una tesi che il turno o regge o
% non regge; `thinking_says/3` e' come si dice il passo quando regge. Un giro
% nuovo costa un operatore e una frase.
machinery(turn_language_known).
machinery(turn_sentence_quoted).
machinery(judged_sentence).
machinery(turn_clash_nameable).
machinery(gj_side).
machinery(gj_join).
machinery(judged_side).

turn_language_known($T) :- judged_language($T, $L).
turn_clash_nameable($T) :- turn_agreement_fails($T).

% PRIMO PENSIERO — ripetere cio' che e' stato detto. Non e' cortesia: e' il
% passo che rende ISPEZIONABILE su che cosa parrot0 sta ragionando, ed e' il
% primo posto in cui un fraintendimento si vede.
turn_sentence_quoted($T) :- judged_sentence($T, $S).
thinking_says(turn_sentence_quoted, $L, $T) :-
    judged_sentence(current_turn, $S), quote_intro($L, $Pre), concat_atoms($Pre, $S, $T).
quote_intro(en, "you said: ").
quote_intro(it, "mi hai detto: ").

thinking_says(turn_language_known, $L, $T) :-
    judged_language(current_turn, $Lang), language_name($Lang, $Name),
    lang_intro($L, $Pre), concat_atoms($Pre, $Name, $T).
thinking_says(turn_agreement_holds, en, "it is well formed").
thinking_says(turn_agreement_holds, it, "è ben formata").
thinking_says(turn_agreement_fails, en, "it is not well formed").
thinking_says(turn_agreement_fails, it, "non è ben formata").
% Anche questa spezzata, per la stessa ragione: prima i due lati, poi lo scontro.
judged_side($L, $W, $T) :- judged_subject(current_turn, $W), word_number($W, $N), number_name($N, $L, $NN), gj_side($L, $W, $NN, $T).
judged_side($L, $W, $T) :- judged_copula(current_turn, $W), copula_number($W, $N), number_name($N, $L, $NN), gj_side($L, $W, $NN, $T).
thinking_says(turn_clash_nameable, $L, $T) :-
    judged_subject(current_turn, $S), judged_side($L, $S, $Lft),
    judged_copula(current_turn, $C), judged_side($L, $C, $Rgt),
    gj_join($L, $Lft, $Rgt, $T).
