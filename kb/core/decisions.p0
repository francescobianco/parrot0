% Scelte motivate su requisiti: E1, interlocutore-di-frontiera §7-8.
% Il C non cambia. Dati = role/3 (IR a ruoli aperti); formule, requisiti,
% limiti e preferenze vengono insegnati tramite turn_form, il lettore comune.
% Nessun viaggio/costo/peso e nessuna preferenza vincente vive in questo file.
% decision_* sono viste: ritrarre la lezione cambia subito candidati e scelta.
:- file_attribute(machinery).

decision_role_name($R) :- decision_requirement($O, $R, $Op, $B).
decision_role_name($R) :- decision_formula($R, $A, $B).
decision_role_name($A) :- decision_formula($R, $A, $B).
decision_role_name($B) :- decision_formula($R, $A, $B).
decision_role_name($R) :- decision_minimum($R, $N).
decision_role_name($R) :- decision_maximum($R, $N).
role($O, $R, $V) :- situation_state(described_situation, $O, $R, $V).
decision_numeric($V) :- is($N, $V).
decision_store($O, $R, $V, $V) :- decision_numeric($V), state_commit($O, $R, $V).

% ── 1. IL VALORE E' UNA PROCEDURA SULLA KB ─────────────────────────────────
% La somma non e' un calcolo di dominio compilato. Ogni discesa porta con se'
% i ruoli gia' attraversati: una formula che si rimanda («loop = twist + loop»,
% o a = b + c e b = a + d) non e' un'esplorazione infinita, e' una definizione
% circolare — vista sotto, §3 — e la ricerca del valore la salta.
decision_value($O, $R, $V) :- decision_eval($O, $R, $V, nil).
decision_eval($O, $R, $V, $Seen) :- role($O, $R, $Raw), is($V, $Raw).
decision_eval($O, $R, $V, $Seen) :- decision_formula($R, $A, $B), naf(member($R, $Seen)), decision_number_in($O, $A, $X, cons($R, $Seen)), decision_number_in($O, $B, $Y, cons($R, $Seen)), is($V, add($X, $Y)).
decision_values_in($O, $R, $Vs, $Seen) :- findall($V, decision_eval($O, $R, $V, $Seen), $Vs).
decision_number_in($O, $R, $V, $Seen) :- decision_values_in($O, $R, cons($V, nil), $Seen).
decision_values($O, $R, $Vs) :- decision_values_in($O, $R, $Vs, nil).
decision_number($O, $R, $V) :- decision_values($O, $R, cons($V, nil)).
decision_known($O, $R) :- decision_number($O, $R, $V).
decision_computed($R) :- decision_formula($R, $A, $B).
% Due strade che danno valori diversi — due formule, o un valore detto e una
% formula — sono una contraddizione, non un valore da scegliere in silenzio.
decision_conflict($O, $R) :- decision_values($O, $R, cons($A, cons($B, $Rest))).

% Un minimo deve essere insegnato: il dato assente NON vale zero. Un ruolo in
% contraddizione non ha un limite inferiore: non ha un valore. Il massimo e'
% la lezione speculare («X is never above N»). Sommare i limiti degli addendi
% vale perche' l'addizione e' monotona in ogni argomento: la proprieta' e' un
% fatto interrogabile (§9.3), non una premessa muta — un operatore senza
% proprieta' insegnata non compone limiti.
decision_operator_monotone(add).
decision_floor($O, $R, $V) :- decision_floor_in($O, $R, $V, nil).
decision_floor_in($O, $R, $V, $Seen) :- decision_number($O, $R, $V).
decision_floor_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_minimum($R, $V).
decision_floor_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_stated_bound($O, $R, $Op, $V), decision_bound_kind($Op, floor).
decision_floor_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_formula($R, $A, $B), naf(member($R, $Seen)), decision_operator_monotone(add), decision_floor_in($O, $A, $X, cons($R, $Seen)), decision_floor_in($O, $B, $Y, cons($R, $Seen)), is($V, add($X, $Y)).
decision_ceiling($O, $R, $V) :- decision_ceiling_in($O, $R, $V, nil).
decision_ceiling_in($O, $R, $V, $Seen) :- decision_number($O, $R, $V).
decision_ceiling_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_maximum($R, $V).
decision_ceiling_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_stated_bound($O, $R, $Op, $V), decision_bound_kind($Op, ceiling).
decision_ceiling_in($O, $R, $V, $Seen) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_formula($R, $A, $B), naf(member($R, $Seen)), decision_operator_monotone(add), decision_ceiling_in($O, $A, $X, cons($R, $Seen)), decision_ceiling_in($O, $B, $Y, cons($R, $Seen)), is($V, add($X, $Y)).

% Il residuo segue le dipendenze: si chiede la foglia ignota, non il risultato
% della formula che parrot0 puo' calcolare da se'.
decision_missing($O, $R, $M) :- decision_missing_in($O, $R, $M, nil).
decision_missing_in($O, $R, $R, $Seen) :- naf(decision_known($O, $R)), naf(decision_computed($R)).
decision_missing_in($O, $R, $M, $Seen) :- naf(decision_known($O, $R)), decision_formula($R, $A, $B), naf(member($R, $Seen)), decision_missing_in($O, $A, $M, cons($R, $Seen)).
decision_missing_in($O, $R, $M, $Seen) :- naf(decision_known($O, $R)), decision_formula($R, $A, $B), naf(member($R, $Seen)), decision_missing_in($O, $B, $M, cons($R, $Seen)).

% ── 2. I REQUISITI: lo stato e' deciso da ciò che basta, non dal valore esatto ─
decision_comparison("at most", le).
decision_comparison("at least", ge).
decision_comparison("exactly", eq).
decision_comparison("less than", lt).
decision_comparison("more than", gt).
decision_comparison("al massimo", le).
decision_comparison("almeno", ge).
decision_comparison("esattamente", eq).
decision_comparison("meno di", lt).
decision_comparison("più di", gt).
decision_opposite(le, gt). decision_opposite(ge, lt). decision_opposite(eq, dif).
decision_opposite(lt, ge). decision_opposite(gt, le).

% Quale GENERE di premessa decide un requisito (E2a, §9.1-9.3): il valore
% esatto lo decide sempre; un limite inferiore conferma «almeno» e confuta
% «al massimo»; un limite superiore fa l'opposto. La tabella e' conoscenza:
% un genere nuovo di premessa (un intervallo, una stima) e' una riga, non un
% ramo. Il test da applicare al limite viaggia nella terza colonna.
decision_bound_confirms(exact, $Op, $Op) :- decision_opposite($Op, $No).
decision_bound_confirms(floor, ge, ge). decision_bound_confirms(floor, gt, gt).
decision_bound_confirms(ceiling, le, le). decision_bound_confirms(ceiling, lt, lt).
decision_bound_refutes(exact, $Op, $No) :- decision_opposite($Op, $No).
decision_bound_refutes(floor, le, gt). decision_bound_refutes(floor, lt, ge). decision_bound_refutes(floor, eq, gt).
decision_bound_refutes(ceiling, ge, lt). decision_bound_refutes(ceiling, gt, le). decision_bound_refutes(ceiling, eq, lt).

% Le premesse disponibili su un ruolo, in UNA lista (lezione di §8.2: le
% negazioni lavorano poi su `member`, mai su una vista ricorsiva).
decision_bound_term($O, $R, limit(exact, $V)) :- decision_number($O, $R, $V).
decision_bound_term($O, $R, limit(floor, $V)) :- naf(decision_known($O, $R)), decision_floor($O, $R, $V).
decision_bound_term($O, $R, limit(ceiling, $V)) :- naf(decision_known($O, $R)), decision_ceiling($O, $R, $V).
decision_bounds($O, $R, $Bs) :- findall($X, decision_bound_term($O, $R, $X), $Bs).

% Lo STATO di un requisito porta il suo sostegno: met(limit(K,V)) dice quale
% premessa ha bastato; unmet(limit(K,V)) quale lo confuta; open(Residuo) quale
% condizione manca ancora; broken(Perche') una definizione rotta. Un solo
% stato per requisito, scelto per gravita' su una lista di reperti.
decision_finding($O, $R, $Bd, broken($W)) :- decision_broken($O, $R, $W).
decision_finding($O, $R, $Bd, $F) :- decision_bounds($O, $R, $Bs), decision_bounded_finding($Bs, $Bd, $F).
decision_finding($O, $R, $Bd, open($Res)) :- naf(decision_known($O, $R)), decision_residual($O, $R, $Bd, $Res).
decision_bounded_finding($Bs, bound($Op, $B), met(limit($K, $V))) :- member(limit($K, $V), $Bs), decision_bound_confirms($K, $Op, $T), apply($T, cons($V, cons($B, nil))).
decision_bounded_finding($Bs, bound($Op, $B), unmet(limit($K, $V))) :- member(limit($K, $V), $Bs), decision_bound_refutes($K, $Op, $T), apply($T, cons($V, cons($B, nil))).
decision_findings($O, $R, $Bd, $Fs) :- findall($F, decision_finding($O, $R, $Bd, $F), $Fs).
decision_finding_kind(broken($W), broken). decision_finding_kind(unmet($S), unmet).
decision_finding_kind(met($S), met). decision_finding_kind(open($S), open).
decision_has_kind($Fs, $K) :- member($F, $Fs), decision_finding_kind($F, $K).
decision_pick($Fs, broken($W)) :- member(broken($W), $Fs).
decision_pick($Fs, unmet($S)) :- naf(decision_has_kind($Fs, broken)), member(unmet($S), $Fs).
decision_pick($Fs, met($S)) :- naf(decision_has_kind($Fs, broken)), naf(decision_has_kind($Fs, unmet)), member(met($S), $Fs).
decision_pick($Fs, open($R)) :- naf(decision_has_kind($Fs, broken)), naf(decision_has_kind($Fs, unmet)), naf(decision_has_kind($Fs, met)), member(open($R), $Fs).
decision_pick($Fs, stuck) :- naf(decision_has_kind($Fs, broken)), naf(decision_has_kind($Fs, unmet)), naf(decision_has_kind($Fs, met)), naf(decision_has_kind($Fs, open)).
decision_status($O, $R, $Bd, $S) :- decision_findings($O, $R, $Bd, $Fs), decision_pick($Fs, $S).
decision_req_status($O, status($R, bound($Op, $B), $S)) :- decision_requirement($O, $R, $Op, $B), decision_status($O, $R, bound($Op, $B), $S).
decision_statuses($O, $Ss) :- findall($S, decision_req_status($O, $S), $Ss).
decision_status_kind(status($R, $Bd, stuck), stuck).
decision_status_kind(status($R, $Bd, $S), $K) :- decision_finding_kind($S, $K).
% Viste di compatibilita' (E1): l'ostacolo e' lo stato «confutato».
decision_obstacle($O, $R, $Bd, $Sup) :- decision_requirement($O, $R, $Op, $B), decision_status($O, $R, bound($Op, $B), unmet($Sup)).
decision_met($O, $R, $Op, $B) :- decision_status($O, $R, bound($Op, $B), met($Sup)).
decision_has_requirements($O) :- decision_requirement($O, $R, $Op, $B).

% ── 2b. IL RESIDUO: quale CONDIZIONE manca, non quale casella (§9.2) ────────
% Per una somma con un addendo noto il vincolo si trasporta sull'altro
% (monotonia dichiarata sopra): «ready ≤ 11» con arrival 10 e' «transfer ≤ 1».
% Con due addendi ignoti il residuo e' CONGIUNTO (need_sum): i limiti dei
% singoli non certificano la somma (§9.10). Arita' 4: verso, soglia e ruoli
% attraversati viaggiano nel termine goal/3.
decision_residual($O, $R, bound($Op, $B), $Res) :- decision_residual_in($O, $R, goal($Op, $B, nil), $Res).
decision_residual_in($O, $R, goal($Op, $B, $Seen), need($R, $Op, $B)) :- naf(decision_known($O, $R)), naf(decision_computed($R)).
decision_residual_in($O, $R, goal($Op, $B, $Seen), $Res) :- naf(decision_known($O, $R)), decision_formula($R, $A, $C), naf(member($R, $Seen)), decision_operator_monotone(add), decision_number($O, $A, $X), naf(decision_known($O, $C)), is($B2, sub($B, $X)), decision_residual_in($O, $C, goal($Op, $B2, cons($R, $Seen)), $Res).
decision_residual_in($O, $R, goal($Op, $B, $Seen), $Res) :- naf(decision_known($O, $R)), decision_formula($R, $A, $C), naf(member($R, $Seen)), decision_operator_monotone(add), decision_number($O, $C, $Y), naf(decision_known($O, $A)), is($B2, sub($B, $Y)), decision_residual_in($O, $A, goal($Op, $B2, cons($R, $Seen)), $Res).
decision_residual_in($O, $R, goal($Op, $B, $Seen), need_sum($R, $Op, $B)) :- naf(decision_known($O, $R)), decision_formula($R, $A, $C), naf(decision_known($O, $A)), naf(decision_known($O, $C)).

% ── 2c. LA SOGLIA DETTA: un limite sul dato di UN soggetto (E2b, §9.2) ─────
% «the transfer of train is at most 1» / «it is at most 1» custodisce
% bound(Op, V) nello STESSO stato descritto del valore (state_commit): un
% valore esatto detto dopo lo sostituisce, e viceversa; nessun pending_*.
% Entra nei limiti del ruolo come minimo/tetto del solo soggetto. Il verso
% stretto («more than 1») si compone come non stretto: piu' debole, mai falso.
decision_bound_kind(ge, floor). decision_bound_kind(gt, floor).
decision_bound_kind(le, ceiling). decision_bound_kind(lt, ceiling).
decision_stated_bound($O, $R, $Op, $V) :- role($O, $R, bound($Op, $V)).
% La soglia arriva come parole: le parole di un confronto (decision_comparison,
% quindi insegnabili) seguite dal numero. Nessun parser nel C.
decision_words_then(nil, cons($V, nil), $V).
decision_words_then(cons($W, $Ws), cons($W, $Rest), $V) :- decision_words_then($Ws, $Rest, $V).
decision_parse_bound($Span, $Op, $V) :- atom_words($Span, $Ws), decision_comparison($Name, $Op), atom_words($Name, $Cw), decision_words_then($Cw, $Ws, $V), decision_numeric($V).
decision_bound_text($L, $R, bound($Op, $V), $Text) :- words_of($R, $Name), concat_atoms("the ", $Name, $A), decision_is_words($L, $Is), concat_atoms($A, $Is, $B), decision_bound_words($L, $Op, $W), concat_atoms($B, $W, $C), concat_atoms($C, $V, $Text).
decision_bound_of_text($L, $O, $R, $Text) :- words_of($R, $Rn), concat_atoms("the ", $Rn, $A), decision_ask_link($L, $Of), concat_atoms($A, $Of, $B), words_of($O, $On), concat_atoms($B, $On, $C), decision_is_words($L, $Is), concat_atoms($C, $Is, $Text).
decision_bound_store($O, $R, $Span, $Text) :- decision_parse_bound($Span, $Op, $V), state_commit($O, $R, bound($Op, $V)), current_language($L), decision_bound_of_text($L, $O, $R, $A), decision_bound_words($L, $Op, $W), concat_atoms($A, $W, $B), concat_atoms($B, $V, $C), concat_atoms($C, ".", $Text).
% L'ellissi con la soglia, sotto la questione massima: stessa regola di «it is 0».
decision_datum_bound_store($Span, $Text) :- decision_parse_bound($Span, $Op, $V), max_qud($I), open_issue($I, datum), naf(decision_other_datum($I)), issue_topic($I, $O), issue_relation($I, $R), state_commit($O, $R, bound($Op, $V)), current_language($L), decision_bound_text($L, $R, bound($Op, $V), $A), decision_datum_reply($O, $A, $Text).

% ── 3. LE DEFINIZIONI ROTTE: circolari o discordi ──────────────────────────
decision_part($R, $A) :- decision_formula($R, $A, $B).
decision_part($R, $B) :- decision_formula($R, $A, $B).
decision_reaches($R, $D, $Seen) :- decision_part($R, $D).
decision_reaches($R, $D, $Seen) :- decision_part($R, $M), naf(member($M, $Seen)), decision_reaches($M, $D, cons($M, $Seen)).
decision_circular($R) :- decision_reaches($R, $R, cons($R, nil)).
% Un requisito e' rotto se il suo ruolo, o un ruolo da cui dipende, e' circolare
% o discorde.
decision_broken($O, $R, circular($R)) :- decision_requirement($O, $R, $Op, $B), decision_circular($R).
decision_broken($O, $R, circular($D)) :- decision_requirement($O, $R, $Op, $B), decision_reaches($R, $D, cons($R, nil)), dif($D, $R), decision_circular($D).
decision_broken($O, $R, conflict($R, $Vs)) :- decision_requirement($O, $R, $Op, $B), decision_conflict($O, $R), decision_values($O, $R, $Vs).
decision_broken($O, $R, conflict($D, $Vs)) :- decision_requirement($O, $R, $Op, $B), decision_reaches($R, $D, cons($R, nil)), decision_conflict($O, $D), decision_values($O, $D, $Vs).

% ── 4. I CANDIDATI: le famiglie restano visibili PRIMA e DOPO una preferenza ─
% Gli stati si calcolano una volta per soggetto e i candidati ne discendono.
% `confirm` porta CHE COSA ha bastato: settled(exact) o settled(bound). Il dato
% mancante resta un candidato `ask` anche quando un limite ha gia' deciso:
% confermare o chiedere e' una CONDOTTA, e si insegna («prefer confirming the
% check to asking questions when a bound settles it»), non si cabla (§9.9).
decision_candidate($O, $M, $Reason) :- decision_statuses($O, $Ss), decision_cand_in($O, $Ss, cand($M, $Reason)).
decision_cand_in($O, $Ss, cand(explain, obstacle($R, $Bd, $Sup))) :- member(status($R, $Bd, unmet($Sup)), $Ss).
decision_cand_in($O, $Ss, cand(explain, $Broken)) :- member(status($R, $Bd, broken($Broken)), $Ss).
decision_cand_in($O, $Ss, cand(ask, missing($M))) :- decision_requirement($O, $R, $Op, $B), decision_missing($O, $R, $M).
decision_cand_in($O, $Ss, cand(confirm, settled($How))) :- decision_has_requirements($O), naf(decision_not_met_in($Ss)), decision_settled_how($Ss, $How).
decision_not_met_in($Ss) :- member($S, $Ss), decision_status_kind($S, $K), dif($K, met).
decision_bound_support_in($Ss) :- member(status($R, $Bd, met(limit($K, $V))), $Ss), dif($K, exact).
decision_settled_how($Ss, bound) :- decision_bound_support_in($Ss).
decision_settled_how($Ss, exact) :- naf(decision_bound_support_in($Ss)).

% La scelta lavora su UNA lista di candidati, calcolata una volta. Misurato
% (14 settembre 2026): con le viste ricorsive ogni `naf` rifaceva l'intera
% ricerca, e sul caso con limite inferiore una guardia del solver scattava
% dentro la negazione — che allora declina — e il turno cadeva al muro
% generico. Le viste pubbliche sotto restano interrogabili sulla stessa lista.
% `findall/3` raccoglie solo una variabile: il termine cand(...) nasce nella testa.
decision_cand($O, $C) :- decision_statuses($O, $Ss), decision_cand_in($O, $Ss, $C).
decision_candidates($O, $Cs) :- findall($C, decision_cand($O, $C), $Cs).
decision_feature_in($Cs, blocked) :- member(cand(explain, obstacle($R, $B, $V)), $Cs).
decision_feature_in($Cs, incomplete) :- member(cand(ask, $Reason), $Cs).
decision_feature_in($Cs, circular) :- member(cand(explain, circular($D)), $Cs).
decision_feature_in($Cs, inconsistent) :- member(cand(explain, conflict($D, $Vs)), $Cs).
decision_feature_in($Cs, bounded) :- member(cand(confirm, settled(bound)), $Cs).
% Una preferenza e' una relazione condizionale, non un ordine di moduli.
decision_dominated_in($Cs, $Worse) :- decision_preference($Better, $Worse, $Condition), decision_feature_in($Cs, $Condition), member(cand($Better, $Reason), $Cs), dif($Better, $Worse).
decision_available_in($Cs, $Move) :- member(cand($Move, $Reason), $Cs), naf(decision_dominated_in($Cs, $Move)).
decision_moves_in($Cs, $Moves) :- findall($M, decision_available_in($Cs, $M), $Moves).
decision_verdict($O, $Cs, $Moves) :- decision_candidates($O, $Cs), decision_moves_in($Cs, $Moves).
decision_feature($O, $F) :- decision_candidates($O, $Cs), decision_feature_in($Cs, $F).
decision_dominated($O, $Move) :- decision_candidates($O, $Cs), decision_dominated_in($Cs, $Move).
decision_available($O, $Move) :- decision_verdict($O, $Cs, $Moves), member($Move, $Moves).
decision_selected($O, $Move) :- decision_verdict($O, $Cs, cons($Move, nil)).
% Le ragioni e i dati da chiedere sono LISTE: si dicono tutti gli ostacoli e si
% chiedono tutti i dati mancanti in un turno (residuo §8.4.1, 14 settembre).
decision_cand_reason($Cs, $Move, $X) :- member(cand($Move, $X), $Cs).
decision_reasons($Cs, $Move, $Rs) :- findall($X, decision_cand_reason($Cs, $Move, $X), $Rs).
decision_cand_missing($Cs, $X) :- member(cand(ask, missing($X)), $Cs).
decision_asks_list($Cs, $Ms) :- findall($X, decision_cand_missing($Cs, $X), $Ms).
decision_first_ask($Cs, $M) :- decision_asks_list($Cs, cons($M, $Rest)).
decision_missing_list($O, $R, $Ms) :- findall($X, decision_missing($O, $R, $X), $Ms).
decision_stated($O, $R) :- role($O, $R, $Raw).

decision_move_name("explaining obstacles", explain).
decision_move_name("asking questions", ask).
decision_move_name("confirming the check", confirm).
decision_move_name("spiegare gli impedimenti", explain).
decision_move_name("fare domande", ask).
decision_move_name("confermare la verifica", confirm).
decision_condition_name("a requirement fails", blocked).
decision_condition_name("information is missing", incomplete).
decision_condition_name("a definition is circular", circular).
decision_condition_name("the data disagree", inconsistent).
decision_condition_name("a bound settles it", bounded).
decision_condition_name("un requisito non vale", blocked).
decision_condition_name("mancano informazioni", incomplete).
decision_condition_name("una definizione è circolare", circular).
decision_condition_name("i dati sono discordi", inconsistent).
decision_condition_name("un limite basta", bounded).

% ── 5. IL DATO CHIESTO E' UNA QUESTIONE SUL TABELLONE (issues.p0) ──────────
% Genere `datum`: parrot0 ha chiesto un valore, l'utente lo deve. Identita'
% datum_<soggetto>_<ruolo>; lo stato e' una vista: si risolve quando il valore
% diventa derivabile. Il turno dopo («it is 0») si legge sotto la massima.
% La questione e' chiusa quando il dato e' noto, OPPURE quando una soglia
% detta lascia l'obbligo senza residuo su quel dato (E2b): il tabellone e'
% collegato all'obbligo, non alla casella. Il controllo costoso (gli stati)
% gira solo se una soglia e' stata detta; le negazioni lavorano su una lista.
issue_state($I, resolved) :- open_issue($I, datum), issue_topic($I, $O), issue_relation($I, $R), decision_known($O, $R).
issue_state($I, resolved) :- open_issue($I, datum), issue_topic($I, $O), issue_relation($I, $R), decision_stated($O, $R), naf(decision_known($O, $R)), naf(decision_has_stated_bound($O, $R)).
issue_state($I, resolved) :- open_issue($I, datum), issue_topic($I, $O), issue_relation($I, $R), naf(decision_known($O, $R)), decision_stated_bound($O, $R, $Op, $V), decision_owed_roles($O, $Rs), naf(member($R, $Rs)).
issue_state($I, open) :- open_issue($I, datum), issue_topic($I, $O), issue_relation($I, $R), naf(decision_known($O, $R)), naf(decision_has_stated_bound($O, $R)), naf(decision_stated($O, $R)).
issue_state($I, open) :- open_issue($I, datum), issue_topic($I, $O), issue_relation($I, $R), naf(decision_known($O, $R)), decision_stated_bound($O, $R, $Op, $V), decision_owed_roles($O, $Rs), member($R, $Rs).
decision_has_stated_bound($O, $R) :- decision_stated_bound($O, $R, $Op, $V).
decision_residual_role(need($R, $Op, $B), $R).
decision_residual_role(need_sum($S, $Op, $B), $R) :- decision_reaches($S, $R, cons($S, nil)).
decision_owed_role($O, $R) :- decision_statuses($O, $Ss), member(status($Q, $Bd, open($Res)), $Ss), decision_residual_role($Res, $R).
decision_owed_roles($O, $Rs) :- findall($R, decision_owed_role($O, $R), $Rs).
issue_owed_by($I, user) :- open_issue($I, datum).
decision_datum_id($O, $R, $I) :- concat_atoms("datum_", $O, $A), concat_atoms($A, "_", $B), concat_atoms($B, $R, $I).
decision_note($O, verdict($Cs, cons(ask, nil))) :- decision_asks_list($Cs, $Ms), decision_note_data($O, $Ms).
decision_note_data($O, nil).
decision_note_data($O, cons($R, $Rest)) :- decision_datum_id($O, $R, $I), decision_note_datum($O, $R, $I), decision_note_data($O, $Rest).
decision_note_datum($O, $R, $I) :- naf(open_issue($I, datum)), turn_counter($N), assert(open_issue, $I, datum), assert(issue_topic, $I, $O), assert(issue_relation, $I, $R), assert(issue_turn, $I, $N).
% Una questione gia' aperta resta com'e': ritrarre `issue_turn` dentro la prova
% (per rinfrescarne l'origine) faceva morire il processo — lo stato cambiava
% mentre il solver lo enumerava (state-description.p0 §5). L'origine e' il
% primo turno che ha chiesto.
% Richiedere un dato deve rendere la questione di nuovo MASSIMA (residuo
% §8.4.1): la prova lascia un fatto scratch, e un contabile sposta l'origine al
% confine sicuro del turno dopo — mai un retract dentro la prova.
decision_note_datum($O, $R, $I) :- open_issue($I, datum), turn_counter($N), assert(datum_reasked, $I, $N).
machinery(datum_reasked).
turn_scratch(datum_reasked).
bookkeeper(datum_reasked).
datum_reasked_pair(re($I, $N)) :- datum_reasked($I, $N).
turn_bookkeeping($Turn, datum_reasked) :- findall($X, datum_reasked_pair($X), $Xs), decision_refresh_all($Xs).
decision_refresh_all(nil).
decision_refresh_all(cons(re($I, $N), $Rest)) :- decision_refresh($I, $N), decision_refresh_all($Rest).
decision_refresh($I, $N) :- issue_turn($I, $K), dif($K, $N), retract(issue_turn, $I, $K), assert(issue_turn, $I, $N), retract(datum_reasked, $I, $N).
decision_refresh($I, $N) :- issue_turn($I, $N), retract(datum_reasked, $I, $N).
decision_note($O, verdict($Cs, nil)).
decision_note($O, verdict($Cs, cons(explain, nil))).
decision_note($O, verdict($Cs, cons(confirm, nil))).
decision_note($O, verdict($Cs, cons($A, cons($B, $Rest)))).
% Il verdetto cita il precedente (episodes.p0, E4) e lascia un episodio.
decision_answer($O, $Text) :- decision_verdict($O, $Cs, $Ms), current_language($L), decision_say($L, $O, verdict($Cs, $Ms), $T0), episode_suffix($L, $O, $Ms, $Sfx), episode_append($T0, $Sfx, $Text), decision_note($O, verdict($Cs, $Ms)), episode_note($O, $Cs, $Ms).
% «it is 0» vale solo se il dato dovuto e' UNO: con due questioni aperte
% NELLO STESSO TURNO («What are the departure and duration of boat?»)
% l'ellissi e' ambigua e resta a chi la leggeva prima. Una domanda su un altro
% soggetto, fatta turni prima e mai chiusa, non contende l'antecedente: il
% referente dell'ellissi e' la questione massima, non ogni questione aperta.
decision_other_datum($I) :- issue_turn($I, $N), open_issue($J, datum), dif($I, $J), issue_turn($J, $N), issue_state($J, open).
decision_datum_store($V, $Text) :- decision_numeric($V), max_qud($I), open_issue($I, datum), naf(decision_other_datum($I)), issue_topic($I, $O), issue_relation($I, $R), state_commit($O, $R, $V), decision_datum_text($O, $R, $V, $Text).
decision_datum_text($O, $R, $V, $Text) :- current_language($L), decision_value_text($L, $R, $V, $A), decision_datum_reply($O, $A, $Text).
decision_datum_reply($O, $A, $Text) :- current_language($L), decision_for_words($L, $For), concat_atoms($A, $For, $B), words_of($O, $Name), concat_atoms($B, $Name, $C), concat_atoms($C, ": ", $D), decision_answer($O, $Reply), concat_atoms($D, $Reply, $Text).

% ── 6. LA RESA: parole in KB, valori derivati dalla stessa prova ───────────
decision_bound_words(en, le, "at most ").
decision_bound_words(en, ge, "at least ").
decision_bound_words(en, eq, "exactly ").
decision_bound_words(en, lt, "less than ").
decision_bound_words(en, gt, "more than ").
decision_bound_words(it, le, "al massimo ").
decision_bound_words(it, ge, "almeno ").
decision_bound_words(it, eq, "esattamente ").
decision_bound_words(it, lt, "meno di ").
decision_bound_words(it, gt, "più di ").
decision_obstacle_start(en, "No: "). decision_obstacle_start(it, "No: ").
decision_value_link(en, exact, " reaches "). decision_value_link(it, exact, " raggiunge ").
decision_value_link(en, floor, " is at least "). decision_value_link(it, floor, " è almeno ").
decision_value_link(en, ceiling, " is at most "). decision_value_link(it, ceiling, " è al massimo ").
decision_settled_start(en, "Settled: "). decision_settled_start(it, "Verificato: ").
decision_need_start(en, "the "). decision_need_start(it, "il ").
decision_keep_link(en, " to keep "). decision_keep_link(it, " perché ").
decision_keep_mid(en, " "). decision_keep_mid(it, " sia ").
decision_must_words(en, " must be "). decision_must_words(it, " deve essere ").
decision_still_unknown(en, "; it is still unknown."). decision_still_unknown(it, "; è ancora ignoto.").
decision_bound_link(en, "; the requirement is "). decision_bound_link(it, "; il requisito è ").
decision_ask_start(en, "What is the "). decision_ask_start(it, "Qual è il valore di ").
decision_ask_start_many(en, "What are the "). decision_ask_start_many(it, "Quali sono i valori di ").
decision_ask_link(en, " of "). decision_ask_link(it, " per ").
decision_is_words(en, " is "). decision_is_words(it, " vale ").
decision_for_words(en, ". For "). decision_for_words(it, ". Per ").
decision_and(en, " and "). decision_and(it, " e ").
decision_plus_words(en, " plus "). decision_plus_words(it, " più ").
decision_circular_words(en, " is defined through itself, so I cannot compute it.").
decision_circular_words(it, " è definito attraverso se stesso, quindi non posso calcolarlo.").
decision_conflict_link(en, " comes out as "). decision_conflict_link(it, " risulta ").
decision_conflict_words(en, " from different rules, so I cannot check it.").
decision_conflict_words(it, " da regole diverse, quindi non posso verificarlo.").
decision_missing_words(en, " is missing."). decision_missing_words(it, " manca.").
decision_missing_words_many(en, " are missing."). decision_missing_words_many(it, " mancano.").
decision_reason_gap(en, " "). decision_reason_gap(it, " ").
decision_unknown_start(en, "I do not have the "). decision_unknown_start(it, "Non ho ancora ").
decision_unknown_link(en, " yet: the "). decision_unknown_link(it, ": ").
decision_complete(en, "The stated requirements are satisfied.").
decision_complete(it, "I requisiti dichiarati sono soddisfatti.").
decision_tie_start(en, "I need to choose between "). decision_tie_start(it, "Devo scegliere tra ").
decision_move_words(en, explain, "explaining an obstacle"). decision_move_words(it, explain, "spiegare un impedimento").
decision_move_words(en, ask, "asking for missing information"). decision_move_words(it, ask, "chiedere le informazioni mancanti").
decision_move_words(en, confirm, "confirming the check"). decision_move_words(it, confirm, "confermare la verifica").
decision_unresolved(en, "I could not settle the check: I found neither an obstacle nor a missing datum.").
decision_unresolved(it, "Non ho potuto concludere la verifica: non ho trovato né un impedimento né un dato mancante.").
decision_no_requirements(en, "I do not know the requirements to check yet.").
decision_no_requirements(it, "Non conosco ancora i requisiti da verificare.").

decision_list($L, cons($X, nil), $X).
decision_list($L, cons($X, $Rest), $Text) :- decision_list($L, $Rest, $B), decision_and($L, $And), concat_atoms($X, $And, $A), concat_atoms($A, $B, $Text).
decision_move_list($L, cons($M, nil), $Text) :- decision_move_words($L, $M, $Text).
decision_move_list($L, cons($M, $Rest), $Text) :- decision_move_list($L, $Rest, $B), decision_move_words($L, $M, $W), decision_and($L, $And), concat_atoms($W, $And, $A), concat_atoms($A, $B, $Text).

% Arita' massima 4 (KB_MAX_ARGS): il genere del valore viaggia nel termine.
decision_value_shown($L, limit($K, $V), $Shown) :- decision_value_link($L, $K, $Link), concat_atoms($Link, $V, $Shown).
decision_obstacle_prefix($L, $R, $Shown, $Text) :- decision_obstacle_start($L, $A), words_of($R, $Name), concat_atoms($A, $Name, $B), concat_atoms($B, $Shown, $Text).
decision_obstacle_suffix($L, $Op, $Bound, $Text) :- decision_bound_link($L, $Link), decision_bound_words($L, $Op, $Words), concat_atoms($Link, $Words, $A), concat_atoms($A, $Bound, $B), concat_atoms($B, ".", $Text).
decision_render($L, obstacle($R, bound($Op, $B), $Value), $Text) :- decision_value_shown($L, $Value, $Shown), decision_obstacle_prefix($L, $R, $Shown, $A), decision_obstacle_suffix($L, $Op, $B, $C), concat_atoms($A, $C, $Text).
decision_render($L, circular($R), $Text) :- decision_obstacle_start($L, $A), words_of($R, $Name), concat_atoms($A, $Name, $B), decision_circular_words($L, $W), concat_atoms($B, $W, $Text).
decision_render($L, conflict($R, $Vs), $Text) :- decision_obstacle_start($L, $A), words_of($R, $Name), concat_atoms($A, $Name, $B), decision_conflict_link($L, $Link), concat_atoms($B, $Link, $C), decision_list($L, $Vs, $List), concat_atoms($C, $List, $D), decision_conflict_words($L, $W), concat_atoms($D, $W, $Text).
decision_role_words($L, cons($R, nil), $Text) :- words_of($R, $Text).
decision_role_words($L, cons($R, $Rest), $Text) :- decision_role_words($L, $Rest, $B), words_of($R, $A), decision_and($L, $And), concat_atoms($A, $And, $C), concat_atoms($C, $B, $Text).
decision_ask_opening($L, cons($R, nil), $Start) :- decision_ask_start($L, $Start).
decision_ask_opening($L, cons($R, cons($S, $Rest)), $Start) :- decision_ask_start_many($L, $Start).
decision_question($L, $O, $Ms, $Text) :- decision_ask_opening($L, $Ms, $Start), decision_role_words($L, $Ms, $Roles), concat_atoms($Start, $Roles, $A), decision_ask_link($L, $Link), concat_atoms($A, $Link, $B), words_of($O, $Name), concat_atoms($B, $Name, $C), concat_atoms($C, "?", $Text).
decision_render_all($L, cons($R, nil), $Text) :- decision_render($L, $R, $Text).
decision_render_all($L, cons($R, $Rest), $Text) :- decision_render_all($L, $Rest, $B), decision_render($L, $R, $A), decision_reason_gap($L, $Gap), concat_atoms($A, $Gap, $C), concat_atoms($C, $B, $Text).
decision_missing_ending($L, cons($R, nil), $W) :- decision_missing_words($L, $W).
decision_missing_ending($L, cons($R, cons($S, $Rest)), $W) :- decision_missing_words_many($L, $W).
decision_say($L, $O, verdict($Cs, cons(explain, nil)), $Text) :- decision_reasons($Cs, explain, $Rs), decision_render_all($L, $Rs, $Text).
% La domanda porta la SOGLIA residua, non solo la casella (§9.2): «What is the
% transfer of train? To keep ready at most 11, the transfer must be at most 1.»
decision_say($L, $O, verdict($Cs, cons(ask, nil)), $Text) :- decision_asks_list($Cs, $Ms), decision_question($L, $O, $Ms, $Q), decision_statuses($O, $Ss), decision_open_texts($L, $Ss, $Ts), decision_join($L, cons($Q, $Ts), $Text).
% La conferma dice il sostegno quando un limite ha bastato (§9.4: rispondere
% E spiegare dalla stessa prova).
decision_say($L, $O, verdict($Cs, cons(confirm, nil)), $Text) :- member(cand(confirm, settled(exact)), $Cs), decision_complete($L, $Text).
decision_say($L, $O, verdict($Cs, cons(confirm, nil)), $Text) :- member(cand(confirm, settled(bound)), $Cs), decision_complete($L, $A), decision_statuses($O, $Ss), decision_support_texts($L, $Ss, $Ts), decision_join($L, cons($A, $Ts), $Text).
decision_say($L, $O, verdict($Cs, cons($A, cons($B, $Rest))), $Text) :- decision_tie_start($L, $Start), decision_move_list($L, cons($A, cons($B, $Rest)), $List), concat_atoms($Start, $List, $T), concat_atoms($T, ".", $Text).
decision_say($L, $O, verdict($Cs, nil), $Text) :- decision_has_requirements($O), decision_unresolved($L, $Text).
decision_say($L, $O, verdict($Cs, nil), $Text) :- naf(decision_has_requirements($O)), decision_no_requirements($L, $Text).
decision_reply($O, $Text) :- decision_verdict($O, $Cs, $Ms), current_language($L), decision_say($L, $O, verdict($Cs, $Ms), $Text).

% Sostegno di un requisito confermato: «ready is at least 10; the requirement
% is at least 9.» — stesse parole dell'ostacolo, senza il «No: ».
decision_support_render($L, status($R, bound($Op, $B), met($Value)), $Text) :- decision_value_shown($L, $Value, $Shown), words_of($R, $Name), concat_atoms($Name, $Shown, $A), decision_obstacle_suffix($L, $Op, $B, $C), concat_atoms($A, $C, $Text).
decision_support_text($L, $Ss, $T) :- member(status($R, $Bd, met(limit($K, $V))), $Ss), dif($K, exact), decision_support_render($L, status($R, $Bd, met(limit($K, $V))), $T).
decision_support_texts($L, $Ss, $Ts) :- findall($T, decision_support_text($L, $Ss, $T), $Ts).
% Il residuo detto: «The transfer must be at most 1 to keep ready at most 11.»
% e, congiunto, «The departure plus duration must be at most 10 to keep …».
decision_need_words($L, need($Leaf, $Op, $B), $Text) :- words_of($Leaf, $Text).
decision_need_words($L, need_sum($R, $Op, $B), $Text) :- decision_formula($R, $A, $C), words_of($A, $An), words_of($C, $Cn), decision_plus_words($L, $Plus), concat_atoms($An, $Plus, $P), concat_atoms($P, $Cn, $Text).
decision_need_bound($L, need($Leaf, $Op, $B), $Text) :- decision_bound_words($L, $Op, $W), concat_atoms($W, $B, $Text).
decision_need_bound($L, need_sum($R, $Op, $B), $Text) :- decision_bound_words($L, $Op, $W), concat_atoms($W, $B, $Text).
% Corpo massimo 16 goal (KB_MAX_BODY): la frase si compone in due meta'. E
% senza virgole: `findall` ristampa e rilegge le soluzioni, quindi una virgola
% dentro un testo spezza il termine della lista (15 settembre 2026).
decision_residual_head($L, $Res, $Text) :- decision_need_start($L, $S), decision_need_words($L, $Res, $Need), concat_atoms($S, $Need, $A), upcase_first($A, $A2), decision_must_words($L, $Must), concat_atoms($A2, $Must, $A3), decision_need_bound($L, $Res, $Nb), concat_atoms($A3, $Nb, $Text).
decision_residual_tail($L, req($R, $Op, $B), $Text) :- decision_keep_link($L, $Link), words_of($R, $Rn), concat_atoms($Link, $Rn, $A), decision_keep_mid($L, $Mid), concat_atoms($A, $Mid, $A2), decision_bound_words($L, $Op, $Bw), concat_atoms($A2, $Bw, $A3), concat_atoms($A3, $B, $A4), concat_atoms($A4, ".", $Text).
% Se il dato ignoto e' il ruolo stesso del requisito la coda «to keep fuel at
% least 5» sarebbe una tautologia: si dice che il dato manca ancora.
decision_residual_render($L, req($R, $Op, $B), need($R, $Op, $B), $Text) :- decision_residual_head($L, need($R, $Op, $B), $A), decision_still_unknown($L, $W), concat_atoms($A, $W, $Text).
decision_residual_render($L, req($R, $Op, $B), need($Leaf, $Op2, $B2), $Text) :- dif($Leaf, $R), decision_residual_head($L, need($Leaf, $Op2, $B2), $A), decision_residual_tail($L, req($R, $Op, $B), $C), concat_atoms($A, $C, $Text).
decision_residual_render($L, $Req, need_sum($R2, $Op2, $B2), $Text) :- decision_residual_head($L, need_sum($R2, $Op2, $B2), $A), decision_residual_tail($L, $Req, $C), concat_atoms($A, $C, $Text).
decision_open_text($L, $Ss, $T) :- member(status($R, bound($Op, $B), open($Res)), $Ss), decision_residual_render($L, req($R, $Op, $B), $Res, $T).
decision_open_texts($L, $Ss, $Ts) :- findall($T, decision_open_text($L, $Ss, $T), $Ts).
decision_join($L, cons($X, nil), $X).
decision_join($L, cons($X, $Rest), $Text) :- decision_join($L, $Rest, $B), decision_reason_gap($L, $Gap), concat_atoms($X, $Gap, $A), concat_atoms($A, $B, $Text).

% ── 6b. «what remains for X?»: lo stato di OGNI requisito, dalla stessa prova ─
% Un impedimento basta per il no; chi chiede tutto riceve anche i residui
% (§9.3, obbligo 3). Senza requisiti non e' un successo.
decision_status_render($L, status($R, $Bd, unmet($Sup)), $Text) :- decision_render($L, obstacle($R, $Bd, $Sup), $Text).
decision_status_render($L, status($R, $Bd, broken($W)), $Text) :- decision_render($L, $W, $Text).
decision_status_render($L, status($R, $Bd, met($Sup)), $Text) :- decision_settled_start($L, $S), decision_support_render($L, status($R, $Bd, met($Sup)), $A), concat_atoms($S, $A, $Text).
decision_status_render($L, status($R, bound($Op, $B), open($Res)), $Text) :- decision_residual_render($L, req($R, $Op, $B), $Res, $Text).
decision_status_render($L, status($R, $Bd, stuck), $Text) :- decision_unresolved($L, $Text).
decision_status_text($L, $Ss, $T) :- member($S, $Ss), decision_status_render($L, $S, $T).
decision_status_texts($L, $Ss, $Ts) :- findall($T, decision_status_text($L, $Ss, $T), $Ts).
decision_status_answer($O, $Text) :- decision_has_requirements($O), current_language($L), decision_statuses($O, $Ss), decision_status_texts($L, $Ss, $Ts), decision_join($L, $Ts, $Text).
decision_status_answer($O, $Text) :- naf(decision_has_requirements($O)), current_language($L), decision_no_requirements($L, $Text).

% ── 7. LA DOMANDA SUL VALORE: la maniglia del cassetto (§8.4.3) ────────────
% «what is the departure of train?» raggiunge lo stato descritto, o il valore
% derivato dalla formula con la sua traccia, o dice quale dato manca. Su un
% ruolo che non conosce la corrispondenza fallisce e il turno passa oltre.
decision_value_text($L, $R, $V, $Text) :- words_of($R, $Name), concat_atoms("the ", $Name, $A), decision_is_words($L, $Is), concat_atoms($A, $Is, $B), concat_atoms($B, $V, $Text).
decision_trace_text($L, $O, $R, $Text) :- decision_formula($R, $A, $B), decision_number($O, $A, $X), decision_number($O, $B, $Y), words_of($A, $An), words_of($B, $Bn), concat_atoms($An, " ", $P), concat_atoms($P, $X, $Q), decision_plus_words($L, $Plus), concat_atoms($Q, $Plus, $S), concat_atoms($S, $Bn, $T), concat_atoms($T, " ", $U), concat_atoms($U, $Y, $Text).
decision_value_answer($O, $R, $Text) :- role($O, $R, $Raw), decision_number($O, $R, $V), current_language($L), decision_value_text($L, $R, $V, $A), concat_atoms($A, ".", $Text).
decision_value_answer($O, $R, $Text) :- naf(decision_stated($O, $R)), decision_number($O, $R, $V), current_language($L), decision_value_text($L, $R, $V, $A), concat_atoms($A, " (", $B), decision_trace_text($L, $O, $R, $Trace), concat_atoms($B, $Trace, $C), concat_atoms($C, ").", $Text).
decision_value_answer($O, $R, $Text) :- naf(decision_known($O, $R)), decision_conflict($O, $R), decision_values($O, $R, $Vs), current_language($L), decision_render($L, conflict($R, $Vs), $Text).
% Con un limite noto (detto o derivato) la risposta e' il limite: «the ready
% is at least 10 and at most 11.» — UNA riga (op(match)); «manca» solo senza.
decision_limit_op(floor, ge). decision_limit_op(ceiling, le). decision_limit_op(exact, eq).
decision_limit_words($L, limit($K, $V), $T) :- decision_limit_op($K, $Op), decision_bound_words($L, $Op, $W), concat_atoms($W, $V, $T).
decision_limit_text_of($L, $Bs, $X) :- member($B, $Bs), decision_limit_words($L, $B, $X).
decision_limits_text($L, $Bs, $T) :- findall($X, decision_limit_text_of($L, $Bs, $X), $Xs), decision_list($L, $Xs, $T).
decision_empty(nil).
decision_value_answer($O, $R, $Text) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_role_name($R), decision_bounds($O, $R, $Bs), naf(decision_empty($Bs)), current_language($L), words_of($R, $Name), concat_atoms("the ", $Name, $A), decision_is_words($L, $Is), concat_atoms($A, $Is, $B), decision_limits_text($L, $Bs, $List), concat_atoms($B, $List, $C), concat_atoms($C, ".", $Text).
decision_value_answer($O, $R, $Text) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_role_name($R), decision_bounds($O, $R, $Bs), decision_empty($Bs), decision_missing_list($O, $R, cons($M, $Ms)), current_language($L), decision_unknown_start($L, $Start), words_of($R, $Name), concat_atoms($Start, $Name, $A), decision_unknown_link($L, $Link), concat_atoms($A, $Link, $B), decision_role_words($L, cons($M, $Ms), $Mn), concat_atoms($B, $Mn, $C), decision_missing_ending($L, cons($M, $Ms), $W), concat_atoms($C, $W, $Text).
decision_value_answer($O, $R, $Text) :- naf(decision_known($O, $R)), naf(decision_conflict($O, $R)), decision_role_name($R), decision_circular($R), current_language($L), decision_render($L, circular($R), $Text).

% La domanda polare sul valore: «is the departure of train 8?» — si', no con il
% valore vero, o il dato che manca. Sopra un ruolo non in gioco fallisce.
decision_yes(en, "Yes: "). decision_yes(it, "Sì: ").
decision_polar_answer($O, $R, $V, $Text) :- decision_number($O, $R, $V), current_language($L), decision_yes($L, $Yes), decision_value_text($L, $R, $V, $A), concat_atoms($Yes, $A, $B), concat_atoms($B, ".", $Text).
decision_polar_answer($O, $R, $V, $Text) :- decision_number($O, $R, $W), dif($W, $V), current_language($L), decision_obstacle_start($L, $No), decision_value_text($L, $R, $W, $A), concat_atoms($No, $A, $B), concat_atoms($B, ".", $Text).
decision_polar_answer($O, $R, $V, $Text) :- naf(decision_known($O, $R)), decision_value_answer($O, $R, $Text).

:- include(decision-language.p0).


