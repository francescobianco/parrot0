% code-plans.p0 — la seconda istanza del piano universale del turno.
%
% conditional-plans.p0 ha mostrato che gli span tipizzati di UN turno compongono
% una risposta interamente in KB. Qui lo stesso substrato compone traccia di
% stato + domanda. Non c'e' un secondo parser e non c'e' un router: il turno
% porta gia' `turn_span/4` (ruolo e tipo), `turn_span_token/4` (i candidati
% nominati dalla domanda) e `turn_span_binding/4` (lo stato in cui la traccia
% finisce, misurato dall'valutatore fisso).
%
% La decisione che questo file possiede e' UNA: quale legame la domanda sta
% chiedendo. Non si sceglie per posizione — il consumer storico teneva l'ultimo
% identificatore della domanda, e «what is total in the end» perdeva cosi' il
% nome che aveva appena ricevuto. Si sceglie per GIUNZIONE: il legame nominato
% dalla domanda che la traccia effettivamente produce. Un solo incrocio risponde,
% piu' incroci restano piu' letture.

:- file_attribute(machinery).

% Quali ruoli di span hanno un modello di stato. E' l'unico interruttore della
% proiezione: ritraendolo, il C smette di misurare lo stato al turno successivo
% senza ricompilare. Il ruolo arriva da register_role/2, quindi un registro
% nuovo entra qui come fatto, non come ramo.
span_state_model(code, statement_trace).

% Lo stato in cui il turno finisce, e i nomi che la domanda mette in gioco.
% Restano viste separate: la prima appartiene alla traccia, la seconda all'atto.
% Entrambe portano SUPERFICI citate, non termini: la memoria di lavoro registra
% cio' che e' stato detto, e nessun sensore deve poter scambiare le parole del
% turno per conoscenza gia' posseduta.
turn_state_after($Frame, $Name, $Value) :- turn_span_binding($Frame, $Index, $Name, $Value).
turn_query_span($Frame, $Index) :- turn_span($Frame, $Index, query, $Payload).
turn_query_candidate($Frame, $Name) :- turn_query_span($Frame, $Index), turn_span_token($Frame, $Index, $Position, $Name).

% La lettura e' l'incrocio fra i due insiemi: il nome che la domanda cita E che
% la traccia lega davvero. Nessuna posizione, nessun ultimo-token.
state_query_reading($Frame, $Ident, $Value) :- turn_query_candidate($Frame, $Name), turn_state_after($Frame, $Name, $Value), span_atom($Name, $Ident).

% Enumerare una volta e leggere il SET e' anche qui lo stato epistemico: nessun
% tiebreak, e un fallimento non diventa unicita'.
state_query_key($Frame, reading($Ident, $Value)) :- state_query_reading($Frame, $Ident, $Value).
state_query_set($Frame, $Readings) :- findall($Reading, state_query_key($Frame, $Reading), $Readings).
state_query_has_reading($Frame) :- state_query_set($Frame, cons($Reading, $Tail)).
state_query_ambiguous($Frame) :- state_query_set($Frame, cons($First, cons($Second, $Tail))).
state_query_unique($Frame, $Ident, $Value) :- state_query_set($Frame, cons(reading($Ident, $Value), nil)).

% Il turno e' un candidato quando porta insieme una traccia con stato e una
% domanda. Una sola delle due non basta: riconoscere il registro `code` non
% chiude un'obbligazione ancora aperta, e una domanda senza traccia appartiene
% agli altri consumer.
state_query_surface($Frame) :- turn_query_span($Frame, $QIndex), turn_span_binding($Frame, $TIndex, $Ident, $Value).
turn_plan_candidate($Frame) :- state_query_surface($Frame).

% Il frame come vista derivata, interrogabile con lo stesso vocabolario del
% piano condizionale.
frame_act($Frame, state_query) :- state_query_unique($Frame, $Ident, $Value).
frame_slot($Frame, binding, $Ident) :- state_query_unique($Frame, $Ident, $Value).
frame_slot($Frame, value, $Value) :- state_query_unique($Frame, $Ident, $Value).

% Realizzazione: il valore provato piu' il terminatore di frase della lingua.
% Il renderer non aggiunge proposizioni — porta solo la forma.
turn_response($Frame, $Text) :- state_query_unique($Frame, $Ident, $Value), current_language($Language), value_sentence($Language, $Value, $Text).

% Due legami nominati sono due letture, e sceglierne una in silenzio sarebbe la
% mossa sbagliata anche quando il numero e' giusto: la domanda non ha ancora
% detto quale. Chiedere e' la mossa, e la frase e' un fatto.
turn_response($Frame, $Text) :- state_query_surface($Frame), state_query_ambiguous($Frame), current_language($Language), response_template(state_query_ambiguous, $Language, $Text).

% La traccia lega dei nomi, ma nessuno di quelli che la domanda ha citato. E' un
% gap tipizzato, non un'assenza di stato: nominarlo e' piu' informativo che
% classificare di nuovo il registro dell'input.
turn_response($Frame, $Text) :- state_query_surface($Frame), naf(state_query_has_reading($Frame)), current_language($Language), response_template(state_query_gap, $Language, $Text).

% ═══ L'OBBLIGAZIONE DICHIARATA: traccia + aspettativa o vincolo ═══
%
% Una domanda apre un'obbligazione e chiede di chiuderla. Una ASPETTATIVA la porta
% gia' chiusa e chiede di VERIFICARLA: «total=3; total += 4; expected 7» non
% domanda nulla, afferma qualcosa sullo stato in cui la traccia finisce. E' lo
% stesso substrato — span tipizzato, stato misurato, giunzione in KB — con un atto
% diverso, e questo e' il punto: se servisse un secondo percorso, il piano
% universale non sarebbe universale.
%
% Il turno prima rispondeva «That looks like a snippet of code.», cioe' il
% riconoscimento del registro consumava un'obbligazione ancora aperta — lo stesso
% difetto che gen393 aveva isolato per la query.

% Quali ruoli di span portano un'obbligazione, e quale confronto affermano. Il
% verso appartiene al RUOLO, non alla cue: tutte le forme di `expected` affermano
% un'uguaglianza e tutte quelle di `constraint` una differenza, quindi una cue
% nuova insegnata a `segment_role/2` eredita subito il proprio confronto. E'
% anche l'interruttore: ritraendo la riga, il ruolo smette di essere verificato.
role_obligation_relation(expected, eq).
role_obligation_relation(constraint, ne).

obligation_span($Frame, $Index, $Role) :- turn_span($Frame, $Index, $Role, $Payload), role_obligation_relation($Role, $Relation).

% Il valore dichiarato. La classe lessicale non e' cablata da nessuna parte: un
% token e' un VALORE quando l'aritmetica lo accetta, cioe' quando l'operatore che
% dovra' confrontarlo sa leggerlo. Cosi' «must not be 0» non ha bisogno che «be»
% sia dichiarata parola funzionale per non essere scambiata per un numero.
span_number($Quoted, $Number) :- span_atom($Quoted, $Number), eq($Number, $Number).
obligation_declared($Frame, $Index, $Relation, $Declared) :- obligation_span($Frame, $Index, $Role), role_obligation_relation($Role, $Relation), turn_span_token($Frame, $Index, $Position, $Token), span_number($Token, $Declared).

% Di CHE COSA parla l'obbligazione. Stessa disciplina della domanda: si sceglie
% per giunzione, mai per posizione. Un nome citato dall'obbligazione e legato
% dalla traccia e' il soggetto; se l'obbligazione non ne cita nessuno che la
% traccia leghi, e la traccia lascia un solo legame, quel legame e' il soggetto —
% non per comodita', ma perche' e' l'unico candidato che esista.
obligation_named_subject($Frame, $Ident, $Actual) :- obligation_span($Frame, $Index, $Role), turn_span_token($Frame, $Index, $Position, $Token), turn_state_after($Frame, $Token, $Value), span_atom($Token, $Ident), span_atom($Value, $Actual).
obligation_has_named_subject($Frame) :- obligation_named_subject($Frame, $Ident, $Actual).

state_binding_key($Frame, binding($Ident, $Value)) :- turn_state_after($Frame, $Name, $Value), span_atom($Name, $Ident).
state_binding_set($Frame, $Bindings) :- findall($Binding, state_binding_key($Frame, $Binding), $Bindings).
state_sole_binding($Frame, $Ident, $Actual) :- state_binding_set($Frame, cons(binding($Ident, $Quoted), nil)), span_atom($Quoted, $Actual).

obligation_subject($Frame, $Ident, $Actual) :- obligation_named_subject($Frame, $Ident, $Actual).
obligation_subject($Frame, $Ident, $Actual) :- naf(obligation_has_named_subject($Frame)), state_sole_binding($Frame, $Ident, $Actual).

% Il verdetto e' la CONGIUNZIONE dei confronti, non il primo che si incontra: un
% turno puo' portare piu' obbligazioni («expected 6 and n must not be 0») e
% rispondere sulla sola prima sarebbe dichiarare chiuso cio' che non e' stato
% guardato. Si enumera l'insieme dei confronti violati e lo si legge.
% Il confronto porta il valore osservato e non il nome del soggetto: l'arita'
% massima del dialetto e' 4, e troncare qui e' corretto invece che comodo —
% il soggetto e' una proprieta' del TURNO, la stessa per ogni obbligazione che
% quel turno dichiara, quindi ripeterlo in ogni confronto sarebbe ridondanza.
obligation_relation_holds($Actual, $Relation, $Declared) :- apply($Relation, cons($Actual, cons($Declared, nil))).
obligation_check($Frame, $Actual, $Relation, $Declared) :- obligation_subject($Frame, $Ident, $Actual), obligation_declared($Frame, $Index, $Relation, $Declared).
obligation_broken_key($Frame, broken($Relation, $Declared)) :- obligation_check($Frame, $Actual, $Relation, $Declared), naf(obligation_relation_holds($Actual, $Relation, $Declared)).
obligation_broken_set($Frame, $Broken) :- findall($B, obligation_broken_key($Frame, $B), $Broken).
obligation_has_check($Frame) :- obligation_check($Frame, $Actual, $Relation, $Declared).
obligation_verdict($Frame, met) :- obligation_has_check($Frame), obligation_broken_set($Frame, nil).
obligation_verdict($Frame, broken) :- obligation_broken_set($Frame, cons($First, $Tail)).

% Il turno e' candidato quando porta insieme una traccia con stato, un'obbligazione
% e un valore da confrontare. «do not use recursion» resta percio' fuori: e' un
% vincolo senza valore, cioe' un altro atto, e questo piano non deve rubarglielo.
obligation_surface($Frame) :- obligation_span($Frame, $Index, $Role), turn_span_binding($Frame, $TIndex, $Name, $Value), obligation_declared($Frame, $DIndex, $Relation, $Declared).
turn_plan_candidate($Frame) :- obligation_surface($Frame).

frame_act($Frame, obligation_check) :- obligation_verdict($Frame, $Verdict).
frame_slot($Frame, verdict, $Verdict) :- obligation_verdict($Frame, $Verdict).
frame_slot($Frame, binding, $Ident) :- obligation_subject($Frame, $Ident, $Actual).
frame_slot($Frame, observed, $Actual) :- obligation_subject($Frame, $Ident, $Actual).

% ── Realizzazione: il piano proposizionale, non una frase memorizzata ──
%
% Cio' che va detto e' <verdetto, soggetto, valore osservato>: tre proposizioni
% gia' provate sopra. Viaggiano NELLA CHIAVE del piano, non vengono ri-dedotte da
% ogni pezzo, e questa non e' un'ottimizzazione: e' il confine. Il renderer riceve
% le proposizioni gia' chiuse e i connettivi della lingua, quindi non ha accesso a
% nulla con cui fabbricarne una nuova — cambiare lingua o punteggiatura non puo'
% cambiare cio' che la risposta afferma. E' la stessa proof a produrre «Yes, total
% is 7.» e «Si', total vale 7.».
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 0, verdict, $Piece) :- verdict_particle($Verdict, $Language, $Piece).
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 1, connective, $Piece) :- list_separator($Language, $Piece).
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 2, subject, $Ident).
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 3, connective, $Piece) :- state_copula($Language, $Piece).
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 4, observed, $Actual).
answer_content(verdict($Verdict, $Ident, $Actual, $Language), 5, terminator, $Piece) :- sentence_terminator($Language, $Piece).

turn_response($Frame, $Text) :- obligation_surface($Frame), obligation_verdict($Frame, $Verdict), obligation_subject($Frame, $Ident, $Actual), current_language($Language), answer_text(verdict($Verdict, $Ident, $Actual, $Language), $Text).

% La traccia lega piu' nomi e l'obbligazione non dice di quale parli. Verificarne
% uno a caso darebbe un verdetto vero per costruzione e falso per il turno: qui la
% mossa e' dirlo, e la frase e' un fatto.
turn_response($Frame, $Text) :- obligation_surface($Frame), naf(obligation_has_subject($Frame)), current_language($Language), response_template(obligation_ambiguous, $Language, $Text).
obligation_has_subject($Frame) :- obligation_subject($Frame, $Ident, $Actual).
