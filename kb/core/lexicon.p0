% --- gen240 (universal-comprehension): the CURRENT conversation language is KB
% knowledge, not a C variable. Detected from these strong, language-exclusive
% markers (BARE atoms so they match bare turn tokens), asserted as the session
% fact current_language/1, and queryable ("what language are we speaking?"). ---
language_name(en, "English").
language_name(it, "Italian").
% Boot policy is knowledge too.  The engine extracts an opaque locale prefix
% and asks this relation which language it denotes; an unknown locale falls
% back through default_language/1 without naming a language in C.
default_language(en).
locale_language_prefix(en, en).
locale_language_prefix(it, it).
% Italian-only markers (ASCII; do not occur as English words).
% gen338: everyday-request vocabulary (the L13 pragmatics probes showed
% «puoi aprire la finestra?» not flipping the language in hermetic runs).
language_marker(it, puoi).
language_marker(it, aprire).
language_marker(it, chiudere).
language_marker(it, finestra).
language_marker(it, freddo).
language_marker(it, caldo).
language_marker(it, passami).
language_marker(it, grazie).
language_marker(it, prego).
language_marker(it, perche).
language_marker(it, cosa).
language_marker(it, che).
language_marker(it, chi).
language_marker(it, dove).
language_marker(it, quando).
language_marker(it, quale).
language_marker(it, quali).
language_marker(it, qual).
language_marker(it, sono).
language_marker(it, sei).
language_marker(it, sai).
language_marker(it, stai).
language_marker(it, dimmi).
language_marker(it, parlami).
language_marker(it, stiamo).
language_marker(it, parlando).
language_marker(it, parliamo).
language_marker(it, lingua).
language_marker(it, italiano).
language_marker(it, mio).
language_marker(it, mia).
language_marker(it, tuo).
language_marker(it, tua).
language_marker(it, della).
% gen382b: le preposizioni articolate mancanti. "mi dici i nomi DEI pezzi DEGLI
% scacchi" non aveva un solo marcatore riconosciuto, quindi il rilevatore
% ripiegava sull'inglese e rispondeva in inglese a una domanda italiana. Non era
% una frase da aggiungere: era una CLASSE incompleta — della/nella c'erano, dei/
% degli/delle/dello/dal/nel no. Sono function word, quindi non rischiano di
% marcare come italiana una frase inglese.
language_marker(it, dei).
language_marker(it, degli).
language_marker(it, delle).
language_marker(it, dello).
language_marker(it, dal).
language_marker(it, dallo).
language_marker(it, dalla).
language_marker(it, nel).
language_marker(it, nello).
language_marker(it, negli).
language_marker(it, sul).
language_marker(it, sulla).
language_marker(it, sugli).
language_marker(it, col).
language_marker(it, dici).
language_marker(it, nella).
language_marker(it, gli).
language_marker(it, anche).
% gen334: more Italian markers for reliable language detection
language_marker(it, come).
language_marker(it, bene).
language_marker(it, male).
language_marker(it, sempre).
language_marker(it, mai).
language_marker(it, molto).
language_marker(it, tanto).
language_marker(it, poco).
language_marker(it, tutti).
language_marker(it, tutte).
language_marker(it, ogni).
language_marker(it, nessuno).
language_marker(it, nessuna).
language_marker(it, niente).
language_marker(it, nulla).
language_marker(it, bello).
language_marker(it, bella).
language_marker(it, belli).
language_marker(it, belle).
language_marker(it, bravo).
language_marker(it, brava).
language_marker(it, buongiorno).
language_marker(it, buonasera).
language_marker(it, arrivederci).
