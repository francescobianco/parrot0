% gen240: localized replies (response_template/3 — additive next to the /2 forms,
% selected by current_language via lang_template()). Slots: {map} {n} {total}.
response_template(language_reply, en, "We're speaking English.").
response_template(language_reply, it, "Stiamo parlando in italiano.").
response_template(audit_report, en, "I audited my own composition on fresh copies of myself: {map}. {n} of {total} triples hold. No file was touched; an external agent owns edits and commits.").
response_template(audit_report, it, "Ho verificato la mia stessa composizione su copie fresche di me: {map}. {n} di {total} triple reggono. Nessun file è stato toccato; le modifiche e i commit spettano a un agente esterno.").

% ── KB-FIRST MIGRATION (gen335 round-3): discourse parsing vocabulary ──
% Formerly hardcoded C arrays; now KB facts so the lexicon learns at runtime.
% The C engine queries these facts instead of iterating static const char *[].
% Per AGENTS.md: "could a user teach the new surface form at runtime and have
% the existing engine use it without a C edit?" — now yes.

machinery(discourse_opener).
machinery(intent_starter).
machinery(connector).
machinery(sequencer).
% Discourse salience is reflective control state, never a user-taught property
% of the entity being described.
machinery(entity_mentioned).
machinery(entity_seq_max).

% Discourse openers — peeled off the front of the turn before dispatch
discourse_opener(anyway).
discourse_opener(anyhow).
discourse_opener(so).
discourse_opener(well).
discourse_opener(ok).
discourse_opener(okay).
discourse_opener(now).
discourse_opener(look).
discourse_opener(listen).
discourse_opener(actually).
discourse_opener(right).
discourse_opener(alright).
discourse_opener(hey).
discourse_opener(um).
discourse_opener(uh).
discourse_opener(hmm).
discourse_opener(comunque).
discourse_opener(allora).
discourse_opener(insomma).
discourse_opener(senti).
discourse_opener(guarda).
discourse_opener(dunque).
discourse_opener(beh).

% Intent starters — words that signal a new sub-turn after a connector
intent_starter(chi).
intent_starter(che).
intent_starter(cosa).
intent_starter(come).
intent_starter(dove).
intent_starter(quando).
intent_starter(perche).
intent_starter(perché).
intent_starter(ricordati).
intent_starter(dimmi).
intent_starter(spiegami).
intent_starter(chiamami).
intent_starter(insegnami).
intent_starter(parlami).
intent_starter(prima).
intent_starter(poi).
intent_starter(non).
intent_starter(what).
intent_starter(who).
intent_starter(where).
intent_starter(when).
intent_starter(why).
intent_starter(how).
intent_starter(which).
intent_starter(quale).
intent_starter(quali).
intent_starter(remember).
intent_starter(tell).
intent_starter(explain).
intent_starter(call).
intent_starter(teach).
intent_starter(say).
intent_starter(is).
intent_starter(are).
intent_starter(does).
intent_starter(do).
intent_starter(can).
intent_starter(every).
intent_starter(forget).
intent_starter(learn).
intent_starter(describe).
intent_starter(read).
intent_starter(show).
intent_starter(first).
intent_starter(then).
intent_starter(dont).

% Connectors — split compound turns into sub-turns
connector(" e ").
connector(" and ").
connector(" ed ").
connector(" ma ").
connector(" but ").

% Sequencers — stripped from the start of the second sub-turn
sequencer(then).
sequencer(also).
sequencer(next).
sequencer(finally).
sequencer(afterwards).
sequencer(poi).
sequencer(dopo).
sequencer(infine).
sequencer(inoltre).
sequencer(now).

% gen335 (long-conversation): more EXCLUSIVE English function/verb markers so an
% English turn is detected instead of sticking to os_language (default it). Factored
% evidence like slot_evidence — English-only tokens (no shared IT words like in/a/no/me).
language_marker(en, i).      language_marker(en, my).     language_marker(en, me).
language_marker(en, he).     language_marker(en, she).    language_marker(en, it).
language_marker(en, they).   language_marker(en, them).   language_marker(en, his).
language_marker(en, her).    language_marker(en, him).    language_marker(en, do).
language_marker(en, did).    language_marker(en, was).    language_marker(en, were).
language_marker(en, have).   language_marker(en, has).    language_marker(en, had).
language_marker(en, will).   language_marker(en, would).  language_marker(en, can).
language_marker(en, could).  language_marker(en, should). language_marker(en, of).
language_marker(en, for).    language_marker(en, from).   language_marker(en, about).
language_marker(en, there).  language_marker(en, then).   language_marker(en, been).
language_marker(en, and).    language_marker(en, but).    language_marker(en, not).
language_marker(en, know).   language_marker(en, want).   language_marker(en, make).
language_marker(en, tell).   language_marker(en, think).  language_marker(en, work).
language_marker(en, live).   language_marker(en, name).   language_marker(en, born).
language_marker(en, when).   language_marker(en, which).  language_marker(en, going).
language_marker(en, really). language_marker(en, just).   language_marker(en, need).

% gen405 — LE CUE DELL'ENUMERAZIONE APPOSITIVA.
%
% In prosa enciclopedica «X e' un Y» compare una volta, nella prima riga; la
% forma che l'autore usa davvero per dire di che cosa parla e' l'elenco con un
% appiglio: «organismi come le piante, le alghe e i cianobatteri». Sulla pagina
% di photosynthesis sono sette fatti IS-A che l'estrattore lasciava per terra.
%
% Il motore e' fisso (testa nominale prima della cue, lista dopo); queste sono
% la parte che cambia da lingua a lingua, ed e' per questo che stanno qui.
enumeration_cue("such as").
enumeration_cue("including").
enumeration_cue("for example").
enumeration_cue("for instance").
enumeration_cue("ad esempio").
enumeration_cue("per esempio").
% «like» e «come» sono ambigui: introducono tanto un elenco quanto una
% similitudine («si comporta come un fluido»). Il cancello dei due membri li
% rende usabili — una similitudine ha un termine solo.
enumeration_cue("like").
enumeration_cue("come").
machinery(enumeration_cue).
machinery(solfege_note).
solfege_note(do). solfege_note(re). solfege_note(mi). solfege_note(fa).
solfege_note(sol). solfege_note(la). solfege_note(si). solfege_note(ti).
machinery(code_keyword).
code_keyword(python, while). code_keyword(python, for). code_keyword(python, if).
code_keyword(python, def). code_keyword(python, class). code_keyword(python, else).
code_keyword(python, elif). code_keyword(python, try). code_keyword(python, with).
code_keyword(c, int). code_keyword(c, char). code_keyword(c, float).
code_keyword(c, double). code_keyword(c, void). code_keyword(c, long).
code_keyword(c, return).
% I prefissi riconoscibili dal verificatore sono dati di sintassi, non decisioni
% del C: una superficie nuova si insegna qui e il consumer continua a scansionare.
machinery(code_pattern).
code_pattern(c, return_statement, "return ").
code_pattern(c, int_assignment, "int ").
code_pattern(c, char_pointer_assignment, "char *").
code_pattern(c, sort_return_type, "void ").
code_pattern(c, sort_array_marker, "[]").
code_pattern(c, sort_integer_marker, "int").
code_pattern(c, loop_for_call, "for(").
code_pattern(c, loop_while_call, "while(").
code_pattern(c, python_print_call, "print(").
machinery(tool_surface).
tool_surface(run_prefix, "run ").
tool_surface(compile_marker, "compile").
tool_surface(teach_prefix, "learn ").
tool_surface(teach_prefix, "impara ").
tool_surface(teach_source_delimiter, " from").
tool_surface(teach_source_delimiter, " da ").
machinery(repair_calendar_wh).
repair_calendar_wh(what).
machinery(repair_calendar_copula).
repair_calendar_copula(is).
machinery(repair_calendar_pronoun).
repair_calendar_pronoun(it).
machinery(repair_mean_marker).
repair_mean_marker("mean").
machinery(repair_referential_surface).
repair_referential_surface("refer to").
machinery(repair_translate_surface).
repair_translate_surface("translate").
machinery(repair_translation_question).
repair_translation_question("how do you say").
machinery(repair_language_target).
repair_language_target("french"). repair_language_target("spanish").
repair_language_target("italian"). repair_language_target("english").
machinery(wordmath_speed_unit).
wordmath_speed_unit("km/h").
machinery(wordmath_radius_marker).
wordmath_radius_marker(radius).
machinery(wordmath_diameter_marker).
wordmath_diameter_marker(diameter).
machinery(wordmath_all_but_marker).
wordmath_all_but_marker("all but").

% ── QUANTO VALE UNA PAROLA MOLTIPLICATIVA (gen442) ─────────────────────────
%
% Stavano dentro `wp_recipe_multiplier` in 25-wordmath-reasoning.c: sei
% letterali e tre numeri, in due lingue, invisibili a qualunque query. La
% superficie e il fattore stanno insieme, perche' separarli avrebbe lasciato il
% numero nel motore. Un moltiplicatore nuovo e' un fatto.
machinery(word_multiplier).
word_multiplier("double", 2).      word_multiplier("twice", 2).
word_multiplier("doppio", 2).      word_multiplier("il doppio", 2).
word_multiplier("triple", 3).      word_multiplier("three times", 3).
word_multiplier("thrice", 3).      word_multiplier("triplo", 3).
word_multiplier("quadruple", 4).   word_multiplier("four times", 4).
word_multiplier("quadruplo", 4).

% File suffixes and human names used by the local listing tool are vocabulary,
% not a closed list in its C adapter.
machinery(file_extension).
file_extension(".c"). file_extension(".h"). file_extension(".py").
file_extension(".js"). file_extension(".ts"). file_extension(".md").
file_extension(".txt"). file_extension(".json"). file_extension(".sh").
file_extension(".cpp"). file_extension(".cc"). file_extension(".go").
file_extension(".rs"). file_extension(".java"). file_extension(".rb").
file_extension(".html"). file_extension(".css").
machinery(file_kind_word).
file_kind_word(python, "*.py"). file_kind_word(header, "*.h").
file_kind_word(javascript, "*.js"). file_kind_word(typescript, "*.ts").
file_kind_word(markdown, "*.md"). file_kind_word(shell, "*.sh").
file_kind_word(rust, "*.rs"). file_kind_word(golang, "*.go").
file_kind_word(java, "*.java").

%% ── LE PAROLE CONFRONTATE DENTRO IL MOTORE (gen442) ────────────────────────
