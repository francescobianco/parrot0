% Whole-category questions delegate to category_enumeration/2, a Horn
% procedure in procedures.p0.  The Italian row names the current canonical
% surface (function words are normalized before answer-frame dispatch).
answer_frame("what are the", category_enumeration).
answer_frame("which are the", category_enumeration).
answer_frame("quali am i", category_enumeration).
answer_frame("list the", category_enumeration).
answer_frame("name the", category_enumeration).
% gen382b: la stessa classe — chiedere i MEMBRI di una categoria — aveva cinque
% superfici e non queste. "mi dici i nomi dei pezzi degli scacchi" andava a muro
% mentre "quali sono i pezzi degli scacchi" rispondeva: non un limite di
% comprensione, due righe mancanti. Le forme italiane stanno nella grafia che
% arriva al dispatch (le parole funzionali sono gia' canonicalizzate).
answer_frame("tell me the", category_enumeration).
% gen382e: l'ATTO (chiedere i membri) e il FORMATO (come disporli) sono due
% dimensioni indipendenti, e devono allinearsi entrambe. Queste sono superfici
% dell'atto che nominano anche il formato: il formato lo intercetta
% format_constraint/2, qui serve solo che la richiesta venga riconosciuta.
answer_frame("elenco markdown", category_enumeration).
answer_frame("markdown list of", category_enumeration).
answer_frame("markdown list", category_enumeration).
answer_frame("elenco puntato", category_enumeration).
answer_frame("elenco numerato", category_enumeration).
answer_frame("give me a list of", category_enumeration).
answer_frame("fammi un elenco", category_enumeration).
answer_frame("the names of", category_enumeration).
answer_frame("names of the", category_enumeration).
answer_frame("dimmi i", category_enumeration).
answer_frame("dimmi le", category_enumeration).
answer_frame("mi dici i", category_enumeration).
answer_frame("mi dici le", category_enumeration).
answer_frame("i nomi dei", category_enumeration).
answer_frame("i nomi delle", category_enumeration).

% Una categoria predefinita del dominio non deve cancellare la faccetta
% nominata dalla domanda.  "what are the chess pieces" resta
% category_enumeration/2; quando la superficie chiede i colori, la relazione e'
% side_color/2 e il gioco occupa il primo slot.  Nuovi giochi, colori e forme
% crescono come fatti senza modificare il consumer binario.
answer_frame("what are the colors", side_color).
answer_frame_input_arg("what are the colors", side_color, 1).
answer_frame("which are the color", side_color).
answer_frame_input_arg("which are the color", side_color, 1).
answer_frame("what colors", side_color).
answer_frame_input_arg("what colors", side_color, 1).
answer_frame("which colors", side_color).
answer_frame_input_arg("which colors", side_color, 1).

% Generic conversational access to game experts.  Every surface maps to a
% relation shared by all game files; adding a game or a new phrasing is a KB
% change, and the answer-frame motor remains domain-blind.
answer_frame("how do you play", game_play).
answer_frame("how to play", game_play).
answer_frame("how is play", game_play).
answer_frame("rules of", game_play).
