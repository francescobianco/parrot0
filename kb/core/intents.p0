task_boundary_cue(resource_marker, "with only").
task_boundary_cue(constraint_marker, "with no").
task_boundary_cue(constraint_marker, keyword(without)).
task_boundary_cue(constraint_marker, "must not").

task_span_pattern(goal_comparison, argument_1,
                  operation_end, marker_start(pair_separator)).
task_span_pattern(goal_comparison, argument_2,
                  marker_end(pair_separator), marker_or_turn_end(goal_marker)).
task_span_pattern(goal_comparison, goal,
                  marker_end(goal_marker), marker_or_turn_end(followup_request)).

task_span_pattern(failure_explanation, argument_1,
                  turn_start, operation_start).
task_span_pattern(failure_explanation, argument_2,
                  operation_end, marker_or_turn_end(followup_request)).

task_span_pattern(ordered_procedure, argument_1,
                  operation_end, marker_or_turn_end(modifier_marker)).
task_span_pattern(constraint_synthesis, argument_1,
                  operation_end, turn_end).

task_span_pattern(common, resource,
                  marker_end(resource_marker), marker_or_turn_end(constraint_marker)).
task_span_pattern(common, constraint,
                  marker_end(constraint_marker), turn_end).

machinery(task_boundary_cue).
machinery(task_span_pattern).

