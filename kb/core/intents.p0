% ── LE PAROLE COME OGGETTI (gen391) ─────────────────────────────────────────
% Il consumer binario universale espone le viste di procedures.p0. Le forme di
% domanda sono conoscenza: una nuova superficie costa un answer_frame/2, non un
% recognizer. L'italiano naturale «si dice X o Y?» resta al giro uso/menzione:
% qui non si finge di preservare una forma che la canonicalizzazione ha usato.
answer_frame("preferred term", preferred_label).
answer_frame("alternative term", alternative_label).
answer_frame("term status", form_mark).
answer_frame("si dice", preferred_label).
answer_frame("do you say", preferred_label).

% Denotazione contestuale: il proiettore universale confronta due evidenze — la
% forma e il dominio — e rende l'identita' concettuale selezionata. Senza dominio
% la porta binaria conserva ed enumera tutte le letture candidate.
answer_frame("denote in", contextual_denotation).
answer_frame("denotations of", candidate_denotation).
answer_projection(contextual_denotation, denotation_form_evidence).
projection_gate(contextual_denotation, denotation_domain_evidence).
projection_source(contextual_denotation, denotation_identity, binary).

% gen393: superfici riflessive per osservare il kernel comune dei frame. Non
% costruiscono il frame dal prompt: rendono falsificabili completezza, residuo,
% proof e letture che il produttore ha materializzato nella KB.
answer_frame("frame completeness", frame_completeness).
answer_frame("frame residue", frame_residue).
answer_frame("frame answer", frame_answer).
answer_frame("frame gap", frame_gap).
answer_frame("frame move", frame_move).
% gen394: la mossa DECISA, cioe' quella che resta dopo aver applicato le
% precedenze. `frame_move/2` continua a mostrare tutte le candidate, e le due
% viste servono a cose diverse: una dice che cosa era possibile, l'altra che
% cosa e' stato scelto.
answer_frame("frame decision", frame_decision).
answer_frame("dialogue policy", move_policy).
answer_frame("context kind", context_kind).
answer_frame("local belief", context_effective_belief).
answer_frame("inherited belief", context_inherited_belief).
answer_frame("visible beliefs", context_visible_belief).
answer_frame("context conflict", context_conflict).
answer_frame("relevant scope", scope_relevant).
answer_frame("commitment status", context_commitment).
answer_frame("proposition source", source_of).
answer_frame("proposition confidence", confidence_of).
answer_frame("candidate reading", candidate_reading).
answer_frame("selected reading", selected_reading).
answer_frame("retained reading", retained_reading).

% ── INSEGNARE UNA RISPOSTA PARLANDO ──────────────────────────────────────────
% gen382c. Il motore delle risposte curate (mod_qa, qa_cue/qa_reply) esisteva dal
% gen347, ma si poteva alimentare solo scrivendo nei file: mancava l'ATTO. Queste
% righe sono le superfici con cui glielo si dice in conversazione — "quando ti
% chiedo X rispondi Y" — e il pezzo in C ritaglia soltanto i due lati.
% Aggiungere una formulazione, o una lingua, e' un fatto.
intent_cue(teach_reply, "when i ask about").
% gen428: misurata come mancante provando a insegnare parlando — «when i say
% bonjour answer hello» non veniva capito, e la facolta' c'era gia' tutta. Il
% buco non era il motore, era l'INVENTARIO delle superfici, e una superficie e'
% una riga.
intent_cue(teach_reply, "when i say").
intent_cue(teach_reply, "quando dico").
intent_cue(teach_reply, "when i ask you about").
% Le righe italiane stanno nella grafia che ARRIVA al dispatch: le parole
% funzionali sono gia' canonicalizzate, quindi la formulazione va scritta come il
% motore la vede, non come la si scrive (stessa lezione di "quali am i", gen379).
intent_cue(teach_reply, "chiedo").
intent_cue(teach_reply, "quando ti chiedo di").
intent_cue(teach_reply, "quando ti chiedo del").
intent_cue(teach_reply, "quando ti chiedo della").
intent_cue(teach_reply, "quando ti chiedo delle").
intent_cue(teach_reply, "quando ti chiedo dei").
intent_cue(teach_reply, "quando ti chiedo degli").
intent_cue(teach_reply, "quando ti chiedo").
intent_cue(teach_reply, "quando parlo di").
% Il separatore fra la situazione e la risposta da dare.
machinery(teach_reply_pivot).
teach_reply_pivot("rispondi").
teach_reply_pivot("answer").
teach_reply_pivot("reply").
teach_reply_pivot("di'").
teach_reply_pivot("dici").
teach_reply_pivot("say").
teach_reply_pivot("answer").
teach_reply_pivot("reply").
teach_reply_pivot("respond").

% ── MARKDOWN: il LAYOUT di un elenco come conoscenza (gen382e) ───────────────
% Lo strato dei formati esisteva (format_constraint/2 dice quali parole chiedono
% quale formato) ma il realizzatore era uno solo e cablato nel motore, quindi
% "un elenco markdown" non era esprimibile: mancava il DATO che descrive come si
% dispone una riga. Da qui un formato nuovo e' una riga, non un realizzatore.
%
%   format_layout(Mode, Prefisso, Numerato)
% MACCHINERIA: come si dispone una riga non e' conoscenza del mondo.
% E' MACCHINERIA: come si dispone una riga non e' conoscenza del mondo, e non
% deve contare fra le cose che parrot0 dice di sapere.

% Quali parole chiedono quel formato. Sono superfici, quindi crescono da sole.
format_constraint(markdown_list, "markdown").
format_constraint(markdown_list, "elenco puntato").
format_constraint(markdown_list, "bullet list").
format_constraint(markdown_list, "as bullets").
format_constraint(markdown_numbered, "elenco numerato").
format_constraint(markdown_numbered, "numbered markdown").
% gen382e: una checklist stile GitHub, insegnata con DUE fatti e zero C — e' la
% prova che il layout e' davvero conoscenza e non un realizzatore in piu'.
format_constraint(checklist, "checklist").

% ── IL VOCABOLARIO CHE ERA NEL MOTORE (gen442) ─────────────────────────────
%
% Mantra #2: niente liste di parole nel C. Queste erano catene
