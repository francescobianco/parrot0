response_template(repair_infra, "I cannot verify a repair because the verification infrastructure failed.").

% T06 bridge: the canonical boundary outcomes of a repository-bound repair.
% Each names the real terminal — commit, policy denial, red canonical oracle,
% stale base — and the state of the workspace, never a vaguer story.
response_template(repair_committed, "Repaired {path}: the candidate passed the oracle in isolation, the live policy authorized the edit, and the canonical re-check passes. The workspace now holds the fix.").
response_template(repair_already_green, "I ran {path} against the oracle: it already passes every case, so there was nothing to repair.").
response_template(repair_policy_gap, "The repair for {path} passed the oracle, but no live commit_policy authorizes that edit, so I did not write anything. Assert the policy fact and ask again if you want it committed.").
response_template(repair_post_check_failed, "The candidate passed in isolation but the canonical oracle went red after commit, so I rolled {path} back byte-and-mode. The workspace is unchanged.").
response_template(repair_commit_conflict, "The base of {path} changed while the candidate was being verified, so the commit was refused before any write. The workspace is unchanged.").

% ── gen363: i gap DICHIARATI ────────────────────────────────────────────────
% Un consumer che riconosce la richiesta ma non ha i fatti per servirla non sta
% rispondendo: sta dichiarando un gap. Prima la frase era cablata nel C, quindi
% (a) non era insegnabile e (b) era indistinguibile da una risposta, così il
% turno risultava "gestito" e il pianificatore di ultima istanza non partiva mai.
% Ora la frase è un frame come tutti gli altri e `gap_frame/1` (meta.p0) dice al
% motore che cosa quel frame significa.
% gen376: il declino nomina l'ANELLO MANCANTE, come ovunque altrove. Prima diceva
% "for that topic", generico; da quando mod_plan declina sui goal senza prerequisiti
% questo e' l'unico messaggio che l'utente vede, e deve dire DI COSA non sa i passi.
response_template(process_step_gap, "I understood you're asking how to make {topic}, but I don't have the steps for it yet.").
response_template(activity_step_gap, "I understood you're asking for a recommendation, but I don't have a grounded plan for that situation yet.").
response_template(activity_intro, "From what I know, a good plan is:").
response_template(activity_intro, it, "Per quanto ne so, un buon piano è:").
response_template(plan_header, "My derived plan for {goal}:").
response_template(plan_header, it, "Il mio piano derivato per {goal}:").
response_template(plan_budget_note, "[total cost {cost}, total time {time}]").
response_template(plan_budget_note, it, "[costo totale {cost}, tempo totale {time}]").
response_template(activity_favorite_intro, "I don't have real favorites, but a good plan is:").
response_template(activity_favorite_intro, it, "Non ho vere preferenze, ma un buon piano è:").
response_template(taxonomy_definition, "{Subject} belongs to the category {category}.").
response_template(taxonomy_definition, it, "{Subject} appartiene alla categoria {category}.").
response_template(arith_division_zero, "I can't divide by zero.").
response_template(arith_division_zero, it, "Non posso dividere per zero.").

% gen363: lo stesso scambio, ma fra i partecipanti che il turno ha nominato.
% La forma è identica a generic_dialogue_answer — cambia solo chi parla, ed è
% esattamente ciò che il giudice ha rilevato come mancante.
response_template(named_dialogue_answer, "{speaker_a}: {topic} could open possibilities we have not considered.
{speaker_b}: Or it could expose costs we are ignoring.
{speaker_a}: Then we should test the benefits without hiding the risks.
{speaker_b}: Agreed; curiosity needs evidence and accountability.").

% gen363: lo stesso scambio quando il turno nomina i due interlocutori ma non
% lascia una coda-argomento riconoscibile: i partecipanti bastano a rendere.
response_template(named_dialogue_open, "{speaker_a}: We see the same thing and call it by different names.
{speaker_b}: Then say what you mean, and I will say where I disagree.
{speaker_a}: What looks like change to me may only be patience to you.
{speaker_b}: And what looks like permanence to me may only be a slower change.").

% gen375 — quando cio' che ti dicono ADESSO stride con cio' che gia' si sa.
% parrot0 accettava "a dog is a fish" in silenzio e poi sosteneva sia fish(dog)
% sia is_a(dog, mammal), due cose che la KB stessa dichiara incompatibili. Non e'
% un errore da rifiutare — chi parla puo' avere ragione, o stare supponendo — ma
% tacerlo e' disonesto. Si accetta l'asserzione E si nomina la tensione, tenendo
% i DUE livelli visibili invece di sceglierne uno di nascosto.
response_template(class_conflict, "That sits badly with what I already hold: {subject} is a {held}, and {claimed} and {held} cannot both apply.").
response_template(class_conflict, it, "Questo stride con quello che gia' so: {subject} e' un {held}, e {claimed} e {held} non possono valere insieme.").

% ── RICERCA INTERROTTA: indeterminato, NON falso (gen382) ────────────────────
% Quando la guardia anti-isteresi taglia un goal gia' aperto piu' in alto, la
% ricerca non ha ESAURITO le possibilita': si e' fermata. Rispondere "No." in
% quel caso e' negation-as-failure applicata a un mondo chiuso che non c'e' —
% e' dichiarare FALSO cio' che e' soltanto INDETERMINATO.
%
% La distinzione e' esattamente quella che un ragionatore vero fa sullo stesso
% stimolo (sonda tests/hysteresis_probe.py, che NON gira a runtime): "con le
% sole informazioni fornite non possiamo stabilirlo", perche' le classi si
% implicano a vicenda e nessun fatto le ancora. La circolarita' non e' un
% guasto da nascondere: e' la cosa piu' informativa che si sia scoperta nel
% turno, e va detta.
response_template(undetermined_cycle, "I cannot settle that: {subject} is not tied to {klass} by any fact I hold, and the rules around {klass} lead back into each other, so the search closes on itself instead of reaching an answer. Not proved is not the same as false.").
response_template(undetermined_cycle, it, "Non posso stabilirlo: nessun fatto che ho lega {subject} a {klass}, e le regole intorno a {klass} si rimandano a vicenda, quindi la ricerca si chiude su se stessa invece di arrivare a una risposta. Non dimostrato non vuol dire falso.").
response_template(saturated_read_unavailable, "I cannot settle that from the current view: the knowledge list reached its limit before I could verify the result.").
response_template(saturated_read_unavailable, it, "Non posso stabilirlo dalla vista corrente: l'elenco della conoscenza ha raggiunto il limite prima che potessi verificare il risultato.").

% gen382: una pagina di disambiguazione riconosciuta. Il declino e' INFORMATO —
% dice che la pagina c'era e perche' e' stata rifiutata — invece di far credere
% che non ci fosse nulla.
response_template(page_disambiguates, "that page disambiguates several meanings rather than describing one").
response_template(page_disambiguates, it, "quella pagina disambigua piu' significati invece di descriverne uno").

% gen382c: conferma dell'atto di insegnamento di una risposta.
response_template(taught_reply, "Understood: when you ask about {cue} I will say so.").
response_template(taught_reply, it, "Capito: quando mi chiedi di {cue} risponderò così.").

% Apprendimento assistito A1. La prima risposta dice CANDIDATO, non "ho capito":
% la comprensione viene disposta dal replay e dal transfer nei turni successivi.
response_template(construction_candidate, "I learned a candidate construction: {source} maps to {target}. Test me with new names before we call it understood.").
response_template(construction_candidate, it, "Ho appreso una costruzione candidata: {source} corrisponde a {target}. Provala con nomi nuovi prima di chiamarla comprensione.").
response_template(construction_already_known, "That construction is already active: {source} maps to {target}.").
response_template(construction_already_known, it, "Quella costruzione è già attiva: {source} corrisponde a {target}.").
response_template(construction_target_unknown, "I cannot anchor that lesson yet: I do not have one unambiguous reading for {target}.").
response_template(construction_target_unknown, it, "Non posso ancora ancorare quella lezione: non ho una lettura univoca per {target}.").
response_template(construction_shape_unsupported, "I found the teaching pivot, but I cannot align exactly two shared variables on both sides. I have not learned the construction.").
response_template(construction_shape_unsupported, it, "Ho trovato il separatore didattico, ma non riesco ad allineare esattamente due variabili condivise sui due lati. Non ho appreso la costruzione.").
response_template(construction_conflict, "I already read {source} through a different frame, so I have kept both readings visible and have not selected the new one.").
response_template(construction_conflict, it, "Leggo già {source} attraverso un frame diverso, quindi ho lasciato visibili entrambe le letture e non ho selezionato quella nuova.").
response_template(construction_forgotten, "The construction {source} -> {target} is no longer active; I kept its lesson trace.").
response_template(construction_forgotten, it, "La costruzione {source} -> {target} non è più attiva; ho conservato la traccia della lezione.").
response_template(construction_not_known, "I did not have that construction active, so there was nothing to retract.").
response_template(construction_not_known, it, "Non avevo quella costruzione attiva, quindi non c'era nulla da ritrarre.").

% gen382k: una premessa ASSERITIVA che contraddice cio' che parrot0 tiene. Non e'
% un rifiuto — chi parla puo' avere ragione — ed e' esattamente cio' che la
% rinominazione rende impossibile dire: se il gatto dell'ipotesi fosse un altro
% concetto, non ci sarebbe nessun conflitto da nominare.
response_template(premise_conflict, "Before I answer: what you state clashes with what I hold — I have {held}({subject}), and {claimed} and {held} cannot both apply.").
response_template(premise_conflict, it, "Prima di rispondere: quello che affermi stride con quello che tengo — ho {held}({subject}), e {claimed} e {held} non possono valere insieme.").

% gen412 — insegnare una CLASSE a qualcosa che la KB conosce con un'altra forma.
% «runs_version is an extract_frame» ha la forma di un insegnamento valido ma
% extract_frame/2 e' binario: il fatto unario che ne nasceva era inutile e veniva
% accettato in silenzio. Il rifiuto e' INFORMATO — nomina la forma vera — perche'
% chi insegna deve poter capire in che modo ha sbagliato, non solo che ha sbagliato.
response_template(class_arity_conflict, "I know {class} as a {arity}-part fact, not a class, so I can't put something in it that way.").
response_template(class_arity_conflict, it, "Conosco {class} come un fatto in {arity} parti, non come una classe, quindi non posso metterci dentro qualcosa in quel modo.").

% gen413 — parrot0 ha cambiato la propria macchineria per rispondere. E' un atto,
% e un atto si annuncia: chi legge deve poter distinguere una risposta che sapeva
% dare da una che ha potuto dare solo dopo essersi modificato.
response_template(self_corrected_on_wall, "{answer}  (I was missing a piece and taught it to myself: {bridge})").
response_template(self_corrected_on_wall, it, "{answer}  (mi mancava un pezzo e me lo sono insegnato: {bridge})").

% gen413 — la risposta a una domanda polare su una proposizione nota che NON e'
% derivabile. «Non lo so» sarebbe vero ma debole: qui il motore sa qualcosa di
% piu' preciso — che dalla regola quella conclusione non segue — e dirlo e' la
% differenza fra ignorare e ragionare.
response_template(not_necessarily, "Not necessarily.").
response_template(not_necessarily, it, "Non necessariamente.").

% gen415 — il turno appartiene a un registro riconosciuto ma non risolvibile.
% E' il declino informato fatto bene: nomina la FORMA del problema invece di una
% parola qualunque, e cosi' chi legge — persona o ciclo di riparazione — sa da
% che parte guardare.
response_template(register_declined, "That looks like a {register} problem, and I cannot solve it yet.").
response_template(register_declined, it, "Mi sembra un problema di {register}, e non so ancora risolverlo.").

% gen416 — la forma e' stata riconosciuta ma non si completa. E' il declino piu'
% informativo che parrot0 sappia dare: nomina il PEZZO, non l'area e non una
% parola, ed e' l'unico che indichi da solo un rimedio.
response_template(schema_incomplete, "I can see a {schema} shape here, but the {role} is missing.").
response_template(schema_incomplete, it, "Ci vedo una forma di tipo {schema}, ma manca {role}.").

% gen420 — la conferma di aver dimenticato. Va detta, perche' un oblio silenzioso
% e' indistinguibile da un turno non capito.
response_template(forgotten_ack, "Done — I've let go of your {slot}.").
response_template(forgotten_ack, it, "Fatto — ho lasciato andare il tuo {slot}.").

% gen426 — un turno di UNA PAROLA SOLA, classificato invece che salutato.
% Le classi misurate mostravano «what», «help», «true», «qzxv», «dog» e «yes»
% con la stessa risposta E la stessa firma: sei turni indistinguibili da dentro e
% da fuori. Ognuno ha la sua mossa.
response_template(lone_question_word, "That's the start of a question — what would you like to know?").
response_template(lone_question_word, it, "E' l'inizio di una domanda — che cosa vorresti sapere?").
response_template(lone_known_topic, "What would you like to know about {token}?").
response_template(lone_known_topic, it, "Che cosa vorresti sapere su {token}?").
response_template(lone_unknown_token, "I have nothing on {token} — could you say what you mean by it?").
response_template(lone_unknown_token, it, "Non ho niente su {token} — mi dici che cosa intendi?").
response_template(lone_assent, "Got it — what would you like to do?").
response_template(lone_assent, it, "Ricevuto — che cosa vuoi fare?").

% gen431 — la richiesta e' incompleta, e si dice quale pezzo manca.
response_template(missing_referent, "I don't have the {kind} you mean — paste it here and I'll work on it.").
response_template(missing_referent, it, "Non ho {kind} di cui parli — incollamelo qui e ci lavoro.").

% gen431 — non c'e' niente da dimenticare, ed e' una risposta.
response_template(nothing_to_forget, "I don't have your {slot} on record, so there is nothing to forget.").
response_template(nothing_to_forget, it, "Non ho {slot} in memoria, quindi non c'e' niente da dimenticare.").

% Gen438: il lettore riferisce soltanto i due contatori prodotti dal meccanismo;
% lingua, parole e disposizione degli slot restano sostituibili nella KB.
response_template(reader_summary, en, "Learned {learned} fact(s), skipped {skipped}.").
response_template(reader_summary, it, "Ho appreso {learned} fatti, ne ho saltati {skipped}.").
response_template(reader_document_summary, en, "Mapped {units} document unit(s) and {relations} rhetorical relation(s); learned {learned} fact(s), skipped {skipped}.").
response_template(reader_document_summary, it, "Ho mappato {units} unita' documentali e {relations} relazioni retoriche; ho appreso {learned} fatti e ne ho saltati {skipped}.").
response_template(reader_claim_summary, en, "Mapped {units} document unit(s), {claims} reported claim(s), and {typed} live epistemic status(es); learned {learned} world fact(s), skipped {skipped}.").
response_template(reader_claim_summary, it, "Ho mappato {units} unita' documentali, {claims} claim riportate e {typed} status epistemici vivi; ho appreso {learned} fatti del mondo e ne ho saltati {skipped}.").
% SC2-B — la quarantena e' un numero, non una promessa. Il sommario dice quante
% proposizioni sono state NORMALIZZATE senza essere credute: la frase conserva
% il prefisso di SC2-A perche' la coordinata vecchia non cambia significato.
response_template(reader_claim_summary_normalized, en, "Mapped {units} document unit(s), {claims} reported claim(s), and {typed} live epistemic status(es); {normalized} proposition(s) normalized in quarantine; learned {learned} world fact(s), skipped {skipped}.").
response_template(reader_claim_summary_normalized, it, "Ho mappato {units} unita' documentali, {claims} claim riportate e {typed} status epistemici vivi; {normalized} proposizioni normalizzate in quarantena; ho appreso {learned} fatti del mondo e ne ho saltati {skipped}.").

% SC2-B — RISPONDERE A UNA DOMANDA SU UNA CLAIM RIPORTATA.
%
% Una risposta su cio' che un documento riporta non e' una risposta sul mondo, e
% la differenza deve stare nella FRASE, non in una nota a margine: chi legge
% deve sentire l'attribuzione e lo status prima del contenuto. Il verbo di
% riporto e' qui perche' e' conoscenza — cambiarlo e' una lezione, non una
% patch.
response_template(claim_content_answer, "The source reports it as {status}: {surface} (from {source}).").
response_template(claim_content_answer, it, "La fonte lo riporta come {status}: {surface} (da {source}).").
response_template(claim_content_answer_unsourced, "The text reports it as {status}: {surface}.").
response_template(claim_content_answer_unsourced, it, "Il testo lo riporta come {status}: {surface}.").
response_template(claim_status_confirmed, "Yes - that claim is reported as {status} (from {source}).").
response_template(claim_status_confirmed, it, "Si' - quella claim e' riportata come {status} (da {source}).").
response_template(claim_status_other, "No - that claim is reported as {actual}, not {status}.").
response_template(claim_status_other, it, "No - quella claim e' riportata come {actual}, non come {status}.").
response_template(claim_status_unreadable, "I recognize this as a {status} verification question, but I cannot normalize its proposition yet.").
response_template(claim_status_unreadable, it, "Riconosco una domanda di verifica {status}, ma non riesco ancora a normalizzarne la proposizione.").
response_template(claim_proof_trace, "I read it in {unit} of {source}, at {span}, and «{cue}» marks it as {status}.").
response_template(claim_proof_trace, it, "L'ho letto in {unit} di {source}, a {span}, e «{cue}» lo marca come {status}.").
response_template(claim_status_modal, "Not as a result - that claim is reported as {status}, and only as {force}.").
response_template(claim_status_modal, it, "Non come risultato - quella claim e' riportata come {status}, e soltanto come {force}.").
response_template(claim_status_confirmed_modal, "Yes - that claim is reported as {status}, as {force} (from {source}).").
response_template(claim_status_confirmed_modal, it, "Si' - quella claim e' riportata come {status}, come {force} (da {source}).").
% SC3 — su che cosa poggia una conclusione, e che cosa resta quando la premessa
% non e' piu' viva. La seconda frase non e' un errore: e' l'unica risposta onesta
% per una conclusione rimasta senza appoggio, e dirla e' diverso sia dal tacere
% sia dal continuare ad affermarla.
response_template(claim_support_answer, "It rests on: {premise} - reported as {status} (from {source}).").
response_template(claim_support_answer, it, "Poggia su: {premise} - riportato come {status} (da {source}).").
response_template(claim_support_lost, "Nothing supports it any more - I no longer have a status for: {premise}.").
response_template(claim_support_lost, it, "Non lo sostiene piu' niente - non ho piu' uno status per: {premise}.").
response_template(claim_support_also, "And on: {premise} - reported as {status}.").
response_template(claim_support_also, it, "E su: {premise} - riportato come {status}.").
response_template(mentioned_class_forgotten, "I no longer treat «{word}» as a {class}.").
response_template(mentioned_class_forgotten, it, "Non considero piu' «{word}» un membro della classe {class}.").
response_template(tool_result, "{label}: {result}").
response_template(tool_result, it, "{label}: {result}").
response_template(tool_result_empty, "{label}: {result}.").
response_template(tool_result_empty, it, "{label}: {result}.").
response_template(ambiguous_description, it, "Ce n'e' piu' di uno — {options}. Quale intendi?").
