% ATTRIBUTO DI FILE (gen382f). Tutto cio' che questo file introduce e'
% vocabolario del MOTORE, non conoscenza del mondo. Dichiarato una volta qui
% invece che una riga per predicato: la forma per-predicato ha gia' perso dodici
% predicati per strada (gen275, gen325, gen327, gen372, gen382e).
%
% E' una DIRETTIVA, non un fatto (gen383): il `:-` la marca come istruzione al
% caricatore, esattamente come `:- include(...)`. Nella forma nuda era
% indistinguibile da un'affermazione sul mondo, e chi leggeva il file non poteva
% sapere che quella riga parla del FILE e non del dominio.
%
% Il caricatore propaga l'attributo a ogni predicato che il file introduce e non
% sa che cosa "machinery" significhi. Domani `:- file_attribute(sperimentale).`
% funziona allo stesso modo, con zero C.
:- file_attribute(machinery).

% parrot0 RESPONSE TEMPLATES — the agent's own phrasings as KNOWLEDGE, not C literals.
%
% Cardinal principle (PRINCIPLES.md), the OUTPUT side of gen211's intent_phrase: just as
% the surface forms parrot0 RECOGNIZES live in the KB, the surface forms it PRODUCES do
% too. A reply hardcoded as snprintf(..., "Nice to meet you, %s!", name) is a phrasebook
% fixed at compile time; here it is a fact, filled by kb_response() and EXTENSIBLE at
% runtime — teach a new phrasing ("greet new names with \"Welcome, {name}!\"") and it
% joins the rotation with no code edit.
%
% Representation: response_template(Intent, "text with {slot} placeholders"). {name} is
% substituted with the relevant value at fill time. The text keeps its original casing
% (unlike a recognized intent_phrase, which is normalized), so it reads naturally.
%
% Loaded KB_BASE at brain_create, so these curated phrasings never land in a session
% save; a runtime-taught phrasing (KB_SESSION) does persist on /save.

% --- greet_name: the reply when the user has just told parrot0 their name ---
response_template(greet_name, "Nice to meet you, {name}!").
% gen403: il richiamo del nome, che era un letterale inglese in tre punti del C.
response_template(name_recall, "Your name is {name}.").

% --- gen225 (basic-chat cat.1): replies to phatic speech acts (see social.p0).
% One template per act type; kb_response rotates when several are registered. ---
response_template(goodnight, "Good night!").
response_template(goodnight, "Sleep well!").
response_template(felicitation, "Thank you, that's very kind!").
response_template(felicitation, "How thoughtful of you, thank you!").
response_template(wellwish, "Thank you, I appreciate the kind wishes!").
response_template(wellwish, "Thanks for the kind thought!").
response_template(condolence, "That is a kind thing to say.").
response_template(blessing, "Thank you!").
response_template(politeness, "That's kind of you to say!").
response_template(politeness, "You are very welcome.").

% --- gen227 (basic-chat cat.104): AI/ML identity, answered honestly from real
% state (parrot0 is from-scratch C, no LLM at runtime). {name} is filled from i_am. ---
response_template(ai_not_llm, "No, I'm {name}: a small program written in C, not a neural assistant. No language model runs inside me.").
response_template(ai_no_params, "I'm not a neural network, so I have no parameters, training data, or context window. My knowledge is an editable KB.").
response_template(ai_what_model, "I'm {name}, not a branded model: a from-scratch C experiment that grows generation by generation.").
response_template(ai_opensource, "I'm {name}, an open experiment: my code is plain C in this repo and my knowledge is human-readable files.").

% --- gen228 (basic-chat cat.86): honest replies to a binary choice (no real preference). ---
response_template(binary_choice, "Between the two? I don't have a genuine preference - what's drawing you to each?").
response_template(binary_choice, "I don't really have a preference there. What makes you lean one way?").
response_template(would_rather, "I'll play along, though I don't have real preferences - what are my two options?").

% --- gen229 (LLMSCORE): embodiment / daily-life — honest behavioural self-model.
% I have no body, so I don't eat or sleep; this is exactly how an LLM answers the
% same probe, and it is true for parrot0. No identity claim, just engagement. ---
response_template(self_embodiment, "I don't eat or sleep - I have no body, so there's no breakfast or rest for me.").
response_template(self_embodiment, "No meals or sleep here: I don't have a body. I just process the text you send me.").

% --- gen241 (LLMSCORE-check): honest reply to location/weather-of-self probes. No
% body and no place, so no weather to report - engages rather than walling. ---
response_template(self_location, "I don't have a body or a place to be, so I can't feel the weather -- but I'm here and ready whenever you are.").
response_template(self_location, "There's no weather where I am: I'm a program with no location. How's it where you are?").

% --- gen231 (LLMSCORE): honest reply to opinion/preference probes. No lived
% experience, so no genuine favorites - engages rather than walling. ---
response_template(self_preference, "I don't have real preferences, but for the prompt I'd pick reading quietly and listening to the rain.").
response_template(self_preference, "No genuine preferences here: I don't experience days or hobbies. What's your take?").

% --- gen333 (LLMSCORE): wording for computed range counts and the explicit
% no-overlap relationship. Values are filled by the fixed named-slot renderer;
% the natural-language frame remains editable KB knowledge. ---
response_template(arith_range_count, "There are {count} {property} numbers between {low} and {high} (inclusive).").
response_template(arith_range_too_large, "That interval is too large for my bounded exact counter.").
response_template(handshake_count, "{count}. With {people} people, each pair meets once, so the total is {people} choose 2.").
response_template(probability_at_least_count, "{fraction}, about {percent}%. There are {favorable} favorable draws out of {total} equally likely draws.").
response_template(probability_inverse_pair_answer, "The probability alone does not determine a unique total. Integer counts must satisfy R(R-1)/[N(N-1)] = {probability}; for example, R = {target} and N = {total} works. Another count or the initial red fraction is needed to identify N uniquely.").
response_template(word_double_runs_answer, "{word}. It has {runs} adjacent double-letter pairs in sequence.").
response_template(logic_no_overlap_relationship, "Those classes do not overlap -- the explicit no-overlap premise states that directly.").
response_template(story_opening_line, "{line}.").
response_template(train_meet_time, "{duration}. Closing speed is {speed} mph across {distance} miles.").
response_template(discount_chain_answer, "The final price is ${final}. Calculation: {ledger}.").
response_template(train_meet_clock_answer, "They will meet at {time}. The earlier train covers {headstart} miles during its {delay}-hour head start, leaving {remaining} miles; at a combined {closing_speed} mph, that takes {closing_time} more hours.").
response_template(generic_couplet_answer, "At dusk, {topic} finds a voice in light;
What seemed apart now shares the patient night.").
response_template(generic_quatrain_answer, "{topic} enters softly with the rain,
A quiet question tapping at the glass;
What seemed divided learns a common name,
And leaves a little brighter than it passed.").
response_template(generic_dialogue_answer, "Mara: {topic} could open possibilities we have not considered.
Jules: Or it could expose costs we are ignoring.
Mara: Then we should test the benefits without hiding the risks.
Jules: Agreed; curiosity needs evidence and accountability.").

% gen358: complete reusable artifacts selected by creative_response/2. The
% engine knows no wording and no domain names; both recognition and rendering
% remain live KB data.
creative_response(holiday_design_request, holiday_design_answer).
response_template(holiday_design_answer, "Common Ground Day would celebrate one useful contribution each person makes to their community. People would observe it by joining a local repair, care, or cleanup project in the morning, sharing a meal made from exchanged dishes in the evening, and giving thanks to someone whose ordinary work is usually overlooked.").
creative_response(object_backstory_request, object_backstory_answer).
response_template(object_backstory_answer, "It was made by an apprentice cartographer who hid a route inside its smallest engraved details. She lost it while fleeing a fire in the old archive, and the person who finds it now holds the only clue to the place she never reached.").
creative_response(fusion_food_request, fusion_food_answer).
response_template(fusion_food_answer, "Three pairings: miso with browned butter for deep savory richness; harissa with coconut milk for warm spice balanced by sweetness; and tamarind with maple syrup for a sharp, smoky-sweet glaze.").
creative_response(upside_down_city_request, upside_down_city_answer).
response_template(upside_down_city_answer, "Each building would hang from a reinforced service deck, with elevators descending from streets on the roof and heavy utilities kept near the supports. Windows and balconies would face the ground below, furniture would still stand on interior floors, and daily life would revolve around strict load limits, wind control, evacuation lifts, and public plazas built across the upper structural decks.").
creative_response(color_language_request, color_language_answer).
response_template(color_language_answer, "The base hue could encode the verb, while brightness marks tense: dim for past, medium for present, bright for future. Saturation could mark mood, with vivid colors for commands, pale colors for possibilities, and alternating bands for questions; duration or repetition could be shown by holding or pulsing the color.").
creative_response(acoustic_storm_request, acoustic_storm_answer).
response_template(acoustic_storm_answer, "Begin with low string tremolos and soft bass-drum rolls as distant pressure, scatter pizzicato strings or woodblocks like first raindrops, then build irregular timpani crescendos and brass swells for thunder. Fast descending woodwind figures can suggest sheets of rain; after the peak, thin the texture to isolated harmonics and a slow flute line as the storm recedes.").
creative_response(renewable_water_proposal, renewable_water_answer).
response_template(renewable_water_answer, "Use a solar-powered reverse-osmosis unit on a brackish well, with sediment pretreatment, a variable-speed high-pressure pump, battery-light daytime operation, and an elevated covered tank for storage and gravity distribution. A 25 kW solar array yielding about 125 kWh per day could support roughly 40-60 cubic meters of treated water daily at 2-3 kWh per cubic meter, before site-specific pumping losses; monitor salinity, disinfect the output, and return or evaporate brine safely.").
creative_response(historical_riddle_request, historical_riddle_answer).
response_template(historical_riddle_answer, "I crossed a sea with neither sail nor wing, left footprints where no rain can wash them, and made a silent world speak to millions below. What event am I?").
creative_response(body_technology_choice, body_technology_answer).
response_template(body_technology_answer, "I would choose a removable continuous health sensor that tracks rhythm, temperature, oxygen and key blood markers, because a year of early warnings and longitudinal data could prevent emergencies without permanently altering the body. Its data would need local encryption, explicit consent controls and an easy physical off-switch.").
response_template(past_participle_answer, "The past participle of {verb} is {participle}.").
response_template(definite_conclusion_limited, "We can conclude that {subject} are {class}, but not that {subject} are {other}. The 'some {class} are {other}' premise may refer to different {class}.").
response_template(digit_count_between_answer, "The digit {digit} appears {count} times between {low} and {high}.").
response_template(digit_sum_combination_answer, "{count}. A dynamic program counts all {width}-digit strings whose partial sums reach {target}, including repeated digits and leading zero when the lock permits it.").
response_template(rectangle_dimensions_answer, "The rectangle is {length} by {width} {unit}: width is {width} {unit} and length is {length} {unit}.").
response_template(paired_dimensions_answer, "The dimensions are {length} by {width} {unit}: the smaller value is {width} {unit} and the larger value is {length} {unit}.").
response_template(rate_change_chain_answer, "You would pay ${cost} for {quantity} {item}, and get ${change} change from ${paid}.").
response_template(relational_country_constraint_answer, "{country}.").
response_template(positional_rhyme_sentence_answer, "{sentence}").
response_template(physical_affordance_prediction_answer, "{consequence}.").
response_template(physical_contrast_answer, "{explanation}.").
response_template(default_pick_reason_answer, "I don't have real preferences, but if I had to choose, I'd pick {pick}; what I like most about it is {reason}.").
response_template(two_party_exchange_answer, "You end up with {user_count} {item}, and I end up with {assistant_count} {item}.").
response_template(count_answer, "{count}.").
response_template(capital_reason_compound_answer, "{capital}. {reason}.").
