% gen398a: i residui del piano situazionale. Sono tre esiti disgiunti e nessuno
% dei tre e' un piano: conoscere la situazione non autorizza a inventare
% un'azione, e conoscere un'azione non autorizza a ignorarne la precondizione.
response_template(situation_no_action, en, "I can see that situation, but I know no action of mine that changes it that way.").
response_template(situation_no_action, it, "Vedo quella situazione, ma non conosco un'azione che la cambi in quel verso.").
response_template(situation_blocked, en, "I know an action for that, but one of its preconditions does not hold in that situation.").
response_template(situation_blocked, it, "Conosco un'azione adatta, ma in quella situazione una sua precondizione non vale.").
response_template(situation_plan_ambiguous, en, "More than one action would change it that way, and nothing in the situation chooses between them.").
response_template(situation_plan_ambiguous, it, "Piu' di un'azione lo cambierebbe in quel verso, e la situazione non sceglie fra loro.").

% gen395: la mossa `acknowledge`. Una stipulazione non fa una domanda, quindi
% cio' che e' dovuto e' dire che l'impegno e' stato preso — non dedurne una
% conseguenza che nessuno ha chiesto.
% gen396: chiedere un registro e' una mossa, e riconoscerla e' la risposta
% dovuta — cambiare stile in silenzio lascerebbe l'interlocutore senza modo di
% sapere che l'ha ottenuto.
% gen397: la ripresa. Dire che cosa manca, o dire che non manca nulla — il
% secondo non e' un muro ma un'informazione, e tacere al suo posto lascerebbe
% l'interlocutore a chiedersi se la domanda sia stata capita.
recall_opener(pending, en, "I still owe you an answer about ").
recall_opener(pending, it, "Ti devo ancora una risposta su ").
recall_opener(settled, en, "Since you asked, I have learned about ").
recall_opener(settled, it, "Da quando l'hai chiesto ho imparato su ").
recall_opener(topic, en, "We are on ").
recall_opener(topic, it, "Stiamo parlando di ").
recall_empty(topic, en, "We are not on anything in particular yet.").
recall_empty(topic, it, "Non stiamo ancora parlando di niente in particolare.").
recall_opener(earlier, en, "Before that we were on ").
recall_opener(earlier, it, "Prima parlavamo di ").
recall_empty(earlier, en, "There was nothing before that.").
recall_empty(earlier, it, "Prima non c'era niente.").
recall_opener(covered, en, "So far we have talked about ").
recall_opener(covered, it, "Finora abbiamo parlato di ").
recall_empty(covered, en, "We have not covered anything yet.").
recall_empty(covered, it, "Non abbiamo ancora toccato niente.").
recall_empty(pending, en, "Nothing is pending: I have answered everything you asked.").
recall_empty(pending, it, "Non c'e' niente in sospeso: ho risposto a tutto quello che hai chiesto.").
recall_empty(settled, en, "Nothing has been settled since: no question of yours has found an answer yet.").
recall_empty(settled, it, "Non si e' chiarito niente: nessuna tua domanda ha ancora trovato risposta.").

% gen398a: descrivere non fa una domanda. La mossa dovuta e' riconoscere che lo
% stato e' stato registrato — dedurne una conseguenza sarebbe rispondere a
% qualcosa che nessuno ha ancora chiesto.
response_template(state_acknowledged, en, "Noted: I am holding that as the current state.").
response_template(state_acknowledged, it, "Annotato: lo tengo come stato attuale.").
response_template(register_acknowledged, en, "Noted: I will keep that register from here on.").
response_template(register_acknowledged, it, "Annotato: da qui in avanti tengo quel registro.").
% gen395: una credenza riportata non e' una cosa che parrot0 crede. Riconoscerla
% dicendo A CHI appartiene e' la mossa dovuta — assorbirla in silenzio sarebbe
% cambiare di padrone a un'affermazione.
response_template(attribution_acknowledged, en, "Noted as theirs, not as mine: I am keeping it attributed.").
response_template(attribution_acknowledged, it, "Annotato come loro, non come mio: lo tengo attribuito.").
response_template(stipulation_acknowledged, en, "All right: I am holding that as a hypothesis, separately from what I know.").
response_template(stipulation_acknowledged, it, "D'accordo: lo tengo come ipotesi, separata da cio' che so.").

% gen395: le due viste nella stessa risposta. Non sono connettivi neutri —
% dicono a quale SCOPE appartiene ciascuna proposizione, che e' esattamente
% l'informazione che sceglierne una sola cancellerebbe.
world_view_opener(en, "In what I know, ").
world_view_opener(it, "Per quello che so, ").
hypothesis_view_opener(en, "; under your hypothesis, ").
hypothesis_view_opener(it, "; per la tua ipotesi, ").

% gen396: i CONNETTIVI della risposta composta (piano proposizionale, §K6).
%
% Non sono risposte: sono i pezzi di lingua che tengono insieme proposizioni gia'
% provate altrove. La distinzione e' l'invariante del renderer — un connettivo non
% puo' portare un claim, quindi comporre non puo' aggiungere nulla alla proof. Una
% lingua nuova entra qui come fatto, e la stessa proof si realizza senza che il
% contenuto proposizionale cambi.
verdict_particle(met, en, "Yes").
verdict_particle(met, it, "Si'").
verdict_particle(broken, en, "No").
