% situation.p0 — LA SITUAZIONE MODIFICABILE COME OGGETTO DELLA KB (gen398a).
%
% Il muro «cosa faresti se una mongolfiera sta cadendo per rallentare la caduta»
% non chiedeva una risposta sulle mongolfiere. Diceva che fra il frame del turno
% e il piano di risposta manca un oggetto: uno STATO su cui un'azione possa
% agire. Questo file introduce quell'oggetto, e nient'altro.
%
% Tre confini, tutti verificabili:
%
%   1. NESSUN LESSICO DI DOMINIO. Qui non compaiono valvole, palloni, zavorre,
%      serbatoi o batterie. Compaiono soltanto le RELAZIONI che un dominio
%      qualunque riempie: stato, precondizione, effetto, legge causale, verso
%      del cambiamento. Il test operativo del mantra e' che un nuovo mondo entri
%      domani con assert/retract, e il ratchet lo esercita su due domini che non
%      condividono una parola.
%
%   2. NESSUN NUOVO PERCORSO NEL C. Il turno arriva gia' reificato dall'unico
%      producer universale (`turn_span/4`, `turn_span_token/4`) e la risposta
%      esce dall'unico contratto `turn_plan_candidate/1` + `turn_response/2`,
%      lo stesso che consumano `conditional-plans.p0` e `code-plans.p0`. Se
%      questo livello avesse avuto bisogno di un router suo, il piano universale
%      non sarebbe universale.
%
%   3. NESSUNA SECONDA TABELLA DI STATO. Lo stato di una situazione e' una
%      credenza visibile di un CONTESTO gen395: `holds_in/2` piu'
%      `context_visible_belief/2`. Non e' eleganza — e' cio' che rende possibile
%      la ripianificazione dopo una correzione senza riscrivere la storia,
%      perche' correggere resta la mossa che `supersedes_in/3` gia' descrive.
%
% Le proposizioni sono REIFICATE: `state_prop(Id, Entita', Proprieta', Valore)`
% invece del termine composto `state(E, P, V)` dentro `holds_in/2`. Non e' una
% comodita' sintattica: `context-scope.p0` tratta gia' una proposizione come
% identita' (`proposition_signature/4`), e l'identita' e' cio' che permette a un
% fatto di essere insegnato, ritrattato e citato da una precondizione senza che
% quattro consumer debbano decomporre lo stesso termine.

:- file_attribute(machinery).

% Gli schemi che un DOMINIO riempie compaiono qui solo nei corpi delle regole.
% Non vanno dichiarati machinery: `action_precondition(open_valve, ...)` e'
% conoscenza del mondo quanto `quantity(deck, cards, 52)`. Machinery e' il
% processo che li legge, non il mondo che descrivono.

% ── 1. IL GOAL: che cosa il turno chiede di CAMBIARE ────────────────────────
%
% Il ruolo di span e' aperto da cue KB. Una lingua nuova, o una forma nuova
% della stessa lingua, entra come fatto; ritraendone una il turno smette di
% aprire una situazione. Il C non conosce nessuna di queste stringhe: le legge
% dall'evidenza `segment_role/2` come qualunque altro ruolo.
segment_role(goal, "how do i").
segment_role(goal, "how can i").
segment_role(goal, "come faccio a").
segment_role(goal, "come posso").

% Il VERSO del cambiamento e' un concetto, non una parola. Le sue forme vivono
% dove vivono tutte le altre — `concept_label/4`, sorgente unica dal gen391 —
% quindi «lower», «abbassare» e una forma insegnata stasera entrano dalla stessa
% porta e la vista `linguistic_form/4` le rende leggibili dalla forma al senso.
change_direction(decrease).
change_direction(increase).

% Le parole del goal sono quelle che il turno ha DETTO, non termini della KB:
% arrivano citate e vengono promosse a senso solo da una regola. E' la stessa
% disciplina di `code-plans.p0` sui nomi legati da una traccia.
turn_goal_span($Turn) :- turn_span($Turn, $Index, goal, $Payload).
goal_span_word($Turn, $Word) :- turn_span($Turn, $Index, goal, $Payload), turn_span_token($Turn, $Index, $Position, $Token), span_atom($Token, $Word).

% Due giunzioni indipendenti, non due posizioni: una parola vale come verso se
% denota un verso, e come proprieta' se una situazione nota ha davvero uno stato
% su quella proprieta'. La seconda condizione e' il filtro che impedisce a
% «il», «the» o a un concetto qualunque di entrare in un ruolo semantico.
% La proprieta' e' situazionale quando una situazione ci tiene davvero uno
% stato, non quando lo SCHEMA di una proposizione la nomina. La differenza e'
% diventata visibile appena `state_prop/4` ha acquistato una clausola unitaria
% con variabili libere (gen398a): la vista era vera per qualunque parola, quindi
% «abbassare» valeva insieme come verso del cambiamento e come proprieta', le
% due letture si annullavano a vicenda e il piano spariva. Un filtro che accetta
% tutto non e' un filtro.
situation_property($Property) :- situation_state($Situation, $Entity, $Property, $Value).
goal_word_direction($Turn, $Direction) :- goal_span_word($Turn, $Word), linguistic_form($Word, $Direction, $Language, $Register), change_direction($Direction).
goal_word_property($Turn, $Property) :- goal_span_word($Turn, $Word), linguistic_form($Word, $Property, $Language, $Register), situation_property($Property).

% Enumerare una volta e leggere il SET e' anche qui lo stato epistemico. Un
% turno che nomina due proprieta' o due versi ha DUE letture: sceglierne una in
% silenzio sarebbe la mossa sbagliata anche quando l'azione e' giusta.
% La guardia `turn_goal_span/1` viene prima della findall e non e' cosmetica:
% `turn_plan_candidate/1` viene interrogata a OGNI turno, e montare un
% sotto-risolutore per scoprire che il turno non ha nemmeno uno span di goal e'
% lavoro pagato da tutte le conversazioni che non parlano di situazioni.
goal_reading_key($Turn, goal($Property, $Direction)) :- goal_word_direction($Turn, $Direction), goal_word_property($Turn, $Property).
goal_reading_set($Turn, $Readings) :- turn_goal_span($Turn), findall($Reading, goal_reading_key($Turn, $Reading), $Readings).
turn_goal($Turn, $Property, $Direction) :- goal_reading_set($Turn, cons(goal($Property, $Direction), nil)).
turn_goal_ambiguous($Turn) :- goal_reading_set($Turn, cons($First, cons($Second, $Tail))).

% ── 2. LA SITUAZIONE: lo stato come credenza visibile di un contesto ────────
%
% `situation_state/4` non e' una tabella: e' la vista che unisce le credenze
% locali del contesto e quelle ereditate dal suo parent. Correggere un fatto
% resta percio' l'operazione gen395, e i fatti degli altri contesti non
% spariscono per il fatto che questo li corregge.
situation_state($Situation, $Entity, $Property, $Value) :- context_visible_belief($Situation, $Proposition), state_prop($Proposition, $Entity, $Property, $Value).

% Di quale situazione parla il turno. Non esiste una «situazione corrente»
% implicita nel motore: e' quella in cui la proprieta' nominata dal goal ha
% davvero uno stato. Se nessuna la possiede, non c'e' situazione — e questo e'
% un residuo onesto, non un mondo da inventare.
turn_task($Turn, $Situation, $Property, $Direction) :- turn_goal($Turn, $Property, $Direction), situation_state($Situation, $Entity, $Property, $Value).

% ── 3. AZIONI: applicabilita' come insieme delle precondizioni non provate ──
%
% Una precondizione e' soddisfatta quando la proposizione che nomina e' vera
% nella situazione. Si legge l'INSIEME di quelle mancanti invece di fermarsi
% alla prima: un'azione bloccata da due precondizioni non e' bloccata da una, e
% la differenza conta appena la risposta dovra' dire che cosa manca.
missing_precondition($Situation, $Action, missing($Proposition)) :- action_precondition($Action, $Proposition), naf(context_visible_belief($Situation, $Proposition)).
missing_precondition_set($Situation, $Action, $Missing) :- findall($M, missing_precondition($Situation, $Action, $M), $Missing).

% `context($Situation, $Kind)` non e' decorazione. Senza quel gate un mondo che
% non esiste non ha credenze, quindi OGNI precondizione vi risulta mancante e
% OGNI azione vi risulta bloccata: l'assenza di conoscenza si travestiva da
% conoscenza negativa. E' la forma peggiore di divergenza — una risposta
% sbagliata col costume di un'assenza onesta — e il ratchet la falsifica
% chiedendo l'azione bloccata di una situazione che non e' mai stata dichiarata.
applicable($Situation, $Action) :- context($Situation, $Kind), action_schema($Domain, $Action), missing_precondition_set($Situation, $Action, nil).
blocked_action($Situation, $Action) :- context($Situation, $Kind), action_schema($Domain, $Action), missing_precondition_set($Situation, $Action, cons($First, $Tail)).

% L'EFFETTO e' cio' che l'azione rende vero; la CONSEGUENZA puo' essere mediata
% da una legge causale del mondo. Restano relazioni distinte perche' hanno
% ablazioni distinte: ritrarre la legge toglie la conseguenza e lascia intatto
% l'effetto — il piano cade, l'azione resta descritta. Un dominio che dichiara
% direttamente un cambiamento come effetto e' letto dalla seconda clausola.
action_consequence($Action, $Change) :- action_effect($Action, $Effect), causal_law($Effect, $Change).
action_change($Action, $Property, $Direction) :- action_consequence($Action, $Change), change_prop($Change, $Property, $Direction).
action_change($Action, $Property, $Direction) :- action_effect($Action, $Change), change_prop($Change, $Property, $Direction).

% ── 3b. LO STATO DOPO UN'AZIONE (gen398c) ──────────────────────────────────
%
% Applicare un'azione non modifica la situazione: la si GUARDA come sarebbe. E'
% la condizione perche' un piano possa essere valutato senza essere eseguito, e
% perche' valutarne uno non renda impossibile valutarne un altro — un motore che
% dovesse asserire per provare non potrebbe mai confrontare due alternative.
%
% Il delta e' minimo e dichiarato: vale l'effetto dell'azione, e vale tutto cio'
% che l'effetto non contraddice. La contraddizione e' sullo stesso ASSE — stessa
% entita', stessa proprieta', valore diverso — e non su un valore qualunque:
% aprire una valvola non dice niente sul livello del serbatoio.
same_state_axis(st($Entity, $Property, $Old), st($Entity, $Property, $New)) :- dif($Old, $New).
action_overrides($Action, $Proposition) :- action_effect($Action, $Effect), same_state_axis($Proposition, $Effect).
holds_after($Situation, $Action, $Proposition) :- action_effect($Action, $Proposition).
holds_after($Situation, $Action, $Proposition) :- context_visible_belief($Situation, $Proposition), naf(action_overrides($Action, $Proposition)).

% Lo stato dopo una SEQUENZA, non piu' dopo una sola azione. La lista e' in
% ordine inverso — l'ultima azione in testa — perche' cosi' la ricorsione dice
% esattamente cio' che si vuole dire: vale cio' che l'ultima azione produce, e
% vale cio' che sopravviveva prima e l'ultima non contraddice. Nessun contatore,
% nessuna profondita' cablata: la vista regge una lista di qualunque lunghezza.
plan_state($Situation, nil, $Proposition) :- context_visible_belief($Situation, $Proposition).
plan_state($Situation, cons($Last, $Earlier), $Proposition) :- action_effect($Last, $Proposition).
plan_state($Situation, cons($Last, $Earlier), $Proposition) :- plan_state($Situation, $Earlier, $Proposition), naf(action_overrides($Last, $Proposition)).

% Una sequenza e' applicabile quando ogni passo lo e' NELLO STATO IN CUI VIENE
% ESEGUITO, non nello stato iniziale. E' la differenza fra un elenco di azioni
% possibili e un piano.
plan_missing($Situation, $Earlier, $Last, missing($Proposition)) :- action_precondition($Last, $Proposition), naf(plan_state($Situation, $Earlier, $Proposition)).
plan_missing_set($Situation, $Earlier, $Last, $Missing) :- findall($M, plan_missing($Situation, $Earlier, $Last, $M), $Missing).
plan_ok($Situation, nil).
plan_ok($Situation, cons($Last, $Earlier)) :- plan_ok($Situation, $Earlier), plan_missing_set($Situation, $Earlier, $Last, nil).

missing_after($Situation, $First, $Second, missing($Proposition)) :- action_precondition($Second, $Proposition), naf(holds_after($Situation, $First, $Proposition)).
missing_after_set($Situation, $First, $Second, $Missing) :- findall($M, missing_after($Situation, $First, $Second, $M), $Missing).
applicable_after($Situation, $First, $Second) :- action_schema($Domain, $Second), missing_after_set($Situation, $First, $Second, nil).

% ── 4. IL PIANO: un passo provato, o un residuo tipizzato ───────────────────
%
% La ricerca e' goal-diretta: si guardano le azioni il cui cambiamento tocca la
% proprieta' del goal NEL VERSO chiesto, non il catalogo intero. Un'azione che
% alza il livello non e' una risposta peggiore alla domanda «come lo abbasso»:
% e' una risposta a un'altra domanda.
turn_action_candidate($Turn, $Situation, $Action) :- turn_task($Turn, $Situation, $Property, $Direction), action_change($Action, $Property, $Direction).
% L'ammissibilita' filtra il PIANO, non l'applicabilita': un'azione vietata resta
% perfettamente applicabile — le sue precondizioni valgono, i suoi effetti sono
% quelli — e semplicemente non viene scelta. Tenere separati il piano fisico e
% quello normativo e' cio' che permette di dire «non lo faccio» invece di «non
% posso», che sono due affermazioni diverse su di se'.
turn_plan_step($Turn, $Action) :- turn_action_candidate($Turn, $Situation, $Action), applicable($Situation, $Action), action_admissible($Action).

% Il PASSO ABILITANTE: l'azione che raggiunge il goal non e' applicabile adesso,
% ma lo diventa dopo un'altra che invece lo e'. E' la differenza fra cercare una
% risposta e fare un piano — e nasce dalla stessa applicabilita' di prima, letta
% nello stato che la prima azione produrrebbe.
turn_enabled_step($Turn, $First, $Second) :- turn_action_candidate($Turn, $Situation, $Second), naf(applicable($Situation, $Second)), applicable($Situation, $First), applicable_after($Situation, $First, $Second), dif($First, $Second), action_admissible($First), action_admissible($Second).
% Tre passi. La macchina dello STATO non ha profondita': quella e' la GENERAZIONE
% delle catene, ed e' bounded per scelta dichiarata — cercare senza limite in uno
% spazio combinatorio non e' piu' ragionare, e il §17.5 autorizza una ricerca
% limitata proprio per questo. Allungare il limite e' una riga; toglierlo no.
turn_enabled_three($Turn, $First, $Second, $Third) :- turn_action_candidate($Turn, $Situation, $Third), action_schema($D1, $First), action_schema($D2, $Second), dif($First, $Second), dif($Second, $Third), plan_ok($Situation, cons($Third, cons($Second, cons($First, nil)))), admissible_chain($First, $Second, $Third).
admissible_chain($First, $Second, $Third) :- action_admissible($First), action_admissible($Second), action_admissible($Third).
turn_triple_key($Turn, triple($First, $Second, $Third)) :- turn_enabled_three($Turn, $First, $Second, $Third).
turn_triple_set($Turn, $Triples) :- turn_has_candidate($Turn), findall($T, turn_triple_key($Turn, $T), $Triples).
turn_three_step($Turn, $First, $Second, $Third) :- turn_triple_set($Turn, cons(triple($First, $Second, $Third), nil)).

turn_enabled_key($Turn, pair($First, $Second)) :- turn_enabled_step($Turn, $First, $Second).
turn_enabled_set($Turn, $Pairs) :- turn_has_candidate($Turn), findall($P, turn_enabled_key($Turn, $P), $Pairs).
turn_two_step($Turn, $First, $Second) :- turn_enabled_set($Turn, cons(pair($First, $Second), nil)).
turn_has_two_step($Turn) :- turn_enabled_set($Turn, cons($Pair, $Tail)).

turn_plan_key($Turn, step($Action)) :- turn_plan_step($Turn, $Action).
turn_plan_set($Turn, $Steps) :- findall($Step, turn_plan_key($Turn, $Step), $Steps).
turn_has_plan($Turn) :- turn_plan_set($Turn, cons($Step, $Tail)).
turn_single_plan($Turn, $Action) :- turn_plan_set($Turn, cons(step($Action), nil)).
turn_plan_ambiguous($Turn) :- turn_plan_set($Turn, cons($First, cons($Second, $Tail))).

turn_has_candidate($Turn) :- turn_action_candidate($Turn, $Situation, $Action).
turn_blocked_action($Turn, $Action) :- turn_action_candidate($Turn, $Situation, $Action), blocked_action($Situation, $Action).

% Il residuo dice DOVE nel grafo il turno si e' fermato, che e' l'unica cosa che
% distingue «non conosco un'azione» da «l'azione che conosco non e' applicabile
% qui». Le due meritano mosse diverse, e nessuna delle due autorizza un piano.
% La condizione e' `turn_task/4`, NON `turn_plan_candidate/1`. Il secondo e' il
% contratto CONDIVISO dai produttori di piano: usarlo qui significava «un piano
% qualunque ha riconosciuto il turno», quindi il residuo situazionale
% rivendicava anche i turni degli altri. Il difetto e' rimasto invisibile finche'
% questo era l'unico produttore recente; l'ha scoperto il primo turno ordinario
% del produttore NL. Una condizione va scritta con il predicato che nomina la
% PROPRIA specie, mai col contratto che tutti condividono.
situation_residue($Turn, situation_no_action) :- turn_task($Turn, $Situation, $Property, $Direction), naf(turn_has_candidate($Turn)).
situation_residue($Turn, situation_blocked) :- turn_blocked_action($Turn, $Action), naf(turn_has_plan($Turn)), naf(turn_has_two_step($Turn)), naf(turn_has_three_step($Turn)).
turn_has_three_step($Turn) :- turn_triple_set($Turn, cons($T, $Tail)).

% Il turno e' candidato solo quando la KB possiede davvero la situazione di cui
% parla. Una domanda «come faccio a ...» su una proprieta' che nessun mondo noto
% possiede non appartiene a questo piano e deve proseguire verso gli altri
% consumer: rubarle il turno per dichiarare un gap sarebbe un muro piu' loquace.
turn_plan_candidate($Turn) :- turn_task($Turn, $Situation, $Property, $Direction).

% ── 4b. RICORDARE IL PIANO, E ACCORGERSI CHE SI E' ROTTO (gen398e) ─────────
%
% Un piano dato e' un impegno preso: chi lo ha ricevuto ci conta. Quando il
% mondo cambia, ricalcolarlo in silenzio non e' onesto — la differenza fra un
% pianificatore e un interlocutore e' che il secondo dice CHE COSA e' cambiato.
%
% Si ricorda l'azione che raggiunge il goal, non la catena intera: la catena e'
% derivata e si riderivera' da sola, mentre cio' che vale la pena confrontare e'
% se il traguardo sia ancora raggiungibile. Una preferenza nuova sulla stessa
% proprieta' SOSTITUISCE la vecchia, con lo stesso pattern a due clausole che il
% registro usa gia': `retract/1` fallisce se il fatto non c'e', e un effetto che
% fallisce si porta dietro tutta la congiunzione.
turn_goal_action($Turn, $Action) :- turn_single_plan($Turn, $Action).
turn_goal_action($Turn, $Action) :- turn_two_step($Turn, $First, $Action).
turn_goal_action($Turn, $Action) :- turn_three_step($Turn, $A, $B, $Action).

% La NAF vuole un goal GROUND: `naf(planned_for($P, $Old))` con $Old libero
% flounders e la clausola non scatta mai — il piano non veniva ricordato e
% nessuno lo diceva. La vista positiva `has_plan_for/1` chiude il buco, ed e' la
% stessa disciplina che il gen393 aveva gia' fissato per il residuo del frame.
has_plan_for($Property) :- planned_for($Property, $Action).
plan_remember($Property, $Action) :- planned_for($Property, $Old), retract(planned_for, $Property, $Old), assert(planned_for, $Property, $Action).
plan_remember($Property, $Action) :- naf(has_plan_for($Property)), assert(planned_for, $Property, $Action).
bookkeeper(plan).
turn_bookkeeping($Turn, plan) :- turn_task($Turn, $Situation, $Property, $Direction), turn_goal_action($Turn, $Action), plan_remember($Property, $Action).

% Raggiungibile: applicabile adesso, oppure abilitata da un passo che lo e'. Il
% piano e' ROTTO quando il traguardo non e' piu' raggiungibile in nessuno dei
% due modi — non quando smette semplicemente di essere applicabile, che e' la
% condizione ordinaria di ogni piano a piu' passi e non merita un allarme.
action_reachable($Situation, $Action) :- applicable($Situation, $Action).
action_reachable($Situation, $Action) :- applicable($Situation, $First), dif($First, $Action), applicable_after($Situation, $First, $Action).
% Un piano COMPIUTO non e' un piano rotto, ed e' la distinzione che salva il
% livello dal diventare un allarme continuo: aprire la valvola rende
% `apri_valvola` non piu' applicabile — la sua precondizione era che fosse
% chiusa — ma non ha spezzato niente. Ha fatto esattamente cio' che il piano
% diceva di fare. Si guarda percio' l'EFFETTO: se vale gia', il piano e' andato
% a buon fine e non c'e' nulla da annunciare.
plan_achieved($Situation, $Action) :- action_effect($Action, $Effect), context_visible_belief($Situation, $Effect).
plan_broken($Property, $Action) :- planned_for($Property, $Action), described_situation($Situation), naf(action_reachable($Situation, $Action)), naf(plan_achieved($Situation, $Action)).

% ── 5. REALIZZAZIONE: il piano proposizionale, non una frase memorizzata ────
%
% Il renderer riceve un'azione gia' provata applicabile e i connettivi della
% lingua. Non ha accesso a nulla con cui fabbricare una proposizione nuova: il
% fold di `answer_text/2` puo' soltanto mettere in fila pezzi che qualcun altro
% ha dimostrato. La forma dell'azione e' la sua `concept_label/4`, quindi la
% stessa proof si realizza in italiano e in inglese senza cambiare cio' che
% afferma — e senza che questo file contenga una frase di dominio.
answer_content(situation_step($Action, $Language), 0, opener, $Piece) :- ability_opener($Language, $Piece).
answer_content(situation_step($Action, $Language), 1, action, $Piece) :- linguistic_form($Piece, $Action, $Language, common).
answer_content(situation_step($Action, $Language), 2, terminator, $Piece) :- sentence_terminator($Language, $Piece).

answer_content(situation_pair($First, $Second, $Language), 0, opener, $Piece) :- first_step_opener($Language, $Piece).
answer_content(situation_pair($First, $Second, $Language), 1, first, $Piece) :- linguistic_form($Piece, $First, $Language, common).
answer_content(situation_pair($First, $Second, $Language), 2, connective, $Piece) :- next_step_connective($Language, $Piece).
answer_content(situation_pair($First, $Second, $Language), 3, second, $Piece) :- linguistic_form($Piece, $Second, $Language, common).
answer_content(situation_pair($First, $Second, $Language), 4, terminator, $Piece) :- sentence_terminator($Language, $Piece).

turn_plan_candidate($Turn) :- turn_two_step($Turn, $First, $Second).
turn_plan_candidate($Turn) :- turn_three_step($Turn, $First, $Second, $Third).

answer_content(situation_triple($A, $B, $C, $Language), 0, opener, $Piece) :- first_step_opener($Language, $Piece).
answer_content(situation_triple($A, $B, $C, $Language), 1, first, $Piece) :- linguistic_form($Piece, $A, $Language, common).
answer_content(situation_triple($A, $B, $C, $Language), 2, connective, $Piece) :- next_step_connective($Language, $Piece).
answer_content(situation_triple($A, $B, $C, $Language), 3, second, $Piece) :- linguistic_form($Piece, $B, $Language, common).
answer_content(situation_triple($A, $B, $C, $Language), 4, connective, $Piece) :- next_step_connective($Language, $Piece).
answer_content(situation_triple($A, $B, $C, $Language), 5, third, $Piece) :- linguistic_form($Piece, $C, $Language, common).
answer_content(situation_triple($A, $B, $C, $Language), 6, terminator, $Piece) :- sentence_terminator($Language, $Piece).
turn_response($Turn, $Text) :- turn_single_plan($Turn, $Action), current_language($Language), answer_text(situation_step($Action, $Language), $Text).
turn_response($Turn, $Text) :- turn_two_step($Turn, $First, $Second), naf(turn_has_plan($Turn)), current_language($Language), answer_text(situation_pair($First, $Second, $Language), $Text).
turn_response($Turn, $Text) :- turn_three_step($Turn, $A, $B, $C), naf(turn_has_plan($Turn)), naf(turn_has_two_step($Turn)), current_language($Language), answer_text(situation_triple($A, $B, $C, $Language), $Text).
turn_response($Turn, $Text) :- turn_plan_ambiguous($Turn), current_language($Language), response_template(situation_plan_ambiguous, $Language, $Text).
turn_response($Turn, $Text) :- situation_residue($Turn, $Kind), current_language($Language), response_template($Kind, $Language, $Text).

% ── 6. PORTE: la situazione e' interrogabile come qualunque altra relazione ─
%
% Il consumer e' il proiettore binario universale gia' esistente. Il verso e'
% dichiarato: senza `answer_frame_input_arg/3` la stessa superficie potrebbe
% legare l'argomento sbagliato e rispondere con una situazione al posto di
% un'azione — il difetto che gen395 ha isolato su Napoli/Campania.
answer_frame("applicable action", applicable).
answer_frame_input_arg("applicable action", applicable, 1).
answer_frame("blocked action", blocked_action).
answer_frame_input_arg("blocked action", blocked_action, 1).
