% user-situations.p0 — LA SITUAZIONE DI CHI PARLA ESEGUE IL PIANO INSEGNATO (assistente utile U1+U2).
%
% docs/plans/assistente-utile.md, il caso di F.:
%
%     >>> ho un problema meccanico
%     Non capisco ancora.
%
% e, dal banco dell'utilita', «I'm really stressed about my exam tomorrow» →
% «That sounds nice -- tell me more about it.»: un misclaim, perche' la coda
% sociale non distingue chi si rallegra da chi e' in ansia.
%
% Un piano di condotta si insegnava gia' parlando («when you don't have the
% steps then say the purpose», gen507/36) e si raccontava («your plan when …?»),
% ma nessun piano scattava davanti alla situazione di CHI PARLA: il solo piano
% eseguito era `steps_missing`, riconosciuto dal motore. Qui manca soltanto il
% riconoscimento. La porta e' quella che serve gia' il meteo (`honest-limits.p0`):
% `turn_plan_candidate/1` + `turn_response/2`. Zero righe di C.
%
% Che cosa sta qui e che cosa no:
% - QUI: le situazioni (come si riconoscono in un turno, come si nominano per
%   insegnarle), le mosse possibili (come si nominano e come si dicono).
%   E' vocabolario del meccanismo, come `situation_cue`/`move_cue` in messages.p0.
% - NON QUI: il piano. Quali mosse, in che ordine, per quale situazione si
%   insegna a voce con «when someone has a problem then …» e si salva con /save
%   (LEARN_PROTOCOL.md). Senza piano insegnato questa porta non si apre: la
%   situazione riconosciuta da sola non produce nessuna frase.

:- file_attribute(machinery).

% ── 1. RICONOSCERE LA SITUAZIONE ─────────────────────────────────────────────
%
% Due indizi DISTINTI, come `register_hint_min`: la situazione (un guasto, un
% sentimento) E che sia di chi parla. «the problem with this theory» nomina un
% problema e non e' di nessuno; «I'm really happy» e' di chi parla e non e' un
% guaio. Un indizio nuovo e' una riga.
machinery(trouble_cue).
machinery(speaker_cue).
machinery(situation_settled_cue).
machinery(user_situation).

trouble_cue("problem", user_problem).
trouble_cue("problems", user_problem).
trouble_cue("problema", user_problem).
trouble_cue("problemi", user_problem).
trouble_cue("broken", user_problem).
trouble_cue("rotto", user_problem).
trouble_cue("rotta", user_problem).
trouble_cue("not working", user_problem).
trouble_cue("doesn't work", user_problem).
trouble_cue("does not work", user_problem).
trouble_cue("stopped working", user_problem).
trouble_cue("won't start", user_problem).
trouble_cue("non funziona", user_problem).
trouble_cue("non parte", user_problem).
trouble_cue("guasto", user_problem).
trouble_cue("keeps disconnecting", user_problem).
trouble_cue("strange noise", user_problem).
trouble_cue("rumore strano", user_problem).

trouble_cue("stressed", user_worry).
trouble_cue("worried", user_worry).
trouble_cue("anxious", user_worry).
trouble_cue("nervous", user_worry).
trouble_cue("scared", user_worry).
trouble_cue("stressato", user_worry).
trouble_cue("stressata", user_worry).
trouble_cue("preoccupato", user_worry).
trouble_cue("preoccupata", user_worry).
trouble_cue("in ansia", user_worry).
trouble_cue("agitato", user_worry).
trouble_cue("agitata", user_worry).
% assistente utile U5 — la tristezza non e' la preoccupazione: «I feel sad today»
% riceveva «That sounds nice -- tell me more about it.», e le mosse della
% preoccupazione («What worries you most?») non le si addicono.
trouble_cue("sad", user_low_mood).
trouble_cue("down today", user_low_mood).
trouble_cue("feeling down", user_low_mood).
trouble_cue("feel down", user_low_mood).
trouble_cue("unhappy", user_low_mood).
trouble_cue("lonely", user_low_mood).
trouble_cue("triste", user_low_mood).
trouble_cue("giu' di morale", user_low_mood).
trouble_cue("giù di morale", user_low_mood).
trouble_cue("mi sento giu", user_low_mood).
trouble_cue("mi sento giù", user_low_mood).
trouble_cue("solo e triste", user_low_mood).
turn_cue_registry(trouble_cue, 1).

speaker_cue("i").
speaker_cue("i'm").
speaker_cue("my").
speaker_cue("me").
speaker_cue("ho").
speaker_cue("mi").
speaker_cue("mio").
speaker_cue("mia").
speaker_cue("sono").
turn_cue_registry(speaker_cue, 1).

% Un guaio gia' risolto non chiede aiuto: «ho risolto il problema meccanico».
situation_settled_cue("solved").
situation_settled_cue("fixed").
situation_settled_cue("risolto").
situation_settled_cue("sistemato").
situation_settled_cue("riparato").
turn_cue_registry(situation_settled_cue, 1).

turn_speaker_involved($Turn) :- turn_cue_form($Turn, speaker_cue, $Cue).
turn_situation_settled($Turn) :- turn_cue_form($Turn, situation_settled_cue, $Cue).

direct_situation($Turn, $Situation) :-
    turn_cue_form($Turn, trouble_cue, $Cue),
    trouble_cue($Cue, $Situation),
    turn_speaker_involved($Turn),
    naf(turn_situation_settled($Turn)),
    naf(turn_has_range_reading($Turn)).
% «the humidity in my bedroom is 70 percent, is that a problem?» chiede di una misura
% contro un intervallo noto (numeric-questions.p0 §9), non riferisce un guasto.
machinery(turn_has_range_reading).
turn_has_range_reading($Turn) :- range_verdict($Turn, $V).
% Un guasto detto con il suo verbo («la lavatrice non funziona più», «the
% heating is broken») non ha bisogno del possessivo: chi riferisce che una cosa
% non funziona sta chiedendo aiuto per quella cosa, anche in italiano, dove il
% possessivo si omette. «problem» invece da solo nomina un argomento («the
% problem with this theory») e resta con i due indizi.
machinery(malfunction_cue).
malfunction_cue("broken").
malfunction_cue("rotto").
malfunction_cue("rotta").
malfunction_cue("not working").
malfunction_cue("doesn't work").
malfunction_cue("does not work").
malfunction_cue("stopped working").
malfunction_cue("won't start").
malfunction_cue("non funziona").
malfunction_cue("non parte").
malfunction_cue("keeps disconnecting").
direct_situation($Turn, user_problem) :-
    turn_cue_form($Turn, trouble_cue, $Cue),
    malfunction_cue($Cue),
    naf(turn_speaker_involved($Turn)),
    naf(turn_situation_settled($Turn)).

% assistente utile U7 — LA SCELTA FRA DUE COSE. «Should I learn Python or
% JavaScript first?» riceveva «I am not sure what you mean by «first»», «Should I
% buy a laptop or a tablet for university?» un muro. Chi chiede di scegliere
% chiede i criteri e la domanda che decide, non un verdetto (T17 della scheda).
% Due indizi: la forma della richiesta di consiglio E l'alternativa.
machinery(choice_cue).
machinery(alternative_cue).
choice_cue("should i").
choice_cue("which should i").
choice_cue("is it better to").
choice_cue("dovrei").
choice_cue("mi conviene").
choice_cue("e' meglio").
choice_cue("è meglio").
turn_cue_registry(choice_cue, 1).
alternative_cue(" or ").
alternative_cue(" o ").
turn_cue_registry(alternative_cue, 1).
direct_situation($Turn, user_choice) :-
    turn_cue_form($Turn, choice_cue, $Cue),
    turn_cue_form($Turn, alternative_cue, $Or).

% assistente utile U11 — «WHAT CAN YOU HELP ME WITH?» CHIEDE DI CHI ASCOLTA.
% Riceveva il registro delle capacita' («From my capability ledger, I can
% currently: answer from KB facts and rules, with limited inference; …»): vero,
% ma detto dal punto di vista del motore. Chi chiede in che cosa puo' essere
% aiutato vuole sapere che cosa portare. Le cose elencate nella mossa sono
% verificate il 2026-09-13 sul banco dell'utilita' e nei cricchetti
% (user_situations, own_procedure, arith): nessuna promessa oltre.
machinery(help_scope_cue).
help_scope_cue("what can you help me with").
help_scope_cue("what can you help with").
help_scope_cue("how can you help me").
help_scope_cue("what can you do for me").
help_scope_cue("in cosa puoi aiutarmi").
help_scope_cue("come puoi aiutarmi").
help_scope_cue("cosa puoi fare per me").
turn_cue_registry(help_scope_cue, 1).
direct_situation($Turn, user_help_scope) :- turn_cue_form($Turn, help_scope_cue, $Cue).

% assistente utile U12b — SCRIVERE UN MESSAGGIO. «Help me write an email.»
% riceveva «I understood the request — produce «email» — … no code to show for
% it», «Can you help me with a letter?» una domanda sulla capacita' dell'utente.
% Chi chiede aiuto per scrivere a qualcuno ha bisogno della forma e di dire a chi
% e perche'.
machinery(writing_help_cue).
writing_help_cue("help me write").
writing_help_cue("help me with an email").
writing_help_cue("help me with a letter").
writing_help_cue("help me with a message").
writing_help_cue("aiutami a scrivere").
writing_help_cue("mi aiuti a scrivere").
turn_cue_registry(writing_help_cue, 1).
direct_situation($Turn, user_writing) :- turn_cue_form($Turn, writing_help_cue, $Cue).

% assistente utile U13 — COMINCIARE QUALCOSA DI NUOVO. «I want to start running.
% Where do I begin?» riceveva un muro su «running», «I want to learn to cook.
% Where should I start?» «I don't understand that yet.». Chi chiede da dove
% cominciare non chiede un'enciclopedia della cosa: chiede il primo passo e di
% misurarlo sul proprio tempo.
machinery(getting_started_cue).
getting_started_cue("where do i begin").
getting_started_cue("where do i start").
getting_started_cue("where should i start").
getting_started_cue("where should i begin").
getting_started_cue("how do i get started").
getting_started_cue("da dove comincio").
getting_started_cue("da dove inizio").
getting_started_cue("da dove parto").
turn_cue_registry(getting_started_cue, 1).
direct_situation($Turn, user_getting_started) :- turn_cue_form($Turn, getting_started_cue, $Cue).

% assistente utile U14 — ORGANIZZARE IL PROPRIO TEMPO. «Come posso organizzare
% meglio la mia giornata?» (il prompt `italian` del banco) riceveva «Non capisco
% ancora.». Chi lo chiede vuole un metodo che stia in una frase e la domanda su
% dove la giornata gli sfugge.
machinery(time_organizing_cue).
time_organizing_cue("organizzare meglio la mia giornata").
time_organizing_cue("organizzare la mia giornata").
time_organizing_cue("gestire meglio il mio tempo").
time_organizing_cue("organize my day").
time_organizing_cue("organise my day").
time_organizing_cue("manage my time").
time_organizing_cue("plan my day").
turn_cue_registry(time_organizing_cue, 1).
direct_situation($Turn, user_organizing_time) :- turn_cue_form($Turn, time_organizing_cue, $Cue).

% assistente utile U15 — IDEE PER UN REGALO. «Give me some ideas for a birthday
% present for my dad» riceveva prima «Thanks for telling me about your family»
% (U1b), poi un muro. Chi chiede idee per un regalo ha bisogno di qualche strada
% concreta e della domanda che le restringe; senza sapere niente della persona,
% le strade sono generi di regalo, non un oggetto inventato.
machinery(gift_idea_cue).
gift_idea_cue("present for").
gift_idea_cue("gift for").
gift_idea_cue("gift ideas").
gift_idea_cue("regalo per").
gift_idea_cue("idee regalo").
turn_cue_registry(gift_idea_cue, 1).
direct_situation($Turn, user_gift_ideas) :- turn_cue_form($Turn, gift_idea_cue, $Cue), turn_speaker_involved($Turn).

% assistente utile U17 — CUCINARE PER ALTRI, E IL VINCOLO CHE ARRIVA DOPO.
% «I need to cook dinner for four people tonight.» / «One of them is
% vegetarian.» murava due volte. Il primo turno chiede un piano che stia nel
% tempo; il secondo aggiunge un vincolo su uno degli ospiti, e si riconosce per
% il vincolo E per il riferimento al gruppo («one of them», «uno di loro») —
% senza il secondo indizio «vegetarians don't eat meat» diventerebbe un invito a
% cena.
machinery(hosting_meal_cue).
hosting_meal_cue("cook dinner for").
hosting_meal_cue("cook lunch for").
hosting_meal_cue("cooking for").
hosting_meal_cue("cucinare per").
hosting_meal_cue("cena per").
turn_cue_registry(hosting_meal_cue, 1).
direct_situation($Turn, user_hosting_meal) :- turn_cue_form($Turn, hosting_meal_cue, $Cue), turn_speaker_involved($Turn).
machinery(dietary_cue).
dietary_cue("vegetarian").  dietary_cue("vegan").  dietary_cue("gluten").  dietary_cue("allergic").
dietary_cue("vegetariano").  dietary_cue("vegetariana").  dietary_cue("vegano").  dietary_cue("allergico").
turn_cue_registry(dietary_cue, 1).
machinery(group_member_cue).
group_member_cue("one of them").  group_member_cue("one of the guests").  group_member_cue("a guest").
group_member_cue("uno di loro").  group_member_cue("una di loro").  group_member_cue("un ospite").
turn_cue_registry(group_member_cue, 1).
direct_situation($Turn, user_guest_diet) :- turn_cue_form($Turn, dietary_cue, $D), turn_cue_form($Turn, group_member_cue, $G).

% ── 1bis. I SEGNI DI PERICOLO (frontier-kb-natural-dialogue.md K11) ─────────
%
% F., 2026-09-13, in make chat:
%
%     >>> ho un problema elettrico
%     Vediamolo insieme. Se qualcosa fuma, … Di che cosa si tratta, e che cosa
%     succede esattamente?
%     >>> ci sono scintille
%     Non capisco ancora.
%
% Due difetti diversi, e vanno tenuti distinti. Il primo e' di CONOSCENZA della
% situazione: le scintille sono un segno di pericolo, e lo sono con o senza una
% conversazione alle spalle — «ci sono scintille» detto a freddo chiede la
% stessa prima mossa. Il secondo e' di DIALOGO: parrot0 aveva fatto una domanda,
% e la risposta non e' stata letta come risposta (sotto, §3bis, e issues.p0).
% Qui il primo: `hazard_sign/2` e' conoscenza K11 (`hazard(Situation, Hazard,
% Severity)` nel lessico di progetto), e un segno nuovo e' una riga.
machinery(hazard_sign_cue).
machinery(hazard_sign).
% (non «spark» al singolare: «a spark plug is part of an engine» non e' un pericolo)
hazard_sign_cue("sparks", sparks).  hazard_sign_cue("sparking", sparks).
hazard_sign_cue("scintille", sparks).  hazard_sign_cue("scintilla", sparks).  hazard_sign_cue("fa scintille", sparks).
hazard_sign_cue("smell gas", gas_smell).  hazard_sign_cue("smells of gas", gas_smell).  hazard_sign_cue("gas smell", gas_smell).
hazard_sign_cue("odore di gas", gas_smell).  hazard_sign_cue("puzza di gas", gas_smell).  hazard_sign_cue("sento gas", gas_smell).
turn_cue_registry(hazard_sign_cue, 1).
hazard_sign(sparks, danger).
hazard_sign(gas_smell, danger).
machinery(hazard_situation).
hazard_situation(sparks, user_sparks).
hazard_situation(gas_smell, user_gas_smell).
direct_situation($Turn, $Situation) :-
    turn_cue_form($Turn, hazard_sign_cue, $Cue), hazard_sign_cue($Cue, $Sign),
    hazard_sign($Sign, danger), hazard_situation($Sign, $Situation).

% ── 1ter. LA RISPOSTA ALLA DOMANDA APPENA FATTA (dialogica L2) ─────────────
%
% Quando un piano di situazione CHIEDE qualcosa («che cosa succede
% esattamente?»), parrot0 ha aperto una questione e l'utente deve la prossima
% mossa: e' il genere `inquiry` del tabellone (issues.p0), e lo apre la
% contabilita' del turno, non il C. Il turno dopo si legge prima come mossa su
% quella questione: un'affermazione che non apre una situazione sua e' la
% RISPOSTA, e la situazione e' la stessa di prima vista un passo avanti
% (`situation_followup/2`). Un segno di pericolo nella risposta vince comunque,
% perche' e' una situazione diretta.
machinery(move_asks).
move_asks(ask_what_happens).
move_asks(ask_main_worry).
move_asks(ask_to_talk).
move_asks(ask_use).
move_asks(ask_need).
move_asks(ask_recipient_goal).
move_asks(ask_weekly_time).
move_asks(ask_hardest_part).
move_asks(ask_person_interests).
move_asks(ask_diet_time).
machinery(situation_followup).
situation_followup(user_problem, user_problem_detail).
machinery(turn_has_direct_situation).
turn_has_direct_situation($Turn) :- direct_situation($Turn, $Situation).
machinery(turn_answers_inquiry).
machinery(turn_answers_inquiry_issue).
% Una lezione non e' la risposta alla domanda appena fatta: «indoor humidity should
% stay between 30 and 50 percent» dopo «what exactly happens?» veniva letta come
% dettaglio del guasto e la lezione non entrava (misurato). Quali aperture siano di
% una lezione e' una lista di cue: una forma di lezione nuova e' una riga.
machinery(lesson_surface_cue).
lesson_surface_cue(" causes ").
lesson_surface_cue("should stay between").
lesson_surface_cue("should not be left out").
lesson_surface_cue("the italian for").
lesson_surface_cue("a sign of").
lesson_surface_cue("never put").
lesson_surface_cue("a cup of").
lesson_surface_cue("the safe internal temperature of").
lesson_surface_cue("is defined as").
lesson_surface_cue("releases").
turn_cue_registry(lesson_surface_cue, 1).
machinery(turn_is_lesson_surface).
turn_is_lesson_surface($Turn) :- turn_cue_form($Turn, lesson_surface_cue, $C).
turn_answers_inquiry_issue($Turn, $Issue) :-
    open_issue($Issue, inquiry), naf(inquiry_closed($Issue)), max_qud($Issue),
    naf(turn_has_question_mark($Turn)), naf(turn_is_plan_lesson($Turn)), naf(turn_is_lesson_surface($Turn)),
    naf(turn_has_direct_situation($Turn)).
turn_answers_inquiry($Turn, $Situation) :-
    turn_answers_inquiry_issue($Turn, $Issue), issue_topic($Issue, $Situation).
user_situation($Turn, $Situation) :- direct_situation($Turn, $Situation).
user_situation($Turn, $Next) :-
    situation_followup($Situation, $Next), turn_answers_inquiry($Turn, $Situation),
    naf(turn_has_direct_situation($Turn)).

% mix §13 — UN'USTIONE. «I burned my hand on the stove» e' una situazione di chi
% parla con una prima mossa vera e urgente (NHS, «Burns and scalds»).
machinery(burn_cue).
burn_cue("burned my").  burn_cue("burnt my").  burn_cue("burned myself").  burn_cue("burnt myself").
burn_cue("scalded my").  burn_cue("scalded myself").  burn_cue("mi sono bruciato").  burn_cue("mi sono bruciata").
turn_cue_registry(burn_cue, 1).
direct_situation($Turn, user_burn) :- turn_cue_form($Turn, burn_cue, $Cue).

% mix §13 — IL SANGUE DAL NASO (NHS, «Nosebleed»).
machinery(nosebleed_cue).
nosebleed_cue("nosebleed").  nosebleed_cue("nose is bleeding").  nosebleed_cue("nose bleeding").
nosebleed_cue("perdo sangue dal naso").  nosebleed_cue("sangue dal naso").  nosebleed_cue("mi sanguina il naso").
turn_cue_registry(nosebleed_cue, 1).
direct_situation($Turn, user_nosebleed) :- turn_cue_form($Turn, nosebleed_cue, $Cue), naf(turn_asks_head_back($Turn)).
machinery(turn_asks_head_back).
turn_asks_head_back($Turn) :- turn_cue_form($Turn, head_back_cue, $C).
machinery(head_back_cue).
head_back_cue("head back").  head_back_cue("testa indietro").
turn_cue_registry(head_back_cue, 1).
% «should I tilt my head back for a nosebleed?» e' il rimedio sbagliato piu' comune:
% la risposta e' no, con la prima mossa dello stesso piano.
direct_situation($Turn, user_nosebleed_myth) :- turn_cue_form($Turn, nosebleed_cue, $Cue), turn_asks_head_back($Turn).

% ── 2. NOMINARE LE SITUAZIONI E LE MOSSE PER INSEGNARLE ──────────────────────
situation_cue("someone has a problem", user_problem).
situation_cue("someone tells you about a problem", user_problem).
situation_cue("something is broken", user_problem).
situation_cue("qualcuno ha un problema", user_problem).
situation_cue("someone is worried", user_worry).
situation_cue("someone is stressed", user_worry).
situation_cue("qualcuno e' preoccupato", user_worry).
situation_cue("qualcuno è preoccupato", user_worry).

situation_cue("someone is sad", user_low_mood).
situation_cue("someone feels down", user_low_mood).
situation_cue("qualcuno e' triste", user_low_mood).
situation_cue("qualcuno è triste", user_low_mood).
situation_label(user_low_mood, en, "someone is sad").
situation_label(user_low_mood, it, "qualcuno è triste").
situation_cue("someone has to choose", user_choice).
situation_cue("someone asks which to choose", user_choice).
situation_cue("qualcuno deve scegliere", user_choice).
situation_label(user_choice, en, "someone has to choose").
situation_label(user_choice, it, "qualcuno deve scegliere").
situation_cue("someone asks what you can help with", user_help_scope).
situation_cue("qualcuno chiede in cosa puoi aiutarlo", user_help_scope).
situation_label(user_help_scope, en, "someone asks what you can help with").
situation_label(user_help_scope, it, "qualcuno chiede in cosa puoi aiutarlo").
situation_cue("someone wants help writing a message", user_writing).
situation_cue("qualcuno vuole aiuto a scrivere un messaggio", user_writing).
situation_label(user_writing, en, "someone wants help writing a message").
situation_label(user_writing, it, "qualcuno vuole aiuto a scrivere un messaggio").
situation_cue("someone wants to start something new", user_getting_started).
situation_cue("qualcuno vuole cominciare qualcosa di nuovo", user_getting_started).
situation_label(user_getting_started, en, "someone wants to start something new").
situation_label(user_getting_started, it, "qualcuno vuole cominciare qualcosa di nuovo").
situation_cue("someone wants to organize their day", user_organizing_time).
situation_cue("qualcuno vuole organizzare la giornata", user_organizing_time).
situation_label(user_organizing_time, en, "someone wants to organize their day").
situation_label(user_organizing_time, it, "qualcuno vuole organizzare la giornata").
situation_cue("someone needs gift ideas", user_gift_ideas).
situation_cue("qualcuno cerca idee regalo", user_gift_ideas).
situation_label(user_gift_ideas, en, "someone needs gift ideas").
situation_label(user_gift_ideas, it, "qualcuno cerca idee regalo").
situation_cue("someone cooks for guests", user_hosting_meal).
situation_cue("qualcuno cucina per ospiti", user_hosting_meal).
situation_label(user_hosting_meal, en, "someone cooks for guests").
situation_label(user_hosting_meal, it, "qualcuno cucina per ospiti").
situation_cue("a guest has a diet", user_guest_diet).
situation_cue("un ospite ha una dieta", user_guest_diet).
situation_label(user_guest_diet, en, "a guest has a diet").
situation_label(user_guest_diet, it, "un ospite ha una dieta").
situation_cue("someone sees sparks", user_sparks).
situation_cue("there are sparks", user_sparks).
situation_cue("qualcuno vede scintille", user_sparks).
situation_label(user_sparks, en, "someone sees sparks").
situation_label(user_sparks, it, "qualcuno vede scintille").
situation_cue("someone smells gas", user_gas_smell).
situation_cue("qualcuno sente odore di gas", user_gas_smell).
situation_label(user_gas_smell, en, "someone smells gas").
situation_label(user_gas_smell, it, "qualcuno sente odore di gas").
situation_cue("someone describes the problem", user_problem_detail).
situation_cue("qualcuno descrive il problema", user_problem_detail).
situation_label(user_problem_detail, en, "someone describes the problem").
situation_label(user_problem_detail, it, "qualcuno descrive il problema").
situation_cue("someone has a burn", user_burn).
situation_cue("qualcuno si e' bruciato", user_burn).
situation_label(user_burn, en, "someone has a burn").
situation_label(user_burn, it, "qualcuno si è bruciato").
situation_cue("someone has a nosebleed", user_nosebleed).
situation_cue("qualcuno perde sangue dal naso", user_nosebleed).
situation_label(user_nosebleed, en, "someone has a nosebleed").
situation_label(user_nosebleed, it, "qualcuno perde sangue dal naso").
situation_cue("someone asks to tilt the head back", user_nosebleed_myth).
situation_label(user_nosebleed_myth, en, "someone asks to tilt the head back").
situation_label(user_nosebleed_myth, it, "qualcuno chiede se piegare la testa indietro").
situation_label(user_problem, en, "someone has a problem").
situation_label(user_problem, it, "qualcuno ha un problema").
situation_label(user_worry, en, "someone is worried").
situation_label(user_worry, it, "qualcuno è preoccupato").

% Le mosse. Il testo e' generale: non nomina nessun dominio, perche' la mossa
% deve valere per la bici, la lavatrice e il telefono (i prompt `held` del banco).
% I due consigli hanno una fonte, registrata nel lab del giro:
% - safety_first: Shropshire Fire and Rescue Service, «electric fire safety
%   tips» (spegnere e staccare cio' che fuma o sa di bruciato); Highway Code
%   UK, regola 274 (un veicolo in panne si ferma fuori dalla carreggiata).
% - one_small_step: NHS, «10 stress busters» — «take control», «work smarter:
%   prioritising … the tasks that'll make a real difference».
move_cue("say we will look at it together", look_together).
move_cue("offer to look at it together", look_together).
move_cue("di' che lo guardiamo insieme", look_together).
move_cue("ask what it is and what happens", ask_what_happens).
move_cue("ask what happens", ask_what_happens).
move_cue("chiedi che cosa succede", ask_what_happens).
% ⚠ Non «put safety first»: «first» lo prende il chiarimento dell'ordinale
% («I am not sure what you mean by «first»») prima che la lezione arrivi.
move_cue("remind them about safety", safety_first).
move_cue("give the safety advice", safety_first).
move_cue("ricorda la sicurezza", safety_first).
move_cue("acknowledge the feeling", acknowledge_feeling).
move_cue("riconosci come si sente", acknowledge_feeling).
move_cue("ask what worries them most", ask_main_worry).
move_cue("chiedi che cosa lo preoccupa di piu'", ask_main_worry).
% ⚠ Non «suggest one small step»: «suggest» apre il registro delle
% raccomandazioni e «step» quello dei procedimenti, e la lezione non arriva.
move_cue("propose one small thing to do today", one_small_step).
move_cue("offer one small thing to do", one_small_step).
move_cue("proponi una piccola cosa da fare oggi", one_small_step).

% - suggest_talking, see_a_doctor_if_lasting: NHS, «Low mood, sadness and
%   depression» — «try talking about your feelings to a friend, family member,
%   healthcare professional or counsellor»; vedere un medico «if you've had a
%   low mood for more than 2 weeks».
move_cue("say you are sorry to hear it", sorry_to_hear).
move_cue("di' che ti dispiace", sorry_to_hear).
move_cue("ask if they want to talk about it", ask_to_talk).
move_cue("chiedi se vuole parlarne", ask_to_talk).
% ⚠ Non «suggest talking…»: «suggest» apre il registro delle raccomandazioni
% (misurato nella sessione U5: la lezione riceveva il saggio «a defensible
% recommendation turns on…»).
move_cue("say that talking to someone they trust helps", suggest_talking).
move_cue("suggerisci di parlarne con qualcuno di fiducia", suggest_talking).
move_cue("mention a doctor if it lasts", see_a_doctor_if_lasting).
move_cue("nomina il medico se dura", see_a_doctor_if_lasting).
plan_step_text_lang(sorry_to_hear, en, "I'm sorry you're feeling this way.").
plan_step_text_lang(sorry_to_hear, it, "Mi dispiace che ti senta così.").
plan_step_text_lang(ask_to_talk, en, "Do you want to tell me what happened?").
plan_step_text_lang(ask_to_talk, it, "Vuoi raccontarmi che cosa è successo?").
plan_step_text_lang(suggest_talking, en, "Talking about it with a friend or someone you trust often helps.").
plan_step_text_lang(suggest_talking, it, "Parlarne con un amico o con qualcuno di cui ti fidi spesso aiuta.").
plan_step_text_lang(see_a_doctor_if_lasting, en, "If the low mood lasts more than two weeks, it is worth talking to a doctor.").
plan_step_text_lang(see_a_doctor_if_lasting, it, "Se l'umore basso dura più di due settimane, vale la pena parlarne con un medico.").
% - choice: la scelta resta di chi chiede (costituzione di Claude, «autonomy»;
%   system prompt, «the factual information the person needs to make their own
%   informed decision»).
move_cue("say it depends on what they need", depends_on_need).
move_cue("di' che dipende da che cosa gli serve", depends_on_need).
move_cue("ask what they will use it for", ask_use).
move_cue("chiedi a che cosa gli serve", ask_use).
plan_step_text_lang(depends_on_need, en, "Both can be the right choice: it depends on what you need it for, how much time or money you want to put in, and what you already know.").
plan_step_text_lang(depends_on_need, it, "Possono essere entrambe la scelta giusta: dipende da che cosa ti serve, da quanto tempo o denaro vuoi metterci e da che cosa sai già.").
plan_step_text_lang(ask_use, en, "What do you want to do with it first?").
plan_step_text_lang(ask_use, it, "Che cosa vuoi farci per prima cosa?").
move_cue("list what you can help with", list_help).
move_cue("elenca in cosa puoi aiutare", list_help).
move_cue("ask what they need", ask_need).
move_cue("chiedi di che cosa ha bisogno", ask_need).
plan_step_text_lang(list_help, en, "I can help you think through a problem with something that isn't working, weigh a choice between two options, talk through a worry, give you the steps for procedures I know (like changing a flat tire or making tea), work out sums and small word problems, and read a short text you give me and answer questions about it.").
plan_step_text_lang(list_help, it, "Posso aiutarti a ragionare su qualcosa che non funziona, a pesare una scelta fra due opzioni, a parlare di una preoccupazione, darti i passi dei procedimenti che conosco (come cambiare una gomma o fare il tè), fare conti e piccoli problemi, e leggere un breve testo che mi dai e rispondere a domande su quello.").
plan_step_text_lang(ask_need, en, "What do you need right now?").
plan_step_text_lang(ask_need, it, "Di che cosa hai bisogno adesso?").
% - message_shape: National Archives, «Top 10 Principles for Plain Language»
%   (state the major point first); Australian Government Style Manual, «Emails
%   and letters» (the subject line as a heading with the main idea first).
move_cue("give the shape of a clear message", message_shape).
move_cue("dai la forma di un messaggio chiaro", message_shape).
move_cue("ask who it is for and what it should achieve", ask_recipient_goal).
move_cue("chiedi a chi e' e che cosa deve ottenere", ask_recipient_goal).
plan_step_text_lang(message_shape, en, "A clear message puts the main point in the subject and in the first sentence, then gives only the details needed, and ends by saying exactly what you need from the reader and by when.").
plan_step_text_lang(message_shape, it, "Un messaggio chiaro mette il punto principale nell'oggetto e nella prima frase, poi dà solo i dettagli che servono, e chiude dicendo esattamente che cosa ti serve dal destinatario e per quando.").
plan_step_text_lang(ask_recipient_goal, en, "Who is it for, and what do you want it to get done?").
plan_step_text_lang(ask_recipient_goal, it, "A chi è rivolto, e che cosa vuoi ottenere?").
% - start_small: NHS, «Couch to 5K» — «It's all about starting small and building
%   up gradually», tre volte a settimana con giorni di riposo in mezzo.
move_cue("say to start small and regular", start_small).
move_cue("di' di cominciare in piccolo e con regolarita'", start_small).
move_cue("ask how much time they have each week", ask_weekly_time).
move_cue("chiedi quanto tempo ha a settimana", ask_weekly_time).
plan_step_text_lang(start_small, en, "Start small and regular: a short session three times a week, building up a little each week, is easier to keep than a big plan.").
plan_step_text_lang(start_small, it, "Comincia in piccolo e con regolarità: una sessione breve tre volte a settimana, aumentando un poco ogni settimana, si mantiene meglio di un grande piano.").
plan_step_text_lang(ask_weekly_time, en, "How much time can you give it each week?").
plan_step_text_lang(ask_weekly_time, it, "Quanto tempo puoi dedicarci ogni settimana?").
% - prioritise_first: NHS, «10 stress busters» — «work smarter, not harder…
%   prioritising your work, concentrating on the tasks that'll make a real
%   difference».
% ⚠ Non «… do the important ones first»: «first» lo prende il chiarimento
% dell'ordinale (misurato nella sessione U14).
% ⚠ e non oltre otto parole: il pezzo `named` non accumula oltre, e la lezione
% con una mossa lunga non combacia.
% ⚠ e non «what matters most»: e' la cue di `own_method(salience)`.
move_cue("say to begin with the important tasks", prioritise_first).
move_cue("di' di cominciare da cio' che conta", prioritise_first).
move_cue("ask which part of the day is hardest", ask_hardest_part).
move_cue("chiedi quale parte della giornata e' piu' difficile", ask_hardest_part).
plan_step_text_lang(prioritise_first, en, "Write down what you have to do, pick the two or three things that make a real difference, and do those first.").
plan_step_text_lang(prioritise_first, it, "Scrivi che cosa devi fare, scegli le due o tre cose che fanno davvero la differenza, e falle per prime.").
plan_step_text_lang(ask_hardest_part, en, "Which part of your day is hardest to manage right now?").
plan_step_text_lang(ask_hardest_part, it, "Quale parte della giornata ti è più difficile da gestire adesso?").
move_cue("give kinds of gifts", gift_kinds).
move_cue("dai dei generi di regalo", gift_kinds).
move_cue("ask what the person enjoys", ask_person_interests).
move_cue("chiedi che cosa piace alla persona", ask_person_interests).
plan_step_text_lang(gift_kinds, en, "A few directions that often work: something for a hobby they already have, an experience you can share (a meal out, a match, a concert), or something personal like a photo book or a handwritten letter.").
plan_step_text_lang(gift_kinds, it, "Qualche strada che spesso funziona: qualcosa per un hobby che ha già, un'esperienza da fare insieme (una cena fuori, una partita, un concerto), o qualcosa di personale come un album di foto o una lettera scritta a mano.").
plan_step_text_lang(ask_person_interests, en, "What does the person enjoy doing in their free time?").
plan_step_text_lang(ask_person_interests, it, "Che cosa ama fare questa persona nel tempo libero?").
move_cue("suggest a simple menu plan", simple_menu).
move_cue("proponi un menu semplice", simple_menu).
move_cue("ask about diets and time", ask_diet_time).
move_cue("chiedi di diete e tempo", ask_diet_time).
move_cue("say to pick a dish everyone can eat", shared_dish).
move_cue("di' di scegliere un piatto per tutti", shared_dish).
plan_step_text_lang(simple_menu, en, "Keep it simple: one main dish you already know well, one side you can prepare ahead, and a dessert you can buy ready.").
plan_step_text_lang(simple_menu, it, "Tienilo semplice: un piatto principale che sai già fare bene, un contorno da preparare prima e un dolce che puoi comprare pronto.").
plan_step_text_lang(ask_diet_time, en, "Does anyone have dietary needs, and how much time do you have?").
plan_step_text_lang(ask_diet_time, it, "Qualcuno ha esigenze alimentari, e quanto tempo hai?").
plan_step_text_lang(shared_dish, en, "Then choose a main dish everyone can eat, so nobody gets a separate plate: a vegetable lasagne, a mushroom risotto or a chickpea curry works for everyone.").
plan_step_text_lang(shared_dish, it, "Allora scegli un piatto principale che possano mangiare tutti, così nessuno ha un piatto a parte: una lasagna di verdure, un risotto ai funghi o un curry di ceci vanno bene per tutti.").
% - scintille: una presa o un apparecchio che fa scintille non si tocca e non si
%   riusa; si stacca il circuito dal quadro se lo si puo' fare in sicurezza e si
%   chiama un elettricista (Stevenage Borough Council, «electrical faults»;
%   Elec-Mate, «socket sparking»); con fumo o fiamme si esce e si chiama il
%   numero di emergenza (112 in Europa).
% - gas: non accendere ne' spegnere luci o apparecchi, niente fiamme, porte e
%   finestre aperte, uscire e chiamare da fuori (Mass.gov, «What to do if you
%   smell gas»; NH Department of Energy; National Grid).
move_cue("say not to touch it", hands_off).
move_cue("di' di non toccarla", hands_off).
move_cue("say to switch off the power at the main switch", switch_off_main).
move_cue("di' di staccare la corrente dal quadro", switch_off_main).
move_cue("say to call an electrician", call_electrician).
move_cue("di' di chiamare un elettricista", call_electrician).
% ⚠ Non «… if there is fire»: «if» apre il lettore dei problemi di logica.
move_cue("say to leave and call 112 on fire", fire_emergency).
move_cue("di' di uscire e chiamare il 112 con fumo o fiamme", fire_emergency).
move_cue("ask if everyone is safe", ask_safe_now).
move_cue("chiedi se sono tutti al sicuro", ask_safe_now).
move_cue("say not to use switches or flames", gas_no_sparks).
move_cue("di' di non usare interruttori ne' fiamme", gas_no_sparks).
move_cue("say to open the windows and go out", gas_ventilate_leave).
move_cue("di' di aprire le finestre e uscire", gas_ventilate_leave).
move_cue("say to call for help from outside", gas_call_outside).
move_cue("di' di chiamare aiuto da fuori", gas_call_outside).
move_cue("thank them for the detail", thank_detail).
move_cue("ringrazia per il dettaglio", thank_detail).
move_cue("ask since when it happens", ask_since_when).
move_cue("chiedi da quando succede", ask_since_when).
move_asks(ask_safe_now).
move_asks(ask_since_when).
plan_step_text_lang(hands_off, en, "Don't touch the socket, the switch or the appliance.").
plan_step_text_lang(hands_off, it, "Non toccare la presa, l'interruttore o l'apparecchio.").
plan_step_text_lang(switch_off_main, en, "If you can do it without going near the sparks, switch the power off at the main switch or fuse box.").
plan_step_text_lang(switch_off_main, it, "Se puoi farlo senza avvicinarti alle scintille, stacca la corrente dal quadro generale.").
plan_step_text_lang(call_electrician, en, "Don't use it again until an electrician has checked it.").
plan_step_text_lang(call_electrician, it, "Non usarlo di nuovo finché non l'ha controllato un elettricista.").
plan_step_text_lang(fire_emergency, en, "If there is smoke or flames, get out and call 112.").
plan_step_text_lang(fire_emergency, it, "Se c'è fumo o ci sono fiamme, esci e chiama il 112.").
plan_step_text_lang(ask_safe_now, en, "Is everyone safe right now?").
plan_step_text_lang(ask_safe_now, it, "Siete tutti al sicuro adesso?").
plan_step_text_lang(gas_no_sparks, en, "Don't switch lights or appliances on or off, and don't use flames or lighters.").
plan_step_text_lang(gas_no_sparks, it, "Non accendere né spegnere luci o apparecchi, e non usare fiamme o accendini.").
plan_step_text_lang(gas_ventilate_leave, en, "Open doors and windows if you can on the way, and get out.").
plan_step_text_lang(gas_ventilate_leave, it, "Apri porte e finestre se puoi mentre esci, ed esci.").
plan_step_text_lang(gas_call_outside, en, "Call the gas emergency service or 112 once you are outside.").
plan_step_text_lang(gas_call_outside, it, "Chiama il pronto intervento gas o il 112 quando sei fuori.").
plan_step_text_lang(thank_detail, en, "Thanks, that helps.").
plan_step_text_lang(thank_detail, it, "Grazie, questo aiuta.").
plan_step_text_lang(ask_since_when, en, "Since when has it been happening, and did anything change just before?").
plan_step_text_lang(ask_since_when, it, "Da quando succede, ed è cambiato qualcosa appena prima?").
% - ustioni: NHS, «Burns and scalds» — acqua fresca corrente per 20 minuti entro 3
%   ore; togliere indumenti e gioielli vicini ma non cio' che e' attaccato; niente
%   creme, oli, burro o cerotti; pellicola appoggiata, non avvolta; pronto soccorso
%   se grande, profonda, sul viso o causata da sostanze chimiche o elettricita'.
move_cue("say to cool it under running water", cool_burn).
move_cue("di' di raffreddarla sotto l'acqua", cool_burn).
move_cue("say to take off rings near it", remove_jewellery).
move_cue("di' di togliere gli anelli", remove_jewellery).
move_cue("say to cover it with cling film", cover_burn).
move_cue("di' di coprirla con la pellicola", cover_burn).
move_cue("say when to go to the emergency room", burn_emergency).
move_cue("di' quando andare al pronto soccorso", burn_emergency).
plan_step_text_lang(cool_burn, en, "Hold the burn under cool running water for 20 minutes, as soon as you can.").
plan_step_text_lang(cool_burn, it, "Tieni l'ustione sotto l'acqua fresca corrente per 20 minuti, appena puoi.").
plan_step_text_lang(remove_jewellery, en, "Take off rings, watches or clothing near it, but not anything stuck to the skin.").
plan_step_text_lang(remove_jewellery, it, "Togli anelli, orologi o vestiti vicini, ma non ciò che è attaccato alla pelle.").
plan_step_text_lang(cover_burn, en, "When it has cooled, lay cling film over it without wrapping it, and don't put butter, oils or creams on it.").
plan_step_text_lang(cover_burn, it, "Quando si è raffreddata, appoggiaci sopra la pellicola senza avvolgerla, e non metterci burro, oli o creme.").
plan_step_text_lang(burn_emergency, en, "Go to the emergency room if it is large or deep, on the face, or caused by chemicals or electricity.").
plan_step_text_lang(burn_emergency, it, "Vai al pronto soccorso se è grande o profonda, sul viso, o causata da sostanze chimiche o elettricità.").
% - naso: NHS, «Nosebleed» — seduti, piegati in avanti con la bocca aperta, stringere il
%   naso sopra le narici per 10-15 minuti respirando con la bocca; NON piegare la testa
%   indietro; pronto soccorso se dura piu' di 10-15 minuti, se e' molto, dopo un colpo
%   alla testa o con debolezza, capogiri o difficolta' a respirare.
move_cue("say to lean forward", lean_forward).
move_cue("di' di piegarsi in avanti", lean_forward).
move_cue("say to pinch the nose", pinch_nose).
move_cue("di' di stringere il naso", pinch_nose).
move_cue("say when to get help", nosebleed_emergency).
move_cue("di' quando chiedere aiuto", nosebleed_emergency).
move_cue("say not to tilt the head back", no_head_back).
move_cue("di' di non piegare la testa indietro", no_head_back).
plan_step_text_lang(lean_forward, en, "Sit down and lean forward with your mouth open.").
plan_step_text_lang(lean_forward, it, "Siediti e piegati in avanti con la bocca aperta.").
plan_step_text_lang(pinch_nose, en, "Pinch the soft part of your nose, just above the nostrils, for 10 to 15 minutes, breathing through your mouth.").
plan_step_text_lang(pinch_nose, it, "Stringi la parte morbida del naso, appena sopra le narici, per 10-15 minuti, respirando con la bocca.").
plan_step_text_lang(nosebleed_emergency, en, "Get urgent help if it lasts longer than 15 minutes, if you lose a lot of blood, after a blow to the head, or if you feel weak or dizzy.").
plan_step_text_lang(nosebleed_emergency, it, "Chiedi aiuto urgente se dura più di 15 minuti, se perdi molto sangue, dopo un colpo alla testa, o se ti senti debole o hai capogiri.").
plan_step_text_lang(no_head_back, en, "No: don't tilt your head back, the blood runs down your throat.").
plan_step_text_lang(no_head_back, it, "No: non piegare la testa indietro, il sangue scende in gola.").
plan_step_text_lang(look_together, en, "Let's look at it together.").
plan_step_text_lang(look_together, it, "Vediamolo insieme.").
plan_step_text_lang(ask_what_happens, en, "What is it, and what exactly happens?").
plan_step_text_lang(ask_what_happens, it, "Di che cosa si tratta, e che cosa succede esattamente?").
plan_step_text_lang(safety_first, en, "If something smokes, smells of burning or could hurt someone, switch it off or stop somewhere safe before anything else.").
plan_step_text_lang(safety_first, it, "Se qualcosa fuma, sa di bruciato o può far male a qualcuno, spegnilo o fermati in un posto sicuro prima di tutto.").
plan_step_text_lang(acknowledge_feeling, en, "That sounds hard, and it makes sense to feel that way.").
plan_step_text_lang(acknowledge_feeling, it, "Sembra pesante, ed è comprensibile sentirsi così.").
plan_step_text_lang(ask_main_worry, en, "What worries you most about it?").
plan_step_text_lang(ask_main_worry, it, "Che cosa ti preoccupa di più?").
plan_step_text_lang(one_small_step, en, "It often helps to pick one small thing you can do about it today.").
plan_step_text_lang(one_small_step, it, "Spesso aiuta scegliere una cosa piccola da fare oggi.").

% ── 3. ESEGUIRE IL PIANO INSEGNATO ───────────────────────────────────────────
%
% Le mosse si dicono nell'ordine in cui sono state insegnate. La prima parte
% dalla posizione 0 di `answer_text`; le altre portano lo spazio davanti.
% assistente utile U16 — UNA MOSSA PUO' VALERE SOLO IN CERTE CONDIZIONI. La
% sicurezza («If something smokes…») usciva anche per il wifi che si disconnette
% e per lo schermo del telefono rotto, dove non c'entra: aiuto fuori luogo. Una
% mossa che dichiara una condizione (`move_condition(Mossa, Registro)`) si dice
% solo se il turno porta una cue di quel registro; altrimenti tace, e il piano
% resta lo stesso per tutti gli altri guasti.
machinery(move_condition).
move_condition(safety_first, hazard_cue).
machinery(hazard_cue).
hazard_cue("car").  hazard_cue("engine").  hazard_cue("brake").  hazard_cue("brakes").
hazard_cue("motorbike").  hazard_cue("motorcycle").  hazard_cue("bike").
hazard_cue("mechanical").  hazard_cue("meccanico").  hazard_cue("auto").  hazard_cue("macchina").
hazard_cue("moto").  hazard_cue("freni").  hazard_cue("motore").
hazard_cue("heating").  hazard_cue("heater").  hazard_cue("boiler").  hazard_cue("caldaia").
hazard_cue("gas").  hazard_cue("oven").  hazard_cue("forno").  hazard_cue("stove").
hazard_cue("washing machine").  hazard_cue("lavatrice").  hazard_cue("electric").  hazard_cue("elettrico").
hazard_cue("smoke").  hazard_cue("smoking").  hazard_cue("fumo").  hazard_cue("burning").  hazard_cue("bruciato").
hazard_cue("socket").  hazard_cue("presa").  hazard_cue("plug").  hazard_cue("spina").
turn_cue_registry(hazard_cue, 1).
machinery(move_silent).
move_silent($Move) :- move_condition($Move, $Registry), naf(turn_has_cue_of(current_turn, $Registry)).
machinery(turn_has_cue_of).
turn_has_cue_of($Turn, $Registry) :- turn_cue_form($Turn, $Registry, $Cue).

situation_move_text($Move, $Language, "") :- move_silent($Move).
situation_move_text($Move, $Language, $Text) :- naf(move_silent($Move)), plan_step_text_lang($Move, $Language, $Text).
situation_move_text($Move, $Language, $Text) :- naf(move_silent($Move)), naf(plan_step_text_lang($Move, $Language, $Any)), plan_step_text_lang($Move, en, $Text).

answer_content(situation_plan($Situation, $Language), 0, move, $Piece) :-
    plan_move($Situation, 1, $Move), situation_move_text($Move, $Language, $Piece).
answer_content(situation_plan($Situation, $Language), $Position, move, $Piece) :-
    plan_move($Situation, $Order, $Move), gt($Order, 1), is($Position, sub($Order, 1)),
    situation_move_text($Move, $Language, $Text), dif($Text, ""), concat_atoms(" ", $Text, $Piece).
answer_content(situation_plan($Situation, $Language), $Position, move, "") :-
    plan_move($Situation, $Order, $Move), gt($Order, 1), is($Position, sub($Order, 1)),
    situation_move_text($Move, $Language, "").

% Una lezione di condotta NOMINA la situazione («when someone needs gift ideas
% then …») e non la vive: se la situazione ha gia' un piano, senza questa riga il
% piano risponde alla lezione che vuole aggiungergli una mossa (misurato in U15).
machinery(plan_lesson_cue).
plan_lesson_cue("when someone").
plan_lesson_cue("your plan when").
plan_lesson_cue("unlearn what you do when").
plan_lesson_cue("quando qualcuno").
turn_cue_registry(plan_lesson_cue, 1).
machinery(turn_is_plan_lesson).
turn_is_plan_lesson($Turn) :- turn_cue_form($Turn, plan_lesson_cue, $Cue).
turn_situation_plan($Turn, $Situation) :- user_situation($Turn, $Situation), plan_move($Situation, 1, $Move), naf(turn_is_plan_lesson($Turn)).
machinery(turn_has_situation_plan).
turn_has_situation_plan($Turn) :- turn_situation_plan($Turn, $Situation).

turn_plan_candidate($Turn) :- turn_situation_plan($Turn, $Situation).
turn_response($Turn, $Text) :- turn_situation_plan($Turn, $Situation), current_language($Language), answer_text(situation_plan($Situation, $Language), $Text).
