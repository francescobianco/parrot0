% Universal code observation IR — UC1.
%
% This file owns the meaning of the neutral records emitted by src/code.c.  The
% frontend may measure bytes, spans, nesting and syntax; it does not decide what
% a definition/call means to downstream faculties.  Observed rows are
% KB_REFLECTIVE and are replaced when the same source is read again.  These
% rules and question surfaces are curated machinery and remain KB_BASE.

machinery(code_snapshot).
machinery(code_source_snapshot).
machinery(code_source_unit).
machinery(code_node).
machinery(code_name).
machinery(code_span).
machinery(code_edge).
machinery(code_provenance).

% Source-qualified views.  These are the first stable consumer boundary: future
% frontends can add node and edge kinds without changing the question engine.
machinery(code_defined_in).
machinery(code_call_in).
machinery(code_reference).
machinery(code_scope).
machinery(code_contains).
machinery(code_ancestor).
machinery(code_predecessor).
machinery(code_ordered_before).
machinery(code_definition_evidence).
machinery(code_call_evidence).

code_defined_in($Name, $Source) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $Node, definition, $Name).

% gen503 — LE DICHIARAZIONI. Il frontend ora osserva anche `ident(...);` fuori
% da ogni funzione (un prototipo) e le da' il ruolo `declaration`. Qui non
% cambia niente del motore: il ruolo era gia' DATO in code_name/4, e questa
% vista e' la stessa forma di code_defined_in con un'altra costante. E' la
% promessa scritta in testa a questo file — un frontend nuovo entra derivando
% righe, non aggiungendo un consumer.
machinery(code_declared_in).

% ── gen503 — IL CONTRATTO, LETTO DALLA PROSA CHE STA SOPRA LA DICHIARAZIONE ──
%
% Di un header si osservava la FIRMA e non l'OBBLIGO: che cosa `str_join` debba
% restituire quando `count` e' 0 non e' nella firma, e' nel commento — e
% `code_strip` cancella i commenti prima che lo scanner li veda.
%
% Quella prosa e' una tabella condizione -> risultato. QUALE segno separa i due
% lati e' conoscenza: una convenzione nuova e' una riga qui, non una ricompilazione.
% gen503 — le FORME del codice si caricano AL BOOT, non pigramente.
%
% Erano dentro `algo_steps.p0`, che `mod_compose` carica solo in modalita'
% agente. Ma le stesse righe servono quando si LEGGE un header — cioe' prima e
% altrove — e un file che c'e' solo su una delle due strade produce il difetto
% peggiore: funziona quando lo provi e no quando serve.
:- include(../experts/programming/code_shapes.p0).

machinery(contract_arrow).
machinery(contract_clause).
machinery(contract_condition).
machinery(contract_result).

contract_arrow("->").
contract_arrow("=>").

% Una sola osservazione, piu' letture. Il fatto resta ternario; le viste sono
% binarie perche' e' la forma che una domanda sa interrogare.
contract_condition($Function, $Condition) :-
    contract_clause($Function, $Condition, $Result).
contract_result($Function, $Result) :-
    contract_clause($Function, $Condition, $Result).

answer_frame("contract of", contract_condition).
answer_frame_input_arg("contract of", contract_condition, 1).
answer_frame("contract results of", contract_result).
answer_frame_input_arg("contract results of", contract_result, 1).

% ⚠ MISURATO, e va detto: la vista tenuta dalla CONDIZIONE — «che cosa
% restituisce quando sep e' NULL» — non e' raggiungibile oggi. La condizione e'
% un testo con spazi e simboli («sep == NULL»), e la domanda non lo lega come
% entita': il turno finisce a `symbolic`, che ci vede del codice. La forma
% ternaria e' osservata e sta li'; manca la strada che ci arriva, ed e' una
% lacuna di raggiungibilita', non di conoscenza. Non si dichiara una superficie
% che non risponde: sarebbe un arco disegnato.
code_declared_in($Name, $Source) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $Node, declaration, $Name).

% ── gen503 — CIO' CHE E' DICHIARATO E NON DEFINITO ─────────────────────────
%
% Quando un progetto non compila perche' manca un file, QUALE funzione debba
% contenere non serve dedurlo da una convenzione sui nomi («strjoin.c sta a
% strjoin.h»): la si vede. Dopo aver letto i sorgenti, una funzione dichiarata
% in un header e definita da nessuna parte E' esattamente cio' che manca.
%
% Vale per qualunque progetto e per qualunque convenzione di nomi, ed e' la
% ragione per cui questa vista sta qui e non in una regola sul Makefile.
machinery(defined_somewhere).
machinery(undefined_declaration).

defined_somewhere($Name) :- code_defined_in($Name, $Source).

undefined_declaration($Name) :-
    code_declared_in($Name, $Source),
    naf(defined_somewhere($Name)).

code_call_in($Caller, $Callee, $Source) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $CallerNode, definition, $Caller),
    code_edge($Snapshot, $CallerNode, calls, $CallNode),
    code_name($Snapshot, $CallNode, reference, $Callee).

% Generic projections for future questions (impact, ownership, nesting): the
% edge kind and parent scope remain data, so adding a new frontend edge does
% not require a new C recognizer or a new question handler.
code_reference($Source, $From, $Kind, $To) :-
    code_source_snapshot($Source, $Snapshot),
    code_edge($Snapshot, $From, $Kind, $To).

code_scope($Name, $Scope, $Source) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $Node, $Role, $Name),
    code_node($Snapshot, $Node, $Kind, $Scope).

% Relazioni strutturali riusabili: il parent osservato diventa containment, e
% la chiusura transitiva permette domande di nesting senza conoscere la lingua
% sorgente. `code_predecessor/4` e' l'inversa generica di un edge: impact,
% callers e dipendenze possono riusarla senza duplicare il frontend.
code_contains($Source, $Parent, $Child) :-
    code_source_snapshot($Source, $Snapshot),
    code_node($Snapshot, $Child, $Kind, $Parent).

code_ancestor($Source, $Ancestor, $Node) :-
    code_contains($Source, $Ancestor, $Node).
code_ancestor($Source, $Ancestor, $Node) :-
    code_contains($Source, $Parent, $Node),
    code_ancestor($Source, $Ancestor, $Parent).

code_predecessor($Source, $To, $Kind, $From) :-
    code_reference($Source, $From, $Kind, $To).

% Ordine osservato nello stesso scope. Non viene chiamato CFG: è una relazione
% conservativa sugli span, utile a sequenza, dipendenze e causalità senza
% inventare branch o merge che il frontend non ha osservato.
code_ordered_before($Source, $First, $Second) :-
    code_source_snapshot($Source, $Snapshot),
    code_node($Snapshot, $First, $KindFirst, $Parent),
    code_node($Snapshot, $Second, $KindSecond, $Parent),
    code_span($Snapshot, $First, $StartFirst, $LenFirst),
    code_span($Snapshot, $Second, $StartSecond, $LenSecond),
    dif($First, $Second),
    lt($StartFirst, $StartSecond).

code_definition_evidence($Name, $Evidence) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $Node, definition, $Name),
    code_provenance($Snapshot, $Node, $Evidence).

code_call_evidence($Caller, $Evidence) :-
    code_name($Snapshot, $CallerNode, definition, $Caller),
    code_edge($Snapshot, $CallerNode, calls, $CallNode),
    code_provenance($Snapshot, $CallNode, $Evidence).

% ── A REPRESENTATION IS A DOOR, NOT A SILO ────────────────────────────────
%
% `apply/2` is the predicate-variable boundary of the solver.  These rules make
% it foundational to the IR: an item can denote an entity, and a declared
% higher-order bridge can ask a relation from another KB region about that
% entity.  The resulting claim retains the predicate it crossed and the bridge
% that licensed it.  There is no enumeration of domains or code questions here.
%
% A future frontend joins the system by deriving ir_denotation/4.  A future
% domain joins by adding representation_bridge/4.  Neither requires a new
% consumer.  With no bridge the IR makes no cross-domain claim; composition is
% opt-in, attributable and therefore retractable/refutable.
machinery(ir_denotation).
machinery(representation_bridge).
machinery(ir_domain_claim).
machinery(ir_domain_claim_basis).

ir_denotation(code, item($Snapshot, $Node), $Role, $Entity) :-
    code_name($Snapshot, $Node, $Role, $Entity).

ir_domain_claim($Representation, $Item,
                proposition($Predicate, $Entity)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, unary),
    apply($Predicate, cons($Entity, nil)).

ir_domain_claim($Representation, $Item,
                proposition($Predicate, $Entity, $Value)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, binary_arg1),
    apply($Predicate, cons($Entity, cons($Value, nil))).

ir_domain_claim($Representation, $Item,
                proposition($Predicate, $Value, $Entity)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, binary_arg2),
    apply($Predicate, cons($Value, cons($Entity, nil))).

ir_domain_claim_basis($Representation, $Item,
                      proposition($Predicate, $Entity),
                      bridge($Role, $Predicate, unary)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, unary),
    apply($Predicate, cons($Entity, nil)).

ir_domain_claim_basis($Representation, $Item,
                      proposition($Predicate, $Entity, $Value),
                      bridge($Role, $Predicate, binary_arg1)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, binary_arg1),
    apply($Predicate, cons($Entity, cons($Value, nil))).

ir_domain_claim_basis($Representation, $Item,
                      proposition($Predicate, $Value, $Entity),
                      bridge($Role, $Predicate, binary_arg2)) :-
    ir_denotation($Representation, $Item, $Role, $Entity),
    representation_bridge($Representation, $Role, $Predicate, binary_arg2),
    apply($Predicate, cons($Value, cons($Entity, nil))).

% ── UC1b — I PEZZI DI UN IDENTIFICATORE, E I PONTI CHE ORA HANNO QUALCOSA DA
%           ATTRAVERSARE ────────────────────────────────────────────────────
%
% Il ponte fra rappresentazioni esisteva ma era INERTE: `representation_bridge/4`
% aveva zero fatti, quindi nessuna query attraversava nessun confine. Il motivo
% non era il meccanismo — era che il lato codice offriva solo NOMI INTERI, e un
% nome intero non incontra mai la conoscenza di dominio: nessuna KB conterra' mai
% `data_structure(hash_table_insert, ...)`.
%
% Quali caratteri spezzino un identificatore e' conoscenza, non una legge: una
% convenzione nuova (kebab, namespace col punto, `::`) e' una riga.
machinery(identifier_separator).
machinery(code_name_part).
identifier_separator("_").
identifier_separator("-").
identifier_separator(".").

% Un pezzo denota quanto il nome intero. Da qui in poi il ponte ha di che vivere.
ir_denotation(code, item($Snapshot, $Node), part, $Part) :-
    code_name_part($Snapshot, $Node, $Index, $Part).

% ── ⭐ I PONTI VIVI: la conoscenza imparata LEGGENDO risponde sul CODICE ────
%
% Questi quattro fatti sono il moltiplicatore. `data_structure/2` e
% `algorithm_family/2` non sono stati scritti per il codice: vengono dagli
% esperti di programmazione, imparati come prosa e come lezioni. Un ponte li
% rende raggiungibili da un identificatore, e da quel momento la stessa
% conoscenza serve DUE rappresentazioni senza essere duplicata.
%
% Sono opt-in e attribuibili: `ir_domain_claim_basis/3` conserva il ponte che ha
% autorizzato la pretesa, quindi ogni claim si puo' contestare e ritirare. Senza
% questi fatti la IR resta muta sul dominio — che e' il comportamento giusto,
% non un difetto.
representation_bridge(code, part, data_structure, binary_arg1).
representation_bridge(code, part, algorithm_family, binary_arg1).
representation_bridge(code, part, complexity_class, binary_arg1).
representation_bridge(code, part, concept_domain, binary_arg1).

% Le domande che il consumer universale apre su questo, senza un handler nel C.
% ⚠ Le parole della domanda devono essere parole che parrot0 CONOSCE, o il turno
% viene preso dal percorso che offre di imparare il termine ignoto e la domanda
% non arriva mai al consumer. Non e' un frasario: e' vocabolario.
lexeme(domain).
lexeme(knowledge).

% ── LEGGERE UN SORGENTE RENDE I SUOI NOMI NOMINABILI ────────────────────────
%
% Senza questa riga, ogni domanda su un simbolo appena letto veniva presa dal
% percorso che offre di imparare il termine ignoto: parrot0 aveva appena messo
% `hash_table_get` nella propria KB e un turno dopo diceva di non conoscerlo.
% Non era un difetto di quel percorso — era vero che la parola non era nel
% lessico: l'osservazione del codice non lo alimentava.
%
% Il vocabolario si DERIVA dall'osservazione invece di essere asserito: nasce
% quando la sorgente viene letta e sparisce quando lo snapshot viene sostituito,
% senza che nessuno debba ricordarsi di ritirarlo.
lexeme($Name) :- code_name($Snapshot, $Node, definition, $Name).
answer_frame("domain knowledge about", ir_code_domain_note).
answer_frame_input_arg("domain knowledge about", ir_code_domain_note, 1).

machinery(ir_code_domain_note).
ir_code_domain_note($Name, $Note) :-
    code_name($Snapshot, $Node, $Role, $Name),
    code_name_part($Snapshot, $Node, $Index, $Part),
    data_structure($Part, $Note).
ir_code_domain_note($Name, $Note) :-
    code_name($Snapshot, $Node, $Role, $Name),
    code_name_part($Snapshot, $Node, $Index, $Part),
    algorithm($Part, $Family, $Note).

% Compatibility views.  They intentionally lose source/node identity and are
% therefore deprecated as an architectural boundary.  Existing code consumers
% may cross them while they migrate, but frontends never assert these facts.
machinery(code_function).
machinery(code_calls).

code_function($Name) :-
    code_source_snapshot($Source, $Snapshot),
    code_name($Snapshot, $Node, definition, $Name).

code_calls($Caller, $Callee) :-
    code_name($Snapshot, $CallerNode, definition, $Caller),
    code_edge($Snapshot, $CallerNode, calls, $CallNode),
    code_name($Snapshot, $CallNode, reference, $Callee).

% The universal answer-frame consumer supplies question matching, slot binding,
% rendering and prompt teaching.  A new paraphrase can be taught by anchoring it
% to either working question; no code handler or predicate name is required.
answer_frame("definition source of", code_defined_in).
answer_frame_input_arg("definition source of", code_defined_in, 1).
answer_frame("declaration source of", code_declared_in).
answer_frame_input_arg("declaration source of", code_declared_in, 1).
answer_frame("source evidence for", code_definition_evidence).
answer_frame_input_arg("source evidence for", code_definition_evidence, 1).
answer_frame("call evidence for", code_call_evidence).
answer_frame_input_arg("call evidence for", code_call_evidence, 1).
