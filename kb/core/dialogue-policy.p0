% dialogue-policy.p0 — la decisione dialogica come conoscenza (gen394).
%
% Il motore non deve decidere localmente che cosa fare davanti a una proof o a
% un gap. Qui lo stato epistemico del frame viene trasformato in evidenza e la
% policy associa quell'evidenza a una mossa. Aggiungere o ritirare una policy
% cambia la decisione senza cambiare il frame, il dominio o il binario.

:- file_attribute(machinery).

dialogue_state($Frame, proven_answer) :- frame_complete($Frame), frame_has_answer($Frame).
dialogue_state($Frame, missing_fact) :- frame_gap($Frame, missing_fact).

move_policy(proven_answer, answer).
move_policy(missing_fact, decline).
move_policy(single_dominant_reading, answer_with_interpretation_key).
move_policy(near_compatible_readings, add_nearby_reading).
move_policy(multiple_lexical_candidates, enumerate_alternatives).
move_policy(unverified_repair, propose_hypothesis).
move_policy(blocking_incompatible_readings, clarify).
move_policy(unresolved_reference, clarify).
move_policy(valid_surface, leave_unchanged).
move_policy(proven_answer_with_components, show_decomposition).

% gen491 — LA PAROLA SOLA CHE NON CONOSCO. La sonda `bare_topic_probe` ha
% misurato la mossa di un modello di frontiera davanti a un token nudo e ignoto
% (`qzxvb`): NOMINA la parola e chiede che cosa si intende. Non saluta mai.
%
% Fino al gen490 parrot0 la indovinava per fonotattica — pronunciabile =
% probabile saluto — e ci finivano dentro `milano`, `mercurio`, `python`,
% `rosso`. Qui la scommessa e' dichiarata invece che cablata: la riga sotto
% sceglie la mossa onesta, e asserire `move_policy(lone_unknown_word,
% social_contact)` a runtime rimette il saluto per eliminazione.
move_policy(lone_unknown_word, name_the_word).

move_priority(answer_with_interpretation_key, clarify, preferred_when_nonblocking).
move_priority(propose_hypothesis, silent_repair, always).
move_priority(decline, unsupported_answer, always).

% Una rinuncia puo' essere un vicolo cieco oppure una richiesta che porta il
% dato mancante nella conversazione. La mossa resta `decline` (non si inventa
% una risposta); la strategia di realizzazione e' conoscenza separata e
% ritrattabile. Lo stesso vale per un riferimento senza antecedente.
missing_fact_dialogue_strategy(name_and_ask).
reference_gap_dialogue_strategy(name_and_ask).

frame_move($Frame, $Move) :- dialogue_state($Frame, $Evidence), move_policy($Evidence, $Move).

% ── LA PRECEDENZA, che finora era un dato senza lettore (gen394) ────────────
%
% Uno stesso frame puo' raggiungere piu' mosse: due classi di evidenza valgono
% insieme, e ciascuna propone la sua. Elencarle tutte non e' rispondere — la
% conversazione ne vuole una — ma sceglierla per ordine di caricamento sarebbe
% far decidere al caso cio' che il piano chiede di rendere esplicito.
%
% `move_priority/3` esisteva dal primo taglio e nessuno la leggeva. Il terzo
% argomento e' la CONDIZIONE della precedenza, non un peso: «sempre» vale senza
% riserve, «preferita quando non blocca» vale solo se la mossa perdente non era
% la richiesta di chiarire un'ambiguita' che blocca davvero. Un numero non
% avrebbe potuto dire questa differenza.
move_beats($Winner, $Loser) :- move_priority($Winner, $Loser, always).
move_beats($Winner, $Loser) :- move_priority($Winner, $Loser, preferred_when_nonblocking), naf(blocking_move($Loser)).
blocking_move($Move) :- dialogue_state($Frame, blocking_incompatible_readings), move_policy(blocking_incompatible_readings, $Move).

move_defeated($Frame, $Loser) :- frame_move($Frame, $Loser), frame_move($Frame, $Winner), move_beats($Winner, $Loser).
frame_decision($Frame, $Move) :- frame_move($Frame, $Move), naf(move_defeated($Frame, $Move)).
