% stipulation.p0 — IL PRODUTTORE DEI CONTESTI (gen395).
%
% `context-scope.p0` sa gia' tenere insieme mondo, ipotesi, citazione e credenza
% riportata, e sa derivarne conflitti senza cancellare nessuna vista. Quello che
% mancava era la porta: nessun turno reale produceva `context/2` e `holds_in/2`,
% quindi il kernel restava un oggetto che soltanto un `.p0t` sapeva riempire. Il
% piano lo dice senza sconti — «la loro proiezione e' il gate della generazione».
%
% Il percorso storico delle ipotesi esiste ed e' diverso: applica le premesse
% sotto la provenienza `KB_HYPOTHETICAL`, risponde, e alla fine del turno le
% ritira tutte. E' giusto per «se tutti i gatti sono pesci, un gatto e' un
% pesce?», dove l'ipotesi serve una volta sola. Non basta per una CONVERSAZIONE:
% un mondo stipulato in un turno deve poter essere interrogato nel successivo, e
% deve restare distinguibile dal mondo invece di sovrascriverlo.
%
% Qui la stipulazione diventa percio' un impegno REIFICATO: un contesto tipizzato
% piu' le sue credenze, che sopravvivono al turno e restano interrogabili accanto
% al mondo. Le due strade convivono — quella storica non viene amputata.

:- file_attribute(machinery).

% ── 1. LA SUPERFICIE: stipulare e' un ruolo di span ─────────────────────────
%
% `stipulation_cue/1` esisteva gia' in `grammar.p0` e serviva un ramo del C che
% decideva se rinominare i concetti della premessa. La stessa conoscenza apre
% ora un ruolo dell'universal input: nessuna cue nuova, nessuna lingua nel
% motore, e una forma insegnata stasera segmenta il turno di stasera.
segment_role(stipulation, $Cue) :- stipulation_cue($Cue).

% Il congiuntivo italiano e' una forma della stessa relazione spaziale, non una
% relazione nuova. Sta qui e non fra le cue condizionali perche' e' la forma che
% una STIPULAZIONE usa: «supponiamo che milano sia in francia».
proposition_cue(located_in, "sia in").
proposition_cue(located_in, "were in").
proposition_arg_form(located_in, 1, canonical).
proposition_arg_form(located_in, 2, canonical).
proposition_arg_kind(located_in, 1, place).
proposition_arg_kind(located_in, 2, place).

% ── 2. LA LETTURA: soggetto stipulato, relazione e oggetto ──────────────────
%
% Il layout e' quello che il segmentatore produce da solo: la cue di
% stipulazione apre lo span del soggetto, la cue di proposizione apre quello
% dell'oggetto. E' la stessa forma del piano condizionale, quindi non nasce un
% secondo parser — cambia l'ATTO, non la meccanica.
% Il dialetto ammette otto goal per corpo, e la conversione delle superfici in
% atomi sta percio' QUI, come `conditional_raw_proposition/4` fa per il piano
% condizionale: la lettura sotto ha gia' i suoi sette. Non e' una limatura
% cosmetica — la stessa regola con nove goal veniva scartata dal loader senza
% una parola, e ogni pezzo interrogato da solo continuava a funzionare.
stipulation_raw($Turn, $Relation, $Subject, $Object) :- turn_span($Turn, $I, stipulation, $RawSubject), turn_span($Turn, $J, proposition, $RawObject), turn_span_cue($Turn, $J, $Evidence), proposition_evidence($Relation, $Evidence), span_atom($RawSubject, $Subject), span_atom($RawObject, $Object).

% Argomenti e tipi passano dalle stesse procedure del condizionale: una forma
% canonica e' una procedura, e un tipo incompatibile toglie la lettura.
stipulation_reading($Turn, $Relation, $Subject, $Object) :- stipulation_raw($Turn, $Relation, $RawSubject, $RawObject), proposition_arg_form($Relation, 1, $SubjectForm), argument_value($SubjectForm, $RawSubject, $Subject), proposition_arg_valid($Relation, 1, $Subject), proposition_arg_form($Relation, 2, $ObjectForm), argument_value($ObjectForm, $RawObject, $Object), proposition_arg_valid($Relation, 2, $Object).

stipulation_key($Turn, stipulated($Relation, $Subject, $Object)) :- stipulation_reading($Turn, $Relation, $Subject, $Object).
stipulation_set($Turn, $Readings) :- turn_stipulation_span($Turn), findall($R, stipulation_key($Turn, $R), $Readings).
turn_stipulation_span($Turn) :- turn_span($Turn, $Index, stipulation, $Payload).
stipulation_unique($Turn, $Relation, $Subject, $Object) :- stipulation_set($Turn, cons(stipulated($Relation, $Subject, $Object), nil)).
stipulation_ambiguous($Turn) :- stipulation_set($Turn, cons($First, cons($Second, $Tail))).

% ── 3. L'IMPEGNO: il mondo stipulato sopravvive al turno ────────────────────
%
% `assert/1` e' una primitiva del solver, quindi la KB puo' rendere persistenti
% le proprie conclusioni senza che un modulo C decida per lei quando farlo. E'
% un EFFETTO, e va guardato come tale: accade solo dentro la realizzazione della
% mossa `acknowledge`, cioe' quando parrot0 sta dicendo di aver preso l'impegno.
% Stipulare in silenzio, mentre si risponde ad altro, sarebbe un cambiamento di
% stato che l'interlocutore non ha modo di vedere.
%
% Il contesto e' tipizzato `hypothesis`, quindi eredita da `world` per la regola
% gia' scritta in `context-scope.p0`: cio' che l'ipotesi non dice resta vero come
% nel mondo, e cio' che dice non cancella nulla.
stipulated_world(stipulated_world).
stipulation_commit($Relation, $Subject, $Object) :- stipulated_world($Context), assert(context, $Context, hypothesis), assert(holds_in, $Context, fact($Relation, $Subject, $Object)).

% Ritirare un mondo stipulato e' l'operazione simmetrica, e appartiene alla KB
% per la stessa ragione: e' una mossa del dialogo, non un dettaglio di memoria.
stipulation_release($Context, $Relation, $Subject, $Object) :- retract(holds_in, $Context, fact($Relation, $Subject, $Object)).

% ── 3b. GLI ALTRI SCOPE: citazione e credenza riportata (gen395) ───────────
%
% `context-scope.p0` tipizza quattro specie di contesto e ne dichiara la politica
% di impegno: mondo e ipotesi impegnano chi parla o nessuno, citazione e credenza
% riportata impegnano soltanto CHI E' CITATO. Finora esisteva la macchina e non
% la porta: nessun turno produceva un contesto di quelle due specie.
%
% La forma e' quella della stipulazione — cue, span, lettura, impegno — con una
% differenza sola e decisiva: il contesto porta il nome di chi ha parlato. Non
% e' un dettaglio anagrafico, e' cio' che rende la credenza attribuibile invece
% che assorbita: «Anna dice che...» non diventa una cosa che parrot0 crede.
attribution_cue(reported_belief, "secondo").
attribution_cue(reported_belief, "according to").
attribution_cue(quotation, "ha detto che").
attribution_cue(quotation, "said that").
attribution_role_evidence($Kind, keyword($Cue)) :- attribution_cue($Kind, $Cue).
segment_role(attribution, $Evidence) :- attribution_role_evidence($Kind, $Evidence).

% La fonte e' la parola di contenuto che precede la cue quando la cue e' un
% verbo di dire, e quella che la segue quando e' una preposizione: due layout,
% e la KB dice quale cue ha quale — il motore non conosce nessuna delle due.
attribution_source_side(quotation, before).
attribution_source_side(reported_belief, after).
attribution_span_word($Turn, $Index, $Word) :- turn_span_token($Turn, $Index, $Position, $Token), span_atom($Token, $Word), naf(stopword($Word)).
attribution_kind($Turn, $Index, $Kind) :- turn_span($Turn, $Index, attribution, $Payload), turn_span_cue($Turn, $Index, $Evidence), attribution_role_evidence($Kind, $Evidence).

% Fonte e soggetto si distinguono per GIUNZIONE, non per posizione: il soggetto
% e' la parola che la relazione accetta come primo argomento, la fonte e' quella
% che non accetta. E' la stessa disciplina di `code-plans.p0` sui nomi legati da
% una traccia — chi parla e di che cosa si parla non si riconoscono dall'ordine.
attribution_raw($Turn, $Relation, $Object) :- turn_span($Turn, $J, proposition, $RawObject), turn_span_cue($Turn, $J, $Evidence), proposition_evidence($Relation, $Evidence), span_atom($RawObject, $Surface), canonical_value($Surface, $Object).
attribution_subject($Turn, $Index, $Relation, $Subject) :- attribution_span_word($Turn, $Index, $Word), canonical_value($Word, $Subject), proposition_arg_valid($Relation, 1, $Subject).
attribution_who($Turn, $Index, $Relation, $Who) :- attribution_span_word($Turn, $Index, $Who), naf(valid_first_argument($Relation, $Who)).
valid_first_argument($Relation, $Word) :- canonical_value($Word, $Value), proposition_arg_valid($Relation, 1, $Value).

attribution_reading($Turn, $Kind, $Who, $Fact) :- attribution_kind($Turn, $Index, $Kind), attribution_raw($Turn, $Relation, $Object), attribution_subject($Turn, $Index, $Relation, $Subject), attribution_who($Turn, $Index, $Relation, $Who), proposition_arg_valid($Relation, 2, $Object), attribution_fact($Relation, $Subject, $Object, $Fact).
attribution_fact($Relation, $Subject, $Object, fact($Relation, $Subject, $Object)).

attribution_key($Turn, attributed($Kind, $Who, $Fact)) :- attribution_reading($Turn, $Kind, $Who, $Fact).
attribution_set($Turn, $Readings) :- turn_span($Turn, $Index, attribution, $Payload), findall($R, attribution_key($Turn, $R), $Readings).
attribution_unique($Turn, $Kind, $Who, $Fact) :- attribution_set($Turn, cons(attributed($Kind, $Who, $Fact), nil)).

% L'impegno: il contesto porta il NOME di chi ha parlato, ed e' cio' che rende la
% credenza attribuibile invece che assorbita. `commitment_policy/2` del gen395
% dice gia' che quelle specie impegnano soltanto chi e' citato: qui si crea
% finalmente un contesto di quelle specie, e la politica smette di essere
% teorica.
attribution_commit($Kind, $Who, $Fact) :- assert(context, $Who, $Kind), assert(holds_in, $Who, $Fact).
bookkeeper(attribution).
turn_bookkeeping($Turn, attribution) :- attribution_unique($Turn, $Kind, $Who, $Fact), attribution_commit($Kind, $Who, $Fact).

turn_plan_candidate($Turn) :- attribution_unique($Turn, $Kind, $Who, $Fact).
turn_response($Turn, $Text) :- attribution_unique($Turn, $Kind, $Who, $Fact), current_language($Language), response_template(attribution_acknowledged, $Language, $Text).

% ── 4. LA MOSSA: riconoscere, non rispondere ───────────────────────────────
%
% Una stipulazione non fa una domanda. La mossa dovuta e' `acknowledge`, che il
% gen394 elenca fra quelle invarianti: dire che l'impegno e' stato preso, e
% renderlo interrogabile. Rispondere qualcosa di piu' significherebbe inventare
% una conseguenza che nessuno ha ancora chiesto.
dialogue_state($Turn, new_shared_constraint) :- stipulation_unique($Turn, $Relation, $Subject, $Object).
turn_plan_candidate($Turn) :- stipulation_unique($Turn, $Relation, $Subject, $Object).
% L'impegno e' un EFFETTO e vive nella contabilita': cosi' avviene anche quando
% a rispondere e' un altro produttore, e `turn_response/2` torna a essere pura —
% una risposta non puo' dipendere da un effetto accaduto mentre la si cercava.
bookkeeper(stipulation).
turn_bookkeeping($Turn, stipulation) :- stipulation_unique($Turn, $Relation, $Subject, $Object), stipulation_commit($Relation, $Subject, $Object).
turn_response($Turn, $Text) :- stipulation_unique($Turn, $Relation, $Subject, $Object), current_language($Language), response_template(stipulation_acknowledged, $Language, $Text).
