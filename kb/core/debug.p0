% debug.p0 — L'ISPETTORE, e la nota che lo accompagna (gen433)
%
% `/debug` non e' piu' soltanto un profiler: e' lo strumento con cui un
% SUPERVISORE guarda dentro un turno andato storto e capisce DOVE piantare il
% seme che manca. Serve perche' finche' la KB non e' fertile
% (docs/plans/autocrescita.md §0a) ci saranno turni in cui l'autocorrezione non
% si innesca — o perche' manca qualcosa di piu' fondamentale, o perche' le
% quattro condizioni non valgono tutte insieme.
%
% TUTTO QUELLO CHE L'ISPETTORE DICE STA QUI. Il C stampa; che cosa valga la pena
% guardare, con che etichetta, e in che ordine, e' conoscenza — cosi' una
% ispezione nuova costa UNA RIGA. E' la richiesta esplicita di F.: gli strumenti
% di debug vanno migliorati di continuo, in relazione a necessita' che oggi non
% conosciamo, quindi devono essere fatti per crescere senza ricompilare.

% ── IL TRACE UNICO DEL TURNO (23 settembre 2026) ──────────────────────────
% Le sonde qui sotto mostrano lo STATO del turno. Il PERCORSO — canone e forza,
% ogni facolta' provata (cede per quale regola, declina, risponde), i cancelli
% dei lettori, gli schemi legati, le ricevute, le viste invalidate, le
% dipendenze della risposta del piano di turno — sta nel trace unico
% (`p0_trace`, src/brain.c), in ordine, sempre registrato:
%   /debug                 l'ispettore, con la TRACCIA DEL TURNO in fondo
%   /debug trace [parola]  solo la traccia, filtrata
%   !debug                 lo stesso dentro un .p0t (nel log del demone)
%   PARROT0_TURN_LOG=file  ogni turno in append nel file
%   PARROT0_TRACE_ECHO=1   ogni riga anche su stderr mentre accade
% Le vecchie variabili (P0_READ/FORM/FRAME/SAVE/WP_TRACE, PARROT0_BOOT_TRACE)
% restano come eco del loro stadio. ⛔ Mai piu' una fprintf temporanea: una
% traccia che serve va nel trace unico, e ci resta (F., sette richieste).

:- file_attribute(machinery).

% ── LA NOTA, che si legge PRIMA di qualunque numero ────────────────────────
% E' il punto piu' importante del comando, non un preambolo di cortesia.
debug_charter_line(1, "NOTA — a che cosa serve addestrare parrot0 parlandogli.").
debug_charter_line(2, "L'addestramento via prompt serve a STRUTTURARE le sue abilita' di").
debug_charter_line(3, "autoapprendimento e automiglioramento: dargli il modo di accorgersi di una").
debug_charter_line(4, "lacuna, di porsi la domanda giusta e di colmarla da solo la prossima volta.").
debug_charter_line(5, "NON serve a spingergli dentro fatti e regole secche.").
debug_charter_line(6, "Un fatto che nessuna forma sa raggiungere non risponde e non genera domande:").
debug_charter_line(7, "e' peso morto due volte, e non si lamenta. Prima di insegnare un valore,").
debug_charter_line(8, "chiediti se manca il valore o se manca la STRADA che ci arriva — e se").
debug_charter_line(9, "quello che stai per dire varra' anche per il caso che non hai davanti.").
debug_charter_line(10, "La domanda di controllo e' sempre la stessa: parrot0 potra' impararne un").
debug_charter_line(11, "membro nuovo domani, da solo, senza che nessuno riscriva questa riga?").

% Quanti predicati mostrare della strada percorsa: un turno ne tocca anche cento.
machinery(debug_road_max).
debug_road_max(24).

% ── LE SONDE: che cosa guardare di un turno andato storto ──────────────────
% debug_probe(Ordine, Predicato, Chiave, Etichetta)
%   Chiave = turn  → si interroga con il turno canonicalizzato
%   Chiave = any   → si elencano le righe presenti (poche, di sessione)
% Una sonda nuova e' una riga: e' cosi' che questo strumento cresce.
% gen434: la SPECIE DERIVATA e il suo rimedio — la prima cosa da guardare,
% perche' e' quella che dice se il seme e' un fatto, una forma o una guardia.
debug_probe(5, turn_gap_kind, now, "SPECIE della lacuna (derivata)").
debug_probe(6, turn_outcome, now, "esito del turno").
debug_probe(7, turn_topic, now, "parola nominata").
debug_probe(8, turn_module, now, "facolta' che ha risposto").
debug_probe(9, turn_gap_remedy, now, "IL RIMEDIO che quella specie chiede").
% gen505t — IL FUOCO DELLA DOMANDA. La lettura che decide se una risposta parla
% della cosa chiesta o del suo AMBITO: «cosa e' l'arrocco negli scacchi» riceveva
% la definizione degli scacchi, e da fuori sembrava una risposta giusta. Con
% queste tre righe si vede su che cosa parrot0 credeva di rispondere, e CHI si e'
% dovuto ritirare — cioe' la differenza fra «non lo so» e «ho risposto d'altro».
debug_probe(11, turn_focus, now, "DI CHE COSA chiede il turno (ambito escluso)").
debug_probe(12, turn_focus_input, now, "su quale testo il fuoco e' stato letto").
debug_probe(13, turn_focus_rejected, now, "risposte ritirate: fuori dal fuoco").
% gen505y — LA FORZA DEL TURNO. «sai cosa sono le sbaddune» scriveva un fatto
% falso, e la diagnosi e' costata due giri perche' nessuno vedeva che cosa il
% frame avesse letto: l'handoff diceva «la lettura c'era», e non c'era. Con
% questa riga si vede in un colpo se il turno e' stato letto come domanda,
% direttiva, affermazione o gesto — cioe' se chi ha scritto aveva titolo.
debug_probe(14, turn_illocution, now, "la FORZA del turno: question / directive / assertion / expressive").
% 18 settembre 2026, notte — IL LETTORE DELLE CLASSI, visto da fuori. «threaten
% is a relation verb» cadeva nel muro e nessuna sonda diceva DOVE il lettore
% «X is a Y» si fosse fermato: e' costato una traccia temporanea nel C. F.:
% «valuta sempre se le tracce temporanee possono diventare parte di /debug».
% Ora il lettore posa che cosa ha letto (soggetto e classi) o a quale cancello
% ha rinunciato, e questa riga lo mostra.
machinery(turn_class_read).
debug_probe(23, turn_class_read, now, "il lettore X-is-a-Y: che cosa ha letto, o a quale cancello si e' fermato").
debug_probe(10, machinery_gap, turn, "lacuna registrata per questo turno").
debug_probe(20, gap_kind, turn, "specie della lacuna").
debug_probe(30, gap_source, turn, "il turno come e' stato detto").
debug_probe(40, pending_gap, any, "parole opache in attesa").
debug_probe(41, open_issue, any, "il TABELLONE (issues.p0): le questioni aperte, per genere").
debug_probe(42, max_qud, any, "la questione MASSIMA: quella su cui il turno si legge per primo").
debug_probe(50, gap_register, turn, "registro riconosciuto").
% gen507/35 — F., 2026-09-10: «meglio un PIANO INTERNO o un reasoning; per
% adesso non scomodiamo il thinking multi-inferenza». Un piano interno che non
% si puo' interrogare non e' un ragionamento: e' un ripiego travestito. Qui i
% passi che parrot0 ha fatto DENTRO un turno diventano visibili, in ordine.
% ⚠ gen507/35 — IL NUMERO D'ORDINE E' USATO COME CHIAVE DAL RENDERER.
% `/debug` enumera le sonde per NUMERO e risale da li' al predicato: due sonde
% con lo stesso numero e una delle due sparisce, senza dirlo. Erano doppi 11, 12,
% 13 e 15 — quindi QUATTRO sonde dichiarate da qualcuno non comparivano mai, fra
% cui le tre della cessione del turno. Uno strumento di diagnosi che tace una
% riga che c'e' mente al supervisore, ed e' peggio di uno che non ce l'ha.
% Rinumerate qui; il difetto vero — l'identita' di una sonda e' il suo
% PREDICATO, il numero serve solo a ordinare — e' scritto in C_TODO.md.
% gen507/36 — e il piano DICHIARATO, distinto dai passi fatti: uno e' la
% condotta che parrot0 ha, l'altro e' quello che ha fatto in questo turno.
debug_probe(22, plan_move, any, "i PIANI che so: situazione, ordine, mossa").
debug_probe(21, turn_plan_step, now, "il PIANO INTERNO: i passi fatti dentro questo turno, in ordine").
% 19 settembre 2026 — che cosa VEDE la IR del turno: i sintagmi candidati e le
% entita' che i frame possono legare. Senza queste due righe, per capire perche'
% «the phylum Cnidaria» non era un'entita' si potevano solo fare domande si'/no.
machinery(debug_np_candidate).
machinery(debug_turn_entity).
debug_np_candidate($T, $Q) :-
    input_node($T, $I, node(phrase, np_candidate, $P), $R), input_node_surface($T, $I, $Q).
debug_turn_entity($T, $E) :- input_scope_language($T, $L), input_entity_node($T, $L, $I, $E).
debug_probe(24, debug_np_candidate, now, "i sintagmi candidati della IR del turno").
debug_probe(25, debug_turn_entity, now, "le entita' che i frame del turno possono legare").
machinery(debug_frame_record).
machinery(debug_binding).
debug_frame_record($T, frame($F, $R)) :- input_frame_record($T, $F, $R).
% (la chiave `any` interroga il predicato con arita' 1)
debug_binding(binding($Op, $S, $F)) :- semantic_binding($Op, $S, $F).
debug_probe(26, debug_frame_record, now, "la lettura registrata del turno (frame e ruoli)").
debug_probe(27, debug_binding, any, "i legami impegnati dalla lettura").
machinery(debug_complement).
debug_complement(complement($B, $P, $X)) :- semantic_complement($B, $P, $X).
debug_probe(28, debug_complement, any, "i complementi registrati accanto ai legami").
machinery(debug_frame_candidate).
debug_frame_candidate($T, frame($M, $Op, $R)) :- input_semantic_frame($T, $M, $Op, $R).
debug_probe(29, debug_frame_candidate, now, "i frame candidati del turno (tutti, prima dell'unicita')").



% 20 settembre 2026 (F.) — «non posso accettare che scoprire chi stampa "Held:"
% non sia banalmente gestito da un /debug». Ora chi parla lascia il proprio nome
% nel turno: la forma che ha rivendicato la frase e il template che l'ha detta,
% nell'ordine in cui sono stati usati. Un template che manca si vede come
% `template_missing(nome)`, che e' esattamente la famiglia da insegnare.
machinery(turn_said_by).
turn_scratch(turn_said_by).
debug_probe(35, turn_said_by, now, "chi ha prodotto la risposta: la forma di turno e il template di frase").
% 23 settembre 2026 (F.: «e' sempre la caccia al filo d'Arianna») — LA STRADA
% DEL DISPATCH: le facolta' provate in ordine, `nome!yield` = ha ceduto per una
% condotta KB, `nome` = ha declinato, `=> nome` = chi ha risposto. Dice in un
% colpo quale facolta' avrebbe dovuto prendere il turno e che cosa le e' successo.
machinery(turn_faculty_path).
turn_scratch(turn_faculty_path).
debug_probe(36, turn_faculty_path, now, "la STRADA del dispatch: chi ha ceduto (!yield), chi ha declinato, => chi ha risposto").
debug_probe(60, learned_bridge, any, "ponti che il ciclo si e' insegnato").
debug_probe(70, dead_rule, any, "regole che non possono dedurre niente").

% ── LE QUATTRO CONDIZIONI dell'autocorrezione (docs/autocorrezione.md §2) ──
% Perche' il ciclo NON si e' innescato. Si stampano sempre tutte e quattro:
% sapere quale manca e' la meta' del lavoro del supervisore.
debug_condition(1, "il turno e' fallito in modo VISIBILE (muro o declino registrato)").
debug_condition(2, "nessuna parola era opaca (se lo era, il rimedio e' leggere, non proporre)").
debug_condition(3, "il ponte mancante e' di una forma PROPONIBILE (oggi: solo le cue)").
debug_condition(4, "la verifica accetta il rimedio (oggi l'interruttore e' spento apposta)").

% ── I SEMI che il supervisore puo' piantare, in ordine di leva ─────────────
% supervisor_seed(Ordine, Forma, Frase-da-dire)
% Le prime tre sono le forme che il ciclo sa poi RIUSARE da solo; l'ultima e'
% quella da usare per ultima, e la nota dice perche'.
supervisor_seed(10, superficie, "insegna la FORMA con cui te l'ho chiesto — e' la classe piu' numerosa: «X is a relation verb», «the R of X is Y», «the notation of N is S»").
supervisor_seed(20, classe, "insegna la CLASSE a cui la parola appartiene — «X is a condition marker», «X is a greeting» — cosi' vale per tutti i membri futuri").
supervisor_seed(30, procedura, "insegna la PROCEDURA come regola sui pezzi, non il risultato: una riga che vale per ogni caso della stessa forma").
supervisor_seed(40, fatto, "solo se manca davvero il VALORE, e dopo esserti chiesto se una forma lo raggiungera': un fatto senza strada e' peso morto").

% ── IL CASO SILENZIOSO ─────────────────────────────────────────────────────
% Nessuna lacuna registrata NON vuol dire che il turno sia andato bene: vuol
% dire che il motore lo ha considerato GESTITO. E' la classe piu' numerosa dei
% cento fallimenti e la peggiore, perche' sembra una risposta. Va detta qui,
% perche' e' esattamente il momento in cui un supervisore rischia di concludere
% che non c'e' niente da riparare.
debug_note_silent(1, "nessuna lacuna registrata: il motore ha considerato il turno GESTITO.").
debug_note_silent(2, "Se la risposta non risponde, questa e' la classe `wrong` — un turno").
debug_note_silent(3, "riuscito per il motore e fallito per te. Non lascia traccia, quindi").
debug_note_silent(4, "l'autocorrezione non sa nemmeno che esiste: il seme qui non e' un fatto,").
debug_note_silent(5, "e' una GUARDIA DI PERTINENZA — dire a parrot0 quando quella facolta' NON").
debug_note_silent(6, "deve prendere il turno. Vedi docs/autocorrezione.md §4b e la forma G di").
debug_note_silent(7, "docs/plans/fix-patterns.md.").

% gen459 — fino a quale arita' `/debug <predicato>` guarda. E' un fatto perche'
% il numero giusto dipende da che cosa si sta cercando, non dal motore.
debug_pred_arity_max(4).

% ── gen502: LA CESSIONE DEL TURNO, resa ispezionabile ──────────────────────
% F.: «migliora lo strumento di debug per l'occasione di scovare questo
% problema». L'occasione: una cessione non scattava su un prompt di 1485 byte, e
% per capirlo e' servita una `fprintf` usa-e-getta — che ha rivelato in un colpo
% che la vista consultata era lunga 93 caratteri invece di 1485, perche' una
% facolta' stava guardando un FRAMMENTO e non il turno.
%
% Un difetto che si vede in una riga non deve costare una ricompilazione per
% essere visto. Le tre sonde qui sotto lo mostrano da sole, e la prima e' quella
% che l'avrebbe chiuso in un secondo: se `source` non e' lungo quanto il turno,
% la decomposizione ha perso la lettura globale.
debug_probe(17, turn_yield_view, now, "cessione: quanto e' lunga OGNI vista consultata").
debug_probe(18, turn_yield_probe, now, "cessione: quale vista ha visto la classe").
debug_probe(19, turn_yield_outcome, now, "cessione: chi ha ceduto il turno").

% ── 20 settembre 2026 (F.) — CHE COSA E' «LA LETTURA DEL TURNO» ─────────────
% Il dump (`/debug dump`, o PARROT0_TURN_DUMP=1 a ogni turno) stampa i fatti di
% questi predicati: e' il tracciato ricco da cui si leggono le incongruenze per
% incrocio, invece di chiederle una sonda per volta. Un predicato nuovo qui
% entra nel dump senza ricompilare.
machinery(turn_reading_predicate).
turn_reading_predicate(turn_span).
turn_reading_predicate(turn_span_surface).
turn_reading_predicate(turn_span_cue).
turn_reading_predicate(turn_span_token).
turn_reading_predicate(turn_span_binding).
turn_reading_predicate(input_node_atom).
turn_reading_predicate(input_node_range).
turn_reading_predicate(input_node_next).
turn_reading_predicate(turn_word).
turn_reading_predicate(turn_surface_token).
turn_reading_predicate(turn_cue).
turn_reading_predicate(turn_pattern_match).
turn_reading_predicate(turn_illocution).
turn_reading_predicate(turn_said_by).
turn_reading_predicate(turn_class_read).
turn_reading_predicate(turn_yield_outcome).
% Il sandbox delle premesse («if A and B, is C?») depone qui che cosa ha preso
% e che cosa ha rifiutato: senza, un turno ipotetico cadeva al muro e la
% premessa colpevole restava invisibile.
machinery(turn_premise_read).
turn_scratch(turn_premise_read).
turn_reading_predicate(turn_premise_read).
% Su che cosa poggia la risposta, e se quel sostegno stava fra le premesse:
% e' la differenza fra «le premesse lo implicano» e «lo so dal mondo», detta
% come conoscenza invece che ottenuta nascondendo il mondo (mantra #25).
machinery(turn_answer_support).
turn_scratch(turn_answer_support).
turn_reading_predicate(turn_answer_support).
turn_reading_predicate(machinery_gap).

% 20 settembre 2026 — I TOKEN DELLA IR, con l'ordine e la superficie.
% Ogni sonda nuova e' una riga di KB: per capire perche' una frase non viene
% letta serve poter guardare da che cosa il lettore parte, non dedurlo.
machinery(debug_ir_token).
debug_ir_token($T, tok($Id, $W)) :- ir_token(input($T), $Id, $W, $Range).
debug_probe(36, debug_ir_token, now, "i token della IR del turno, con l'indice").
machinery(debug_ir_node).
debug_ir_node($T, n($Id, $Node)) :- input_node($T, $Id, $Node, $R).
debug_probe(37, debug_ir_node, now, "i nodi grezzi della IR del turno, con il livello").

% L3/I1 (25 settembre 2026) — LE QUANTITA' CHE LA IR HA VISTO: numero e unita'.
% Senza questa riga «il numero sparisce» si poteva solo dedurre dalle entita'.
machinery(debug_quantity).
debug_quantity($T, $Q) :- input_quantity_node($T, $I, $Q, $L).
debug_probe(39, debug_quantity, now, "le quantita' della IR del turno: numero e unita'").

% L3/I2 (25 settembre 2026) — LE IPOTESI NATE PER CONTATTO: quale nome potrebbe
% nominare quale relazione, con quanti sostegni, e se sono ritirate.
machinery(debug_contact).
debug_contact(hypothesis($N, $R, observations($K))) :- contact_candidate($N, $R), contact_support($N, $R, $K).
debug_contact(suspended($N, $R, competing_reading)) :- contact_candidate($N, $R), contact_competing($N, $R).
debug_contact(withdrawn($N, $R)) :- contact_bridge_withdrawn($N, $R).
debug_contact(used_not_confirmed($N, $R, $E)) :- contact_use($N, $R, $E).
debug_contact(read_through($F, $V)) :- read_support($F, $V).
debug_contact(withheld($F)) :- read_support($F, $V), fact_withheld($F).
debug_contact(countered($N, $R, $E)) :- contact_counter($N, $R, $E).
debug_probe(43, debug_contact, any, "le ipotesi nate per contatto: nome, relazione, sostegni").

% L3 §25 (25 settembre 2026) — I CORTOCIRCUITI DELLE VISTE: quale vista non si
% e' potuta congelare, per quale costrutto riflessivo, e la catena di predicati
% dalla vista alla regola che lo usa. Prima lo diceva solo PARROT0_BOOT_TRACE.
% §25.3 — oggi e' una faccia del registro unico (`paradox_event/4`, sotto).
machinery(view_short_circuit).
view_short_circuit($V, $B, $Chain) :- paradox_event(view, short_circuit($B), $V, $Chain).

% §25.2 — i CICLI delle viste: una vista che raggiunge se stessa per regole
% (dentro la sua definizione, o attraverso un'altra vista).
machinery(view_cycle).
view_cycle($V, $Chain) :- paradox_event(view, cycle, $V, $Chain).

% §25.3 (25 settembre 2026) — IL REGISTRO UNICO DEI PARADOSSI. Il taglio
% anti-isteresi nella prova (gen382), il budget esaurito, il cortocircuito di
% una vista e il ciclo di una vista sono la STESSA specie: una definizione che
% per chiudersi deve consultare cio' che sta definendo, o non finisce. Erano
% tre nomi e un contatore del C; ora sono un fatto solo:
%   paradox_event(Livello, Specie, Dove, Dettaglio)
%     proof  loop_cut | budget         Predicato   seen(Turno, Quante)
%     view   short_circuit(Costrutto)  Vista       Catena
%     view   cycle                     Vista       Catena
% Il motore lo scrive e la KB lo legge; la sonda lo mostra per intero.
machinery(paradox_event).
machinery(debug_paradox).
debug_paradox(paradox($L, $K, $W, $D)) :- paradox_event($L, $K, $W, $D).
debug_probe(44, debug_paradox, any, "il registro unico dei paradossi: cicli tagliati, budget, cortocircuiti e cicli delle viste").
