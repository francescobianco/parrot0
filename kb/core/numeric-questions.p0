% numeric-questions.p0 — I NUMERI CHE IL TURNO PORTA (gen399).
%
% Dal censimento di `docs/plans/parrot0-100-failures.md`: «which is greater,
% 3.14 or 3.41?» rispondeva «I don't know about greater yet», e con lui
% l'ordinamento, il resto della divisione e la mediana. Non era una lacuna di
% CALCOLO — `is/2`, `gt/2`, `le/2` e `mod` esistono dal gen335 e `max_list/2` sta
% in `procedures.p0` da allora. Mancava il ponte: nessuna superficie portava i
% numeri del turno dentro un operatore.
%
% Il fascio si chiude una volta sola perche' il ponte e' generico: una domanda
% numerica nuova e' UNA cue piu' UNA procedura, e nessun consumer cambia. La
% sonda `failure_modes_probe.py` ha mostrato che la mossa giusta e' anche corta —
% «3.41 is greater», «2, 4, 8, 11» — quindi la resa non spiega se non le si
% chiede.

:- file_attribute(machinery).

% ── 1. LE PROCEDURE, che sono conoscenza ───────────────────────────────────
%
% `max_list/2` c'era gia'. Le altre sono la stessa specie: fold e ricorsione
% sopra i primitivi, nessuna riga di C. L'ordinamento e' un inserimento — la
% forma piu' piccola che sia ancora un ordinamento — e mediana e minimo ci si
% appoggiano invece di rifare il lavoro.
min_list(cons($X, nil), $X).
min_list(cons($H, $T), $M) :- min_list($T, $M1), le($H, $M1), is($M, $H).
min_list(cons($H, $T), $M) :- min_list($T, $M1), gt($H, $M1), is($M, $M1).

insert_sorted($X, nil, cons($X, nil)).
insert_sorted($X, cons($H, $T), cons($X, cons($H, $T))) :- le($X, $H).
insert_sorted($X, cons($H, $T), cons($H, $R)) :- gt($X, $H), insert_sorted($X, $T, $R).
sort_list(nil, nil).
sort_list(cons($H, $T), $R) :- sort_list($T, $S), insert_sorted($H, $S, $R).

nth_item(cons($H, $T), 0, $H).
nth_item(cons($H, $T), $K, $X) :- gt($K, 0), is($K1, sub($K, 1)), nth_item($T, $K1, $X).

% Con un numero pari di valori questa mediana prende quello centrale INFERIORE
% invece della media dei due: e' una scelta, e va detta. La media dei centrali
% entra il giorno in cui un caso reale la chiede, non oggi per completezza.
median_list($List, $M) :- sort_list($List, $Sorted), count_list($List, $N), is($K, div(sub($N, 1), 2)), nth_item($Sorted, $K, $M).

% ── 2. I NUMERI DEL TURNO ──────────────────────────────────────────────────
%
% `turn_span_token/4` pubblica gia' ogni parola del turno; un token e' un NUMERO
% quando l'aritmetica lo accetta, che e' lo stesso criterio che `code-plans.p0`
% usa per le obbligazioni. Non serve una classe lessicale: lo decide l'operatore
% che dovra' leggerlo.
turn_number($Turn, $Number) :- turn_span_token($Turn, $Index, $Position, $Token), span_number($Token, $Number).
turn_number_list($Turn, $Numbers) :- findall($N, turn_number($Turn, $N), $Numbers).

% ── 3. LA SUPERFICIE E L'OPERATORE ─────────────────────────────────────────
%
% Una cue nomina un operatore; l'operatore e' una procedura. Aggiungerne uno e'
% due fatti e nessun codice — ed e' il motivo per cui questo file chiude un
% fascio dei cento fallimenti invece di quattro casi.
numeric_cue("which is greater", greatest).
numeric_cue("which is larger", greatest).
numeric_cue("which is bigger", greatest).
numeric_cue("qual è il maggiore", greatest).
numeric_cue("qual è il più grande", greatest).
numeric_cue("which is smaller", least).
numeric_cue("which is less", least).
numeric_cue("qual è il minore", least).
numeric_cue("sort these numbers", ascending).
numeric_cue("sort the numbers", ascending).
numeric_cue("ordina questi numeri", ascending).
numeric_cue("in ascending order", ascending).
numeric_cue("what is the median of", median).
numeric_cue("qual è la mediana di", median).
numeric_cue("what is the remainder of", remainder).
% gen431 — il massimo comun divisore e il minimo comune multiplo, che sono due
% dei cento fallimenti (#43, #44). Costano quello che il file promette: una cue e
% una procedura. Il gcd e' gia' un operatore insegnato (`gcd_op`, gen423) e il
% mcm si COMPONE da lui, che e' il modo giusto di aggiungerlo.
numeric_cue("what is the greatest common divisor of", gcd).
numeric_cue("greatest common divisor", gcd).
numeric_cue("what is the gcd of", gcd).
numeric_cue("massimo comun divisore", gcd).
numeric_cue("what is the least common multiple of", lcm).
numeric_cue("least common multiple", lcm).
numeric_cue("minimo comune multiplo", lcm).
numeric_cue("qual è il resto di", remainder).
turn_cue_registry(numeric_cue, 1).

turn_numeric_op($Turn, $Op) :- turn_cue_form($Turn, numeric_cue, $Cue), numeric_cue($Cue, $Op).

apply_numeric(greatest, $List, $Result) :- max_list($List, $Result).
apply_numeric(least, $List, $Result) :- min_list($List, $Result).
apply_numeric(median, $List, $Result) :- median_list($List, $Result).
apply_numeric(remainder, cons($A, cons($B, nil)), $Result) :- is($Result, mod($A, $B)).
apply_numeric(gcd, cons($A, cons($B, nil)), $Result) :- apply_operator(gcd_op, $A, $B, $Result).
apply_numeric(lcm, cons($A, cons($B, nil)), $Result) :- apply_operator(gcd_op, $A, $B, $G), is($Result, div(mul($A, $B), $G)).

% L'ordinamento non produce un numero ma una LISTA, quindi ha la sua resa: il
% fold su lista del gen397, con il separatore della lingua come dato.
numeric_answer($Turn, $Text) :- turn_numeric_op($Turn, ascending), turn_number_list($Turn, $Numbers), sort_list($Numbers, $Sorted), current_language($Language), list_text($Language, $Sorted, $Text).
numeric_answer($Turn, $Text) :- turn_numeric_op($Turn, $Op), dif($Op, ascending), turn_number_list($Turn, $Numbers), apply_numeric($Op, $Numbers, $Value), current_language($Language), value_statement($Language, $Value, $Text).

turn_plan_candidate($Turn) :- numeric_answer($Turn, $Text).
turn_response($Turn, $Text) :- numeric_answer($Turn, $Text).

% ── 4. assistente utile U12 — UNA QUANTITA' PER PERIODO, PER QUANTI PERIODI ──
%
% «If I save 50 euros a month, how much will I have in two years?» murava, e con
% lui «I save 50 euros every month. How much do I save in 24 months?», mentre
% «what is 50 times 24?» rispondeva 1200 e la KB sa che un anno ha 12 mesi. Il
% conto quotidiano non chiedeva un calcolo nuovo: chiedeva di leggere tre pezzi
% gia' pubblicati — la quantita' con la sua unita', il periodo, la durata — e di
% convertire la durata nel periodo con `quantity/3`. Una cadenza nuova («a
% fortnight») e' una riga.
machinery(rate_cue).
rate_cue("a month", month).
rate_cue("every month", month).
rate_cue("per month", month).
rate_cue("each month", month).
rate_cue("a week", week).
rate_cue("every week", week).
rate_cue("per week", week).
rate_cue("a day", day).
rate_cue("every day", day).
rate_cue("per day", day).
rate_cue("a year", year).
rate_cue("every year", year).
rate_cue("al mese", month).
rate_cue("ogni mese", month).
rate_cue("a settimana", week).
rate_cue("al giorno", day).
turn_cue_registry(rate_cue, 1).
machinery(total_amount_cue).
total_amount_cue("how much").
total_amount_cue("how many").
total_amount_cue("quanto").
turn_cue_registry(total_amount_cue, 1).

machinery(duration_unit).
duration_unit(month, month).  duration_unit(months, month).
duration_unit(week, week).    duration_unit(weeks, week).
duration_unit(day, day).      duration_unit(days, day).
duration_unit(year, year).    duration_unit(years, year).
duration_unit(mese, month).   duration_unit(mesi, month).
duration_unit(anno, year).    duration_unit(anni, year).
duration_unit(settimana, week). duration_unit(settimane, week).
duration_unit(giorno, day).   duration_unit(giorni, day).

machinery(duration_word).
duration_word($W) :- duration_unit($W, $Unit).
machinery(period_factor).
period_factor($U, $U, 1).
period_factor($Big, $Small, $F) :- quantity($Big, $SmallSurface, $F), duration_unit($SmallSurface, $Small).

machinery(duration_count).
duration_count($Token, $N) :- span_number($Token, $N).
duration_count($Token, $N) :- span_atom($Token, $W), number_word($W, $N).

machinery(token_later).
token_later(pos($S, $P1), pos($S2, $P2)) :- gt($S2, $S).
token_later(pos($S, $P1), pos($S, $P2)) :- gt($P2, $P1).

% (Tre regole e argomenti raggruppati: una regola oltre KB_MAX_BODY goal, o un
% predicato oltre KB_MAX_ARGS argomenti, viene scartato senza errore — ed e' cosi'
% che la prima stesura di questa taceva.)
rate_amount($Turn, $RateUnit, pos($SA, $PA), amount($Amount, $Currency)) :-
    turn_cue_form($Turn, rate_cue, $RC), rate_cue($RC, $RateUnit),
    turn_cue_form($Turn, total_amount_cue, $Q),
    turn_span_token($Turn, $SA, $PA, $TA), span_number($TA, $Amount),
    is($PC, add($PA, 1)), turn_span_token($Turn, $SA, $PC, $TC), span_atom($TC, $Currency),
    naf(duration_word($Currency)).
rate_duration($Turn, pos($SD, $PD), duration($Count, $DurUnit)) :-
    turn_span_token($Turn, $SD, $PD, $TD), duration_count($TD, $Count),
    is($PU, add($PD, 1)), turn_span_token($Turn, $SD, $PU, $TU), span_atom($TU, $DurSurface),
    duration_unit($DurSurface, $DurUnit).
rate_total($Turn, $Total, $Currency) :-
    rate_amount($Turn, $RateUnit, $APos, amount($Amount, $Currency)),
    rate_duration($Turn, $DPos, duration($Count, $DurUnit)),
    token_later($APos, $DPos),
    period_factor($DurUnit, $RateUnit, $F),
    is($Total, mul(mul($Amount, $Count), $F)).

machinery(rate_total_text).
rate_total_text(en, $Total, $Currency, $Text) :- concat_atoms($Total, " ", $A), concat_atoms($A, $Currency, $B), concat_atoms($B, ".", $Text).
rate_total_text(it, $Total, $Currency, $Text) :- concat_atoms($Total, " ", $A), concat_atoms($A, $Currency, $B), concat_atoms($B, ".", $Text).

turn_plan_candidate($Turn) :- rate_total($Turn, $Total, $Currency).
turn_response($Turn, $Text) :- rate_total($Turn, $Total, $Currency), current_language($Language), rate_total_text($Language, $Total, $Currency, $Text).
