% numeric-questions.p0 — I NUMERI CHE IL TURNO PORTA (gen399).
%
% Dal censimento di `docs/plans/parrot0-100-failures.md`: «which is greater,
% 3.14 or 3.41?» rispondeva «I don't know about greater yet», e con lui
% l'ordinamento, il resto della divisione e la mediana. Non era una lacuna di
% CALCOLO — `is/2`, `gt/2`, `le/2` e `mod` esistono dal gen335 e `max_list/2` sta
% in `procedures.p0` da allora. Mancava il ponte: nessuna superficie portava i
% numeri del turno dentro un operatore.
%
% Il fascio si chiude una volta sola perche' il ponte e' generico: una domanda
% numerica nuova e' UNA cue piu' UNA procedura, e nessun consumer cambia. La
% sonda `failure_modes_probe.py` ha mostrato che la mossa giusta e' anche corta —
% «3.41 is greater», «2, 4, 8, 11» — quindi la resa non spiega se non le si
% chiede.

:- file_attribute(machinery).

% ── 1. LE PROCEDURE, che sono conoscenza ───────────────────────────────────
%
% `max_list/2` c'era gia'. Le altre sono la stessa specie: fold e ricorsione
% sopra i primitivi, nessuna riga di C. L'ordinamento e' un inserimento — la
% forma piu' piccola che sia ancora un ordinamento — e mediana e minimo ci si
% appoggiano invece di rifare il lavoro.
min_list(cons($X, nil), $X).
min_list(cons($H, $T), $M) :- min_list($T, $M1), le($H, $M1), is($M, $H).
min_list(cons($H, $T), $M) :- min_list($T, $M1), gt($H, $M1), is($M, $M1).

insert_sorted($X, nil, cons($X, nil)).
insert_sorted($X, cons($H, $T), cons($X, cons($H, $T))) :- le($X, $H).
insert_sorted($X, cons($H, $T), cons($H, $R)) :- gt($X, $H), insert_sorted($X, $T, $R).
sort_list(nil, nil).
sort_list(cons($H, $T), $R) :- sort_list($T, $S), insert_sorted($H, $S, $R).

nth_item(cons($H, $T), 0, $H).
nth_item(cons($H, $T), $K, $X) :- gt($K, 0), is($K1, sub($K, 1)), nth_item($T, $K1, $X).

% Con un numero pari di valori questa mediana prende quello centrale INFERIORE
% invece della media dei due: e' una scelta, e va detta. La media dei centrali
% entra il giorno in cui un caso reale la chiede, non oggi per completezza.
median_list($List, $M) :- sort_list($List, $Sorted), count_list($List, $N), is($K, div(sub($N, 1), 2)), nth_item($Sorted, $K, $M).

% ── 2. I NUMERI DEL TURNO ──────────────────────────────────────────────────
%
% `turn_span_token/4` pubblica gia' ogni parola del turno; un token e' un NUMERO
% quando l'aritmetica lo accetta, che e' lo stesso criterio che `code-plans.p0`
% usa per le obbligazioni. Non serve una classe lessicale: lo decide l'operatore
% che dovra' leggerlo.
turn_number($Turn, $Number) :- turn_span_token($Turn, $Index, $Position, $Token), span_number($Token, $Number).
turn_number_list($Turn, $Numbers) :- findall($N, turn_number($Turn, $N), $Numbers).

% ── 3. LA SUPERFICIE E L'OPERATORE ─────────────────────────────────────────
%
% Una cue nomina un operatore; l'operatore e' una procedura. Aggiungerne uno e'
% due fatti e nessun codice — ed e' il motivo per cui questo file chiude un
% fascio dei cento fallimenti invece di quattro casi.
numeric_cue("which is greater", greatest).
numeric_cue("which is larger", greatest).
numeric_cue("which is bigger", greatest).
numeric_cue("qual è il maggiore", greatest).
numeric_cue("qual è il più grande", greatest).
numeric_cue("which is smaller", least).
numeric_cue("which is less", least).
numeric_cue("qual è il minore", least).
numeric_cue("sort these numbers", ascending).
numeric_cue("sort the numbers", ascending).
numeric_cue("ordina questi numeri", ascending).
numeric_cue("in ascending order", ascending).
numeric_cue("what is the median of", median).
numeric_cue("qual è la mediana di", median).
numeric_cue("what is the remainder of", remainder).
% gen431 — il massimo comun divisore e il minimo comune multiplo, che sono due
% dei cento fallimenti (#43, #44). Costano quello che il file promette: una cue e
% una procedura. Il gcd e' gia' un operatore insegnato (`gcd_op`, gen423) e il
% mcm si COMPONE da lui, che e' il modo giusto di aggiungerlo.
numeric_cue("what is the greatest common divisor of", gcd).
numeric_cue("greatest common divisor", gcd).
numeric_cue("what is the gcd of", gcd).
numeric_cue("massimo comun divisore", gcd).
numeric_cue("what is the least common multiple of", lcm).
numeric_cue("least common multiple", lcm).
numeric_cue("minimo comune multiplo", lcm).
numeric_cue("qual è il resto di", remainder).
turn_cue_registry(numeric_cue, 1).

turn_numeric_op($Turn, $Op) :- turn_cue_form($Turn, numeric_cue, $Cue), numeric_cue($Cue, $Op).

apply_numeric(greatest, $List, $Result) :- max_list($List, $Result).
apply_numeric(least, $List, $Result) :- min_list($List, $Result).
apply_numeric(median, $List, $Result) :- median_list($List, $Result).
apply_numeric(remainder, cons($A, cons($B, nil)), $Result) :- is($Result, mod($A, $B)).
apply_numeric(gcd, cons($A, cons($B, nil)), $Result) :- apply_operator(gcd_op, $A, $B, $Result).
apply_numeric(lcm, cons($A, cons($B, nil)), $Result) :- apply_operator(gcd_op, $A, $B, $G), is($Result, div(mul($A, $B), $G)).

% L'ordinamento non produce un numero ma una LISTA, quindi ha la sua resa: il
% fold su lista del gen397, con il separatore della lingua come dato.
numeric_answer($Turn, $Text) :- turn_numeric_op($Turn, ascending), turn_number_list($Turn, $Numbers), sort_list($Numbers, $Sorted), current_language($Language), list_text($Language, $Sorted, $Text).
numeric_answer($Turn, $Text) :- turn_numeric_op($Turn, $Op), dif($Op, ascending), turn_number_list($Turn, $Numbers), apply_numeric($Op, $Numbers, $Value), current_language($Language), value_statement($Language, $Value, $Text).

turn_plan_candidate($Turn) :- numeric_answer($Turn, $Text).
turn_response($Turn, $Text) :- numeric_answer($Turn, $Text).

% ── 4. assistente utile U12 — UNA QUANTITA' PER PERIODO, PER QUANTI PERIODI ──
%
% «If I save 50 euros a month, how much will I have in two years?» murava, e con
% lui «I save 50 euros every month. How much do I save in 24 months?», mentre
% «what is 50 times 24?» rispondeva 1200 e la KB sa che un anno ha 12 mesi. Il
% conto quotidiano non chiedeva un calcolo nuovo: chiedeva di leggere tre pezzi
% gia' pubblicati — la quantita' con la sua unita', il periodo, la durata — e di
% convertire la durata nel periodo con `quantity/3`. Una cadenza nuova («a
% fortnight») e' una riga.
machinery(rate_cue).
rate_cue("a month", month).
rate_cue("every month", month).
rate_cue("per month", month).
rate_cue("each month", month).
rate_cue("a week", week).
rate_cue("every week", week).
rate_cue("per week", week).
rate_cue("a day", day).
rate_cue("every day", day).
rate_cue("per day", day).
rate_cue("a year", year).
rate_cue("every year", year).
rate_cue("al mese", month).
rate_cue("ogni mese", month).
rate_cue("a settimana", week).
rate_cue("al giorno", day).
turn_cue_registry(rate_cue, 1).
machinery(total_amount_cue).
total_amount_cue("how much").
total_amount_cue("how many").
total_amount_cue("quanto").
turn_cue_registry(total_amount_cue, 1).

machinery(duration_unit).
duration_unit(month, month).  duration_unit(months, month).
duration_unit(week, week).    duration_unit(weeks, week).
duration_unit(day, day).      duration_unit(days, day).
duration_unit(year, year).    duration_unit(years, year).
duration_unit(mese, month).   duration_unit(mesi, month).
duration_unit(anno, year).    duration_unit(anni, year).
duration_unit(settimana, week). duration_unit(settimane, week).
duration_unit(giorno, day).   duration_unit(giorni, day).

machinery(duration_word).
duration_word($W) :- duration_unit($W, $Unit).
machinery(period_factor).
period_factor($U, $U, 1).
period_factor($Big, $Small, $F) :- quantity($Big, $SmallSurface, $F), duration_unit($SmallSurface, $Small).

machinery(duration_count).
duration_count($Token, $N) :- span_number($Token, $N).
duration_count($Token, $N) :- span_atom($Token, $W), number_word($W, $N).

machinery(token_later).
token_later(pos($S, $P1), pos($S2, $P2)) :- gt($S2, $S).
token_later(pos($S, $P1), pos($S, $P2)) :- gt($P2, $P1).

% (Tre regole e argomenti raggruppati: una regola oltre KB_MAX_BODY goal, o un
% predicato oltre KB_MAX_ARGS argomenti, viene scartato senza errore — ed e' cosi'
% che la prima stesura di questa taceva.)
rate_amount($Turn, $RateUnit, pos($SA, $PA), amount($Amount, $Currency)) :-
    turn_cue_form($Turn, rate_cue, $RC), rate_cue($RC, $RateUnit),
    turn_cue_form($Turn, total_amount_cue, $Q),
    turn_span_token($Turn, $SA, $PA, $TA), span_number($TA, $Amount),
    is($PC, add($PA, 1)), turn_span_token($Turn, $SA, $PC, $TC), span_atom($TC, $Currency),
    naf(duration_word($Currency)).
rate_duration($Turn, pos($SD, $PD), duration($Count, $DurUnit)) :-
    turn_span_token($Turn, $SD, $PD, $TD), duration_count($TD, $Count),
    is($PU, add($PD, 1)), turn_span_token($Turn, $SD, $PU, $TU), span_atom($TU, $DurSurface),
    duration_unit($DurSurface, $DurUnit).
rate_total($Turn, $Total, $Currency) :-
    rate_amount($Turn, $RateUnit, $APos, amount($Amount, $Currency)),
    rate_duration($Turn, $DPos, duration($Count, $DurUnit)),
    token_later($APos, $DPos),
    period_factor($DurUnit, $RateUnit, $F),
    is($Total, mul(mul($Amount, $Count), $F)).

machinery(rate_total_text).
rate_total_text(en, $Total, $Currency, $Text) :- concat_atoms($Total, " ", $A), concat_atoms($A, $Currency, $B), concat_atoms($B, ".", $Text).
rate_total_text(it, $Total, $Currency, $Text) :- concat_atoms($Total, " ", $A), concat_atoms($A, $Currency, $B), concat_atoms($B, ".", $Text).

turn_plan_candidate($Turn) :- rate_total($Turn, $Total, $Currency).
turn_response($Turn, $Text) :- rate_total($Turn, $Total, $Currency), current_language($Language), rate_total_text($Language, $Total, $Currency, $Text).

% ── 5. mix 13×08 — QUANTE COSE HANNO N ESEMPLARI ────────────────────────────
%
% «how many legs do three spiders have?» riceveva «A spider has 8 legs.»: il
% numero chiesto spariva, e la risposta sembrava giusta. La quantita' per
% esemplare e' un fatto vero (`quantity(spider, legs, 8)`), il conto e' una
% moltiplicazione: servono il numero del turno, la cosa che lo segue (anche al
% plurale) e l'unita' nominata. «how many days are in two weeks?» e' la stessa
% forma letta dall'altro lato: «in N <cosa>».
machinery(counted_thing).
counted_thing($Word, $Thing) :- quantity($Word, $Unit, $K).
counted_thing($Word, $Thing) :- lemma_candidate($Word, $Thing), quantity($Thing, $Unit, $K).

count_total($Turn, $Total, counted($N, $Word, $Unit, $K)) :-
    turn_cue_form($Turn, total_amount_cue, $Q),
    turn_span_token($Turn, $S, $P, $TN), duration_count($TN, $N), gt($N, 1),
    is($P1, add($P, 1)), turn_span_token($Turn, $S, $P1, $TW), span_atom($TW, $Word),
    counted_thing($Word, $Thing), quantity($Thing, $Unit, $K),
    turn_span_token($Turn, $S2, $PU, $TU), span_atom($TU, $Unit),
    is($Total, mul($N, $K)).

machinery(count_total_text).
count_total_text(en, $Total, counted($N, $Word, $Unit, $K), $Text) :-
    concat_atoms($Total, " ", $A), concat_atoms($A, $Unit, $B), concat_atoms($B, ": ", $C),
    concat_atoms($C, $N, $D), concat_atoms($D, " ", $E), concat_atoms($E, $Word, $F),
    concat_atoms($F, " with ", $G), concat_atoms($G, $K, $H), concat_atoms($H, " ", $I),
    concat_atoms($I, $Unit, $J), concat_atoms($J, " each.", $Text).
count_total_text(it, $Total, counted($N, $Word, $Unit, $K), $Text) :-
    concat_atoms($Total, ".", $Text).

turn_plan_candidate($Turn) :- count_total($Turn, $Total, $How).
turn_response($Turn, $Text) :- count_total($Turn, $Total, $How), current_language($Language), count_total_text($Language, $Total, $How, $Text).

% ── 6. mix 13×15 — QUANTO CONSUMA E QUANTO COSTA UN APPARECCHIO ─────────────
%
% «how much does it cost to run a 2000 watt heater for 3 hours at 0.25 euros per
% kwh?» rispondeva «1996.75.», e «how many kwh does a 2000 watt heater use in 3
% hours?» «1997.»: un'aritmetica sui numeri del turno presi alla rinfusa, cioe' un
% numero falso detto con sicurezza. Ogni numero ha un RUOLO che la parola dopo
% dichiara: la potenza (watt), la durata (ore), il prezzo (valuta … per kWh). La
% conoscenza e' una riga vera: un kilowattora sono mille watt per un'ora.
machinery(power_word).
power_word(watt).
power_word(watts).
power_word(w).
machinery(energy_unit_word).
energy_unit_word(kwh).
machinery(watts_per_kwh_hour).
watts_per_kwh_hour(1000).

machinery(turn_role_number).
turn_role_number($Turn, power, $N) :- turn_word($Turn, $I, $W), span_number($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $U), power_word($U).
turn_role_number($Turn, hours, $N) :- turn_word($Turn, $I, $W), duration_count_word($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $U), hours_word($U).
turn_role_number($Turn, price, $N) :- turn_word($Turn, $I, $W), span_number($W, $N), is($J, add($I, 2)), turn_word($Turn, $J, $Per), per_word($Per), is($K, add($I, 3)), turn_word($Turn, $K, $E), energy_unit_word($E).
machinery(per_word).
per_word(per).
per_word(a).
machinery(turn_currency).
turn_currency($Turn, $C) :- turn_word($Turn, $I, $W), span_number($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $C), is($K, add($I, 2)), turn_word($Turn, $K, $Per), per_word($Per).

machinery(energy_kwh).
energy_kwh($Turn, $KWh) :- turn_role_number($Turn, power, $W), turn_role_number($Turn, hours, $H), watts_per_kwh_hour($K), is($KWh, div(mul($W, $H), $K)).

machinery(energy_answer).
energy_answer($Turn, $Text) :-
    turn_role_number($Turn, price, $P), energy_kwh($Turn, $KWh), turn_currency($Turn, $C), is($Cost, mul($KWh, $P)),
    concat_atoms($Cost, " ", $A), concat_atoms($A, $C, $B), concat_atoms($B, ": ", $D), concat_atoms($D, $KWh, $E),
    concat_atoms($E, " kWh at ", $F), concat_atoms($F, $P, $G), concat_atoms($G, " per kWh.", $Text).
energy_answer($Turn, $Text) :-
    naf(turn_has_price($Turn)), energy_kwh($Turn, $KWh), turn_role_number($Turn, power, $W), turn_role_number($Turn, hours, $H),
    concat_atoms($KWh, " kWh: ", $A), concat_atoms($A, $W, $B), concat_atoms($B, " watts for ", $D), concat_atoms($D, $H, $E),
    concat_atoms($E, " hours.", $Text).
machinery(turn_has_price).
turn_has_price($Turn) :- turn_role_number($Turn, price, $P).

turn_plan_candidate($Turn) :- energy_kwh($Turn, $KWh).
turn_response($Turn, $Text) :- energy_answer($Turn, $Text).

% ── 7. mix 15×13 — QUALE CONFEZIONE CONVIENE ────────────────────────────────
%
% «which is cheaper: 750 g for 3 euros or 1 kg for 3.80 euros?» murava su
% «cheaper». Il confronto giusto non e' fra i prezzi ma fra i prezzi per la stessa
% quantita': si porta ogni offerta all'unita' di base (grammi, millilitri) con un
% fatto vero di conversione, e si confronta il prezzo per unita'. Le due offerte
% sono due gruppi «N <unita'> for P <valuta>» nel turno, in ordine.
machinery(base_unit).
base_unit(g, g, 1).  base_unit(grams, g, 1).  base_unit(gram, g, 1).
base_unit(kg, g, 1000).  base_unit(kilo, g, 1000).  base_unit(kilos, g, 1000).  base_unit(kilograms, g, 1000).
base_unit(ml, ml, 1).  base_unit(milliliters, ml, 1).
base_unit(l, ml, 1000).  base_unit(liter, ml, 1000).  base_unit(liters, ml, 1000).  base_unit(litre, ml, 1000).  base_unit(litres, ml, 1000).

machinery(deal_cue).
deal_cue("which is cheaper").
deal_cue("better deal").
deal_cue("better value").
deal_cue("conviene di piu'").
turn_cue_registry(deal_cue, 1).

machinery(turn_offer).
turn_offer($Turn, offer($I, $Q, $U, $P)) :-
    turn_word($Turn, $I, $W), span_number($W, $Q), is($J, add($I, 1)), turn_word($Turn, $J, $U), base_unit($U, $B, $F),
    is($K, add($I, 2)), turn_word($Turn, $K, for), is($L, add($I, 3)), turn_word($Turn, $L, $PW), span_number($PW, $P).

machinery(offer_price_per).
offer_price_per(offer($I, $Q, $U, $P), $Base, $PerUnit) :- base_unit($U, $Base, $F), is($PerUnit, div($P, mul($Q, $F))).

machinery(deal_pair).
deal_pair($Turn, $O1, $O2) :-
    turn_cue_form($Turn, deal_cue, $Cue), turn_offer($Turn, $O1), turn_offer($Turn, $O2),
    offer_index($O1, $I1), offer_index($O2, $I2), lt($I1, $I2),
    offer_price_per($O1, $B, $P1), offer_price_per($O2, $B, $P2).
machinery(offer_index).
offer_index(offer($I, $Q, $U, $P), $I).

machinery(offer_text).
offer_text(offer($I, $Q, $U, $P), $T) :- concat_atoms($Q, " ", $A), concat_atoms($A, $U, $B), concat_atoms($B, " for ", $C), concat_atoms($C, $P, $T).
% Un prezzo si dice al centesimo. Non c'e' un arrotondamento nell'aritmetica: `mod`
% lavora sugli interi, quindi la parte intera di N e' mod(N, 10^9) per i prezzi.
machinery(cents).
cents($X, $R) :- is($R, div(mod(add(mul($X, 100), 0.5), 1000000000), 100)).
machinery(per_kilo_text).
per_kilo_text($O, $T) :- offer_price_per($O, g, $PG), is($PK, mul($PG, 1000)), cents($PK, $C), concat_atoms($C, " per kilo", $T).
per_kilo_text($O, $T) :- offer_price_per($O, ml, $PM), is($PL, mul($PM, 1000)), cents($PL, $C), concat_atoms($C, " per liter", $T).

machinery(deal_answer).
deal_answer($Turn, $Text) :- deal_pair($Turn, $O1, $O2), deal_winner(pair($O1, $O2), $Win, $Lose), deal_text($Win, $Lose, $Text).
machinery(deal_text).
deal_text($Win, $Lose, $Text) :-
    offer_text($Win, $WT), per_kilo_text($Win, $WK), per_kilo_text($Lose, $LK),
    concat_atoms($WT, " is cheaper: ", $A), concat_atoms($A, $WK, $B2), concat_atoms($B2, " against ", $C), concat_atoms($C, $LK, $D), concat_atoms($D, ".", $Text).
machinery(deal_winner).
deal_winner(pair($O1, $O2), $O1, $O2) :- offer_price_per($O1, $B, $P1), offer_price_per($O2, $B, $P2), lt($P1, $P2).
deal_winner(pair($O1, $O2), $O2, $O1) :- offer_price_per($O1, $B, $P1), offer_price_per($O2, $B, $P2), lt($P2, $P1).

turn_plan_candidate($Turn) :- deal_pair($Turn, $O1, $O2).
turn_response($Turn, $Text) :- deal_answer($Turn, $Text).

% ── 8. mix 13×08 — LE TAZZE IN GRAMMI, PER INGREDIENTE ──────────────────────
% «how many grams are 2 cups of flour?» — una tazza di farina non pesa come una
% di zucchero: il peso per tazza e' conoscenza insegnata parlando (King Arthur
% Baking) e il conto e' una moltiplicazione. Le frazioni dette a parole («half a
% cup») sono una riga.
machinery(cup_word).
cup_word(cup).
cup_word(cups).
machinery(cup_count).
cup_count($Turn, $N) :- turn_word($Turn, $I, $W), span_number($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $C), cup_word($C).
cup_count($Turn, $N) :- turn_word($Turn, $I, $W), number_word($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $C), cup_word($C).
cup_count($Turn, 0.5) :- turn_word($Turn, $I, half), is($J, add($I, 1)), turn_word($Turn, $J, a), is($K, add($I, 2)), turn_word($Turn, $K, cup).
machinery(grams_cue).
grams_cue("how many grams").
grams_cue("in grams").
grams_cue("quanti grammi").
turn_cue_registry(grams_cue, 1).
machinery(cup_grams_answer).
cup_grams_answer($Turn, $Text) :-
    turn_cue_form($Turn, grams_cue, $Q), cup_count($Turn, $N), turn_word($Turn, $Ing), cup_grams($Ing, $G),
    is($Total, mul($N, $G)), cents($Total, $T),
    concat_atoms($T, " grams: a cup of ", $A), concat_atoms($A, $Ing, $B), concat_atoms($B, " weighs ", $C),
    concat_atoms($C, $G, $D), concat_atoms($D, " grams.", $Text).
turn_plan_candidate($Turn) :- cup_grams_answer($Turn, $Text).
turn_response($Turn, $Text) :- cup_grams_answer($Turn, $Text).

% ── 9. mix 13×15×12 — UNA MISURA CONTRO L'INTERVALLO RACCOMANDATO ───────────
% «the humidity in my bedroom is 70 percent, is that a problem?» — la grandezza
% nominata nel turno (una parola della chiave insegnata, «humidity»), il numero con
% «percent» o «%», e l'intervallo insegnato. Sopra o sotto: si dice di quanto e con
% che conseguenza nota; dentro: si dice che e' nell'intervallo.
machinery(percent_word).
percent_word(percent).
percent_word("%").
percent_word(per).
machinery(turn_percent).
turn_percent($Turn, $N) :- turn_word($Turn, $I, $W), span_number($W, $N), is($J, add($I, 1)), turn_word($Turn, $J, $P), percent_word($P).
machinery(turn_range).
turn_range($Turn, range($Said, $Lo, $Hi)) :- recommended_percent_range($Said, $Lo, $Hi), atom_words($Said, $Ws), member($W, $Ws), turn_word($Turn, $I, $W), dif($W, indoor).
% «my hygrometer says the humidity is 45 percent» ha la copula e nessun «?»: senza
% questa vista cedeva come prosa e il lettore delle grandezze salvava
% `has(my_hygrometer_says_the_humidity, 45 percent)`. Letta sui token di superficie,
% disponibili quando la forza del turno si materializza.
machinery(turn_has_range_surface).
turn_has_range_surface($Turn) :-
    recommended_percent_range($Said, $Lo, $Hi), atom_words($Said, $Ws), member($W, $Ws), dif($W, indoor),
    turn_word($Turn, $I, $W), turn_word($Turn, $J, $N), span_number($N, $V), is($K, add($J, 1)), turn_word($Turn, $K, $P), percent_word($P).
machinery(range_verdict).
range_verdict($Turn, above($R, $N)) :- turn_range($Turn, $R), turn_percent($Turn, $N), range_high($R, $Hi), gt($N, $Hi).
range_verdict($Turn, below($R, $N)) :- turn_range($Turn, $R), turn_percent($Turn, $N), range_low($R, $Lo), lt($N, $Lo).
range_verdict($Turn, inside($R, $N)) :- turn_range($Turn, $R), turn_percent($Turn, $N), range_low($R, $Lo), range_high($R, $Hi), ge($N, $Lo), le($N, $Hi).
machinery(range_low).
range_low(range($S, $Lo, $Hi), $Lo).
machinery(range_high).
range_high(range($S, $Lo, $Hi), $Hi).
machinery(range_answer).
range_answer(above(range($S, $Lo, $Hi), $N), $Text) :-
    words_of($S, $ST), concat_atoms("That is high: ", $ST, $A), concat_atoms($A, " should stay between ", $B), concat_atoms($B, $Lo, $C),
    concat_atoms($C, " and ", $D), concat_atoms($D, $Hi, $E), concat_atoms($E, " percent, and ", $F), concat_atoms($F, $N, $G),
    concat_atoms($G, " is above that.", $H), range_consequence($S, above, $Tail), concat_atoms($H, $Tail, $Text).
range_answer(below(range($S, $Lo, $Hi), $N), $Text) :-
    words_of($S, $ST), concat_atoms("That is low: ", $ST, $A), concat_atoms($A, " should stay between ", $B), concat_atoms($B, $Lo, $C),
    concat_atoms($C, " and ", $D), concat_atoms($D, $Hi, $E), concat_atoms($E, " percent, and ", $F), concat_atoms($F, $N, $G),
    concat_atoms($G, " is below that.", $Text).
range_answer(inside(range($S, $Lo, $Hi), $N), $Text) :-
    words_of($S, $ST), concat_atoms("That is fine: ", $N, $A), concat_atoms($A, " percent is inside the recommended ", $B),
    concat_atoms($B, $Lo, $C), concat_atoms($C, " to ", $D), concat_atoms($D, $Hi, $E), concat_atoms($E, " percent for ", $F),
    concat_atoms($F, $ST, $G), concat_atoms($G, ".", $Text).
% La conseguenza nota di stare sopra: cio' che l'umidita' alta causa, insegnato
% parlando («high humidity causes mold»; ⚠ non «mould»: e' anche il nome del verbo
% «to mould» e la lezione cade nel lettore sbagliato).
machinery(range_consequence).
range_consequence($S, above, $T) :- atom_words($S, $Ws), member(humidity, $Ws), causes(high_humidity, $E), words_of($E, $ET), concat_atoms(" High humidity causes ", $ET, $A), concat_atoms($A, ".", $T).
range_consequence($S, above, "") :- naf(humidity_consequence_known($S)).
machinery(humidity_consequence_known).
humidity_consequence_known($S) :- atom_words($S, $Ws), member(humidity, $Ws), causes(high_humidity, $E).

turn_plan_candidate($Turn) :- range_verdict($Turn, $V).
turn_response($Turn, $Text) :- range_verdict($Turn, $V), range_answer($V, $Text).
