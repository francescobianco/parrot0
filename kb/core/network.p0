% ── 10. L'OFFERTA APERTA E' IL CONTESTO DEL TURNO DOPO (gen506f) ────────────
% F., in chat: «parlami dei plc» -> «Vuoi che cerchi?» -> «certo» -> «Ricevuto
% — che cosa vuoi fare?»; «una panoramica generale» -> «Non capisco»; «dimmi
% qualsiasi cosa sai sui plc» -> «Non sono sicuro di aver seguito»; «plc» ->
% «Non capisco». Quattro modi di dire «si'» a QUELLA domanda, e nessuno lo
% era, perche' il «si'» stava in una catena di classi compilate e il turno
% non rivendicato andava al muro come se l'offerta non esistesse.
%
% Qui la risoluzione e' UNA lettura del frame del turno, come le altre forze:
% le parole di assenso e dissenso sono cue pubblicate (`turn_cue`), rinominare
% il tema dell'offerta e' accettarla, e un turno che nessuna facolta' sa
% servire, sotto un'offerta aperta, la accetta — a meno di un dissenso. Il C
% chiede `offer_resolution(current_turn, accept|refuse)` e
% `offer_unclaimed_turn(accept)`; una parola nuova o una politica diversa
% («se non dico si' non cercare») e' una riga, o una lezione.
turn_cue_registry(assent_word, 1).
turn_cue_registry(dissent_word, 1).
machinery(offer_resolution).
machinery(offer_unclaimed_turn).
offer_resolution($T, refuse) :- turn_cue($T, dissent_word, $W).
offer_resolution($T, accept) :- turn_cue($T, assent_word, $W), naf(offer_resolution($T, refuse)).
% (`pending_gap` e' dal gen506i una vista del tabellone: l'offerta aperta e'
% `open_issue(gap_offer_<tema>, gap_offer)` in issues.p0.) ⚠ Residuo misurato
% al gen506i: un turno DICHIARATIVO che nomina il tema («zorbia is in europe»
% sotto «vuoi che cerchi zorbia?») passa di qui come assenso e fa partire una
% lettura; la forma giusta e' `move_addresses(T, Issue, answer|unrelated)`
% quando la forza del turno non e' un assenso (dialogica L2, incremento I2).
offer_resolution($T, accept) :-
    pending_gap($Topic), input_node_atom($T, $Id, $Topic), turn_short_reply($T),
    naf(offer_resolution($T, refuse)).
% gen510 — il residuo qui sopra, misurato insegnando: «a battle involves a
% winner» sotto un'offerta su «winner», e «photon is defined as the elementary
% particle of light» sotto una su «photon», valevano come assenso — partiva una
% ricerca, e la LEZIONE era persa (report gen509, NL3 e NL4). Chi risponde a
% un'offerta nominandone il tema lo fa in poche parole; una frase lunga che lo
% nomina sta dicendo altro. Quante parole bastano e' una politica, non C.
machinery(turn_short_reply).
machinery(offer_reply_max_words).
offer_reply_max_words(3).
turn_short_reply($T) :-
    findall($I, input_node_atom($T, $I, $A), $L), list_len($L, $N),
    offer_reply_max_words($M), le($N, $M).
offer_unclaimed_turn(accept).
conduct_lesson1("non cercare se non dico di si", offer_unclaimed_turn, ask).
conduct_lesson1("don't look things up unless i say yes", offer_unclaimed_turn, ask).
conduct_lesson_reply(offer_unclaimed_turn, ask, "Understood: I'll look things up only when you say yes.").

% ── 11. LA SCELTA SI LEGGE SUL FRAME, E LA RISPOSTA PARZIALE RESTRINGE (gen506h) ─
% Le parole di ogni opzione sono cue del turno (`option_word(Parola, Tema, N)`,
% scritte dal motore con le opzioni — ancora fuori dal tabellone: la forma di
% arrivo e' `issue_option_word(Issue, N, Parola)`, C_TODO); un'opzione e' «colpita» se una sua
% parola sta nel turno. Una colpita: scelta. Piu' d'una: la lista si
% restringe e si richiede (dialogica.md L3). E un turno che il frame legge
% come DOMANDA non viene catturato da una questione aperta che non indirizza:
% si risponde per se', la questione resta (L4).
turn_cue_registry(option_word, 1).
machinery(option_word).
machinery(option_hit).
machinery(option_hit_word).
machinery(unclaimed_turn_captured).
option_hit_word($Topic, $N, $W) :- option_word($W, $Topic, $N), turn_cue(current_turn, option_word, $W), naf(stopword($W)), turn_short_reply(current_turn).
option_hit($Topic, $N) :- option_hit_word($Topic, $N, $W).

% gen510 — un turno che nomina una relazione porta la PROPRIA relazione: non
% eredita quella del discorso (il ramo ellittico di `mod_answer_frame`).
machinery(turn_names_relation).
turn_names_relation($T) :- input_node_atom($T, $Id, $W), relation_verb($W).
turn_names_relation($T) :- input_node_atom($T, $Id, $W), relation_noun($P, $W).
turn_names_relation($T) :- input_node_atom($T, $Id, $W), family_relation($W).
unclaimed_turn_captured($Kind) :- naf(turn_illocution(current_turn, question)).

