response_template(dialogue_form_assert, "I will read that expression with the intention you named.").
response_template(dialogue_form_assert, it, "Leggerò quella espressione con l intenzione che hai indicato.").
response_template(dialogue_form_retract, "I have withdrawn that reading of the expression.").
response_template(dialogue_form_retract, it, "Ho ritirato quella lettura dell espressione.").

