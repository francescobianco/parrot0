% Meta-comprensione: insegnare e ritirare aperture con nomi pronunciabili.
turn_form(teach_dialogue_opening, 1, text("when i say")).
turn_form(teach_dialogue_opening, 2, span(surface)).
turn_form(teach_dialogue_opening, 3, text("i mean")).
turn_form(teach_dialogue_opening, 4, named(dialogue_act_name, act)).
turn_form_view(teach_dialogue_opening, said).
turn_form_priority(teach_dialogue_opening, early).
turn_form_act(teach_dialogue_opening, "op(assert, dialogue_opening, [surface, act])").
turn_form_reply(teach_dialogue_opening, dialogue_form_assert).
turn_form(forget_dialogue_opening, 1, text("forget that when i say")).
