% Branching act-loop operation vocabulary (gen467). Surface, primitive symbol
% and factor are one teachable relation; the parser does not own these words.
machinery(agent_branch_step).
agent_branch_step("double", "*", 2).
agent_branch_step("raddoppia", "*", 2).
agent_branch_step("triple", "*", 3).
agent_branch_step("triplica", "*", 3).
agent_branch_step("halve", "/", 2).
agent_branch_step("dimezza", "/", 2).
agent_branch_step("add", "+", 0).
agent_branch_step("plus", "+", 0).
agent_branch_step("aggiungi", "+", 0).
agent_branch_step("somma", "+", 0).
agent_branch_step("subtract", "-", 0).
agent_branch_step("minus", "-", 0).
agent_branch_step("sottrai", "-", 0).
agent_branch_step("togli", "-", 0).
agent_branch_step("multiply", "*", 0).
agent_branch_step("times", "*", 0).
agent_branch_step("moltiplica", "*", 0).
agent_branch_step("divide", "/", 0).
machinery(agent_parity_marker).
agent_parity_marker(even, "even"). agent_parity_marker(even, "pari").
agent_parity_marker(odd, "odd"). agent_parity_marker(odd, "dispari").
machinery(search_using_marker).
search_using_marker("using"). search_using_marker("usando").
machinery(search_reach_marker).
search_reach_marker("reach"). search_reach_marker("raggiungere").
machinery(search_make_marker).
search_make_marker("make"). search_make_marker("arrivare a").
machinery(search_get_to_marker).
search_get_to_marker("get to"). search_get_to_marker("ottenere").
agent_branch_step("dividi", "/", 0).
agent_branch_step("diviso", "/", 0).
apply_operator(divide, $A, $B, $R) :- dif($B, 0), is($R, div($A, $B)).
% NIENTE «x» per la moltiplicazione: in questo sistema `x` e' la variabile
% dell'algebra, e dichiararla operatore faceva leggere «10 / x = 0» come una
% moltiplicazione (misurato: algebra.p0t rispondeva 0 invece di declinare).
% Un simbolo che ha gia' un mestiere non ne prende un secondo.

apply_operator(plus,  $A, $B, $R) :- is($R, add($A, $B)).
apply_operator(minus, $A, $B, $R) :- is($R, sub($A, $B)).
apply_operator(times, $A, $B, $R) :- is($R, mul($A, $B)).

% E la prova che sia davvero insegnabile: due operatori VERI che il motore non
% conosce e non calcolera' mai in C. Esistono perche' lo dicono queste righe, e
% nient'altro.
%
% Il massimo comun divisore e' l'esempio migliore che ci sia: e' ricorsivo, quindi
% non lo si puo' fingere con una formula, e nessun `case` del C lo contiene.
infix_operator("gcd", gcd_op).
apply_operator(gcd_op, $A, 0, $A).
apply_operator(gcd_op, $A, $B, $R) :- gt($B, 0), is($M, mod($A, $B)), apply_operator(gcd_op, $B, $M, $R).

% E la media, che e' una composizione: somma e poi divide.
infix_operator("avg", avg_op).
apply_operator(avg_op, $A, $B, $R) :- is($R, div(add($A, $B), 2)).
% Surface forms that open an induction request. The consumer only keeps the
% operational kind and the matched span; new language forms are KB data.
machinery(induce_query_phrase).
induce_query_phrase("continue from", continue).
induce_query_phrase("continua da", continue).
induce_query_phrase("what comes after", next).
induce_query_phrase("cosa viene dopo", next).
induce_query_phrase("apply it to", next).
induce_query_phrase("applicala a", next).
induce_query_phrase("what is the rule", rule).
induce_query_phrase("what's the rule", rule).
induce_query_phrase("qual è la regola", rule).
induce_query_phrase("quale regola", rule).
induce_query_phrase("che regola", rule).
