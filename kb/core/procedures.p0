format_realizer(numbered, numbered_lines).

% ── gen494 — IL FORMATO DI UN RISULTATO E' CONOSCENZA, ANCHE PER I TOOL ─────
%
% F.: «e poi ti processa il risultato, e se gli chiedi "dammi la lista dei file
% in formato markdown" lui lo sa fare per inferenza con la conoscenza».
%
% Lo strato dei formati esisteva (`format_constraint/2` + `format_realizer/2`) ma
% serviva solo i piani di analisi: l'uscita di uno strumento tornava sempre nella
% stessa forma, una riga sola separata da spazi. Qui la stessa conoscenza governa
% anche quella — un formato nuovo e' un fatto, non un ramo nel modulo dei tool.
%
% `format_line_prefix/2` e' il pezzo che mancava: dice CON CHE COSA si apre ogni
% elemento. Il motore sa spezzare un elenco e mettere un prefisso; non sa che
% «-» sia markdown, e non deve saperlo.
format_constraint(markdown_list, "in markdown").
format_constraint(markdown_list, "formato markdown").
format_constraint(markdown_list, "as markdown").
format_constraint(markdown_list, "markdown format").
format_constraint(bulleted, "elenco puntato").
format_constraint(bulleted, "puntato").
format_constraint(bulleted, "come elenco").
format_constraint(bulleted, "bullet list").
format_constraint(bulleted, "as a bulleted list").
format_constraint(bulleted, "punto elenco").

format_realizer(markdown_list, line_prefix).
format_realizer(bulleted, line_prefix).

machinery(format_line_prefix).
format_line_prefix(markdown_list, "- ").
format_line_prefix(bulleted, "- ").

% gen335+: meta-knowledge layer (L4-L12 saturation).
:- include(meta.p0).

% ── gen362: la frase analitica si COSTRUISCE, non si deposita ────────────────
% F.: "la prosa lunga nei predicati va tradotta in predicati in costruzione,
% relazioni e regole di inferenza". Una frase-paragrafo memorizzata è un
% frasario con un nome migliore: non si ricombina, non si interroga, e un atto
% nuovo non ne può riusare metà. Qui la frase di apertura è DERIVATA da:
%
%   act_move(Act, Gerundio)        il movimento cognitivo dell'atto
%   analysis_lens(Act, Lente)      le dimensioni attraverso cui l'atto ragiona
%   lens_gloss(Lente, "frase")     una lente glossata UNA volta, riusata da
%                                  ogni atto che la prende in prestito
%   atom_frame(Facet, superficie)  la superficie con gli slot
%   atom_slot(Slot, forma)         come si risolve lo slot (unaria o serie)
%
% La leva è il prodotto: lenti x atti. `constraint`, `failure_mode`,
% `reversibility` sono glossate una sola volta e valgono per design, rischio e
% impatto insieme. Aggiungere una dimensione a un atto è UN fatto.
machinery(act_move).
machinery(analysis_lens).
machinery(lens_gloss).
machinery(atom_frame).
machinery(atom_slot).
machinery(list_frame).

atom_frame(framing, "On {subject}, {move} turns on {lenses}.").
atom_slot(move, unary(act_move)).
atom_slot(lenses, series(analysis_lens, lens_gloss)).
list_frame(series, ", ", " and ").

act_move(impact_analysis, "a consequence analysis").
act_move(design_analysis, "a workable design").
act_move(mechanism_analysis, "a causal account").
act_move(ethical_analysis, "an ethical judgement").
act_move(investigation_analysis, "a sound investigation").
act_move(risk_analysis, "a risk assessment").
act_move(interpretive_analysis, "a close reading").
act_move(comparison_analysis, "a useful comparison").
act_move(advice_analysis, "a defensible recommendation").

% Le lenti: ogni atto dichiara le proprie, e le condivide con gli altri.
analysis_lens(design_analysis, objective).
analysis_lens(design_analysis, constraint).
analysis_lens(design_analysis, failure_mode).
analysis_lens(impact_analysis, baseline).
analysis_lens(impact_analysis, adaptation).
analysis_lens(impact_analysis, distribution).
analysis_lens(mechanism_analysis, trigger).
analysis_lens(mechanism_analysis, intermediate).
analysis_lens(mechanism_analysis, observable).
analysis_lens(ethical_analysis, beneficiary).
analysis_lens(ethical_analysis, exposure).
analysis_lens(ethical_analysis, refusal).
analysis_lens(investigation_analysis, rival_account).
analysis_lens(investigation_analysis, discriminating_test).
analysis_lens(investigation_analysis, provenance).
analysis_lens(risk_analysis, hazard_source).
analysis_lens(risk_analysis, exposure).
analysis_lens(risk_analysis, reversibility).
analysis_lens(interpretive_analysis, premise).
analysis_lens(interpretive_analysis, formal_choice).
analysis_lens(interpretive_analysis, tension).
analysis_lens(comparison_analysis, shared_baseline).
analysis_lens(comparison_analysis, dimension).
analysis_lens(comparison_analysis, scale).
analysis_lens(advice_analysis, objective).
analysis_lens(advice_analysis, option_set).
analysis_lens(advice_analysis, uncertainty).

% Le glosse: frammenti corti, indipendenti, riusabili da qualunque atto.
lens_gloss(objective, "what would count as success").
lens_gloss(constraint, "what cannot be violated").
lens_gloss(failure_mode, "how it fails in practice").
lens_gloss(baseline, "what the situation looks like unchanged").
lens_gloss(adaptation, "how people and systems adjust once it holds").
lens_gloss(distribution, "who gains and who absorbs the cost").
lens_gloss(trigger, "the condition that starts it").
lens_gloss(intermediate, "the process that carries it").
lens_gloss(observable, "the effect one could actually measure").
lens_gloss(beneficiary, "who gains").
lens_gloss(exposure, "who is exposed to the harm").
lens_gloss(refusal, "who is able to refuse").
lens_gloss(rival_account, "the competing explanations").
lens_gloss(discriminating_test, "the observation that separates them").
lens_gloss(provenance, "the chain of evidence behind each claim").
lens_gloss(hazard_source, "where the harm originates").
lens_gloss(reversibility, "whether the outcome can be undone").
lens_gloss(premise, "the premise it commits to").
lens_gloss(formal_choice, "the formal choices that carry it").
lens_gloss(tension, "the tension it refuses to resolve").
lens_gloss(shared_baseline, "the baseline both share").
lens_gloss(dimension, "the dimensions worth holding fixed").
lens_gloss(scale, "the difference scale alone would explain").
lens_gloss(option_set, "the genuinely distinct options").
lens_gloss(uncertainty, "what remains uncertain").

% ── gen363: la faccetta GROUNDING ───────────────────────────────────────────
% gen362 sosteneva che la specificità fosse una sostituzione: lega il soggetto
% negli atomi di metodo e la risposta diventa "sul" soggetto. Il giudice l'ha
% smentito 19 volte su 20 in un solo run ("generic template that names the topic
% but never discusses it"). LEGARE NON È FONDARE.
%
% Questa faccetta chiede al piano di dire ciò che parrot0 SA davvero dei termini
% del soggetto, proiettato lungo una relazione dichiarata. È `optional` di
% proposito: additiva (F.: strutture secondarie, niente potatura anticipata),
% quindi dove la conoscenza esiste la risposta diventa specifica e dove non
% esiste il piano resta quello di prima. Il moltiplicatore è
% relazioni x concetti: fondare domani lungo `because` o `difference_between` è
% una riga, zero C.
atom_frame(grounding, "{knowledge}").
atom_slot(knowledge, grounded(semantic_summary)).

% Ordine -1: se parrot0 sa qualcosa del soggetto, quella conoscenza APRE la
% risposta. Il giudice legge l'inizio; aprire con il metodo e nascondere il
% contenuto a meta e' il motivo per cui piu risposte corrette sono state lette
% come "templated dodge". L'ordine e' un fatto: si cambia senza ricompilare.
answer_plan(impact_analysis, grounding, -1, optional).
answer_plan(design_analysis, grounding, -1, optional).
answer_plan(mechanism_analysis, grounding, -1, optional).
answer_plan(ethical_analysis, grounding, -1, optional).
answer_plan(investigation_analysis, grounding, -1, optional).
answer_plan(risk_analysis, grounding, -1, optional).
answer_plan(interpretive_analysis, grounding, -1, optional).
answer_plan(comparison_analysis, grounding, -1, optional).
answer_plan(advice_analysis, grounding, -1, optional).

% ── gen366: REASONING OPERATOR R1 — goal-conditioned comparison ─────────────
%
% These are transformations, not answer rows.  `property/3` and
% `goal_prefers/3` live in world files; the conclusions below are absent from
% the fact base and must be proven by the resolver.  The activation fact makes
% rule ablation executable at runtime without deleting source.
reasoning_operator_active(goal_comparison).

task_difference($X, $Y, $Dimension, pair($VX, $VY)) :-
    reasoning_operator_active(goal_comparison),
    effective_property($X, $Dimension, $VX),
    effective_property($Y, $Dimension, $VY),
    dif($VX, $VY).

task_goal_match($Candidate, $Goal, $Dimension, $Value) :-
    reasoning_operator_active(goal_comparison),
    effective_goal_prefers($Goal, $Dimension, $Value),
    effective_property($Candidate, $Dimension, $Value).

% Open terms inherit only relations explicitly attached to one of their
% compositional concepts.  "linen_shirt" may therefore reuse a property of
% linen without an entity cue or a fact naming linen_shirt.
effective_property($Entity, $Dimension, $Value) :-
    property($Entity, $Dimension, $Value).

effective_property($Entity, $Dimension, $Value) :-
    task_term_concept($Entity, $Concept),
    property($Concept, $Dimension, $Value).

effective_goal_prefers($Goal, $Dimension, $Value) :-
    goal_prefers($Goal, $Dimension, $Value).

effective_goal_prefers($Goal, $Dimension, $Value) :-
    task_term_concept($Goal, $Concept),
    goal_prefers($Concept, $Dimension, $Value).

% R2 — explain a system's vulnerability as a reusable trade-off:
% a normally useful strategy has a failure condition that a phenomenon exploits.
reasoning_operator_active(failure_explanation).

failure_mechanism($System, $Phenomenon, $Strategy, $Condition) :-
    reasoning_operator_active(failure_explanation),
    effective_system_relies_on($System, $Strategy),
    strategy_failure_condition($Strategy, $Condition),
    effective_phenomenon_exploits($Phenomenon, $Condition).

normal_strategy_benefit($System, $Strategy, $Benefit) :-
    reasoning_operator_active(failure_explanation),
    effective_system_relies_on($System, $Strategy),
    strategy_benefit($Strategy, $Benefit).

failure_example($Phenomenon, $Example, $Relation, $Object) :-
    reasoning_operator_active(failure_explanation),
    effective_phenomenon_example($Phenomenon, $Example),
    example_event($Example, $Subject, $Relation, $Object).

effective_system_relies_on($System, $Strategy) :-
    system_relies_on($System, $Strategy).

effective_system_relies_on($System, $Strategy) :-
    task_term_concept($System, $Concept),
    system_relies_on($Concept, $Strategy).

effective_phenomenon_exploits($Phenomenon, $Condition) :-
    phenomenon_exploits($Phenomenon, $Condition).

effective_phenomenon_exploits($Phenomenon, $Condition) :-
    task_term_concept($Phenomenon, $Concept),
    phenomenon_exploits($Concept, $Condition).

effective_phenomenon_example($Phenomenon, $Example) :-
    phenomenon_example($Phenomenon, $Example).

effective_phenomenon_example($Phenomenon, $Example) :-
    task_term_concept($Phenomenon, $Concept),
    phenomenon_example($Concept, $Example).

% R3 — process planning.  The recursive clause proves that a goal state follows
% from initial state plus action preconditions/effects; C performs the same
% dependency walk once to order steps, check resources and sum durations.
reasoning_operator_active(ordered_procedure).

process_reaches($Process, $State) :-
    reasoning_operator_active(ordered_procedure),
    process_initial_state($Process, $State).

process_reaches($Process, $Next) :-
    reasoning_operator_active(ordered_procedure),
    action_produces($Action, $Next),
    process_action($Process, $Action),
    action_requires($Action, $Prior),
    process_reaches($Process, $Prior).

process_dependency($Process, $Before, $After, $State) :-
    reasoning_operator_active(ordered_procedure),
    process_action($Process, $Before),
    process_action($Process, $After),
    action_produces($Before, $State),
    action_requires($After, $State).

% A recipe, an assembly and a software pipeline are the same relation at the
% fixed point: actions consume typed inputs and produce states toward a product.
% The verb used to describe an action is a field of action_semantics/3, not a
% predicate such as brewed/assembled/deployed.  This rule proves input coverage;
% C checks the universal "every declared input is covered" condition while it
% performs the already-required dependency walk.
process_input_covered($Process, $Product, $Input, $Action) :-
    reasoning_operator_active(ordered_procedure),
    process_product($Process, $Product),
    product_input($Product, $Input, $Role),
    process_action($Process, $Action),
    action_consumes($Action, $Input).

% R4 — constraint synthesis is goal matching without pre-enumerated options.
% Concepts in an open task term expose requirements and candidate features;
% properties decide which features cover which requirements.
reasoning_operator_active(constraint_synthesis).

task_candidate($Context, $Feature) :-
    reasoning_operator_active(constraint_synthesis),
    task_term_concept($Context, $Concept),
    candidate_for($Concept, $Feature).

task_requirement($Context, $Dimension, $Value) :-
    reasoning_operator_active(constraint_synthesis),
    task_term_concept($Context, $Concept),
    goal_prefers($Concept, $Dimension, $Value).

task_feature_match($Context, $Feature, $Dimension, $Value) :-
    reasoning_operator_active(constraint_synthesis),
    task_candidate($Context, $Feature),
    task_requirement($Context, $Dimension, $Value),
    property($Feature, $Dimension, $Value).

% ── SPAZIO NEGATIVO DELLA KB (gen382n, primo taglio verticale) ──────────────
% kb_fact/2 e apply/2 sono viste riflessive GENERALI del risolutore. Tutta la
% decisione resta qui: quale gruppo crea un obbligo, quale supporto basta, che
% cosa conta come copertura e quale rimedio segue dal tipo di lacuna.

% Un attributo osservato e' una relazione binaria diretta il cui primo argomento
% e' un membro del dominio. La macchineria e' esclusa dalla regola, non dal C:
% insegnare machinery(NewPred) cambia subito il profilo senza ricompilare.
observed_domain_attribute($Domain, $Facet, $Entity) :-
    expert_domain($Entity, $Domain),
    kb_fact($Facet, cons($Entity, cons($Value, nil))),
    naf(machinery($Facet)).

domain_member_count($Domain, $Count) :-
    findall($Member, expert_domain($Member, $Domain), $Members),
    count_list($Members, $Count).

attribute_support_count($Domain, $Facet, $Count) :-
    findall($Member, observed_domain_attribute($Domain, $Facet, $Member), $Members),
    count_list($Members, $Count).

% La maggioranza e' stretta (supporto*2 > popolazione), con una dimensione
% minima dichiarata da gap_policy/3. Il primo observed_domain_attribute enumera
% le FACET reali della KB: nessuno schema di attributi e' scritto a mano.
sibling_majority_expected($Entity, $Facet) :-
    expert_domain($Entity, $Domain),
    observed_domain_attribute($Domain, $Facet, $Witness),
    attribute_support_count($Domain, $Facet, $Support),
    domain_member_count($Domain, $Population),
    gap_policy(sibling_majority_expected, minimum_group_size, $Minimum),
    ge($Population, $Minimum),
    is($TwiceSupport, mul($Support, 2)),
    gt($TwiceSupport, $Population).

% Copertura epistemica, non presenza fisica: apply/2 passa dallo stesso
% risolutore delle domande normali, quindi una regola derivabile vale quanto un
% fatto e non produce un falso gap.
binary_relation_coverage($Entity, $Facet) :-
    apply($Facet, cons($Entity, cons($Value, nil))).

gap_covered($Coverage, $Entity, $Facet) :-
    apply($Coverage, cons($Entity, cons($Facet, nil))).

gap_uncovered($Coverage, $Entity, $Facet) :-
    naf(gap_covered($Coverage, $Entity, $Facet)).

knowledge_gap($Entity, $Facet) :-
    gap_source($Type, $Obligation, $Coverage),
    apply($Obligation, cons($Entity, cons($Facet, nil))),
    gap_uncovered($Coverage, $Entity, $Facet).

knowledge_gap_remedy($Entity, $Remedy) :-
    gap_source($Type, $Obligation, $Coverage),
    gap_remedy($Type, $Remedy),
    apply($Obligation, cons($Entity, cons($Facet, nil))),
    gap_uncovered($Coverage, $Entity, $Facet).

% Forma completa per host, dream e futuri consumer: un record tipizzato e
% azionabile, non una stringa di diagnosi.
gap_record($Type, $Entity, $Facet, $Remedy) :-
    gap_source($Type, $Obligation, $Coverage),
    gap_remedy($Type, $Remedy),
    apply($Obligation, cons($Entity, cons($Facet, nil))),
    gap_uncovered($Coverage, $Entity, $Facet).

% ── IL GAP DIALOGICO DI META-CONOSCENZA (gen382p) ───────────────────────────
%
% Il rilevatore di §9 cerca conoscenza che MANCA. Questo cerca l'altra cosa, che
% e' peggiore: conoscenza che C'E' e non riesce a uscire, perche' manca il fatto
% che collega una forma di domanda alla relazione che la risponde.
%
% Zero C: le due primitive riflessive di gen382n bastano. La differenza sta tutta
% in che cosa si mette come obbligo e come copertura — che e' il punto di §10:
% gap_source/3 e' cieca a entrambi.

% Le relazioni che parlano di un'entita' come SOGGETTO. Non un elenco: la forma
% della KB letta com'e'. machinery/1 tiene fuori la macchineria, ed e' un fatto,
% quindi la frontiera fra mondo e macchineria resta insegnabile.
entity_facet($Entity, $Facet) :-
    kb_fact($Facet, cons($Entity, cons($Value, nil))),
    naf(machinery($Facet)).

% Una faccetta e' RAGGIUNGIBILE se un registro di superficie la nomina. I
% registri sono elencati qui come clausole perche' ognuno ha una forma diversa;
% aggiungerne uno costa una clausola di una riga, e nessun C cambia.
facet_reachable($Facet) :- answer_frame($Cue, $Facet).
facet_reachable($Facet) :- aggregate_frame($Cue, $Facet, $Ret, $Mode).
facet_reachable($Facet) :- question_form($Cue, $Facet).
facet_reachable($Facet) :- consumer_reads($Module, $Facet).

% La copertura, nella forma binaria che gap_source/3 sa applicare. L'entita' non
% entra: una porta e' della RELAZIONE, non dell'oggetto di cui si parla — ed e'
% esattamente questo che la rende un moltiplicatore (§10.1).
surface_reachable($Entity, $Facet) :- facet_reachable($Facet).

% Il gap dialogico, per entita': so qualcosa e non c'e' modo di chiedermelo.
unreachable_facet($Entity, $Facet) :-
    entity_facet($Entity, $Facet),
    naf(facet_reachable($Facet)).

machinery(entity_facet).
machinery(facet_reachable).
machinery(surface_reachable).
machinery(unreachable_facet).
machinery(consumer_reads).

% ── LE LETTURE DI UNA DOMANDA DI CONTEGGIO (gen389) ─────────────────────────
%
% «Quanti pezzi ci sono negli scacchi» porta due ambiguita' sovrapposte, e la
% sonda `tests/ambiguity_probe.py` ha mostrato che un modello forte non chiede:
% sceglie la lettura piu' probabile, la DICHIARA («32 in totale»), e aggiunge
% subito la lettura vicina e la scomposizione. Qui le letture si DERIVANO dalla
% composizione, quindi una collezione nuova costa i suoi fatti e nessuna regola.
%
% La relazione e' UNA e generale — `part_count(Collezione, Parte, Quante)` — non
% una per dominio (mantra #3, astrai fino al punto fisso). Il primo tentativo la
% passava come DATO a `apply/2` per restare generico sul nome; era piu' debole di
% cosi' e piu' fragile, perche' `apply/2` non si comporta dentro `findall/3`
% (limite del motore trovato qui, annotato in question-emergence.md). Una
% relazione sola non ha bisogno di essere meta-chiamata.

% ── IL REGISTRO CAMBIA L'ESTENSIONE, NON SOLO L'ETICHETTA (gen390) ──────────
%
% Nel registro tecnico degli scacchi il PEDONE non e' un «pezzo»: i pezzi sono
% re, donna, torre, alfiere, cavallo. Non e' un errore dell'uso corrente — sono
% due strati, come *regina* e *donna*. Ma finora il registro cambiava solo le
% ETICHETTE (`concept_label/4`); qui cambia CHI STA DENTRO la categoria.
%
% L'astrazione, detta una volta: un termine non denota un insieme, denota un
% insieme PER REGISTRO. `part_excluded(Collezione, Registro, Parte)` e' un fatto,
% quindi un registro nuovo — o una categoria che si restringe altrove — non tocca
% il motore.
part_in_register($Coll, $Reg, $Part) :-
    part_count($Coll, $Part, $Q),
    naf(part_excluded($Coll, $Reg, $Part)).

part_count_in_register($Coll, $Reg, $Part, $Q) :-
    part_count($Coll, $Part, $Q),
    naf(part_excluded($Coll, $Reg, $Part)).

collection_kinds_in($Coll, $Reg, $N) :-
    findall($Part, part_in_register($Coll, $Reg, $Part), $Ps),
    count_list($Ps, $N).

collection_per_side_in($Coll, $Reg, $N) :-
    findall_bag($Q, part_count_in_register($Coll, $Reg, $Part, $Q), $Qs),
    sum_list($Qs, $N).

machinery(part_in_register).
machinery(part_count_in_register).
machinery(collection_kinds_in).
machinery(collection_per_side_in).
machinery(part_excluded).
machinery(register_trigger).
machinery(label_status).

collection_kinds($Coll, $N) :-
    findall($Part, part_count($Coll, $Part, $Q), $Ps),
    count_list($Ps, $N).

% findall_bag e non findall: qui i duplicati SONO il dato (due torri, due
% alfieri, due cavalli). Con la findall che deduplica la somma dava 11 invece di
% 16, in silenzio — vedi il commento in src/kb.c.
collection_per_side($Coll, $N) :-
    findall_bag($Q, part_count($Coll, $Part, $Q), $Qs),
    sum_list($Qs, $N).

collection_total($Coll, $N) :-
    collection_per_side($Coll, $Per),
    sides($Coll, $Sides),
    is($N, mul($Per, $Sides)).

% La vista unica: ogni lettura con la sua CHIAVE, che e' cio' che va detto
% insieme al numero perche' la risposta non sia una mezza verita'.
count_reading($Coll, kinds, $N)    :- collection_kinds($Coll, $N).
count_reading($Coll, per_side, $N) :- collection_per_side($Coll, $N).
count_reading($Coll, total, $N)    :- collection_total($Coll, $N).

machinery(collection_kinds).
machinery(collection_per_side).
machinery(collection_total).
machinery(count_reading).
machinery(part_count).
machinery(sides).

% gen391: viste linguistiche omogenee in un file proprio.
%
% CORREZIONE gen419 (F.): la frase che stava qui — «non si puo' mettere
% file_attribute(machinery) su procedures.p0 perche' include meta.p0, che
% contiene anche conoscenza del mondo» — era SBAGLIATA, e ha fatto danno finche'
% e' rimasta. L'attributo NON SI EREDITA: vale per il file che lo dichiara e solo
% per i predicati che quel file introduce, perche' un include e' una chiamata
% ricorsiva al caricatore e il file incluso parte con la lavagna pulita (vedi la
% documentazione della direttiva in src/kb.c). Includere meta.p0 non e' mai stato
% un rischio.
%
% Le `machinery(...)` una per predicato qui sotto restano valide e non fanno
% danno, ma non erano l'unica strada: chi aggiunge procedure puo' scegliere.
:- include(time-questions.p0).
:- include(dialogue-frames.p0).
:- include(dialogue-policy.p0).
:- include(context-scope.p0).
:- include(conditional-plans.p0).
:- include(code-plans.p0).
:- include(situation.p0).
:- include(turn-frames.p0).
% gen505y — la rete come memoria profonda: stato di rete, politica, rimedio,
% lezioni di condotta, memoria (docs/plans/la-rete-come-memoria-profonda.md).
:- include(network.p0).
:- include(stipulation.p0).
:- include(register.p0).
:- include(state-description.p0).
:- include(issues.p0).
:- include(discourse.p0).
:- include(inquiry.p0).
:- include(risk.p0).
:- include(numeric-questions.p0).
:- include(literals.p0).
:- include(claims.p0).
:- include(own-methods.p0).
:- include(gap-kinds.p0).
:- include(language-forms.p0).
:- include(language-observation.p0).
:- include(input-structure.p0).
:- include(document-structure.p0).
:- include(document-claims.p0).
:- include(document-argument.p0).
:- include(document-method.p0).
:- include(assisted-learning.p0).
:- include(arrests.p0).
:- include(debug.p0).
:- include(honest-limits.p0).
:- include(denotation.p0).
:- include(epistemic-status.p0).

% Internal protocol predicates are declared as machinery so self-description
% never mistakes a task trace or a renderer registry for world knowledge.
machinery(reasoning_operator_active).
machinery(task_difference).
machinery(task_goal_match).
machinery(effective_property).
machinery(effective_goal_prefers).
machinery(failure_mechanism).
machinery(normal_strategy_benefit).
machinery(failure_example).
machinery(effective_system_relies_on).
machinery(effective_phenomenon_exploits).
machinery(effective_phenomenon_example).
machinery(process_reaches).
machinery(process_dependency).
machinery(process_input_covered).
machinery(task_candidate).
machinery(task_requirement).
machinery(task_feature_match).
machinery(task_ir).
machinery(task_term_concept).
machinery(observed_domain_attribute).
machinery(domain_member_count).
machinery(attribute_support_count).
machinery(sibling_majority_expected).
machinery(binary_relation_coverage).
machinery(gap_covered).
machinery(gap_uncovered).
machinery(knowledge_gap).
machinery(knowledge_gap_remedy).
machinery(gap_record).

% una procedura e' macchineria: saper calcolare non e' un fatto sul mondo.
machinery(probability_procedure).

% Una PROCEDURA e' macchineria: saper sommare, contare o filtrare non e' un fatto
% sul mondo. Ma la distinzione corre sulla FORMA, non sul file: questi predicati
% sono definiti da REGOLE, mentre is_prime/1 e' un elenco di FATTI GROUND — che 2
% sia primo e' conoscenza matematica, non instradamento. Marcarlo (gen372) ha
% infatti rotto la risposta "2 is a is_prime" su cui poggia counterfactual.it;
% gen376 lo ha tolto. La regola pratica: se il predicato ha fatti che qualcuno
% potrebbe voler CHIEDERE, non e' macchineria.
machinery(sum_list).
machinery(count_list).
machinery(max_list).
machinery(drop_odds).
machinery(factorial).
machinery(fib).
machinery(gcd).
machinery(power).
machinery(member).
machinery(append_list).
machinery(concat_atoms).
machinery(sentence_terminator).
machinery(sentence_initial).
machinery(value_in_language).
machinery(register_value).
machinery(context_preference).
machinery(register_preferred).
machinery(register_output).
machinery(register_renders).
machinery(lexical_output).
machinery(lexical_renders).
machinery(realization_policy).
machinery(translated_term).
machinery(value_sentence).
machinery(answer_content).
machinery(answer_has_content).
machinery(answer_tail).
machinery(answer_text).

% ═══ gen419 — ORARI, DATE E NUMERI COMPLESSI, come PROCEDURE ═══════════════
%
% Tirate da un fallimento reale, non inventate: «A train leaves at 14:30 and
% travels for 2 hours 45 minutes. When does it arrive?» (#4 dei cento). Tracciato
% pezzo per pezzo, parrot0 aveva gia' TUTTI i mattoni — l'aritmetica pura
% (870+165=1035), le unita' di tempo in KB, la relazione «un'ora ha 60 minuti» —
% e nessuna PROCEDURA che li mettesse in fila. Il MANTRA #12 non applicato al
% tempo: tre numeri nel turno, nessuno dei quali e' la risposta.
%
% Sono regole, non C: si interrogano, si compongono, e domani se ne insegna una
% nuova senza ricompilare (docs/plans/teachable-procedures.md §2.2).

% Le procedure sono MACCHINERIA e qui si dichiarano una per una, come fa il resto
% del file. Dimenticarlo si vede subito — introspect.p0t elenca i predicati che
% parrot0 crede di sapere sul MONDO, e `days_in_month` fra quelli e' un errore che
% si legge a occhio. (Quel test dice anche la cosa giusta da fare: «mettila li',
% non alzare il numero qui», ed e' cosi' che questa svista e' stata corretta.)
machinery(int_div).       machinery(minutes_of).     machinery(time_of_minutes).
machinery(time_plus).     machinery(time_minus).     machinery(time_diff).
machinery(time_before).   machinery(leap_year).      machinery(days_in_month).
machinery(next_day).      machinery(date_plus_days).
machinery(c_add).  machinery(c_sub).   machinery(c_mul).  machinery(c_conj).
machinery(c_scale). machinery(c_norm2). machinery(c_div).

% ── la divisione INTERA, che il motore non ha ────────────────────────────────
% `div` e' reale: div(165,60) = 2.75. Il quoziente intero si compone dalle
% primitive che ci sono — togli il resto, poi dividi — ed e' il primo esempio del
% metodo: non si aggiunge una primitiva al C, si scrive una procedura.
int_div($A, $B, $Q) :- is($Q, div(sub($A, mod($A, $B)), $B)).

% ── ORARI ────────────────────────────────────────────────────────────────────
% Un orario e' time(Ore, Minuti); una durata e' dur(Ore, Minuti). Tenerli
% distinti non e' pedanteria: «14:30» e «2 ore 45» sono lo stesso paio di numeri
% con ruoli diversi, ed e' esattamente il ruolo che mancava.
minutes_of(time($H, $M), $T) :- is($T, add(mul($H, 60), $M)).
minutes_of(dur($H, $M), $T)  :- is($T, add(mul($H, 60), $M)).

% Dai minuti all'orario: il modulo 60 e' tutto il mestiere.
time_of_minutes($T, time($H, $M)) :- int_div($T, 60, $H), is($M, mod($T, 60)).

% Sommare una durata a un orario. Il giorno gira: 23:30 + 1h = 00:30.
time_plus($T0, $D, $T1) :-
    minutes_of($T0, $A), minutes_of($D, $B),
    is($S, mod(add($A, $B), 1440)), time_of_minutes($S, $T1).

time_minus($T0, $D, $T1) :-
    minutes_of($T0, $A), minutes_of($D, $B),
    is($S, mod(add(sub($A, $B), 1440), 1440)), time_of_minutes($S, $T1).

% Quanto passa fra due orari, in minuti e come durata.
% Il termine composto si costruisce nella TESTA, non con un eq nel corpo: e' il
% posto in cui l'unificazione lo sa riempire.
time_diff($T0, $T1, dur($H, $M)) :-
    minutes_of($T0, $A), minutes_of($T1, $B),
    is($S, mod(add(sub($B, $A), 1440), 1440)),
    int_div($S, 60, $H), is($M, mod($S, 60)).

time_before($T0, $T1) :- minutes_of($T0, $A), minutes_of($T1, $B), lt($A, $B).

% ── DATE ─────────────────────────────────────────────────────────────────────
% Una data e' date(Anno, Mese, Giorno).
leap_year($Y) :- eq(mod($Y, 400), 0).
leap_year($Y) :- eq(mod($Y, 4), 0), naf(eq(mod($Y, 100), 0)).

days_in_month(1, $Y, 31).   days_in_month(3, $Y, 31).  days_in_month(4, $Y, 30).
days_in_month(5, $Y, 31).   days_in_month(6, $Y, 30).  days_in_month(7, $Y, 31).
days_in_month(8, $Y, 31).   days_in_month(9, $Y, 30).  days_in_month(10, $Y, 31).
days_in_month(11, $Y, 30).  days_in_month(12, $Y, 31).
days_in_month(2, $Y, 29) :- leap_year($Y).
days_in_month(2, $Y, 28) :- naf(leap_year($Y)).

% Il giorno dopo, con i tre travasi: giorno -> mese -> anno.
next_day(date($Y, $M, $D), date($Y, $M, $D1)) :-
    days_in_month($M, $Y, $L), lt($D, $L), is($D1, add($D, 1)).
next_day(date($Y, $M, $D), date($Y, $M1, 1)) :-
    days_in_month($M, $Y, $D), lt($M, 12), is($M1, add($M, 1)).
next_day(date($Y, 12, 31), date($Y1, 1, 1)) :- is($Y1, add($Y, 1)).

% Sommare giorni: ricorsione sul giorno dopo. Zero e' il caso base.
date_plus_days($D, 0, $D).
date_plus_days($D0, $N, $D2) :-
    gt($N, 0), next_day($D0, $D1),
    is($N1, sub($N, 1)), date_plus_days($D1, $N1, $D2).

% ── NUMERI COMPLESSI ─────────────────────────────────────────────────────────
% Un complesso e' c(Reale, Immaginario). Le quattro operazioni sono definizioni,
% non calcoli cablati: si leggono come le si scriverebbe alla lavagna.
c_add(c($A, $B), c($C, $D), c($R, $I)) :- is($R, add($A, $C)), is($I, add($B, $D)).
c_sub(c($A, $B), c($C, $D), c($R, $I)) :- is($R, sub($A, $C)), is($I, sub($B, $D)).
c_mul(c($A, $B), c($C, $D), c($R, $I)) :-
    is($R, sub(mul($A, $C), mul($B, $D))),
    is($I, add(mul($A, $D), mul($B, $C))).
c_conj(c($A, $B), c($A, $N)) :- is($N, sub(0, $B)).
c_scale(c($A, $B), $K, c($R, $I)) :- is($R, mul($A, $K)), is($I, mul($B, $K)).

% Il modulo al quadrato evita la radice, che il motore non ha: e' la forma in cui
% i confronti fra moduli si fanno comunque.
c_norm2(c($A, $B), $N) :- is($N, add(mul($A, $A), mul($B, $B))).

% La divisione, per il coniugato — e qui si vede che sono procedure e non tabelle:
% c_div si APPOGGIA a c_mul, c_conj e c_norm2 invece di riscriverne il contenuto.
c_div($Z, $W, c($R, $I)) :-
    c_conj($W, $WC), c_mul($Z, $WC, c($P, $Q)), c_norm2($W, $N),
    is($R, div($P, $N)), is($I, div($Q, $N)).

% ═══ gen423 — GLI OPERATORI SONO CONOSCENZA ═══════════════════════════════
%
% Trovato dalla firma del ragionamento (gen422): «9-4» e «why» portavano la
% stessa firma perche' toccavano gli stessi 57 predicati — cioe' perche' «9-4»
% NON INTERROGA LA CONOSCENZA PER NIENTE. Il calcolo stava in
% src/brain/20-math.c come `case '+': return a + c;`, mentre qui accanto
% `product/3` e `factor/3` esistevano gia' e nessuno le chiamava: due strade per
% la stessa cosa, e il turno prendeva quella cablata.
%
% F.: «non si puo' insegnare alla KB che esiste un operatore chiamato cavallo che
% e' la somma dei quadrati, e non mi piace». E' il test del mantra #2 nella sua
% forma piu' esigente, e la risposta e' che ora si puo': un operatore nuovo costa
% DUE RIGHE qui e nessuna riga di C.
machinery(infix_operator).
machinery(apply_operator).
machinery(operator_symbol).
operator_symbol(plus, "+"). operator_symbol(minus, "-").
operator_symbol(times, "*"). operator_symbol(divide, "/").
machinery(operator_explanation).
operator_explanation("+", "adding", "sum").
operator_explanation("-", "subtracting", "difference").
operator_explanation("*", "multiplying", "product").
operator_explanation("/", "dividing", "quotient").
machinery(domain_relation).

domain_relation(neighbor, borders).
domain_relation(capital, capital_of_country).
domain_relation(magnitude, magnitude).
domain_relation(planet_superlative, planet_superlative).
domain_relation(membership, category_member).
domain_relation(difference, difference_between).
domain_relation(sound, sound_of).
domain_relation(no_land_border, no_land_border).
domain_relation(color, color_of).
domain_relation(surface_color, color_of).
domain_relation(opposite, opposite).
domain_relation(landmark, landmark_of).
domain_relation(riddle_signature, riddle_sig).
domain_relation(riddle_answer, riddle_answer).
domain_relation(distance, distance_between).
domain_relation(meeting_time, meet_time).
domain_relation(quantity, quantity).
domain_relation(proportional_cost, proportional_cost).
domain_relation(change_due, change_due).
domain_relation(part_count, part_count).
domain_relation(causal, causes).
domain_relation(continuation, cont).
domain_relation(river, river_of).
domain_relation(ocean_border, ocean_borders).
domain_relation(western_ocean, ocean_west_of).
domain_relation(kind, kind_is).
domain_relation(capital_fallback, capital).
domain_relation(count, count_of).
domain_relation(isa, is_a).
domain_relation(same, same).
domain_relation(location, located_in).
domain_relation(authored_work, wrote).
domain_relation(kinship, family_relation).
domain_relation(narrative_completion, continuation_template).
domain_relation(content, content_kind).
domain_relation(role_trait, trait).
domain_relation(world_extreme, world_superlative).
domain_relation(invention, invented_object).
domain_relation(mereology, part_of).
domain_relation(idiom, idiom_meaning).
domain_relation(pair_scale, pair_magnitude).

infix_operator("+", plus).
infix_operator("-", minus).
infix_operator("*", times).
infix_operator("plus", plus).
infix_operator("più", plus).
infix_operator("piu", plus).
infix_operator("minus", minus).
infix_operator("meno", minus).
infix_operator("times", times).
infix_operator("per", times).
infix_operator("multiplied", times).
infix_operator("by", times).
infix_operator("/", divide).
infix_operator("divided", divide).
infix_operator("diviso", divide).
infix_operator("fratto", divide).
infix_operator("moltiplicato", times).
infix_operator("sommato", plus).
infix_operator("over", divide).
machinery(algebra_inverse).
algebra_inverse(left, "+", minus, "-").
algebra_inverse(left, "-", plus, "+").
algebra_inverse(left, "*", divide, "/").
algebra_inverse(left, "/", times, "*").
algebra_inverse(right, "+", minus, "-").
algebra_inverse(right, "-", minus, "-").
algebra_inverse(right, "*", divide, "/").
algebra_inverse(right, "/", divide, "/").
machinery(algebra_inverse_order).
algebra_inverse_order(left, "+", normal).
algebra_inverse_order(left, "-", normal).
algebra_inverse_order(left, "*", normal).
algebra_inverse_order(left, "/", normal).
algebra_inverse_order(right, "+", normal).
algebra_inverse_order(right, "-", swap).
algebra_inverse_order(right, "*", normal).
algebra_inverse_order(right, "/", swap).
machinery(number_word).
number_word(zero, 0). number_word(one, 1). number_word(two, 2).
number_word(three, 3). number_word(four, 4). number_word(five, 5).
number_word(six, 6). number_word(seven, 7). number_word(eight, 8).
number_word(nine, 9). number_word(ten, 10). number_word(eleven, 11).
number_word(twelve, 12). number_word(thirteen, 13). number_word(fourteen, 14).
number_word(fifteen, 15). number_word(sixteen, 16). number_word(seventeen, 17).
number_word(eighteen, 18). number_word(nineteen, 19). number_word(twenty, 20).
number_word(thirty, 30). number_word(forty, 40). number_word(fifty, 50).
number_word(sixty, 60). number_word(seventy, 70). number_word(eighty, 80).
number_word(ninety, 90). number_word(hundred, 100). number_word(thousand, 1000).
number_word(dozen, 12). number_word(dozzina, 12).
number_word(uno, 1). number_word(due, 2). number_word(tre, 3).
number_word(quattro, 4). number_word(cinque, 5). number_word(sei, 6).
number_word(sette, 7). number_word(otto, 8). number_word(nove, 9).
number_word(dieci, 10). number_word(undici, 11). number_word(dodici, 12).
number_word(tredici, 13). number_word(quattordici, 14). number_word(quindici, 15).
number_word(sedici, 16). number_word(diciassette, 17). number_word(diciotto, 18).
number_word(diciannove, 19). number_word(venti, 20). number_word(trenta, 30).
number_word(quaranta, 40). number_word(cinquanta, 50). number_word(sessanta, 60).
number_word(settanta, 70). number_word(ottanta, 80). number_word(novanta, 90).
number_word(cento, 100). number_word(mille, 1000).

% Branching act-loop operation vocabulary (gen467). Surface, primitive symbol
% and factor are one teachable relation; the parser does not own these words.
machinery(agent_branch_step).
agent_branch_step("double", "*", 2).
agent_branch_step("raddoppia", "*", 2).
agent_branch_step("triple", "*", 3).
agent_branch_step("triplica", "*", 3).
agent_branch_step("halve", "/", 2).
agent_branch_step("dimezza", "/", 2).
agent_branch_step("add", "+", 0).
agent_branch_step("plus", "+", 0).
agent_branch_step("aggiungi", "+", 0).
agent_branch_step("somma", "+", 0).
agent_branch_step("subtract", "-", 0).
agent_branch_step("minus", "-", 0).
agent_branch_step("sottrai", "-", 0).
agent_branch_step("togli", "-", 0).
agent_branch_step("multiply", "*", 0).
agent_branch_step("times", "*", 0).
agent_branch_step("moltiplica", "*", 0).
agent_branch_step("divide", "/", 0).
machinery(agent_parity_marker).
agent_parity_marker(even, "even"). agent_parity_marker(even, "pari").
agent_parity_marker(odd, "odd"). agent_parity_marker(odd, "dispari").
machinery(search_using_marker).
search_using_marker("using"). search_using_marker("usando").
machinery(search_reach_marker).
search_reach_marker("reach"). search_reach_marker("raggiungere").
machinery(search_make_marker).
search_make_marker("make"). search_make_marker("arrivare a").
machinery(search_get_to_marker).
search_get_to_marker("get to"). search_get_to_marker("ottenere").
agent_branch_step("dividi", "/", 0).
agent_branch_step("diviso", "/", 0).
apply_operator(divide, $A, $B, $R) :- dif($B, 0), is($R, div($A, $B)).
% NIENTE «x» per la moltiplicazione: in questo sistema `x` e' la variabile
% dell'algebra, e dichiararla operatore faceva leggere «10 / x = 0» come una
% moltiplicazione (misurato: algebra.p0t rispondeva 0 invece di declinare).
% Un simbolo che ha gia' un mestiere non ne prende un secondo.

apply_operator(plus,  $A, $B, $R) :- is($R, add($A, $B)).
apply_operator(minus, $A, $B, $R) :- is($R, sub($A, $B)).
apply_operator(times, $A, $B, $R) :- is($R, mul($A, $B)).

% E la prova che sia davvero insegnabile: due operatori VERI che il motore non
% conosce e non calcolera' mai in C. Esistono perche' lo dicono queste righe, e
% nient'altro.
%
% Il massimo comun divisore e' l'esempio migliore che ci sia: e' ricorsivo, quindi
% non lo si puo' fingere con una formula, e nessun `case` del C lo contiene.
infix_operator("gcd", gcd_op).
apply_operator(gcd_op, $A, 0, $A).
apply_operator(gcd_op, $A, $B, $R) :- gt($B, 0), is($M, mod($A, $B)), apply_operator(gcd_op, $B, $M, $R).

% E la media, che e' una composizione: somma e poi divide.
infix_operator("avg", avg_op).
apply_operator(avg_op, $A, $B, $R) :- is($R, div(add($A, $B), 2)).
% Surface forms that open an induction request. The consumer only keeps the
% operational kind and the matched span; new language forms are KB data.
machinery(induce_query_phrase).
induce_query_phrase("continue from", continue).
induce_query_phrase("continua da", continue).
induce_query_phrase("what comes after", next).
induce_query_phrase("cosa viene dopo", next).
induce_query_phrase("apply it to", next).
induce_query_phrase("applicala a", next).
induce_query_phrase("what is the rule", rule).
induce_query_phrase("what's the rule", rule).
induce_query_phrase("qual è la regola", rule).
induce_query_phrase("quale regola", rule).
induce_query_phrase("che regola", rule).

% ── gen492 — QUANTI ELEMENTI HA UNA LISTA ──────────────────────────────────
% Meccanica generale, non conoscenza di dominio: serve ovunque una misura sia un
% CONTEGGIO invece che una lunghezza. Il motore ha `findall/3` ma non sapeva
% contarne il risultato, quindi ogni criterio che voglia dire «quante» doveva
% farsi contare da un ramo nel C.
machinery(list_len).
list_len(nil, 0).
list_len(cons($H, $T), $N) :- list_len($T, $M), is($N, add($M, 1)).

% ══ gen507/80 — LE RELAZIONI SI PARLANO FRA LORO: `holds/3` ═══════════════
%
% F., 2026-09-10: «superfici di insegnabilita' di astrazione superiore — si
% insegna che una relazione e' simile a un'altra ma per un contesto: `part_of`
% potrebbe essere indicato per "un giocatore appartiene a una squadra" nel
% contesto dello sport».
%
% Il pezzo che lo permette c'e' gia' ed e' `apply/2`, il confine a predicato
% variabile del solver (docs/plans/thinking.md §0.1): il NOME di una relazione
% e' un dato. Finora lo usavano i criteri di qualita' e i ponti fra
% rappresentazioni; qui diventa il modo in cui si insegnano cose SULLE
% relazioni invece che con esse.
%
%     holds(Relazione, X, Y)
%
% e' la domanda «questa relazione vale fra questi due?» posta in modo che la
% relazione sia un argomento. Un lettore che chiede `holds/3` invece del
% predicato nudo eredita, senza saperlo, ogni ponte che la KB dichiarera'
% domani fra una relazione e un'altra.
machinery(holds).
machinery(context_alias).

% (a) la strada diretta: la relazione vale davvero.
holds($Rel, $X, $Y) :- apply($Rel, cons($X, cons($Y, nil))).

% (b) IL CONTESTO. `context_alias(Contesto, Locale, Generale)` dice che dentro
%     un contesto una relazione locale E' un caso di una generale: nello sport
%     «gioca per» e' un modo di dire «fa parte di». Chi chiede la generale
%     ottiene anche i fatti detti con la locale, e chi insegna non deve tradurre
%     il proprio dominio nel vocabolario di parrot0.
holds($General, $X, $Y) :-
    context_alias($Context, $Local, $General),
    apply($Local, cons($X, cons($Y, nil))).

% (c) LA SPECIALIZZAZIONE CON VINCOLO DI CLASSE. `class_scoped_alias(Classe,
%     Locale, Generale)` dice che la locale vale come la generale SOLO quando il
%     soggetto e' di quella classe. E' il ponte del contesto stretto di un
%     grado: «dirige» vale come «guida» per una persona, non per un fiume.
machinery(class_scoped_alias).
holds($General, $X, $Y) :-
    class_scoped_alias($Class, $Local, $General),
    apply($Local, cons($X, cons($Y, nil))),
    apply($Class, cons($X, nil)).

% (d) LE PROPRIETA' SI EREDITANO FRA RELAZIONI. `relation_like(V, W)` dice che V
%     si comporta come W: quello che e' stato dichiarato di W vale per V senza
%     ripeterlo. E' il predicato variabile applicato alle PROPRIETA' invece che
%     ai fatti — si insegna una volta la scheda di una relazione, e ogni
%     relazione che le somiglia la eredita.
machinery(relation_like).
transitive_relation($V) :- relation_like($V, $W), transitive_relation($W).
symmetric_relation($V)  :- relation_like($V, $W), symmetric_relation($W).
reflexive_relation($V)  :- relation_like($V, $W), reflexive_relation($W).
functional_relation($V) :- relation_like($V, $W), functional_relation($W).

% (e) UNA CLASSE DEFINITA DA UNA RELAZIONE. `holds1(Classe, X)` e' l'appartenenza
%     posta con la CLASSE come argomento — il gemello unario di `holds/3`. Serve
%     perche' una classe possa essere definita invece che elencata: «un genitore
%     e' chi ha un figlio» non e' una lista di genitori, e' una regola.
machinery(holds1).
machinery(class_from_relation).
holds1($Class, $X) :- apply($Class, cons($X, nil)).
% gen512 — LA RESTRIZIONE ESISTENZIALE: Q vale per X se X sta nella relazione R
% con qualcosa che e' P (Q ⊒ ∃R.P). Una riga sola per ogni Q, R, P: sono
% VARIABILI di predicato, e la conoscenza e' il fatto `exists_restriction/3`,
% che si insegna parlando («if someone is stung by something venomous then they
% are in danger») e che una spiegazione puo' leggere, perche' e' un dato e non
% una regola opaca.
machinery(exists_restriction).
holds1($Q, $X) :- exists_restriction($Q, $R, $P), holds($R, $X, $Y), holds1($P, $Y).
holds1($Class, $X) :-
    class_from_relation($Class, $Rel),
    apply($Rel, cons($X, cons($Any, nil))).

% (f) UNA RELAZIONE DEFINITA DA DUE. Insegnare una REGOLA invece di un fatto:
%     `relation_and(V, W, Z)` dice che V vale dove valgono entrambe. E'
%     congiunzione dichiarata — il mantra #19 applicato alle relazioni.
%
%     gen508: le famiglie (f)(g)(h)(i)(s) non hanno piu' una clausola di
%     `holds/3` ciascuna. Sono DESCRIZIONI della stessa espressione — vedi il
%     blocco «LA DEFINIZIONE E' UN'ESPRESSIONE» piu' sotto — e la interpreta
%     `eval_rel/3`, che passa da `holds/3` per ogni operando. Prima gli operandi
%     passavano da `apply/2`, cioe' dal predicato nudo: una relazione definita
%     soltanto da un ponte non era un operando possibile (LEARN_PROTOCOL §G.5).
machinery(relation_and).

% (g) E la disgiunzione: V vale dove ne vale almeno una.
machinery(relation_or).

% (h) LA COMPOSIZIONE DI DUE RELAZIONI. `relation_chain(V, W, Z)` dice che V e'
%     W seguita da Z: «nonno» e' «genitore» seguito da «genitore». E' la mossa
%     che genera relazioni NUOVE invece di collegare quelle che ci sono — con
%     due relazioni note se ne definisce una terza che nessuno ha mai popolato.
machinery(relation_chain).

% (i) L'ECCEZIONE DICHIARATA. `relation_unless(V, W, Z)`: V vale dove vale W
%     tranne dove vale Z. Una regola con la sua eccezione detta insieme, invece
%     di una regola falsa che qualcuno correggera' poi.
machinery(relation_unless).

% (l) LA SCHEDA DI UNA RELAZIONE, come vista. `relation_note(V, Nota)` raccoglie
%     in un posto solo tutto cio' che e' stato dichiarato SU una relazione:
%     proprieta', ponti, definizioni. Serve a chi insegna — dopo cinque lezioni
%     su una relazione si vuole vedere che cosa parrot0 ne ha capito, e finora
%     l'unico modo era leggere i file.
machinery(relation_note).
relation_note($V, "chains")              :- transitive_relation($V).
relation_note($V, "goes both ways")      :- symmetric_relation($V).
relation_note($V, "holds of itself")     :- reflexive_relation($V).
relation_note($V, "has one value")       :- functional_relation($V).
relation_note($V, $Note) :- inverse_relation($V, $W), concat_atoms("opposite of ", $W, $Note).
relation_note($V, $Note) :- inverse_relation($W, $V), concat_atoms("opposite of ", $W, $Note).
relation_note($V, $Note) :- implies_relation($V, $W), concat_atoms("implies ", $W, $Note).
relation_note($V, $Note) :- excludes_relation($V, $W), concat_atoms("rules out ", $W, $Note).
relation_note($V, $Note) :- relation_like($V, $W), concat_atoms("behaves like ", $W, $Note).
relation_note($V, $Note) :- context_alias($C, $V, $W), concat_atoms("stands for ", $W, $Note).
% gen508: catena, congiunzione, unione ed eccezione non hanno piu' una nota
% ciascuna che nominava UN solo operando: la scheda rende la definizione intera
% («defined as parent followed by parent») tramite `expr_words/2`, piu' sotto.

% (m) UN FATTO CHE VALE SOLO DENTRO UN CONTESTO. `context_fact(Contesto, V, X,
%     Y)` e' un fatto SOSPESO: vale quando quel contesto e' attivo, e tace
%     altrimenti. Serve a tenere insieme conoscenze che si contraddicono fra
%     domini — «la regina si muove in tutte le direzioni» e' vera negli scacchi
%     e falsa a dama — senza che parrot0 debba scegliere quale mondo abitare.
machinery(context_fact).
machinery(active_context).
holds($V, $X, $Y) :-
    context_fact($C, $V, $X, $Y),
    active_context($C).

% (n) TUTTO CIO' CHE SI PUO' DIRE DI UNA COSA. `about(X, V, Y)` enumera le
%     relazioni in cui X compare, applicando ognuna: il predicato variabile
%     usato per GUARDARSI INTORNO invece che per rispondere a una domanda
%     precisa. E' la differenza fra sapere e sapere di sapere.
machinery(about).
% gen508: si guarda intorno con `holds/3`, non col predicato nudo — cosi' vede
% anche le relazioni DEFINITE e i ponti, che `apply/2` da solo non attraversa.
about($X, $V, $Y) :- relation_verb($V), holds($V, $X, $Y).
% gen510 — e i RUOLI in cui X compare: Napoleone e' solo un valore
% (`loser_of(waterloo, napoleon)`), e «what can you say about napoleon?»
% trovava zero righe, cedeva, e riceveva la chiacchiera (report gen509, NA11).
about($X, $Role, $O) :- role_name($Role), role($O, $Role, $X).
% (solo i ruoli di uno SCHEMA: `subject`/`object` dell'adattatore `fact/3`
%  sono posizioni interne, e comparivano nella risposta.)

% (o) CHE COSA LEGA DUE COSE. `between(X, Y, V)` enumera le relazioni che valgono
%     fra due cose date: il gemello a due argomenti di `about/3`. E' la domanda
%     che si fa guardando due nomi e chiedendosi che rapporto ci sia.
machinery(between_rel).
% Il catalogo comprende anche nomi relazionali e definizioni insegnate:
% saper leggere «the material of ...» deve rendere la relazione ricercabile.
between_rel($X, $Y, $V) :- capability_provider(binary_relation, $V, 2), holds($V, $X, $Y).
:- include(inference-capabilities.p0).

% (p) LA FIRMA DI UNA RELAZIONE: da quale classe parte e a quale arriva.
%     Dichiararla non serve solo a documentare — dice DOVE una relazione ha
%     senso, ed e' cio' che permettera' di rifiutare un fatto assurdo invece di
%     tenerlo. Per ora entra nella scheda.
machinery(relation_signature).
relation_note($V, $Note) :-
    relation_signature($V, $From, $To),
    concat_atoms("goes from ", $From, $Half),
    concat_atoms($Half, " to ", $Half2),
    concat_atoms($Half2, $To, $Note).

% (q) LA COMPOSIZIONE DI UNA RELAZIONE CON SE' STESSA, detta in breve: «nonno e'
%     genitore due volte». E' il caso piu' frequente della composizione, e
%     scriverlo due volte e' cio' che fa sbagliare.
relation_chain($V, $W, $W) :- relation_twice($V, $W).
machinery(relation_twice).

% (r) UN NOME CHE VALE DENTRO UN CONTESTO. `context_name(Contesto, Locale,
%     Vero)` dice che dentro un dominio una cosa si chiama diversamente. Non e'
%     un alias globale: fuori da quel contesto il nome locale non significa
%     niente, ed e' giusto — «il capitano» e' una persona precisa solo dentro
%     una squadra.
machinery(context_name).
holds($V, $X, $Y) :-
    context_name($C, $X, $Real), active_context($C),
    apply($V, cons($Real, cons($Y, nil))).
holds($V, $X, $Y) :-
    context_name($C, $Y, $Real), active_context($C),
    apply($V, cons($X, cons($Real, nil))).

% (s) IL VERSO ROVESCIO, dentro `holds/3`: cosi' compone con i contesti, le
%     catene e le eccezioni, cosa che `inverse_relation/2` da sola non fa perche'
%     e' letta da un lettore solo. (gen508: e' la descrizione `flip(W)`.)
machinery(relation_reverse).

% ══ gen508 — LA DEFINIZIONE E' UN'ESPRESSIONE: `relation_def/2`, `eval_rel/3` ══
%
% docs/plans/due-strutture-kb-viva.md §3 (F., 2026-09-11): «una relazione
% derivata potrebbe denotare una struttura i cui operandi sono altre
% definizioni. La stessa inferenza potrebbe eseguirla e interrogarne la forma».
%
% Al gen507 ogni famiglia (catena, congiunzione, unione, eccezione, rovescio)
% aveva la propria clausola di `holds/3` e risolveva gli operandi con `apply/2`:
% cinque interpreti a un grado di profondita', chiusi l'uno all'altro. Qui c'e'
% UN linguaggio delle definizioni, chiuso per composizione:
%
%     relation_def(V, Espressione)       V e' definita da questa espressione
%
%     flip(E)          il verso rovescio di E
%     both(A, B)       dove valgono entrambe          (intersezione)
%     either(A, B)     dove ne vale almeno una         (unione)
%     then(A, B)       A seguita da B                  (composizione)
%     unless(A, B)     A tranne dove vale B            (eccezione)
%     within(C, E)     E, ma solo dentro il contesto C
%     use(C, A)        la costruzione C applicata ad A (parametrica, vedi sotto)
%     un nome          una relazione: fatti, regole, ponti E la sua definizione
%
% Ogni operando e' a sua volta un'espressione: una definizione insegnata oggi
% puo' stare dentro una insegnata domani senza una famiglia C per la coppia.
% Le famiglie del gen507 NON sono state riscritte: forniscono descrizioni a
% questa interpretazione (viste), e le lezioni gia' date restano valide.
machinery(relation_def).
machinery(eval_rel).

% ── (1) le famiglie sono viste sulla descrizione comune ─────────────────────
relation_def($V, both($W, $Z))   :- relation_and($V, $W, $Z).
relation_def($V, $W)             :- relation_or($V, $W).
relation_def($V, then($W, $Z))   :- relation_chain($V, $W, $Z).
relation_def($V, unless($W, $Z)) :- relation_unless($V, $W, $Z).
relation_def($V, flip($W))       :- relation_reverse($V, $W).
% (`context_alias/3` resta nella clausola (b) di `holds/3`: al gen507 il ponte
%  di contesto non richiede il contesto attivo, e cambiarlo e' una decisione
%  semantica, non una migrazione. `within/2` e' il costruttore che la richiede.)

% ── (2) l'interprete: una clausola per costruttore, e il nome passa da holds ─
% Piu' definizioni della stessa relazione sono SUPPORTI alternativi (unione):
% e' il contratto che `relation_or` gia' aveva, esteso a tutto il linguaggio.
holds($V, $X, $Y) :- relation_def($V, $D), eval_rel($D, $X, $Y), self_pair_allowed($V, $X, $Y).

% gen510 — una definizione puo' produrre la coppia (x, x) senza volerlo:
% «child followed by parent» rende ognuno fratello di se' stesso. Se la
% relazione e' dichiarata irriflessiva («sibling never holds of itself»), la
% coppia con se' stessi non vale. Riguarda solo cio' che una DEFINIZIONE
% deriva: un fatto detto resta com'e' stato detto.
machinery(irreflexive_relation).
machinery(self_pair_allowed).
self_pair_allowed($V, $X, $Y) :- naf(irreflexive_relation($V)).
self_pair_allowed($V, $X, $Y) :- irreflexive_relation($V), dif($X, $Y).
relation_note($V, "never holds of itself") :- irreflexive_relation($V).

eval_rel(flip($E), $X, $Y)       :- eval_rel($E, $Y, $X).
eval_rel(both($A, $B), $X, $Y)   :- eval_rel($A, $X, $Y), eval_rel($B, $X, $Y).
eval_rel(either($A, $B), $X, $Y) :- eval_rel($A, $X, $Y).
eval_rel(either($A, $B), $X, $Y) :- eval_rel($B, $X, $Y).
eval_rel(then($A, $B), $X, $Z)   :- eval_rel($A, $X, $Y), eval_rel($B, $Y, $Z).
eval_rel(unless($A, $B), $X, $Y) :- eval_rel($A, $X, $Y), naf(eval_rel($B, $X, $Y)).
eval_rel(within($C, $E), $X, $Y) :- active_context($C), eval_rel($E, $X, $Y).
% un nome — o un'istanza `use(C, A)`, che ha una definizione come un nome —
% torna a `holds/3`: fatti, regole, ponti di contesto e di classe, definizione.
eval_rel($E, $X, $Y)             :- holds($E, $X, $Y).

% ── (3) LE COSTRUZIONI PARAMETRICHE ─────────────────────────────────────────
% «reciprocal x holds where both x and flipped x» e' una definizione con una
% VARIABILE: il lettore la salva come fatto non ground, `relation_and(
% use(reciprocal, $x), $x, use(flipped, $x))`, e il solver la standardizza a
% ogni uso come una regola. «friendship is reciprocal likes» produce allora
% `relation_def(friendship, use(reciprocal, likes))`, e `use(reciprocal, likes)`
% trova la propria definizione per unificazione, senza un dispatcher per la
% costruzione. E' l'effetto di `apply/2` portato alle famiglie: un'intera
% costruzione e' un oggetto parametrico della KB, riusabile su ogni dominio.
%
% Una parola e' una costruzione se esiste una definizione parametrica che la
% usa come tale: la licenza e' l'esistenza della lezione, e si ritira
% ritirando la lezione («forget that flipped x is x read backwards»).
machinery(relation_construction).
relation_construction($C) :- relation_def(use($C, $P), $D).

% ── (3b) gen510 — «X is the R of Y» e «the R of Y is X» sono LO STESSO LEGAME ─
% Le due superfici scrivevano due predicati: `mother(elizabeth, charles)` e
% `mother_of(irene_joliot-curie, marie_curie)`. Chi insegna nomina la relazione
% con la parola che usa («mother»), mai con `mother_of`, quindi «parent holds
% wherever mother» non raggiungeva mai i fatti detti nella seconda forma
% (report gen509, NL6). Il verso sta gia' in KB (`relation_value_first/1`,
% grammar.p0): per le relazioni col valore secondo, «X is the R of Y» e'
% `R_of(Y, X)`; per quelle col valore primo e' `R_of(X, Y)`.
holds($Noun, $X, $Y) :-
    relation_noun($Pred, $Noun), naf(relation_value_first($Pred)),
    apply($Pred, cons($Y, cons($X, nil))).
holds($Noun, $X, $Y) :-
    relation_noun($Pred, $Noun), relation_value_first($Pred),
    apply($Pred, cons($X, cons($Y, nil))).

% ── (4) LA FORMA NORMALE: costruzioni e nomi definiti si espandono ──────────
% Le leggi che seguono valgono per relazioni pure lette come insiemi di coppie;
% per applicarle a una definizione bisogna prima vederla nei costruttori di
% base. Qui stanno anche due EQUIVALENZE della costruzione:
%   flip(flip(E))   = E                        la legge del doppio inverso
%   flip(then(A,B)) = then(flip(B), flip(A))   la legge dell'ordine scambiato
machinery(norm_expr).
machinery(compound_expr).
% gen509: gli aiutanti sono meccanica. Senza questa riga «describe waterloo»
% annunciava «waterloo is a base_expr» — un atomo qualunque soddisfa
% `base_expr/1`, e il lettore delle descrizioni scarta solo cio' che si
% dichiara `machinery/1` (gen434). Difetto del gen508, trovato insegnando.
machinery(base_expr).  machinery(has_def).       machinery(flip_norm).
machinery(same_form).  machinery(symmetric_form). machinery(transitive_form).
machinery(reflexive_form). machinery(functional_form).
machinery(expr_infix). machinery(expr_suffix).    machinery(expr_pair_words).
machinery(has_role).   machinery(missing_role).   machinery(occurrence_incomplete).
machinery(occurrence_complete). machinery(has_condition). machinery(schema_note).
compound_expr(flip($E)).       compound_expr(both($A, $B)).   compound_expr(either($A, $B)).
compound_expr(then($A, $B)).   compound_expr(unless($A, $B)). compound_expr(within($C, $E)).
compound_expr(use($C, $A)).
base_expr($E) :- naf(compound_expr($E)).
has_def($E)   :- relation_def($E, $D).

norm_expr(flip($E), $N)                :- norm_expr($E, $M), flip_norm($M, $N).
norm_expr(both($A, $B), both($NA, $NB))     :- norm_expr($A, $NA), norm_expr($B, $NB).
norm_expr(either($A, $B), either($NA, $NB)) :- norm_expr($A, $NA), norm_expr($B, $NB).
norm_expr(then($A, $B), then($NA, $NB))     :- norm_expr($A, $NA), norm_expr($B, $NB).
norm_expr(unless($A, $B), unless($NA, $NB)) :- norm_expr($A, $NA), norm_expr($B, $NB).
norm_expr(within($C, $E), within($C, $N))   :- norm_expr($E, $N).
norm_expr(use($C, $A), $N)             :- relation_def(use($C, $A), $D), norm_expr($D, $N).
norm_expr($V, $N)                      :- base_expr($V), relation_def($V, $D), norm_expr($D, $N).
norm_expr($V, $V)                      :- base_expr($V), naf(has_def($V)).

flip_norm(flip($E), $E).
flip_norm(then($A, $B), then($FB, $FA))     :- flip_norm($B, $FB), flip_norm($A, $FA).
flip_norm(both($A, $B), both($FA, $FB))     :- flip_norm($A, $FA), flip_norm($B, $FB).
flip_norm(either($A, $B), either($FA, $FB)) :- flip_norm($A, $FA), flip_norm($B, $FB).
flip_norm(unless($A, $B), unless($FA, $FB)) :- flip_norm($A, $FA), flip_norm($B, $FB).
flip_norm(within($C, $E), within($C, $F))   :- flip_norm($E, $F).
flip_norm($A, flip($A))                     :- base_expr($A).

% ── (5) LE PROPRIETA' SEGUONO DALLA COSTRUZIONE ─────────────────────────────
% Un passo oltre `behaves like`: la' una proprieta' si eredita da un NOME
% simile, qui segue da COME la relazione e' fatta. «both(R, flip(R))» e'
% simmetrica per ogni R, prima che esista un solo fatto della relazione nuova:
% (x,y) vi appartiene esattamente quando R(x,y) e R(y,x), e scambiare x e y
% chiede le stesse due premesse. Anche l'ASSENZA di una legge e' informativa:
% l'unione di due transitive non e' transitiva, e qui non c'e' una clausola che
% lo dica — il sistema non distribuisce proprieta' per somiglianza.
% gen510 — PIU' DEFINIZIONI SONO UN'UNIONE, E LA PROPRIETA' DEVE VALERE PER
% L'UNIONE. «parent holds wherever mother» e «… wherever father» sono due
% supporti alternativi della stessa relazione: derivare una proprieta' da UNO
% dei due (come faceva la prima stesura) e' falso — se `mother` fosse
% funzionale, `parent` non lo sarebbe. Si ragiona sulla definizione intera:
% `either(D1, either(D2, …))`, e le leggi dell'unione decidono.
machinery(structural_def).
machinery(fold_union).
structural_def($V, $E) :- findall($D, relation_def($V, $D), $L), fold_union($L, $E).
fold_union(cons($D, nil), $D).
fold_union(cons($D, cons($D2, $T)), either($D, $R)) :- fold_union(cons($D2, $T), $R).
symmetric_relation($V)  :- structural_def($V, $D), norm_expr($D, $N), symmetric_form($N).
transitive_relation($V) :- structural_def($V, $D), norm_expr($D, $N), transitive_form($N).
reflexive_relation($V)  :- structural_def($V, $D), norm_expr($D, $N), reflexive_form($N).
functional_relation($V) :- structural_def($V, $D), norm_expr($D, $N), functional_form($N).

symmetric_form($R)               :- base_expr($R), symmetric_relation($R).
symmetric_form(flip($E))         :- symmetric_form($E).
symmetric_form(both($E, flip($E))).
symmetric_form(both(flip($E), $E)).
symmetric_form(either($E, flip($E))).
symmetric_form(either(flip($E), $E)).
symmetric_form(then($E, flip($E))).
symmetric_form(then(flip($E), $E)).
symmetric_form(both($A, $B))     :- symmetric_form($A), symmetric_form($B).
symmetric_form(either($A, $B))   :- symmetric_form($A), symmetric_form($B).
symmetric_form(unless($A, $B))   :- symmetric_form($A), symmetric_form($B).
symmetric_form(within($C, $E))   :- symmetric_form($E).

transitive_form($R)              :- base_expr($R), transitive_relation($R).
transitive_form(flip($E))        :- transitive_form($E).
transitive_form(both($A, $B))    :- transitive_form($A), transitive_form($B).
transitive_form(within($C, $E))  :- transitive_form($E).

reflexive_form($R)               :- base_expr($R), reflexive_relation($R).
reflexive_form(flip($E))         :- reflexive_form($E).
reflexive_form(both($A, $B))     :- reflexive_form($A), reflexive_form($B).
reflexive_form(either($A, $B))   :- reflexive_form($A).
reflexive_form(either($A, $B))   :- reflexive_form($B).
reflexive_form(then($A, $B))     :- reflexive_form($A), reflexive_form($B).
reflexive_form(within($C, $E))   :- reflexive_form($E).

functional_form($R)              :- base_expr($R), functional_relation($R).
functional_form(both($A, $B))    :- functional_form($A).
functional_form(both($A, $B))    :- functional_form($B).
functional_form(then($A, $B))    :- functional_form($A), functional_form($B).
functional_form(unless($A, $B))  :- functional_form($A).
functional_form(within($C, $E))  :- functional_form($E).

% ── (6) DUE DEFINIZIONI POSSONO ESSERE LA STESSA RELAZIONE ──────────────────
% Stessa forma normale, o la stessa a meno dell'ordine di `both`/`either`: la
% scheda lo dice («same as W»). E' il seme dell'analisi delle equivalenze; le
% leggi restano valide solo per relazioni pure a contesto fisso (§3.5).
machinery(same_relation).
same_relation($V, $W) :-
    structural_def($V, $D1), norm_expr($D1, $N),
    relation_def($W, $X2), structural_def($W, $D2), norm_expr($D2, $N2),
    dif($V, $W), same_form($N, $N2).
same_form($N, $N).
same_form(both($A, $B), both($B, $A)).
same_form(either($A, $B), either($B, $A)).

% ── (7) LA RESA IN PAROLE — cio' che parrot0 dice e' conoscenza (mantra #16) ─
machinery(expr_words).
expr_infix(both,   "both ",   " and ").
expr_infix(either, "either ", " or ").
expr_infix(then,   "",        " followed by ").
expr_infix(unless, "",        " except where ").
expr_suffix(flip,  " read backwards").

expr_words($R, $R)               :- base_expr($R).
expr_words(flip($E), $W)         :- expr_words($E, $A), expr_suffix(flip, $S), concat_atoms($A, $S, $W).
expr_words(both($A, $B), $W)     :- expr_pair_words(both, $A, $B, $W).
expr_words(either($A, $B), $W)   :- expr_pair_words(either, $A, $B, $W).
expr_words(then($A, $B), $W)     :- expr_pair_words(then, $A, $B, $W).
expr_words(unless($A, $B), $W)   :- expr_pair_words(unless, $A, $B, $W).
expr_words(within($C, $E), $W)   :- expr_words($E, $A), concat_atoms("in ", $C, $H), concat_atoms($H, ", ", $H2), concat_atoms($H2, $A, $W).
expr_words(use($C, $A), $W)      :- expr_words($A, $WA), concat_atoms($C, " ", $H), concat_atoms($H, $WA, $W).
expr_pair_words($F, $A, $B, $W) :-
    expr_infix($F, $Pre, $Mid), expr_words($A, $WA), expr_words($B, $WB),
    concat_atoms($Pre, $WA, $H1), concat_atoms($H1, $Mid, $H2), concat_atoms($H2, $WB, $W).

% la scheda rende la definizione intera, e le equivalenze scoperte
relation_note($V, $Note) :- relation_def($V, $D), expr_words($D, $W), concat_atoms("defined as ", $W, $Note).
relation_note($V, $Note) :- same_relation($V, $W), concat_atoms("same as ", $W, $Note).
% «how is V defined?»
machinery(relation_def_words).
relation_def_words($V, $W) :- relation_def($V, $D), expr_words($D, $W).

% ══ gen508/2 — IL FATTO COME NODO A RUOLI APERTI: `occurrence/2`, `role/3` ═══
%
% docs/plans/due-strutture-kb-viva.md §2 (F., 2026-09-11): «rendere variabile R
% in R(X,Y) lascia fissi numero, posizione e significato degli argomenti».
% Aggiungere a uno scambio chi riceve, quando e a quale titolo non deve
% obbligare a creare `scambio_con_data` e una nuova famiglia di lettori.
%
% La forma minima, costruita con cio' che la KB ha gia':
%
%     occurrence(O, R)      O e' un'istanza della relazione/evento R — cioe' un
%                           MEMBRO della categoria R («sale1 is a sale»)
%     role(O, Ruolo, V)     in O il ruolo vale V — cioe' il fatto binario
%                           `Ruolo_of(O, V)` che «the seller of sale1 is anna»
%                           gia' produce, per ogni ruolo dichiarato
%     relation_role(R, Ruolo)   lo schema: R ha quel ruolo (aperto: si estende)
%     required_role(R, Ruolo)   e quali ruoli deve avere per essere completa
%
% L'identita' dell'istanza e' l'atomo O: i ruoli restano COAPPARTENENTI a quella
% istanza e due vendite non si mescolano. Nessuna tabella universale: i predicati
% ordinari restano come sono, e questa e' l'interfaccia che li rende visibili
% attraverso un contratto di ruoli. Aggiungere un ruolo domani e' una riga di
% schema piu' i fatti; nessun consumer che chiede `role/3` deve cambiare.
machinery(occurrence).
machinery(role).
machinery(relation_role).
machinery(required_role).
machinery(role_name).

role_name($Role) :- relation_role($R, $Role).
% dichiarare un ruolo apre anche il lettore «the Ruolo of O is V» (grammar.p0,
% `relation_noun/2` sopra `relation/1`) e la domanda «what is the Ruolo of O?»
relation($Role) :- role_name($Role).

% (1) un'istanza e' un membro di una categoria che ha uno schema di ruoli.
occurrence($O, $R) :- relation_role($R, $Any), holds1($R, $O).

% (2) un ruolo e' il predicato binario `Ruolo_of` con l'istanza come soggetto.
role($O, $Role, $V) :-
    role_name($Role), concat_atoms($Role, "_of", $P),
    apply($P, cons($O, cons($V, nil))).

% (3) i fatti binari ordinari VISTI come nodi: `fact(R, X, Y)` e' l'identita'
%     dell'occorrenza, con i ruoli posizionali `subject` e `object`. Cosi' una
%     proiezione o una vista puo' parlare anche di cio' che e' gia' in KB.
occurrence(fact($R, $X, $Y), $R) :- relation_verb($R), apply($R, cons($X, cons($Y, nil))).
role(fact($R, $X, $Y), subject, $X).
role(fact($R, $X, $Y), object, $Y).

% (4) LA PROIEZIONE E' UN'ESPRESSIONE: due ruoli di un'istanza, e a scelta una
%     condizione su un terzo. Cosi' una proiezione compone con `flip`, `both`,
%     `then` e le costruzioni come qualunque altra definizione — e il verso
%     rovescio di una proiezione e' la proiezione con i ruoli scambiati.
%       roles(R, A, B)                       la A di una R verso la sua B
%       roles_where(R, A, B, is_a(C, K))     ...quando la sua C e' una K
eval_rel(roles($R, $A, $B), $X, $Y) :-
    occurrence($O, $R), role($O, $A, $X), role($O, $B, $Y).
eval_rel(roles_where($R, $A, $B, is_a($C, $K)), $X, $Y) :-
    occurrence($O, $R), role($O, $A, $X), role($O, $B, $Y),
    role($O, $C, $V), holds1($K, $V).
compound_expr(roles($R, $A, $B)).
compound_expr(roles_where($R, $A, $B, $C)).
norm_expr(roles($R, $A, $B), roles($R, $A, $B)).
norm_expr(roles_where($R, $A, $B, $C), roles_where($R, $A, $B, $C)).
flip_norm(roles($R, $A, $B), roles($R, $B, $A)).
flip_norm(roles_where($R, $A, $B, $C), roles_where($R, $B, $A, $C)).
expr_words(roles($R, $A, $B), $W) :-
    concat_atoms("the ", $A, $H1), concat_atoms($H1, " of a ", $H2),
    concat_atoms($H2, $R, $H3), concat_atoms($H3, " to its ", $H4),
    concat_atoms($H4, $B, $W).
expr_words(roles_where($R, $A, $B, is_a($C, $K)), $W) :-
    expr_words(roles($R, $A, $B), $H1), concat_atoms($H1, " when its ", $H2),
    concat_atoms($H2, $C, $H3), concat_atoms($H3, " is a ", $H4),
    concat_atoms($H4, $K, $W).

% la lezione «sold_to links the seller of a sale to its buyer» e' una famiglia
% come le altre: fornisce la descrizione, non un interprete.
machinery(relation_projection).
machinery(projection_condition).
has_condition($V) :- projection_condition($V, $C, $K).
relation_def($V, roles($R, $A, $B)) :-
    relation_projection($V, $R, $A, $B), naf(has_condition($V)).
relation_def($V, roles_where($R, $A, $B, is_a($C, $K))) :-
    relation_projection($V, $R, $A, $B), projection_condition($V, $C, $K).

% (5) CONOSCENZA PARZIALE SENZA FATTI FALSI. Un ruolo assente e' «non ancora
%     noto», non «inesistente»: la completezza e' relativa allo schema, e cio'
%     che manca e' interrogabile — e' lo spazio negativo della KB
%     (docs/plans/question-emergence.md) reso per ruoli.
has_role($O, $Role) :- role($O, $Role, $V).
missing_role($O, $Role) :- occurrence($O, $R), required_role($R, $Role), naf(has_role($O, $Role)).
occurrence_incomplete($O) :- missing_role($O, $Role).
occurrence_complete($O)   :- occurrence($O, $R), naf(occurrence_incomplete($O)).

% (6) LO STESSO EVENTO DA UN ALTRO PUNTO DI VISTA. `schema_view(Vista, R)` dice
%     che una vista legge le istanze di R; `role_alias(Vista, RuoloVista,
%     RuoloR)` dice come si chiamano i ruoli da li'. Un acquisto e' una vendita
%     vista dal compratore: stesse istanze, nessun fatto copiato, e la licenza
%     semantica e' la dichiarazione della vista, non la somiglianza dei nomi.
machinery(schema_view).
machinery(role_alias).
occurrence($O, $View) :- schema_view($View, $R), occurrence($O, $R).
role($O, $VRole, $V)  :- role_alias($View, $VRole, $SRole), schema_view($View, $R), occurrence($O, $R), role($O, $SRole, $V).
relation_role($View, $VRole) :- role_alias($View, $VRole, $SRole).

% (7) LA SCHEDA DI UN'ISTANZA: ruoli noti e ruoli mancanti — cio' che parrot0
%     dice e' conoscenza (mantra #16).
machinery(occurrence_note).
occurrence_note($O, $Note) :- role($O, $Role, $V), concat_atoms($Role, ": ", $H), concat_atoms($H, $V, $Note).
occurrence_note($O, $Note) :- missing_role($O, $Role), concat_atoms("missing: ", $Role, $Note).
% e la scheda di uno schema: quali ruoli ha, quali richiede
schema_note($R, $Note) :- relation_role($R, $Role), naf(required_role($R, $Role)), concat_atoms("has a ", $Role, $Note).
schema_note($R, $Note) :- required_role($R, $Role), concat_atoms("requires a ", $Role, $Note).
schema_note($V, $Note) :- schema_view($V, $R), concat_atoms("a view of ", $R, $Note).

% (t) LA FAMIGLIA di una relazione — temporale, spaziale, sociale, causale.
%     Serve a chi insegna per orientarsi, e a parrot0 per dire che cosa sa di un
%     GENERE di legame invece che di un legame preciso.
machinery(relation_family).
relation_note($V, $Note) :-
    relation_family($V, $Fam), concat_atoms("a ", $Fam, $Half),
    concat_atoms($Half, " relation", $Note).
