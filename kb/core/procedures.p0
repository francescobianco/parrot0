answer_plan(mechanism_analysis, framing, 0, required).
answer_plan(ethical_analysis, framing, 0, required).
answer_plan(investigation_analysis, framing, 0, required).
answer_plan(risk_analysis, framing, 0, required).
answer_plan(interpretive_analysis, framing, 0, required).
answer_plan(comparison_analysis, framing, 0, required).
answer_plan(advice_analysis, framing, 0, required).

