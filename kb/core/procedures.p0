% ── PROCEDURE COMPUTAZIONALI ─────────────────────────────────────────────────────
% "Anche le PROCEDURE sono conoscenza" (F., [[teachable-procedures]]): saper sommare,
% ignorare i dispari, risolvere una relazione — è KB, non un consumer C. Il motore
% tiene solo i PRIMITIVI di valutazione (gen335, src/kb.c):
%   is($R, Expr)              valuta Expr e lega $R      (Expr: add/sub/mul/div/mod, annidabili)
%   lt/le/gt/ge/eq/ne($A,$B)  confrontano (valutano entrambi i lati come espressioni)
% Da qui OGNI procedura di calcolo si insegna come clausola. Nomi predicato freschi;
% liste in forma cons($H,$T)/nil. Questo file è il HOME dove il save-map instraderà
% le procedure future accanto alle loro parenti.

% Self-research profiles and capability descriptions are data, not C phrasebooks.
machinery(module_capability).
module_capability(knowledge, "answer questions about facts and logical rules").
module_capability(arith, "compute arithmetic (plus, minus, times, divisible by)").
module_capability(cause, "reason about cause and effect relations").
module_capability(compare, "compare magnitudes (more/less than)").
module_capability(memory, "remember your name, possessions, and personal facts").
module_capability(reader, "read a passage and extract known fact patterns").
module_capability(shell, "explain shell commands and predict their output").
module_capability(gen, "generate text continuations from learned sequences").
module_capability(self, "answer questions about my own identity and capabilities").
module_capability(meta, "handle meta-conversation (attention, understanding)").
module_capability(discourse, "remember what topics we discussed").
module_capability(social, "handle greetings, thanks, and social conventions").
module_capability(symbolic, "recognize symbolic patterns (Morse, leet, palindromes)").
machinery(social_act_type).
social_act_type(goodnight).
social_act_type(felicitation).
social_act_type(wellwish).
social_act_type(condolence).
social_act_type(blessing).
social_act_type(politeness).

% -- parità (l'esempio di F.: "saper ignorare i dispari" è conoscenza) --

% -- relazione lineare ASTRATTA: A*B=C, risolvibile in ogni direzione nota --
% copre tasso·tempo=distanza, prezzo·quantità=totale, ecc. con UN operatore.
% quanto tempo perché il secondo raggiunga il primo, dato il vantaggio e le velocità
% (schema catch-up generale, non "i treni"): tempo = vantaggio / (v2 - v1)

% -- fold su lista: somma, conteggio, massimo (aggregazione astratta) --

% -- filtro su lista: tieni i pari, scarta i dispari (map/filter astratto) --
% ── LOGICAL OPERATORS (transitive closures, bridge, same_category) (scattered from mesh-session.p0, gen335) ──
even($X) :- eq(mod($X, 2), 0).
odd($X)  :- eq(mod($X, 2), 1).
product($A, $B, $C) :- is($C, mul($A, $B)).      % noti A,B → C
factor($C, $B, $A)  :- is($A, div($C, $B)).      % noti C,B → A
catch_up($Head, $V1, $V2, $T) :- gt($V2, $V1), is($T, div($Head, sub($V2, $V1))).
sum_list(nil, 0).
sum_list(cons($H, $T), $S) :- sum_list($T, $S1), is($S, add($H, $S1)).
count_list(nil, 0).
count_list(cons($H, $T), $N) :- count_list($T, $N1), is($N, add($N1, 1)).
max_list(cons($X, nil), $X).
max_list(cons($H, $T), $M) :- max_list($T, $M1), ge($H, $M1), is($M, $H).
max_list(cons($H, $T), $M) :- max_list($T, $M1), lt($H, $M1), is($M, $M1).
drop_odds(nil, nil).
drop_odds(cons($H, $T), cons($H, $R)) :- even($H), drop_odds($T, $R).
drop_odds(cons($H, $T), $R) :- odd($H), drop_odds($T, $R).
causes_t($X, $Z) :- causes($X, $Y), causes($Y, $Z).
causes_t($X, $Z) :- causes($X, $Y), causes_t($Y, $Z).
enables_t($X, $Z) :- enables($X, $Y), enables($Y, $Z).
enables_t($X, $Z) :- enables($X, $Y), enables_t($Y, $Z).
faster_than_t($X, $Z) :- faster_than($X, $Y), faster_than($Y, $Z).
faster_than_t($X, $Z) :- faster_than($X, $Y), faster_than_t($Y, $Z).
heavier_than_t($X, $Z) :- heavier_than($X, $Y), heavier_than($Y, $Z).
heavier_than_t($X, $Z) :- heavier_than($X, $Y), heavier_than_t($Y, $Z).
is_a_t($X, $Y) :- is_a($X, $Y).
is_a_t($X, $Z) :- is_a($X, $Y), is_a_t($Y, $Z).
kind_of_t($X, $Z) :- kind_of($X, $Y), kind_of($Y, $Z).
kind_of_t($X, $Z) :- kind_of($X, $Y), kind_of_t($Y, $Z).
larger_than_t($X, $Z) :- larger_than($X, $Y), larger_than($Y, $Z).
larger_than_t($X, $Z) :- larger_than($X, $Y), larger_than_t($Y, $Z).
% Relazioni geografiche specializzate alimentano una sola vista spaziale. La
% guardia continent_of/2 distingue il verso canonico di capital_of_country/2
% dalle vecchie righe inverse ancora presenti nella base; stato e regione hanno
% gia' un verso univoco nel contratto dei rispettivi predicati.
located_in($Country, $Continent) :- continent_of($Country, $Continent).
located_in($Region, $Country) :- region_of_country($Region, $Country).
administrative_capital($Capital, $Country) :- capital_of_country($Country, $Capital), continent_of($Country, $Continent).
administrative_capital($Capital, $State) :- capital_of_state($State, $Capital).
administrative_capital($Capital, $Region) :- capital_of_region($Region, $Capital).
located_in($Capital, $Area) :- administrative_capital($Capital, $Area).
located_in_t($X, $Z) :- located_in($X, $Z).
located_in_t($X, $Z) :- located_in($X, $Y), located_in($Y, $Z).
located_in_t($X, $Z) :- located_in($X, $Y), located_in_t($Y, $Z).
located_in_t($Capital, $Region) :- capital_of_region($Region, $Capital).
located_in_t($Region, $Country) :- region_of_country($Region, $Country).
located_in_t($Capital, $Country) :- capital_of_region($Region, $Capital), region_of_country($Region, $Country).
part_of_t($X, $Z) :- part_of($X, $Y), part_of($Y, $Z).
part_of_t($X, $Z) :- part_of($X, $Y), part_of_t($Y, $Z).
same_category($X, $Y) :- category_member($C, $X), category_member($C, $Y).

% Una misura di peso diventa una relazione binaria interrogabile dal consumer
% universale answer_frame/2. Il dimensionamento e' conoscenza: il motore non
% contiene una nozione speciale di "peso".
weight_of($Item, $Value) :- magnitude(weight, $Item, $Value).

% ── ENUMERAZIONE DI CATEGORIE ────────────────────────────────────────────────
% La superficie individua una categoria e la clausola GENERA una soluzione per
% membro. answer_frame/2 sa già presentare tutte le soluzioni di una qualunque
% relazione binaria: non serve un secondo enumeratore di dominio in C. Nessun
% consumer conosce "scacchi", la cardinalità o i membri; una nuova
% category_surface/2 o category_member/2 entra in uso immediatamente a runtime.
category_enumeration($Surface, $Member) :-
    category_surface($Surface, $Category),
    category_member($Category, $Member).

% A game expert's concise identity is the ordinary means/2 fact, projected
% through its declared domain so "what is X" does not fall through to a raw dump
% of every setup, rule and tip attached to X.
game_summary($Game, $Summary) :-
    expert_domain($Game, games),
    means($Game, $Summary).

% Cross-domain humanities projection.  Topic membership and summaries are facts
% owned by the expert files; the procedure is shared by literature, philosophy,
% anthropology, art history and world history.
humanities_summary($Topic, $Summary) :-
    humanities_topic($Topic),
    means($Topic, $Summary).

% Quali relazioni binarie possono fornire la proiezione minima di una
% definizione tassonomica e' conoscenza. `apply/2` tiene l'adattatore aperto:
% una relazione nuova entra (o esce) a runtime registrando una sola riga.
definition_relation(is_a).
definition_value($Entity, $Kind) :-
    definition_relation($Relation),
    apply($Relation, cons($Entity, cons($Kind, nil))).
machinery(definition_relation).
machinery(definition_value).

% Normalized view of the split invented_object/2 + trait/3 representation.  It
% keeps every callable relation within the engine's four-argument contract and
% makes a newly taught object's taste immediately answerable by answer_frame/2.
invented_object_taste($Name, $Taste) :-
    invented_object($Domain, $Name),
    invented_object_trait($Name, taste, $Taste).

% ── RELATIONAL COMPOSITION (habitat, diet) ──
lives_in($X, $H) :- is_a($X, $C), habitat($C, $H).
diet($X, $D) :- is_a($X, $C), eats_category($C, $D).

% ── TEMPORAL REASONING ──
period_contains_t($X, $Z) :- period_contains($X, $Y), period_contains($Y, $Z).
period_contains_t($X, $Z) :- period_contains($X, $Y), period_contains_t($Y, $Z).
happened_during($E, $P) :- happened_in($E, $Y), period_contains_t($P, $Y).

% ── MATH PROCEDURES (factorial, fibonacci, gcd, lcm, prime, power) ──
factorial(0, 1).
factorial($N, $R) :- gt($N, 0), is($N1, sub($N, 1)), factorial($N1, $R1), is($R, mul($N, $R1)).

fib(0, 0).
fib(1, 1).

gcd($A, 0, $A).
gcd($A, $B, $R) :- gt($B, 0), is($M, mod($A, $B)), gcd($B, $M, $R).

lcm($A, $B, $L) :- gcd($A, $B, $G), is($L, div(mul($A, $B), $G)).

is_prime(2).
is_prime(3).
is_prime($N) :- gt($N, 3), is($M, mod($N, 2)), gt($M, 0), no_divisor($N, 3).
no_divisor($N, $D) :- is($D2, mul($D, $D)), gt($D2, $N).
no_divisor($N, $D) :- is($M, mod($N, $D)), gt($M, 0), is($D2, add($D, 2)), no_divisor($N, $D2).

power($B, 0, 1).
power($B, $E, $R) :- gt($E, 0), is($E1, sub($E, 1)), power($B, $E1, $R1), is($R, mul($B, $R1)).

choose($N, $K, $R) :- is($R, binom($N, $K)).

valid_hypergeom_take(hg($K, $O, $D, $X)) :- le($X, $K), le($X, $D), is($Y, sub($D, $X)), le($Y, $O).
skip_hypergeom_take(hg($K, $O, $D, $X)) :- le($X, $K), le($X, $D), is($Y, sub($D, $X)), gt($Y, $O).
hypergeom_term(hg($K, $O, $D, $X), $Term) :- is($Y, sub($D, $X)), choose($K, $X, $A),
                                             choose($O, $Y, $B), is($Term, mul($A, $B)).
fav_at_least(hg($K, $O, $D, $X), 0) :- gt($X, $K).
fav_at_least(hg($K, $O, $D, $X), 0) :- gt($X, $D).
fav_at_least(hg($K, $O, $D, $X), $R) :- skip_hypergeom_take(hg($K, $O, $D, $X)),
                                        is($X1, add($X, 1)), fav_at_least(hg($K, $O, $D, $X1), $R).
fav_at_least(hg($K, $O, $D, $X), $R) :- valid_hypergeom_take(hg($K, $O, $D, $X)),
                                        hypergeom_term(hg($K, $O, $D, $X), $Term),
                                        is($X1, add($X, 1)), fav_at_least(hg($K, $O, $D, $X1), $Rest),
                                        is($R, add($Term, $Rest)).
probability_procedure(probability_at_least_count, favorable, fav_at_least).
probability_procedure(probability_at_least_count, denominator, choose).
probability_procedure(inverse_pair_probability, solver, integer_pair_search).

is_even($N) :- eq(mod($N, 2), 0).
is_odd($N) :- eq(mod($N, 2), 1).

% ── LIST OPERATIONS ──
member($X, cons($X, $T)).
member($X, cons($H, $T)) :- member($X, $T).
append_list(nil, $L, $L).
append_list(cons($H, $T), $L, cons($H, $R)) :- append_list($T, $L, $R).

% Comporre una forma d'uscita da un valore provato e' realizzazione, non
% contenuto: la punteggiatura terminale e' una proprieta' della lingua, non del
% modulo che ha calcolato il valore. chars/2 e append_list/3 bastano, quindi
% nessun renderer deve concatenare stringhe in C per aggiungere un punto.
concat_atoms($A, $B, $AB) :- chars($A, $CA), chars($B, $CB), append_list($CA, $CB, $CAB), chars($AB, $CAB).
sentence_terminator(en, ".").
sentence_terminator(it, ".").
value_sentence($Language, $Value, $Text) :- sentence_terminator($Language, $Mark), concat_atoms($Value, $Mark, $Text).

% gen393: APRIRE una frase e' la simmetrica di chiuderla, e sta allo stesso
% livello. Il terminatore era gia' un fatto di lingua; la maiuscola iniziale no,
% quindi ogni realizzazione composta dalla proof usciva minuscola mentre ogni
% modulo C capitalizzava per conto suo. `sentence_initial/2` e' il dato — una
% lingua o un registro che non apre in maiuscolo e' una riga, non un ramo — e il
% motore offre soltanto la trasformazione, che non conosce lingue.
sentence_initial(en, upper).
sentence_initial(it, upper).
sentence_opening($Language, $Value, $Piece) :- sentence_initial($Language, upper), upcase_first($Value, $Piece).
sentence_opening($Language, $Value, $Value) :- naf(sentence_initial($Language, upper)).
% gen505z — e il valore si RENDE prima di aprirlo. La politica esiste dal
% gen505c (`present_rule(strip_underscore)`), ma solo il C poteva applicarla:
% una risposta composta qui usciva «Central_nivoran_sea.», cioe' la chiave con
% cui il motore indicizza. `present_term/2` e' la stessa politica resa
% interrogabile — un nome proprio resta com'e', perche' `proper_name/1` lo dice.
value_statement($Language, $Value, $Text) :- present_term($Value, $Shown), sentence_opening($Language, $Shown, $Opened), value_sentence($Language, $Opened, $Text).

% gen395: un valore provato e' un TERMINE della KB, e i termini sono canonici.
% Renderlo nella lingua del turno e' realizzazione, non contenuto: la stessa
% proof dice `lombardy` e `Lombardia` senza che cambi cio' che afferma. Il verso
% di `tr/2` e' gia' il contratto — primo argomento canonico, secondo italiano —
% e una lingua nuova entra come fatto, non come ramo.
% gen396: prima il REGISTRO, poi la lingua. Se il contesto ha dichiarato una
% preferenza e il concetto ha una forma non marcata in quel registro, quella
% forma e' gia' nella lingua giusta — `concept_label/4` porta entrambi gli assi.
% Senza preferenza dichiarata non cambia nulla: le tre clausole storiche restano
% e il livello e' additivo.
% La scala della realizzazione, dalla forma piu' informata alla piu' nuda:
% il registro preferito; una qualunque forma non marcata della lingua; la
% traduzione; il termine canonico. La guardia `naf(marked_form(...))` sta su
% OGNI gradino, non solo sul primo: la regola del gen390 — capire una forma
% marcata non obbliga a rispecchiarla — sarebbe stata falsa se la
% localizzazione ordinaria avesse continuato a emettere `mangiare` mentre il
% registro si rifiutava di farlo. Misurato, ed e' il motivo per cui la scala
% esiste al posto di una clausola sola.
translated_term($Value) :- tr($Value, $Local).
lexical_output($Value, $Language, $Form) :- register_output($Value, $Language, $Form).
lexical_output($Value, $Language, $Form) :- register_marked($Value, $Language), concept_label($Value, $Language, $Register, $Form), naf(marked_form($Form)).
machinery(default_register).
default_register(common).
lexical_output($Value, $Language, $Form) :- naf(register_renders($Value, $Language)), default_register($Register), concept_label($Value, $Language, $Register, $Form), naf(marked_form($Form)).
lexical_renders($Value, $Language) :- lexical_output($Value, $Language, $Form).
value_in_language($Language, $Value, $Form) :- lexical_output($Value, $Language, $Form).
value_in_language(en, $Value, $Value) :- naf(lexical_renders($Value, en)).
value_in_language(it, $Value, $Local) :- naf(lexical_renders($Value, it)), tr($Value, $Local), naf(marked_form($Local)).
value_in_language(it, $Value, $Value) :- naf(lexical_renders($Value, it)), naf(translated_term($Value)).

% ── PIANO PROPOSIZIONALE (K6): prima COSA va detto, poi COME dirlo ──
%
% Una risposta composta e' una sequenza ordinata di pezzi, e ogni pezzo porta il
% proprio RUOLO. Il ruolo e' la parte che si puo' interrogare e criticare: dice
% se quel pezzo e' una proposizione provata o soltanto un connettivo di lingua.
% Il fold qui sotto non sa nulla dei ruoli — puo' soltanto mettere in fila cio'
% che qualcun altro ha gia' dimostrato — quindi un renderer non ha modo di
% introdurre un claim che la proof non contiene: e' la garanzia strutturale che
% `docs/plans/frontier-kb-natural-dialogue.md` §K6 chiede al posto delle risposte
% terminali.
%
% Le posizioni sono contigue da 0. La coda si chiude sull'ULTIMO pezzo invece che
% su un atomo vuoto: cosi' la ricorsione non ha bisogno di una costante di lingua
% per fermarsi.
answer_has_content($Answer, $Position) :- answer_content($Answer, $Position, $Role, $Text).
answer_tail($Answer, $Position, $Piece) :- answer_content($Answer, $Position, $Role, $Piece), is($Next, add($Position, 1)), naf(answer_has_content($Answer, $Next)).
answer_tail($Answer, $Position, $Text) :- answer_content($Answer, $Position, $Role, $Piece), is($Next, add($Position, 1)), answer_has_content($Answer, $Next), answer_tail($Answer, $Next, $Rest), concat_atoms($Piece, $Rest, $Text).
answer_text($Answer, $Text) :- answer_tail($Answer, 0, $Text).

% ── PROPERTY INHERITANCE (ordine superiore: le proprietà si ereditano lungo la tassonomia) ──
inherits($X, $P) :- is_a($X, $C), has_prop($C, $P).
inherits($X, $P) :- is_a_t($X, $C), has_prop($C, $P).
inherits($X, $P) :- kind_of_t($X, $C), has_prop($C, $P).

% ── KINSHIP COMPOSITION ──
child_of($X, $Y) :- parent_of($Y, $X).
uncle_of($X, $Z) :- sibling_of($X, $Y), parent_of($Y, $Z).
aunt_of($X, $Z) :- sibling_of($X, $Y), parent_of($Y, $Z).
nephew_of($X, $Z) :- uncle_of($Z, $X).
niece_of($X, $Z) :- aunt_of($Z, $X).
cousin_of($X, $Z) :- parent_of($P1, $X), parent_of($P2, $Z), sibling_of($P1, $P2).

% ── DIRECTIONAL SPATIAL (transitivo) ──
north_of_t($X, $Z) :- north_of($X, $Y), north_of($Y, $Z).
north_of_t($X, $Z) :- north_of($X, $Y), north_of_t($Y, $Z).
east_of_t($X, $Z) :- east_of($X, $Y), east_of($Y, $Z).
east_of_t($X, $Z) :- east_of($X, $Y), east_of_t($Y, $Z).
south_of($X, $Y) :- north_of($Y, $X).
west_of($X, $Y) :- east_of($Y, $X).

% ── INVERSE RELATIONS ──
smaller_than($X, $Y) :- larger_than($Y, $X).
lighter_than($X, $Y) :- heavier_than($Y, $X).
slower_than($X, $Y) :- faster_than($Y, $X).
owned_by($X, $Y) :- owns($Y, $X).

% ── CONTAINMENT ──
contains_t($X, $Z) :- contains($X, $Y), contains($Y, $Z).
contains_t($X, $Z) :- contains($X, $Y), contains_t($Y, $Z).
contained_in($X, $Y) :- contains($Y, $X).

% ── L4: ONTOLOGY OPERATORS ──
transitive($R) :- relation_type($R, transitive).
symmetric($R) :- relation_type($R, symmetric).
asymmetric($R) :- relation_type($R, asymmetric).
domain_predicates($D, $P) :- predicate_domain($P, $D).

% ── L5: SEMANTIC NETWORK ──
node($X) :- is_a($X, $Y).
node($Y) :- is_a($X, $Y).
node($X) :- capital_of_country($X, $Y).
node($Y) :- capital_of_country($X, $Y).
node($X) :- larger_than($X, $Y).
node($X) :- causes($X, $Y).
node($X) :- category_member($C, $X).
edge($X, $Y, is_a) :- is_a($X, $Y).
edge($X, $Y, part_of) :- part_of($X, $Y).
edge($X, $Y, capital_of) :- capital_of_country($X, $Y).
edge($X, $Y, larger_than) :- larger_than($X, $Y).
edge($X, $Y, causes) :- causes($X, $Y).
path_exists($X, $Y, $R) :- edge($X, $Y, $R).
path_exists($X, $Z, $R) :- edge($X, $Y, $R), path_exists($Y, $Z, $R).

% ── L6: SELF-MODEL ──
kb_knows_about($D) :- predicate_domain($P, $D).
kb_has_facts_about($X) :- node($X).
kb_can_answer(capital) :- capital_of_country($X, $Y).
kb_can_answer(definition) :- means($X, $Y).
kb_can_answer(inventor) :- invented_by($X, $Y).

% ── L7: FORM-TO-PREDICATE MAPPING ──
form_maps_to($F, $P) :- question_form($F, identity_lookup), answer_frame($F, $P).

% ── L8: ARGUMENTATION ──
valid_syllogism($A, $B, $C) :- is_a($A, $B), is_a($B, $C).
justified($C, $P) :- argument(conclusion, $C), argument(premise, $P), argument_supports($P, $C).

% ═══════════════════════════════════════════════════════════
% L10 — PROOF TREES & EXPLANATION CHAINS
% ═══════════════════════════════════════════════════════════

% reason_for/3: X has property P because of rule R and supporting fact C
reason_for($X, $P, inherits) :- inherits($X, $P), is_a($X, $C), has_prop($C, $P).
reason_for($X, $P, direct) :- has_prop($X, $P).

% explains/2: one-step explanation
explains(inherits($X, $P), is_a($X, $C)) :- inherits($X, $P), is_a($X, $C), has_prop($C, $P).
explains(inherits($X, $P), has_prop($C, $P)) :- inherits($X, $P), is_a($X, $C), has_prop($C, $P).

% deduction_chain/3: A derives B via intermediate C
deduction_chain($A, $B, is_a) :- is_a_t($A, $B).
deduction_chain($A, $B, kind_of) :- kind_of_t($A, $B).
deduction_chain($A, $B, causes) :- causes_t($A, $B).
deduction_chain($A, $B, larger_than) :- larger_than_t($A, $B).
deduction_chain($A, $B, heavier_than) :- heavier_than_t($A, $B).
deduction_chain($A, $B, faster_than) :- faster_than_t($A, $B).
deduction_chain($A, $B, part_of) :- part_of_t($A, $B).
deduction_chain($A, $B, located_in) :- located_in_t($A, $B).
deduction_chain($A, $B, north_of) :- north_of_t($A, $B).
deduction_chain($A, $B, east_of) :- east_of_t($A, $B).
deduction_chain($A, $B, contains) :- contains_t($A, $B).
deduction_chain($A, $B, after_time) :- after_in_time($A, $B).

% ═══════════════════════════════════════════════════════════
% L11 — INDUCTION & GENERALIZATION
% ═══════════════════════════════════════════════════════════

% generalize/3: from examples (A has P, B has P) infer that category C has P
generalize($C, $P, $E1) :- category_member($C, $E1), has_prop($E1, $P),
                            category_member($C, $E2), has_prop($E2, $P).
generalize($C, $P, $E2) :- category_member($C, $E2), has_prop($E2, $P),
                            category_member($C, $E1), has_prop($E1, $P).

% all_have/2: every member of category C has property P (induced)
% A property is universal if no counterexample exists
counterexample($C, $P, $X) :- category_member($C, $X), naf(has_prop($X, $P)),
                               naf(inherits($X, $P)).

% typical/2: most members have P (non-universal, inductive)
typical($C, $P) :- category_member($C, $X), has_prop($X, $P),
                    naf(counterexample($C, $P, $X)).

% ═══════════════════════════════════════════════════════════
% L12 — CONSISTENCY & CONSTRAINT CHECKING
% ═══════════════════════════════════════════════════════════

% contradiction/0: the KB contains a contradiction
contradiction($X) :- is_a($X, $C1), is_a($X, $C2),
                      incompatible($C1, $C2).

% constraint_violation/2: X violates constraint C
constraint_violation($X, unique_capital) :- capital_of_country($C, $X1),
                                             capital_of_country($C, $X2).

% ═══════════════════════════════════════════════════════════
% TEMPORAL DURATION & INTERVALS
% ═══════════════════════════════════════════════════════════

% happened_between/3: event E happened between years Y1 and Y2
happened_between($E, $Y1, $Y2) :- happened_in($E, $Y),
                                   ge($Y, $Y1), le($Y, $Y2).

% same_era/2: two events happened in the same period
same_era($E1, $E2) :- happened_during($E1, $P), happened_during($E2, $P).

% ═══════════════════════════════════════════════════════════
% NUMERICAL RANGE & CLASSIFICATION
% ═══════════════════════════════════════════════════════════

% between_values/3: V is between Min and Max (inclusive)
between_values($V, $Min, $Max) :- ge($V, $Min), le($V, $Max).

% heavier_than_value/3: X is heavier than V kg
heavier_than_value($X, $V) :- mass_of($X, $M), gt($M, $V).

% ═══════════════════════════════════════════════════════════
% Q9 / ANALOGICAL REASONING (KB knowledge, gen335 round-3)
% ═══════════════════════════════════════════════════════════

% Recognize common numeric relationships between two numbers
num_relation($X, $Y, square) :- is($Y, mul($X, $X)).
num_relation($X, $Y, double) :- is($Y, mul($X, 2)).
num_relation($X, $Y, triple) :- is($Y, mul($X, 3)).
num_relation($X, $Y, half) :- is($Y, div($X, 2)).
num_relation($X, $Y, add_1) :- is($Y, add($X, 1)).
num_relation($X, $Y, add_2) :- is($Y, add($X, 2)).
num_relation($X, $Y, add_5) :- is($Y, add($X, 5)).

% Given a W:Z pair, find A:B with the same relationship
analogy_answer($A, $B, $W, $Z) :- num_relation($W, $Z, $R), num_relation($A, $B, $R).
% Minimal non-trivial: 2:4 is the smallest square after 1:1
canonical_analogy($W, $Z, $A, $B) :- num_relation($W, $Z, $R),
    num_relation($A, $B, $R),
    naf(num_relation($A, $A, $R)).

% gen343 (KB-first gaps): unit conversion as procedural knowledge.
% Adding a new conversion is one rule here — zero C code.
fahrenheit_to_celsius($F, $C) :- is($C, div(mul(sub($F, 32), 5), 9)).
celsius_to_fahrenheit($C, $F) :- is($F, add(div(mul($C, 9), 5), 32)).
km_to_miles($KM, $M) :- is($M, div(mul($KM, 62137), 100000)).
miles_to_km($M, $KM) :- is($KM, div(mul($M, 100000), 62137)).

% gen350 (LLMSCORE): closing time for two movers heading toward each other.
% C only binds the numeric slots from language; the computation lives here.
approach_speed($V1, $V2, $V) :- is($V, add($V1, $V2)).
meet_time($D, $V1, $V2, $T) :- approach_speed($V1, $V2, $V), is($T, div($D, $V)).

% gen351 (LLMSCORE-max): domain schemas live here; C binds roles from language.
% Generic paired-dimension algebra: a doubled sum (e.g. rectangle perimeter) and
% a ratio between the parts determine the small and large component.
paired_dimensions_from_doubled_sum_ratio($DoubledSum, $K, $Small, $Large) :-
    is($HalfSum, div($DoubledSum, 2)),
    is($Small, div($HalfSum, add($K, 1))),
    is($Large, mul($K, $Small)).
rectangle_dimensions_from_perimeter_ratio($P, $K, $W, $L) :-
    paired_dimensions_from_doubled_sum_ratio($P, $K, $W, $L).
proportional_cost($Batch, $BatchPrice, $Quantity, $Cost) :-
    is($Cost, div(mul($Quantity, $BatchPrice), $Batch)).
change_due($Paid, $Cost, $Change) :- is($Change, sub($Paid, $Cost)).
digit_count_between($Digit, $Low, $High, $Count) :-
    digit_count_between_prim($Digit, $Low, $High, $Count).
country_with_two_border_constraints($Country) :-
    border_count($Country, 2),
    borders($Country, $EuroNeighbor),
    currency_of_country($EuroNeighbor, euro),
    borders($Country, $SeaNeighbor),
    sea_borders($SeaNeighbor, mediterranean_sea),
    sea_borders($SeaNeighbor, black_sea),
    dif($EuroNeighbor, $SeaNeighbor).

% gen356 (LLMSCORE-max): one binary semantic view over the existing
% wiki_concept/3 corpus. answer_frame already consumes binary relations, so this
% projection makes every loaded concept available to several request acts without
% a C branch or a prompt-specific reply. Multi-word concepts are reached through
% semantic_alias/2; adding or retracting an alias changes resolution at runtime.
semantic_summary($Topic, $Text) :-
    wiki_concept($Topic, $Domain, $Text).
% A definition learned in dialogue must enter the same candidate vocabulary
% as a boot-time concept. Its name is evidence; its prose is the answer.
semantic_topic_cue($Topic, keyword($Topic)) :- concept($Topic, $Text).
semantic_summary($Topic, $Text) :- concept($Topic, $Text).
semantic_summary($Surface, $Text) :-
    semantic_alias($Surface, $Topic),
    wiki_concept($Topic, $Domain, $Text).
semantic_summary($Topic, $Text) :-
    explanation($Topic, $Text).
semantic_summary($Surface, $Text) :-
    semantic_alias($Surface, $Topic),
    explanation($Topic, $Text).
semantic_summary($Topic, $Text) :-
    because($Topic, $Text).
semantic_summary($Surface, $Text) :-
    semantic_alias($Surface, $Topic),
    because($Topic, $Text).
% Anche i domini specialistici gia' presenti nella KB devono essere interrogabili
% dalla stessa faccetta semantica: il consumer non deve conoscere gli scacchi.
semantic_summary($Topic, $Text) :- game_goal($Topic, $Text).
semantic_summary($Topic, $Text) :-
    current_language(it),
    game_play_localized($Topic, it, $Text).
semantic_summary($Topic, $Text) :-
    naf(current_language(it)),
    game_play($Topic, $Text).
machinery(semantic_summary).
machinery(projection_gate).
machinery(semantic_topic_gate).
projection_gate(semantic_summary, semantic_topic_gate).

% gen440 — indirizzamento interno prima di qualunque sorgente esterna.
% L'indirizzo non e' un URL scritto nel C: e' una tupla KB che conserva lingua
% della pagina, edizione, titolo, revisione e sezione.  Le forme superficiali
% sono risolte attraverso alias, traduzioni e locuzioni insegnabili a runtime.
address_identity($Surface, $Concept) :-
    semantic_alias($Surface, $Concept).
address_identity($Surface, $Concept) :-
    entity_alias($Surface, $Concept).
% Un nome appreso deve indirizzare lo stesso concetto, non restare un fatto
% raccontabile ma inutilizzabile da chi riconosce quel nome nel turno.
entity_alias($Surface, $Concept) :- also_known_as($Concept, $Surface).
address_identity($Surface, $Concept) :-
    phrase_form($Surface, $Concept, $Language, $Register).
address_identity($Surface, $Concept) :-
    linguistic_form($Surface, $Concept, $Language, $Register).
address_identity($Surface, $Concept) :-
    tr($Concept, $Surface).

address_relation($Concept, $Relation, $Shape) :-
    internal_relation($Concept, $Relation, $Shape, $Value).

address_target($Surface, $Relation, $Shape, $Concept) :-
    address_identity($Surface, $Concept),
    address_relation($Concept, $Relation, $Shape).

address_internal($Surface, $Relation, $Shape,
                 internal($Concept, $Relation, $Shape)) :-
    address_identity($Surface, $Concept),
    address_relation($Concept, $Relation, $Shape).

address_external($Surface, $Relation, $Shape, $Address) :-
    address_target($Surface, $Relation, $Shape, $Concept),
    source_address($Concept, $Address).

source_address($Concept,
               address($Language, $Edition, $Title, revision($Revision, $Section))) :-
    source_page($Concept, $Language, $Edition, $Title),
    source_revision($Title, $Revision),
    source_section($Title, $Section).

% Uno stop e' positivo: impedisce un fetch quando identita', relazione o shape
% non sono determinati.  La query resta leggibile e il chiamante puo' chiedere
% esattamente il prerequisito mancante.
address_stop($Surface, $Relation, $Shape) :-
    naf(address_identity($Surface, $Concept)).
address_stop($Surface, $Relation, $Shape) :-
    address_identity($Surface, $Concept),
    naf(address_relation($Concept, $Relation, $Shape)).
address_stop($Surface, $Relation, $Shape) :-
    address_identity($Surface, $Concept),
    address_relation($Concept, $Relation, $Shape),
    naf(address_external($Surface, $Relation, $Shape, $Address)).

machinery(address_identity).
machinery(address_relation).
machinery(address_target).
machinery(address_internal).
machinery(address_external).
machinery(address_stop).
machinery(source_address).
machinery(source_claim).
machinery(source_candidate).
machinery(source_supported).
machinery(source_replay).
machinery(campaign_claim).
machinery(campaign_required).
machinery(campaign_dependency).
machinery(campaign_quarantine).
machinery(campaign_promote).
machinery(campaign_rollback).
machinery(campaign_replay).
machinery(live_cycle).
machinery(live_cycle_ready).
machinery(live_cycle_language).

% gen441 — sorgente in memoria: si conserva solo la coordinata dello span e la
% proposizione verificata, mai il corpo della pagina. La selezione e' guidata
% da relazione e shape richiesti dal frame.
source_candidate($Address, $Relation, $Shape, $Value) :-
    source_claim($Address, $Relation, $Shape, $Value).
source_supported($Address, $Relation, $Shape, $Value) :-
    source_candidate($Address, $Relation, $Shape, $Value),
    source_provenance($Address, $Span, $Language).
source_replay($Address, $Relation, $Shape, $Value) :-
    source_supported($Address, $Relation, $Shape, $Value),
    replay_check($Relation, $Shape, $Value).

% gen443 — la fonte resta in quarantena finche' il replay non sostiene il
% sottoinsieme minimo. Le claim non richieste non ereditano autorita' dalla
% pagina; il rollback opera per campagna e lascia intatta la KB stabile.
campaign_quarantine($Campaign, $Id, $Claim) :-
    campaign_claim($Campaign, $Id, $Claim, $Span),
    naf(campaign_promote($Campaign, $Id, $Claim)).
campaign_promote($Campaign, $Id, $Claim) :-
    campaign_claim($Campaign, $Id, $Claim, $Span),
    campaign_required($Campaign, $Id),
    campaign_replay($Campaign, $Id, $Claim).
campaign_rollback($Campaign, $Id, $Claim) :-
    campaign_claim($Campaign, $Id, $Claim, $Span),
    naf(campaign_replay($Campaign, $Id, $Claim)).

% Gen446 — stato vivente come composizione dichiarativa. Un ciclo è pronto
% soltanto quando lo stesso stato conserva una mossa dialogica, una crescita
% promossa e un piano compensativo completo. Il C non sceglie l'ordine né il
% dominio: osserva questa congiunzione KB e può riprodurla per nuovi membri.
live_cycle($Cycle, $Dialogue, $Campaign, $Plan) :-
    dialogue_move($Cycle, $Dialogue),
    campaign_promote($Campaign, $Claim, $Value),
    compensation_plan_complete($Plan).
live_cycle_ready($Cycle) :-
    live_cycle($Cycle, $Dialogue, $Campaign, $Plan).
live_cycle_language($Cycle, $Input, $Source, $Output) :-
    live_cycle($Cycle, $Dialogue, $Campaign, $Plan),
    dialogue_language($Cycle, $Input, $Output),
    campaign_source_language($Campaign, $Source).
machinery(internal_relation).
machinery(source_page).
machinery(source_revision).
machinery(source_section).

% gen360: finite analytical acts as complete facet plans. The subject remains
% open: semantic_atom/3 in the world layer supplies domain knowledge, while the
% fixed consumer verifies every required facet before rendering anything.
machinery(answer_plan).
machinery(format_realizer).
machinery(semantic_atom).
machinery(creative_response_gate).
machinery(creative_text_gate).
machinery(compound_guard_evidence).
machinery(analysis_domain_cue).
machinery(analysis_domain_gate).
machinery(analysis_domain_act).
machinery(analysis_family_cue).
machinery(analysis_family_gate).
machinery(analysis_family_act).
machinery(analysis_default_domain).

% A finite act can still execute when the open subject has no curated specific
% domain. These defaults provide only the subject-neutral context; the remaining
% required facets come from semantic_atom(general, ...). A field family with
% stronger evidence supersedes them.
analysis_default_domain(impact_analysis, default_impact).
analysis_default_domain(design_analysis, default_design).
analysis_default_domain(mechanism_analysis, default_mechanism).
analysis_default_domain(ethical_analysis, default_ethics).
analysis_default_domain(investigation_analysis, default_investigation).
analysis_default_domain(risk_analysis, default_risk).
analysis_default_domain(interpretive_analysis, default_interpretation).
analysis_default_domain(comparison_analysis, default_comparison).
analysis_default_domain(advice_analysis, default_advice).

answer_plan(impact_analysis, framing, 0, required).
answer_plan(design_analysis, framing, 0, required).
answer_plan(mechanism_analysis, framing, 0, required).
answer_plan(ethical_analysis, framing, 0, required).
answer_plan(investigation_analysis, framing, 0, required).
answer_plan(risk_analysis, framing, 0, required).
answer_plan(interpretive_analysis, framing, 0, required).
answer_plan(comparison_analysis, framing, 0, required).
answer_plan(advice_analysis, framing, 0, required).

answer_plan(impact_analysis, context, 1, domain_required).
answer_plan(impact_analysis, direct_effect, 2, required).
answer_plan(impact_analysis, secondary_effect, 3, required).
answer_plan(impact_analysis, qualification, 4, required).

answer_plan(design_analysis, context, 1, domain_required).
answer_plan(design_analysis, objective, 2, required).
answer_plan(design_analysis, intervention, 3, required).
answer_plan(design_analysis, tradeoff, 4, required).
answer_plan(design_analysis, validation, 5, required).

answer_plan(mechanism_analysis, context, 1, domain_required).
answer_plan(mechanism_analysis, mechanism, 2, required).
answer_plan(mechanism_analysis, consequence, 3, required).
answer_plan(mechanism_analysis, evidence, 4, required).
answer_plan(mechanism_analysis, qualification, 5, required).

answer_plan(ethical_analysis, context, 1, domain_required).
