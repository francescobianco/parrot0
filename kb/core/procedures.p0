machinery(algebra_inverse).
algebra_inverse(left, "+", minus, "-").
algebra_inverse(left, "-", plus, "+").
algebra_inverse(left, "*", divide, "/").
algebra_inverse(left, "/", times, "*").
algebra_inverse(right, "+", minus, "-").
algebra_inverse(right, "-", minus, "-").
algebra_inverse(right, "*", divide, "/").
