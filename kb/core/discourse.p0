% discourse.p0 — LA CONVERSAZIONE COME OGGETTO INTERROGABILE (gen397, avvio).
%
% Il gen394 ha dato a parrot0 la memoria di cio' che non ha saputo dire. Restava
% muta: un'issue aperta si poteva interrogare solo nominando la parola giusta,
% cioe' bisognava gia' sapere che cosa era rimasto in sospeso. Una conversazione
% vera fa il contrario — e' parrot0 che deve poter dire che cosa manca.
%
% Il piano chiede per gen397 unita' discorsive, salienza e operatori di
% continuita'. Questo e' il primo taglio: la RIPRESA. Le unita' e la salienza
% arriveranno sullo stesso aggancio (`turn_bookkeeping/1`), che e' il motivo per
% cui esiste.

:- file_attribute(machinery).

% ── 1. LA SUPERFICIE DELLA RIPRESA ─────────────────────────────────────────
%
% Chiedere «cosa e' rimasto in sospeso» non nomina nessuna entita': e' una
% domanda sulla CONVERSAZIONE, non sul mondo. Il registro delle cue e' lo stesso
% che il motore gia' cerca nel turno, quindi non nasce ne' un recognizer ne' una
% lingua nel C.
recall_cue("what is still open", pending).
recall_cue("what is still pending", pending).
recall_cue("what do you still owe me", pending).
recall_cue("cosa è rimasto in sospeso", pending).
recall_cue("cosa non sai ancora", pending).
recall_cue("what did we settle", settled).
recall_cue("what have you learned since", settled).
recall_cue("cosa abbiamo chiarito", settled).
turn_cue_registry(recall_cue, 1).

turn_recall($Turn, $Kind) :- turn_cue_form($Turn, recall_cue, $Cue), recall_cue($Cue, $Kind).

% ── 2. CHE COSA C'E' DA RIPRENDERE ─────────────────────────────────────────
%
% Non una lista tenuta a mano: l'insieme delle issue il cui stato E' quello
% chiesto, calcolato adesso. Una conoscenza arrivata nel frattempo sposta da sola
% una parola da un elenco all'altro, e nessuno deve ricordarsi di aggiornare
% niente — e' la stessa ragione per cui `issue_status/2` e' una vista.
recall_kind_word(pending, $Word) :- issue_status($Word, open).
recall_kind_word(settled, $Word) :- issue_status($Word, resolved).
recall_set($Kind, $Words) :- findall($W, recall_kind_word($Kind, $W), $Words).
recall_nonempty($Kind, $Words) :- recall_set($Kind, cons($First, $Tail)), recall_set($Kind, $Words).

% ── 3. REALIZZARE UN ELENCO ────────────────────────────────────────────────
%
% Il piano proposizionale del §K6 compone un numero FISSO di pezzi: va bene per
% una frase con ruoli noti, non per un elenco la cui lunghezza dipende da cio'
% che e' successo. Questa e' la piega mancante — un fold sulla lista, con il
% separatore della lingua come dato. Non decide nulla su cosa dire: mette in fila
% cio' che qualcun altro ha gia' provato, esattamente come `answer_tail/3`.
list_text($Language, cons($Item, nil), $Item).
list_text($Language, cons($Item, $Tail), $Text) :- list_separator($Language, $Separator), list_text($Language, $Tail, $Rest), concat_atoms($Item, $Separator, $Head), concat_atoms($Head, $Rest, $Text).

answer_content(recall($Kind, $Words, $Language), 0, opener, $Piece) :- recall_opener($Kind, $Language, $Piece).
answer_content(recall($Kind, $Words, $Language), 1, items, $Piece) :- list_text($Language, $Words, $Piece).
answer_content(recall($Kind, $Words, $Language), 2, terminator, $Piece) :- sentence_terminator($Language, $Piece).

% ── 4. CIO' CHE E' STATO DETTO ─────────────────────────────────────────────
%
% Un'issue ricorda le domande senza risposta. Questo ricorda il contrario: le
% risposte date. Non e' la stessa cosa di sapere il fatto — il fatto sta nella
% KB e puo' cambiare, mentre uno scambio e' accaduto e resta accaduto. E' la
% distinzione fra cio' che parrot0 SA e cio' che ha DETTO, e senza di essa una
% conversazione non puo' riferirsi a se stessa.
%
% Vive nella contabilita' perche' e' un effetto del turno, non una sua risposta.
% Il turno ha bisogno di un NUMERO, altrimenti la conversazione e' un insieme e
% non una sequenza: senza ordine non esistono «prima», «poi» e «ancora prima»,
% cioe' non esiste discorso. L'orologio e' un contabile come gli altri e sta
% nella KB — il motore non conta i turni per conto suo.
turn_counter(0).
turn_counter(1).

% ── CHE COSA NON SOPRAVVIVE AL TURNO ─────────────────────────────────────────
%
% `/save` instrada tutto cio' che ha origine di sessione, e finiva per portarsi
% dietro anche lo stato di mezzo turno: `turn_counter(42)` accanto a
% `turn_counter(0)` e `turn_counter(1)`, cioe' un terzo orologio che al boot
% entra in `turn_bookkeeping` — la regola qui sotto fa retract/assert su
% `turn_counter($N)` — e i token dell'ultima frase come se fossero conoscenza.
%
% La sessione e' runtime e non rientra dalla porta del boot
% (docs/session-and-provenance.md §1). Quali predicati siano scratch del turno
% e' pero' CONOSCENZA, non un elenco nel C: un predicato effimero nuovo domani
% e' una riga qui, non una ricompilazione.
machinery(turn_scratch).
turn_scratch(turn_counter).
turn_scratch(turn_span_token).
% `exchange/3` e `exchange_turn/2` sono la salienza della conversazione VIVA.
% Salvarli e ricaricarli trasforma un archivio in stato corrente: una chat nuova
% nasceva gia' «su Paris». Gli utterance restano nell'archivio transcript; una
% fotografia semantica che si vuole conservare usa un predicato d'archivio
% distinto, mai quello consumato da current_topic/1.
turn_scratch(exchange).
turn_scratch(exchange_turn).
bookkeeper(clock).
turn_bookkeeping($Turn, clock) :- turn_counter($N), is($M, add($N, 1)), retract(turn_counter, $N), assert(turn_counter, $M).

bookkeeper(exchange).
% Lo scambio e il suo POSTO nella sequenza sono due fatti, non uno. Non e' una
% scelta di stile: un termine del dialetto porta al massimo quattro argomenti,
% quindi un `assert` puo' creare un fatto di arita' tre e non di piu' — il
% quinto argomento non e' rappresentabile nel corpo di una regola. Separarli e'
% anche piu' onesto: quando accadde e che cosa fu detto sono due domande.
turn_bookkeeping($Turn, exchange) :- turn_reading_unique($Turn, $Relation, $Entity, $Value), turn_counter($N), assert(exchange, $Entity, $Relation, $Value), assert(exchange_turn, $N, $Entity).

told_about($Entity, $Value) :- exchange($Entity, $Relation, $Value).
covered_entity($Entity) :- exchange($Entity, $Relation, $Value).

% ── SALIENZA: di che cosa stiamo parlando ──────────────────────────────────
%
% Non un campo «ultimo topic» tenuto da qualcuno: l'entita' il cui scambio piu'
% recente non ha nulla dopo di se'. E' una vista, quindi una digressione che non
% risponde a niente — un conto, un saluto — non sposta l'argomento, e non perche'
% qualcuno l'abbia esclusa: perche' non ha lasciato uno scambio.
later_exchange($Entity, $Turn) :- exchange_turn($Later, $Entity), gt($Later, $Turn).
entity_last_turn($Entity, $Turn) :- exchange_turn($Turn, $Entity), naf(later_exchange($Entity, $Turn)).
any_later_exchange($Turn) :- exchange_turn($Later, $Other), gt($Later, $Turn).
current_topic($Entity) :- entity_last_turn($Entity, $Turn), naf(any_later_exchange($Turn)).

% «Prima di questo» e' la stessa vista, tolta la cima: il topic stack del piano
% nella sua profondita' minima, e senza una pila da mantenere.
non_current_last($Entity, $Turn) :- entity_last_turn($Entity, $Turn), current_topic($Top), dif($Entity, $Top).
later_non_current($Turn) :- non_current_last($Other, $Later), gt($Later, $Turn).
previous_topic($Entity) :- non_current_last($Entity, $Turn), naf(later_non_current($Turn)).

recall_cue("what are we on", topic).
recall_cue("what is the current topic", topic).
recall_cue("qual è l'argomento", topic).
recall_kind_word(topic, $Entity) :- current_topic($Entity).
recall_cue("what were we on before", earlier).
recall_cue("prima di cosa parlavamo", earlier).
recall_kind_word(earlier, $Entity) :- previous_topic($Entity).
covered_set($Entities) :- findall($E, covered_entity($E), $Entities).

answer_frame("what did you tell me about", told_about).
answer_frame_input_arg("what did you tell me about", told_about, 1).
answer_frame("cosa mi hai detto su", told_about).
answer_frame_input_arg("cosa mi hai detto su", told_about, 1).
answer_frame_input_arg("parlami di", told_about, 1).
answer_frame_input_arg("dimmi qualcosa su", told_about, 1).
answer_frame_input_arg("che cosa conosci di", told_about, 1).
answer_frame_input_arg("sai qualcosa di", told_about, 1).
answer_frame_input_arg("cosa sai su", told_about, 1).
answer_frame_input_arg("che cosa sai di", told_about, 1).
answer_frame_input_arg("dove ha sede", located_in, 1).
answer_frame_input_arg("dove è situato", located_in, 1).
answer_frame_input_arg("in che posto sta", located_in, 1).
answer_frame_input_arg("dove si trovano", located_in, 1).
answer_frame_input_arg("dove la trovo", located_in, 1).
answer_frame_input_arg("dove lo trovo", located_in, 1).
answer_frame_input_arg("in quale luogo", located_in, 1).
answer_frame_input_arg("in che posto", located_in, 1).
answer_frame_input_arg("dove sta", located_in, 1).
answer_frame_input_arg("dov", located_in, 1).

% Anche l'elenco di cio' che si e' toccato e' una ripresa, e passa dallo stesso
% fold: la lunghezza dipende da cio' che e' successo, non da uno schema.
% «what did we talk about» NON entra qui: quella superficie ha gia' un consumer
% dal gen58, che elenca le parole di contenuto dei turni recenti. Fa una cosa
% diversa — piu' larga e piu' grezza — e rubargliela sarebbe amputare una
% struttura secondaria per far posto a una nuova. Le due memorie convivono:
% quella conta cio' che e' stato NOMINATO, questa cio' che e' stato RISPOSTO.
recall_cue("what have we covered", covered).
recall_cue("what have you answered", covered).
recall_cue("su cosa mi hai risposto", covered).
recall_kind_word(covered, $Entity) :- covered_entity($Entity).

% ── G4: L'ELLISSI — QUANDO IL TURNO NON PORTA LA PROPRIA RELAZIONE ─────────
%
% «E il secondo?» non e' una domanda incompleta da riparare: e' una domanda
% NORMALE, che si appoggia al discorso invece di ripetersi. Chi risponde
% «e' sulla mensola» non ha indovinato — ha applicato la relazione che era gia'
% in gioco a un referente nuovo. Un dialogo in cui ogni turno deve riportare
% per intero la propria relazione non e' un dialogo: e' una sequenza di
% interrogazioni indipendenti, ed e' esattamente cio' che parrot0 faceva.
%
% LA STRUTTURA C'ERA GIA', ED ERA A DIGIUNO. `exchange/3` e' documentato qui
% sopra come cio' che parrot0 ha DETTO (distinto da cio' che SA), ed e' gia'
% consumato da `told_about/2`, `covered_entity/1` e «su cosa mi hai risposto».
% Ma nessuno lo riempiva quando una DOMANDA riceveva risposta: era popolato
% solo dalle letture dichiarative. Il risultato e' che tre capacita' gia'
% scritte erano morte per fame, e la quarta — l'ellissi — sembrava mancare di
% un'infrastruttura che invece esisteva.
%
% Percio' qui non si aggiunge una memoria nuova accanto a quella vecchia: si
% NUTRE quella vecchia. Un secondo registro parallelo sarebbe stato piu' rapido
% da scrivere e avrebbe creato due memorie del discorso destinate a divergere —
% la forma del difetto ricorrente (D33/D35/D37): due percorsi che devono
% accordarsi senza condividere l'oggetto su cui accordarsi.
machinery(discourse_answer_observe).
machinery(current_relation).
machinery(referring_surface).
machinery(elliptical_reference_policy).

discourse_answer_observe($Entity, $Relation, $Value) :-
    turn_counter($N),
    assert(exchange, $Entity, $Relation, $Value),
    assert(exchange_turn, $N, $Entity).

% La relazione in gioco e' una VISTA, non un campo tenuto da qualcuno — la
% stessa forma di `current_topic/1` qui sopra, e per la stessa ragione: una
% digressione che non risponde a niente non lascia uno scambio, quindi non
% sposta la relazione. Non c'e' nessun «ultima domanda» da mantenere aggiornato.
current_relation($Relation) :- current_topic($Entity), exchange($Entity, $Relation, $Value).

% Che cosa conti come espressione che RIFERISCE e' conoscenza, non un elenco nel
% C. Il motore chiede soltanto «questo turno contiene un riferimento?»; quali
% forme lo siano si dichiara qui, e una forma nuova domani costa una riga.
referring_surface($Surface) :- ordinal_surface($Surface).
referring_surface($Surface) :- demonstrative_surface($Surface).

% La vista per superficie sola, gemella di `ordinal_surface/1`: chi deve
% chiedere «questa parola e' un dimostrativo?» non deve prima sapere in quale
% lingua cercarla — la canonicalizzazione puo' gia' aver mescolato le lingue
% dentro un turno solo («and quello blue»).
machinery(demonstrative_surface).
demonstrative_surface($Surface) :- demonstrative_reference($Language, $Surface).

% ⚠ IL DIMOSTRATIVO NON E' UN NOME: e' un segnaposto che dice «un referente gia'
% introdotto», e da solo NON individua. «quello rosso» individua per la
% proprieta' che lo segue, non per «quello». Percio' un dimostrativo nudo deve
% restare ambiguo e chiedere, mai scegliere in silenzio (vincolo GD4).
machinery(demonstrative_reference).
demonstrative_reference(it, "quello").
demonstrative_reference(it, "quella").
demonstrative_reference(it, "quelli").
demonstrative_reference(it, "quelle").
demonstrative_reference(en, "that one").
demonstrative_reference(en, "the other one").
demonstrative_reference(it, "l'altro").
demonstrative_reference(it, "l'altra").

% ── COME UN RIFERIMENTO SI LEGA A UN RUOLO ─────────────────────────────────
%
% Il binder risolveva il pronome soltanto nel PRIMO slot, e negli altri lo
% lasciava passare come atomo: «He reviewed it» diventava `reviewed(luca, it)`,
% cioe' un pronome scritto in KB come entita' e annunciato come appreso. Il
% mantra #7 nella forma peggiore, perche' persiste oltre il turno.
%
% La politica sta qui, non nel motore, quindi si puo' cambiare parlando:
%
%   `most_recent`        — l'ordine dei candidati e' la recenza. I candidati sono
%                          `entity_mentioned(Nome, Seq)`, la storia del discorso
%                          che gia' esiste: non un secondo registro parallelo.
%   `distinct_in_frame`  — due ruoli dello STESSO frame non prendono lo stesso
%                          referente. E' cio' che fa leggere «He reviewed it»
%                          con due antecedenti diversi senza inventare un
%                          sistema di tipi: il vincolo e' strutturale, non
%                          lessicale, quindi non elenca ne' generi ne' animatezza.
%
% Ritrarre una di queste righe cambia la condotta senza ricompilare — che e' il
% test operativo. Se nessun candidato regge, la lettura si RITIRA: un muro
% visibile e' preferibile a un fatto falso.
%   `role_parallel`      — si preferisce, per un ruolo, un referente che ha gia'
%                          occupato QUELLO stesso ruolo. E' cio' che fa leggere
%                          «He reviewed the draft» con He=Luca e non He=draft,
%                          una volta che il discorso contiene anche i nomi comuni:
%                          il parallelismo di ruolo e' una generalizzazione
%                          linguistica vera, e non elenca generi ne' animatezza.
%                          I ruoli occupati sono `entity_role(Nome, Indice)`,
%                          scritti da ogni frame legato.
machinery(reference_binding).
machinery(entity_role).
reference_binding(most_recent).
reference_binding(distinct_in_frame).
reference_binding(role_parallel).

% L'eredita' e' una POLITICA dichiarata, non un comportamento cablato: si puo'
% spegnere, e un registro che non la vuole puo' dichiararne un'altra. Segue
% l'idioma gia' usato da `branch_action_ellipsis/3` in conditional-plans.p0.
elliptical_reference_policy(inherit_previous).

% ── 5. LA MOSSA ────────────────────────────────────────────────────────────
%
% Due esiti disgiunti, ed entrambi sono una risposta: dire che cosa manca, o
% dire che non manca nulla. Il secondo non e' un muro — e' un'informazione, e
% tacere al suo posto sarebbe lasciare l'interlocutore a chiedersi se la domanda
% sia stata capita.
turn_plan_candidate($Turn) :- turn_recall($Turn, $Kind).
turn_response($Turn, $Text) :- turn_recall($Turn, $Kind), recall_nonempty($Kind, $Words), current_language($Language), answer_text(recall($Kind, $Words, $Language), $Text).
turn_response($Turn, $Text) :- turn_recall($Turn, $Kind), recall_set($Kind, nil), current_language($Language), recall_empty($Kind, $Language, $Text).
