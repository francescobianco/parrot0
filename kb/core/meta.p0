% meta.p0 — Abstraction ceiling saturation L4-L12 (gen335+).
% Engine primitives: call/1, findall/3, assert/retract, dif/2, prob/2, ranges_over/3.
% All rules MUST be single-line (parser limitation).

% ============================================================================
% L4 — ONTOLOGIA DELLE RELAZIONI
% ============================================================================

relation_domain(is_a, taxonomy).
relation_domain(has_prop, taxonomy).
relation_domain(kind_of, taxonomy).
relation_domain(category_member, taxonomy).
relation_domain(part_of, mereology).
relation_domain(contains, mereology).
relation_domain(located_in, geography).
relation_domain(capital_of_country, geography).
relation_domain(borders, geography).
relation_domain(north_of, geography).
relation_domain(south_of, geography).
relation_domain(east_of, geography).
relation_domain(west_of, geography).
relation_domain(parent_of, kinship).
relation_domain(sibling_of, kinship).
relation_domain(spouse_of, kinship).
relation_domain(after_in_time, temporal).
relation_domain(before_in_time, temporal).
relation_domain(larger_than, comparative).
relation_domain(heavier_than, comparative).
relation_domain(faster_than, comparative).
relation_domain(causes, causality).
relation_domain(enables, causality).
relation_domain(author_of, art).
relation_domain(habitat, biology).
relation_domain(eats, biology).
relation_domain(can_fly, biology).
relation_domain(chemical_symbol, chemistry).
relation_domain(invented_by, history).
relation_domain(founded_by, history).

% Relation arity facts promised by the abstraction-ceiling L4 section. These are
% meta-knowledge, not parser machinery: adding a new predicate description here
% makes the existing answer_frame path able to talk about it.
relation_arity(is_a, 2).
relation_arity(has_prop, 2).
relation_arity(kind_of, 2).
relation_arity(category_member, 2).
relation_arity(part_of, 2).
relation_arity(contains, 2).
relation_arity(located_in, 2).
relation_arity(capital_of_country, 2).
relation_arity(borders, 2).
relation_arity(north_of, 2).
relation_arity(south_of, 2).
relation_arity(east_of, 2).
relation_arity(west_of, 2).
relation_arity(parent_of, 2).
relation_arity(sibling_of, 2).
relation_arity(spouse_of, 2).
relation_arity(after_in_time, 2).
relation_arity(before_in_time, 2).
relation_arity(larger_than, 2).
relation_arity(heavier_than, 2).
relation_arity(faster_than, 2).
relation_arity(causes, 2).
relation_arity(enables, 2).
relation_arity(author_of, 2).
relation_arity(habitat, 2).
relation_arity(eats, 2).
relation_arity(can_fly, 1).
relation_arity(chemical_symbol, 2).
relation_arity(invented_by, 2).
relation_arity(invented_in_year, 2).
relation_arity(invented_before, 2).
relation_arity(founded_by, 2).
relation_arity(requires, 2).
relation_arity(lacks, 2).
relation_arity(worn_on, 2).
relation_arity(can_live_in, 2).
relation_arity(cannot_live_in, 2).

% ============================================================================
% L5 — RETE SEMANTICA ESPLICITA (expanded edge/3 coverage)
% ============================================================================

edge($X, $Y, located_in) :- located_in($X, $Y).
edge($X, $Y, north_of) :- north_of($X, $Y).
edge($X, $Y, south_of) :- south_of($X, $Y).
edge($X, $Y, east_of) :- east_of($X, $Y).
edge($X, $Y, west_of) :- west_of($X, $Y).
edge($X, $Y, borders) :- borders($X, $Y).
edge($X, $Y, contains) :- contains($X, $Y).
edge($X, $Y, heavier_than) :- heavier_than($X, $Y).
edge($X, $Y, faster_than) :- faster_than($X, $Y).
edge($X, $Y, after_in_time) :- after_in_time($X, $Y).
edge($X, $Y, before_in_time) :- before_in_time($X, $Y).
edge($X, $Y, enables) :- enables($X, $Y).
edge($X, $Y, born_in) :- born_in($X, $Y).
edge($X, $Y, died_in) :- died_in($X, $Y).
edge($X, $Y, discovered_by) :- discovered_by($X, $Y).
edge($X, $Y, invented_by) :- invented_by($X, $Y).
edge($X, $Y, founded_by) :- founded_by($X, $Y).
edge($X, $Y, parent_of) :- parent_of($X, $Y).
edge($X, $Y, sibling_of) :- sibling_of($X, $Y).
edge($X, $Y, spouse_of) :- spouse_of($X, $Y).
edge($X, $Y, author_of) :- author_of($X, $Y).
edge($X, $Y, habitat) :- habitat($X, $Y).
edge($X, $Y, eats) :- eats($X, $Y).

% Direct transitive closure for any relation with edges.
closure_step($R, $X, $Z) :- edge($X, $Z, $R).
closure_step($R, $X, $Z) :- edge($X, $Y, $R), dif($X, $Z), edge($Y, $Z, $R).
closure_step($R, $X, $Z) :- edge($X, $Y, $R), dif($X, $Z), closure_step($R, $Y, $Z).

% ============================================================================
% L8 — ARGOMENTAZIONE E GIUSTIFICAZIONE
% ============================================================================

incompatible_conclusions(can_fly($X), flightless($X)).
incompatible_conclusions(gives_birth($X), lays_eggs($X)).
incompatible_conclusions(flightless($X), can_fly($X)).
incompatible_conclusions(lays_eggs($X), gives_birth($X)).

argument_attacks($C1, $C2) :- argument(conclusion, $C1), argument(conclusion, $C2), dif($C1, $C2), incompatible_conclusions($C1, $C2).

justified($C) :- argument(conclusion, $C), argument(premise, $P), argument_supports($P, $C).

% ============================================================================
% L9 — PROVENANCE E CONFIDENZA (using prob/2)
% ============================================================================

confidence_weight($Fact, $W) :- prob($Fact, $W).
high_confidence($F) :- confidence_weight($F, high).
low_confidence($F) :- confidence_weight($F, low).
medium_confidence($F) :- confidence_weight($F, medium).

% ============================================================================
% L10 — SPIEGAZIONE MULTI-STEP
% ============================================================================

deduction_path($X, $Z, cons($R, nil)) :- edge($X, $Z, $R).
deduction_path($X, $Z, cons($R, $Tail)) :- edge($X, $Y, $R), deduction_path($Y, $Z, $Tail).

% ============================================================================
% L11 — INDUZIONE ED ESTENSIONE
% ============================================================================

proposed_rule($Category, $Property) :- category_member($X, $Category), category_member($Y, $Category), dif($X, $Y), call($Property, $X), call($Property, $Y), naf(counterexample($Category, $Property, _)).

% ============================================================================
% L12 — VINCOLI E CONSISTENZA
% ============================================================================

incompatible(bird, mammal).
incompatible(fish, mammal).
incompatible(reptile, mammal).
incompatible(mammal, bird).
incompatible(mammal, fish).
incompatible(mammal, reptile).
incompatible(bird, fish).
incompatible(fish, bird).
incompatible(bird, reptile).
incompatible(reptile, bird).
incompatible(fish, reptile).
incompatible(reptile, fish).

violates_constraint($X) :- is_a($X, $C1), is_a($X, $C2), incompatible($C1, $C2).
violates_constraint($X) :- can_fly($X), flightless($X).

consistent_kb :- naf(violates_constraint(_)).

% ============================================================================
% ANSWER FRAMES — make L4-L12 predicates user-queryable
% ============================================================================

answer_frame("arity", relation_arity).
answer_frame("domain", relation_domain).
answer_frame("predicate", kb_has_predicate).
answer_frame("edge", edge).
answer_frame("conclusion", argument).
answer_frame("supports", argument_supports).
answer_frame("attacks", argument_attacks).
answer_frame("justified", justified).
answer_frame("confidence", confidence_weight).
answer_frame("high confidence", high_confidence).
answer_frame("uncertain", medium_confidence).
answer_frame("explains", explains).
answer_frame("proposed rule", proposed_rule).
answer_frame("incompatible", incompatible).
answer_frame("violation", violates_constraint).
answer_frame("consistent", consistent_kb).

% ============================================================================
% L14 — META-RAGIONAMENTO INTERROGABILE (gen339, abstraction-ceiling §1b)
% Pulled from measured walls: «which relations are transitive?», «what kind of
% question is …?», «cause vs enabling condition» all walled or named the gap.
% ============================================================================

% -- relation properties (completes the L4 promise of relation_type/2) --
relation_type(is_a, transitive).
relation_type(part_of, transitive).
relation_type(located_in, transitive).
relation_type(contains, transitive).
relation_type(larger_than, transitive).
relation_type(heavier_than, transitive).
relation_type(faster_than, transitive).
relation_type(before_in_time, transitive).
relation_type(after_in_time, transitive).
relation_type(borders, symmetric).
relation_type(sibling_of, symmetric).
relation_type(spouse_of, symmetric).
relation_type(incompatible, symmetric).
relation_type(parent_of, asymmetric).
relation_type(capital_of_country, asymmetric).
relation_type(eats, asymmetric).
relation_type(is_a, hierarchical).
relation_type(part_of, mereological).

answer_frame("transitive", relation_type).
answer_frame("symmetric", relation_type).
answer_frame("asymmetric", relation_type).

% -- converse pairs, keyed on plain words so turn tokens reach them --
inverse_of(parent, child).
inverse_of(child, parent).
inverse_of(before, after).
inverse_of(after, before).
inverse_of(above, below).
inverse_of(below, above).
inverse_of(buy, sell).
inverse_of(sell, buy).
inverse_of(teacher, student).
inverse_of(student, teacher).
inverse_of(predecessor, successor).
inverse_of(successor, predecessor).
inverse_of(larger, smaller).
inverse_of(smaller, larger).

answer_frame("inverse", inverse_of).
answer_frame("converse", inverse_of).

% -- L7 question typology, finally answerable (keys are the interrogatives;
%    served by the answer_frame engine's stopword second pass, gen339) --
question_form(who, "a who-question asks for the identity of a person or agent").
question_form(why, "a why-question asks for a cause, a reason or a justification").
question_form(where, "a where-question asks for a place or location").
question_form(when, "a when-question asks for a time or a date").
question_form(how, "a how-question asks for a method, a process or a degree").
question_form(which, "a which-question asks to choose among known alternatives").
question_form(whether, "a whether-question asks for a yes or a no").

answer_frame("kind of question", question_form).
answer_frame("type of question", question_form).

% -- quale SLOT di una relazione binaria l'interrogativo lascia INCOGNITO --
% Era cablato in C come due strcmp su "who"/"what" dentro il ramo generico delle
% relazioni (10-memory-knowledge.c): parole inglesi che decidevano la semantica,
% cioe' C che rubava flessibilita' alla KB. Qui e' conoscenza, quindi un nuovo
% interrogativo — o quello di un'altra lingua — e' un FATTO, non una ricompilata.
%   asks_slot(Interrogativo, subject)  ->  rel($X, Oggetto)   chiede il 1o argomento
%   asks_slot(Interrogativo, object)   ->  rel(Oggetto, $X)   chiede il 2o argomento
% "who is the parent of ann?"  -> parent($X, ann)  -> bob
% "what is the effect of leak?"-> effect(leak, $X)
asks_slot(who, subject).
asks_slot(what, object).
asks_slot(whom, subject).

% Le forme italiane restano utili anche con canonicalize_lang attivo: se un giorno
% una frase IT arriva non canonicalizzata, la mappa e' gia' conoscenza.
asks_slot(chi, subject).
asks_slot(cosa, object).

% -- reasoning contrasts: thinking about thinking, one fact per distinction --
difference_between(cause, enabling_condition, "A cause actively produces the effect; an enabling condition only makes it possible").
difference_between(deduction, induction, "Deduction derives what must follow from rules; induction generalizes a rule from examples").
difference_between(deduction, abduction, "Deduction goes from rule to consequence; abduction guesses the best explanation of an observation").
difference_between(induction, abduction, "Induction generalizes from many cases; abduction explains one case by the most plausible hypothesis").
difference_between(correlation, causation, "Correlation means two things vary together; causation means one actually produces the other").
difference_between(fact, rule, "A fact states one concrete case; a rule derives new conclusions from other facts").
difference_between(fact, opinion, "A fact can be checked against the world; an opinion expresses a preference or a judgement").
difference_between(knowledge, belief, "Knowledge is belief that is true and justified; a belief may be neither").
difference_between(necessary, sufficient, "A necessary condition must hold for the effect; a sufficient one guarantees it by itself").
difference_between(syntax, semantics, "Syntax is the form of an expression; semantics is its meaning").
difference_between(metaphor, simile, "A simile compares with like or as; a metaphor asserts that one thing IS the other").
difference_between(validity, truth, "Validity is about an argument's form; truth is about its premises and conclusion").
% Italian keys (the canonicalizer leaves untranslated content words as-is)
difference_between(correlazione, causalita, "Correlazione: due cose variano insieme; causalita: una produce davvero l'altra").
difference_between(deduzione, induzione, "La deduzione ricava cio che segue dalle regole; l'induzione generalizza una regola dagli esempi").

% gen362 — parrot0 sa riconoscere un PROPRIO muro.
% Finora questa conoscenza viveva solo in tests/llmscore_probe.py: un giudizio
% su parrot0 tenuto fuori da parrot0. Portarla qui la rende un fatto
% interrogabile e la mette a disposizione del motore: un turno la cui risposta
% è un muro dichiarato non è "gestito", quindi il pianificatore analitico può
% ancora provare un piano completo prima che il muro venga pronunciato.
% Insegnare una nuova forma di resa è UN fatto, zero C.
machinery(wall_marker).
wall_marker("i don't understand").
wall_marker("i dont understand").
wall_marker("i don't know about").
wall_marker("i dont know about").
wall_marker("want me to learn").
wall_marker("haven't learned").
wall_marker("havent learned").
wall_marker("not sure i followed").
wall_marker("no idea what to say").
wall_marker("say it another way").
wall_marker("not sure which function").
wall_marker("but i don't have").
wall_marker("i don't have process_step").
wall_marker("facts for that topic yet").

% ── gen363: che COSA è un frame di resa ─────────────────────────────────────
% gen362 provava a riconoscere le rese di parrot0 dal testo (`wall_marker/1`).
% È il livello sbagliato: un consumer che scriveva "for that situation" sfuggiva
% a un marker scritto "for that topic". Il motore ora registra soltanto QUALE
% frame ha parlato (provenance, come `last_module`); il significato del frame è
% questo fatto. Dichiarare che un nuovo frame è una resa è UN fatto, zero C, e
% vale in qualunque lingua perché non guarda le parole.
machinery(gap_frame).
gap_frame(process_step_gap).
gap_frame(activity_step_gap).

% ── gen382n: il registro delle sorgenti di spazio negativo ──────────────────
% Una sorgente nomina due RELAZIONI, non una funzione C:
%   obligation(Entity, Facet)  — perche' la domanda e' legittima;
%   coverage(Entity, Facet)    — che cosa conterebbe come risposta posseduta.
% knowledge_gap/2 in procedures.p0 applica entrambe attraverso la primitiva
% generale apply/2. Tipo, soglia e rimedio restano dati sostituibili a runtime.
machinery(gap_source).
machinery(gap_policy).
machinery(gap_remedy).
gap_source(missing_sibling_attribute, sibling_majority_expected, binary_relation_coverage).
gap_policy(sibling_majority_expected, minimum_group_size, 3).
gap_remedy(missing_sibling_attribute, ask_user).

% gen382p — la seconda sorgente, e costa esattamente cio' che era stato
% promesso: TRE FATTI. Obbligo e copertura sono relazioni gia' definite in
% procedures.p0; qui si dichiara solo che quella coppia e' una sorgente, che tipo
% di lacuna nomina e come si ripara.
%
% Il rimedio non e' "vai a imparare": e' "dillo". Una lacuna di ponte si chiude
% enunciando un fatto che il sistema possiede gia' tutti gli elementi per
% scrivere — la relazione la conosce, la superficie gliela ha appena data
% l'utente sbagliando la domanda. Vedi §10.5.
gap_source(bridge_gap, entity_facet, surface_reachable).
gap_remedy(bridge_gap, declare_surface).

% Il consumer generico esiste gia': answer_frame interroga una relazione
% binaria. Queste sono solo le superfici con cui si raggiunge la vista dei gap.
answer_frame("knowledge gap", knowledge_gap).
answer_frame("lacuna di conoscenza", knowledge_gap).
answer_frame("gap remedy", knowledge_gap_remedy).
answer_frame("rimedio della lacuna", knowledge_gap_remedy).

% il meta-modello delle relazioni descrive la KB, non il mondo.
machinery(relation_domain).
machinery(relation_arity).
machinery(incompatible_conclusions).

% gen382e — dichiarazioni di MACCHINERIA rimaste implicite finche' un cap le
% nascondeva. `kb_predicates` si fermava a 128 predicati distinti e questi
% cadevano oltre: il modello di se' riportava un numero incompleto senza dirlo
% (stessa famiglia del declined[64] di gen376). Tolto il troncamento, sono
% emersi — e nessuno di questi e' conoscenza del mondo: sono la grammatica
% interrogativa, gli slot, il registro di riparazione e i semi di conversazione.
machinery(relation_type).
machinery(inverse_of).
machinery(asks_slot).
machinery(question_form).

% gen404 — LE LACUNE DI MACCHINERIA SONO FATTI.
%
% `pending_gap/1` registra la classe W: il turno nominava qualcosa che parrot0
% non conosce. `machinery_gap/1` registra la classe M: tutte le parole erano
% note e a mancare era il PONTE — nessuna superficie portava quel turno a una
% facolta'. E' la classe che nessuna lettura colma e l'unica che si verifica da
% sola, perche' la prova del rimedio e' che il turno che murava ora risponde.
%
% Sono macchineria, non conoscenza del mondo: non devono comparire quando si
% chiede a parrot0 che cosa sa.
machinery(machinery_gap).

% ── «SU COSA HO FALLITO?» — la seconda freccia dell'anello (gen404) ────────
%
% Un fatto che nessuna frase legge e' scritto e cieco: e' la stessa condizione
% in cui erano le cue italiane morte del gen403, presenti e invisibili. Il
% sensore di `machinery_gap/1` scriveva senza che nulla potesse guardarlo, e
% infatti per verificarlo e' servito prima inventare `!query` nel formato dei
% test.
%
% Qui la lacuna diventa DICIBILE, e senza una riga di C: il contratto di turno
% universale del gen393 basta gia'. Una cue, una regola che raccoglie i fatti
% con findall, il fold di lista del gen397 per renderli. E' anche il primo posto
% in cui parrot0 puo' parlare del proprio spazio negativo invece che del proprio
% contenuto.
gap_report_cue("what did you fail on").
gap_report_cue("what did you not understand").
gap_report_cue("where did you get stuck").
gap_report_cue("su cosa hai fallito").
gap_report_cue("cosa non hai capito").
gap_report_cue("dove ti sei bloccato").
turn_cue_registry(gap_report_cue, 1).
machinery(gap_report_cue).

turn_gap_report($Turn) :- turn_cue_form($Turn, gap_report_cue, $Cue), gap_report_cue($Cue).
turn_gap_list($Turn, $Gaps) :- turn_gap_report($Turn), findall($G, machinery_gap($G), $Gaps).

% Due risposte, e la differenza non e' cosmetica: «non ho fallito su niente» e
% «ho fallito su queste tre cose» sono due stati del mondo diversi, e il primo
% e' una risposta piena quanto il secondo.
answer_content(gaps($Gaps, $Language), 0, opener, $Piece) :- gap_report_opener($Language, $Piece).
answer_content(gaps($Gaps, $Language), 1, items, $Piece) :- list_text($Language, $Gaps, $Piece).
gap_report_opener(en, "So far I could not bridge: ").
gap_report_opener(it, "Finora non sono riuscito a coprire: ").
machinery(gap_report_opener).

turn_plan_candidate($Turn) :- turn_gap_report($Turn).
turn_response($Turn, $Text) :- turn_gap_list($Turn, nil), current_language($Language), no_gap_text($Language, $Text).
turn_response($Turn, $Text) :- turn_gap_list($Turn, cons($H, $T)), current_language($Language), answer_text(gaps(cons($H, $T), $Language), $Text).
no_gap_text(en, "Nothing walled on me yet in this conversation.").
no_gap_text(it, "In questa conversazione non mi sono ancora bloccato su niente.").
machinery(no_gap_text).
% gen404 — una lacuna COLMATA e' un'informazione diversa da una mai avuta: e'
% quella che dice se l'anello sta girando. Anche lei e' macchineria.
machinery(bridged).
% gen405 — il sogno si dichiara mentre e' in corso, cosi' che una lacuna chiusa
% leggendo si distingua da una chiusa perche' qualcuno ha portato la conoscenza.
machinery(dreaming).

% ── gen406: L'ANCORA — DOVE SI E' FERMATO ─────────────────────────────────
%
% Un muro non e' opaco. Il turno si divide in cio' di cui parrot0 sa qualcosa
% (`gap_anchor`) e cio' che per lui non e' niente (`gap_opaque`), e la divisione
% e' la prima informazione utile a chi debba rimediare: senza, lo spazio di
% ricerca e' l'intera KB.
%
% La lacuna SENZA ancora e' il caso che conta di piu': vuol dire che non manca
% conoscenza sul mondo — manca un PONTE, e nessuna lettura lo portera'. E' la
% distinzione M/W calcolata sul singolo turno invece che ragionata a tavolino.
machinery(gap_anchor).
machinery(gap_opaque).

gap_stop_cue("where did you stop").
gap_stop_cue("what did you understand").
gap_stop_cue("dove ti sei fermato").
gap_stop_cue("cosa avevi capito").
turn_cue_registry(gap_stop_cue, 1).
machinery(gap_stop_cue).

turn_gap_stop($Turn) :- turn_cue_form($Turn, gap_stop_cue, $Cue), gap_stop_cue($Cue).
turn_gap_anchors($Turn, $Words) :- turn_gap_stop($Turn), findall($W, gap_anchor($G, $W), $Words).
turn_gap_opaques($Turn, $Words) :- turn_gap_stop($Turn), findall($W, gap_opaque($G, $W), $Words).

% I quattro casi sono DISGIUNTI, e ognuno ha la sua cornice. Tenerli in una sola
% con dei pezzi opzionali sembrava piu' economico e rendeva «I had something on:
% » con la lista vuota: `list_text` non ha una clausola per nil, e un frame che
% ne dipende produce una frase mutilata invece di una risposta.
answer_content(stopped_both($Known, $Opaque, $Language), 0, opener, $Piece) :- gap_stop_opener($Language, $Piece).
answer_content(stopped_both($Known, $Opaque, $Language), 1, known, $Piece) :- list_text($Language, $Known, $Piece).
answer_content(stopped_both($Known, $Opaque, $Language), 2, joint, $Piece) :- gap_stop_joint($Language, $Piece).
answer_content(stopped_both($Known, $Opaque, $Language), 3, opaque, $Piece) :- list_text($Language, $Opaque, $Piece).

answer_content(stopped_known($Known, $Language), 0, opener, $Piece) :- gap_stop_opener($Language, $Piece).
answer_content(stopped_known($Known, $Language), 1, known, $Piece) :- list_text($Language, $Known, $Piece).

answer_content(stopped_opaque($Opaque, $Language), 0, opener, $Piece) :- gap_stop_nothing($Language, $Piece).
answer_content(stopped_opaque($Opaque, $Language), 1, opaque, $Piece) :- list_text($Language, $Opaque, $Piece).

gap_stop_opener(en, "I had something on: ").
gap_stop_opener(it, "Qualcosa lo avevo: ").
gap_stop_joint(en, ". Nothing at all on: ").
gap_stop_joint(it, ". Di questo invece niente: ").
gap_stop_nothing(en, "I had nothing on: ").
gap_stop_nothing(it, "Non avevo niente su: ").
machinery(gap_stop_opener).
machinery(gap_stop_joint).
machinery(gap_stop_nothing).

% Quattro stati del mondo, non uno con tre eccezioni. Il terzo — mi sono
% bloccato e conoscevo TUTTE le parole — e' il piu' informativo di tutti,
% perche' dice che a mancare non e' la conoscenza ma il ponte, e che leggere
% non servirebbe a niente.
turn_plan_candidate($Turn) :- turn_gap_stop($Turn).
turn_response($Turn, $Text) :- turn_gap_stop($Turn), naf(has_open_gap), current_language($Language), no_gap_text($Language, $Text).
turn_response($Turn, $Text) :- turn_gap_anchors($Turn, nil), turn_gap_opaques($Turn, nil), has_open_gap, current_language($Language), bridge_only_text($Language, $Text).
turn_response($Turn, $Text) :- turn_gap_anchors($Turn, cons($K, $KT)), turn_gap_opaques($Turn, cons($O, $OT)), current_language($Language), answer_text(stopped_both(cons($K, $KT), cons($O, $OT), $Language), $Text).
turn_response($Turn, $Text) :- turn_gap_anchors($Turn, cons($K, $KT)), turn_gap_opaques($Turn, nil), current_language($Language), answer_text(stopped_known(cons($K, $KT), $Language), $Text).
turn_response($Turn, $Text) :- turn_gap_anchors($Turn, nil), turn_gap_opaques($Turn, cons($O, $OT)), current_language($Language), answer_text(stopped_opaque(cons($O, $OT), $Language), $Text).

has_open_gap :- machinery_gap($G).
bridge_only_text(en, "I knew every word, and still had no way through: what is missing is a bridge, not knowledge.").
bridge_only_text(it, "Conoscevo tutte le parole e non sono passato lo stesso: a mancare non è la conoscenza, è un ponte.").
machinery(bridge_only_text).
machinery(has_open_gap).

% ── gen408: LO SCOPO DI UNA LETTURA ───────────────────────────────────────
%
% La sonda `dream_intent_probe.py` misura che davanti alla stessa prosa e' la
% CORNICE a decidere l'atto: senza intenzione un ragionatore chiede cosa
% dovrebbe farne, con «acquisisci» trattiene, con «acquisisci per rispondere a
% X» va dritto alla risposta e non riassume nemmeno.
%
% Queste sono le superfici con cui uno scopo si dichiara. Un modo nuovo, o una
% lingua nuova, e' una riga.
reading_purpose_cue("to answer").
reading_purpose_cue("to find out").
reading_purpose_cue("looking for").
reading_purpose_cue("per rispondere a").
reading_purpose_cue("per sapere").
reading_purpose_cue("cercando").
machinery(reading_purpose_cue).
% `reading_intent(bridge, "<domanda>")` vive solo per la durata della lettura:
% e' come si legge QUELLA pagina, non una proprieta' di parrot0.
machinery(reading_intent).

% ── gen408: I PREDICATI CHE HANNO SOLO I PROPRI ESEMPI ────────────────────
%
% §4d di question-emergence.md, calcolato invece che elencato — e con il nome
% corretto solo al secondo tentativo, che vale la pena raccontare.
%
% Il primo rilevatore cercava le regole MORTE: un predicato del corpo senza
% nessun produttore. Ne ha trovate ZERO, ed era vero — la KB non ha regole
% formalmente morte. Ma la domanda che l'aveva fatto nascere («il padre del
% padre è inteso il?») falliva lo stesso, quindi il concetto era quello
% sbagliato.
%
% Quello giusto e' piu' sottile: un predicato i cui UNICI fatti sono gli esempi
% curati scritti accanto alle regole che lo leggono. Non e' morto, non crescera'
% mai parlando, e le regole che ne dipendono varranno per sempre soltanto su
% quelle poche righe. Sono 256 e passa, e leggendone l'elenco si vedono due
% specie diverse:
%
%   `north_of`, `heavier_than`, `capital_of_country`  — pochi dati, non un
%       difetto: nessuno ha ancora raccontato abbastanza mondo;
%   `parent_of`  — un DIALETTO PRIVATO: la conversazione scrive `father/2`, le
%       regole leggono `parent_of/2`, e fra i due non c'era niente.
%
% La differenza non e' calcolabile staticamente: si vede solo confrontando cio'
% che le regole leggono con cio' che l'uso davvero scrive. E' la meta' dinamica,
% e appartiene alle generazioni successive del piano.
machinery(dead_rule).
machinery(inert_rule).
machinery(inert_rule_count).

example_only_cue("which predicates have only examples").
example_only_cue("rules that only work on examples").
example_only_cue("quali predicati hanno solo esempi").
turn_cue_registry(example_only_cue, 1).
machinery(example_only_cue).

turn_example_only($Turn) :- turn_cue_form($Turn, example_only_cue, $Cue), example_only_cue($Cue).
% Il conto lo pubblica il motore (`inert_rule_count/1`): contarlo qui con
% `count_list` su centinaia di elementi e' una ricorsione profonda quanto
% l'elenco, e il turno non tornava affatto.
turn_example_count($Turn, $N) :- turn_example_only($Turn), inert_rule_count($N).

answer_content(only_examples($N, $Language), 0, opener, $Piece) :- example_only_opener($Language, $Piece).
answer_content(only_examples($N, $Language), 1, count, $Piece) :- is($Piece, $N).
answer_content(only_examples($N, $Language), 2, closer, $Piece) :- example_only_closer($Language, $Piece).
example_only_opener(en, "At least ").
example_only_opener(it, "Almeno ").
example_only_closer(en, " of my rules read something that only exists as the examples shipped beside them.").
example_only_closer(it, " delle mie regole leggono qualcosa che esiste solo come gli esempi scritti accanto a loro.").
machinery(example_only_opener).
machinery(example_only_closer).

% L'elenco NON si stampa, e non e' pudore: sono centinaia, e un termine di
% lista con centinaia di elementi sfonda `KB_TERM_LEN` — il primo tentativo lo
% faceva e la risposta spariva in silenzio, che e' il modo peggiore di sbagliare.
turn_plan_candidate($Turn) :- turn_example_only($Turn).
turn_response($Turn, $Text) :- turn_example_count($Turn, $N), current_language($Language), answer_text(only_examples($N, $Language), $Text).



% ── gen409: LE FORME DEL PONTE ────────────────────────────────────────────
%
% Barriera A del piano (question-emergence.md): parrot0 non sapeva di che cosa
% e' fatta la propria macchineria. Ha `numeric_cue`, `setting_cue`,
% `gap_report_cue` e altre dodici, e nessun fatto diceva che quelle sono LE
% FORME CON CUI UN TURNO DIVENTA RISPONDIBILE. Percio', davanti a una lacuna,
% non poteva nemmeno formulare l'ipotesi «mi manca una cue»: quella conoscenza
% viveva solo nei commenti in prosa e nella testa di chi scrive il codice.
%
% La cosa buffa e' che era gia' quasi tutta dichiarata. `turn_cue_registry/2`
% elenca i registri di cue da quando esiste il contratto di turno — serviva a
% pubblicarli, non a descriversi. Leggerlo come autodescrizione non costa niente
% e chiude la barriera per tutta quella famiglia.
bridge_shape(cue, $Registry) :- turn_cue_registry($Registry, $Position).

% Le forme che non passano dal contratto di turno vanno dette. `setting_cue`
% alimenta il SEGMENTATORE (`segment_role(setting, keyword(Cue))`), non il
% dispatcher, ed e' il caso che ha fatto nascere questa generazione: «siamo in
% spiaggia» funziona e «siamo al mare» no, per una cue che manca di un carattere.
bridge_shape(cue, setting_cue).
bridge_shape(cue, slot_evidence).
bridge_shape(cue, enumeration_cue).
bridge_shape(cue, intent_cue).
machinery(bridge_shape).

bridge_ask_cue("what would you need to answer that").
bridge_ask_cue("what kind of fact are you missing").
bridge_ask_cue("cosa ti servirebbe per rispondere").
bridge_ask_cue("che fatto ti manca").
turn_cue_registry(bridge_ask_cue, 1).
machinery(bridge_ask_cue).

turn_bridge_ask($Turn) :- turn_cue_form($Turn, bridge_ask_cue, $Cue), bridge_ask_cue($Cue).
turn_bridge_shapes($Turn, $Shapes) :- turn_bridge_ask($Turn), findall($R, bridge_shape(cue, $R), $Shapes).

answer_content(shapes($Shapes, $Language), 0, opener, $Piece) :- bridge_shape_opener($Language, $Piece).
answer_content(shapes($Shapes, $Language), 1, items, $Piece) :- list_text($Language, $Shapes, $Piece).
bridge_shape_opener(en, "A turn becomes answerable when one of these is taught: ").
bridge_shape_opener(it, "Un turno diventa rispondibile quando gli si insegna una di queste: ").
machinery(bridge_shape_opener).

turn_plan_candidate($Turn) :- turn_bridge_ask($Turn).
turn_response($Turn, $Text) :- turn_bridge_shapes($Turn, cons($S, $T)), current_language($Language), answer_text(shapes(cons($S, $T), $Language), $Text).

% gen410 — la richiesta di ripararsi. E' una cue come tutte le altre, e sta qui
% per la stessa ragione per cui ci stanno le altre: un modo nuovo di chiederlo,
% o una lingua nuova, deve essere una riga.
self_repair_cue("try to fix yourself").
self_repair_cue("fix your own walls").
self_repair_cue("repair yourself").
self_repair_cue("prova a ripararti").
self_repair_cue("riparati da solo").
machinery(self_repair_cue).
response_template(self_repair_none, "I tried the bridges I know how to build and none of them closed a wall.").
response_template(self_repair_none, it, "Ho provato i ponti che so costruire e nessuno ha chiuso un muro.").
% gen410 — la lacuna ricorda anche COME e' stata detta: e' indicizzata sul turno
% canonicalizzato (due modi di dire la stessa cosa sono la stessa lacuna) ma un
% ponte si prova riponendo il turno vero.
machinery(gap_source).
% gen411 — il marcatore che il ciclo lascia sul proprio lavoro: distingue un
% ponte che parrot0 si e' insegnato dai fatti che ha estratto leggendo, che sono
% conoscenza sul mondo e vanno altrove.
machinery(learned_bridge).

% gen413 — L'AUTOCORREZIONE SUL MURO, come interruttore dichiarato.
%
% Quando un turno mura senza nessuna parola opaca, le parole c'erano tutte e a
% mancare e' un ponte: leggere non servirebbe (l'ancora del gen406), proporre si'.
% Finora il ciclo andava innescato a mano — «prova a ripararti» era un turno
% dell'utente — e un sistema che si ripara solo se glielo chiedi non si sta
% riparando da solo. Con questo fatto il tentativo avviene sul muro, nel turno,
% dalla stessa porta di tutto il resto: il prompt.
%
% E' un interruttore e non una costante del motore: toglierlo restituisce il muro
% nudo senza ricompilare niente.
machinery(self_correct_on_wall).

% ── SPENTO, e la ragione va letta prima di riaccenderlo (gen413) ─────────────
%
% Il meccanismo funziona: «ci sistemiamo al rifugio» mura, parrot0 propone
% setting_cue("ci sistemiamo al"), lo verifica riponendo il turno, risponde, e
% da quel momento capisce anche «ci sistemiamo al bivacco». Nessuno gli ha
% chiesto niente. E' esattamente l'autocorrezione dalla porta normale.
%
% Ma acceso su TUTTI i muri produce anche questo, misurato su arith.p0t:
%
%   > what is gold
%   ponte proposto:  gap_report_cue("what is gold")
%   risposta:        «Nothing walled on me yet in this conversation.»
%
% Il ponte PASSA la verifica di gen410 — il turno adesso "risponde" — perche'
% quella verifica chiede solo «la risposta e' diversa dal muro?». Non lo e' piu',
% infatti: e' la risposta di un'ALTRA domanda. Il turno e' stato dirottato in un
% registro che non c'entra, e il risultato e' una risposta sbagliata data con
% sicurezza — cioe' la cosa peggiore che parrot0 possa fare (MANTRA #7), e
% peggiore del muro che ha sostituito.
%
% Una guardia e' stata aggiunta e serviva: la riparazione mira solo alla lacuna
% del turno, altrimenti c'era diafonia — il turno che murava tornava indietro con
% il ponte di un'altra lacuna addosso (misurato).
%
% Una seconda l'ho provata e ERA SBAGLIATA, e vale la pena averla scritta qui
% perche' non venga riprovata: «un candidato deve portare almeno una parola
% piena» sembra ovvia e uccide un ponte legittimo — `gap_report_cue("dove hai")`
% e' fatto di due parole funzionali ed e' giusto (lo fissa self_repair.p0t). Il
% problema non era MAI la forma del candidato.
%
% Il buco e' nel CRITERIO DI ACCETTAZIONE: «la risposta e' diversa dal muro» non
% distingue una riparazione da un DIROTTAMENTO. Serve una prova che la risposta
% nuova sia una risposta A QUELLA DOMANDA. Finche' non c'e', l'interruttore resta
% a `off`.
%
% ── ANCORA SPENTO dopo gen417, e la ragione e' cambiata ─────────────────────
%
% gen417 ha chiuso il dirottamento per REGISTRO: un cue di auto-resoconto non si
% insegna piu' su una domanda sul mondo (`bridge_needs_register/2`), e il ponte
% legittimo — gap_report_cue("dove hai") su un turno che parla di parrot0 —
% continua a passare. Verificato in entrambe le direzioni.
%
% Ma provando ad accendere l'interruttore il dirottamento si e' ripresentato
% identico da un'ALTRA famiglia, poi da una terza: gap_stop_cue, poi
% bridge_ask_cue. Le famiglie di cue sono sedici, e dichiararle una per una e'
% chiudere casi a mano — cioe' il difetto che questo progetto rifiuta ovunque.
%
% IL VINCOLO GIUSTO E' UN ALTRO, e il piano lo aveva gia' scritto a gen410: «se
% risponde e NIENT'ALTRO REGREDISCE». La seconda meta' non e' mai stata
% implementata. Un ponte va accettato solo se, oltre a far rispondere il turno
% che murava, lascia invariate le risposte dei turni che gia' rispondevano — e il
% log della conversazione, che parrot0 tiene, e' esattamente il materiale per
% quella prova.
%
% TRE GUARDIE COSTRUITE, E IL DIFETTO E' ANCORA UN QUARTO — che e' il risultato
% vero di gen417, perche' ora e' isolato invece che sospettato:
%
%   1. il REGISTRO del ponte (gen417): un cue di auto-resoconto non si insegna su
%      una domanda sul mondo. Chiude gap_report_cue e gap_stop_cue;
%   2. la NON-REGRESSIONE (gen417b, `repair_breaks_past`): i turni recenti che
%      gia' rispondevano devono rispondere ancora uguale. E' la seconda meta' del
%      criterio di gen410, finalmente implementata, e non guarda la famiglia del
%      ponte ma l'effetto;
%   3. il PONTE CHE COPRE TUTTO IL TURNO (gen417c): timbrare la frase intera
%      dentro un registro non generalizza niente — e' «una per superficie» invece
%      che «una per classe», il criterio di falsificazione del piano applicato al
%      candidato invece che al risultato.
%
% Nessuna delle tre prende il caso residuo, e adesso si sa perche'. Con il turno
% «what is gold plus silver?» il ciclo propone `bridge_ask_cue("what is gold")`:
% e' un pezzo del turno (guardia 3 non morde), non e' auto-resoconto per registro
% dichiarato (guardia 1 non morde), e non rompe nessun turno passato perche' e' la
% PRIMA volta che quella frase compare (guardia 2 non morde). Eppure la risposta e'
% l'elenco dei registri di cue: pertinente a un'altra domanda.
%
% CIO' CHE MANCA E' UNO SOLO, ed e' il substrato S3 di docs/autocorrezione.md: una
% prova che la risposta sia UNA RISPOSTA A QUELLA DOMANDA. Le altre tre strade
% sono state percorse e chiuse; questa non si puo' aggirare.
self_correct_on_wall(off).

% ── gen414: IL FALLIMENTO HA QUATTRO FORME ──────────────────────────────────
%
% §9.1 di question-emergence.md aveva decomposto il problema in quattro difetti
% — knowledge, reachability, surface, wrong-answer — e poi le sette generazioni
% hanno costruito per il solo muro cieco. Misurato sui cento fallimenti reali:
% 88 fallimenti, 85 invisibili al ciclo, perche' un declino informato («I don't
% know about X yet») viene considerato un turno GESTITO.
%
% Qui si dichiara QUALI esiti sono fallimenti e di che forma. Il motore non
% impara nessun caso nuovo: impara che anche quelli sono fallimenti, e li
% registra come gia' fa per il muro. Togliere una riga rimette le cose come
% stavano, senza ricompilare — ed e' il test del mantra #2 su questo strato.
%
% reachability: il turno non ha raggiunto nessun consumatore. Il muro cieco e il
% declino informato sono LA STESSA COSA vista da due punti — nel secondo il
% ripiego e' riuscito a nominare una parola, e quella parola quasi mai e'
% l'argomento (docs/autocorrezione.md §3b).
machinery(unsatisfying_outcome).
machinery(gap_kind).
unsatisfying_outcome(blind_wall, reachability).
unsatisfying_outcome(informed_decline, reachability).

% ── gen415: GLI INDIZI DI REGISTRO ──────────────────────────────────────────
%
% `looks_code` riconosce il codice per indizi, senza schema, e quando non sa
% eseguire dice quale registro e'. Per la logica gli indizi sono altrettanto
% robusti — e stanno gia' in KB da sempre — ma nessuno li usava per classificare.
% Il fondo della catena, prima di nominare una parola a caso, guarda qui.
%
% LA SOGLIA non e' prudenza generica: un indizio solo ruberebbe il messaggio
% storico a turni che non c'entrano, perche' «all» e «some» stanno in mezzo a
% mille frasi. Servono due indizi DISTINTI, e la soglia e' un fatto.
machinery(register_hint).
machinery(register_hint_min).
machinery(gap_register).
register_hint_min(2).

% Logica: implicazione, quantificazione, modalita', contraddizione.
register_hint(logic, if).            register_hint(logic, then).
register_hint(logic, necessarily).   register_hint(logic, contrapositive).
register_hint(logic, contradictory). register_hint(logic, therefore).
register_hint(logic, implies).       register_hint(logic, counterexample).
register_hint(logic, premise).       register_hint(logic, conclusion).
register_hint(logic, valid).         register_hint(logic, follows).

% Aritmetica su grandezze dette a parole: le unita' e i verbi del calcolo.
register_hint(arithmetic, remainder). register_hint(arithmetic, divided).
register_hint(arithmetic, median).    register_hint(arithmetic, average).
register_hint(arithmetic, minutes).   register_hint(arithmetic, hours).
register_hint(arithmetic, greater).   register_hint(arithmetic, total).

% gen415b — altri registri. Ogni riga qui e' un turno che smette di ricevere una
% parola a caso e riceve il nome del proprio problema. Costa zero C: e' il senso
% dello strato, e il modo piu' economico di far crescere il numero di lacune
% NOMINABILI — cioe' riparabili.
register_hint(translation, translate).   register_hint(translation, spanish).
register_hint(translation, french).      register_hint(translation, italian).
register_hint(translation, german).      register_hint(translation, language).

register_hint(artifact, json).    register_hint(artifact, yaml).
register_hint(artifact, csv).     register_hint(artifact, regex).
register_hint(artifact, schema).  register_hint(artifact, format).
register_hint(artifact, write).   register_hint(artifact, produce).

register_hint(salience, salient).  register_hint(salience, matters).
register_hint(salience, important).register_hint(salience, most).
register_hint(salience, log).      register_hint(salience, line).

register_hint(dialogue_memory, remember). register_hint(dialogue_memory, forget).
register_hint(dialogue_memory, discussed). register_hint(dialogue_memory, earlier).
register_hint(dialogue_memory, conversation). register_hint(dialogue_memory, turns).

register_hint(planning, plan).      register_hint(planning, steps).
register_hint(planning, research).  register_hint(planning, break).
register_hint(planning, design).    register_hint(planning, approach).

% ── gen416: GLI SCHEMI COMPOSIZIONALI ───────────────────────────────────────
%
% Uno schema e' una SEQUENZA DI RUOLI, non un conteggio di token — ed e' la
% correzione della fragilita' che ha bloccato la classe B per due strati su tre:
% «ground is wet» entrava e «the ground is wet» no, perche' `nw == 3` diventava
% `nw == 4` per un articolo. Un ruolo aperto si prende l'articolo senza
% accorgersene.
%
% Ma il motivo per cui esiste non e' leggere di piu': e' FALLIRE MEGLIO. Quando
% lo schema non si completa dice quale ruolo manca, e «riconosco una forma
% copulare, manca la copula» e' una lacuna nominabile — cioe' riparabile —
% mentre «non conosco ground» non lo e'.
%
% Uno schema nuovo costa una riga qui. Un ruolo si riempie o con una classe
% dichiarata (`role_class/2`) o con un token qualunque (`role_open/1`).
machinery(schema_shape).
machinery(role_class).
machinery(role_open).
machinery(gap_missing).

schema_shape(copular, "np copula predicate").
schema_shape(implication, "condition proposition consequence proposition").

role_class(copula, generic_copula).
role_class(condition, rule_antecedent_marker).
role_class(consequence, rule_consequent_marker).
role_open(np).  role_open(predicate).  role_open(proposition).

% gen416 — QUALI RUOLI SONO OBBLIGATORI, cioe' quali assenze sono un difetto.
%
% Un marcatore mancante NON lo e': «if a is bigger than b, is a bigger than c?»
% e' inglese corretto e il «then» e' opzionale — la virgola fa lo stesso lavoro.
% Denunciarlo come implicazione monca era un falso positivo (misurato su
% transitivity.p0t).
%
% Nessun ruolo e' dichiarato obbligatorio, quindi lo schema oggi TACE. Non e' un
% ripiego: e' il criterio giusto in attesa che i ruoli aperti sappiano dove
% finiscono. Un `np` che si ferma a `np_closer` puo' dire «qui il contenuto manca
% davvero», e allora una riga qui accende tutto.
machinery(role_required).

% gen416b — e adesso si puo' dire quale assenza e' un difetto.
%
% Un ruolo aperto che conosce il proprio confine distingue «il contenuto manca»
% da «me lo sono mangiato io»: se davanti trova subito il marcatore successivo,
% lo slot e' vuoto davvero. «if then the ground is wet» non ha antecedente,
% «is wet» non ha soggetto — e queste sono assenze vere, non omissioni di stile
% come il «then» opzionale.
role_required(proposition).
role_required(np).

% ── gen417: LA PERTINENZA COME REQUISITO DI REGISTRO ────────────────────────
%
% La verifica di gen410 chiede «il turno adesso risponde?» e non distingue una
% riparazione da un DIROTTAMENTO. Misurato: davanti a un muro il ciclo proponeva
% gap_report_cue("what is gold"), il turno «rispondeva» con «Nothing walled on me
% yet» — la risposta di un'altra domanda — e il ponte passava. Una risposta falsa
% data con sicurezza e' peggio del muro che sostituisce.
%
% Certe famiglie di ponte hanno un registro e vivono solo li': un cue di
% AUTO-RESOCONTO non si insegna su una domanda sul mondo. Il registro del turno
% lo riconosce lo stesso meccanismo di gen415, quindi il vincolo costa una riga.
machinery(bridge_needs_register).
%
% TUTTE le famiglie di auto-resoconto, non una sola: la prima stesura dichiarava
% il solo `gap_report_cue` e il dirottamento si e' ripresentato identico da
% `gap_stop_cue` (misurato su arith.p0t). Un vincolo che copre un membro di una
% famiglia e non gli altri non e' un vincolo — e' un caso chiuso a mano.
bridge_needs_register(gap_report_cue, self).
bridge_needs_register(gap_stop_cue, self).

% Gli indizi del registro «self»: il turno parla di parrot0, non del mondo. Sono
% soprattutto marcatori di SECONDA PERSONA, ed e' la scelta giusta — «parla di
% te» e' letteralmente questo — piu' le parole con cui si nomina uno stato
% proprio. «dove hai fallito» ne ha due; «what is gold» nessuno.
register_hint(self, you).        register_hint(self, yourself).
register_hint(self, your).       register_hint(self, stuck).
register_hint(self, ti).         register_hint(self, tu).
register_hint(self, hai).        register_hint(self, sei).
register_hint(self, tuo).        register_hint(self, tua).
register_hint(self, fermato).    register_hint(self, fallito).
register_hint(self, bloccato).   register_hint(self, capito).

% gen417 — `self` e' un vincolo, non un annuncio. Serve a dire «questo turno
% parla di parrot0», cosi' che un ponte di auto-resoconto non venga proposto per
% una domanda sul mondo. Annunciarlo ruberebbe il turno al ripiego che registra
% la lacuna, e il ciclo resterebbe senza niente da riparare.
machinery(register_silent).
register_silent(self).

% ── gen418: QUALE RIMEDIO PER QUALE FORMA DI LACUNA ─────────────────────────
%
% Il ciclo provava le cue su qualunque lacuna, anche dove non possono funzionare
% per costruzione. Una forma incompleta (gen416) non si ripara insegnando una
% cue: le manca uno SLOT, non un aggancio — e provarci brucia i tentativi e puo'
% far passare per caso un ponte che non c'entra.
%
% Oggi c'e' una riga sola, ed e' la verita' di adesso: le lacune di
% raggiungibilita' si riparano proponendo una cue. Le altre forme aspettano il
% loro rimedio, e finche' non ce l'hanno vengono SALTATE — che e' meglio che
% ripararle a caso.
%
% Le righe che verranno, quando i rimedi esisteranno:
%   remedy_for(incomplete_schema, slot).   proporre il riempimento del ruolo vuoto
%   remedy_for(wrong_answer, pertinence).  proporre il vincolo di pertinenza
%   remedy_for(knowledge, reading).        leggere — l'unico caso in cui serve
machinery(remedy_for).
remedy_for(reachability, cue).

% ── gen420: LE MOSSE SULLO STATO ────────────────────────────────────────────
%
% K3 di frontier-kb-natural-dialogue.md: un turno e' prima di tutto una MOSSA, e
% «la naturalezza va cercata prima nella mossa, poi nella frase». «Forget my
% name» non porta un contenuto da imparare — chiede a parrot0 di cambiare il
% proprio stato — e letto come contenuto produceva «Nice to meet you, franco!»,
% cioe' reimparava la cosa che gli era stato chiesto di dimenticare.
%
% L'effetto e' un SUPERAMENTO, non una cancellazione (K4): il fatto resta con la
% sua provenienza e smette di essere letto. E' l'unica forma di oblio compatibile
% con «non si toglie niente».
machinery(state_move_cue).
machinery(user_slot_cue).
state_move_cue("forget", retract).
state_move_cue("dimentica", retract).
state_move_cue("scordati", retract).
state_move_cue("non ricordare", retract).

% Quali slot personali si possono ritirare, e come si nominano.
user_slot_cue("my name", name).
user_slot_cue("il mio nome", name).
user_slot_cue("mi chiamo", name).
