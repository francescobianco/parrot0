% conduct-lessons.p0 — LA CONDOTTA SI INSEGNA PARLANDO, E SI RITIRA
% (T3 di docs/plans/train-the-learning-process.md, 21 settembre 2026)
%
% ── IL CASO ────────────────────────────────────────────────────────────────
%
%   >>> sai parlare italiano
%   Sì, parlo italiano.
%   >>> in quale lingua ti ho chiesto quale lingua sai parlare
%   c, python.
%
% Il tema della domanda è un TURNO di questa conversazione, e parrot0 ha
% risposto con l'elenco delle cose che sa. Non è un muro: è fluente e
% infondato, la specie peggiore sulla scala di F. La cura giusta non è
% indovinare «in italiano» — è **tacere con onestà** finché non si sa leggere
% il riferimento, e soprattutto poterlo **dire parlando**.
%
% ── LA FORMA, E PERCHÉ È PIÙ GRANDE DEL CASO ───────────────────────────────
%
%   quando il tema di una domanda è un turno di questa conversazione
%   non rispondere con l elenco delle cose che sai
%
% Non è una regola per quel turno: è `situazione × comportamento`, e ogni
% coppia nuova costa **un nome**, non una riga di C. È il livello L4 della
% scala learning-capability (§4.2 del piano) — la condotta — con ordine A1:
% vale per ogni domanda della famiglia, anche mai vista.
%
% Il maestro nomina ciò che VEDE («l'elenco delle cose che sai»); la KB sa
% quale facoltà lo produce. È il ponte «nome pronunciabile → ruolo» che il
% piano indica come il più fertile, e nessuna parte della lezione nomina
% predicati, arità o tuple.

% ── Le situazioni nominabili ───────────────────────────────────────────────
% Una situazione nuova e' una riga qui, e da quel momento e' dicibile.
conduct_situation("un turno di questa conversazione", a_turn_of_this_conversation).
conduct_situation("a turn of this conversation", a_turn_of_this_conversation).
% Il nome pronunciabile e' una cosa, il rilevatore un'altra: cosi' la conferma
% parla la lingua del maestro invece di esporre lo schema interno.
conduct_situation_test(a_turn_of_this_conversation, topic_is_a_turn).

% Il rilevatore: la domanda nomina un ATTO dello scambio. Quali espressioni
% nominino un atto e' conoscenza, non un ramo: una lingua nuova o una
% formulazione nuova e' una riga, e la si puo' insegnare.
conversation_act_phrase(it, "ti ho chiesto").
conversation_act_phrase(it, "ti ho detto").
conversation_act_phrase(it, "mi hai chiesto").
conversation_act_phrase(it, "mi hai detto").
conversation_act_phrase(it, "hai detto").
conversation_act_phrase(it, "ho detto").
conversation_act_phrase(en, "i asked you").
conversation_act_phrase(en, "i ask you").
conversation_act_phrase(en, "did i ask").
conversation_act_phrase(en, "did you say").
conversation_act_phrase(en, "i told you").
conversation_act_phrase(en, "you asked me").
conversation_act_phrase(en, "you said").
conversation_act_phrase(en, "i said").
machinery(conversation_act_phrase).
machinery(topic_is_a_turn).
topic_is_a_turn($T, named_act) :-
    current_language($L), conversation_act_phrase($L, $Phrase),
    atom_words($Phrase, $Words), words_in_turn($T, $Words).

% ── I comportamenti nominabili ─────────────────────────────────────────────
% Il nome e' quello che l'interlocutore VEDE; la facolta' la sa la KB.
conduct_behaviour("l elenco delle cose che sai", what_you_know).
conduct_behaviour("the list of things you know", what_you_know).
conduct_behaviour_faculty(what_you_know, knowledge).

% ── Il ponte alla porta condivisa ──────────────────────────────────────────
% `faculty_yield_when(Facolta', Stadio, Predicato)` interroga il predicato sul
% turno corrente. Qui una coppia insegnata diventa una cessione.
faculty_yield_when($Faculty, open, $Pred) :-
    conduct_forbidden($Situation, $Behaviour),
    conduct_situation_test($Situation, $Pred),
    conduct_behaviour_faculty($Behaviour, $Faculty).

% ── La lezione, e la sua ritrattazione ─────────────────────────────────────
turn_form(teach_conduct_yield, 1, text("when the topic of a question is")).
turn_form(teach_conduct_yield, 2, named(conduct_situation, situation)).
turn_form(teach_conduct_yield, 3, text("do not answer with")).
turn_form(teach_conduct_yield, 4, named(conduct_behaviour, behaviour)).
turn_form_priority(teach_conduct_yield, early).
turn_form_view(teach_conduct_yield, said).
turn_form_act(teach_conduct_yield, "op(assert, conduct_forbidden, [situation, behaviour])").
turn_form_reply(teach_conduct_yield, conduct_yield_learned).

turn_form(forget_conduct_yield, 1, text("forget that when the topic of a question is")).
turn_form(forget_conduct_yield, 2, named(conduct_situation, situation)).
turn_form(forget_conduct_yield, 3, text("do not answer with")).
turn_form(forget_conduct_yield, 4, named(conduct_behaviour, behaviour)).
turn_form_priority(forget_conduct_yield, early).
turn_form_view(forget_conduct_yield, said).
turn_form_act(forget_conduct_yield, "op(retract, conduct_forbidden, [situation, behaviour])").
turn_form_reply(forget_conduct_yield, conduct_yield_forgotten).

turn_form(teach_conduct_yield_it, 1, text("quando il tema di una domanda è")).
turn_form(teach_conduct_yield_it, 2, named(conduct_situation, situation)).
turn_form(teach_conduct_yield_it, 3, text("non rispondere con")).
turn_form(teach_conduct_yield_it, 4, named(conduct_behaviour, behaviour)).
turn_form_priority(teach_conduct_yield_it, early).
turn_form_view(teach_conduct_yield_it, said).
turn_form_act(teach_conduct_yield_it, "op(assert, conduct_forbidden, [situation, behaviour])").
turn_form_reply(teach_conduct_yield_it, conduct_yield_learned_it).

turn_form(forget_conduct_yield_it, 1, text("dimentica che quando il tema di una domanda è")).
turn_form(forget_conduct_yield_it, 2, named(conduct_situation, situation)).
turn_form(forget_conduct_yield_it, 3, text("non rispondere con")).
turn_form(forget_conduct_yield_it, 4, named(conduct_behaviour, behaviour)).
turn_form_priority(forget_conduct_yield_it, early).
turn_form_view(forget_conduct_yield_it, said).
turn_form_act(forget_conduct_yield_it, "op(retract, conduct_forbidden, [situation, behaviour])").
turn_form_reply(forget_conduct_yield_it, conduct_yield_forgotten_it).

response_template(conduct_yield_learned,
    "Understood: when the topic is {situation}, I will not answer with {behaviour}.").
response_template(conduct_yield_forgotten,
    "I dropped that rule: when the topic is {situation}, I may answer with {behaviour} again.").
response_template(conduct_yield_learned_it,
    "Inteso: quando il tema è {situation}, non risponderò con {behaviour}.").
response_template(conduct_yield_forgotten_it,
    "Ho ritirato quella regola: quando il tema è {situation}, potrò di nuovo rispondere con {behaviour}.").

% ─── UNA FORMA DEL CATALOGO CHE NON REGGEVA UN VERBO NUOVO ─────────────────
% (censimento §4.5-bis, reperto B3 — 21 settembre 2026)
%
% `LEARN_PROTOCOL.md` dichiara la forma «V is an event subject verb» e la dà
% per verificata. Misurata su un verbo MAI VISTO, non insegna:
%
%   > glorp is an event subject verb
%   Learned: glorp is an event. Learned: glorp subject verb.
%
% Due fatti mutilati, e il turno costava 9,7 s. La causa è che «event subject
% verb» è un nome di classe di TRE parole, e il lettore generico lo spezza —
% con `help`, già noto alla KB, non si vedeva. Una forma dichiarata che vale
% solo per i membri già presenti non è una forma: è un ricordo.
%
% Qui la forma si dichiara, con la sua ritrattazione. Il nome di classe resta
% una superficie, quindi un altro nome multiparola costa una riga.
turn_form(teach_event_subject_verb, 1, slot(verb)).
turn_form(teach_event_subject_verb, 2, text("is an event subject verb")).
turn_form_slot_form(teach_event_subject_verb, verb, atom).
turn_form_priority(teach_event_subject_verb, early).
turn_form_view(teach_event_subject_verb, said).
turn_form_act(teach_event_subject_verb, "op(assert, event_subject_verb, [verb])").
turn_form_reply(teach_event_subject_verb, event_subject_verb_learned).

turn_form(forget_event_subject_verb, 1, text("forget that")).
turn_form(forget_event_subject_verb, 2, slot(verb)).
turn_form(forget_event_subject_verb, 3, text("is an event subject verb")).
turn_form_slot_form(forget_event_subject_verb, verb, atom).
turn_form_priority(forget_event_subject_verb, early).
turn_form_view(forget_event_subject_verb, said).
turn_form_act(forget_event_subject_verb, "op(retract, event_subject_verb, [verb])").
turn_form_reply(forget_event_subject_verb, event_subject_verb_forgotten).

response_template(event_subject_verb_learned,
    "Held: the subject of «{verb}» can be an action or a means.").
response_template(event_subject_verb_forgotten,
    "Dropped: the subject of «{verb}» is an agent again.").

% ─── QUASI UNA LEZIONE: il rilevatore, prima di collegarlo ─────────────────
% (§6.2 del piano — il pavimento. 21 settembre 2026)
%
% La specie che tiene il pavimento sotto la soglia: un turno che SOMIGLIA a una
% lezione dichiarata, non viene completato da nessuna forma, e finisce al
% lettore generico che asserisce qualcosa in silenzio. Il maestro riceve
% «Learned» e crede di aver insegnato.
%
% Il segnale c'e' ed e' strutturale: il turno contiene il TESTO FISSO di una
% forma dichiarata — la parte che non varia, quella che identifica la lezione —
% e nessuna forma ha concluso. Le forme si dichiarano da se', quindi il
% rilevatore vale anche per le forme che verranno.
%
% ⚠ DICHIARATO E NON ANCORA COLLEGATO. Un falso positivo qui spegnerebbe
% l'apprendimento ordinario, che e' il canale principale: prima si misura
% quanto spesso scatta su turni che NON sono lezioni, poi si decide. La misura
% sta nel piano, §4.5-bis.
machinery(lesson_fixed_text).
machinery(lesson_near_miss).
lesson_fixed_text($Form, $Text) :- turn_form($Form, $N, text($Text)).
lesson_near_miss($T, $Form) :-
    lesson_fixed_text($Form, $Text),
    atom_words($Text, $Words), count_list($Words, $N), gt($N, 2),
    words_in_turn($T, $Words).

% `turn_form_concluded(Turno, Forma)` — scritto dal motore quando una forma
% dichiarata conclude davvero. E' il fatto che mancava: senza, «quasi una
% lezione» non si distingueva da «una lezione riuscita».
machinery(turn_form_concluded).
turn_scratch(turn_form_concluded).
lesson_concluded(yes) :- turn_counter($N), turn_form_concluded($N, $Form).

% ─── IL DECLINO SUL «QUASI UNA LEZIONE»: PROVATO E RITIRATO ────────────────
%
% Con `turn_form_concluded` interrogabile, il rilevatore sembrava poter
% diventare una porta: un turno che porta il testo identificativo di una
% lezione e non ne conclude nessuna riceve il nome di cio' che manca.
% Scritto, collegato con `faculty_yield_when(knowledge, open, …)` e MISURATO:
%
%   «zorbo is a member of»        ✅ declina invece di asserire in silenzio
%   «socrates is a man»           ✅ impara, nessun falso positivo
%   «bob is an animal»            ✅ impara
%   «zorbo is a member of birds»  ⛔ DECLINA — ed e' la lezione COMPLETA
%
% Il cancello della cessione si decide PRIMA che la forma concluda, quindi la
% guardia `naf(lesson_concluded(yes))` non puo' ancora vedere il successo.
% Ritirato: una regressione su una lezione che funziona non e' accettabile.
%
% Il pezzo che manca non e' un altro fatto: e' che la cessione possa essere
% decisa DOPO il tentativo delle forme dichiarate. Finche' l'ordine e' questo,
% il rilevatore resta una sonda.

% Ora che «una forma ha concluso» e' interrogabile, il rilevatore diventa una
% porta: un turno che porta il testo identificativo di una lezione e non ne
% conclude nessuna riceve il nome di cio' che manca, invece di finire al
% lettore generico che asserisce in silenzio.
machinery(lesson_almost).
lesson_almost($T, $Form, $Text) :-
    lesson_near_miss($T, $Form), lesson_fixed_text($Form, $Text),
    naf(lesson_concluded(yes)).

% ─── LA PORTA, RICOLLEGATA DOPO IL CAMBIO D'ORDINE ─────────────────────────
% Ora la cessione si decide dopo che le forme dichiarate hanno avuto il turno,
% quindi «quasi una lezione» non puo' piu' scattare su una lezione riuscita.
machinery(lesson_almost_turn).
lesson_almost_turn($T, yes) :- lesson_almost($T, $Form, $Text).
faculty_yield_when(knowledge, open, lesson_almost_turn).
