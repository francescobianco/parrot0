% ── 8. IL REGISTRO AFFETTIVO SENZA CONTENUTO ──────────────────────────────
%
% Emoji, emoticon, risate, gesti fra asterischi, vezzeggiativi. Qui la
% distinzione conta: l'emoji e il gesto fra asterischi sono STRUTTURA (una
% classe di codepoint, un asterisco iniziale) e restano un riconoscitore in C;
% le risate e i vezzeggiativi sono PAROLE, e le parole stanno qui.
%
% La risposta ruota da sola: `response_template` con piu' righe e' gia' una
% rotazione, che e' l'istinto anti-ripetizione del gen55 ottenuto per dati.
intent_cue(playful, "haha").                intent_cue(playful, "lol").
intent_cue(playful, "hehe").                intent_cue(playful, "ahah").
intent_cue(playful, "lmao").                intent_cue(playful, "hihi").
intent_cue(playful, "rofl").                intent_cue(playful, "eheh").
intent_cue(playful, "ahaha").               intent_cue(playful, "battuta").
intent_cue(playful, "scherzo").             intent_cue(playful, "hilarious").
intent_cue(playful, ":)").                  intent_cue(playful, ":-)").
intent_cue(playful, ";)").                  intent_cue(playful, ":d").
intent_cue(playful, ":p").                  intent_cue(playful, " xd").
intent_cue(playful, ":(").                  intent_cue(playful, "<3").
intent_cue(playful, "sweety").              intent_cue(playful, "sweetie").
intent_cue(playful, "babes").               intent_cue(playful, "buddy").
intent_cue(playful, "tesoro").
% «friend» e «amico» erano in questa lista e rubavano ogni frase che NOMINASSE
% un amico: «perché balu è un amico?» riceveva una risposta affettuosa invece
% della prova. Un vezzeggiativo e' un vocativo — «ehi amico» — e riconoscerlo
% come tale vuole la posizione, non la sola presenza della parola. Finche' la
% posizione non la guardiamo, meglio non rispondere che rispondere a caso.
response_template(playful, "I'm enjoying this — what's on your mind?").
response_template(playful, "Ha, you're playful! Ask me something?").
response_template(playful, "I'm a simple bot, but I'm here for it. Go on?").
response_template(playful, it, "Mi sto divertendo — a cosa stai pensando?").
response_template(playful, it, "Ah, sei in vena! Chiedimi qualcosa.").
response_template(playful, it, "Sono un bot semplice, ma ci sto. Vai avanti.").

machinery(chitchat_reaction).
machinery(reaction_effect).
machinery(session_slot).
