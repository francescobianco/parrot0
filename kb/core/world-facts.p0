% gen335: demonym knowledge — place → demonym for completion queries.
% KB-first: add a demonym/2 fact and "born in X, therefore I am a ___"
% resolves with zero C changes. The completion_chain/2 consumer in
% mod_knowledge reads the cue + predicate; the data is KB knowledge.
% ==================================================================

% completion_chain(Cue, ResultPred): when the user says "Cue X" and the
% sentence ends with a blank/article, query ResultPred(X, ?Y) and respond
% with Y. The C motor (mod_knowledge) reads this; the data grows here.
% gen335b: profession chain — "studied X, therefore I am a ___"
% study medicine → doctor, study law → lawyer, etc.

% ═══ Conoscenza di ordine superiore cresciuta sulla learning mesh (gen335) ═══════
% Vedi docs/plans/learning-mesh.md §4.4. Fatti QUI accanto ai loro parenti (is_a,
% answer_frame, capital_of_country) così il save-map instrada la crescita futura.
% Operatori (regole) in forma robusta: closure a predicato separato, right-recursive.

% -- Tassonomia + ereditarietà di proprietà/abilità (kind_of/prop_of/able_to) --

% -- Ordinamenti transitivi (comparativo + temperatura + temporale) --

% -- Geografia (continente) e paternità letteraria (rispondibili via answer_frame) --

% ── TAXONOMY + CATEGORIES + PROPERTIES + COMPARISONS + CAUSALITY + GEOGRAPHY + SUPERLATIVES (scattered from mesh-session.p0, gen335) ──

% ── DEFAULT REASONING with NAF (non-monotonic) ──
% "birds fly" with exceptions (gen335 round-2)

% ── HABITAT & DIET ──

% ── TEMPORAL PERIODS ──

% ── L4: ONTOLOGY OF RELATIONS (meta-knowledge about predicates) ──




% ── L7: QUESTION TYPOLOGY ──

% ── L8: ARGUMENTATION ──
% Socrates syllogism (classic example of deductive reasoning)
% ── PERIODIC TABLE (118 elements, gen335 round-3) ──
% ── COMPLETE WORLD GEOGRAPHY (gen335 round-3) ──
able_to($X, $A) :- has_own_ability($X, $A).
able_to($X, $A) :- kind_of($X, $Y), able_to($Y, $A).

% Piano di sicurezza, non folklore: mantenere la calma e uscire senza spruzzi,
% avvisare i responsabili e non avvicinare/inseguire/toccare/nutrire lo squalo.
% Fonti: NSW SharkSmart, Florida Museum International Shark Attack File.
important_quality(leader, trustworthiness, "people follow hard decisions only when they believe the leader is honest and consistent").
important_quality(manager, clarity, "clear expectations let people coordinate without guessing what success means").
important_quality(teacher, patience, "students learn at different speeds, and patience keeps correction useful instead of discouraging").
important_quality(doctor, judgment, "medical skill depends on choosing the right action under uncertainty and pressure").
important_quality(engineer, rigor, "small unchecked assumptions can become large failures in the finished system").
important_quality(parent, steadiness, "children need care they can rely on, especially when things are difficult").
important_quality(friend, loyalty, "friendship depends on showing up when support actually costs something").
important_quality(reviewer, honesty, "a review helps only when it names the real risk instead of flattering the work").
after_in_time($X, $Z) :- after_in_time($X, $Y), after_in_time($Y, $Z).
after_in_time(baroque, renaissance).
after_in_time(classical, baroque).
after_in_time(cold_war, ww2).
after_in_time(friday, thursday).
after_in_time(internet_era, cold_war).
after_in_time(modern_era, romantic).
after_in_time(renaissance, middle_ages).
after_in_time(romantic, classical).
after_in_time(saturday, friday).
after_in_time(sunday, saturday).
after_in_time(ww2, ww1).
age_of(earth, 4500000000).
age_of(pyramids, 4500).
age_of(roman_empire, 2000).
age_of(universe, 13800000000).
appearance(black, "the absence of light -- the darkness of a moonless night").
appearance(blue, "a cool, calm colour -- the shade of a clear daytime sky and of deep, still water").
appearance(forest, "tall trees crowded together, green light filtering through the leaves onto a floor of moss and fallen branches").
appearance(green, "a fresh, restful colour -- the shade of grass and of new spring leaves").
appearance(ocean, "a vast expanse of blue-green water reaching to the horizon, its surface forever moving in waves").
appearance(orange, "a warm, glowing colour between red and yellow -- the shade of a sunset and of its namesake fruit").
appearance(purple, "a deep, rich colour between blue and red -- the shade of plums and of twilight").
appearance(rainbow, "a wide arc of colour -- red, orange, yellow, green, blue, and violet -- that appears when sunlight shines through rain").
appearance(red, "a warm, intense colour -- the shade of fire, of ripe strawberries, and of blood").
appearance(snow, "soft white flakes that settle into a smooth, bright blanket covering everything in quiet").
appearance(sunrise, "the dark sky brightens with soft gold and rose as the sun edges over the horizon and daylight returns").
