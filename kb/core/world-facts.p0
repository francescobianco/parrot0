% ── IL CORPUS DEVE POTER CRESCERE PARLANDO ─────────────────────────────────
%
% ⛔ Il cassetto senza maniglia, nella sua forma piu' pura. Misurato:
%
%     > teflon is a molecule             ->  Learned: teflon is a molecule.
%     > teflon contains fluorine         ->  Learned: teflon contains fluorine.
%     > tell me a molecule with fluorine ->  «non riesco a verificare»
%
% Tutto a buon fine e niente servito: il percorso che INSEGNA scrive il fatto
% unario `molecule(teflon)`, quello che LEGGE interroga `category_member/2`.
%
% ⚠ La prima cura fu UNA REGOLA scritta a mano per quella coppia di forme.
% F. l'ha fermata: «la soluzione e' un arco connettivo dinamico che possa
% connettere parti della conoscenza espresse in una forma a parti espresse in
% un'altra, con predicate-join e predicati variabili». Aveva ragione: una regola
% per coppia e' l'elenco degli incidenti un livello piu' su — domani serve fra
% `contains` e `has_part`, fra `located_in` e `in`, fra un'unaria e una ternaria.
%
% Qui l'arco e' un FATTO e i predicati sono ARGOMENTI. Il motore legge la
% POSIZIONE e la GUARDIA, e non nomina nessuna relazione.
machinery(knowledge_arc).
machinery(knowledge_alias).
machinery(category).

% «in `category_member(A0, A1)` l'argomento in posizione 0 e' il PREDICATO di un
% fatto che porta gli argomenti rimanenti»: cioe' `A0(A1)`. La guardia dice quali
% predicati possono essere promossi — non ogni unaria e' una categoria.
knowledge_arc(category_member, 0, category).

% Che cosa sia una categoria e' a sua volta conoscenza, e si apre parlando:
% `category/1` e' scritta cosi' perche' «widget is a category» produca esattamente
% quel fatto. Una classe che ha gia' membri curati lo e' per derivazione.
category($Class) :- kb_fact(category_member, cons($Class, cons($Member, nil))).

% ── CHIMICA: MOLECOLE ED ELEMENTI ──────────────────────────────────────────
%
% Corpus vero e committabile, aggiunto perche' «dimmi una molecola con
% l'ossigeno» murava: non mancava una macchina, mancava la conoscenza. Passa
% dalla stessa via generale di «tell me a country in asia» — categoria piu'
% vincolo verificato da `member_satisfies/2` — quindi non serve nessun ramo per
% la chimica: serve che parrot0 SAPPIA di che cosa e' fatta una molecola.
category_member(molecule, water).
category_member(molecule, carbon_dioxide).
category_member(molecule, carbon_monoxide).
category_member(molecule, methane).
category_member(molecule, ammonia).
category_member(molecule, ozone).
category_member(molecule, glucose).
category_member(molecule, ethanol).
category_member(molecule, hydrogen_peroxide).
category_member(molecule, sulfuric_acid).
category_member(molecule, sodium_chloride).
category_member(molecule, calcium_carbonate).
category_member(molecule, nitrogen_dioxide).

category_member(element, hydrogen).   category_member(element, helium).
category_member(element, carbon).     category_member(element, nitrogen).
category_member(element, oxygen).     category_member(element, sodium).
category_member(element, sulfur).     category_member(element, chlorine).
category_member(element, calcium).    category_member(element, iron).

% Di che cosa e' fatta ciascuna. E' `contains/2`, la stessa relazione che serve
% a qualunque altra composizione: il vincolo «con l'ossigeno» si verifica qui
% senza che nessuno abbia scritto «ossigeno» nel motore.
contains(water, hydrogen).             contains(water, oxygen).
contains(carbon_dioxide, carbon).      contains(carbon_dioxide, oxygen).
contains(carbon_monoxide, carbon).     contains(carbon_monoxide, oxygen).
contains(methane, carbon).             contains(methane, hydrogen).
contains(ammonia, nitrogen).           contains(ammonia, hydrogen).
contains(ozone, oxygen).
contains(glucose, carbon).             contains(glucose, hydrogen).
contains(glucose, oxygen).
contains(ethanol, carbon).             contains(ethanol, hydrogen).
contains(ethanol, oxygen).
contains(hydrogen_peroxide, hydrogen). contains(hydrogen_peroxide, oxygen).
contains(sulfuric_acid, hydrogen).     contains(sulfuric_acid, sulfur).
contains(sulfuric_acid, oxygen).
contains(sodium_chloride, sodium).     contains(sodium_chloride, chlorine).
contains(calcium_carbonate, calcium).  contains(calcium_carbonate, carbon).
contains(calcium_carbonate, oxygen).
contains(nitrogen_dioxide, nitrogen).  contains(nitrogen_dioxide, oxygen).

