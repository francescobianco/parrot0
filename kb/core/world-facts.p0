lacks(desert, water).
lacks(desert, dissolved_oxygen).
can_live_in($X, $Place) :- habitat($X, $Place).
can_live_in($X, $Place) :- requires($X, $Need), provides($Place, $Need), naf(lacks($Place, $Need)).
cannot_live_in($X, $Place) :- requires($X, $Need), lacks($Place, $Need).

