% document-structure.p0 — Document IR minima e aperta (SC1).
%
% Il producer C assegna soltanto identita', ordine e byte span alle unita' che
% il lettore gia' separa meccanicamente. Copia qui la gerarchia transiente di
% `current_prose` prima che venga ripulita per la clausola successiva. La KB
% decide se un token sia una cue retorica, quale relazione segnali e in quale
% direzione colleghi le unita'.

:- file_attribute(machinery).

machinery(current_document).
machinery(document_begin).
machinery(document_unit).
machinery(document_unit_source).
machinery(document_unit_token).
machinery(document_unit_token_key).
machinery(document_unit_token_set).
machinery(document_unit_token_store).
machinery(document_unit_node_observe).
machinery(document_unit_observe).
machinery(document_source_observe).
machinery(document_source).
machinery(document_fingerprint).
machinery(current_document_source).
machinery(current_document_fingerprint).
machinery(document_unit_token_range).
machinery(document_unit_token_surface).
machinery(document_unit_token_before).
machinery(document_unit_token_precedes).
machinery(document_unit_initial_token).
machinery(document_unit_follows).
machinery(rhetorical_marker_class).
machinery(document_unit_rhetorical_cue).
machinery(rhetorical_edge).
machinery(current_document_relation).

% Una sola vista e' corrente, ma le osservazioni precedenti restano fatti di
% sessione con la propria identita'. Il cambio di focus non cancella il passato.
current_document(none).
document_begin($Document) :-
    current_document($Old),
    retract(current_document, $Old),
    assert(current_document, $Document).

% La lista consente al rule engine di materializzare tutti i token senza che C
% debba conoscere una categoria linguistica. Il record reificato mantiene il
% limite di tre argomenti dell'assert da regola.
document_unit_token_key($Scope, token($Id, $Quoted, $Range)) :-
    input_node($Scope, $Id, node(token, token, $Parent), $Range),
    input_node_surface($Scope, $Id, $Quoted).

document_unit_token_set($Scope, $Tokens) :-
    findall($Token, document_unit_token_key($Scope, $Token), $Tokens).

document_unit_token_store($Unit, nil).
document_unit_token_store($Unit, cons(token($Id, $Quoted, $Range), $Tail)) :-
    assert(document_unit_token, $Unit, $Id, token($Quoted, $Range)),
    document_unit_token_store($Unit, $Tail).

% Questa e' la frontiera transazionale: prima del clear di `current_prose`, una
% clausola diventa un'unita' stabile con superficie, span e token allineati.
document_unit_observe($Document, $Unit, $Order, $Scope) :-
    input_node($Scope, 0, node(clause, clause, root), $Range),
    input_node_surface($Scope, 0, $Quoted),
    assert(document_unit, $Document, $Unit, $Order),
    assert(document_unit_source, $Unit, $Quoted, $Range).

% Il producer invoca questa regola una volta per node id. Evita che una frase
% scientifica lunga debba attraversare una lista ricorsiva profonda per
% diventare osservabile: la selezione dei soli token resta qui, mentre il C
% incrementa soltanto un indice entro il numero di nodi gia' pubblicato.
document_unit_node_observe($Unit, $Scope, $Id) :-
    input_node($Scope, $Id, node(token, token, $Parent), $Range),
    input_node_surface($Scope, $Id, $Quoted),
    assert(document_unit_token, $Unit, $Id, token($Quoted, $Range)).

% Fonte e fingerprint sono coordinate osservate, non interpretazioni. Il loro
% accoppiamento rende l'identita' riproducibile fra processi e impedisce che il
% contatore locale `document_N` venga promosso come identita' epistemica.
document_source_observe($Document, $Source, $Fingerprint) :-
    assert(document_source, $Document, $Source),
    assert(document_fingerprint, $Document, $Fingerprint).
current_document_source($Source) :-
    current_document($Document), document_source($Document, $Source).
current_document_fingerprint($Fingerprint) :-
    current_document($Document), document_fingerprint($Document, $Fingerprint).

document_unit_token_surface($Unit, $Id, $Surface) :-
    document_unit_token($Unit, $Id, token($Quoted, $Range)),
    span_atom($Quoted, $Surface).
document_unit_token_range($Unit, $Id, $Start, $Length) :-
    document_unit_token($Unit, $Id, token($Quoted, range($Start, $Length))).
document_unit_token_before($Unit, $Left, $Right) :-
    document_unit_token_range($Unit, $Left, $LeftStart, $LeftLength),
    document_unit_token_range($Unit, $Right, $RightStart, $RightLength),
    lt($LeftStart, $RightStart).
document_unit_token_precedes($Unit, $Id) :-
    document_unit_token_before($Unit, $Other, $Id).
document_unit_initial_token($Unit, $Id) :-
    document_unit_token($Unit, $Id, $Token),
    naf(document_unit_token_precedes($Unit, $Id)).

document_unit_follows($Document, $Left, $Right) :-
    document_unit($Document, $Left, $LeftOrder),
    document_unit($Document, $Right, $RightOrder),
    is($RightOrder, add($LeftOrder, 1)).

% La classe della superficie e la semantica dell'arco sono due coordinate
% aperte. `apply/2` invoca la classe dichiarata: insegnare un nuovo membro di
% `contrastive_connector` lo rende consumabile al turno dopo senza rebuild.
rhetorical_marker_class(contrastive_connector, contrast, previous_to_current).

document_unit_rhetorical_cue($Unit, $Relation, $Direction, $Cue) :-
    document_unit_initial_token($Unit, $Id),
    document_unit_token_surface($Unit, $Id, $Cue),
    rhetorical_marker_class($Class, $Relation, $Direction),
    apply($Class, cons($Cue, nil)).

rhetorical_edge($Document, $Left, $Right, $Relation) :-
    document_unit_follows($Document, $Left, $Right),
    document_unit_rhetorical_cue(
        $Right, $Relation, previous_to_current, $Cue).

current_document_relation($Relation) :-
    current_document($Document),
    rhetorical_edge($Document, $Left, $Right, $Relation).
