% Morphological knowledge — plural→singular mappings for the research pipeline.
% KB-first: a new plural form is a fact, never a C branch. The engine queries
% singular/2 before Wikipedia/file lookup so "cavalli" resolves to "cavallo".

% --- Italian plural → singular ---
singular(cavalli, cavallo).
singular(cani, cane).
singular(gatti, gatto).
singular(uomini, uomo).
singular(donne, donna).
singular(case, casa).
singular(tavoli, tavolo).
singular(libri, libro).
singular(fiori, fiore).
singular(alberi, albero).
singular(frutti, frutto).
singular(pesci, pesce).
singular(uccelli, uccello).
singular(animali, animale).
singular(studenti, studente).
singular(professori, professore).
singular(amici, amico).
singular(numeri, numero).
singular(colori, colore).
singular(montagne, montagna).
singular(stelle, stella).
singular(pianeti, pianeta).
singular(città, città).
singular(film, film).
singular(leoni, leone).
singular(lupi, lupo).
singular(orsi, orso).
singular(tigri, tigre).
singular(serpenti, serpente).
singular(insetti, insetto).
singular(ragni, ragno).
singular(farfalle, farfalla).
singular(formiche, formica).
singular(api, ape).
singular(uova, uovo).
singular(dita, dito).
singular(braccia, braccio).
singular(orecchie, orecchio).
singular(occhi, occhio).
singular(mani, mano).
singular(piedi, piede).

% --- English irregular plural → singular ---
singular(horses, horse).
singular(children, child).
singular(men, man).
singular(women, woman).
singular(mice, mouse).
singular(geese, goose).
singular(feet, foot).
singular(teeth, tooth).
singular(leaves, leaf).
singular(wolves, wolf).
singular(fish, fish).
singular(sheep, sheep).
singular(deer, deer).

% --- CANDIDATI DI LEMMA: regole, non elenco (gen395) --------------------------
%
% Le 54 righe qui sopra sono un elenco, e un elenco ha un difetto strutturale:
% «variabili» non c'era, quindi «cosa sono le variabili» murava mentre «cosa e'
% una variabile» rispondeva. Aggiungere la riga mancante sarebbe stato il fix
% dell'istanza; la CLASSE e' la flessione, e la flessione e' una procedura.
% `chars/2` e `append_list/3` bastano: il motore non impara nessuna desinenza.
%
% Vivono sotto un nome PROPRIO, e la distinzione non e' cosmetica. `singular/2`
% e' una DECISIONE — il research loop la usa cosi', prendendo il primo risultato
% come il lemma — mentre una regola di flessione produce CANDIDATI: «variabili»
% propone sia «variabilo» sia «variabile», e una parola inventata come «florble»
% propone «florbla». Misurato: mescolarli faceva cercare «florbla» al posto di
% «florble». Un candidato che non ha fatti muore alla giunzione, ma solo se chi
% lo consuma sa che e' un candidato; chi decide sul primo che trova ha bisogno di
% una tabella curata, e continua ad averla.
lemma_candidate($Word, $Lemma) :- singular($Word, $Lemma).
lemma_candidate($Plural, $Singular) :- chars($Plural, $Chars), append_list($Stem, cons(i, nil), $Chars), append_list($Stem, cons(o, nil), $SingChars), chars($Singular, $SingChars).
lemma_candidate($Plural, $Singular) :- chars($Plural, $Chars), append_list($Stem, cons(i, nil), $Chars), append_list($Stem, cons(e, nil), $SingChars), chars($Singular, $SingChars).
lemma_candidate($Plural, $Singular) :- chars($Plural, $Chars), append_list($Stem, cons(e, nil), $Chars), append_list($Stem, cons(a, nil), $SingChars), chars($Singular, $SingChars).
lemma_candidate($Plural, $Singular) :- chars($Plural, $Chars), append_list($SingChars, cons(s, nil), $Chars), chars($Singular, $SingChars).

% --- Disambiguation flags: phrases inside a definition that signal it may NOT
% match the user's intended meaning. Detected post-fetch to warn or refuse. ---
disambig_flag(en, "may refer to").
disambig_flag(en, "is a surname").
disambig_flag(en, "can refer to").
disambig_flag(it, "è un cognome").
disambig_flag(it, "può riferirsi a").
disambig_flag(it, "è un cognome italiano").

% --- Proper names: words that should NOT be translated by tr/2,
% even if a translation exists. Teachable at runtime via learnable.
% Example: "luna" as a pet name stays "luna", not "moon".
proper_name(luna).
proper_name(rosa).
proper_name(viola).
proper_name(leo).

% --- gen506k — i plurali italiani comuni (F., 9 settembre 2026: «parliamo
% delle zanzare»). Le regole di suffisso (`plural_suffix/2`, grammar.p0) non
% sono per lingua e valgono per l'inglese: «-e -> -a» qui romperebbe «house».
% Finche' `plural_suffix` non porta la lingua (C_TODO), il plurale italiano e'
% un fatto per parola — e ogni parola nuova e' una riga. Gli invariabili
% (computer, robot, virus, re, caffè) sono dichiarati uguali a se stessi.
singular(zanzare, zanzara).
singular(mosche, mosca).
singular(vespe, vespa).
singular(calabroni, calabrone).
singular(scarafaggi, scarafaggio).
