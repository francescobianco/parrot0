% ── PRESENTATION LAYER ──────────────────────────────────────────────────────────
% Come un dato viene RESO nella superficie di output. KB-first (F., gen335):
% "anche la presentazione e la manipolazione del dato in output e kb-first".
% Il motore C tiene solo il MECCANISMO (present_atom: togliere un separatore,
% capitalizzare una parola); la CONOSCENZA di cosa fare vive qui.
%
%   present_rule/1     attiva una regola di superficie globale
%   proper_name/1      (kb/core/morphology.p0, teachable) marca gli atomi che
%                      sono nomi propri → si scrivono in Maiuscolo Ogni Parola
%
% Aggiungere una regola di resa = un fatto, non una riga di C. Il costo marginale
% di una decorazione nuova (virgolette, grassetto, …) deve tendere a un fatto.

% present_rule/1 è machinery: dichiarato QUI, nello stesso respiro del fatto, così
% non "leaka" mai nel conteggio "quante cose sai?" (is_internal_pred interroga
% machinery/1 prima della lista C di fallback). Questa è la forma KB-first del
% marcatore interno: la conoscenza di cosa è substrato vive nella KB, non nel C.
machinery(present_rule).
present_rule(strip_underscore).          % gli atomi multi-parola si mostrano con spazi

% Nomi propri "importanti" di default (la conoscenza di CHI si capitalizza).
% È teachable a runtime come qualsiasi proper_name — la mesh la fa crescere.
proper_name(marie_curie).
proper_name(south_america).
proper_name(north_america).
proper_name(mary_shelley).
proper_name(don_quixote).
proper_name(ancient_rome).
proper_name(middle_ages).

% gen366 R1: generic realization of proof-carrying comparisons.  These frames
% contain no domain entity or conclusion; C fills them only from derived
% task_difference/task_goal_match results.
task_response_frame(comparison_first,
  "{x} and {y} differ on {dimension}: {x} has {x_property}, while {y} has {y_property}.").
task_response_frame(comparison_next,
  "On {dimension}, {x} has {x_property}, while {y} has {y_property}.").
task_response_frame(comparison_choice,
  "For {goal}, {winner} is the better fit because it provides {matches}.").
task_response_frame(comparison_tie,
  "For {goal}, neither option matches more stated requirements; the choice depends on which differing property matters most.").
task_response_frame(failure_explanation,
  "{system} is susceptible to {phenomenon} because it relies on {strategy}. This phenomenon exploits {condition}. That strategy is normally useful because it provides {benefit}. For example, {example}: {observation}.").
task_response_frame(procedure_intro,
  "{process}, in dependency order:").
task_response_frame(procedure_intro_deadline,
  "{process} fits {deadline} with about {minutes} minutes of active and cooking time:").
task_response_frame(procedure_step,
  "{number}. {instruction}").
task_response_frame(procedure_step_focus,
  "{number}. {instruction} This step strongly affects {impact}.").
task_response_frame(procedure_finish,
  "These actions reach {goal}.").

machinery(task_response_frame).
machinery(reasoning_gloss).
machinery(property_gloss).
