% ── gen505x — «X vive in Y» non aveva NESSUNA forma (glm-test §3.3) ────────
%
% `habitat/2` c'e' in KB con i suoi fatti, e `answer_frame("live in", …)`
% puntava a un'altra relazione: quindi «Penguins live in Antarctica» non era
% imparabile e «Where do penguins live?» non trovava cio' che c'era. Il report
% lo legge come «i soggetti plurali non diventano entita'»; misurato, e' piu'
% semplice e piu' grave — mancava la porta, in entrambi i versi.
% ── gen507 — AVERE UNA PARTE ──────────────────────────────────────────────
%
% «zelnik has a handle» entrava gia' in KB come `has(zelnik, handle)`, ma
% «does zelnik have a handle?» rispondeva di non saperne niente: la domanda
% porta l'INFINITO, l'asserzione la terza persona, e le due non si
% incontravano. Il muro proponeva «has is a relation verb» — una lezione che
% non si riesce a dare, perche' `have` e' anche l'ausiliare.
%
% Le tre superfici della stessa relazione, dette una volta.
relation(part).
extract_frame("@S has a @O", has_part).
extract_frame("@S has an @O", has_part).
extract_frame("@S has @O", has_part).
extract_frame("@S have a @O", has_part).
extract_frame("@S have @O", has_part).
extract_frame("@S ha un @O", has_part).
extract_frame("@S ha una @O", has_part).
% ── gen507/34 — DI CHE COSA E' FATTA UNA COSA ──────────────────────────────
% `made_of` mancava del tutto: parrot0 poteva tenere le PARTI di una cosa e non
% la sua MATERIA. Sono due relazioni diverse — una zattera ha un remo e e' fatta
% di tronchi — e servono entrambe al passo del giro /34.
machinery(made_of).
relation(material).
relation_noun(made_of, material).
extract_frame("@S is made of @O", made_of).
extract_frame("@S are made of @O", made_of).
extract_frame("@S is built from @O", made_of).
extract_frame("@S e' fatto di @O", made_of).
extract_frame("@S e' fatta di @O", made_of).
extract_frame("@S sono fatti di @O", made_of).
answer_frame("made of", made_of).
answer_frame("built from", made_of).

answer_frame("has", has_part).
answer_frame("have", has_part).
answer_frame("ha", has_part).
relation_noun(has_part, part).

extract_frame("@S live in @O", habitat).
extract_frame("@S lives in @O", habitat).
extract_frame("@S vive in @O", habitat).
extract_frame("@S vivono in @O", habitat).
% ⚠ Le `answer_frame` corrispondenti NON si aggiungono: provate, spengono le
% domande che gia' funzionavano («Where do penguins live?», e la polare
% «Do penguins live in the Arctic?» che il gen505x aveva appena chiuso). La
% porta di INGRESSO e quella di USCITA di questa relazione non si aprono con lo
% stesso gesto — `answer_frame("live in", can_live_in)` occupa gia' quella
% superficie, e sovrapporle cambia chi vince. Verdetto: rifiutato, specie
% `circostanza` — da riprendere quando si sapra' distinguere le due relazioni
% sulla stessa superficie.

extract_frame(@S uses @O, uses).
extract_frame("@S is called @O", also_known_as).
extract_frame(@S includes @O, includes).
extract_frame("@S is also called @O", also_known_as).
% Il nome e' un'intera superficie, anche se contiene preposizioni. Le
% introduzioni di menzione in input.p0 lo proteggono durante la lezione; il tipo
% testuale impedisce al legatore di troncarlo al primo confine nominale.
relation_value_kind(also_known_as, text).
extract_frame(@S releases @O, releases).
extract_frame(@S modified @O, modified).
extract_frame(@S modulates @O, modulates).
extract_frame(@S biases @O, biases).
extract_frame(@S detect @O, detect).
extract_frame(@S eradicate @O, eradicate).
extract_frame(@S shortens @O, shortens).
extract_frame(@S shortened @O, shortened).
extract_frame(@S improved @O, improved).
extract_frame(@S detected @O, detected).
extract_frame(@S eradicated @O, eradicated).
extract_frame("@S is referred to as @O", also_known_as).
extract_frame(@S secretes @O, secretes).
extract_frame(@S filter @O, filter).
extract_frame(@S pumps @O, pumps).
extract_frame(@S carries @O, carries).
extract_frame(@S digests @O, digests).
extract_frame(@S prevents @O, prevents).
extract_frame(@S minimizes @O, minimizes).
extract_frame(@S computes @O, computes).
extract_frame(@S predicts @O, predicts).
extract_frame(@S splits @O, splits).
extract_frame(@S harms @O, harms).
extract_frame(@S penalizes @O, penalizes).
extract_frame(@S represents @O, represents).
extract_frame(@S discovers @O, discovers).
extract_frame(@S applies @O, applies).
extract_frame(@S encodes @O, encodes).
extract_frame(@S refutes @O, refutes).
extract_frame(@S weakens @O, weakens).
extract_frame(@S surveys @O, surveys).
extract_frame(@S maps @O, maps).
extract_frame(@S tests @O, tests).
extract_frame(@S precedes @O, precedes).
extract_frame(@S organizes @O, organizes).
extract_frame(@S measures @O, measures).
extract_frame(@S is contracts @O, contracts).
extract_frame(@S is expands @O, expands).
extract_frame(@S is limits @O, limits).
extract_frame(@S is enables @O, enables).
extract_frame(@S is follows @O, follows).
