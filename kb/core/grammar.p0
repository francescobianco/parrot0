% ── PAGINE CHE DICHIARANO DI NON CONTENERE CONOSCENZA ────────────────────────
% gen382. "X may refer to ..." e' l'apertura di una pagina di DISAMBIGUAZIONE:
% non dice nulla su X, elenca cose diverse che portano lo stesso nome. Ricorre 8
% volte nel corpus, ed e' il difetto che il sogno aveva gia' mostrato — sognando
% il modale "may" parrot0 ha scaricato il mese di maggio e ci ha imparato sopra.
% Estrarre da una pagina cosi' non e' imparare poco: e' imparare il falso.
% Riconoscerla e' conoscenza sulla forma del testo, non sul suo argomento.
machinery(disambiguation_marker).
disambiguation_marker("may refer to").
disambiguation_marker("may also refer to").
disambiguation_marker("can refer to").
% gen506e — l'edizione italiana disambigua con altre parole.
disambiguation_marker("può riferirsi a").
disambiguation_marker("può indicare").
disambiguation_marker("si può riferire a").
disambiguation_marker("commonly refers to").

% La congiunzione finale di un elenco. Era il letterale " and " dentro i cicli di
% formattazione, e si vedeva: "Re, regina, torre, alfiere, cavallo AND pedone".
% Una parola che compone la frase e' vocabolario, quindi conoscenza.
machinery(list_final_joiner).
list_final_joiner(en, and).
list_final_joiner(it, e).

% gen382d: i tre membri che mancavano alle classi perche' vivevano solo dentro
% una lista copiata a mano in 70-social-pragma.c. La copia era incompleta in
% entrambe le direzioni: aveva "am/qual/quale" che le classi non avevano, e non
% aveva "was/were/might/must" che le classi avevano.
auxiliary(am).
question_word(qual).
question_word(quale).

% ── LE VARIABILI DI UNA REGOLA ───────────────────────────────────────────────
% gen382h. Fino a qui si poteva insegnare parlando una sola forma di regola,
% l'universale unario ("every X is a Y"): una variabile implicita, due predicati.
% Tutto cio' che LEGA piu' entita' restava fuori dalla conversazione, quindi
% parrot0 si addestrava a classificare ma non a ragionare.
%
% In lingua naturale le variabili non si scrivono con le lettere: si portano con
% i PRONOMI INDEFINITI e si riprendono con l'ANAFORA. Sono due classi chiuse,
% quindi conoscenza — esattamente come np_opener/1 e np_closer/1.
%
% Le lettere restano ammesse perche' sono un registro didattico legittimo ("se X
% e' un barista allora X e' una persona") e sono l'unico modo comodo di portare
% TRE variabili distinte in una frase sola.
%
% La differenza fra le due classi e' quella che la lingua fa gia': una seconda
% occorrenza di un INDEFINITO introduce una variabile NUOVA ("se qualcuno e' il
% genitore di qualcuno" = due persone), mentre un'ANAFORA riprende quella di
% prima ("...allora LUI e' ..." = la stessa).
rule_variable(someone).  rule_variable(anyone).   rule_variable(something).
rule_variable(qualcuno). rule_variable(chiunque). rule_variable(qualcosa).
rule_variable(x). rule_variable(y). rule_variable(z).

rule_anaphor(they). rule_anaphor(them). rule_anaphor(he). rule_anaphor(she).
rule_anaphor(it).   rule_anaphor(lui).  rule_anaphor(lei). rule_anaphor(esso).

% ── USO E MENZIONE (M2) ────────────────────────────────────────────────────
%
% Come si annuncia che si sta parlando DI una parola invece che usarla. Serve
% perche' una parola-funzione viene altrimenti consumata dal proprio ruolo:
% «unless is a condition marker» si ferma sul subordinatore prima di avere un
% soggetto. Le virgolette sono l'altra superficie, ed e' meccanica pura.
%
% Un marcatore nuovo — in questa o in un'altra lingua — e' una riga, non una
% ricompilazione.
machinery(mention_marker).
mention_marker(word).    mention_marker(term).
mention_marker(parola).  mention_marker(termine).  mention_marker(vocabolo).

% Dove finiscono antecedente, conseguente e alternativa. `logic_connector/2`
% e' la sorgente unica: il parser delle regole vede le due viste storiche,
% mentre il producer universale puo' costruire un piano a tre span. Una lingua
% o una congiunzione nuova entra qui e viene consumata da entrambi.
logic_connector(condition, if).       logic_connector(condition, se).
logic_connector(consequence, then).   logic_connector(consequence, allora).
logic_connector(alternative, otherwise). logic_connector(alternative, else).
logic_connector(alternative, altrimenti).
rule_antecedent_marker($Cue) :- logic_connector(condition, $Cue).
rule_consequent_marker($Cue) :- logic_connector(consequence, $Cue).

% ── STIPULARE o ASSERIRE ─────────────────────────────────────────────────────
% gen382k. Una premessa ipotetica puo' fare due cose diverse, e finora parrot0
% le trattava come una sola.
%
%   "SUPPONI CHE tutti i gatti siano pesci"  -> STIPULA: apre un mondo possibile.
%       Il "gatto" di quel mondo e' un altro concetto con la stessa etichetta,
%       quindi si rinomina e il conflitto con cio' che si sa e' IRRILEVANTE.
%
%   "tutti i gatti sono pesci"               -> ASSERISCE: parla del mondo di
%       sempre, quindi il "gatto" e' lo stesso e il conflitto con cio' che si sa
%       e' la cosa piu' importante da dire.
%
% La distinzione non e' una preferenza architetturale: e' una proprieta' della
% frase, ed e' portata da parole — quindi e' conoscenza. Misurata su un
% ragionatore vero in tests/coexistence_probe.py, che di fronte alla stessa
% premessa distingue le due letture e nomina il discriminante.
machinery(stipulation_cue).
stipulation_cue("supponi che").      stipulation_cue("supponiamo che").
stipulation_cue("immagina che").     stipulation_cue("immaginiamo che").
stipulation_cue("assumendo che").    stipulation_cue("ammesso che").
stipulation_cue("per ipotesi").      stipulation_cue("poniamo che").
stipulation_cue("suppose that").     stipulation_cue("suppose").
stipulation_cue("imagine that").     stipulation_cue("imagine").
stipulation_cue("assuming that").    stipulation_cue("assume that").
stipulation_cue("hypothetically").   stipulation_cue("for the sake of argument").
stipulation_cue("pretend that").     stipulation_cue("say that").

% gen413 — I CONDIZIONALI PROPOSIZIONALI.
%
% «if someone is a doctor then they are a scientist» si legge da sempre, perche'
% i due lati sono APPARTENENZE. «if it rains then the ground is wet» no: i due
% lati sono proposizioni intere, che e' la forma in cui la logica si dice quasi
% sempre. Acceso, un segmento che nessuna forma tipata riconosce diventa un atomo
% opaco sotto `holds/1` — e per la logica proposizionale basta: da «Q :- P» e «Q»
% non segue «P», e per saperlo non serve sapere cosa siano P e Q.
%
% E' un interruttore perche' allarga parecchio cio' che il lettore di regole
% accetta: chi vuole solo le forme tipate lo spegne.
machinery(propositional_conditionals).
propositional_conditionals(on).

% gen413 — GLI AUSILIARI CHE SI SPOSTANO IN TESTA in una domanda polare.
%
% «is the ground wet» e «the ground is wet» sono la stessa proposizione: la
% domanda e' l'asserzione con l'ausiliare portato davanti. Rimetterlo al suo
% posto e' una trasformazione generica, e quali parole si spostino cosi' e'
% conoscenza — una lingua nuova costa righe qui, non C.
%
% E' una classe a se' e non `aux_question/1` perche' quella serve alla
% traduzione (l'ausiliare che sparisce quando il verbo si coniuga) ed e' un
% insieme diverso: «do you speak» perde il «do», «is the ground wet» no.
machinery(polar_fronted).
polar_fronted(is).   polar_fronted(are).
polar_fronted(was).  polar_fronted(were).
polar_fronted(does). polar_fronted(do).  polar_fronted(did).

% ── gen419: LE FORME TRANSCODIFICABILI ──────────────────────────────────────
%
% Un token che ha una di queste forme smette di essere opaco e diventa un termine
% strutturato, disponibile a qualunque regola come `transcoded(Token, Termine)`.
% Il motore non sa che cosa sia un orario: sa spezzare su un separatore e contare
% i pezzi. Una notazione nuova — un altro formato di data, un'altra lingua —
% costa una riga qui.
machinery(transcode_shape).
machinery(transcoded).
transcode_shape(time, ":", 2).
transcode_shape(date, "-", 3).
transcode_shape(date, "/", 3).

% gen426 — ASSENSO E DINIEGO, come classi.
%
% «ok», «yes» e «no» da soli non chiedono di sapere qualcosa su «ok»: accusano
% ricezione. Erano solo stopword, quindi finivano nel saluto generico insieme a
% «what», «dog» e «qzxv» — sei turni diversi con la stessa risposta e la stessa
% firma. Una parola nuova, in qualunque lingua, costa una riga qui.
machinery(assent_word).
machinery(dissent_word).
assent_word(yes).  assent_word(ok).   assent_word(okay).
assent_word(si).   assent_word(certo). assent_word(va).
assent_word(certamente). assent_word(sicuro). assent_word(volentieri). assent_word(dai).
assent_word(sure). assent_word(please). assent_word(yep). assent_word(yeah).
dissent_word(no).  dissent_word(nope). dissent_word(nah).

% ── LE FORME CHE SI POSSONO OFFRIRE PER UNA PAROLA SOLA (gen430) ────────────
%
% Quando parrot0 si ferma su una parola che non sa leggere, il ciclo di
% autocorrezione dovrebbe INDOVINARE il pezzo mancante — e per questo arriva a
% tre casi su ottantotto. Ma l'interlocutore e' nella stanza: il pezzo non va
% indovinato, va CHIESTO, e dal gen427-429 la risposta e' gia' l'atto di
% insegnamento perche' ha effetto nel turno successivo.
%
% Ogni riga qui e' una forma che una PAROLA SOLA puo' avere, con la frase da
% dire per insegnarla. Una forma nuova si affaccia da sola nel messaggio: nessun
% file di C sa che questa lista esista.
machinery(word_teaching_offer).
machinery(teaching_offer_max).

% `{middle}` e' la parola al posto della relazione quando il turno ha la forma
% «X ? Y»; dove quella derivazione non c'e', il motore ricade sulla parola
% nominata, quindi la vecchia frase resta valida per il vecchio caso.
word_teaching_offer(relation_verb, "if {middle} is something one thing does to another, say «{middle} is a relation verb»").
% gen506 (glm-test §6.2): l'articolo si CONCORDA. «say «something is a eiffel»»
% era grammatica sbagliata proprio nel messaggio con cui parrot0 chiede di
% essere insegnato — e chi insegna male si fa insegnare male. `{article}` legge
% la stessa politica che il resto del motore usa per «a»/«an».
word_teaching_offer(class, "if it is a kind of thing, say «something is {article} {topic}»").
word_teaching_offer(condition_marker, "if it opens a condition, say «{topic} is a condition marker»").
word_teaching_offer(relation_noun, "if it names a value of something, say «the {topic} of X is Y»").
% M3/M13: se la forma nuova dice a modo suo qualcosa di gia' compreso, la
% lezione non e' una classe — e' una COSTRUZIONE.
word_teaching_offer(construction, "if «x {middle} y» says what you already say another way, say «x {middle} y means x <known verb> y»").
% M2: e la parola di cui si parla puo' essere una parola-funzione, che nessuna
% delle offerte precedenti sa ricevere perche' verrebbe consumata dal proprio
% ruolo.
word_teaching_offer(mention, "if {topic} is a word you want to talk ABOUT, say «the word {topic} is a …»").

% Quante offrirne. Due bastano a insegnare senza trasformare il muro in un
% modulo d'iscrizione — ed e' un fatto, non una scelta del C.
% assistente utile U3 — IL REGISTRO DEL MAESTRO SOLO CON CHI INSEGNA.
% «Hmm, I don't know about dinner yet. Want me to learn about it? Or teach me: if
% «x cook y» says what you already say another way, say «x cook y means x <known
% verb> y»» e' la frase giusta per chi addestra e incomprensibile per chi chiede
% aiuto (banco dell'utilita', 8 archi su 33). Chi insegna lo dice («I want to
% teach you», conduct_lesson1 in network.p0) e da li' il muro porta le frasi
% pronte; senza, porta solo l'offerta di informarsi. Il registro vale per la
% sessione e non si salva (`turn_scratch`): la prossima persona e' un'altra.
machinery(session_register).
turn_scratch(session_register).
teaching_offer_max(2) :- session_register(teacher).
teaching_offer_max(0) :- naf(session_register(teacher)).

% ── QUALE OFFERTA, DATA LA FORMA DEL TURNO (M13) ───────────────────────────
%
% Fino a qui il muro offriva SEMPRE le prime due forme dell'elenco, qualunque
% cosa fosse successo: «say «X is a relation verb»» anche quando la lacuna era
% una costruzione, una procedura o una parola-funzione. E' il difetto che il
% piano chiama M13 — parrot0 non sa dire CHE TIPO di lacuna ha, quindi la
% diagnosi resta a carico di chi insegna, e un teacher automatico la sbaglia.
%
% La forma del turno e' gia' pubblicata: `input_node_atom/3` e
% `input_node_before/3` sotto lo scope `current_turn`. La scelta diventa quindi
% una derivazione, e una specie nuova domani e' una regola.
machinery(turn_gap_shape).
machinery(turn_teaching_offer).
machinery(turn_gap_flanked).
machinery(turn_gap_middle).

% La parola opaca ha qualcosa PRIMA e qualcosa DOPO che non sia funzionale: e'
% la forma di una relazione binaria, non di una classe.
turn_gap_flanked($T, before, $Id) :-
    input_node_before($T, $Other, $Id),
    input_node_atom($T, $Other, $Word), naf(stopword($Word)).
turn_gap_flanked($T, after, $Id) :-
    input_node_before($T, $Id, $Other),
    input_node_atom($T, $Other, $Word), naf(stopword($Word)).

% La condizione NON e' che sia la parola nominata a stare in mezzo: in «zilvan
% brinks torvo» sono opache tutte e tre, e il muro nomina la prima. Cio' che
% conta e' che il TURNO abbia la forma di una relazione binaria — qualcosa,
% qualcosa in mezzo, qualcosa — perche' e' quella forma a rendere sensata la
% lezione di costruzione.
% La domanda «il turno apre un'interrogativa?» non dipende dal nodo: si fa UNA
% volta, prima di scorrere i nodi, non una volta per candidato.
turn_gap_shape($T, binary_frame) :-
    naf(turn_opens_question($T)),
    input_node_atom($T, $Id, $W),
    turn_gap_flanked($T, before, $Id),
    turn_gap_flanked($T, after, $Id).

% UNA DOMANDA NON HA LA FORMA DI UN'ASSERZIONE, e la differenza si vedeva:
% «is the word unless a condition marker?» offriva di insegnare «is is a
% relation verb», cioe' proponeva la copula come relazione. Un'offerta sbagliata
% e' peggio di nessuna offerta, perche' chi insegna la segue.
machinery(turn_opens_question).
machinery(input_node_precedes).
input_node_precedes($T, $Id) :- input_node_before($T, $Other, $Id).
% ⛔ gen513 — «NESSUNO LO PRECEDE» NON REGGE SU UN TESTO LUNGO.
%
% Le tre regole chiedevano il primo nodo per NEGAZIONE: «un nodo che nessun
% altro precede». Su un turno di una riga e' esatto; su un paragrafo di 1500
% byte l'IR ha centinaia di nodi, l'enumerazione dentro il `naf` non arriva in
% fondo, e la negazione riesce su un nodo che invece era preceduto. Effetto: un
% «is» a meta' paragrafo faceva credere che il turno APRISSE con una copula, e
% `compound_statement` cadeva — cioe' il testo non veniva piu' diviso in frasi.
%
% Misurato con la scala della prosa: a 1049 byte il paragrafo si divide, a 1515
% no, e la cue del confine di frase c'era in tutti e due i casi.
%
% Il primo nodo si CHIEDE, non si deduce per esclusione: comincia a byte zero.
% E' esatto, costa una riga, e non peggiora con la lunghezza del testo — che e'
% la proprieta' che serve a leggere la prosa (docs/plans/lettura-della-prosa.md).
machinery(input_node_first).
input_node_first($T, $Id) :- input_node_range($T, $Id, 0, $Len).
turn_opens_question($T) :-
    input_node_first($T, $Id), input_node_atom($T, $Id, $W), question_word($W),
    naf(turn_opens_conditional($T)).
turn_opens_question($T) :-
    input_node_first($T, $Id), input_node_atom($T, $Id, $W), clause_copula($W).
% L'inversione dell'ausiliare e' la stessa evidenza strutturale anche quando la
% domanda non ha una wh-word e non usa la copula: «did zorak shimmer?», «can a
% tern fly?». Quali forme siano ausiliari resta una classe KB aperta; insegnarne
% una nuova cambia questa lettura senza ricompilare.
turn_opens_question($T) :-
    input_node_first($T, $Id), input_node_atom($T, $Id, $W), auxiliary($W).

% ── assistente utile U2 — «WHEN … THEN …» APRE UNA CONDIZIONE, NON UNA DOMANDA ─
%
% «when someone has a problem then say we will look at it together» e' una
% lezione di condotta (forma E di LEARN_PROTOCOL.md). «when» e' anche un
% interrogativo, e la regola sopra la leggeva come domanda: la forma `teach_plan`,
% dichiarata per le affermazioni, veniva scartata e il turno cadeva nella
% riparazione («Who or what does «it» refer to?») — rosso di behavior_gen512.p0t.
% Un interrogativo che fa anche da congiunzione, seguito dal connettore del
% conseguente (lo span `consequence` che il segmentatore pubblica da
% `logic_connector/2`) e senza «?», regge una condizione. Quali parole lo siano
% e' una classe: una lingua nuova e' una riga.
machinery(conditional_question_word).
conditional_question_word(when).
conditional_question_word(quando).
turn_opens_conditional($T) :-
    input_node_first($T, $Id), input_node_atom($T, $Id, $W), conditional_question_word($W),
    turn_span($T, $Index, consequence, $Then),
    naf(turn_has_question_mark($T)).

% ── gen505y — LA DOMANDA NON DEVE APRIRE IL TURNO ──────────────────────────
%
% Reperto di F.: «sai cosa sono le sbaddune» -> «Imparato: sai what è un
% sbaddune». Un fatto FALSO scritto in KB da una domanda. Il perimetro non era
% «sai»: «zzz what are the sbaddune» faceva lo stesso, cioe' QUALUNQUE token
% davanti a una domanda la rendeva invisibile — le tre regole qui sopra
% chiedono tutte che l'interrogativo sia il PRIMO nodo.
%
% La distinzione che mancava: «il turno apre con un interrogativo» non e' «il
% turno contiene l'apertura di una clausola interrogativa». La seconda e'
% strutturale quanto la prima: un interrogativo seguito IMMEDIATAMENTE dalla
% copula («what are», «cosa sono», «qual è») apre una domanda dovunque stia,
% e non c'e' nessuna affermazione in cui quella coppia contigua si presenti.
%
% ⚠ Chi vede di piu' deve distinguere di piu' (mantra #19b): «che» e' un
% interrogativo («che cosa») ma anche un complementatore («so che è tardi»), e
% «che è» dentro un'affermazione non apre nessuna domanda. Quali interrogativi
% siano anche complementatori e' conoscenza, non un'eccezione nel motore: un
% membro nuovo domani e' una riga.
%
% L'adiacenza si legge dall'ordine dei nodi: B segue A e nessun token sta in
% mezzo. Non c'e' un predicato «prossimo token» da introdurre: l'ordine c'e'
% gia' (`input_node_before/3`), e questa e' una sua lettura.
complementizer(che).
complementizer(that).
% gen506c — GLI INVOLUCRI DI UNA DOMANDA. «can you say whether P?» chiede P:
% la formula davanti e' cortesia, non contenuto, e senza questo elenco la
% prendeva il registro sociale per la cue «can you». Il C (wrapper_peel,
% 99-registry.c) toglie l'involucro e rimette P nella forma polare.
machinery(question_wrapper).
question_wrapper("can you say whether").
question_wrapper("can you say if").
question_wrapper("can you tell me whether").
question_wrapper("can you tell me if").
question_wrapper("could you say whether").
question_wrapper("could you tell me whether").
question_wrapper("could you tell me if").
question_wrapper("do you know whether").
question_wrapper("do you know if").
question_wrapper("sai dirmi se").
question_wrapper("puoi dirmi se").
question_wrapper("mi sai dire se").
question_wrapper("is it true that").
question_wrapper("is it the case that").
question_wrapper("does it follow that").
question_wrapper("e' vero che").
question_wrapper("è vero che").
% assistente utile U8 — le CODE che fanno di un'affermazione una domanda:
% «paris is the capital of spain, right?» chiede la polare, e il presupposto
% sbagliato riceve cio' che si sa invece di un «France.» secco.
% assistente utile U6b — la cortesia davanti a una richiesta: «can you explain
% X?» chiede «explain X».
machinery(request_wrapper).
request_wrapper("can you explain", "explain").
request_wrapper("could you explain", "explain").
request_wrapper("can you tell me", "tell me").
request_wrapper("could you tell me", "tell me").
request_wrapper("please explain", "explain").
machinery(question_tag).
question_tag(", right").
question_tag(", isn't it").
question_tag(", correct").
question_tag(", true").
question_tag(", vero").
question_tag(", giusto").
question_tag(", no").
machinery(input_token_between).
machinery(input_node_next).
input_token_between($T, $A, $B) :-
    input_node_atom($T, $C, $W),
    input_node_before($T, $A, $C), input_node_before($T, $C, $B).
machinery(interrogative_clause_opener).
% Che cosa segua l'interrogativo e' la stessa evidenza che le tre regole sopra
% gia' leggono al primo nodo: la copula o l'ausiliare invertito («who has
% invented», «did zorak shimmer»). Una classe sola, letta in un secondo posto.
machinery(clause_inverter).
clause_inverter($V) :- clause_copula($V).
clause_inverter($V) :- auxiliary($V).
% gen506b: l'adiacenza la pubblica il motore (`input_node_next/3`, src/code.c) —
% derivarla da `input_node_before` + `naf(input_token_between)` costava O(n^4)
% e teneva il muro per minuti sui turni lunghi del banco di comprensione.
interrogative_clause_opener($T, $Id) :-
    input_node_atom($T, $Id, $W), question_word($W), naf(complementizer($W)),
    input_node_next($T, $Id, $Next),
    input_node_atom($T, $Next, $V), clause_inverter($V).
% ⛔ gen513 — «DOVUNQUE STIA» VALE PER UNA FRASE, NON PER UN PARAGRAFO.
%
% La regola qui sopra dice che un interrogativo seguito dalla copula apre una
% domanda dovunque si trovi, e per un turno di UNA frase e' vero: non c'e'
% affermazione in cui quella coppia contigua compaia. In un PARAGRAFO invece
% compare di continuo, dentro una subordinata — «…explains how it works»,
% «…shows where the field is» — e allora il turno intero veniva letto come
% domanda: `compound_statement` cadeva e il testo non veniva piu' diviso in
% frasi. Misurato sulla scala: a 1049 byte il paragrafo si divide, a 1515 no.
%
% Un turno che porta piu' frasi non e' una domanda perche' una delle sue
% subordinate lo sembra. Il confine di frase e' gia' una cue dichiarata.
machinery(turn_multi_sentence).
turn_multi_sentence($T) :- turn_cue($T, sentence_boundary_cue, $B).
turn_opens_question($T) :-
    interrogative_clause_opener($T, $Id), naf(turn_multi_sentence($T)).

% ── gen510 — LA PREPOSIZIONE DAVANTI ALL'INTERROGATIVO ──────────────────────
% «di dove sei», «da dove vieni», «con chi parli», «from where …»: la
% domanda non si apre con l'interrogativo ma con la preposizione che lo regge,
% e le tre regole sopra — che vogliono l'interrogativo come PRIMO nodo — la
% leggevano come un turno espressivo, cioe' come nessuna domanda (report gen509,
% il muro di «di dove sei»). Quali parole siano preposizioni e' una classe
% aperta: quelle inglesi le da' `preposition/1`, le altre sono righe qui.
machinery(question_preposition).
question_preposition($P) :- preposition($P).
question_preposition(di).  question_preposition(da).  question_preposition(a).
question_preposition(con). question_preposition(per). question_preposition(su).
question_preposition(tra). question_preposition(fra).
% gen513 — anche qui il primo nodo si CHIEDE («comincia a byte zero») invece di
% dedurlo per esclusione: su un paragrafo l'enumerazione dentro il `naf` non
% arriva in fondo e la negazione riesce su un nodo che era preceduto.
turn_opens_question($T) :-
    input_node_first($T, $Id), input_node_atom($T, $Id, $P),
    question_preposition($P),
    input_node_next($T, $Id, $Next), input_node_atom($T, $Next, $W),
    question_word($W), naf(complementizer($W)).

% E l'ordine in cui offrirle, che e' esso stesso conoscenza: davanti a una forma
% binaria la costruzione viene prima, perche' e' la lezione che non richiede di
% sapere gia' come parrot0 chiama quella relazione.
% E la parola di cui parla la lezione di costruzione non e' quella nominata dal
% muro — e' quella IN MEZZO, cioe' quella che sta al posto della relazione.
turn_gap_middle($T, $W) :-
    input_node_atom($T, $Id, $W),
    turn_gap_flanked($T, before, $Id),
    turn_gap_flanked($T, after, $Id),
    naf(clause_copula($W)),
    naf(stopword($W)).

% ── mix-04-23-004 — LA LACUNA NOMINA IL SINTAGMA, NON LA PRIMA PAROLA IGNOTA ──
% «what does a carbon monoxide detector detect?» costruiva la lacuna su
% «monoxide» (e la rete leggeva «Oxide»), «what does a fire blanket do?» su
% «blanket»: il muro nominava la prima parola lunga senza fatti. Quello che il
% turno nomina e' il nome dopo il determinante — due o tre parole piene, fino al
% verbo. Il motore chiede questa frase prima di scorrere le parole; se non c'e',
% resta la scelta di sempre.
machinery(turn_gap_phrase).
machinery(gap_np_words).
machinery(gap_np_word).
machinery(gap_np_goes_on).
machinery(known_topic_atom).
turn_gap_phrase($T, $Atom) :-
    input_node_atom($T, $D, $Det), english_determiner($Det),
    input_node_next($T, $D, $First), gap_np_words($T, $First, $Run, $Last),
    gap_np_verb_trim($T, at($D, $Last), $Run, $Ws),
    gap_phrase_size($Ws), words_underscored($Ws, $Atom), naf(known_topic_atom($Atom)).
gap_np_words($T, $Id, cons($W, $R), $Last) :-
    input_node_atom($T, $Id, $W), gap_np_word($W),
    input_node_next($T, $Id, $N), gap_np_words($T, $N, $R, $Last).
gap_np_words($T, $Id, cons($W, nil), $Id) :-
    input_node_atom($T, $Id, $W), gap_np_word($W), naf(gap_np_goes_on($T, $Id)).
% «what does a glimpwort NEED?»: con il «do» ausiliare davanti al soggetto, un
% sintagma che arriva a fine turno finisce col verbo nudo, che nessun elenco
% conosce. Si toglie l'ultima parola; altrove il sintagma resta intero.
machinery(gap_np_verb_trim).
machinery(do_support_before).
machinery(turn_node_last).
gap_np_verb_trim($T, at($D, $Last), $Run, $Ws) :-
    do_support_before($T, $D), turn_node_last($T, $Last), list_without_last($Run, $Ws).
gap_np_verb_trim($T, at($D, $Last), $Run, $Run) :- naf(do_support_before($T, $D)).
gap_np_verb_trim($T, at($D, $Last), $Run, $Run) :- turn_node_has_next($T, $Last).
do_support_before($T, $D) :- input_node_next($T, $A, $D), input_node_atom($T, $A, $Aux), do_support_verb($Aux).
turn_node_last($T, $Id) :- naf(turn_node_has_next($T, $Id)).
machinery(turn_node_has_next).
turn_node_has_next($T, $Id) :- input_node_next($T, $Id, $N).
machinery(do_support_verb).
do_support_verb(does).
do_support_verb(do).
do_support_verb(did).
machinery(list_without_last).
list_without_last(cons($W, nil), nil).
list_without_last(cons($W, cons($V, $R)), cons($W, $Rest)) :- list_without_last(cons($V, $R), $Rest).
gap_np_goes_on($T, $Id) :- input_node_next($T, $Id, $N), input_node_atom($T, $N, $W), gap_np_word($W).
gap_np_word($W) :- compound_word($W), naf(relative_clause_verb($W)), naf(question_word($W)).
machinery(gap_phrase_size).
gap_phrase_size(cons($A, cons($B, nil))).
gap_phrase_size(cons($A, cons($B, cons($C, nil)))).
known_topic_atom($A) :- topic_definition($A, $D).
known_topic_atom($A) :- topic_read($A, $R).

% La forma e' una DOMANDA DI ESISTENZA, non un elenco di testimoni. Chiesta in
% positivo, `turn_gap_shape/2` da' una soluzione per ogni terna (nodo, parola
% piena prima, parola piena dopo): su una frase di prosa di 34 nodi sono
% migliaia, e il motore che raccoglie le offerte le enumerava tutte per
% ricavarne due (E0, 18 settembre: 540 ms in una sola chiamata, meta' del costo
% del turno di lettura). La negazione si ferma alla prima prova; la forma
% presente e' la negazione della forma assente. Nessun contenuto cambia: le
% stesse quattro offerte, sulla stessa evidenza.
machinery(turn_gap_shape_absent).
turn_gap_shape_absent($T) :- naf(turn_gap_shape($T, binary_frame)).
turn_teaching_offer($T, construction) :- naf(turn_gap_shape_absent($T)).
turn_teaching_offer($T, relation_verb) :- naf(turn_gap_shape_absent($T)).
turn_teaching_offer($T, class) :- turn_gap_shape_absent($T).
turn_teaching_offer($T, mention) :- turn_gap_shape_absent($T).

% ── «QUESTO» CHE COSA? IL REFERENTE NON ALLEGATO (gen431) ───────────────────
%
% «explain this stack trace», «refactor this function», «translate this
% paragraph»: dodici dei cento fallimenti chiedono di lavorare su un testo che
% nessuno ha allegato. Non sono richieste difficili, sono richieste INCOMPLETE, e
% la risposta giusta e' dirlo e chiedere il pezzo.
%
% Un genere di contenuto nuovo — un verbale, una fattura, uno spartito — e' una
% riga qui, e da quel momento «questo <genere>» senza il testo viene riconosciuto.
machinery(content_kind).
machinery(demonstrative_word).

demonstrative_word(this).
demonstrative_word(these).
demonstrative_word(that).
demonstrative_word(those).

content_kind(story).
content_kind(function).
content_kind(paragraph).
content_kind(sentence).
content_kind(poem).
content_kind(claim).
content_kind(dialogue).
content_kind(experiment).
content_kind(trace).
content_kind(log).
content_kind(code).
content_kind(text).
content_kind(passage).
content_kind(article).
content_kind(contract).
content_kind(symptom).
content_kind(argument).
content_kind(diagram).

% gen431 — i quantificatori che aprono un plurale senza referente: «compare TWO
% GRAPHS structurally» non porta i due grafi. Un numero nuovo e' una riga.
machinery(countable_opener).
countable_opener(two).
countable_opener(three).
countable_opener(both).
countable_opener(due).
countable_opener(tre).
content_kind(graph).
content_kind(table).
content_kind(file).

% ── LE COPULE CHE SEGNALANO UNA FRASE (gen431) ──────────────────────────────
% Classe SEPARATA da `generic_copula`, e la separazione e' stata misurata:
% aggiungere «is» a quella cambiava l'estrazione italiana («Marte e' rosso»
% diventava un fatto, 4 invece di 3+1 in summary.it.p0t). Quella e' forse una
% cosa giusta, ma va fatta con la sua prova, non di straforo dentro un'altra
% riparazione. Qui serve solo a distinguere «in questa storia rex E' un drago»
% (il contenuto e' allegato) da «spiega questa poesia» (non lo e').
machinery(clause_copula).
% ── gen505z — DOVE FINISCE UNA FRASE E' CONOSCENZA (piano §3.1) ────────────
%
% Il lettore di passi (`read_passage`) spezzava su `. ! ? ;` scritti nel C. Una
% lingua nuova, o un'abbreviazione, chiedevano una ricompilazione. Qui il
% confine si dichiara, e riusa `sentence_terminator/2` che gia' chiude ogni
% risposta composta: ritirandolo il passo resta una frase sola, ed e'
% l'ablazione che distingue «il lettore consulta la KB» da «il lettore ha un
% punto compilato».
%
% Gli altri segni stanno qui e non in `sentence_terminator/2` apposta: quello e'
% consumato anche da chi COMPONE una risposta, e aggiungerci «!» farebbe
% terminare le frasi con un punto esclamativo.
machinery(passage_boundary_mark).
passage_boundary_mark($Mark) :- sentence_terminator($Language, $Mark).
passage_boundary_mark("!").
passage_boundary_mark("?").
passage_boundary_mark(";").

% ── I DETERMINANTI CHE PUNTANO INDIETRO ────────────────────────────────────
%
% «Its capital is Velk» non ha soggetto: lo prende dalla frase prima. Quali
% parole facciano questo e' vocabolario, quindi sta qui; che il focus scorra e'
% meccanica, e sta nel lettore.
machinery(referring_possessive).
referring_possessive(its).
referring_possessive(his).
referring_possessive(her).
referring_possessive(their).
referring_possessive(sua).
referring_possessive(suo).

% ── gen506 — «THE COUNTRY» E' IL FOCUS ─────────────────────────────────────
% Una pagina riprende il soggetto anche con un sintagma definito: «Tonga is an
% island country … The country was founded in 1845». Il sintagma definito
% riferisce il focus quando il focus E' un membro della classe che il sintagma
% nomina — e' inferenza sulla classe letta nella primaria, non una lista di
% parole. `apply/2` chiama la classe come predicato, cosi' vale per ogni classe
% che parrot0 abbia letto o imparato. Il lettore (reader_focus_rewrite) chiede
% qui, con la testa nuda e con i composti a testa destra («island_country»).
machinery(definite_refers_to_focus).
definite_refers_to_focus($Class, $Focus) :- apply($Class, cons($Focus, nil)).
referring_possessive(sue).
referring_possessive(suoi).
referring_possessive(loro).

clause_copula(is).
clause_copula(are).
clause_copula(was).
clause_copula(were).
clause_copula(e').
% La forma accentata e' un membro come gli altri: il turno di chat non passa
% sempre dalla riscrittura che produce `e'`, e una classe non deve dipendere da
% quale normalizzazione ha toccato la frase prima.
clause_copula(è).
clause_copula(sono).
clause_copula(era).
clause_copula(erano).

% gen432: gli articoli indeterminativi che, DENTRO UNA DOMANDA, indicano una cosa
% precisa che chi chiede ha in mente e non ha allegato («why did a function
% return early?»).
machinery(indefinite_opener).
indefinite_opener(a).
indefinite_opener(an).

% ── gen491: DIRE UNA RELAZIONE E' L'INVERSA DI LEGGERLA ──────────────────────
%
% Misurato il 2026-09-01 con `scripts/self_echo_audit.py`, che rimanda a parrot0
% le sue stesse frasi. In inglese la conferma di OGNI fatto imparato era un
% termine Prolog, e rileggendolo parrot0 lo classificava come codice altrui:
%
%   > the book is on the table   →  Learned: located_in(book, table).
%   > located_in(book, table)    →  That looks like a snippet of code.     ⛔
%
% Due difetti in una riga. Il primo: la risposta principale di parrot0 non e'
% LINGUA, e' notazione — e chi legge «located_in(book, table)» non sta leggendo
% una frase. Il secondo: parrot0 non riconosce la propria notazione come propria.
%
% LA CURA NON E' UN SECONDO ELENCO DI RESE. Un `relation_phrase/2` per relazione
% sarebbe un frasario destinato a divergere dai pattern di lettura: si potrebbe
% insegnare a parrot0 a LEGGERE «@S is part of @O» e a DIRE tutt'altro, e nessuno
% se ne accorgerebbe.
%
% La forma per dire una relazione e' esattamente l'inversa della forma per
% leggerla, e i pattern di lettura ci sono gia'. Cosi' i due lati condividono UN
% oggetto invece di accordarsi su due copie — la cura della forma ricorrente
% D33/D35/D37/D40 — e l'invariante dell'eco vale PER COSTRUZIONE: cio' che
% parrot0 dice e' stato costruito con un pattern che parrot0 sa leggere.
%
% Insegnare un `extract_frame` nuovo rende la relazione dicibile senza altro.
machinery(say_frame).
say_frame($Predicate, $Pattern) :- extract_frame($Pattern, $Predicate).
% gen510 — un nome di parentela si dice con la copula: «tom is the parent of
% bob», non «tom parent bob» (la forma piu' breve che `say_frame` sceglieva).
machinery(say_frame_preferred).
say_frame_preferred($R, $Pat) :-
    family_relation($R), concat_atoms("@S is the ", $R, $A), concat_atoms($A, " of @O", $Pat).

% ── gen491: QUALE ARTICOLO INDETERMINATIVO, E PERCHE' STA IN KB ──────────────
%
% Serve per dire in lingua un fatto di classe («whale is a mammal») invece di
% pronunciarne il termine («mammal(whale)»). La scelta dipende dall'iniziale, ed
% e' conoscenza della lingua: il motore chiede, non decide. Cosi' un'eccezione
% («an hour») e una lingua nuova sono righe, non codice.
%
% ⚠ L'ITALIANO NON E' COMPLETO QUI e la riga sotto lo dichiara: un/uno/una
% dipendono da genere e fonotassi, non dalla sola iniziale, e il genere dei nomi
% e' conoscenza che parrot0 non ha ancora. Il default «un» sbaglia sui femminili.
% Meglio una frase con l'articolo sbagliato che un termine Prolog — ma e' un
% debito dichiarato, non una svista.
machinery(indefinite_article_default).
machinery(indefinite_article_before).
indefinite_article_default(en, "a").
indefinite_article_default(it, "un").
indefinite_article_before(en, a, "an").
indefinite_article_before(en, e, "an").
indefinite_article_before(en, i, "an").
indefinite_article_before(en, o, "an").
indefinite_article_before(en, u, "an").

% ══ gen490 — IL LETTORE STRUTTURALE ERA COSTRUITO E SPENTO ═══════════════════
%
% `input-structure.p0` implementa per intero il matcher compositivo di
% `universal-input.md`: ruoli, ordini, operatori, coordinazione, provenienza. Ma
% i fatti che lo ACCENDONO non sono mai usciti dal laboratorio — al gen490
% `frame_pattern/4`, `frame_operator_concept/2`, `semantic_entity/1`,
% `semantic_class/1` e `phrase_form/4` avevano **zero fatti in tutta la KB**, e
% vivevano solo dentro i profili finti di `docs/labs/autocrescita-v3/`
% (`flourion`, `lumion`, `million`). Conseguenza misurata: su prosa vera di
% Wikipedia la lettura rendeva **0,13 fatti per frase**, e «Photosynthesis
% releases oxygen» — la forma piu' comune della prosa enciclopedica — non
% produceva niente. Non era un motore da scrivere: era un motore da collegare.
%
% Qui si collega, e si collega per DERIVAZIONE, non per elenco. La differenza e'
% il mantra #2 al livello del lettore: se le entita' fossero enumerate, il corpus
% leggibile sarebbe chiuso una volta per tutte; derivandole da cio' che parrot0
% gia' sa, ogni concetto imparato domani diventa leggibile domani, e insegnare
% «governs is a relation verb» accende la lettura di «X governs Y» dal turno
% dopo, senza ricompilare e senza toccare questo file.

% ── L'ORDINE DELLE PAROLE E' CONOSCENZA DI LINGUA ───────────────────────────
% Una lingua nuova che condivide un ordine noto e' sei righe, non un recognizer.
machinery(frame_pattern).
machinery(frame_operator_concept).
machinery(frame_gap_form).

frame_pattern(en, binary,     assertion, sro).
frame_pattern(en, binary,     question,  qsr).
frame_pattern(en, measure,    assertion, srvu).
frame_pattern(en, measure,    question,  qusr).
frame_pattern(en, membership, assertion, src).
frame_pattern(en, membership, question,  qrs).

frame_pattern(it, binary,     assertion, sro).
frame_pattern(it, binary,     question,  qrs).
frame_pattern(it, measure,    assertion, srvu).
frame_pattern(it, measure,    question,  qurs).
frame_pattern(it, membership, assertion, src).
frame_pattern(it, membership, question,  qrs).

% Quale interrogativo lascia scoperto quale ruolo.
% 20 settembre 2026 — «WHERE do coral reefs flourish?». Nella costruzione
% «soggetto + verbo + sintagma preposizionale» il luogo E' l'oggetto letto: la
% frase «Coral reefs flourish IN ocean waters» si registra come
% binary(flourish) con oggetto ocean_waters, quindi la domanda di luogo chiede
% quello stesso ruolo. Senza questa riga la domanda non produceva frame e
% rispondeva il frasario — la conoscenza c'era e la strada no.
frame_gap_form(en, where,  object).
frame_gap_form(en, what,   object).
frame_gap_form(en, what,   class).
frame_gap_form(en, which,  class).
frame_gap_form(en, many,   value).
% E2/E5, 19 settembre 2026 — la domanda sul SOGGETTO («what threatens forests?»,
% «who threatens forests?»): il gap viene prima del verbo e l'oggetto dopo.
frame_gap_form(en, what,   subject).
frame_gap_form(en, who,    subject).
frame_pattern(en, binary,     question,  qro).
% E2b in specie A, 19 settembre 2026 — il PASSIVO come ordine della IR
% (input-structure.p0), al posto dello schema di stringa.
frame_pattern(en, binary,     assertion, passive).
frame_pattern(en, binary,     question,  qpassive).
frame_gap_form(it, cosa,   object).
frame_gap_form(it, cosa,   class).
frame_gap_form(it, quale,  class).
frame_gap_form(it, quanti, value).

% ── CHE COSA E' UN OPERATORE: DERIVATO, MAI ELENCATO ────────────────────────
% Un verbo di relazione E' l'operatore binario della sua frase; la copula E'
% l'operatore di appartenenza. Le due classi crescono gia' parlando
% (`governs is a relation verb`), quindi anche la LETTURA cresce parlando.
frame_operator_concept($Verb, binary)     :- relation_verb($Verb).
frame_operator_concept($Verb, binary)     :- ternary_relation_verb($Verb).
frame_operator_concept($Cop,  membership) :- clause_copula($Cop).

% ── CHE COSA E' UN'ENTITA': CIO' CHE PARROT0 GIA' CONOSCE ───────────────────
% Non ogni parola: un'entita' e' un CONCETTO — qualcosa di cui la KB sa gia'
% qualcosa. Se lo fosse ogni lessema, ogni frase avrebbe letture concorrenti e
% la commit (che pretende un frame unico) non avverrebbe mai: si leggerebbe di
% piu' e si imparerebbe di meno.
% ⚠ §L — LA SORGENTE DELLE ENTITA' E' ANCHE IL SUO COSTO. La prima versione
% derivava un'entita' anche da `category_member/2`, che ha centinaia di fatti:
% valutata per ogni token di ogni turno costava 1,5-3,8s e mandava in timeout
% `taught_lexicon`. `wiki_concept/3` e' l'insieme giusto per due ragioni, e la
% seconda conta piu' della prima: e' piccolo, e soprattutto E' IL CORPUS. Ogni
% pagina letta lo allarga, quindi allargarlo rende leggibile altra prosa — la
% lettura finanzia la lettura, invece di dipendere da un elenco chiuso.
semantic_entity($E) :- wiki_concept($E, $Domain, $Gloss).
semantic_class($C)  :- wiki_concept($C, $Domain, $Gloss).

% La superficie di un concetto e' il concetto stesso quando nessun gloss dice
% altrimenti: `concept_label/4` resta la via per i casi in cui differiscono.
linguistic_form($W, $W, en, common) :- relation_verb($W), naf(word_has_other_verb_root($W)).
% 19 settembre 2026 — una forma che e' la flessione di un ALTRO verbo di relazione
% si legge come la sua radice: «supplies», dichiarato anche verbo a se' da una
% vecchia lezione, dava due operatori e due asserzioni per «Compost supplies
% nutrients», e la IR non ne impegnava nessuna. Il fatto resta; cambia quale
% lettura la IR preferisce.
machinery(word_has_other_verb_root).
word_has_other_verb_root($W) :- verb_reading_form($Root, $W), dif($Root, $W).
% E2a, 19 settembre 2026 — e le sue forme flesse: la IR riconosceva come
% operatore solo la forma nuda («threatens» non era un operatore). Le forme di
% lettura sono gia' conoscenza (`verb_reading_form/2`, una vista).
linguistic_form($Form, $Root, en, common) :- verb_reading_form($Root, $Form), dif($Root, $Form).
linguistic_form($W, $W, en, common) :- clause_copula($W).
linguistic_form($W, $W, en, common) :- wiki_concept($W, $Domain, $Gloss).

% ── gen491 — QUALI PROCESSI VALE LA PENA CONGELARE ──────────────────────────
%
% F.: «usare delle cache, delle liste ordinate per favorire un early match,
% delle kv con hash su processi gia' ricostruiti — la KB deve crescere e
% crescera', quindi i problemi di carico li avremo sempre».
%
% `materialized_view(Predicato, Arita')` dice al motore che le soluzioni di quel
% predicato vanno enumerate UNA volta per revisione della conoscenza e tenute
% come fatti derivati, invece di essere riderivate a ogni domanda. Quali
% processi lo meritino e' conoscenza: il motore possiede solo il meccanismo, e
% un predicato che domani diventasse caro e' una riga in piu' qui.
%
% `extract_frame/2` e' il caso che ha aperto il tema: misurato col profilo,
% costava 890 ms su 1075 di turno (442 chiamate, 266.553 passi) perche' e' fatti
% PIU' le regole che ne generano uno schema per ogni verbo di relazione,
% ricorrendo su liste di caratteri. Ed e' anche il motivo per cui il corpus non
% si poteva allargare: ogni verbo nuovo moltiplicava quel costo.
machinery(materialized_view).
materialized_view(extract_frame, 2).
materialized_view(verb_stem, 2).
materialized_view(swapped_construction_cue, 2).
materialized_view(construction_target_cue, 2).
materialized_view(active_agent_surface, 2).
materialized_view(particle_finite_surface, 2).
% Le superfici che una lezione di costruzione rivendica (vedi `construction_claims/1`):
% la guardia del passivo generico le chiede una per schema, quindi si congelano.
materialized_view(construction_claims, 1).
materialized_view(finite_reading_verb_form, 1).
materialized_view(adjective_relation_head, 1).
% gen510 — le COPPIE di una vista binaria in una sola enumerazione. Il motore
% (`kb_view_ensure`) la usa per congelare una vista senza rienumerarla una volta
% per ogni primo argomento: con `extract_frame` era un costo quadratico nel
% numero di pattern, 6 secondi a ogni avvio.
machinery(view_pair).
view_pair($P, pair($X, $Y)) :- apply($P, cons($X, cons($Y, nil))).

% Da CHE COSA dipende una vista: i predicati la cui variazione la invalida. E'
% la chiave della cache, e dev'essere stretta — la prima versione usava la
% revisione dell'intera KB e la vista si ricostruiva a ogni turno, perche' ogni
% turno asserisce le proprie tracce. Misurato: 1075 ms -> 1725 ms, cioe' una
% cache che costava piu' di quello che risparmiava.
machinery(view_depends).
view_depends(extract_frame, extract_frame).
view_depends(extract_frame, relation_verb).
view_depends(extract_frame, ternary_relation_verb).
view_depends(extract_frame, verb_suffix).
view_depends(extract_frame, verb_stem).
view_depends(extract_frame, construction_claims).
% Le cornici delle reggenze e degli aggettivi sono dentro `extract_frame`: se si
% congelano DOPO di lei, la sua vista nasce vecchia e si rifa' nel primo turno
% (misurato il 19 settembre 2026: 3,1 s dentro il turno invece che all'avvio).
% Dichiararle e' dire la verita' sull'ordine, non un trucco della cache.
view_depends(extract_frame, verb_particle_surface).
view_depends(extract_frame, adjective_relation_pred).
view_depends(extract_frame, passive_participle_frame).
view_depends(verb_stem, relation_verb).
view_depends(verb_stem, verb_suffix).

% ── 19 settembre 2026 — LE CORNICI CHE LA FOGLIATA HA RESO CARE ─────────────
%
% Con il lessico verbale della prima fogliata (1.144 verbi di relazione, 426
% reggenze, 438 relazioni aggettivali) tre processi di `answer_frame/2` sono
% diventati il costo del turno: 52 ms -> 364 ms nel solver, 27 chiamate,
% 100.000 passi (misurato con `/debug`). Nessuno dei tre dipende dal turno —
% sono superfici del lessico — quindi si congelano come le altre. Il rimedio e'
% una riga per processo, non una potatura della conoscenza: la stessa scelta che
% gen491 aveva gia' fatto per `extract_frame`.
materialized_view(verb_particle_surface, 2).
view_depends(verb_particle_surface, verb_particle).
view_depends(verb_particle_surface, relation_verb).
view_depends(verb_particle_surface, verb_form_analysis).
% E la vista per RADICE, che e' la strada vera di `verb_finite_form`: senza
% dichiararla, dopo una lezione si ricostruiva con la dipendenza ancora sporca
% e la ri-derivava a mano — 958 ms invece di 9 (misurato il 19 settembre 2026).
view_depends(verb_particle_surface, verb_root_form).
materialized_view(adjective_relation_pred, 2).
view_depends(adjective_relation_pred, adjective_relation).
% Il participio che interroga il passivo («what is compost prepared by?»): la
% forma e' lessico, la guardia `naf(relation_verb(Forma))` pure.
machinery(passive_participle_frame).
materialized_view(passive_participle_frame, 2).
view_depends(passive_participle_frame, relation_verb).
view_depends(passive_participle_frame, verb_form_analysis).
view_depends(passive_participle_frame, verb_suffix).

% ── gen513 — LE PAROLE CHE APRONO UNA RELATIVA ──────────────────────────────
% Servono al lettore composto per riconoscere che dopo la virgola comincia una
% PROPOSIZIONE e non un modificatore: «…phylum Cnidaria, WHICH INCLUDES sea
% anemones». Il soggetto della relativa e' l'ultimo sintagma nominale prima
% della virgola, e chi lo dice e' la IR. Una lingua nuova costa una riga.
machinery(relative_opener).
relative_opener(which).
relative_opener(who).
relative_opener(whose).
% gen514 — il relativo possessivo: la seconda proposizione parla del nome
% POSSEDUTO, legato all'antecedente. «stony corals, whose polyps cluster in
% groups» -> «polyps of stony corals cluster in groups».
% gen514 — «that» apre una relativa anche senza virgola, ma solo se la parola
% dopo e' la forma di un verbo di relazione: altrimenti e' complementatore
% («indicate that DART slowed») o dimostrativo.
% gen514 — il participio che apre gli ESEMPI del sintagma precedente, con il
% verbo della relazione che dichiara: «marine species, including fish» ->
% «marine species include fish».
% gen514 — i participi che, davanti alla virgola, aprono una frase sul soggetto
% della principale: «Sometimes called rainforests of the sea, shallow coral reefs…».
machinery(fronted_participle).
fronted_participle(called).
fronted_participle(known).
fronted_participle(named).
fronted_participle(located).
fronted_participle(found).
% gen514 — una parentetica dopo un sintagma ne da' gli esempi. Il verbo e' la
% forma canonica della relazione (`includes`, a cui porta anche la domanda con il
% verbo nudo): «@S include @O» curato scrive `include`, e due nomi per la stessa
% pretesa non si incontrano.
knowledge_alias(include, includes).
machinery(parenthetical_relation).
parenthetical_relation(includes).
% gen514 — i RANGHI di una classificazione, e la preposizione che mette un rango
% dentro un altro: «the class Anthozoa IN the animal phylum Cnidaria».
% gen514 — il composto agentivo «reef-building corals»: il secondo pezzo e' il
% gerundio di un verbo di relazione, il primo il suo oggetto (al plurale se
% numerabile). Irregolari e non numerabili si aggiungono come fatti.
machinery(agentive_compound_root).
machinery(count_plural).
agentive_compound_root($Gerund, $Root) :-
    concat_atoms($Root, "ing", $Gerund), relation_verb($Root).
count_plural($Singular, $Plural) :- concat_atoms($Singular, "s", $Plural).
% gen514 — un turno inglese non traduce le proprie parole: «due to» non e' «two
% to». Si traducono le parole piene solo dalle lingue che la KB dichiara sorgenti
% della traduzione verso la forma canonica (`content_translation_source/1`).
% (`lexeme/1` si carica solo su richiesta, quindi non puo' decidere qui.)
machinery(keeps_own_word).
machinery(content_translation_source).
content_translation_source(it).
keeps_own_word($Lang, $W) :- naf(content_translation_source($Lang)).
machinery(rank_noun).
machinery(rank_container_preposition).
rank_noun(kingdom). rank_noun(phylum). rank_noun(class). rank_noun(order).
rank_noun(family). rank_noun(genus). rank_noun(species).
rank_container_preposition(in).
% E l'appartenenza e' transitiva: chi sta in una classe sta anche nel phylum
% che la contiene. `membership_chain/2` risale di un livello per ogni relazione
% che la KB dichiara transitiva e di appartenenza; il tipo chiesto («what
% PHYLUM…») sceglie il livello.
machinery(membership_relation).
machinery(membership_chain).
membership_relation(belong).
relation_type(belong, transitive).
% Solo quando la domanda chiede un TIPO: senza, la risposta diretta («what does
% coral belong to?» -> class anthozoa) e' quella giusta, e la catena la scavalcava.
membership_chain($A, $C) :-
    has_asked_answer_type(current_turn),
    membership_relation($R), relation_type($R, transitive),
    apply($R, cons($A, cons($B, nil))), apply($R, cons($B, cons($C, nil))).
answer_frame("belong to", membership_chain).
machinery(participial_opener).
% 18 settembre 2026, notte — il GERUNDIO di ogni verbo di relazione apre la
% stessa frase sul soggetto della principale: «Coral reefs first appeared …,
% displacing the microbial and sponge reefs» -> «coral reefs displace the
% microbial and sponge reefs». Tre aperture scritte a mano (including, such
% as, incluso) diventano una classe: un verbo insegnato parlando («displace is
% a relation verb») porta con se' il proprio gerundio, con la -e finale che
% cade (displace -> displacing) e senza (form -> forming).
machinery(gerund_of).
gerund_of($Root, $G) :- relation_verb($Root), concat_atoms($Stem, "e", $Root), concat_atoms($Stem, "ing", $G).
% (la seconda clausola vale anche per i verbi in -e: «displaceing» non compare
% in nessun testo, e un `naf` su uno stelo libero non decide)
gerund_of($Root, $G) :- relation_verb($Root), concat_atoms($Root, "ing", $G).
% 18 settembre 2026, notte — e il gerundio CHIUDE il sintagma, come la forma
% finita (gen513, `np_closer ← relation_verb`): «prepared by decomposing plant
% and food waste» non nomina una cosa chiamata «decomposing plant». E' la
% guardia del passivo dalla radice (sopra) e di ogni slot che un gerundio apre.
% ⛔ PROVATO E RITIRATO la stessa notte, misurato sul piolo 320 (referto -2318):
% con il gerundio confine, «what does composting require?» perdeva «Gathering a
% mix», «what do the benefits of compost include?» perdeva «providing
% nutrients», «the resulting mixture» non era piu' un soggetto: il lettore al
% confine SCARTA l'intero riempitivo invece di tagliare. Tre risposte vere per
% un fatto falso evitato: il rimedio giusto e' nel lettore (tagliare al
% confine), un circuito, non questa riga. Per riprovarla quando il lettore taglia:
%   np_closer($G) :- gerund_of($Root, $G).
% ⚠ NON ancora un'apertura participiale: il lettore delle aperture (99-registry.c,
% relative_rewrite) lega la frase aperta al sintagma PRIMA della virgola («marine
% species, including fish» → «marine species include fish»), mentre il gerundio
% di un'azione parla del SOGGETTO della principale («Reefs form ecosystems,
% displacing the sponge reefs» → «reefs displace …», non «ecosystems displace»).
% Con il ponte `participial_opener($G, $Root) :- gerund_of($Root, $G)` si
% scriverebbe un fatto falso. Il consumatore giusto e' il circuito successivo;
% `gerund_of/2` resta come conoscenza della forma, interrogabile.
participial_opener(including, includes).
participial_opener("such as", includes).
participial_opener(incluso, includes).
machinery(bare_relative_opener).
machinery(relative_clause_verb).
bare_relative_opener(that).
relative_clause_verb($W) :- verb_reading_form($Root, $W).
machinery(possessive_relative_opener).
machinery(possessive_link).
possessive_relative_opener(whose).
possessive_link(whose, of).
possessive_relative_opener(cui).
possessive_link(cui, di).
relative_opener(che).
relative_opener(cui).

% ── gen513 — UN SEGNO DI FINE FRASE FRA DUE CIFRE APPARTIENE AL NUMERO ──────
% «0.1%», «3.5 percent», «1.6 billion tons»: il punto non chiude la frase, e
% chi lo prendeva per un confine perdeva tutto cio' che seguiva il numero —
% senza un muro e senza una traccia. Il tokenizzatore lo sa dal gen399; il
% lettore di prosa no, ed e' il caso peggiore dell'audit KB-first: la stessa
% conoscenza scritta due volte, di cui una sbagliata.
machinery(boundary_not_between_digits).
boundary_not_between_digits(".").

% ── gen513 — LE MISURE, E IL PARTITIVO CHE LE LEGA A CIO' CHE MISURANO ──────
% «0.1 percent OF the world ocean area» e' UN valore, non due: senza queste
% righe lo slot si fermava a «of» e la testa del valore si perdeva. Una misura
% nuova costa una riga e vale dal turno dopo.
machinery(measure_noun).
measure_noun(percent).
measure_noun(percentage).
measure_noun(share).
measure_noun(fraction).
measure_noun(half).
measure_noun(third).
measure_noun(quarter).
measure_noun(part).
measure_noun(portion).
measure_noun(proportion).
measure_noun(percento).
measure_noun(parte).
measure_noun(meta).

machinery(partitive_preposition).
partitive_preposition(of).
partitive_preposition(di).

% Il partitivo lega anche un quantificatore al suo dominio: «some of the
% ecosystems». La scelta delle teste e la congiunzione sono conoscenza; il
% lettore degli slot e quello del loro limite chiedono la STESSA relazione.
machinery(partitive_head_class).
machinery(partitive_link).
partitive_head_class(measure_noun).
partitive_head_class(non_universal_quantifier).
partitive_head_class(universal_quantifier).
% gen514 — e un NOME D'ATTRIBUTO lega il suo portatore: «the annual global
% economic value OF coral reefs» e' un soggetto solo, non «value» piu' un
% complemento perso. Un attributo nuovo e' una riga.
partitive_head_class(attribute_noun).
machinery(attribute_noun).
attribute_noun(value).
attribute_noun(price).
attribute_noun(cost).
attribute_noun(population).
% mix-04-05-001 — e un NOME DI STATO lega cio' di cui e' lo stato: «a device
% which detects THE PRESENCE OF carbon monoxide gas» (Carbon monoxide detector,
% Wikipedia) si leggeva `detect(…, presence)`, e «what does a carbon monoxide
% detector detect?» rispondeva «presence.». Uno stato nuovo e' una riga.
partitive_head_class(state_noun).
machinery(state_noun).
state_noun(presence).
state_noun(absence).
state_noun(level).
state_noun(levels).
state_noun(concentration).
state_noun(buildup).
% 26 settembre 2026 (P11) — e un NOME DI RACCOLTA lega cio' che raccoglie: «a
% stack trace shows THE SEQUENCE OF function calls». La classe nasce qui, VUOTA,
% con il suo nome pronunciabile: i membri si insegnano parlando («sequence is a
% collection noun»), non si scrivono.
partitive_head_class(collection_noun).
machinery(collection_noun).
class_surface(collection_noun, collection noun).
partitive_link($Head, $Prep) :-
    partitive_preposition($Prep), partitive_head_class($Class),
    apply($Class, cons($Head, nil)).

% Un valore misurato e' piu' lungo di un concetto, e non perche' ha ingoiato
% qualcosa: «0.1 percent of the world ocean area» sono sette parole e sono tutte
% del valore. Vale solo per le forme che contengono un partitivo dopo una misura.
% gen514 — i limiti di una quantita' («at least 25%», «about half») fanno
% parte del valore quando precedono un numero.
machinery(quantity_bound).
quantity_bound("anywhere from").
quantity_bound("at least").
quantity_bound("at most").
quantity_bound("about").
quantity_bound("around").
quantity_bound("up to").
quantity_bound("more than").
quantity_bound("less than").
quantity_bound("nearly").
quantity_bound("almost").
quantity_bound("over").
machinery(measured_value_max_words).
measured_value_max_words(9).

% ── gen513 — UN VERBO DI RELAZIONE CHIUDE UN SINTAGMA NOMINALE ─────────────
% «what do coral reefs occupy?»: il sintagma del soggetto finiva per inglobare
% il verbo («coral_reefs_occupy»), quindi la chiave giusta non veniva mai
% costruita e la risoluzione PER DESCRIZIONE — quella che sa che «coral reefs»
% descrive «shallow coral reefs» — non poteva scattare. `pos/2` dichiara nove
% verbi; i verbi di relazione insegnati sono centinaia, e sono verbi a tutti
% gli effetti. Un confine dichiarato una volta vale per il lettore E per la IR.
% 18 settembre 2026, notte — SALVO CHE IL TURNO PARLI DI UNA PAROLA. «threaten
% is a relation verb» con `threaten` gia' verbo: il verbo chiudeva il sintagma,
% il soggetto restava vuoto e la lezione ripetuta cadeva nel muro (il difetto
% del canale #1, §4-sexies.3). Un turno che dopo la copula nomina una testa
% metalinguistica (`metalinguistic_head/1`: verb, noun, marker, word, name…)
% ha per soggetto una parola menzionata, e una parola menzionata non e' chiusa
% da nessun verbo. E' la stessa regola con una condizione in piu', non un
% predicato parallelo; `p0_np_closer` la enumera una volta per turno.
% E0, 19 settembre 2026: la condizione sul turno e' ground e vale lo stesso per
% ogni verbo, quindi si chiede PRIMA. Nell'ordine inverso `p0_np_closer`, che
% enumera la classe, la rivalutava per ognuno dei ~290 verbi di relazione:
% 210 ms su 7 enumerazioni nella frase del compost, cioe' tutto il costo di
% `np_closer`. Il significato non cambia.
% L2 (reading-choices.p0): una parola che il maestro ha detto parte del sintagma
% QUI — «trap belongs to the noun phrase» — non lo chiude, anche se e' un verbo.
% La guardia si chiede UNA volta (`reading_continuer_exists(any)`, ground): senza
% lezioni la regola e' quella di prima, e non paga ~290 prove per enumerazione.
% RI-012, portata dal C il 26 settembre 2026: dentro un turno il primo verbo e'
% il verbo della frase, e un verbo che viene DOPO un altro verbo e' un
% modificatore («Capacitors block DIRECT current»). Il filtro in
% `p0_np_closer` toglieva dalla vista OGNI chiusore dopo il primo, anche le
% preposizioni: «the lungs absorb oxygen FROM the air» si leggeva
% `absorb(lungs, oxygen_from_the_air)`, e nessuna lezione di confine poteva
% curarlo (sessione live, docs/sessions/2026-09-26-live-fisiologia.md). Qui
% la condizione vale solo per i verbi, e chi e' un verbo lo dice la KB.
machinery(turn_verb_closer).
turn_verb_closer($U) :- relation_verb($U).
turn_verb_closer($U) :- finite_reading_verb_form($U).
machinery(turn_verb_before).
% 26 settembre 2026 (P11) — e un verbo che CHIUDE un nome composto che il maestro
% ha gia' tenuto come COSA non chiude il sintagma: dopo «A stack trace is a
% list.», in «A stack trace shows the sequence of function calls» «trace» e' la
% testa del nome, non il verbo. La prova e' che il composto e' gia' argomento di
% un fatto detto dal maestro (`fact_mention/2`, indicizzata per entita'):
% `declared_thing/1` scorreva tutte le classi e raddoppiava il costo di
% np_closer, che si paga a ogni token (misurato: 500 → 900–1200 ms).
machinery(turn_declared_compound_tail).
turn_declared_compound_tail($W) :-
    turn_word(current_turn, $J, $W), is($I, sub($J, 1)), turn_word(current_turn, $I, $P),
    concat_atoms($P, "_", $X), concat_atoms($X, $W, $A), fact_mention($A, $S).
turn_verb_before($V) :-
    turn_word(current_turn, $J, $V), turn_word(current_turn, $I, $U), lt($I, $J), dif($U, $V), turn_verb_closer($U).
np_closer($V) :- naf(reading_continuer_exists(any)), naf(turn_mentions_word(current_turn)), relation_verb($V), naf(turn_verb_before($V)), naf(turn_declared_compound_tail($V)).
np_closer($V) :- reading_continuer_exists(any), naf(turn_mentions_word(current_turn)), relation_verb($V), naf(reading_continuer($V)), naf(turn_verb_before($V)), naf(turn_declared_compound_tail($V)).
% E2a, 19 settembre 2026 — e la sua forma finita al presente (-s, -es, -ies):
% «The zorvan beetle threatens …» correva fino a fine clausola. Participi e
% gerundi restano fuori: dentro un sintagma sono modificatori legittimi.
machinery(finite_present_of).
np_closer($Form) :- naf(reading_continuer_exists(any)), finite_reading_verb_form($Form), naf(turn_verb_before($Form)), naf(turn_declared_compound_tail($Form)).
np_closer($Form) :- reading_continuer_exists(any), finite_reading_verb_form($Form), naf(reading_continuer($Form)), naf(turn_verb_before($Form)), naf(turn_declared_compound_tail($Form)).
% 23 settembre 2026 — LA STESSA CONOSCENZA, INDICIZZATA DALLA PAROLA LETTA.
% Il lettore chiede `np_closer(Parola)` una volta per token, con la parola
% legata, e per ognuna la regola rifaceva la morfologia su migliaia di forme:
% 0,9 s su 2 del turno che legge una pagina (deep_memory.p0t, misurato con
% `!debug` spegnendo le regole una per una). La vista la calcola una volta,
% indicizzata sulla forma; enumerata da libera da' le stesse parole.
machinery(finite_reading_verb_form).
finite_reading_verb_form($Form) :- verb_reading_form($Root, $Form), finite_present_of($Root, $Form).
finite_present_of($Root, $Form) :- concat_atoms($Root, "s", $Form).
finite_present_of($Root, $Form) :- concat_atoms($Root, "es", $Form).
finite_present_of($Root, $Form) :- y_to_ies($Root, $Form).
machinery(turn_mentions_word).
turn_mentions_word($T) :-
    turn_word($T, $I, $C), clause_copula($C),
    turn_word($T, $J, $H), gt($J, $I), metalinguistic_head($H).

% ── 12 settembre 2026 — LA DOMANDA DICHIARA IL TIPO DELLA RISPOSTA ─────────
% «what PHYLUM does coral belong to?» riceveva «Class anthozoa.», e «what KIND
% OF CORALS are most reefs built from?» riceveva «Colonies.»: la relazione era
% giusta, il valore no, perche' la parola che nomina il tipo chiesto non la
% guardava nessuno. Una risposta confidente del tipo sbagliato e' una bugia
% (mantra #7), non una risposta parziale.
% Il tipo e' il nome fra l'interrogativo e l'ausiliare («what phylum DOES»),
% oppure dopo un nome di tipo («what kind of corals ARE»). L'ausiliare dopo e'
% la condizione che separa un tipo da un verbo: «what holds coral…» non chiede
% un tipo «holds». Tutte le parole sono classi: una lingua nuova e' una riga.
machinery(typed_wh_word).
machinery(type_noun).
machinery(asked_answer_type).
machinery(answer_fits_type).
machinery(answer_type_ok).
typed_wh_word(what).
typed_wh_word(which).
type_noun(kind).
type_noun(type).
type_noun(sort).
auxiliary(did).
turn_word($T, $I, $W) :- turn_surface_token($T, 0, $I, $Tok), span_atom($Tok, $W).

% Una preposizione senza complemento in coda chiede una relazione, non una
% definizione («what is calcium carbonate for?»). Si verifica la risposta
% candidata sull'IR gia' pubblicata, senza rileggere o riscrivere la domanda.
% La classe resta aperta: insegnare una preposizione cambia anche la verifica.
machinery(definition_answer_ok).
machinery(definition_unfilled_relation).
turn_word_at($T, $I) :- turn_surface_token($T, 0, $I, $Tok).
turn_last_word($T, $W) :-
    turn_word($T, $I, $W), is($Next, add($I, 1)),
    naf(turn_word_at($T, $Next)).
definition_unfilled_relation($T) :-
    turn_last_word($T, $W), question_preposition($W).
definition_answer_ok($T) :- naf(definition_unfilled_relation($T)).
turn_word_opens_clause($T, $I) :- turn_word($T, $I, $W), auxiliary($W).
turn_word_opens_clause($T, $I) :- turn_word($T, $I, $W), clause_copula($W).
asked_answer_type($T, $Type) :-
    turn_word($T, $I, $Wh), typed_wh_word($Wh), is($J, add($I, 1)),
    turn_word($T, $J, $Type), naf(type_noun($Type)), naf(stopword($Type)),
    is($K, add($I, 2)), turn_word_opens_clause($T, $K).
asked_answer_type($T, $Type) :-
    turn_word($T, $I, $Wh), typed_wh_word($Wh), is($J, add($I, 1)),
    turn_word($T, $J, $N), type_noun($N), is($K, add($I, 3)),
    turn_word($T, $K, $Type), typed_after_type_noun($T, $K).
typed_after_type_noun($T, $K) :- is($L, add($K, 1)), turn_word_opens_clause($T, $L).
% La risposta e' del tipo se lo NOMINA (anche al singolare o al plurale), o se
% la KB la tiene come membro di quella classe.
answer_fits_type($Ans, $Type) :- atom_words($Ans, $Ws), member($Type, $Ws).
answer_fits_type($Ans, $Type) :- lemma_candidate($Type, $L), atom_words($Ans, $Ws), member($L, $Ws).
answer_fits_type($Ans, $Type) :- atom_words($Ans, $Ws), member($W, $Ws), lemma_candidate($W, $Type).
answer_fits_type($Ans, $Type) :- apply($Type, cons($Ans, nil)).
answer_fits_type($Ans, $Type) :- lemma_candidate($Type, $L), apply($L, cons($Ans, nil)).
% mix 01×08 — e se la KB la tiene come membro della CATEGORIA: «what color is
% blood?» chiede un colore, e `red` lo e' come `category_member(color, red)`, non
% come `color(red)`. Senza questa riga la risposta vera veniva scartata e il turno
% dichiarava che mancava il valore.
answer_fits_type($Ans, $Type) :- category_member($Type, $Ans).
answer_fits_type($Ans, $Type) :- lemma_candidate($Type, $L), category_member($L, $Ans).
% E un nome della categoria che si e' insegnato come alias («colour and color name
% the same thing»): la stessa categoria sotto un'altra grafia.
answer_fits_type($Ans, $Type) :- entity_alias($Type, $Other), category_member($Other, $Ans).
% E ogni valore di una relazione di cui si sa la CLASSE DEI VALORI: una valuta di
% un paese e' una valuta anche se nessun fatto dice «cedi is a currency». «what
% currency does ghana use?» scartava «cedi» e dichiarava che mancava il valore.
% Una relazione nuova con la sua classe e' una riga.
machinery(value_class).
value_class(currency_of_country, currency).
value_class(currency_of, currency).
value_class(capital_of_country, city).
value_class(language_of_country, language).
answer_fits_type($Ans, $Type) :- value_class($Rel, $Type), apply($Rel, cons($Any, cons($Ans, nil))).
has_asked_answer_type($T) :- asked_answer_type($T, $Type).
answer_type_ok($T, $Ans) :- naf(has_asked_answer_type($T)), naf(answer_echoes_turn($T, $Ans)).
answer_type_ok($T, $Ans) :- asked_answer_type($T, $Type), answer_fits_type($Ans, $Type), naf(answer_echoes_turn($T, $Ans)).
% 26 settembre 2026 (P13, train-the-learning-process.md) — UNA RISPOSTA CHE
% RIPETE SOLO LA DOMANDA NON RISPONDE. «Where does OPcache store compiled
% bytecode?» riceveva «Compiled bytecode.»: il luogo era perso e la domanda
% riceveva l'oggetto che lei stessa nomina. Meglio un muro (mantra #7).
machinery(answer_echoes_turn).
machinery(answer_word_new).
machinery(turn_has_word).
answer_echoes_turn($T, $Ans) :- atom_words($Ans, $Ws), dif($Ws, nil), naf(answer_word_new($T, $Ws)).
answer_word_new($T, $Ws) :- member($W, $Ws), naf(turn_has_word($T, $W)).
turn_has_word($T, $W) :- turn_word($T, $I, $W).

% ── 12 settembre 2026 — CHE COSA APRE UNA RELATIVA RIDOTTA ─────────────────
% Il participio di un verbo con particella, anche con il suo marcatore d'agente:
% «colonies of coral polyps HELD TOGETHER BY calcium carbonate». Il lettore
% (99-registry.c, `relative_rewrite`) spezza la frase qui e da' alla seconda
% proposizione l'antecedente che la IR trova. Nessuna superficie e' scritta a
% mano: sono quelle che la grammatica genera dai verbi con particella.
machinery(reduced_relative_surface).
reduced_relative_surface($Surface) :- verb_particle_passive_relation($Pred, $Surface).
reduced_relative_surface($Surface) :- verb_particle_agent_relation($Pred, $Surface).
% Dove finisce, all'indietro, l'antecedente di una relativa ridotta quando la IR
% non ha un sintagma (plurale nudo): a un verbo, a una copula, a un determinante
% o a un confine di sintagma — ma NON al partitivo, che tiene insieme «colonies
% OF coral polyps».
machinery(antecedent_stop).
antecedent_stop($W) :- np_closer($W), naf(partitive_preposition($W)).
antecedent_stop($W) :- phrase_boundary(np, breaker, $W).
antecedent_stop($W) :- clause_copula($W).
antecedent_stop($W) :- np_opener($W).

% ── gen515 (18 settembre 2026, notte) — IL QUALIFICATORE DELLA DOMANDA ──────
%
% Piolo 300: «what was the economic value of coral reefs estimated at IN 2020?»
% riceveva la cifra del 1997; «what area do coral reefs occupy ABOUT HALF OF?»
% la percentuale; piolo 320: «WHY does composting offer a superior
% alternative?» l'oggetto del verbo. La cornice delle risposte rivendicava
% sulla cue («estimated at», «occupy», «offer») e non leggeva il resto della
% domanda (specie B, `turn-arbitration.md` §1-bis.1-ter). Mantra #23: alla KB
% mancava la dimensione «una domanda puo' RESTRINGERE il valore che chiede» —
% a un tempo, a una porzione, a una causa. Qui e' conoscenza: la classe del
% qualificatore, le parole che lo aprono, e la forma di cio' che segue.
%
% `question_qualifier(Classe, Apertura)`: una superficie che, nella domanda,
%   fuori dalla cue della relazione, restringe il valore chiesto.
% `qualifier_shape(Classe, number|word|none)`: che cosa porta il qualificatore —
%   `number` il numero che segue («in 2020», «since 1950»); `word` la prima
%   parola dell'apertura stessa («half of» → half); `none` niente che un valore
%   possa portare («why»: si chiede la causa, non il valore).
% Il consumatore (`p0_question_qualifier`, 10-memory-knowledge.c) prova il
% qualificatore sui valori letti: chi lo porta risponde; se nessuno lo porta
% la cornice non risponde come se il qualificatore non ci fosse — dice che
% cosa ha letto e che cosa le manca (`answer_frame_unqualified`, messages.p0).
% Un'apertura nuova e' una riga; una classe nuova e' una riga piu' la forma.
machinery(question_qualifier).
machinery(qualifier_shape).
qualifier_shape(time, number).
question_qualifier(time, in).
question_qualifier(time, since).
question_qualifier(time, during).
question_qualifier(time, before).
question_qualifier(time, after).
% L'italiano arriva canonicalizzato: «nel 2020» e' «in the 2020», «dal 1950»
% «from the 1950» (misurato con P0_READ_TRACE, notte del 18): l'apertura e' la
% forma canonica, e «nel»/«dal» restano per un turno non canonicalizzato.
question_qualifier(time, nel).
question_qualifier(time, dal).
question_qualifier(time, "in the").
question_qualifier(time, "from the").
qualifier_shape(portion, word).
question_qualifier(portion, "half of").
question_qualifier(portion, "a third of").
question_qualifier(portion, "a quarter of").
question_qualifier(portion, "twice").
qualifier_shape(cause, none).
question_qualifier(cause, why).
question_qualifier(cause, perche).
% E la lezione, parlando (gerarchia di crescita, canale #1): chi insegna non
% conosce nessun predicato, dice la parola e di che cosa parla.
%     > a question that says "during" asks about a time
%     > forget that a question that says "during" asks about a time
% La classe si nomina con le parole di chi insegna (`qualifier_class_name/2`);
% la parola citata e' una menzione e resta com'e'.
machinery(qualifier_class_name).
qualifier_class_name("a time", time).       qualifier_class_name("a period", time).
qualifier_class_name("a year", time).       qualifier_class_name("a date", time).
qualifier_class_name("a portion", portion). qualifier_class_name("a fraction", portion).
qualifier_class_name("a share", portion).
qualifier_class_name("a cause", cause).     qualifier_class_name("a reason", cause).
segment_role(mention, "a question that says").
segment_role(mention, "forget that a question that says").
turn_form(teach_qualifier_en, 1, text("a question that says")).
turn_form(teach_qualifier_en, 2, span(opener)).
turn_form(teach_qualifier_en, 3, text("asks about")).
turn_form(teach_qualifier_en, 4, named(qualifier_class_name, class)).
turn_form_slot_form(teach_qualifier_en, opener, mention).
turn_form_act(teach_qualifier_en, "op(assert, question_qualifier, [class, opener])").
turn_form_priority(teach_qualifier_en, early).
turn_form_view(teach_qualifier_en, said).
turn_form_reply(teach_qualifier_en, qualifier_taught).
turn_form(forget_qualifier_en, 1, text("forget that a question that says")).
turn_form(forget_qualifier_en, 2, span(opener)).
turn_form(forget_qualifier_en, 3, text("asks about")).
turn_form(forget_qualifier_en, 4, named(qualifier_class_name, class)).
turn_form_slot_form(forget_qualifier_en, opener, mention).
turn_form_act(forget_qualifier_en, "op(retract, question_qualifier, [class, opener])").
turn_form_priority(forget_qualifier_en, early).
turn_form_view(forget_qualifier_en, said).
turn_form_reply(forget_qualifier_en, qualifier_forgotten).
% ⛔ Il consumatore era nato come funzione C di novanta righe (notte del 18);
% F.: «siamo sicuri che non poteva essere la KB stessa?». Poteva: e' una
% regola sulle viste del turno che esistono gia' (`turn_word/3`,
% `turn_surface_at/3`, `atom_words`, `member`). Il C chiede solo il verdetto.
%   turn_qualifier(Cue, Apertura, q(Contenuto, Detto)): il qualificatore che il
%     turno porta fuori dalla cue della relazione, con cio' che il valore deve
%     portare e come lo si dice nel muro («in 2020», «half of», «why»).
%   qualifier_verdict(Cue, Valore, carries|lacks, Detto): il valore letto lo
%     porta, oppure no.
machinery(surface_has_word).
machinery(turn_qualifier).
machinery(qualifier_content).
machinery(value_carries).
machinery(qualifier_verdict).
surface_has_word($S, $W) :- atom_words($S, $Ws), member($W, $Ws).
turn_qualifier($Cue, $Opener, $Q) :-
    question_qualifier($Class, $Opener), naf(surface_has_word($Cue, $Opener)),
    turn_surface_at(current_turn, $Opener, $At),
    qualifier_content($Class, $Opener, $At, $Q).
qualifier_content($Class, $Opener, $At, q($C, $Said)) :-
    qualifier_shape($Class, number), atom_words($Opener, $Ws), list_len($Ws, $N),
    is($Next, add($At, $N)), turn_word(current_turn, $Next, $C), ge($C, 0),
    concat_atoms($Opener, " ", $T), concat_atoms($T, $C, $Said).
qualifier_content($Class, $Opener, $At, q($C, $Opener)) :-
    qualifier_shape($Class, word), atom_words($Opener, cons($C, $Rest)).
qualifier_content($Class, $Opener, $At, q(none, $Opener)) :-
    qualifier_shape($Class, none).
value_carries($Value, $C) :- atom_words($Value, $Ws), member($C, $Ws).
qualifier_verdict($Cue, $Value, carries, $Said) :-
    turn_qualifier($Cue, $Opener, q($C, $Said)), value_carries($Value, $C).
qualifier_verdict($Cue, $Value, lacks, $Said) :-
    turn_qualifier($Cue, $Opener, q($C, $Said)), naf(value_carries($Value, $C)).
