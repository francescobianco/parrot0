% ══ UC2 — IL GIUDIZIO QUALITATIVO NON E' UNA LIBRERIA DI SMELL ═══════════════
%
% F., 2026-09-04: «non dobbiamo impostare un frasario con un meccanismo a match
% con infiniti casi […] non un semplice pattern recognition da addestrare ma
% qualcosa di piu' potente».
%
% Uno smell e' una CONCLUSIONE, non un sensore (piano §5). Aggiungere il
% controllo numero cinque non e' comprensione: e' la libreria infinita. Qui un
% criterio e' un FATTO che nomina quattro cose e nient'altro:
%
%     quality_criterion(Nome, Dimensione, threshold(Misura, Verso, Soglia))
%
% (Il vincolo di arita' del motore e' 4, e la soglia sta bene in un termine
%  composto: `threshold/3` dice da se' che quei tre pezzi sono UNA cosa.)
%
% dove **Misura e' il nome di una relazione binaria sulla IR**, non una funzione
% cablata. `apply/2` — lo stesso confine a predicato variabile che regge il ponte
% fra rappresentazioni — la attraversa. Ne segue la proprieta' che conta:
%
%   ⭐ un criterio nuovo e' UNA RELAZIONE PIU' UN FATTO, mai un ramo nel C,
%     e il motore del giudizio non nomina nessun criterio.
%
% E la SOGLIA e' conoscenza, non una costante: «troppo lungo» dipende dal
% progetto, e si cambia parlando. Il C puo' contare, ordinare e confrontare; non
% puo' decidere che 400 sia troppo.

machinery(quality_dimension).
machinery(quality_criterion).
machinery(criterion_finding).
machinery(criterion_basis).
machinery(criterion_counterevidence).
machinery(quality_severity).
machinery(finding_priority).
machinery(finding_precedes).
machinery(code_quality_task).
machinery(code_quality_evidence_requirement).

% ── LE DIMENSIONI, con il loro significato in chiaro ────────────────────────
quality_dimension(size, "how much has to be read at once to understand a unit").
quality_dimension(coupling, "how many other units it must know to work").

% ── LE MISURE: relazioni binarie sulla IR, nessuna privilegiata dal motore ──
machinery(code_definition_length).
code_definition_length($Name, $Len) :-
    code_name($Snapshot, $Node, definition, $Name),
    code_span($Snapshot, $Node, $Start, $Len).

machinery(code_definition_fanout).
code_definition_fanout($Name, $Count) :-
    code_name($Snapshot, $Node, definition, $Name),
    findall($Callee, code_edge($Snapshot, $Node, calls, $Callee), $Calls),
    list_len($Calls, $Count).

% ── I CRITERI. Sono due perche' due bastano a dimostrare il meccanismo: il
%    terzo non aggiunge comprensione, aggiunge una riga. E' esattamente la
%    differenza fra motorizzare la classe e collezionare istanze.
quality_criterion(long_definition, size,     threshold(code_definition_length, above, 400)).
quality_criterion(wide_fanout,     coupling, threshold(code_definition_fanout, above, 8)).

% La gravita' e' policy, non una proprieta' cablata del criterio. Il rank
% numerico permette confronti generici fra finding; cambiare la priorita'
% richiede solo sostituire il fatto nella KB.
quality_severity(long_definition, advisory, 1).
quality_severity(wide_fanout, warning, 2).

machinery(quality_severity_name).
quality_severity_name($Criterion, $Severity) :-
    quality_severity($Criterion, $Severity, $Rank).

% Proiezione con evidenza: l'ordinamento non perde soggetto, criterio o prova.
finding_priority($Subject, $Criterion, priority($Severity, $Rank)) :-
    code_finding($Subject, $Criterion, $Evidence),
    quality_severity($Criterion, $Severity, $Rank).

finding_precedes($Subject, $Left, $Right) :-
    finding_priority($Subject, $Left, priority($LeftSeverity, $LeftRank)),
    finding_priority($Subject, $Right, priority($RightSeverity, $RightRank)),
    lt($LeftRank, $RightRank).

% ── IL MOTORE DEL GIUDIZIO: una regola, che non nomina nessun criterio ──────
%
% Il finding porta la propria evidenza: che cosa e' stato misurato, quanto e'
% venuto, contro quale soglia. Una conclusione che non sa dire perche' e' vera
% non e' un giudizio, e' un'opinione.
criterion_finding($Subject, $Criterion,
                  evidence($Measure, $Value, above, $Bound)) :-
    quality_criterion($Criterion, $Dimension,
                      threshold($Measure, above, $Bound)),
    apply($Measure, cons($Subject, cons($Value, nil))),
    gt($Value, $Bound).

criterion_finding($Subject, $Criterion,
                  evidence($Measure, $Value, below, $Bound)) :-
    quality_criterion($Criterion, $Dimension,
                      threshold($Measure, below, $Bound)),
    apply($Measure, cons($Subject, cons($Value, nil))),
    lt($Value, $Bound).

% La BASIS: quale dimensione il finding tocca, e con che significato. Serve a
% rispondere «perche' lo dici», che e' meta' del giudizio.
criterion_basis($Subject, $Criterion, dimension($Dimension, $Gloss)) :-
    criterion_finding($Subject, $Criterion, $Evidence),
    quality_criterion($Criterion, $Dimension,
                      threshold($Measure, $Direction, $Bound)),
    quality_dimension($Dimension, $Gloss).

% ── LA CONTROEVIDENZA E' PARTE DEL GIUDIZIO, NON UN'ECCEZIONE ──────────────
%
% Un criterio che non si puo' smentire non e' un criterio. Chi dichiara un
% criterio puo' dichiarare quale osservazione lo neutralizza: la stessa unita'
% resta osservata, il finding non si forma. Senza questo, un giudizio e' un
% verdetto — e un verdetto non si discute, quindi non e' conoscenza.
machinery(criterion_waiver).
criterion_counterevidence($Subject, $Criterion, waived($Reason)) :-
    criterion_waiver($Criterion, $Reason, $Predicate),
    apply($Predicate, cons($Subject, nil)).

% ⚠ `naf/1` rifiuta un goal NON GROUND — e' la scelta giusta del motore
% (floundering: declina invece di mentire), ma vuol dire che la guardia non puo'
% portarsi dietro una variabile libera per la ragione. Percio' la ragione si
% chiede a parte, e qui si chiede solo SE.
machinery(criterion_waived).
criterion_waived($Subject, $Criterion) :-
    criterion_counterevidence($Subject, $Criterion, $Reason).

machinery(code_finding).
code_finding($Subject, $Criterion, $Evidence) :-
    criterion_finding($Subject, $Criterion, $Evidence),
    naf(criterion_waived($Subject, $Criterion)).

% ── LA RESA, dal consumer universale: nessun handler nel C ──────────────────
machinery(code_improvement_note).
% ⚠ la catena di composizione resta CORTA di proposito: la resa e' la parte
% meno importante del giudizio, e una catena lunga di `concat_atoms` consuma il
% budget d'inferenza del turno senza aggiungere niente di ricostruibile. Chi
% vuole il dettaglio lo chiede a `code_finding/3` e a `criterion_basis/3`, che
% lo portano in forma strutturata invece che in una frase.
code_improvement_note($Subject, $Note) :-
    code_finding($Subject, $Criterion, evidence($Measure, $Value, $Dir, $Bound)),
    concat_atoms($Criterion, " — ", $A),
    concat_atoms($A, $Measure, $B),
    concat_atoms($B, " = ", $C),
    concat_atoms($C, $Value, $Note).

% ⚠ Le parole della domanda devono essere PAROLE CHE PARROT0 CONOSCE, altrimenti
% il turno viene preso dal percorso che offre di imparare il termine ignoto e la
% domanda non arriva mai al consumer. Non e' un frasario: e' vocabolario, e come
% ogni vocabolario e' una riga di KB — vedi `lexeme/1`.
lexeme(quality).
lexeme(improvement).
lexeme(finding).
lexeme(note).

% La domanda qualitativa entra anche nel contratto Task IR. La superficie e'
% lingua in KB; il consumer non deve riconoscere una nuova frase nel C.
task_operation_cue(code_quality_review, "improvement note for").
task_deliverable_cue(qualitative_judgment, "improvement note for").

% Il task riusa l'argomento gia' estratto dall'IR di turno e apre l'obbligo di
% evidenza: il finding non e' pronunciabile senza una misura sulla snapshot.
code_quality_task($Subject, $Criterion) :-
    task_ir(operation, code_quality_review),
    task_ir(argument_1, $Subject),
    quality_criterion($Criterion, $Dimension, $Threshold).

code_quality_evidence_requirement($Subject, $Criterion, requirement($Measure, snapshot)) :-
    code_quality_task($Subject, $Criterion),
    quality_criterion($Criterion, $Dimension, threshold($Measure, $Direction, $Bound)).

% ── «HO GUARDATO E NON HO TROVATO NIENTE» NON E' «NON SO COSA SIA» ─────────
%
% Senza questa clausola, chiedere un giudizio su una funzione SANA cadeva nel
% declino della parola ignota — «Hmm, I don't know about hash_table_get yet» —
% che e' falso due volte: parrot0 quel simbolo l'ha appena letto, e l'assenza di
% finding e' un RISULTATO, non una lacuna. Un'assenza dichiarata e' informazione;
% un muro al suo posto e' rumore travestito da modestia (honest-limits.p0).
machinery(code_has_finding).
code_has_finding($Subject) :- code_finding($Subject, $Criterion, $Evidence).

code_improvement_note($Subject, $Note) :-
    code_name($Snapshot, $Node, definition, $Subject),
    naf(code_has_finding($Subject)),
    clean_bill($Note).

machinery(clean_bill).
clean_bill("no finding: nothing measured crosses a declared threshold").

answer_frame("improvement note for", code_improvement_note).
answer_frame_input_arg("improvement note for", code_improvement_note, 1).

% ══ UC2b — DALLA SOLA SINTASSI NON SI DICE «LENTO» ═══════════════════════════
%
% Piano §5.2, e la regola di onesta' e' piu' forte di tutte le altre di questo
% file: senza evidenza dinamica si puo' trovare un CANDIDATO COSTOSO, mai una
% parte lenta. Un giudizio di performance senza misura non e' un'approssimazione
% utile: e' un'affermazione falsa detta con sicurezza, ed e' il mantra #7.
%
% Percio' qui la velocita' ha due risposte e nessuna delle due indovina:
%   - senza profilo, si dichiara che manca e si dice che cosa si puo' dare al
%     suo posto (il candidato costoso, che e' un'altra cosa e va nominata
%     diversamente);
%   - con un profilo, si risponde DALL'EVIDENZA, che porta con se' la misura.
%
% `perf_evidence/3` non ha nessun fatto e non e' una dimenticanza: e' il punto in
% cui un profiler si collega. Un formato nuovo si aggiunge come evidenza, non
% come ramo nel C.
machinery(perf_evidence).
machinery(code_speed_answer).
machinery(no_profile_note).

no_profile_note("no profile on record -- from structure alone I can name a costly candidate, never a slow part").

code_speed_answer($Name, $Answer) :-
    code_name($Snapshot, $Node, definition, $Name),
    perf_evidence($Name, $Metric, $Value),
    concat_atoms($Metric, " = ", $A),
    concat_atoms($A, $Value, $Answer).

code_speed_answer($Name, $Answer) :-
    code_name($Snapshot, $Node, definition, $Name),
    naf(code_has_perf_evidence($Name)),
    no_profile_note($Answer).

machinery(code_has_perf_evidence).
code_has_perf_evidence($Name) :- perf_evidence($Name, $Metric, $Value).

% Il candidato costoso: si nomina per quello che e', una CONGETTURA STRUTTURALE
% ordinabile, e non usa mai la parola «lento».
machinery(code_cost_candidate).
code_cost_candidate($Name, $Fanout) :-
    code_definition_fanout($Name, $Fanout),
    gt($Fanout, 4).

lexeme(speed).
lexeme(cost).
lexeme(candidate).
answer_frame("speed of", code_speed_answer).
answer_frame_input_arg("speed of", code_speed_answer, 1).
answer_frame("cost candidate for", code_cost_candidate).
answer_frame_input_arg("cost candidate for", code_cost_candidate, 1).
