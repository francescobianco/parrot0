% guided-reading.p0 — LEGGERE PER RISPONDERE: LA LETTURA GUIDATA DAL FRAME APERTO.
%
% docs/plans/multi-hop-deep-memory.md §4.4 (strada 2) e §7.0 (il banco della classe).
% Una domanda come «in which country is the museum that holds The Starry Night?» non
% si risponde leggendo tutto e poi cercando: si parte da ciò che si nomina, si legge la
% sua pagina CERCANDO ciò che manca — un museo, poi un paese — e ogni scoperta decide la
% pagina successiva. Come fa una persona.
%
% Il motore fa la meccanica: scarica la pagina con lo stesso provider della memoria
% profonda, la divide in frasi, trova nelle frasi i nomi propri (dall'ortografia) e i
% sintagmi comuni, e fa girare il ciclo. Qui sta tutto ciò che DECIDE:
%   - quando una domanda apre una lettura guidata (tipo chiesto + ponte);
%   - quale tipo si chiede, e in che ordine;
%   - quali parole del prompt sono indizi;
%   - quando un candidato e' del tipo giusto, e con quale forma si presenta la risposta;
%   - quali parole sono prova a favore o contro un legame;
%   - come si dice la catena.
%
% ⚠ Debito dichiarato (MANTRA #24). Le frasi e i candidati della pagina sono pubblicati
% come fatti di scratch del turno (`guided_*`), non ancora come scope della Document IR
% con nodi e range: e' la stessa informazione (frase, menzione, posizione), e la
% migrazione e' IR1 + IR2 del piano. Gemelli: guided_page_sentence → document_unit;
% guided_mention → input_entity_node nello scope pagina; guided_found → legame fra scope.

:- file_attribute(machinery).

% ── 1. QUALE TIPO SI CHIEDE ─────────────────────────────────────────────────
% «which religion», «into which sea», «what was his nationality», «what is the capital
% of»: il tipo e' la prima parola piena dopo l'interrogativo, saltando copule,
% ausiliari, articoli e possessivi. Un interrogativo nuovo e' una riga.
machinery(open_question_word).
open_question_word(which).
open_question_word(what).
open_question_word(quale).
open_question_word(quali).
machinery(type_skip_word).
type_skip_word($W) :- clause_copula($W).
type_skip_word($W) :- auxiliary($W).
type_skip_word($W) :- english_determiner($W).
type_skip_word($W) :- italian_determiner($W).
type_skip_word($W) :- possessive_word($W).
type_skip_word(do). type_skip_word(does). type_skip_word(did).
type_skip_word(was). type_skip_word(were).
type_skip_word($W) :- elided_article($W).
% gli articoli elisi dell'italiano, staccati dal nome («dell'Ungheria»)
machinery(elided_article).
elided_article(dell). elided_article(nell). elided_article(sull). elided_article(dall).
elided_article(all). elided_article(l). elided_article(d). elided_article(un).
machinery(possessive_word).
possessive_word(his). possessive_word(her). possessive_word(its). possessive_word(their).
possessive_word(suo). possessive_word(sua).

machinery(guided_asked_type).
machinery(first_type_word_after).
guided_asked_type($T, $I, $Type) :-
    turn_word($T, $I, $Q), open_question_word($Q), is($J, add($I, 1)), first_type_word_after($T, $J, $Type).
% Il tipo e' la TESTA del sintagma: «the supreme deity» → deity, «the historical figure he
% is named after» → figure. Una parola piena seguita da un'altra parola piena ne e' il
% modificatore.
first_type_word_after($T, $J, $W) :-
    turn_word($T, $J, $W), naf(type_skip_word($W)), naf(open_question_word($W)), type_candidate_word($W),
    naf(type_modifier_at($T, $J)).
first_type_word_after($T, $J, $W) :-
    turn_word($T, $J, $M), naf(type_skip_word($M)), type_candidate_word($M), type_modifier_at($T, $J),
    is($K, add($J, 1)), lt($K, 64), first_type_word_after($T, $K, $W).
machinery(type_modifier_at).
type_modifier_at($T, $J) :-
    guided_head_last, is($K, add($J, 1)), turn_word($T, $K, $N), type_candidate_word($N), naf(type_skip_word($N)), naf(bridge_word($N)),
    naf(relative_clause_verb($N)),
    naf(open_question_word($N)), naf(type_stop_word($N)).
% una parola che puo' essere un tipo: piena, oppure un tipo generico dichiarato («figure»
% e' anche una parola funzione in «figure out», e il lessico la segna come tale)
machinery(type_candidate_word).
type_candidate_word($W) :- content_word($W).
type_candidate_word($W) :- generic_type($W).
% dove sta la testa lo dice la lingua (`compound_head_side/2`, grammar.p0): in inglese il
% modificatore precede («supreme deity»), in italiano la testa viene prima («mare»)
machinery(guided_head_last).
guided_head_last :- naf(current_language(it)), compound_head_side(en, last).
guided_head_last :- current_language(it), compound_head_side(it, last).
machinery(type_stop_word).
type_stop_word(he). type_stop_word(she). type_stop_word(it). type_stop_word(they).
type_stop_word(of). type_stop_word(in). type_stop_word(that).
% E un compito all'imperativo apre un tipo come un interrogativo: «Identify the historical
% figure …», «determine the religion …», «name the supreme deity …».
machinery(task_verb).
task_verb(identify). task_verb(determine). task_verb(name). task_verb(find).
task_verb(identifica). task_verb(determina).
guided_asked_type($T, $I, $Type) :-
    turn_word($T, $I, $V), task_verb($V), is($J, add($I, 1)), first_type_word_after($T, $J, $Type).
% Un tipo generico lo soddisfa l'entita' che la frase pertinente nomina come ponte.
machinery(generic_type).
generic_type(figure). generic_type(person). generic_type(one). generic_type(thing).
generic_type(entity). generic_type(someone). generic_type(figura). generic_type(persona).
first_type_word_after($T, $J, $W) :-
    turn_word($T, $J, $S), type_skip_word($S), is($K, add($J, 1)), lt($K, 64), first_type_word_after($T, $K, $W).

% ── 2. IL PONTE: LA DOMANDA NON SI RISPONDE CON UN SOLO FATTO ─────────────────
% Una relativa dopo un nome («the museum THAT holds», «the country WHERE»), un'anafora
% («that figure», «its followers», «his nationality»), «named after», o piu' tipi
% chiesti. Senza ponte la domanda resta alle facolta' di sempre: «what is the capital
% of France?» risponde la KB.
machinery(bridge_word).
bridge_word(that). bridge_word(where). bridge_word(whose).
bridge_word(its). bridge_word(his). bridge_word(her). bridge_word(their).
bridge_word(cui). bridge_word(dove). bridge_word(che).
machinery(turn_guided_bridge).
turn_guided_bridge($T) :- turn_word($T, $I, $W), bridge_word($W), gt($I, 0).
turn_guided_bridge($T) :- guided_asked_type($T, $I, $A), guided_asked_type($T, $J, $B), lt($I, $J).
% ...o una DESCRIZIONE di un'altra entita' dopo il tipo chiesto: «the nationality of THE
% COMPOSER of the opera Carmen», «which range contains THE HIGHEST MOUNTAIN in Europe». Un
% sintagma col determinante, la cui testa non e' il tipo chiesto, seguito da una
% preposizione: per arrivare al tipo bisogna prima trovare quell'entita'. «what is the
% capital of France?» non lo e': la testa della descrizione e' il tipo stesso.
machinery(guided_description_at).
machinery(description_head_after).
machinery(guided_head_is_asked).
guided_head_is_asked($T, $Head) :- guided_asked_type($T, $I, $A), same_word_lemma($Head, $A).
guided_description_at($T, $J, $Head) :- guided_description_span($T, $J, pair($Head, $P)).
% la descrizione finisce alla testa, seguita da una preposizione («the composer OF») o da
% una relativa («the country WHERE», «the museum THAT», «il fiume CHE»)
machinery(guided_description_span).
guided_description_span($T, $J, pair($Head, $P)) :-
    turn_word($T, $J, $D), description_determiner($D), is($K, add($J, 1)),
    description_head_after($T, $K, pair($Head, $P)), turn_word($T, $P, $F), description_follow($F).
machinery(description_follow).
description_follow($W) :- preposition($W).
description_follow($W) :- articulated_preposition($W).
description_follow(di). description_follow(in).
description_follow($W) :- bridge_word($W).
description_follow(which). description_follow(who).
% i modificatori della descrizione dicono QUALE entita': «the HIGHEST mountain in Europe».
% Un candidato del tipo della testa li deve avere nella sua frase.
machinery(guided_description_modifier).
guided_description_modifier($T, $J, $W) :-
    guided_description_span($T, $J, pair($Head, $P)), is($H, sub($P, 1)),
    turn_word($T, $K, $W), gt($K, $J), lt($K, $H), naf(type_skip_word($W)).
machinery(guided_description_head_at).
guided_description_head_at($T, $J, $Head) :-
    guided_asked_type($T, $I, $Type), guided_description_at($T, $J, $Head), gt($J, $I), naf(same_word_lemma($Head, $Type)),
    naf(guided_head_is_asked($T, $Head)).
description_head_after($T, $K, pair($W, $P)) :-
    turn_word($T, $K, $W), type_candidate_word($W), naf(type_skip_word($W)), naf(type_modifier_at($T, $K)), is($P, add($K, 1)).
% un modificatore puo' essere una parola che il lessico segna come funzione («highest»)
description_head_after($T, $K, $R) :-
    turn_word($T, $K, $M), naf(type_skip_word($M)), naf(bridge_word($M)), description_modifier_at($T, $K),
    is($L, add($K, 1)), lt($L, 64), description_head_after($T, $L, $R).
machinery(description_modifier_at).
description_modifier_at($T, $J) :-
    guided_head_last, is($K, add($J, 1)), turn_word($T, $K, $N), type_candidate_word($N), naf(type_skip_word($N)),
    naf(bridge_word($N)), naf(relative_clause_verb($N)), naf(type_stop_word($N)).
machinery(description_determiner).
description_determiner(the). description_determiner(a). description_determiner(an).
description_determiner(il). description_determiner(la). description_determiner(lo). description_determiner(l).
description_determiner($D) :- articulated_preposition($D).
% le preposizioni articolate dell'italiano: sono determinante e preposizione insieme
% («NEL paese dove», «la capitale DELL'Ungheria»)
machinery(articulated_preposition).
articulated_preposition(del). articulated_preposition(della). articulated_preposition(dello).
articulated_preposition(dei). articulated_preposition(degli). articulated_preposition(delle). articulated_preposition(dell).
articulated_preposition(nel). articulated_preposition(nella). articulated_preposition(nello).
articulated_preposition(nei). articulated_preposition(negli). articulated_preposition(nelle). articulated_preposition(nell).
articulated_preposition(al). articulated_preposition(alla). articulated_preposition(sul). articulated_preposition(sulla).
turn_guided_bridge($T) :-
    guided_asked_type($T, $I, $Type), guided_description_at($T, $J, $Head), gt($J, $I), naf(same_word_lemma($Head, $Type)).
machinery(turn_guided_inquiry).
turn_guided_inquiry($T) :- acquisition_move(acquire), guided_asked_type($T, $I, $Type), turn_guided_bridge($T).
% un compito a passi e' gia' un ponte: ogni passo parte dal risultato del precedente
turn_guided_bridge($T) :- turn_word($T, $I, $V), task_verb($V), turn_word($T, $J, $W), task_verb($W), lt($I, $J).

% ── 3. GLI INDIZI ────────────────────────────────────────────────────────────
% Le parole piene del prompt che non sono ne' interrogativi ne' tipi chiesti: dicono
% che cosa cercare nella frase («holds», «named», «formulate», «flow»).
machinery(guided_cue).
guided_cue($T, $W) :-
    turn_word($T, $I, $W), content_word($W), naf(open_question_word($W)), naf(type_skip_word($W)),
    naf(bridge_word($W)), naf(guided_asked_word($T, $W)), naf(task_verb($W)).
machinery(guided_asked_word).
guided_asked_word($T, $W) :- guided_asked_type($T, $I, $W).

% La stessa parola sotto un'altra forma: flessione, plurale, radice nota.
machinery(same_word_lemma).
same_word_lemma($W, $W).
same_word_lemma($W, $T) :- plural_of($W, $T).
same_word_lemma($W, $T) :- lemma_candidate($W, $T).
same_word_lemma($W, $T) :- lemma_candidate($T, $W).

% ── 4. PROVE A FAVORE E CONTRO UN LEGAME ─────────────────────────────────────
% Un indizio del prompt si ritrova nella pagina anche con altre parole: «associated
% with that figure» e' provato da «the founder of X». Insegnabile: «a founder of
% something is associated with it». La prova contraria abbassa un candidato che la
% frase nomina per opporlo («challenged the tenets of …»).
machinery(cue_evidence).
cue_evidence(associated, founder).
cue_evidence(associated, founded).
cue_evidence(associated, founding).
cue_evidence(holds, collection).
cue_evidence(holds, housed).
cue_evidence(runs, stands).
cue_evidence(runs, flows).
cue_evidence(flow, into).
cue_evidence(named, named).
cue_evidence(named, nominally).
cue_evidence(named, called).
machinery(opposition_evidence).
opposition_evidence(challenged).
opposition_evidence(opposed).
opposition_evidence(rejected).
opposition_evidence(controversy).
machinery(guided_evidence_word).
guided_evidence_word($T, $E) :- guided_cue($T, $C), cue_evidence($C, $E).

% ── 5. IL TIPO DI UN CANDIDATO ───────────────────────────────────────────────
% Tre prove, dalla piu' economica: la testa del nome («Black Sea»), un tipo che la KB
% conosce gia', la prima frase della pagina del candidato (la prova la cerca il motore
% e la chiede qui). Un tipo nuovo che la KB sa riconoscere e' una riga.
machinery(known_entity_type).
known_entity_type($K, country) :- capital_of_country($K, $C).
known_entity_type($K, city) :- capital_of_country($C, $K).
known_entity_type($K, $T) :- apply($T, cons($K, nil)).

% La forma della risposta, per tipo: un nome proprio (sempre), un sintagma comune con
% la testa del tipo («the periodic law»), il modificatore della classe nella frase che
% definisce («a Russian chemist» → Russian).
machinery(answer_shape).
answer_shape(nationality, class_modifier).
answer_shape(law, headed_phrase).
answer_shape(theory, headed_phrase).
answer_shape(principle, headed_phrase).
machinery(naming_link).
naming_link(known).
naming_link(called).
naming_link(named).
machinery(definition_copula).
definition_copula(is). definition_copula(was). definition_copula(are). definition_copula(were).

% ── 6. LA RISPOSTA E LA CATENA ───────────────────────────────────────────────
% I fatti del turno li scrive il motore mentre legge (tutti col numero del turno in
% `guided_turn/1`, cosi' nessuna risposta sopravvive al turno che l'ha prodotta):
%   guided_read(P, Topic, Address)          la P-esima pagina letta
%   guided_found(F, Type, "Risposta", P)     l'F-esima risposta, trovata nella pagina P
%   guided_sentence(F, "Frase")              la frase che la prova
%   guided_bridge(P, "Prossima", "Frase")    la pagina successiva, scelta da questa frase
%   guided_missing(Type)                    un tipo chiesto non trovato
machinery(guided_turn).
machinery(guided_read).
machinery(guided_found).
machinery(guided_sentence).
machinery(guided_bridge).
machinery(guided_missing).
turn_scratch(guided_turn).
turn_scratch(guided_read).
turn_scratch(guided_found).
turn_scratch(guided_sentence).
turn_scratch(guided_bridge).
turn_scratch(guided_missing).
machinery(guided_now).
guided_now :- turn_counter($N), guided_turn($N).

machinery(guided_language).
guided_language(it) :- current_language(it).
guided_language(en) :- naf(current_language(it)).

machinery(guided_line).
guided_line(en, answer_head, "Answer: ").
guided_line(it, answer_head, "Risposta: ").
guided_line(en, partial_head, "Partial answer: ").
guided_line(it, partial_head, "Risposta parziale: ").
guided_line(en, steps_head, "How I got there (every link read from Wikipedia; the choices between candidates are mine):").
guided_line(it, steps_head, "Come ci sono arrivato (ogni anello letto su Wikipedia; le scelte fra i candidati sono mie):").
guided_line(en, missing_head, "What I could not find: ").
guided_line(it, missing_head, "Che cosa non ho trovato: ").
guided_line(en, read_word, "I read «").
guided_line(it, read_word, "Ho letto «").
guided_line(en, bridge_word, "   next page: ").
guided_line(it, bridge_word, "   pagina successiva: ").
guided_line(en, nothing_found, "I could not find any of what the question asks in the pages I could read.").
guided_line(it, nothing_found, "Nelle pagine che ho potuto leggere non ho trovato nulla di cio' che la domanda chiede.").

machinery(guided_address_text).
guided_address_text(wiki_address($Ed, $Title, $Rev, $Sec), $Text) :-
    concat_atoms($Title, "» (", $A), concat_atoms($A, $Ed, $B), concat_atoms($B, " edition, revision ", $C),
    concat_atoms($C, $Rev, $D), concat_atoms($D, ")", $Text).

% ordini: 1 risposta, 2 intestazione, 10+10P pagina P, 11+10P risposte e ponte, 900 mancanze
machinery(guided_part).
guided_part(1, $Text) :-
    guided_now, guided_any_asked_found, naf(guided_missing_any), guided_language($L),
    guided_line($L, answer_head, $H), guided_values_from(0, $Vs), concat_atoms($H, $Vs, $A), concat_atoms($A, ".", $Text).
guided_part(1, $Text) :-
    guided_now, guided_any_asked_found, guided_missing_any, guided_language($L),
    guided_line($L, partial_head, $H), guided_values_from(0, $Vs), concat_atoms($H, $Vs, $A), concat_atoms($A, ".", $Text).
guided_part(1, $Text) :-
    guided_now, naf(guided_any_asked_found), guided_read(1, $To, $Ad), guided_language($L), guided_line($L, nothing_found, $Text).
guided_part(2, $Text) :- guided_now, guided_read(1, $Topic, $Addr), guided_language($L), guided_line($L, steps_head, $Text).
guided_part($O, $Line) :-
    guided_now, guided_read($P, $Topic, $Addr), guided_language($L), guided_line($L, read_word, $R),
    guided_address_text($Addr, $AT), is($O, add(10, mul(10, $P))),
    concat_atoms($P, ". ", $A), concat_atoms($A, $R, $B), concat_atoms($B, $AT, $Line).
guided_part($O, $Line) :-
    guided_now, guided_found($F, $Type, $V, $P), guided_sentence($F, $S), is($O, add(11, mul(10, $P))),
    concat_atoms("   «", $S, $A), concat_atoms($A, "» → ", $B), concat_atoms($B, $Type, $C),
    concat_atoms($C, ": ", $D), concat_atoms($D, $V, $Line).
guided_part($O, $Line) :-
    guided_now, guided_bridge($P, $Next, $S), guided_language($L), guided_line($L, bridge_word, $W),
    is($O, add(12, mul(10, $P))),
    concat_atoms($W, $Next, $A), concat_atoms($A, " («", $B), concat_atoms($B, $S, $C), concat_atoms($C, "»)", $Line).
guided_part(900, $Text) :-
    guided_now, guided_missing($Type), guided_language($L), guided_line($L, missing_head, $H),
    concat_atoms($H, $Type, $A), concat_atoms($A, ".", $Text).

machinery(guided_missing_any).
guided_missing_any :- guided_missing($T).
machinery(guided_found_any).
guided_found_any :- guided_found($F, $T, $V, $P).
machinery(guided_values_from).
machinery(guided_values_after).
machinery(guided_next_found).
machinery(guided_found_between).
machinery(guided_has_found_after).
guided_values_from($N, $Text) :- guided_next_found($N, $M, $V0), guided_value_said($M, $V0, $V), guided_values_after($M, $Rest), concat_atoms($V, $Rest, $Text).
guided_values_after($N, $Text) :- guided_next_found($N, $M, $V0), guided_value_said($M, $V0, $V), guided_values_after($M, $Rest), concat_atoms("; ", $V, $A), concat_atoms($A, $Rest, $Text).
guided_values_after($N, "") :- naf(guided_has_found_after($N)).
guided_next_found($N, $M, $V) :- guided_answer_found($M, $V), gt($M, $N), naf(guided_found_between($N, $M)).
% la risposta elenca i tipi chiesti; i tipi delle descrizioni sono passi della catena
machinery(guided_intermediate_type).
turn_scratch(guided_intermediate_type).
machinery(guided_answer_found).
guided_answer_found($M, $V) :- guided_found($M, $Ty, $V, $P), naf(guided_intermediate_type($Ty)).
machinery(guided_any_asked_found).
guided_any_asked_found :- guided_found($M, $Ty, $V, $P), naf(guided_intermediate_type($Ty)).
guided_found_between($N, $M) :- guided_answer_found($K, $V), gt($K, $N), lt($K, $M).
guided_has_found_after($N) :- guided_answer_found($M, $V), gt($M, $N).

% I connettori dentro un nome proprio: «Museum OF Modern Art», «Leonardo DA Vinci».
machinery(name_connector).
name_connector(of).
name_connector(da).
name_connector(de).
name_connector(di).
name_connector(von).
name_connector(van).

% Le flessioni regolari che un indizio del prompt incontra nella pagina: «formulate» /
% «formulating», «flow» / «flows», «hold» / «held» resta a `lemma_candidate`.
same_word_lemma($W, $T) :- inflection_suffix_guided($Suf), concat_atoms($T, $Suf, $W).
same_word_lemma($W, $T) :- concat_atoms($S, "e", $T), inflection_suffix_guided($Suf), concat_atoms($S, $Suf, $W).
same_word_lemma($W, $T) :- inflection_suffix_guided($Suf), concat_atoms($W, $Suf, $T).
machinery(inflection_suffix_guided).
inflection_suffix_guided("s").
inflection_suffix_guided("es").
inflection_suffix_guided("ed").
inflection_suffix_guided("ing").

% Un nome che porta davanti la sua classe: «River Danube», «Mount Etna», «Lake Como».
% Se la pagina col nome intero non c'e', si prova senza la classe.
machinery(name_class_prefix).
name_class_prefix(river).
name_class_prefix(lake).
name_class_prefix(mount).
name_class_prefix(saint).
name_class_prefix(mar). name_class_prefix(monte). name_class_prefix(lago).

% Il punto di partenza puo' essere un fatto che la KB sa gia': «the CAPITAL of Hungary»
% → la superficie «capital» interroga `capital_of_country` (answer_frame/2), e il valore
% e' la prima pagina da leggere. Il passo si dice come conoscenza, non come lettura.
machinery(guided_known).
turn_scratch(guided_known).
guided_part(5, $Line) :-
    guided_now, guided_known($Rel, $From, $To), guided_language($L), guided_line($L, known_word, $K),
    guided_line($L, of_word, $Of), concat_atoms($K, $Rel, $A), concat_atoms($A, $Of, $B), concat_atoms($B, $From, $C),
    concat_atoms($C, " = ", $D), concat_atoms($D, $To, $Line).
guided_line(en, known_word, "0. Known before reading: ").
guided_line(en, of_word, " of ").
guided_line(it, of_word, " di ").
guided_line(it, known_word, "0. Gia' noto prima di leggere: ").

% Gli indizi che nessuna pagina letta contiene: dicono dove la catena si e' rotta.
machinery(guided_unmatched).
turn_scratch(guided_unmatched).
guided_part(901, $Line) :-
    guided_now, guided_missing_any, guided_unmatched_list($List), guided_language($L), guided_line($L, unmatched_head, $H),
    concat_atoms($H, $List, $A), concat_atoms($A, ".", $Line).
guided_line(en, unmatched_head, "No page I read mentions: ").
guided_line(it, unmatched_head, "Nessuna pagina letta nomina: ").
machinery(guided_unmatched_list).
guided_unmatched_list($Text) :- findall($W, guided_unmatched($W), $Ws), words_comma_text($Ws, $Text).
machinery(words_comma_text).
words_comma_text(cons($W, nil), $W).
words_comma_text(cons($W, cons($V, $R)), $T) :- words_comma_text(cons($V, $R), $Rest), concat_atoms($W, ", ", $A), concat_atoms($A, $Rest, $T).

% La biforcazione, detta: gli altri candidati dello stesso tipo nella pagina, uno per
% riga (una lista con le frasi supererebbe la lunghezza di un atomo), con la frase che
% li nomina — dove si vede che non porta la prova del legame chiesto, o ne porta una
% contraria («challenged the tenets of the Ancient Iranian religion»).
machinery(guided_rejected).
turn_scratch(guided_rejected).
guided_part($O, $Line) :-
    guided_now, guided_rejected($F, $S, $E, $D), guided_found($F, $Type, $V, $P), guided_language($L),
    guided_line($L, rejected_head, $H), is($O, add(11, mul(10, $P))),
    concat_atoms($H, $Type, $A), concat_atoms($A, ": ", $B), concat_atoms($B, $S, $C),
    concat_atoms($C, " («", $G), concat_atoms($G, $E, $I), concat_atoms($I, "»)", $Line).
guided_line(en, rejected_head, "   not chosen, also of type ").
guided_line(it, rejected_head, "   non scelto, anch'esso di tipo ").

% La frase da cercare quando nessun nome del prompt ha una pagina e la KB non da' un
% fatto da cui partire: cio' che segue il ponte («… the country WHERE the highest mountain
% in Africa stands»). La ricerca e' quella dell'edizione (Wikipedia; in edizione locale,
% risultati veri registrati in `search.tsv`).
machinery(guided_search_phrase).
machinery(turn_words_from_to).
guided_search_phrase($T, $Phrase) :-
    turn_word($T, $I, $B), bridge_word($B), gt($I, 0), is($J, add($I, 1)),
    findall($W, guided_word_after($T, $J, $W), $Ws), words_space_text($Ws, $Phrase).
% e, senza parola ponte, la descrizione stessa: dal suo determinante alla fine
guided_search_phrase($T, $Phrase) :-
    naf(turn_has_bridge_word($T)), guided_asked_type($T, $I, $Type), guided_description_at($T, $J, $Head), gt($J, $I),
    naf(same_word_lemma($Head, $Type)),
    findall($W, guided_word_after($T, $J, $W), $Ws), words_space_text($Ws, $Phrase).
machinery(turn_has_bridge_word).
turn_has_bridge_word($T) :- turn_word($T, $I, $B), bridge_word($B), gt($I, 0).
machinery(guided_word_after).
guided_word_after($T, $J, $W) :- turn_word($T, $K, $W), ge($K, $J).
machinery(words_space_text).
words_space_text(cons($W, nil), $W).
words_space_text(cons($W, cons($V, $R)), $T) :- words_space_text(cons($V, $R), $Rest), concat_atoms($W, " ", $A), concat_atoms($A, $Rest, $T).

machinery(guided_searched).
turn_scratch(guided_searched).
guided_part(4, $Line) :-
    guided_now, guided_searched($Q, $Title), guided_language($L), guided_line($L, searched_word, $W),
    concat_atoms($W, $Q, $A), concat_atoms($A, "» → «", $B), concat_atoms($B, $Title, $C), concat_atoms($C, "»", $Line).
guided_line(en, searched_word, "0. I searched Wikipedia for «").
guided_line(it, searched_word, "0. Ho cercato su Wikipedia «").

% Una risposta che la KB sa gia' del nodo raggiunto: «the capital of Tanzania» dopo aver
% letto che il Kilimanjaro sta in Tanzania. Si dice come conoscenza, non come lettura.
machinery(guided_found_known).
turn_scratch(guided_found_known).
guided_part($O, $Line) :-
    guided_now, guided_found_known($F, $Rel, $From), guided_found($F, $Type, $V, $P), guided_language($L),
    guided_line($L, known_found, $K), is($O, add(11, mul(10, $P))),
    guided_line($L, of_word, $Of), concat_atoms($K, $Type, $A), concat_atoms($A, $Of, $B), concat_atoms($B, $From, $C),
    concat_atoms($C, " = ", $D), concat_atoms($D, $V, $Line).
guided_line(en, known_found, "   known before reading: ").
guided_line(it, known_found, "   gia' noto prima di leggere: ").

% Un nome del prompt preceduto da un dimostrativo («THIS author», «THAT figure», «THAT
% philosopher's work») si riferisce a un risultato gia' nominato, non a quello chiesto: un
% candidato che la frase presenta con quel nome di ruolo («… by Russian AUTHOR Fyodor
% Dostoevsky») e' quel referente, e non puo' essere la risposta a un altro tipo.
machinery(anaphor_determiner).
anaphor_determiner(this). anaphor_determiner(that). anaphor_determiner(these). anaphor_determiner(those).
anaphor_determiner(questo). anaphor_determiner(quella). anaphor_determiner(quel).
machinery(guided_anaphor_noun).
guided_anaphor_noun($T, $W) :- turn_word($T, $I, $D), anaphor_determiner($D), is($J, add($I, 1)), turn_word($T, $J, $W), content_word($W).

% ── LA STESSA CLASSE IN UN'ALTRA LINGUA ─────────────────────────────────────
% La domanda in italiano, le pagine in inglese: un tipo o un indizio si ritrova nella
% pagina attraverso la traduzione che la KB conosce («mare» ↔ «sea»), un nome del prompt
% si cerca nella sua forma inglese («Ungheria» → hungary), e la risposta si dice nella
% lingua di chi chiede se la KB ne sa il nome («Black Sea» → «Mar Nero»). Una lingua o un
% nome nuovo e' una lezione di lessico, detta a voce.
same_word_lemma($W, $T) :- tr($W, $T).
same_word_lemma($W, $T) :- word_variant($W, $T).
same_word_lemma($W, $T) :- word_variant($W, $V), tr($T, $V).
% forme tronche dei nomi di classe nei nomi propri: «MAR Nero», «SAN Marco», «MONTE Bianco»
machinery(word_variant).
word_variant(mar, mare). word_variant(san, santo). word_variant(sant, santo).
word_variant(mount, mountain). word_variant(mt, mountain).
machinery(guided_english_key).
guided_english_key($K, $K).
guided_english_key($K, $E) :- tr($E, $K).
machinery(guided_found_key).
turn_scratch(guided_found_key).
machinery(guided_value_said).
guided_value_said($F, $V, $Said) :-
    current_language(it), guided_found_key($F, $K), tr($K, $It), atom_words($It, $Ws), capitalized_words_text($Ws, $Said).
guided_value_said($F, $V, $V) :- naf(guided_value_translated($F)).
machinery(guided_value_translated).
guided_value_translated($F) :- current_language(it), guided_found_key($F, $K), tr($K, $It).
machinery(capitalized_words_text).
capitalized_words_text(cons($W, nil), $U) :- upcase_first($W, $U).
capitalized_words_text(cons($W, cons($V, $R)), $T) :-
    upcase_first($W, $U), capitalized_words_text(cons($V, $R), $Rest), concat_atoms($U, " ", $A), concat_atoms($A, $Rest, $T).

% Una parola a inizio frase e' maiuscola per posizione, non per nome: «Based on 2024
% projections…». Se il lessico la conosce come parola comune (o ne conosce la radice),
% non e' una menzione.
machinery(common_lexical_word).
common_lexical_word($W) :- lexeme($W).
common_lexical_word($W) :- lemma_candidate($W, $L), lexeme($L).
common_lexical_word($W) :- same_word_lemma($W, $L), lexeme($L).

% La testa della descrizione di un'entita' intermedia e' il primo tipo da trovare: «the
% nationality of the COMPOSER of the opera Carmen» si risolve cercando prima un compositore
% a partire da Carmen, poi la sua nazionalita'. E' una sotto-domanda, con la stessa
% risoluzione di ogni tipo: la KB, la pagina del nome d'appoggio, la ricerca.
machinery(guided_description_head).
guided_description_head($T, $Head) :-
    guided_asked_type($T, $I, $Type), guided_description_at($T, $J, $Head), gt($J, $I), naf(same_word_lemma($Head, $Type)).

% la frase di una descrizione, per cercarla: dal suo determinante alla fine del turno
machinery(guided_description_phrase).
guided_description_phrase($T, $Phrase) :-
    guided_description_head_at($T, $J, $Head), findall($W, guided_word_after($T, $J, $W), $Ws), words_space_text($Ws, $Phrase).
machinery(guided_description_phrase_at).
guided_description_phrase_at($T, $J, $Phrase) :-
    guided_description_head_at($T, $J, $Head), findall($W, guided_word_after($T, $J, $W), $Ws), words_space_text($Ws, $Phrase).
% la frase dalla posizione di una descrizione alla fine, senza ricontrollare la descrizione
% una descrizione che contiene un dimostrativo («the prophet of THAT philosopher's work»)
% parla di un referente non ancora trovato: la sua frase non si cerca alla lettera
machinery(guided_description_anaphoric).
guided_description_anaphoric($T, $J) :- turn_word($T, $K, $D), gt($K, $J), anaphor_determiner($D).
machinery(guided_description_words_at).
guided_description_words_at($T, $J, $Phrase) :- findall($W, guided_word_after($T, $J, $W), $Ws), words_space_text($Ws, $Phrase).
