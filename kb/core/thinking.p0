% ══ R1 — IL VOCABOLARIO UNICO DEL THINKING ══════════════════════════════════
%
% ⛔ DUE PAROLE DIVERSE PER DUE COSE DIVERSE (F., 2026-09-04):
%
%   REASONING  e' l'inferenza che parrot0 fa gia': un turno entra, il solver
%              risolve, esce una risposta. Resta com'e' e si chiama cosi'.
%   THINKING   e' la rielaborazione dell'output con meta-prompt fino alla
%              CHIUSURA DELLA PIPELINE: il risultato del primo giro rientra,
%              agganciato a un meta-prompt, e il giro si ripete finche' una
%              condizione dichiarata non lo chiude.
%
% Tenerle separate non e' pedanteria: sono due capacita' con costi, garanzie e
% condizioni d'arresto diverse, e confonderle avrebbe fatto sembrare «pensare
% di piu'» una proprieta' del solver invece che uno strato sopra di esso.
%
% Piano: `docs/plans/thinking.md`, Parte II §1 (H1) e §4.
%
% L'audit ha trovato che parrot0 ha gia' TRE dialetti di piano, tutti KB-first:
%
%   compensation_plan_step/3   arrests.p0    passi con Pre, Effetto, Costo, Supporto
%                                            piu' un DAG con rango topologico
%   answer_plan/4              procedures.p0 75 fatti, gira in produzione
%   turn_plan/2 + plan_step/3  capabilities.p0  il piano sugli strumenti (gen495)
%
% Aggiungerne un quarto sarebbe il difetto che il piano dice di voler evitare,
% commesso mentre lo si evita. Percio' la firma qui sotto NON e' inventata: e' la
% quadrupla piu' ricca dei tre — quella degli arresti — promossa a vocabolario
% comune. `step(Operatore, Pre, Effetto, meta(Costo, Supporto))` e' la stessa
% forma che `compensation_plan_step/3` usa gia'.
%
% ⛔ E IL PRIMO TEST DELLA FIRMA E' QUI SOTTO, non in un documento: il piano
% VIVO del gen495 — quello che risponde a «analizza tutti i file sorgenti che
% trovi» — viene ora DERIVATO da questa firma. Se non si fosse potuto esprimere
% senza perdere niente, la firma sarebbe sbagliata e andava cambiata, non
% forzata. L'esecutore degli strumenti non e' stato toccato: continua a leggere
% `turn_plan/2` e `plan_step/3`, che ora sono VISTE.

:- file_attribute(machinery).

machinery(thinking_scheme).
machinery(thinking_step).
machinery(thinking_after).
machinery(thinking_stop).
machinery(thinking_rank).
machinery(thinking_depends).
machinery(thinking_cycle).
machinery(thinking_ready).
machinery(plan_utterance).

% ── LA FIRMA ────────────────────────────────────────────────────────────────
%
%   thinking_scheme(Nome, Scopo)
%   thinking_step(Nome, Id, step(Operatore, Pre, Effetto, meta(Costo, Supporto)))
%   thinking_after(Nome, Prima, Dopo)      l'arco: da qui si deriva il grafo
%   thinking_stop(Nome, Condizione)        perche' ci si ferma, dichiarato

% ── L'ORDINE SI DERIVA DAL GRAFO, NON DALL'INDICE (H2) ─────────────────────
%
% Il rango e' la stessa costruzione di `arrest_rank/2`: un nodo senza
% predecessori ha rango 0, chi dipende da un nodo di rango R ha rango R+1. Ne
% segue che **un ramo parallelo non e' una feature dell'esecutore**: e' un
% insieme di nodi con lo stesso rango, cioe' una proprieta' osservabile della
% conoscenza. Si puo' chiedere «perche' hai fatto queste tre cose insieme?» e la
% risposta e' un fatto.
thinking_depends($Scheme, $Node, $Prev) :-
    thinking_after($Scheme, $Prev, $Node).

thinking_rank($Scheme, $Node, 0) :-
    thinking_step($Scheme, $Node, $Step),
    naf(thinking_has_predecessor($Scheme, $Node)).
thinking_rank($Scheme, $Node, $Rank) :-
    thinking_depends($Scheme, $Node, $Prev),
    thinking_rank($Scheme, $Prev, $PrevRank),
    is($Rank, add($PrevRank, 1)).

machinery(thinking_has_predecessor).
thinking_has_predecessor($Scheme, $Node) :-
    thinking_depends($Scheme, $Node, $Prev).

% Un grafo con un ciclo resta OSSERVABILE ma non e' eseguibile: si dichiara
% malato invece di girare per sempre. Stessa scelta di `arrest_cycle/1`.
thinking_cycle($Scheme) :-
    thinking_depends($Scheme, $Node, $Node).
thinking_cycle($Scheme) :-
    thinking_depends($Scheme, $A, $B),
    thinking_depends($Scheme, $B, $A).

thinking_ready($Scheme) :-
    thinking_scheme($Scheme, $Purpose),
    naf(thinking_cycle($Scheme)).

% ══ IL PRIMO SCHEMA, ED E' UN PIANO CHE GIA' GIRAVA ═════════════════════════
%
% «analizza tutti i file sorgenti che trovi»: trova → leggi ciascuno → riferisci.
% Era gia' vivo al gen495 come `turn_plan`/`plan_step`; qui viene ridetto con la
% firma comune, e le due forme vecchie diventano viste. Nessuna riga di C e'
% cambiata: e' esattamente la prova che si voleva.
thinking_scheme(analyze_sources, "read every source file and report what it contains").

thinking_step(analyze_sources, 1,
               step(list_sources, none, sources_found, meta(1, local))).
thinking_step(analyze_sources, 2,
               step(read_each, sources_found, structure_ingested, meta(1, local))).

thinking_after(analyze_sources, 1, 2).

% Perche' ci si ferma: dichiarato, non implicito.
thinking_stop(analyze_sources, structure_ingested).
thinking_stop(analyze_sources, budget_exhausted).

% ── LE VISTE: i consumatori vecchi non sanno che e' cambiato qualcosa ───────
%
% `turn_plan/2` e `plan_step/3` non sono piu' fatti: sono proiezioni. Chi le
% legge — l'esecutore degli strumenti in `60-agent-tools.c` — non e' stato
% toccato. E' la condizione che rende questa migrazione onesta: se avesse
% richiesto di cambiare il consumatore, non sarebbe stata una unificazione ma
% una riscrittura con un nome nuovo (mantra #18a).
turn_plan($Scheme, $CueClass) :-
    thinking_scheme($Scheme, $Purpose),
    scheme_cue_class($Scheme, $CueClass).

plan_step($Scheme, $Id, $Operator) :-
    thinking_step($Scheme, $Id, step($Operator, $Pre, $Effect, $Meta)).

% Quale classe di superfici apre uno schema. Resta un fatto separato perche' e'
% LINGUA, non struttura del ragionamento: lo stesso grafo puo' essere chiamato
% da parole diverse, e in lingue diverse.
machinery(scheme_cue_class).
scheme_cue_class(analyze_sources, plan_analyze_sources).

% ══ IL SECONDO SCHEMA — UN PROGETTO CHE NON COMPILA ═════════════════════════
%
% gen503. Sul banco di gara il turno vero — «il progetto in code/ non compila:
% il Makefile si aspetta un file che non c'e', scrivilo» — finiva a `codeast`,
% che rispondeva onestamente «leggo del codice ma non so quale funzione
% intendi». Onesto e inutile: parrot0 sapeva gia' eseguire il build, sapeva
% leggerne il verdetto, e sapeva leggere un contratto da un header. Non c'era
% niente che tenesse insieme quei pezzi quando la richiesta arrivava tutta in
% una volta.
%
% Questo schema non aggiunge nessuna capacita': ORDINA quelle che ci sono.
% Ed e' generale — un progetto che non compila e' un progetto che non compila,
% qui non c'e' niente del banco: nessun nome di file, nessun compito, nessun
% giudice. La domanda di controllo di CHALLENGE_TODO §6.5-bis («serve anche a un
% compito che non e' nel banco?») ha una sola risposta.
thinking_scheme(repair_broken_build,
                "run the build, name what it says is missing, and say what must be produced").

% ⭐ Il primo passo NON e' un operatore: e' una FRASE che parrot0 dice a se
% stesso, e rientra dalla stessa porta da cui entrano i turni di chi parla.
% Cio' che quel turno lascia in KB — il verdetto letto da `tool_result_cue` —
% e' la connessione col passo dopo. Il segnaposto tiene la generalita' che
% aveva il ramo compilato: quale comando costruisce un progetto resta
% `build_command/1`.
thinking_step(repair_broken_build, 1,
               step(say_build, none, build_verdict, meta(1, local))).
plan_utterance(repair_broken_build, 1, "run {build_command}").
% ⭐ gen503 — I DUE PASSI CENTRALI SONO UNA FRASE, e la frase gia' esisteva.
%
% Erano `list_sources` + `read_each`: due operatori compilati. Ma quel lavoro
% e' esattamente cio' che fa lo schema `analyze_sources`, e quello schema ha
% gia' una superficie che parrot0 capisce. Quindi il passo non descrive il
% lavoro: lo CHIEDE, e chi risponde e' parrot0 stesso.
%
% Fra le estensioni dichiarate c'e' gia' "*.h", quindi leggere i sorgenti
% significa anche leggere i contratti — ed e' cosi' che il passo dopo trova le
% clausole senza che nessuno gliele passi.
thinking_step(repair_broken_build, 2,
               step(say_analyze, build_verdict, structure_ingested, meta(2, local))).
plan_utterance(repair_broken_build, 2, "analyze all the sources").

thinking_step(repair_broken_build, 4,
               step(state_obligation, structure_ingested, obligation_named, meta(1, local))).
% gen503: i due passi che chiudono il ciclo. Produrre e' un atto, quindi ha il
% suo passo; e VERIFICARE non e' un dettaglio del produrre — e' cio' che
% distingue «ho scritto» da «funziona», ed e' un secondo giro del build.
thinking_step(repair_broken_build, 5,
               step(produce_artifact, obligation_named, artifact_written, meta(2, local))).
% ⚠ E verificare comincia dal RIGUARDARE. Senza questi due passi il build
% passava ma la struttura interna restava quella di prima: parrot0 continuava a
% credere che `concat` fosse dichiarata e mai definita, un minuto dopo averla
% scritta lui. Un ciclo che non si rilegge non si e' chiuso, si e' interrotto
% bene.
thinking_step(repair_broken_build, 6,
               step(say_analyze, artifact_written, structure_ingested, meta(2, local))).
plan_utterance(repair_broken_build, 6, "analyze all the sources").

thinking_step(repair_broken_build, 8,
               step(say_build, structure_ingested, build_verified, meta(1, local))).
plan_utterance(repair_broken_build, 8, "run {build_command}").

thinking_after(repair_broken_build, 1, 2).
thinking_after(repair_broken_build, 2, 4).
thinking_after(repair_broken_build, 4, 5).
thinking_after(repair_broken_build, 5, 6).
thinking_after(repair_broken_build, 6, 8).

thinking_stop(repair_broken_build, build_verified).
thinking_stop(repair_broken_build, obligation_named).
thinking_stop(repair_broken_build, budget_exhausted).

scheme_cue_class(repair_broken_build, plan_repair_build).

% QUALE comando costruisce un progetto e' conoscenza. `ninja`, `cargo`, `zig
% build` sono una riga ciascuno, e nessuno di essi e' una ricompilazione.
machinery(build_command).
build_command(make).

% Come si riferisce di questo piano: il rapporto dei sorgenti descriveva un
% altro lavoro, e due numeri a zero non sono una risposta.
machinery(plan_report_template).
plan_report_template(repair_broken_build, plan_build_obligation).

% ══ H5 — LA PRIMITIVA E' UNA SOLA: IL RIENTRO ═══════════════════════════════
%
% F., 2026-09-04: «non c'e' nessun LLM, e' un refuso. Il processo intendo:
% pipeline di inferenza, l'output del primo giro agganciato a un meta-prompt e
% reinserito. I flussi sono in KB ma di fatto sono inferenze successive.»
%
% Questo semplifica invece di complicare. `process(P)` E' la pipeline di parrot0,
% rientrata: un passo compone un turno nuovo dal risultato precedente piu' un
% meta-prompt dichiarato qui, e lo rimette dalla stessa porta da cui entrano i
% turni dell'interlocutore. Non c'e' nessuna intelligenza esterna a cui chiedere:
% c'e' lo stesso motore che gira di nuovo, su un input che il grafo ha costruito.
%
% Il meta-prompt e' CONOSCENZA come tutto il resto: si insegna parlando, si
% ritratta, e si puo' chiedere a parrot0 quale abbia usato. E' la parte
% insegnabile di cio' che altrove e' un prompt di sistema nascosto.
machinery(meta_prompt).
machinery(thinking_reentry).

% `{prev}` viene riempito col risultato del nodo precedente. E' l'unico
% segnaposto: se un giorno ne servisse un secondo sara' un fatto, non un ramo.
meta_prompt(ingest, "read: {prev}").
meta_prompt(recall, "what do you know about it").

% Un nodo di RIENTRO dichiara quale meta-prompt usa. La forma resta la
% quadrupla comune: l'operatore e' `reenter(MetaPrompt)`.
thinking_reentry($Scheme, $Node, $Prompt) :-
    thinking_step($Scheme, $Node,
                   step(reenter($Prompt), $Pre, $Effect, $Meta)).

% ⛔ LA GUARDIA CHE VIENE PRIMA DELL'ESECUTORE (H5.4 — il loop di specchio).
%
% parrot0 che critica la propria risposta con la STESSA conoscenza che l'ha
% prodotta puo' solo confermarla. Un nodo di critica che non porta conoscenza
% nuova non e' teatro che non cambia niente: e' teatro che si da' ragione, che e'
% peggio. Percio' un rientro deve DICHIARARE da dove viene cio' che lo rende
% diverso dal passo che critica — un'altra zona della KB, uno strumento, una
% query. Senza quella dichiarazione il nodo non e' eseguibile.
machinery(reentry_brings).
machinery(reentry_admissible).
% Un artefatto nominato non basta: il passo deve anche dichiarare quale
% cambiamento osservabile porta nel loop. Questo è il contratto che impedisce
% al feedback di fermarsi dopo due prompt equivalenti.
machinery(thinking_feedback).
machinery(thinking_feedback_ready).
machinery(thinking_feedback_action).
machinery(thinking_node_effect).
machinery(thinking_outcome_evidence).
machinery(thinking_outcome_policy).
machinery(thinking_default_outcome).
machinery(thinking_stop_reached).
machinery(thinking_prompt_issue).
machinery(thinking_scheme_priority).
machinery(thinking_selected_scheme).

% thinking_feedback(Schema, Nodo, Fonte, Delta)
%   Fonte  = la conoscenza esterna dichiarata da reentry_brings/3
%   Delta  = il tipo di novità attesa (mai `none`)
% Due forme chiudono il passo con conoscenza nuova. La terza è esplicita:
% anche un gap è progresso, ma solo se porta l'azione che può colmarlo.
thinking_feedback_ready($Scheme, $Node) :-
    thinking_reentry($Scheme, $Node, $Prompt),
    reentry_brings($Scheme, $Node, $Source),
    thinking_feedback($Scheme, $Node, $Source, fact_delta).
thinking_feedback_ready($Scheme, $Node) :-
    thinking_reentry($Scheme, $Node, $Prompt),
    reentry_brings($Scheme, $Node, $Source),
    thinking_feedback($Scheme, $Node, $Source, query_result).
thinking_feedback_ready($Scheme, $Node) :-
    thinking_reentry($Scheme, $Node, $Prompt),
    reentry_brings($Scheme, $Node, $Source),
    thinking_feedback($Scheme, $Node, $Source, gap_with_action),
    thinking_feedback_action($Scheme, $Node, $Action).

reentry_admissible($Scheme, $Node) :-
    thinking_reentry($Scheme, $Node, $Prompt),
    thinking_feedback_ready($Scheme, $Node).

machinery(reentry_mirror_risk).
reentry_mirror_risk($Scheme, $Node) :-
    thinking_reentry($Scheme, $Node, $Prompt),
    naf(reentry_admissible($Scheme, $Node)).

% A0 — NON PEGGIORAMENTO. Il motore classifica l'esito con lo scorer
% universale e chiede qui se quella classe puo' sostituire la risposta
% precedente. Una domanda di chiarimento e un gap restano visibili nel trace,
% ma non chiudono il thinking prendendo il posto di una risposta utile.
thinking_outcome_evidence(clarification, line_suffix("?")).
thinking_outcome_policy(wall, hold).
thinking_outcome_policy(clarification, hold).
thinking_outcome_policy(gap, hold).
thinking_outcome_policy(answer, propagate).
thinking_default_outcome(answer).

% E3 — l'effetto del nodo e' interrogabile senza far analizzare al C il termine
% step/4. L'esecutore usa questa vista per verificare thinking_stop/2.
thinking_node_effect($Scheme, $Node, $Effect) :-
    thinking_step($Scheme, $Node,
                  step($Operator, $Pre, $Effect, $Meta)).

% ══ QUANDO SI PENSA, E FINO A QUANDO ════════════════════════════════════════
%
% Il thinking non e' sempre acceso: e' uno strato in piu', e ogni strato costa.
% Quale schema si applica a quale turno e' conoscenza — cosi' come il fatto che
% uno schema esista non basta perche' venga usato.
machinery(thinking_for).
machinery(thinking_default).
machinery(thinking_prompt_text).
machinery(thinking_max_steps).

% Quale schema si applica quando il turno non ne nomina nessuno. E' un fatto
% perche' e' una scelta, non un default del motore: cambiarla e' una riga, e
% toglierla spegne il thinking senza spegnere la politica.
thinking_default(second_thought).
thinking_scheme_priority(second_thought, 0).

% Quanti rientri al massimo. Un rientro costa un TURNO INTERO, non un passo di
% inferenza: senza tetto un grafo si mangia la conversazione. Due non e' un
% numero magico — e' il minimo che permette «critica poi sintetizza», ed e' li'
% finche' non avremo misurato il costo vero (esperimento E5 del piano).
thinking_max_steps(2).

% Uno schema di esempio, dichiarato e con la sua fonte: la critica non rientra a
% mani vuote — porta i finding di qualita', che sono conoscenza che la prima
% risposta non aveva guardato. Senza `thinking_brings` sarebbe uno specchio.
thinking_scheme(second_thought, "look again at what was just said").
thinking_step(second_thought, 1,
              step(reenter(ingest), first_answer, ingested, meta(2, local))).
thinking_step(second_thought, 2,
              step(reenter(recall), ingested, final_answer, meta(1, local))).
thinking_after(second_thought, 1, 2).
thinking_stop(second_thought, final_answer).
thinking_stop(second_thought, budget_exhausted).
% Che cosa porta di NUOVO ciascun rientro: il primo trasforma la risposta in
% fatti (`reading_fact`), il secondo interroga quei fatti. Senza queste due
% righe i nodi sarebbero specchi e non verrebbero eseguiti.
reentry_brings(second_thought, 1, reading_fact).
reentry_brings(second_thought, 2, reading_fact).
thinking_feedback(second_thought, 1, reading_fact, fact_delta).
thinking_feedback(second_thought, 2, reading_fact, query_result).

% Il TESTO di un meta-prompt e' una frase rivolta al motore, quindi e' KB come
% ogni altra frase (mantra #16). `{prev}` e' il solo segnaposto.
% ⚠ UN META-PROMPT DEVE ESSERE UNA COSA CHE PARROT0 SA FARE.
%
% I primi due che avevo scritto — «quali assunzioni non dimostrate ci sono in
% …» e «ridillo in una frase» — muravano entrambi, e il muro diventava la
% risposta finale: pensare di piu' PEGGIORAVA il turno. Il difetto non era il
% loop: era che avevo scritto meta-prompt che descrivono un'attivita' umana
% invece di una capacita' di parrot0.
%
% Questi due sono capacita' che parrot0 ha davvero, ed e' per questo che il giro
% produce qualcosa: RILEGGERE la propria risposta come prosa (e quindi
% trasformarla in conoscenza interrogabile), e poi INTERROGARE cio' che ne e'
% uscito. E' auto-feedback vero: l'output del primo giro diventa input del
% secondo, e in mezzo cambia di natura — da frase a fatto.
thinking_prompt_text(ingest, "read: {prev}").
thinking_prompt_text(recall, "what do you know about it").
