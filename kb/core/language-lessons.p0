% language-lessons.p0 — UNA LEZIONE SULLA LINGUA NON E' UN FATTO SUL MONDO.
%
% L4-1 (docs/plans/l4-upgrade.md, 26 settembre 2026). «To make a question with
% other verbs, put do, does or did before the subject and use the bare verb.»
% diventava `did(put, does)` («Learned: put do does.»): il lettore della
% conoscenza legava `@S do @O` su un imperativo, e il verbo «put» finiva
% soggetto di un fatto. «Short adjectives make the comparative with er…»
% diventava `make(short_adjectives, comparative)`, e poi rispondeva a «What needs
% grease?». Sette regole che parrot0 applicava gia' (G2, G3, G4, G19, G21, G22,
% G23) non venivano riconosciute: nessuna lezione diceva «lo faccio gia'».
%
% Qui c'e' il passo 3 del circuito di L4 (§5) per le lezioni sulla lingua,
% senza un lettore di regole descritte e senza nominare la regola:
%
%   1. una frase che parla della lingua (parole come verb, noun, plural,
%      subject, question) non si impara come fatto: si legge come lezione, e
%      parrot0 dice che non ne tiene niente e chiede un esempio;
%   2. la lezione resta APERTA per qualche turno (`language_lesson_opened/1`);
%   3. se la domanda dell'esempio riceve una risposta, parrot0 dice che la legge
%      gia' cosi': la sovrapposizione si riconosce PER CONTATTO, facendo girare
%      la comprensione sull'esempio;
%   4. se l'esempio prende un muro, lo dice: la lezione resta un'ipotesi, e il
%      punto dove la lettura si ferma e' il punto d'innesto (L4-2).
%
% Tutto e' conoscenza: quali parole parlano della lingua, per quanti turni la
% lezione resta aperta, che cosa dire. Una parola nuova e' una riga.

:- file_attribute(machinery).

% ── 1. LE PAROLE CHE PARLANO DELLA LINGUA ───────────────────────────────────
% `language_term(Parola, Forza)`. `strong`: una parola che, detta, parla quasi
% sempre della grammatica. `weak`: parla della grammatica solo accanto a
% un'altra («the subject of the painting», «a prison sentence»). Non si riusa
% `metalinguistic_head/1`: contiene `name`, `word`, `greeting`, che una frase
% qualsiasi dice senza fare lezione di grammatica.
machinery(language_term).
language_term(verb, strong).        language_term(noun, strong).
language_term(adjective, strong).   language_term(adverb, strong).
language_term(pronoun, strong).     language_term(preposition, strong).
language_term(conjunction, strong). language_term(auxiliary, strong).
language_term(participle, strong).  language_term(plural, strong).
language_term(singular, strong).    language_term(comparative, strong).
language_term(superlative, strong). language_term(suffix, strong).
language_term(prefix, strong).      language_term(vowel, strong).
language_term(consonant, strong).   language_term(apostrophe, strong).
language_term(syllable, strong).    language_term(tense, strong).
language_term(passive, strong).     language_term(article, weak).
language_term(subject, weak).       language_term(object, weak).
language_term(question, weak).      language_term(sentence, weak).
language_term(clause, weak).        language_term(agent, weak).

% La parola del turno e il termine che porta: la forma detta, o il plurale
% regolare letto con la desinenza che la grammatica gia' conosce
% (`plural_suffix(s, nil)`, grammar.p0) — «verbs», «sentences», «adjectives».
machinery(language_term_form).
% (⚠ `eq/2` e' un confronto NUMERICO: l'identita' si scrive nella testa.)
language_term_form($W, $W, $F) :- language_term($W, $F).
% La desinenza si stacca dalla parola detta, non si attacca a ogni termine: con
% le liste di caratteri costruite per ogni termine il turno di una lezione
% passava 1,6 s dentro `app` (177 000 ingressi, misurato con /debug on).
language_term_form($W, $H, $F) :-
    plural_suffix($Suf, nil), concat_atoms($H, $Suf, $W), language_term($H, $F).

% Si legge la SUPERFICIE del turno (`turn_surface_token/4`), non gli span: la
% forza del turno si decide una prima volta prima che gli span esistano, e la
% cessione del piano di turno si prende quella (misurato: la prima lettura
% diceva ancora `prose_carried`, la seconda no, e rispondeva la conoscenza).
machinery(turn_language_term).
turn_language_term($T, $H, $F) :-
    turn_surface_token($T, $S, $I, $Tok), span_atom($Tok, $W), language_term_form($W, $H, $F).

% ── 2. QUANDO UN TURNO E' UNA LEZIONE SULLA LINGUA ──────────────────────────
% Due termini diversi, o un termine forte in un turno che da' un ordine
% («Add es to make the plural…», «Use this with a singular noun…»). Non una
% domanda: «What is the plural of box?» chiede, non insegna. Non un turno di
% piu' frasi: un paragrafo si legge una frase alla volta, e ogni frase decide
% da se'.
machinery(turn_is_language_lesson).
machinery(turn_language_terms_two).
turn_language_terms_two($T) :-
    turn_language_term($T, $A, $F), turn_language_term($T, $B, $G), dif($A, $B).
machinery(turn_language_lesson_evidence).
turn_language_lesson_evidence($T) :- turn_language_terms_two($T).
turn_language_lesson_evidence($T) :-
    turn_language_term($T, $A, strong), turn_declared_act($T, directive).
turn_is_language_lesson($T) :-
    turn_prose_long($T),
    naf(turn_has_question_mark($T)),
    naf(turn_declared_act($T, compound_statement)),
    naf(turn_opens_request($T)),
    turn_language_lesson_evidence($T).
% Una richiesta non e' una lezione: «Tell me about the subject of the painting
% and the questions it raises» ha due termini deboli e chiede, non insegna.
% ⚠ Limite noto: una frase affermativa con due termini deboli («The subject of
% the lecture was the question of free will») si legge ancora come lezione, e
% parrot0 chiede un esempio invece di imparare il fatto.

% Chi porta prosa non la prende (turn-frames.p0, `prose_carried`): una lezione
% sulla lingua appartiene al piano di turno, come le premesse di un problema.
turn_plan_candidate($T) :- turn_is_language_lesson($T).
turn_response_part($T, 1, $Text) :-
    turn_is_language_lesson($T), current_language($L), language_lesson_line($L, not_a_fact, $Text).
turn_response_part($T, 2, $Text) :-
    turn_is_language_lesson($T), naf(lesson_withdraws($T)), naf(lesson_brings_condition($T)),
    lesson_target_operators($T, $Ops), dif($Ops, nil),
    current_language($L), lesson_quote_list($L, $Ops, $Q),
    language_lesson_line($L, rule_in_use, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, rule_in_use_end, $C), concat_atoms($B, $C, $Text).
turn_response_part($T, 3, $Text) :-
    turn_is_language_lesson($T), naf(lesson_withdraws($T)),
    lesson_residue_operators($T, $Ops), dif($Ops, nil),
    current_language($L), lesson_quote_list($L, $Ops, $Q),
    language_lesson_line($L, rule_residue, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, rule_residue_end, $C), concat_atoms($B, $C, $Text).
turn_response_part($T, 9, $Text) :-
    turn_is_language_lesson($T), naf(lesson_asks_no_example($T)),
    current_language($L), language_lesson_line($L, ask_example_only, $Text).
% (un ritiro non chiede esempi; una condizione non detta chiede la condizione)
machinery(lesson_asks_no_example).
lesson_asks_no_example($T) :- lesson_withdraws($T).
lesson_asks_no_example($T) :- lesson_condition_unsaid($T, $X, $R).

% ── 3. LA LEZIONE RESTA APERTA ─────────────────────────────────────────────
% Il turno in cui e' stata detta; non si salva nell'albero (turn_scratch): e'
% lo stato della conversazione, non conoscenza del mondo.
machinery(language_lesson_opened).
turn_scratch(language_lesson_opened).
machinery(language_lesson_settled).
turn_scratch(language_lesson_settled).
bookkeeper(language_lesson_open).
turn_bookkeeping($T, language_lesson_open) :-
    turn_is_language_lesson($T), turn_counter($N), assert(language_lesson_opened, $N),
    lesson_target_operators($T, $Ts), lesson_store_operators($N, $Ts),
    lesson_residue_operators($T, $Rs), lesson_store_operators($N, $Rs),
    findall($M, lesson_names_mood($T, $M), $Ms), lesson_store_all($N, mood, $Ms),
    findall($K, lesson_placement_order($T, $K), $Ks), lesson_store_all($N, order, $Ks),
    findall($S, lesson_placement_slot($T, $S), $Ss), lesson_store_all($N, slot, $Ss).

% Per quanti turni una domanda e' l'esempio della lezione: l'insegnante che
% risponde a «Can you show me an example?» dice la frase e poi la domanda.
machinery(language_example_window).
language_example_window(3).
machinery(language_lesson_waiting).
language_lesson_waiting($N) :-
    turn_counter($C), language_lesson_opened($N), lt($N, $C),
    is($D, sub($C, $N)), language_example_window($W), le($D, $W),
    naf(language_lesson_settled($N)).
% Senza argomenti, per chi deve chiederlo sotto `naf` (una variabile libera sotto
% `naf` fa fallire sempre la negazione).
machinery(language_example_waiting_now).
language_example_waiting_now :- language_lesson_waiting($N).

% ── 3-bis. LA LEZIONE SI CONFRONTA CON LE REGOLE CHE OPERANO (L4, punto 3) ──
% Prima la lezione non si confrontava con niente: «To make a question with can,
% put can before the subject» e poi QUALUNQUE domanda risposta — anche «What
% is the capital of France?», anche «Must a welder wear a mask?» letta male —
% diceva «lo faccio gia'» (l4-upgrade.md, §0 e Censimento 1). Ora la lezione si
% allinea alle FORME di turno che la comprensione esegue, attraverso le parti
% che una forma ha e che la lingua sa nominare: il suo modo (una domanda), i
% suoi pezzi (il soggetto), le sue ancore (l'ausiliare in testa), e l'ordine
% fra di essi. Non si legge la regola descritta per scriverne una: si chiede se
% una regola che gia' opera ha le conseguenze che la lezione descrive. Le forme
% derivate da `question_inversion/4` (grammar.p0) sono forme come le altre.
%
% Le parole che nominano le parti di una forma: conoscenza, una riga per
% parola e per lingua.
machinery(form_part_word).
form_part_word(question, mood(question)).    form_part_word(questions, mood(question)).
form_part_word(domanda, mood(question)).     form_part_word(domande, mood(question)).
form_part_word(subject, slot(subject)).      form_part_word(soggetto, slot(subject)).
form_part_word(object, slot(object)).        form_part_word(oggetto, slot(object)).
machinery(form_order_word).
form_order_word(before, before).  form_order_word(prima, before).
form_order_word(after, after).    form_order_word(dopo, after).

machinery(turn_lesson_word).
machinery(turn_lesson_word_at).
turn_lesson_word($T, $W) :- turn_surface_token($T, $S, $I, $Tok), span_atom($Tok, $W).
turn_lesson_word_at($T, $I, $W) :- turn_surface_token($T, $S, $I, $Tok), span_atom($Tok, $W).
% dove sta, in una forma, un'ancora detta e un pezzo nominato
machinery(form_anchor_at).
machinery(form_slot_at).
form_anchor_at($F, $N, $W) :- turn_form($F, $N, text($W0)), concat_atoms($W0, "", $W).
form_slot_at($F, $N, $S) :- turn_form($F, $N, slot($S)).
form_slot_at($F, $N, $S) :- turn_form($F, $N, span($S)).
form_slot_at($F, $N, $S) :- turn_form($F, $N, rest($S)).
% La lezione COLLOCA qualcosa: «put X before the subject». Cio' che si colloca
% sta prima della parola d'ordine, il pezzo rispetto a cui lo si colloca dopo:
% senza le posizioni, il «the» di «the subject» passava per l'ausiliare.
% Cio' che si colloca e' la FILA di parole subito prima della parola d'ordine:
% la parola adiacente, e piu' indietro altri ausiliari legati da una
% congiunzione («put do, does or did before»). La fila si ferma a un articolo o
% a qualunque altra parola. Prima bastava stare prima di «before», e «put the
% verb before the subject», detto del tedesco, si riconosceva come «la regola
% che uso: metto «the» prima del soggetto» (sessione live del 26 settembre).
machinery(lesson_placement).
machinery(lesson_placed).
machinery(lesson_run_back).
lesson_placement($T, $X, $K, $S) :-
    turn_lesson_word_at($T, $IO, $O), form_order_word($O, $K),
    lesson_placed($T, $IO, $X),
    turn_lesson_word_at($T, $IS, $WS), lt($IO, $IS), form_part_word($WS, slot($S)).
lesson_placed($T, $IO, $X) :-
    is($I, sub($IO, 1)), turn_lesson_word_at($T, $I, $X), naf(np_opener($X)).
lesson_placed($T, $IO, $X) :-
    is($I, sub($IO, 1)), turn_lesson_word_at($T, $I, $W), naf(np_opener($W)),
    lesson_run_back($T, $I, $X).
% un passo indietro attraverso una congiunzione (o una virgola), verso un altro
% ausiliare
machinery(lesson_list_joiner).
lesson_list_joiner($W) :- conjunction($W).
lesson_list_joiner(",").
lesson_run_back($T, $J, $X) :-
    is($C, sub($J, 1)), turn_lesson_word_at($T, $C, $Conj), lesson_list_joiner($Conj),
    is($I, sub($C, 1)), turn_lesson_word_at($T, $I, $X), auxiliary($X).
lesson_run_back($T, $J, $X) :-
    is($I, sub($J, 1)), turn_lesson_word_at($T, $I, $X), auxiliary($X),
    turn_lesson_word_at($T, $J, $Next), auxiliary($Next).
lesson_run_back($T, $J, $X) :-
    is($C, sub($J, 1)), turn_lesson_word_at($T, $C, $Conj), lesson_list_joiner($Conj),
    is($I, sub($C, 1)), turn_lesson_word_at($T, $I, $W), auxiliary($W),
    lesson_run_back($T, $I, $X).
lesson_run_back($T, $J, $X) :-
    is($I, sub($J, 1)), turn_lesson_word_at($T, $I, $W), auxiliary($W),
    turn_lesson_word_at($T, $J, $Next), auxiliary($Next), lesson_run_back($T, $I, $X).
machinery(lesson_order_holds).
lesson_order_holds(before, $NX, $NS) :- lt($NX, $NS).
lesson_order_holds(after, $NX, $NS) :- lt($NS, $NX).

% LA CONSEGUENZA STRUTTURALE: una forma del modo che la lezione nomina, con
% un'ancora che la lezione dice e un pezzo che la lezione nomina, nell'ordine
% che la lezione dice. `lesson_form_target(Turno, Forma, Ancora, Pezzo)`.
machinery(lesson_form_target).
machinery(lesson_names_mood).
lesson_names_mood($T, $M) :- turn_lesson_word($T, $W), form_part_word($W, mood($M)).
lesson_form_target($T, $F, $X, $S) :-
    lesson_names_mood($T, $M), lesson_placement($T, $X, $K, $S),
    turn_form_mood($F, $M), form_anchor_at($F, $NX, $X), form_slot_at($F, $NS, $S),
    lesson_order_holds($K, $NX, $NS).
% (le parti della collocazione si raccolgono a parte: una virgola dentro un
% termine raccolto spezza la lista di `findall`)
machinery(lesson_placement_order).
machinery(lesson_placement_slot).
lesson_placement_order($T, $K) :- lesson_placement($T, $X, $K, $S).
lesson_placement_slot($T, $S) :- lesson_placement($T, $X, $K, $S).
machinery(lesson_target_operators).
machinery(lesson_target_operator).
lesson_target_operator($T, $X) :- lesson_form_target($T, $F, $X, $S).
lesson_target_operators($T, $Ops) :- findall($X, lesson_target_operator($T, $X), $Ops).
% IL RESIDUO: la lezione nomina il modo, un pezzo e l'ordine, e dice un
% ausiliare con cui nessuna forma di quel modo si apre. Non «lo faccio gia'», e
% non un fatto: la regola c'e', manca la forma dichiarativa da cui derivarla.
machinery(lesson_residue_operator).
machinery(lesson_residue_operators).
machinery(lesson_has_target_with).
lesson_has_target_with($T, $X) :- lesson_form_target($T, $F, $X, $S).
lesson_residue_operator($T, $X) :-
    lesson_names_mood($T, $M), lesson_placement($T, $X, $K, $S),
    auxiliary($X), naf(lesson_has_target_with($T, $X)).
lesson_residue_operators($T, $Ops) :- findall($X, lesson_residue_operator($T, $X), $Ops).

% ── 3-ter. UNA LEZIONE CHE CAMBIA QUANDO LA REGOLA SI APPLICA (L4, incr. 5) ──
% Le lezioni di sopra si allineano a forme che esistono o nominano il residuo:
% possono confermare una regola, non cambiarne la CONDIZIONE. Qui la lezione
% colloca prima del soggetto un VERBO che non e' un ausiliare («need», «dare»)
% e nomina la condizione sotto cui lo fa («when a bare verb follows»). La
% condizione e' un oggetto della regola (`inverts_when/2`, grammar.p0): la
% lezione la scrive per la radice del verbo, e da quel momento la stessa
% `question_inversion/4` deriva la domanda senza «do» dove la condizione si
% prova, e solo li'. Non e' un membro in piu' degli ausiliari: «Need a welder a
% mask?» resta illeggibile, «Does a welder need a mask?» resta com'era.
%
% Senza condizione detta la lezione non si applica alla cieca: farne un
% ausiliare per sempre e' una delle due letture, e la lezione non le distingue.
% parrot0 chiede quale (§5 del piano: tenere le alternative, chiedere la
% distinzione). «forget» davanti alla stessa lezione la ritira.
%
% (incremento 7) La lezione nomina PARTI di una condizione (grammar.p0,
% `condition_part_kind/2`): le parole che le nominano, e come si dicono. La
% condizione e' `all(Parti)` nell'ordine dei tipi (`condition_kinds/1`); un tipo
% che la lezione non nomina prende la parte di default, se c'e': «when a bare
% verb follows» vale al presente, «in the past when a bare verb follows» e' una
% condizione nuova. Senza la parte di complemento la condizione non e' detta.
machinery(inversion_condition_word).
inversion_condition_word(bare, bare_verb_follows).
inversion_condition_word(nudo, bare_verb_follows).
inversion_condition_word(infinitive, bare_verb_follows).
inversion_condition_word(past, in_the_past).
inversion_condition_word(passato, in_the_past).
inversion_condition_word(present, in_the_present).
inversion_condition_word(presente, in_the_present).
machinery(condition_part_said).
condition_part_said(en, bare_verb_follows, "when a bare verb follows").
condition_part_said(it, bare_verb_follows, "quando segue un verbo nudo").
condition_part_said(en, in_the_present, "in the present").
condition_part_said(it, in_the_present, "al presente").
condition_part_said(en, in_the_past, "in the past").
condition_part_said(it, in_the_past, "al passato").
machinery(condition_said).
condition_said($L, all(cons($P, nil)), $T) :- condition_part_said($L, $P, $T).
condition_said($L, all(cons($P, cons($Q, $R))), $T) :-
    condition_part_said($L, $P, $A), condition_said($L, all(cons($Q, $R)), $B),
    concat_atoms($A, " ", $A1), concat_atoms($A1, $B, $T).
machinery(lesson_withdraw_word).
lesson_withdraw_word(forget).  lesson_withdraw_word(dimentica).
machinery(lesson_withdraws).
lesson_withdraws($T) :- turn_lesson_word($T, $W), lesson_withdraw_word($W).
machinery(lesson_condition).
lesson_condition($T, all($Ps)) :- condition_kinds($Ks), lesson_condition_parts($T, $Ks, $Ps).
machinery(lesson_condition_parts).
machinery(lesson_condition_part).
machinery(lesson_names_part_kind).
lesson_condition_parts($T, nil, nil).
lesson_condition_parts($T, cons($K, $Ks), cons($P, $Ps)) :-
    lesson_condition_part($T, $K, $P), lesson_condition_parts($T, $Ks, $Ps).
lesson_condition_part($T, $K, $P) :-
    turn_lesson_word($T, $W), inversion_condition_word($W, $P), condition_part_kind($P, $K).
lesson_condition_part($T, $K, $P) :-
    naf(lesson_names_part_kind($T, $K)), default_condition_part($K, $P).
lesson_names_part_kind($T, $K) :-
    turn_lesson_word($T, $W), inversion_condition_word($W, $P), condition_part_kind($P, $K).
machinery(lesson_places_verb).
lesson_places_verb($T, $X, $R) :-
    lesson_names_mood($T, question), lesson_placement($T, $X, before, subject),
    naf(auxiliary($X)), verb_form($R, $X, base).
machinery(lesson_condition_change).
lesson_condition_change($T, $X, $R, $C) :-
    naf(lesson_withdraws($T)), lesson_places_verb($T, $X, $R), lesson_condition($T, $C).
% nuova solo se la regola non la applica gia' (anche per analogia): altrimenti
% la lezione si allinea alle forme come le altre (§3-bis, «It matches…»)
machinery(lesson_condition_new).
lesson_condition_new($T, $X, $R, $C) :-
    lesson_condition_change($T, $X, $R, $C), naf(inverts_when($R, $C)).
% una lezione che porta una condizione nuova non «combacia» con la regola:
% la cambia (si dice la parte nuova, non una conferma a meta')
machinery(lesson_brings_condition).
lesson_brings_condition($T) :- lesson_condition_new($T, $X, $R, $C).
machinery(lesson_condition_unsaid).
machinery(lesson_names_some_condition).
lesson_names_some_condition($T) :- lesson_condition($T, $C).
lesson_condition_unsaid($T, $X, $R) :-
    naf(lesson_withdraws($T)), lesson_places_verb($T, $X, $R),
    naf(lesson_names_some_condition($T)).
machinery(lesson_condition_withdrawn).
lesson_condition_withdrawn($T, $X, $R, $C) :-
    lesson_withdraws($T), lesson_places_verb($T, $X, $R), inverts_when_taught($R, $C).
% LA CONSEGUENZA: un'affermazione che la comprensione legge ha quel verbo al
% posto dell'operatore e prova la condizione. Si chiede alle forme, non alla
% lezione.
machinery(lesson_condition_opens).
lesson_condition_opens($R, $C) :-
    verb_root_form($R, form($W, $K)), operator_member($W, $D),
    semi_modal_root($W, $R, $K), condition_holds($C, $D, $K).
view_apply_resolved(lesson_condition_opens).

% La scrittura e il ritiro si fanno DOPO la risposta: la risposta si calcola
% dalla lezione, non dal fatto, e una vista sporcata a meta' prova (qui
% `derived_question`) si rideriva dal vivo a ogni domanda (misurato: 35 s nel
% turno della lezione, 42 000 cammini di `question_inversion`).
after_reply_bookkeeper(language_lesson_condition).
turn_after_reply($T, language_lesson_condition) :-
    lesson_condition_new($T, $X, $R, $C),
    assert(inverts_when_taught, $R, $C),
    turn_counter($N), lesson_store_operator($N, $R).
turn_after_reply($T, language_lesson_condition) :-
    lesson_condition_withdrawn($T, $X, $R, $C), retract(inverts_when_taught, $R, $C).
% una lezione che ritira, o che aspetta la condizione, non aspetta un esempio
bookkeeper(language_lesson_no_example).
turn_bookkeeping($T, language_lesson_no_example) :-
    turn_is_language_lesson($T), lesson_asks_no_example($T),
    turn_counter($N), assert(language_lesson_settled, $N).

turn_response_part($T, 5, $Text) :-
    turn_is_language_lesson($T), lesson_condition_new($T, $X, $R, $C),
    naf(inverts_under_condition($R)),
    current_language($L), lesson_quoted($R, $Q), condition_said($L, $C, $Cw),
    language_lesson_line($L, condition_taught, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, condition_taught_mid, $D), concat_atoms($B, $D, $E),
    concat_atoms($E, $Cw, $F),
    language_lesson_line($L, condition_taught_end, $G), concat_atoms($F, $G, $H),
    concat_atoms($H, $Q, $I),
    language_lesson_line($L, condition_taught_tail, $J), concat_atoms($I, $J, $Text).
% un verbo che una condizione l'aveva gia': questa si aggiunge, non la sostituisce
turn_response_part($T, 5, $Text) :-
    turn_is_language_lesson($T), lesson_condition_new($T, $X, $R, $C),
    inverts_under_condition($R),
    current_language($L), lesson_quoted($R, $Q), condition_said($L, $C, $Cw),
    language_lesson_line($L, condition_taught_also, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, condition_taught_also_mid, $D), concat_atoms($B, $D, $E),
    concat_atoms($E, $Cw, $F),
    language_lesson_line($L, condition_taught_also_end, $G), concat_atoms($F, $G, $Text).
turn_response_part($T, 6, $Text) :-
    turn_is_language_lesson($T), lesson_condition_new($T, $X, $R, $C),
    naf(lesson_condition_opens($R, $C)),
    current_language($L), lesson_quoted($R, $Q),
    language_lesson_line($L, condition_residue, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, condition_residue_end, $D), concat_atoms($B, $D, $Text).
turn_response_part($T, 5, $Text) :-
    turn_is_language_lesson($T), lesson_condition_unsaid($T, $X, $R),
    current_language($L), lesson_quoted($R, $Q),
    language_lesson_line($L, condition_ask, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, condition_ask_mid, $D), concat_atoms($B, $D, $E),
    concat_atoms($E, $R, $F),
    language_lesson_line($L, condition_ask_end, $G), concat_atoms($F, $G, $Text).
turn_response_part($T, 5, $Text) :-
    turn_is_language_lesson($T), lesson_condition_withdrawn($T, $X, $R, $C),
    current_language($L), lesson_quoted($R, $Q),
    language_lesson_line($L, condition_withdrawn, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, condition_withdrawn_end, $D), concat_atoms($B, $D, $Text).

% ── 3-quater. LA CONDIZIONE SI CHIEDE A PAROLE (L4, incremento 6) ──────────
% «When does need go before the subject?» risponde dalla STESSA
% `inverts_when_via/3` che la regola esegue: la condizione, e il suo sostegno
% (una lezione, o un'analogia con un altro verbo). Un ausiliare ci va sempre,
% un verbo senza condizione mai, e prende «do». La risposta cambia al turno
% dopo una lezione o un ritiro, senza una seconda copia della regola.
turn_form(ask_inversion_condition, 1, text("when does")).
turn_form(ask_inversion_condition, 2, slot(word)).
turn_form(ask_inversion_condition, 3, text("go before the subject")).
turn_form_mood(ask_inversion_condition, question).
turn_form_priority(ask_inversion_condition, early).
turn_form_act(ask_inversion_condition, "op(match, inversion_condition_answer, [word, free])").
turn_form_reply(ask_inversion_condition, inversion_condition_reply).
turn_form_empty_reply(ask_inversion_condition, inversion_condition_unknown).
turn_form(ask_inversion_condition_put, 1, text("when do you put")).
turn_form(ask_inversion_condition_put, 2, slot(word)).
turn_form(ask_inversion_condition_put, 3, text("before the subject")).
turn_form_mood(ask_inversion_condition_put, question).
turn_form_priority(ask_inversion_condition_put, early).
turn_form_priority(taught_form_17, early).
turn_form_act(ask_inversion_condition_put, "op(match, inversion_condition_answer, [word, free])").
turn_form_reply(ask_inversion_condition_put, inversion_condition_reply).
turn_form_empty_reply(ask_inversion_condition_put, inversion_condition_unknown).
response_template(inversion_condition_reply, "«{word}» {result}").
response_template(inversion_condition_reply, it, "«{word}» {result}").
response_template(inversion_condition_unknown, "I don't know «{word}» as a verb yet, so I can't say where it goes in a question.").
response_template(inversion_condition_unknown, it, "Non conosco ancora «{word}» come verbo, quindi non so dire dove va in una domanda.").

machinery(inversion_condition_answer).
machinery(inversion_condition_root).
machinery(inverts_under_condition).
% la parola detta, o la sua radice («needs» -> need)
inversion_condition_root($W, $W) :- verb_form($W, $W, base).
inversion_condition_root($W, $R) :- naf(verb_form($W, $W, base)), verb_form($R, $W, $K).
inverts_under_condition($R) :- inverts_when($R, $C), dif($C, always).
% un ausiliare: sempre
inversion_condition_answer($W, $Text) :-
    auxiliary($W), current_language($L), language_lesson_line($L, condition_always, $Text).
% un verbo con condizioni: quali, e da dove viene ciascuna, in una frase
% (le frasi raccolte non hanno virgole: `findall` le spezzerebbe)
inversion_condition_answer($W, $Text) :-
    naf(auxiliary($W)), inversion_condition_root($W, $R), inverts_under_condition($R),
    current_language($L), findall($P, inversion_condition_phrase($L, $R, $P), $Ps),
    inversion_phrase_join($L, $Ps, $J),
    language_lesson_line($L, condition_only, $A), concat_atoms($A, $J, $B),
    language_lesson_line($L, condition_only_end, $E), concat_atoms($B, $E, $Text).
machinery(inversion_condition_phrase).
inversion_condition_phrase($L, $R, $P) :-
    inverts_when_via($R, $C, $S), dif($C, always),
    condition_said($L, $C, $Cw), inversion_support_said($L, $S, $Sw), concat_atoms($Cw, $Sw, $P).
machinery(inversion_phrase_join).
inversion_phrase_join($L, cons($P, nil), $P).
inversion_phrase_join($L, cons($P, cons($Q, $R)), $T) :-
    inversion_phrase_join($L, cons($Q, $R), $B), language_lesson_line($L, condition_or, $O),
    concat_atoms($P, $O, $A), concat_atoms($A, $B, $T).
% un verbo senza condizione: mai, e chiede con «do»
inversion_condition_answer($W, $Text) :-
    naf(auxiliary($W)), inversion_condition_root($W, $R), naf(inverts_under_condition($R)),
    current_language($L), language_lesson_line($L, condition_never, $Text).
machinery(inversion_support_said).
inversion_support_said($L, taught, $T) :- language_lesson_line($L, support_taught, $T).
inversion_support_said($L, like($R), $T) :-
    lesson_quoted($R, $Q), language_lesson_line($L, support_like, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, support_like_end, $C), concat_atoms($B, $C, $T).

% ── 3-quinquies. LA DOMANDA INVERSA: la condizione come chiave (L4, incr. 8) ─
% «Which verbs go before the subject when a bare verb follows?» chiede la
% regola dall'altro lato: non «quando va need?», ma «chi ci va, a questa
% condizione?». La condizione si legge con lo STESSO lettore delle parti che
% legge la lezione (`lesson_condition/2`: le parole, i tipi, la parte di
% default), e i verbi vengono dalla stessa `inverts_when_via/3` che la regola
% esegue, ciascuno con il suo sostegno. Una lezione o un ritiro cambiano la
% risposta al turno dopo; nessuna copia.
turn_form(ask_verbs_under_condition, 1, text("which verbs go before the subject")).
turn_form(ask_verbs_under_condition, 2, rest(condition)).
turn_form_mood(ask_verbs_under_condition, question).
turn_form_priority(ask_verbs_under_condition, early).
turn_form_act(ask_verbs_under_condition, "op(match, verbs_under_condition_answer, [condition, free])").
turn_form_reply(ask_verbs_under_condition, verbs_under_condition_reply).
turn_form_empty_reply(ask_verbs_under_condition, verbs_under_condition_unread).
turn_form(ask_verbs_under_condition_it, 1, text("quali verbi vanno prima del soggetto")).
turn_form(ask_verbs_under_condition_it, 2, rest(condition)).
turn_form_mood(ask_verbs_under_condition_it, question).
turn_form_view(ask_verbs_under_condition_it, said).
turn_form_priority(ask_verbs_under_condition_it, early).
turn_form_act(ask_verbs_under_condition_it, "op(match, verbs_under_condition_answer, [condition, free])").
turn_form_reply(ask_verbs_under_condition_it, verbs_under_condition_reply).
turn_form_empty_reply(ask_verbs_under_condition_it, verbs_under_condition_unread).
turn_form(ask_verbs_before_subject_it, 1, text("quali verbi vanno prima del soggetto")).
turn_form_mood(ask_verbs_before_subject_it, question).
turn_form_view(ask_verbs_before_subject_it, said).
turn_form_priority(ask_verbs_before_subject_it, early).
turn_form_act(ask_verbs_before_subject_it, "op(match, verbs_before_subject_answer, [free])").
turn_form_reply(ask_verbs_before_subject_it, verbs_under_condition_reply).
response_template(verbs_under_condition_reply, "{result}").
response_template(verbs_under_condition_reply, it, "{result}").
response_template(verbs_under_condition_unread, "Tell me the condition in words, for example «when a bare verb follows» or «in the past when a bare verb follows».").
response_template(verbs_under_condition_unread, it, "Dimmi la condizione a parole, per esempio «quando segue un verbo nudo» o «al passato quando segue un verbo nudo».").
% Senza condizione: la regola intera, dai due lati — gli ausiliari sempre, i
% verbi con una condizione ciascuno con la sua, e gli altri con «do».
turn_form(ask_verbs_before_subject, 1, text("which verbs go before the subject")).
turn_form_mood(ask_verbs_before_subject, question).
turn_form_priority(ask_verbs_before_subject, early).
turn_form_act(ask_verbs_before_subject, "op(match, verbs_before_subject_answer, [free])").
turn_form_reply(ask_verbs_before_subject, verbs_under_condition_reply).
machinery(verbs_before_subject_answer).
machinery(conditioned_verb_phrase).
verbs_before_subject_answer($Text) :-
    current_language($L), language_lesson_line($L, rule_always, $A),
    findall($P, conditioned_verb_phrase($L, $P), cons($P1, $Ps)), rule_conditioned_said($L, cons($P1, $Ps), $M),
    concat_atoms($A, $M, $B), language_lesson_line($L, rule_else, $E), concat_atoms($B, $E, $Text).
verbs_before_subject_answer($Text) :-
    current_language($L), naf(any_conditioned_verb), language_lesson_line($L, rule_always, $A),
    language_lesson_line($L, rule_else, $E), concat_atoms($A, $E, $Text).
machinery(any_conditioned_verb).
any_conditioned_verb :- inverts_under_condition($R).
conditioned_verb_phrase($L, $P) :-
    inverts_under_condition($R), findall($X, inversion_condition_phrase($L, $R, $X), $Xs),
    inversion_phrase_join($L, $Xs, $J), lesson_quoted($R, $Q), language_lesson_line($L, only_when, $O),
    concat_atoms($Q, $O, $A), concat_atoms($A, $J, $P).
machinery(rule_conditioned_said).
rule_conditioned_said($L, cons($P, $Ps), $T) :-
    inversion_phrase_and($L, cons($P, $Ps), $J), language_lesson_line($L, rule_some, $A),
    concat_atoms($A, $J, $T).
language_lesson_line(en, rule_always, "The auxiliaries always go before the subject to ask").
language_lesson_line(en, rule_some, "; some verbs only under a condition: ").
language_lesson_line(en, only_when, " only ").
language_lesson_line(en, rule_else, "; every other verb stays after the subject and asks with «do».").
language_lesson_line(it, rule_always, "Gli ausiliari vanno sempre prima del soggetto per chiedere").
language_lesson_line(it, rule_some, "; alcuni verbi solo a una condizione: ").
language_lesson_line(it, only_when, " solo ").
language_lesson_line(it, rule_else, "; ogni altro verbo resta dopo il soggetto e chiede con «do».").
machinery(verbs_under_condition_answer).
machinery(verb_under_condition_phrase).
verbs_under_condition_answer($Said, $Text) :-
    lesson_condition(current_turn, $C), current_language($L), condition_said($L, $C, $Cw),
    findall($P, verb_under_condition_phrase($L, $C, $P), cons($P1, $Ps)),
    inversion_phrase_and($L, cons($P1, $Ps), $J), upcase_first($Cw, $Cu),
    concat_atoms($Cu, ": ", $A), concat_atoms($A, $J, $B), concat_atoms($B, ".", $Text).
verbs_under_condition_answer($Said, $Text) :-
    lesson_condition(current_turn, $C), naf(some_verb_under($C)), current_language($L),
    condition_said($L, $C, $Cw), language_lesson_line($L, no_verb_under, $A),
    concat_atoms($A, $Cw, $B), language_lesson_line($L, no_verb_under_end, $E), concat_atoms($B, $E, $Text).
verb_under_condition_phrase($L, $C, $P) :-
    inverts_when_via($R, $C, $S), lesson_quoted($R, $Q), inversion_support_said($L, $S, $Sw),
    concat_atoms($Q, $Sw, $P).
machinery(some_verb_under).
some_verb_under($C) :- inverts_when_via($R, $C, $S).
machinery(inversion_phrase_and).
inversion_phrase_and($L, cons($P, nil), $P).
inversion_phrase_and($L, cons($P, cons($Q, $R)), $T) :-
    inversion_phrase_and($L, cons($Q, $R), $B), language_lesson_line($L, and_join, $O),
    concat_atoms($P, $O, $A), concat_atoms($A, $B, $T).
language_lesson_line(en, and_join, " and ").
language_lesson_line(it, and_join, " e ").
language_lesson_line(en, no_verb_under, "None that I know: no verb goes before the subject only ").
language_lesson_line(en, no_verb_under_end, "; the auxiliaries go there always, and the other verbs ask with «do».").
language_lesson_line(it, no_verb_under, "Nessuno che io sappia: nessun verbo va prima del soggetto solo ").
language_lesson_line(it, no_verb_under_end, "; gli ausiliari ci vanno sempre, e gli altri verbi chiedono con «do».").

% Che cosa la lezione COLLOCA resta con lei (turn_scratch): l'ausiliare, il
% modo, l'ordine, il pezzo. Non le forme trovate adesso: al turno dell'esempio
% si chiede di nuovo alle forme di quel momento, cosi' una lezione rimasta al
% residuo si risolve se nel frattempo un'altra lezione ha dato cio' che
% mancava (§2.6: rivedere i giudizi con la conoscenza nuova).
machinery(language_lesson_operator).
turn_scratch(language_lesson_operator).
machinery(language_lesson_part).
turn_scratch(language_lesson_part).
machinery(lesson_store_all).
lesson_store_all($N, $Kind, nil).
lesson_store_all($N, $Kind, cons($V, $R)) :-
    lesson_store_part($N, $Kind, $V), lesson_store_all($N, $Kind, $R).
machinery(lesson_store_part).
lesson_store_part($N, $Kind, $V) :- language_lesson_part($N, $Kind, $V).
lesson_store_part($N, $Kind, $V) :- naf(language_lesson_part($N, $Kind, $V)), assert(language_lesson_part, $N, $Kind, $V).
machinery(lesson_store_operators).
machinery(lesson_store_operator).
lesson_store_operators($N, nil).
lesson_store_operators($N, cons($X, $R)) :- lesson_store_operator($N, $X), lesson_store_operators($N, $R).
lesson_store_operator($N, $X) :- language_lesson_operator($N, $X).
lesson_store_operator($N, $X) :- naf(language_lesson_operator($N, $X)), assert(language_lesson_operator, $N, $X).
machinery(language_lesson_aligned).
language_lesson_aligned($N) :- language_lesson_operator($N, $X).

% «do», «does» e «did»: una lista detta con le virgolette della lingua
machinery(lesson_quote_list).
lesson_quote_list($L, cons($X, nil), $Q) :- lesson_quoted($X, $Q).
lesson_quote_list($L, cons($X, cons($Y, $R)), $Q) :-
    lesson_quoted($X, $QX), lesson_quote_list($L, cons($Y, $R), $QR),
    language_lesson_line($L, list_sep, $Sep), concat_atoms($QX, $Sep, $A), concat_atoms($A, $QR, $Q).
machinery(lesson_quoted).
lesson_quoted($X, $Q) :- concat_atoms("«", $X, $A), concat_atoms($A, "»", $Q).

% ── 4. L'ESEMPIO, LETTO DALLA COMPRENSIONE ─────────────────────────────────
% Per una lezione ALLINEATA l'esempio conta solo se lo ha letto la forma che la
% lezione descrive (`turn_form_read/2`, la ricevuta del lettore delle forme).
% Un esempio che dice l'ausiliare ma e' stato letto per altra via non conferma
% niente: lo si dice. Un turno che non dice l'ausiliare non e' un esempio di
% questa lezione: la lezione resta aperta, in silenzio («Paris» del §0).
machinery(turn_form_read).
turn_scratch(turn_form_read).
machinery(language_example_by_rule).
machinery(language_example_relevant).
language_example_by_rule($N, $X) :-
    language_lesson_waiting($N), turn_declared_act(current_turn, question),
    turn_form_read(current_turn, $F), language_lesson_operator($N, $X),
    language_lesson_part($N, mood, $M), turn_form_mood($F, $M),
    language_lesson_part($N, order, $K), language_lesson_part($N, slot, $S),
    form_anchor_at($F, $NX, $X), form_slot_at($F, $NS, $S), lesson_order_holds($K, $NX, $NS).
machinery(language_example_by_rule_some).
language_example_by_rule_some($N) :- language_example_by_rule($N, $X).
language_example_relevant($N, $X) :-
    language_lesson_waiting($N), turn_declared_act(current_turn, question),
    language_lesson_operator($N, $X), turn_lesson_word(current_turn, $X),
    naf(turn_mentions_words(current_turn)).
% Una domanda che NOMINA la parola («When does need go before the subject?») non
% la USA: parla della regola, non ne e' un esempio. Il ruolo lo dichiara la
% forma che l'ha letta (`mention_form/1`), non la posizione della parola.
machinery(mention_form).
machinery(turn_mentions_words).
turn_mentions_words($T) :- turn_form_read($T, $F), mention_form($F).
mention_form(ask_inversion_condition).
mention_form(ask_inversion_condition_put).
machinery(language_example_other_way).
language_example_other_way($N, $X) :-
    language_example_relevant($N, $X), naf(language_example_by_rule_some($N)).
% Per una lezione che non si allinea a nessuna forma, una risposta non dice COME
% e' stata data: non si proclama «lo faccio gia'» (era il falso del §0).
machinery(language_example_read).
language_example_read($N) :-
    language_lesson_waiting($N), naf(language_lesson_aligned($N)),
    turn_declared_act(current_turn, question),
    turn_outcome(current_turn, answered),
    naf(turn_gap_kind(current_turn, wrong_suspect)).
% Una risposta generica (il sospetto di gap-kinds.p0: rispondeva una facolta'
% che produce un testo che puo' non rispondere) non e' un esempio capito, e non
% e' nemmeno un muro: la lezione resta aperta, e parrot0 non dice niente.
machinery(language_example_unread).
language_example_unread($N) :-
    language_lesson_waiting($N), naf(language_lesson_aligned($N)),
    turn_declared_act(current_turn, question),
    turn_outcome(current_turn, $O), unsatisfying_outcome($O, $K).

% La condotta sulla risposta (reply-conduct.p0): il motore la consulta una
% volta, prima che la risposta esca.
reply_conduct($In, $Out) :-
    language_example_by_rule($N, $X), assert(language_lesson_settled, $N),
    current_language($L), lesson_quoted($X, $Q),
    language_lesson_line($L, by_rule, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, by_rule_end, $C), concat_atoms($B, $C, $Note), concat_atoms($In, $Note, $Out).
reply_conduct($In, $Out) :-
    language_example_other_way($N, $X), assert(language_lesson_settled, $N),
    current_language($L), lesson_quoted($X, $Q),
    language_lesson_line($L, other_way, $A), concat_atoms($A, $Q, $B),
    language_lesson_line($L, other_way_end, $C), concat_atoms($B, $C, $Note), concat_atoms($In, $Note, $Out).
reply_conduct($In, $Out) :-
    language_example_read($N), assert(language_lesson_settled, $N),
    current_language($L), language_lesson_line($L, answered_unknown_way, $Note), concat_atoms($In, $Note, $Out).
reply_conduct($In, $Out) :-
    language_example_unread($N), assert(language_lesson_settled, $N),
    current_language($L), language_lesson_line($L, not_yet, $Note), concat_atoms($In, $Note, $Out).

% ── 5. CHE COSA DIRE ────────────────────────────────────────────────────────
machinery(language_lesson_line).
language_lesson_line(en, not_a_fact, "I read that as a rule about how the language works, not as a fact about the world, so I keep nothing from it yet.").
language_lesson_line(it, not_a_fact, "La leggo come una regola su come funziona la lingua, non come un fatto sul mondo, quindi per ora non ne tengo niente.").
language_lesson_line(en, rule_in_use, "It matches a rule I already use: I ask questions by putting ").
language_lesson_line(en, rule_in_use_end, " before the subject.").
language_lesson_line(it, rule_in_use, "Corrisponde a una regola che uso già: faccio le domande mettendo ").
language_lesson_line(it, rule_in_use_end, " prima del soggetto.").
language_lesson_line(en, rule_residue, "I do put an auxiliary before the subject to ask, but no statement I can read has ").
language_lesson_line(en, rule_residue_end, " in that place, so I can't do it that way yet.").
language_lesson_line(it, rule_residue, "Metto sì l'ausiliare prima del soggetto per chiedere, ma nessuna affermazione che so leggere ha ").
language_lesson_line(it, rule_residue_end, " in quel posto, quindi così non so ancora farlo.").
language_lesson_line(en, condition_taught, "From now on I put ").
language_lesson_line(en, condition_taught_mid, " before the subject, but only ").
language_lesson_line(en, condition_taught_end, "; everywhere else ").
language_lesson_line(en, condition_taught_tail, " stays a verb and asks with «do».").
language_lesson_line(it, condition_taught, "D'ora in poi metto ").
language_lesson_line(it, condition_taught_mid, " prima del soggetto, ma solo ").
language_lesson_line(it, condition_taught_end, "; altrove ").
language_lesson_line(it, condition_taught_tail, " resta un verbo e chiede con «do».").
language_lesson_line(en, condition_residue, "No statement I can read has ").
language_lesson_line(en, condition_residue_end, " with a bare verb after it yet, so I have nothing to ask that way.").
language_lesson_line(it, condition_residue, "Nessuna affermazione che so leggere ha ancora ").
language_lesson_line(it, condition_residue_end, " seguito da un verbo nudo, quindi non ho niente da chiedere così.").
language_lesson_line(en, condition_ask, "Is that always, or only in some cases? ").
language_lesson_line(en, condition_ask_mid, " isn't an auxiliary: if it went before the subject every time, from «X needs a mask» I would ask «").
language_lesson_line(en, condition_ask_end, " X a mask?». Tell me when it goes there, for instance only when a bare verb follows.").
language_lesson_line(it, condition_ask, "Sempre, o solo in certi casi? ").
language_lesson_line(it, condition_ask_mid, " non è un ausiliare: se andasse sempre prima del soggetto, da «X needs a mask» chiederei «").
language_lesson_line(it, condition_ask_end, " X a mask?». Dimmi quando ci va, per esempio solo quando segue un verbo nudo.").
language_lesson_line(en, condition_withdrawn, "Done: I no longer put ").
language_lesson_line(en, condition_withdrawn_end, " before the subject; it asks with «do» again.").
language_lesson_line(it, condition_withdrawn, "Fatto: non metto più ").
language_lesson_line(it, condition_withdrawn_end, " prima del soggetto; torna a chiedere con «do».").
language_lesson_line(en, condition_always, "always goes before the subject to ask: it is an auxiliary.").
language_lesson_line(it, condition_always, "va sempre prima del soggetto per chiedere: è un ausiliare.").
language_lesson_line(en, condition_only, "goes before the subject only ").
language_lesson_line(it, condition_only, "va prima del soggetto solo ").
language_lesson_line(en, condition_only_end, "; everywhere else it stays a verb and asks with «do».").
language_lesson_line(it, condition_only_end, "; altrove resta un verbo e chiede con «do».").
language_lesson_line(en, support_taught, " (you taught me that)").
language_lesson_line(it, support_taught, " (me l'hai insegnato tu)").
language_lesson_line(en, support_like, " (because it behaves like ").
language_lesson_line(en, support_like_end, ")").
language_lesson_line(it, support_like, " (perché si comporta come ").
language_lesson_line(it, support_like_end, ")").
language_lesson_line(en, condition_or, " or ").
language_lesson_line(it, condition_or, " oppure ").
language_lesson_line(en, condition_taught_also, "From now on I also put ").
language_lesson_line(en, condition_taught_also_mid, " before the subject ").
language_lesson_line(en, condition_taught_also_end, ", as well as where I already did.").
language_lesson_line(it, condition_taught_also, "D'ora in poi metto ").
language_lesson_line(it, condition_taught_also_mid, " prima del soggetto anche ").
language_lesson_line(it, condition_taught_also_end, ", oltre a dove lo facevo già.").
language_lesson_line(en, condition_never, "never goes before the subject: it is a verb, and it asks with «do».").
language_lesson_line(it, condition_never, "non va mai prima del soggetto: è un verbo, e chiede con «do».").
language_lesson_line(en, list_sep, ", ").
language_lesson_line(it, list_sep, ", ").
language_lesson_line(en, ask_example_only, "Can you show me an example?").
language_lesson_line(it, ask_example_only, "Mi fai un esempio?").
language_lesson_line(en, by_rule, " That was your example, and I read it with that rule, ").
language_lesson_line(en, by_rule_end, " before the subject: what you described is something I already do, at least here.").
language_lesson_line(it, by_rule, " Era il tuo esempio, e l'ho letto con quella regola, ").
language_lesson_line(it, by_rule_end, " prima del soggetto: quello che hai descritto lo faccio già, almeno qui.").
language_lesson_line(en, other_way, " That was your example, but I didn't read it with ").
language_lesson_line(en, other_way_end, " before the subject, so I can't claim to do what you described yet.").
language_lesson_line(it, other_way, " Era il tuo esempio, ma non l'ho letto con ").
language_lesson_line(it, other_way_end, " prima del soggetto, quindi non posso dire di fare già quello che hai descritto.").
language_lesson_line(en, answered_unknown_way, " That was your example, and I answered it, but I can't tell yet whether I did it the way you described.").
language_lesson_line(it, answered_unknown_way, " Era il tuo esempio, e ho risposto, ma non so ancora dire se l'ho fatto nel modo che hai descritto.").
language_lesson_line(en, not_yet, " That was your example, and I can't read it yet, so what you described is something I don't do yet.").
language_lesson_line(it, not_yet, " Era il tuo esempio, e non so ancora leggerlo: quello che hai descritto non lo faccio ancora.").
