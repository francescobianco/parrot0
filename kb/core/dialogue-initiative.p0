% Il seguito motivato: una lettura IR, atti citati, proposte e uptake.
% Primo circuito operativo di docs/plans/the-rational-philosopher.md.
% Non prova il contenuto del payload e non lo asserisce come fatto del mondo.
% Nuove forme, atti, itinerari e mosse sono conoscenza; nessun consumer C nuovo.
:- file_attribute(machinery).
:- include(dialogue-initiative/forms.p0).
:- include(dialogue-initiative/moves.p0).
:- include(dialogue-initiative/teaching.p0).

% Il matcher consuma i token gia' pubblicati dalla IR universale, dall'inizio
% del turno: una menzione incassata non diventa un'intenzione dell'utente.
dialogue_prefix($T, $I, nil, $I).
dialogue_prefix($T, $I, cons($W, $Ws), $End) :-
    turn_word($T, $I, $W), is($Next, add($I, 1)),
    dialogue_prefix($T, $Next, $Ws, $End).
% Un avverbio dell'ATTO non e' il tema. «facciamo filosofia insieme» parla di
% filosofia, non di «filosofia insieme»: «insieme» dice COME si propone di
% procedere, e appartiene alla proposta. Quali parole in coda appartengano
% all'atto invece che al complemento e' conoscenza — una in piu' e' una riga,
% e nessuna e' legata a un atto particolare.
machinery(dialogue_payload_trim).
dialogue_payload_trim(insieme).
dialogue_payload_trim(together).
dialogue_payload_trim(please).
% L'ultimo indice del complemento: l'ultima parola, oppure quella prima di un
% avverbio dell'atto in coda. Le due clausole si escludono, quindi il tema ha
% una lettura sola: due code diverse darebbero due proposte per lo stesso atto.
dialogue_payload_last($T, $I) :-
    turn_word($T, $I, $W), is($N, add($I, 1)), naf(turn_word_at($T, $N)),
    naf(dialogue_payload_trim($W)).
dialogue_payload_last($T, $I) :-
    turn_word($T, $I, $W), is($N, add($I, 1)), turn_word($T, $N, $L),
    dialogue_payload_trim($L), is($A, add($N, 1)), naf(turn_word_at($T, $A)).
dialogue_tail($T, $I, $W) :- dialogue_payload_last($T, $I), turn_word($T, $I, $W).
dialogue_tail($T, $I, $Text) :-
    turn_word($T, $I, $W), naf(dialogue_payload_last($T, $I)),
    is($Next, add($I, 1)), turn_word_at($T, $Next),
    dialogue_tail($T, $Next, $Tail), concat_atoms($W, " ", $Head), concat_atoms($Head, $Tail, $Text).
dialogue_payload($T, $End, rest, $Text) :- dialogue_tail($T, $End, $Text).
dialogue_payload($T, $End, whole, unspecified) :- naf(turn_word_at($T, $End)).
dialogue_payload($T, $End, optional, $Text) :- dialogue_tail($T, $End, $Text).
dialogue_payload($T, $End, optional, unspecified) :- naf(turn_word_at($T, $End)).

% Le cue sono solo un indice dei candidati; la prova e' la sequenza intera.
% La forma piu' lunga prevale. Due atti diversi alla stessa estensione restano
% ambigui: nessuna vittoria per ordine di caricamento.
turn_cue_registry(dialogue_opening, 1).
% L'apertura e il suo complemento sono due cose: l'atto e' gia' deciso dalla
% sequenza iniziale, il complemento costa la costruzione della coda. Separarli
% permette di chiedere «questo turno apre un atto?» senza pagare la coda — ed
% e' la domanda che il confine di arbitrato pone (turn-frames.p0,
% `turn_opens_act/1`): una copula dentro un'apertura non e' prosa da leggere.
dialogue_opening_at($T, $Act, $End) :-
    turn_cue_form($T, dialogue_opening, $Surface), dialogue_opening($Surface, $Act),
    atom_words($Surface, $Words), dialogue_prefix($T, 0, $Words, $End).
turn_opens_act($T) :- dialogue_opening_at($T, $Act, $End).
dialogue_form_read($T, $Act, $Text, $End) :-
    dialogue_opening_at($T, $Act, $End),
    dialogue_shape($Act, $Mode), dialogue_payload($T, $End, $Mode, $Text).

% ── RI-008 — L'INSISTENZA NON E' UN TURNO PIU' DIFFICILE ──────────────────
%
% «never mind» si ferma; «stop» si ferma; «Stop, never mind.» — le stesse due
% parole dette con piu' forza — cadeva nel muro. Un atto di forma `whole`
% vuole che il turno sia SOLO la sua apertura, e chi insiste ne mette due.
% Chi si ferma due volte veniva capito di meno, ed e' il contrario di quello
% che una persona si aspetta.
%
% Non si allarga la forma: si riconosce la RIPETIZIONE. La seconda apertura
% dev'essere dello stesso atto, cominciare dove finisce la prima e chiudere il
% turno. Vale per ogni atto `whole` dichiarato, oggi e domani, e non tocca gli
% atti che una coda ce l'hanno per contratto (`rest`, `optional`).
machinery(dialogue_second_opening).
dialogue_second_opening($T, $Act, $From, $End) :-
    turn_cue_form($T, dialogue_opening, $Surface), dialogue_opening($Surface, $Act),
    atom_words($Surface, $Words), dialogue_prefix($T, $From, $Words, $End).
dialogue_form_read($T, $Act, unspecified, $End2) :-
    dialogue_opening_at($T, $Act, $End), dialogue_shape($Act, whole),
    dialogue_second_opening($T, $Act, $End, $End2),
    naf(turn_word_at($T, $End2)).
% Si pubblicano le letture prima di confrontarle: negare una rilettura
% ricorsiva completa faceva esaurire la profondita' sulle aperture inglesi.
% L'assenza di un'alternativa deve essere una verifica finita sui candidati.
machinery(dialogue_raw).
turn_scratch(dialogue_raw).
bookkeeper(dialogue_parse).
dialogue_record_form($T, $N, $End) :-
    dialogue_form_read($T, $A, $P, $End), assert(dialogue_raw, $N, $A, payload($P, $End)).
turn_bookkeeping($T, dialogue_parse) :-
    turn_counter($N), findall($End, dialogue_record_form($T, $N, $End), $Ends).
dialogue_current_raw($T, $A, $P, $End) :- turn_counter($N), dialogue_raw($N, $A, payload($P, $End)).
dialogue_longer($T, $End) :- dialogue_current_raw($T, $A, $P, $Other), gt($Other, $End).
dialogue_best($T, $Act, $Text) :-
    dialogue_current_raw($T, $Act, $Text, $End), naf(dialogue_longer($T, $End)).
dialogue_ambiguous($T, $Act) :- dialogue_best($T, $Other, $P), dif($Act, $Other).
dialogue_excluded($T) :- inner_turn.
% 20 settembre 2026 — UN PIANO INSEGNATO BATTE UN ITINERARIO DI BOOTSTRAP.
% Aperto il confine di arbitrato (turn-frames.p0, `turn_opens_act/1`), «I have
% a problem with my bike.» arriva al circuito — ed e' un'apertura `problem`
% vera — ma per quella situazione qualcuno ha gia' IMPARATO che cosa fare
% (user-situations.p0). I quattro passi per attivita' sono un bootstrap, non
% una risposta migliore di una lezione ricevuta: chi ha il piano risponde lui.
% ⚠ La vista giusta e' `direct_situation/2`, NON `turn_has_situation_plan/1`.
% La seconda e' vera anche quando il turno non nomina nessun guaio: le basta
% una questione di ricerca aperta, e con un'issue aperta OGNI seguito le
% apparterrebbe. La precedenza si merita nominando la situazione, non essendo
% il turno dopo.
dialogue_direct_plan($T) :- direct_situation($T, $S), plan_move($S, 1, $M).
dialogue_excluded($T) :- dialogue_direct_plan($T).
dialogue_excluded($T) :- turn_cue($T, sentence_boundary_cue, $C).
dialogue_excluded($T) :- turn_cue($T, dialogue_quotation_cue, $C).
turn_cue_registry(dialogue_quotation_cue, 1).
dialogue_quotation_cue("\"").
dialogue_quotation_cue("«").
dialogue_quotation_cue("»").
dialogue_reading($T, $Act, $Text) :-
    dialogue_best($T, $Act, $Text), naf(dialogue_ambiguous($T, $Act)), naf(dialogue_excluded($T)).

% Stato di sessione, mai training del mondo o persistenza di una conversazione.
machinery(dialogue_seen).
machinery(dialogue_scope).
machinery(dialogue_emitted).
machinery(dialogue_language).
machinery(dialogue_detail).
machinery(dialogue_offered).
turn_scratch(dialogue_seen).
turn_scratch(dialogue_scope).
turn_scratch(dialogue_emitted).
turn_scratch(dialogue_language).
turn_scratch(dialogue_detail).
turn_scratch(dialogue_offered).
bookkeeper(dialogue_observe).
turn_bookkeeping($T, dialogue_observe) :-
    turn_counter($N), input_scope_language($T, $L), assert(dialogue_language, $N, $L),
    dialogue_reading($T, $A, $P), assert(dialogue_seen, $N, $A, $P).

dialogue_now(current_turn, $Act, $P) :- turn_counter($N), dialogue_seen($N, $Act, $P).
dialogue_previous($Scope, $Step) :-
    turn_counter($N), is($Before, sub($N, 1)), dialogue_emitted($Before, $Scope, $Step).
dialogue_previous_open($Scope, $Step) :- dialogue_previous($Scope, $Step), dif($Step, closed).
dialogue_has_previous :- dialogue_previous_open($S, $K).

% La proposta e' fondata sull'atto e sull'itinerario dichiarato, non una prova
% della verita' del tema. Step e bisogno sono interrogabili prima della resa.
dialogue_candidate($T, $N, 1, $Move) :-
    dialogue_now($T, $A, $P), dialogue_task($A, $Task), turn_counter($N),
    dialogue_initial($Task, $Move).
dialogue_candidate($T, $S, $Next, $Move) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, advance), dialogue_previous_open($S, $K),
    dialogue_scope($S, $Task, $Topic), is($Next, add($K, 1)), dialogue_step($Task, $Next, $Move).
dialogue_next_exists($Task, $K) :- is($Next, add($K, 1)), dialogue_step($Task, $Next, $M).
dialogue_candidate($T, $S, $K, review_outcome) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, advance), dialogue_previous_open($S, $K),
    dialogue_scope($S, $Task, $Topic), naf(dialogue_next_exists($Task, $K)).
dialogue_candidate($T, $S, closed, respect_stop) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, stop), dialogue_previous($S, $K).
dialogue_candidate($T, $N, closed, respect_stop) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, stop), naf(dialogue_any_previous),
    naf(dialogue_offer_elsewhere(any)), turn_counter($N).
dialogue_any_previous :- dialogue_previous($S, $K).
dialogue_candidate($T, $N, closed, ask_anchor) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, advance), naf(dialogue_has_previous),
    naf(dialogue_offer_elsewhere(any)), turn_counter($N).
% 23 settembre 2026 — UN'OFFERTA APERTA DI UN'ALTRA FACOLTA' E' UN'ANCORA.
% «tell me about zorbium» -> «Want me to look it up?» -> «yes» riceveva «I do
% not have an active proposal to continue»: senza una proposta PROPRIA, questo
% strato rivendicava il «si'» e il «no» dovuti a un'altra questione
% (deep_memory.p0t). Se il tabellone ha una questione che l'utente deve
% (`issue_owed_by/2`, issues.p0), il seguito appartiene a lei: qui non si
% risponde a vuoto. Trovato con `!debug`: `max_qud = gap_offer_zorbium`.
machinery(dialogue_offer_elsewhere).
dialogue_offer_elsewhere(any) :- issue_owed_by($Issue, user).
dialogue_candidate($T, $S, $K, explain_move) :-
    dialogue_now($T, explain, $P), dialogue_previous_open($S, $K).
dialogue_candidate($T, $N, closed, ask_anchor) :-
    dialogue_now($T, explain, $P), naf(dialogue_has_previous), turn_counter($N).

% Il bisogno non e' inventato dalla frase di risposta: appartiene alla mossa.
dialogue_basis($T, $Move, anchor($S), $Need) :-
    dialogue_candidate($T, $S, $Step, $Move), dialogue_move_need($Move, $Need).
dialogue_topic($T, $Topic) :- dialogue_now($T, $A, $P), dialogue_task($A, $Task), dif($P, unspecified), words_of($P, $Topic).
dialogue_topic($T, $Topic) :- dialogue_now($T, $A, unspecified), dialogue_task($A, $Task), dialogue_reply_language($T, $L), dialogue_task_name($Task, $L, $Topic).
dialogue_topic($T, $Topic) :- dialogue_now($T, $A, $P), dialogue_uptake($A, $Effect), dialogue_previous($S, $K), dialogue_scope($S, $Task, $Topic).
dialogue_topic($T, $Topic) :- dialogue_now($T, explain, $P), dialogue_previous_open($S, $K), dialogue_scope($S, $Task, $Topic).

bookkeeper(dialogue_remember).
turn_bookkeeping($T, dialogue_remember) :-
    dialogue_now($T, $A, $P), dialogue_task($A, $Task), turn_counter($N),
    dialogue_topic($T, $Topic), assert(dialogue_scope, $N, $Task, $Topic).
bookkeeper(dialogue_propose).
% ── 20 settembre 2026 — SI REGISTRA CIO' CHE HA DELLE PAROLE ───────────────
%
% Debito dichiarato in docs/plans/the-rational-philosopher.md §D.4: il
% contabile registrava la CANDIDATURA, non la resa. Una mossa scelta ma senza
% parole nella lingua del turno lasciava `dialogue_emitted` dietro di se': il
% turno dopo trovava una proposta aperta che nessuno aveva mai fatto, e
% «continua» proseguiva da un passo mai pronunciato — una falsa memoria, la
% specie peggiore perche' non si vede.
% La resa e' ora UN oggetto solo (`dialogue_reply_text/3`): chi parla e chi
% registra leggono la stessa cosa, quindi non possono divergere.
% ⚠ Resta aperto il pezzo che questo non chiude: le parole esistono, ma che il
% turno sia stato DETTO da questo circuito lo sa solo l'arbitrato, e il
% contabile corre prima della risposta. L'osservabile comune (`turn_done`) e'
% il passo successivo; questa riga toglie la falsa memoria da resa mancante,
% non quella da turno perso.
turn_bookkeeping($T, dialogue_propose) :-
    dialogue_candidate($T, $S, $Step, $M), dialogue_reply_text($T, $M, $Text),
    turn_counter($N), assert(dialogue_emitted, $N, $S, $Step), assert(dialogue_offered, $N, $M).

% Un solo consumatore delle letture: scelta, ancora, bisogno e lingua.
turn_plan_candidate($T) :- dialogue_now($T, $A, $P).
dialogue_reply_text($T, $M, $Text) :- dialogue_standalone($M), dialogue_reply_language($T, $L), dialogue_move_text($M, $L, $Text).
dialogue_reply_text($T, $M, $Text) :-
    naf(dialogue_standalone($M)), dif($M, explain_move),
    dialogue_topic($T, $Topic), dialogue_reply_language($T, $L), answer_text(dialogue_reply($Topic, $M, $L), $Base), dialogue_with_detail($T, $L, $Base, $Text).
dialogue_reply_text($T, explain_move, $Text) :- dialogue_reason_text($T, $Text).
turn_priority_response($T, $Text) :- dialogue_candidate($T, $S, $K, $M), dialogue_reply_text($T, $M, $Text).
answer_content(dialogue_reply($Topic, $M, $L), 0, opening, $Text) :- dialogue_anchor_open($L, $Text).
answer_content(dialogue_reply($Topic, $M, $L), 1, anchor, $Topic).
answer_content(dialogue_reply($Topic, $M, $L), 2, separator, $Text) :- dialogue_anchor_close($L, $Text).
answer_content(dialogue_reply($Topic, $M, $L), 3, proposal, $Text) :- dialogue_move_text($M, $L, $Text).

% Ispezione condivisa: la mossa si giustifica sullo stesso oggetto che parla.
turn_reading_predicate(dialogue_seen).
turn_reading_predicate(dialogue_scope).
turn_reading_predicate(dialogue_emitted).
answer_frame("dialogue purpose", dialogue_move_need).

% La policy iniziale e' correggibile parlando. Una policy ambigua non sceglie
% per ordine di inserimento: resta visibile come gap, senza dire due mosse.
dialogue_has_first($Task) :- dialogue_first($Task, $Move).
dialogue_first_conflict($Task, $Move) :- dialogue_first($Task, $Other), dif($Move, $Other).

% 21 settembre 2026 (T1 di `train-the-learning-process.md`) — UNA POLICY
% INUSABILE NON CANCELLA IL COMPORTAMENTO DI BASE.
%
% Misurato: insegnando la SOLA policy «quando guidi apprendimento inizia con
% partenza concreta», senza aver prima detto che cosa quella mossa affronta e
% che cosa deve dire, la lezione veniva ACCETTATA e il turno successivo
% crollava in «Non capisco ancora.» — dove prima rispondeva con la mossa di
% base. Una lezione confermata che PEGGIORA il comportamento e' peggio di un
% muro: il maestro crede di aver insegnato, e ha rotto.
%
% La causa era una guardia troppo larga: il ramo di base si spegneva appena
% ESISTEVA una policy, anche quando quella policy non era usabile. Una mossa e'
% usabile quando si sa che cosa affronta e che cosa dire nella lingua del
% turno; finche' manca uno dei due, il piano di base resta in piedi e la
% lezione incompleta non toglie nulla.
machinery(dialogue_move_usable).
machinery(dialogue_usable_first).
dialogue_move_usable($Move) :-
    dialogue_move_need($Move, $Need),
    current_language($L), dialogue_move_text($Move, $L, $Text).
dialogue_usable_first($Task) :-
    dialogue_first($Task, $Move), dialogue_move_usable($Move).

dialogue_initial($Task, $Move) :-
    dialogue_first($Task, $Move), naf(dialogue_first_conflict($Task, $Move)),
    dialogue_move_usable($Move).
dialogue_initial($Task, $Move) :-
    naf(dialogue_usable_first($Task)), dialogue_step($Task, 1, $Move).

% Un vincolo cambia il passo in corso: non significa averlo eseguito.
dialogue_candidate($T, $S, $K, $Move) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, update), dialogue_previous_open($S, $K),
    dialogue_update_move($A, $Move).
dialogue_candidate($T, $N, closed, ask_anchor) :-
    dialogue_now($T, $A, $P), dialogue_uptake($A, update), naf(dialogue_has_previous), turn_counter($N).
bookkeeper(dialogue_detail).
turn_bookkeeping($T, dialogue_detail) :-
    dialogue_now($T, $A, $P), dialogue_detail_role($A, $Role), dialogue_previous_open($S, $K),
    turn_counter($N), assert(dialogue_detail, $S, $Role, said($N, $P)).
dialogue_has_current_detail($T) :- dialogue_now($T, $A, $P), dialogue_detail_role($A, $R), dialogue_has_previous.
dialogue_with_detail($T, $L, $Base, $Text) :-
    dialogue_now($T, $A, $P), dialogue_detail_role($A, $Role), dialogue_has_previous,
    dialogue_detail_open($L, $Open), dialogue_detail_close($L, $Close),
    concat_atoms($Open, $P, $Head), concat_atoms($Head, $Close, $Prefix), concat_atoms($Prefix, $Base, $Text).
dialogue_with_detail($T, $L, $Text, $Text) :- naf(dialogue_has_current_detail($T)).

% La ragione della proposta legge la mossa effettivamente emessa, anche se
% modificata da una lezione. Non usa un testo identico per tutte le mosse.
dialogue_previous_move($M) :- turn_counter($N), is($K, sub($N, 1)), dialogue_offered($K, $M).
dialogue_reason_text($T, $Text) :-
    dialogue_now($T, explain, $P), dialogue_previous_open($S, $K), dialogue_previous_move($M),
    dialogue_move_need($M, $Need), current_language($L), dialogue_need_words($Need, $L, $Words),
    dialogue_reason_open($L, $Open), dialogue_reason_close($L, $Close),
    concat_atoms($Open, $Words, $Head), concat_atoms($Head, $Close, $Text).
turn_priority_response($T, $Text) :- dialogue_reason_text($T, $Text).

% 21 settembre 2026 (T4 di `train-the-learning-process.md`) — LA LINGUA DI UNO
% SCAMBIO APERTO E' QUELLA DELL'ANCORA.
%
% Misurato: «sono indeciso tra leggere e passeggiare» apre in italiano, e il
% seguito «per me conta riposare» riceve «You added: riposare. On leggere e
% passeggiare: Use this criterion…». Quattro parole corte e ambigue bastano a
% far osservare la lingua sbagliata, e la resa seguiva l'osservazione del
% turno invece della conversazione in corso.
%
% La leva esisteva gia' e nessuno la leggeva: `dialogue_language(N, L)` e'
% scritta a ogni turno dal libro mastro. Finche' uno scambio e' aperto, la
% resa legge QUELLA: la lingua e' una proprieta' della conversazione, non una
% scommessa su un turno di quattro parole.
%
% ⚠ Limite dichiarato: dentro uno scambio aperto un cambio di lingua non
% dichiarato non sposta la resa. E' il prezzo voluto — l'osservazione su un
% seguito corto e' inaffidabile per costruzione — e si paga finche' non
% esistera' un cambio di lingua ESPLICITO da nominare.
machinery(dialogue_reply_language).
dialogue_reply_language($T, $L) :- dialogue_previous_open($S, $K), dialogue_language($S, $L).
dialogue_reply_language($T, $L) :- naf(dialogue_has_previous), current_language($L).
