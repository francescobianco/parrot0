% input-structure.p0 — viste KB sulla gerarchia osservata dell'input (gen438).
%
% Il producer misura soltanto struttura e byte:
%
%   input_node(Scope, Id, node(Level, Kind, Parent), range(Start, Len))
%   input_node_surface(Scope, Id, "Surface")
%   input_node_role(Scope, Id, Role)
%
% Le viste seguenti rendono interrogabili le coordinate e conservano la catena
% Surface + Language -> Concept prima che la canonicalizzazione perda la forma.

:- file_attribute(machinery).

machinery(input_node_level).
machinery(input_node_kind).
machinery(input_node_parent).
machinery(input_node_range).
machinery(input_scope_language).
machinery(input_node_atom).
machinery(input_node_form).
machinery(input_node_has_form).
machinery(input_node_unresolved).
machinery(input_entity_node).
machinery(input_entity_between).
machinery(input_nearest_entity_before).
machinery(input_nearest_entity_after).
machinery(input_class_node).
machinery(input_unit_node).
machinery(input_operator_node).
machinery(input_coordination_node).
machinery(input_gap_node).
machinery(input_number_node).
machinery(node_order3).
machinery(node_order4).
machinery(input_node_before).
machinery(input_node_order3).
machinery(input_node_order4).
machinery(input_binary_assertion).
machinery(input_binary_object_coordination).
machinery(input_semantic_frame).
machinery(input_frame_gap).
machinery(input_frame_key).
machinery(input_frame_set).
machinery(input_frame_unique).
machinery(input_frame_observe).
machinery(input_frame_record).
machinery(input_clause_provenance).
machinery(input_assertion_key).
machinery(input_assertion_set).
machinery(input_assertion_unique).
machinery(input_assertion_coordinated).
machinery(input_assertion_bundle).
machinery(input_assertion_ambiguous).
machinery(input_assertion_store).
machinery(input_frame_commit).
machinery(proposition_source).
machinery(proposition_source_record).
machinery(input_proposition_binding).
machinery(semantic_binding).
machinery(input_frame_reading).
machinery(input_frame_reading_key).
machinery(input_frame_reading_set).
machinery(input_frame_reading_unique).
machinery(input_reading_values).
machinery(input_frame_reading_many).
machinery(input_answer_surface_key).
machinery(input_answer_surface_set).
machinery(input_answer_surface_unique).
machinery(input_answer_surface_list).
machinery(input_answer_list_text).

input_node_level($Scope, $Id, $Level) :-
    input_node($Scope, $Id, node($Level, $Kind, $Parent), $Range).
input_node_kind($Scope, $Id, $Kind) :-
    input_node($Scope, $Id, node($Level, $Kind, $Parent), $Range).
input_node_parent($Scope, $Id, $Parent) :-
    input_node($Scope, $Id, node($Level, $Kind, $Parent), $Range).
input_node_range($Scope, $Id, $Start, $Length) :-
    input_node($Scope, $Id, $Node, range($Start, $Length)).

% Turno e prosa passano dallo stesso osservatore n-lingue, ma restano scope
% separati. Una fonte puo' quindi avere una lingua diversa dalla richiesta che
% l'ha fatta leggere senza perdere nessuna delle due coordinate.
% E0b, 19 settembre 2026: la lingua che la KB ha scelto per lo scope quando il
% produttore l'ha osservata (`turn_language_observed/2`, registrata dal C senza
% deciderla). Senza quell'osservazione si deriva come prima.
machinery(turn_language_observed).
machinery(scope_language_observed).
input_scope_language($Scope, $Language) :-
    turn_language_observed($Scope, $Language).
input_scope_language($Scope, $Language) :-
    naf(scope_language_observed($Scope)),
    turn_language_selected($Scope, $Language).
scope_language_observed($Scope) :- turn_language_observed($Scope, $Language).

input_node_atom($Scope, $Id, $Surface) :-
    input_node($Scope, $Id, node(token, token, $Parent), $Range),
    input_node_surface($Scope, $Id, $Quoted),
    span_atom($Quoted, $Surface).

input_node_form($Scope, $Id, $Language, form($Surface, $Concept)) :-
    input_node_atom($Scope, $Id, $Surface),
    input_scope_language($Scope, $Language),
    linguistic_form($Surface, $Concept, $Language, $Register).

input_node_has_form($Scope, $Id, $Language) :-
    input_node_form($Scope, $Id, $Language, $Form).

input_node_unresolved($Scope, $Id, form($Language, $Surface)) :-
    input_node_atom($Scope, $Id, $Surface),
    input_scope_language($Scope, $Language),
    naf(input_node_has_form($Scope, $Id, $Language)).

% Le locuzioni sono nodi di span, non token speciali. La forma e' una relazione
% KB a quattro coordinate (superficie, concetto, lingua, registro), quindi una
% lingua nuova o un'entita' multiword si insegna senza toccare il producer C.
input_node_phrase_form($Scope, $Id, $Language, form($Quoted, $Concept)) :-
    input_node($Scope, $Id, node(phrase, $Kind, $Parent), $Range),
    input_node_surface($Scope, $Id, $Quoted),
    phrase_form($Quoted, $Concept, $Language, $Register).

input_node_form($Scope, $Id, $Language, form($Surface, $Concept)) :-
    input_node_phrase_form($Scope, $Id, $Language, form($Surface, $Concept)).

% ── MATCHER COMPOSITIVO MINIMO M1–M4 ──────────────────────────────────────
%
% Le categorie, le forme e gli ordini ammessi sono fatti aperti. Le regole
% sottostanti conoscono soltanto ruoli e relazioni d'ordine fra node id: un
% idioma che condivide un ordine noto cresce aggiungendo frame_pattern/4 e
% forme, senza un recognizer C. Le locuzioni e l'induzione degli ordini restano
% il lavoro M5/gen439.

input_entity_node($Scope, $Language, $Id, $Entity) :-
    input_node_form($Scope, $Id, $Language, form($Surface, $Entity)),
    semantic_entity($Entity), naf(input_token_in_phrase($Scope, $Id)).
input_entity_node($Scope, $Language, $Id, $Entity) :-
    input_node($Scope, $Id, node(phrase, $Kind, $Parent), $Range),
    input_node_surface($Scope, $Id, $Quoted),
    phrase_form($Quoted, $Entity, $Language, $Register).

% E2a, 19 settembre 2026 — UN SINTAGMA NOMINALE NUOVO E' UN CANDIDATO RUOLO, E
% ANCHE IL NOME NUDO. I frame legavano i ruoli solo a entita' gia' note: su prosa
% nuova la IR non vedeva ruoli e leggeva soltanto lo schema di stringa (specie B).
% Il sintagma candidato e' gia' delimitato dalla KB (np_opener … np_closer); il
% suo nome si costruisce dai TOKEN dentro lo span (pubblicati in minuscolo),
% senza l'articolo che lo apre. Un token e' candidato quando nessun sintagma lo
% contiene (vince lo span massimo, anche su un'entita' nota) e quando non
% appartiene a nessuna classe funzionale che la KB gia' conosce.
machinery(np_phrase_words).
machinery(token_in_span).
machinery(np_words_entity).
machinery(bare_noun_candidate).
machinery(input_token_in_phrase).
machinery(word_is_verb_form).
machinery(word_is_number).
input_entity_node($Scope, $Language, $Id, $Entity) :-
    input_node($Scope, $Id, node(phrase, np_candidate, $Parent), $Range),
    np_phrase_words($Scope, $Id, $Ws),
    np_words_entity($Ws, $Entity).
input_entity_node($Scope, $Language, $Id, $Word) :-
    input_node_atom($Scope, $Id, $Word),
    naf(input_token_in_phrase($Scope, $Id)),
    bare_noun_candidate($Word),
    naf(bare_noun_neighbour_before($Scope, $Id)), naf(bare_noun_neighbour_after($Scope, $Id)).
% E la SEQUENZA senza articolo: parole piene consecutive, fuori da ogni
% sintagma con articolo, sono UN'entita' con il nome di tutte («coral polyps»,
% «ancient times», «hard carbonate exoskeletons»). Il nodo che la porta e' il
% suo primo token; le sue parole sono parti dell'entita', non parole non lette.
machinery(bare_token).
machinery(bare_run).
machinery(bare_run_start).
bare_token($Scope, $Id, $W) :-
    input_node_atom($Scope, $Id, $W),
    naf(input_token_in_phrase($Scope, $Id)), bare_noun_candidate($W).
bare_run_start($Scope, $Id) :-
    bare_token($Scope, $Id, $W), naf(bare_noun_neighbour_before($Scope, $Id)).
bare_noun_neighbour_before($Scope, $Id) :-
    input_node_next($Scope, $P, $Id), tokens_contiguous($Scope, $P, $Id), bare_token($Scope, $P, $W).
bare_run($Scope, $Id, cons($W, $R)) :-
    bare_token($Scope, $Id, $W), input_node_next($Scope, $Id, $N),
    tokens_contiguous($Scope, $Id, $N), bare_token($Scope, $N, $W2), bare_run($Scope, $N, $R).
bare_run($Scope, $Id, cons($W, nil)) :-
    bare_token($Scope, $Id, $W), naf(bare_noun_neighbour_after($Scope, $Id)).
bare_noun_neighbour_after($Scope, $Id) :-
    input_node_next($Scope, $Id, $N), tokens_contiguous($Scope, $Id, $N), bare_token($Scope, $N, $W).
% Una sequenza lega soltanto token separati da UNO spazio: gli offset conservano
% la punteggiatura che i token perdono. «spans ancient times, rooted in …» non
% e' una sequenza «ancient times rooted» (r340, 19 settembre).
machinery(tokens_contiguous).
tokens_contiguous($Scope, $A, $B) :-
    input_node_range($Scope, $A, $SA, $LA), input_node_range($Scope, $B, $SB, $LB),
    is($SB, add($SA, add($LA, 1))).
input_entity_node($Scope, $Language, $Id, $Entity) :-
    bare_run_start($Scope, $Id),
    bare_run($Scope, $Id, cons($A, cons($B, $R))),
    words_underscored(cons($A, cons($B, $R)), $Entity).
% Un nome nudo vale solo ISOLATO (la sequenza e' la clausola sopra). «Corals secrete hard carbonate exoskeletons»:
% tre parole piene senza articolo sono UN sintagma, e spezzarle faceva leggere
% l'oggetto «hard» (piolo r300: «what do corals secrete?» → «hard.», perso).
% Finche' manca il lettore dello span senza articolo, la IR tace su quella
% sequenza invece di sbagliarla.
machinery(bare_noun_neighbour).
bare_noun_neighbour($Scope, $Id) :-
    input_node_next($Scope, $Id, $N), input_node_atom($Scope, $N, $W),
    naf(input_token_in_phrase($Scope, $N)), bare_noun_candidate($W).
bare_noun_neighbour($Scope, $Id) :-
    input_node_next($Scope, $P, $Id), input_node_atom($Scope, $P, $W),
    naf(input_token_in_phrase($Scope, $P)), bare_noun_candidate($W).
np_phrase_words($Scope, $Id, $Ws) :-
    input_node($Scope, $Id, node(phrase, np_candidate, $Parent), range($PS, $PL)),
    is($PE, add($PS, $PL)),
    findall($W, token_in_span($Scope, $PS, $PE, $W), $Ws).
token_in_span($Scope, $PS, $PE, $W) :-
    input_node($Scope, $T, node(token, token, $TP), range($TS, $TL)),
    naf(lt($TS, $PS)), lt($TS, $PE), input_node_atom($Scope, $T, $W).
np_words_entity(cons($Opener, cons($W, $Rest)), $Entity) :-
    np_opener($Opener), words_underscored(cons($W, $Rest), $Entity).
input_token_in_phrase($Scope, $Id) :-
    input_node($Scope, $Id, node(token, token, $TP), $TR),
    input_node_range($Scope, $Id, $Start, $Len),
    input_node($Scope, $P, node(phrase, np_candidate, $Parent), range($PS, $PL)),
    is($PE, add($PS, $PL)), naf(lt($Start, $PS)), lt($Start, $PE).
bare_noun_candidate($W) :-
    naf(word_is_function_word($W)), naf(preposition($W)), naf(trailing_subordinator($W)),
    naf(word_is_gerund($W)),
    naf(word_is_verb_form($W)), naf(word_is_number($W)).
% Le classi funzionali sono quelle che la KB dichiara (`function_word_class/1`):
% una classe nuova vale anche qui senza toccare la regola. «yet» (una
% congiunzione) era diventato un nome e rispondeva a «what do coral reefs provide
% a home for?» (r300). `np_closer` si salta perche' e' la classe piu' cara da
% provare parola per parola, e i suoi membri funzionali (preposizioni,
% congiunzioni) stanno gia' nelle altre.
machinery(word_is_function_word).
word_is_function_word($W) :-
    function_word_class($C), dif($C, np_closer), apply($C, cons($W, nil)).
% `naf` non lega variabili libere: le domande con un argomento incognito passano
% da un ausiliario ground.
word_is_verb_form($W) :- verb_reading_form($Root, $W).
word_is_number($W) :- is($N, add($W, 0)).
machinery(word_is_gerund).
word_is_gerund($W) :- gerund_root($W, $Root).

% Un ruolo non si lega a un nome qualunque che cada dalla parte giusta del
% verbo. Si lega al nodo semantico piu' vicino. Questo elimina il prodotto
% cartesiano che trasformava `A R B and C` in due letture concorrenti prima
% ancora che la coordinazione potesse spiegare perche' B e C sono entrambi
% filler legittimi.
input_entity_between($Scope, $Language, interval($Left, $Right)) :-
    input_entity_node($Scope, $Language, $Middle, $Entity),
    input_node_before($Scope, $Left, $Middle),
    input_node_before($Scope, $Middle, $Right).

% E2a, 19 settembre 2026 — LA VICINANZA SI CALCOLA SU UNA LISTA. La versione di
% prima negava `input_entity_between/3` per ogni candidato, e ogni negazione
% rienumerava tutte le entita' della clausola: quadratico nel numero di
% candidati, e ogni candidato e' a sua volta una prova. Appena la IR ha
% riconosciuto piu' candidati (sintagmi e nomi nuovi) il turno di un paragrafo
% e' passato da 1,7 a 11 s solo qui. La lista si raccoglie una volta per
% domanda (`input_entity_item/3` costruisce il termine nella testa: `findall`
% raccoglie solo template variabili) e l'«in mezzo» si nega su `member`. Stessa
% relazione: ordine per offset d'inizio, come `input_node_before/3`.
% `input_entity_between/3` resta per chi la interroga.
machinery(input_entity_item).
machinery(input_clause_entities).
machinery(entity_item_between).
input_entity_item($Scope, $Language, ent($Start, $Id, $Entity)) :-
    input_entity_node($Scope, $Language, $Id, $Entity),
    input_node_range($Scope, $Id, $Start, $Len).
input_clause_entities($Scope, $Language, $Items) :-
    input_entities_observed($Scope, $Language),
    findall($Item, input_entity_cached($Scope, $Language, $Item), $Items).
input_clause_entities($Scope, $Language, $Items) :-
    naf(input_entities_observed($Scope, $Language)),
    findall($Item, input_entity_item($Scope, $Language, $Item), $Items).
% (19 settembre 2026: le entita' di una clausola si chiedono UNA volta, subito
% dopo la pubblicazione del turno; il C registra le risposte come
% `input_entity_cached/3` + `input_entities_observed/2` e le ritira alla
% pubblicazione successiva. Rivalutarle a ogni domanda di vicinanza costava
% 5,5 s su un paragrafo.)
machinery(input_entity_cached).
machinery(input_entities_observed).
entity_item_between($Items, $Low, $High) :-
    member(ent($S, $I, $E), $Items), lt($Low, $S), lt($S, $High).

input_nearest_entity_before($Scope, $Language, $Anchor,
                            entity($Id, $Entity)) :-
    input_node_range($Scope, $Anchor, $AStart, $ALen),
    input_clause_entities($Scope, $Language, $Items),
    member(ent($Start, $Id, $Entity), $Items), lt($Start, $AStart),
    naf(entity_item_between($Items, $Start, $AStart)),
    input_node_range($Scope, $Id, $Start, $Len), is($End, add($Start, $Len)),
    naf(unread_word_between($Scope, $End, $AStart)).

input_nearest_entity_after($Scope, $Language, $Anchor,
                           entity($Id, $Entity)) :-
    input_node_range($Scope, $Anchor, $AStart, $ALen),
    input_clause_entities($Scope, $Language, $Items),
    member(ent($Start, $Id, $Entity), $Items), lt($AStart, $Start),
    naf(entity_item_between($Items, $AStart, $Start)),
    is($AEnd, add($AStart, $ALen)),
    naf(unread_word_between($Scope, $AEnd, $Start)).

% «Vicino» vuol dire che fra l'operatore e l'entita' ci sono solo parole
% funzionali. Se in mezzo c'e' una parola piena che la IR non ha letto come
% entita' («spans ANCIENT TIMES …, rooted in the abundance»), la vicinanza
% saltava fino alla prima entita' dopo e scriveva un legame falso (r340:
% «abundance.» al posto di un muro). La IR tace invece di saltare.
machinery(unread_word_between).
unread_word_between($Scope, $Low, $High) :-
    input_node($Scope, $T, node(token, token, $P), range($S, $L)),
    naf(lt($S, $Low)), lt($S, $High),
    input_node_atom($Scope, $T, $W), naf(bare_noun_candidate($W)),
    naf(word_is_function_word($W)).

input_class_node($Scope, $Language, $Id, $Class) :-
    input_node_form($Scope, $Id, $Language, form($Surface, $Class)),
    semantic_class($Class).

input_unit_node($Scope, $Language, $Id, $Unit) :-
    input_node_form($Scope, $Id, $Language, form($Surface, $Unit)),
    measurement_unit($Unit).

input_operator_node($Scope, $Language, operator($Kind, $Relation), $Id) :-
    input_node_form($Scope, $Id, $Language, form($Surface, $Relation)),
    frame_operator_concept($Relation, $Kind).

% La superficie della congiunzione resta una classe KB aperta. Il nodo conserva
% la lingua osservata nello scope; insegnare un nuovo membro a runtime attraverso
% `use X as a conjunction` abilita questa stessa composizione senza rebuild.
input_coordination_node($Scope, $Language, $Id, $Surface) :-
    input_scope_language($Scope, $Language),
    input_node_atom($Scope, $Id, $Surface),
    conjunction($Surface).

input_gap_node($Scope, $Language, $Role, $Id) :-
    input_node_atom($Scope, $Id, $Surface),
    frame_gap_form($Language, $Surface, $Role),
    naf(gap_after_preposition($Scope, $Id)).
% «IN what water do coral reefs grow best?»: il gap e' il complemento di una
% preposizione, non il soggetto ne' l'oggetto del verbo. Letto come ruolo dava
% «reefs.» (r300, 19 settembre). Le preposizioni sono quelle che chiudono un
% sintagma (`np_closer/1`).
machinery(gap_after_preposition).
gap_after_preposition($Scope, $Id) :-
    input_node_next($Scope, $P, $Id), input_node_atom($Scope, $P, $W), np_closer($W).

input_number_node($Scope, $Id, $Number) :-
    input_node_atom($Scope, $Id, $Surface),
    is($Number, add($Surface, 0)).

node_order3($A, $B, $C) :- lt($A, $B), lt($B, $C).
node_order4($A, $B, $C, $D) :-
    lt($A, $B), lt($B, $C), lt($C, $D).

% Gli ID riflettono l'ordine di pubblicazione, non l'ordine linguistico: un
% phrase node viene naturalmente aggiunto dopo i token che lo compongono. I
% frame ordinano quindi per offset di span, la sola coordinata meccanica stabile.
input_node_before($Scope, $A, $B) :-
    input_node_range($Scope, $A, $StartA, $LengthA),
    input_node_range($Scope, $B, $StartB, $LengthB),
    lt($StartA, $StartB).
input_node_order3($Scope, $A, $B, $C) :-
    input_node_before($Scope, $A, $B), input_node_before($Scope, $B, $C).
input_node_order4($Scope, order($A, $B, $C, $D)) :-
    input_node_before($Scope, $A, $B), input_node_before($Scope, $B, $C),
    input_node_before($Scope, $C, $D).

% Relazione binaria: prima si costruisce il frame locale attorno all'operatore;
% poi gli operatori compositivi possono distribuirne un ruolo. Asserzione e
% domanda continuano a condividere firma e ruoli.
input_binary_assertion($Scope, $Language, relation($Relation, $RId),
                       roles(entity($SId, $Subject),
                             entity($OId, $Object))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, binary, assertion, sro),
    input_operator_node($Scope, $Language, operator(binary, $Relation), $RId),
    input_nearest_entity_before($Scope, $Language, $RId,
                                entity($SId, $Subject)),
    input_nearest_entity_after($Scope, $Language, $RId,
                               entity($OId, $Object)).

input_binary_object_coordination(
    $Scope, $Language, relation($Relation, $RId),
    coordination(subject($SId, $Subject), first($O1Id, $Object1),
                 cue($CId), second($O2Id, $Object2))) :-
    input_binary_assertion(
        $Scope, $Language, relation($Relation, $RId),
        roles(entity($SId, $Subject), entity($O1Id, $Object1))),
    input_coordination_node($Scope, $Language, $CId, $Surface),
    input_entity_node($Scope, $Language, $O2Id, $Object2),
    input_node_before($Scope, $O1Id, $CId),
    input_node_before($Scope, $CId, $O2Id),
    dif($Object1, $Object2).

input_semantic_frame($Scope, assertion, binary($Relation),
                     roles(subject($Subject), object($Object))) :-
    input_binary_assertion(
        $Scope, $Language, relation($Relation, $RId),
        roles(entity($SId, $Subject), entity($OId, $Object))).

input_semantic_frame($Scope, assertion, binary($Relation),
                     roles(subject($Subject), object($Object2))) :-
    input_binary_object_coordination(
        $Scope, $Language, relation($Relation, $RId),
        coordination(subject($SId, $Subject), first($O1Id, $Object1),
                     cue($CId), second($O2Id, $Object2))).

input_semantic_frame($Scope, question, binary($Relation),
                     roles(subject($Subject), object(missing))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, binary, question, qsr),
    input_gap_node($Scope, $Language, object, $QId),
    input_operator_node($Scope, $Language, operator(binary, $Relation), $RId),
    input_nearest_entity_before($Scope, $Language, $RId,
                                entity($SId, $Subject)),
    input_node_order3($Scope, $QId, $SId, $RId).

input_semantic_frame($Scope, question, binary($Relation),
                     roles(subject($Subject), object(missing))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, binary, question, qrs),
    input_gap_node($Scope, $Language, object, $QId),
    input_operator_node($Scope, $Language, operator(binary, $Relation), $RId),
    input_nearest_entity_after($Scope, $Language, $RId,
                               entity($SId, $Subject)),
    input_node_order3($Scope, $QId, $RId, $SId).

% Misura: valore e unita' sono ruoli distinti, quindi "numero trovato" non puo'
% essere scambiato per "misura compresa".
input_semantic_frame($Scope, assertion, measure($Relation),
                     roles(subject($Subject), measure(value($Value), unit($Unit)))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, measure, assertion, srvu),
    input_operator_node($Scope, $Language, operator(measure, $Relation), $RId),
    input_nearest_entity_before($Scope, $Language, $RId,
                                entity($SId, $Subject)),
    input_number_node($Scope, $VId, $Value),
    input_unit_node($Scope, $Language, $UId, $Unit),
    input_node_order4($Scope, order($SId, $RId, $VId, $UId)).

input_semantic_frame($Scope, question, measure($Relation),
                     roles(subject($Subject), measure(value(missing), unit($Unit)))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, measure, question, qusr),
    input_gap_node($Scope, $Language, value, $QId),
    input_unit_node($Scope, $Language, $UId, $Unit),
    input_operator_node($Scope, $Language, operator(measure, $Relation), $RId),
    input_nearest_entity_before($Scope, $Language, $RId,
                                entity($SId, $Subject)),
    input_node_order4($Scope, order($QId, $UId, $SId, $RId)).

input_semantic_frame($Scope, question, measure($Relation),
                     roles(subject($Subject), measure(value(missing), unit($Unit)))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, measure, question, qurs),
    input_gap_node($Scope, $Language, value, $QId),
    input_unit_node($Scope, $Language, $UId, $Unit),
    input_operator_node($Scope, $Language, operator(measure, $Relation), $RId),
    input_nearest_entity_after($Scope, $Language, $RId,
                               entity($SId, $Subject)),
    input_node_order4($Scope, order($QId, $UId, $RId, $SId)).

% Appartenenza di classe. `membership(Relation)` mantiene esplicita la relazione
% canonica invece di assumere che ogni copula significhi automaticamente isa.
input_semantic_frame($Scope, assertion, membership($Relation),
                     roles(subject($Subject), class($Class))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, membership, assertion, src),
    input_operator_node($Scope, $Language, operator(membership, $Relation), $RId),
    input_nearest_entity_before($Scope, $Language, $RId,
                                entity($SId, $Subject)),
    input_class_node($Scope, $Language, $CId, $Class),
    input_node_order3($Scope, $SId, $RId, $CId).

input_semantic_frame($Scope, question, membership($Relation),
                     roles(subject($Subject), class(missing))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, membership, question, qrs),
    input_gap_node($Scope, $Language, class, $QId),
    input_operator_node($Scope, $Language, operator(membership, $Relation), $RId),
    input_nearest_entity_after($Scope, $Language, $RId,
                               entity($SId, $Subject)),
    input_node_order3($Scope, $QId, $RId, $SId).

input_semantic_frame($Scope, question, binary($Relation),
                     roles(subject(missing), object($Object))) :-
    input_scope_language($Scope, $Language),
    frame_pattern($Language, binary, question, qro),
    input_gap_node($Scope, $Language, subject, $QId),
    input_operator_node($Scope, $Language, operator(binary, $Relation), $RId),
    input_nearest_entity_after($Scope, $Language, $RId,
                               entity($OId, $Object)),
    input_node_order3($Scope, $QId, $RId, $OId),
    input_node_range($Scope, $QId, $QS, $QL), is($QE, add($QS, $QL)),
    input_node_range($Scope, $RId, $RS, $RL),
    naf(unread_word_between($Scope, $QE, $RS)).
% (Il gap e' il soggetto solo se fra lui e il verbo non c'e' un soggetto detto:
% «what do CORAL POLYPS form colonies of?» non chiede chi forma le colonie —
% letta cosi' rispondeva «reefs.», r300.)

input_frame_gap($Scope, binary($Relation), object) :-
    input_semantic_frame($Scope, question, binary($Relation),
                         roles(subject($Subject), object(missing))).
input_frame_gap($Scope, measure($Relation), value) :-
    input_semantic_frame($Scope, question, measure($Relation),
                         roles(subject($Subject), measure(value(missing), unit($Unit)))).
input_frame_gap($Scope, membership($Relation), class) :-
    input_semantic_frame($Scope, question, membership($Relation),
                         roles(subject($Subject), class(missing))).

% La risoluzione completa del frame e' deliberatamente eseguita una volta al
% confine di osservazione. Il record risultante e' ancora una struttura della
% KB, non una classificazione C: evita che ogni consumatore debba rieseguire
% tutta la catena lingua -> forma -> ruolo fino al limite di profondita' del
% solver, e rende esplicito quale lettura sia stata ammessa nel turno.
input_frame_key($Scope, observed($Mode, $Operator, $Roles)) :-
    input_semantic_frame($Scope, $Mode, $Operator, $Roles).
input_frame_set($Scope, $Frames) :-
    findall($Frame, input_frame_key($Scope, $Frame), $Frames).
input_frame_unique($Scope, observed($Mode, $Operator, $Roles)) :-
    input_frame_set($Scope, cons(observed($Mode, $Operator, $Roles), nil)).
input_frame_observe($Scope, observed($Mode, $Operator, $Roles)) :-
    input_frame_unique($Scope, observed($Mode, $Operator, $Roles)),
    assert(input_frame_record, $Scope, frame($Mode, $Operator), $Roles).

% ── DALLA PROSA ALLA CONOSCENZA, SENZA UN SECONDO ESTRATTORE ──────────────
%
% L'asserzione viene reificata esattamente nella forma che la domanda consuma.
% La commit e' autorizzata soltanto con un frame unico; una lettura concorrente
% resta un'ambiguita' e non produce conoscenza. Provenienza significa qui lingua
% osservata, superficie esatta della clausola e byte span locale. Una revisione
% Wikipedia sostituira' `inline` con il proprio indirizzo senza cambiare il
% contratto proposition_source/4.

input_clause_provenance($Scope,
                        provenance($Language, $Quoted, range($Start, $Length))) :-
    input_scope_language($Scope, $Language),
    input_node($Scope, 0, node(clause, clause, root), range($Start, $Length)),
    input_node_surface($Scope, 0, $Quoted).

input_assertion_key($Scope,
                    proposition(binary($Relation),
                                roles(subject($Subject), object($Object)))) :-
    input_semantic_frame($Scope, assertion, binary($Relation),
                         roles(subject($Subject), object($Object))).
input_assertion_key($Scope,
                    proposition(measure($Relation),
                                roles(subject($Subject),
                                      measure(value($Value), unit($Unit))))) :-
    input_semantic_frame($Scope, assertion, measure($Relation),
                         roles(subject($Subject),
                               measure(value($Value), unit($Unit)))).
input_assertion_key($Scope,
                    proposition(membership($Relation),
                                roles(subject($Subject), class($Class)))) :-
    input_semantic_frame($Scope, assertion, membership($Relation),
                         roles(subject($Subject), class($Class))).

input_assertion_set($Scope, $Assertions) :-
    findall($Assertion, input_assertion_key($Scope, $Assertion), $Assertions).
input_assertion_unique($Scope, $Assertion) :-
    input_assertion_set($Scope, cons($Assertion, nil)).

input_assertion_coordinated(
    $Scope,
    cons(proposition(binary($Relation),
                     roles(subject($Subject), object($Object1))),
         cons(proposition(binary($Relation),
                          roles(subject($Subject), object($Object2))), nil))) :-
    input_binary_object_coordination(
        $Scope, $Language, relation($Relation, $RId),
        coordination(subject($SId, $Subject), first($O1Id, $Object1),
                     cue($CId), second($O2Id, $Object2))).

% E2, 19 settembre 2026 — LA PARTICIPIALE HA IL SOGGETTO DELLA PRINCIPALE.
% «Reefs form ecosystems, displacing the sponge reefs»: chi soppianta sono i
% reef, non gli ecosistemi (lettura-della-prosa.md, contrasto del gerundio).
% La participiale comincia dopo una punteggiatura (gli offset la conservano) con
% un gerundio di un verbo di relazione; il soggetto e' la prima entita' della
% clausola, anche quando il verbo principale non e' una relazione («Coral reefs
% first appeared …, displacing …»); l'oggetto e' l'entita' vicina dopo il gerundio.
machinery(gerund_root).
machinery(gerund_stem_root).
machinery(input_participial_assertion).
machinery(clause_first_entity).
gerund_root($G, $Root) :- concat_atoms($S, "ing", $G), gerund_stem_root($S, $Root).
gerund_stem_root($S, $S) :- relation_verb($S).
gerund_stem_root($S, $R) :- concat_atoms($S, "e", $R), relation_verb($R).
clause_first_entity($Items, ent($S, $Id, $E)) :-
    member(ent($S, $Id, $E), $Items), naf(entity_item_before_start($Items, $S)).
entity_item_before_start($Items, $S) :- member(ent($S2, $I, $E), $Items), lt($S2, $S).
input_participial_assertion($Scope, $Language,
                            proposition(binary($Root), roles(subject($Subj), object($Obj)))) :-
    input_node_atom($Scope, $GId, $G), gerund_root($G, $Root),
    input_node_next($Scope, $P, $GId), naf(tokens_contiguous($Scope, $P, $GId)),
    input_node_range($Scope, $GId, $GS, $GL),
    input_clause_entities($Scope, $Language, $Items),
    clause_first_entity($Items, ent($SS, $SId, $Subj)), lt($SS, $GS),
    input_nearest_entity_after($Scope, $Language, $GId, entity($OId, $Obj)).
% Il bundle: la principale unica (se c'e') e la participiale.
input_assertion_bundle($Scope, cons($Main, cons($Part, nil))) :-
    input_assertion_unique($Scope, $Main),
    input_scope_language($Scope, $Language),
    input_participial_assertion($Scope, $Language, $Part).
input_assertion_bundle($Scope, cons($Part, nil)) :-
    input_assertion_set($Scope, nil),
    input_scope_language($Scope, $Language),
    input_participial_assertion($Scope, $Language, $Part).
input_recorded_bundle($Scope, cons(proposition($Operator, $Roles), cons($Part, nil))) :-
    input_frame_record($Scope, frame(assertion, $Operator), $Roles),
    input_scope_language($Scope, $Language),
    input_participial_assertion($Scope, $Language, $Part).
input_recorded_bundle($Scope, cons($Part, nil)) :-
    naf(input_frame_record_assertion($Scope)),
    input_scope_language($Scope, $Language),
    input_participial_assertion($Scope, $Language, $Part).
machinery(input_frame_record_assertion).
input_frame_record_assertion($Scope) :- input_frame_record($Scope, frame(assertion, $Op), $R).

% Il bundle di cio' che l'osservazione ha GIA' registrato: il frame unico del
% turno (`input_frame_record/3`) come asserzione, senza ricalcolare i frame. Per
% la prosa detta nel turno, dove l'osservazione avviene un istante prima del
% commit: ricalcolarli costava 6 s su un paragrafo (19 settembre 2026).
machinery(input_recorded_bundle).
input_recorded_bundle($Scope, cons(proposition($Operator, $Roles), nil)) :-
    input_frame_record($Scope, frame(assertion, $Operator), $Roles).

input_assertion_bundle($Scope, cons($Assertion, nil)) :-
    input_assertion_unique($Scope, $Assertion).
input_assertion_bundle($Scope, $Assertions) :-
    input_assertion_coordinated($Scope, $Assertions).

input_assertion_ambiguous($Scope) :-
    input_assertion_set($Scope, cons($First, cons($Second, $Tail))),
    naf(input_assertion_coordinated(
        $Scope, cons($First, cons($Second, $Tail)))).

% Proiezione relazionale della stessa IR. `semantic_proposition/1` conserva la
% forma completa e la provenienza; semantic_binding/3 offre al solver un indice
% poco profondo, senza re-interpretare la frase e senza perdere l'operatore.
input_proposition_binding(
    proposition(binary($Relation),
                roles(subject($Subject), object($Object))),
    binary($Relation), $Subject, object($Object)).
input_proposition_binding(
    proposition(measure($Relation),
                roles(subject($Subject),
                      measure(value($Value), unit($Unit)))),
    measure($Relation), $Subject, measure($Value, $Unit)).
input_proposition_binding(
    proposition(membership($Relation),
                roles(subject($Subject), class($Class))),
    membership($Relation), $Subject, class($Class)).

input_assertion_store(nil, $Language, $Quoted, $Range).
input_assertion_store(cons($Proposition, $Tail), $Language, $Quoted,
                      range($Start, $Length)) :-
    input_proposition_binding($Proposition, $Operator, $Subject, $Filler),
    assert(semantic_proposition, $Proposition),
    assert(semantic_binding, $Operator, $Subject, $Filler),
    assert(proposition_source_record, $Proposition, source(inline, $Quoted),
           provenance(language($Language), range($Start, $Length))),
    assert(reading_fact, $Proposition, $Quoted),
    input_assertion_store($Tail, $Language, $Quoted, range($Start, $Length)).

% Il bundle viene osservato una volta al confine e ripassato come termine opaco
% dal producer. Evita di rieseguire l'intera catena forma -> frame mentre si
% scrivono le proposizioni, senza spostare nel C alcuna scelta semantica.
input_frame_commit($Scope, $Assertions, $Count) :-
    count_list($Assertions, $Count),
    input_clause_provenance($Scope,
                            provenance($Language, $Quoted,
                                       range($Start, $Length))),
    input_assertion_store($Assertions, $Language, $Quoted,
                          range($Start, $Length)).

% Il builtin assert/1 conserva il limite meccanico KB_MAX_ARGS: nome del
% predicato piu' al massimo tre argomenti. La provenienza e' quindi registrata
% in un record reificato a tre argomenti e proiettata nella vista pubblica a
% quattro coordinate; nessuna coordinata informativa viene persa.
proposition_source($Proposition, $Source, $Language, $Range) :-
    proposition_source_record($Proposition, $Source,
                              provenance($Language, $Range)).

% La domanda non viene tradotta in un altro formato: completa il proprio ruolo
% `missing` contro la proposizione reificata. Questo e' il ponte effettivo fra
% lettura e dialogo e funziona anche quando le due lingue non coincidono.
input_frame_reading($Scope, binary($Relation), subject, $Subject) :-
    input_frame_record($Scope, frame(question, binary($Relation)),
                       roles(subject(missing), object($Object))),
    semantic_binding(binary($Relation), $Subject, object($Object)).
input_frame_reading($Scope, binary($Relation), object, $Object) :-
    input_frame_record($Scope, frame(question, binary($Relation)),
                       roles(subject($Subject), object(missing))),
    semantic_binding(binary($Relation), $Subject, object($Object)).
input_frame_reading($Scope, measure($Relation), value,
                    measure($Value, $Unit)) :-
    input_frame_record($Scope, frame(question, measure($Relation)),
                       roles(subject($Subject),
                             measure(value(missing), unit($Unit)))),
    semantic_binding(measure($Relation), $Subject,
                     measure($Value, $Unit)).
input_frame_reading($Scope, membership($Relation), class, $Class) :-
    input_frame_record($Scope, frame(question, membership($Relation)),
                       roles(subject($Subject), class(missing))),
    semantic_binding(membership($Relation), $Subject, class($Class)).

% E5 (specie A), 19 settembre 2026 — LA DOMANDA LETTA RISPONDE DALLA LETTURA.
% `input_frame_reading_unique/4` c'era ma nessuno la consumava: la strada «la IR
% della domanda + il legame semantico impegnato dalla IR del testo» era morta,
% e rispondeva sempre il frasario (`answerframe`, specie B). Qui prende la
% parola, per la porta KB `turn_response/2`, soltanto quando la lettura e'
% UNICA; il valore si dice con le sue parole.
machinery(ir_reading_answer).
% E LA LETTURA TACE dove la domanda chiede piu' di quanto il frame legge
% (19 settembre 2026, r300): «what PHYLUM does coral belong to?» riceveva la
% classe (il qualificatore dopo il gap e' un tipo di risposta), «what do coral
% polyps form COLONIES …?» riceveva «reefs» (la coda dopo il verbo e' un pezzo di
% domanda che il frame binario non vede). Parola piena = non funzionale e non
% forma di verbo; allora risponde il percorso di prima.
machinery(ir_question_qualified).
machinery(ir_question_tail).
ir_question_qualified($Turn) :-
    input_scope_language($Turn, $Language), input_gap_node($Turn, $Language, $Role, $Q),
    input_node_next($Turn, $Q, $N), input_node_atom($Turn, $N, $W),
    naf(word_is_function_word($W)), naf(word_is_verb_form($W)).
ir_question_tail($Turn, object) :-
    input_scope_language($Turn, $Language),
    input_operator_node($Turn, $Language, operator(binary, $R), $RId),
    input_node_range($Turn, $RId, $S, $Len), is($E, add($S, $Len)),
    unread_word_between($Turn, $E, 1000000).
ir_question_tail($Turn, subject) :-
    input_scope_language($Turn, $Language),
    input_operator_node($Turn, $Language, operator(binary, $R), $RId),
    input_nearest_entity_after($Turn, $Language, $RId, entity($OId, $O)),
    input_node_range($Turn, $OId, $S, $Len), is($E, add($S, $Len)),
    unread_word_between($Turn, $E, 1000000).
turn_response($Turn, $Text) :- ir_reading_answer($Turn, $Text).
ir_reading_answer($Turn, $Text) :-
    input_frame_reading_unique($Turn, binary($Relation), $Role, $Value),
    naf(ir_question_qualified($Turn)), naf(ir_question_tail($Turn, $Role)),
    atom_words($Value, $Ws), words_join($Ws, $Name), upcase_first($Name, $Cap),
    concat_atoms($Cap, ".", $Text).

input_frame_reading_key($Scope, reading($Operator, $Role, $Value)) :-
    input_frame_reading($Scope, $Operator, $Role, $Value).
input_frame_reading_set($Scope, $Readings) :-
    findall($Reading, input_frame_reading_key($Scope, $Reading), $Readings).
input_frame_reading_unique($Scope, $Operator, $Role, $Value) :-
    input_frame_reading_set($Scope,
                            cons(reading($Operator, $Role, $Value), nil)).

input_reading_values(nil, $Operator, $Role, nil).
input_reading_values(cons(reading($Operator, $Role, $Value), $Tail),
                     $Operator, $Role, cons($Value, $Values)) :-
    input_reading_values($Tail, $Operator, $Role, $Values).

input_frame_reading_many($Scope, $Operator, $Role, $Values) :-
    input_frame_reading_set(
        $Scope,
        cons(reading($Operator, $Role, $First),
             cons(reading($Operator, $Role, $Second), $Tail))),
    input_reading_values(
        cons(reading($Operator, $Role, $First),
             cons(reading($Operator, $Role, $Second), $Tail)),
        $Operator, $Role, $Values).

% Anche la realizzazione rifiuta una scelta arbitraria fra sinonimi di pari
% stato. Il registro/default della lingua determina i candidati; soltanto un
% insieme singleton autorizza la risposta.
input_answer_surface_key($Language, $Value, $Surface) :-
    lexical_output($Value, $Language, $Surface).
input_answer_surface_set($Language, $Value, $Surfaces) :-
    findall($Surface, input_answer_surface_key($Language, $Value, $Surface),
            $Surfaces).
input_answer_surface_unique($Language, $Value, $Surface) :-
    input_answer_surface_set($Language, $Value, cons($Surface, nil)).

input_answer_surface_list($Language, nil, nil).
input_answer_surface_list($Language, cons($Value, $Tail),
                          cons($Surface, $Surfaces)) :-
    input_answer_surface_unique($Language, $Value, $Surface),
    input_answer_surface_list($Language, $Tail, $Surfaces).

input_answer_list_text($Language, cons($First, cons($Second, nil)), $Text) :-
    list_final_joiner($Language, $Joiner),
    concat_atoms($First, " ", $FirstSpace),
    concat_atoms($FirstSpace, $Joiner, $FirstJoiner),
    concat_atoms($FirstJoiner, " ", $Prefix),
    concat_atoms($Prefix, $Second, $Text).
input_answer_list_text($Language, cons($First, cons($Second, $Tail)), $Text) :-
    list_separator($Language, $Separator),
    concat_atoms($First, $Separator, $Prefix),
    input_answer_list_text($Language, cons($Second, $Tail), $Rest),
    concat_atoms($Prefix, $Rest, $Text).

turn_plan_candidate($Turn) :-
    input_frame_reading_unique($Turn, $Operator, $Role, $Value).
turn_plan_candidate($Turn) :-
    input_frame_reading_many($Turn, $Operator, $Role, $Values).
turn_response($Turn, $Text) :-
    input_frame_reading_unique($Turn, $Operator, $Role, $Value),
    turn_language($Turn, output, $Language),
    input_answer_surface_unique($Language, $Value, $Surface),
    value_statement($Language, $Surface, $Text).
turn_response($Turn, $Text) :-
    input_frame_reading_many($Turn, $Operator, $Role, $Values),
    turn_language($Turn, output, $Language),
    input_answer_surface_list($Language, $Values, $Surfaces),
    input_answer_list_text($Language, $Surfaces, $Surface),
    value_statement($Language, $Surface, $Text).
