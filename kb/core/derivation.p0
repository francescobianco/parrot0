% derivation.p0 — la prova prodotta dalla ricerca che decide (M2, 20 settembre 2026)
%
% docs/plans/lettura-della-prosa.md, HANDOFF «contenuti, atti e giudizi»: il
% caso Zelvo mostrava che una prova riferita da un secondo risolutore era la
% PRIMA trovata, e che aggiungere conoscenza vera cambiava il verdetto. Ora la
% prova e' un prodotto di `solve` stesso, esposta con una porta sola
% (src/kb.c, derivation_door):
%
%   kb_derivation(D, Goal, 0, N)      una derivazione di Goal con N dipendenze
%   kb_derivation(D, Goal, I, Dip)    la I-esima dipendenza, I in 1..N
%
% Con D libera e Goal legato si cerca nella stessa ricerca: ogni soluzione del
% backtracking e' una derivazione ALTERNATIVA (l'OR), le sue dipendenze sono
% congiunte (l'AND). Una dipendenza e' `content(Pred, impronta)` — una clausola
% usata, la stessa identita' di kb_clause/4 —, `absent(G)` — una negazione per
% fallimento: la prova dipende dall'ASSENZA di G in questa KB — oppure
% `aggregate(G)` — un findall: dipende dall'insieme delle soluzioni di G.
% `incomplete(N)` al posto di N dichiara che i passi hanno superato la pila.
% `derivation_<n>` vale nella sessione e non si salva.
%
% Qui stanno le facce NOMINABILI: che cosa una derivazione e' e da che cosa
% dipende. Che cosa sia AMMESSO in un contesto e' il lavoro di M3.

derivation_of($Goal, $D) :- kb_derivation($D, $Goal, 0, $N).
derivation_dependency_count($D, $N) :- kb_derivation($D, $Goal, 0, $N).
derivation_depends_on($D, $Dip) :- kb_derivation($D, $Goal, $I, $Dip), dif($I, 0).

% Le tre specie di dipendenza, ciascuna dicibile per quello che e'.
derivation_uses_clause($D, $Id) :-
    derivation_depends_on($D, $Id), kb_clause($Id, $Head, 0, $C).
derivation_needs_absent($D, $G) :- derivation_depends_on($D, absent($G)).
derivation_needs_aggregate($D, $G) :- derivation_depends_on($D, aggregate($G)).
derivation_uses_rule($D, $Id) :-
    derivation_depends_on($D, $Id), kb_clause($Id, $Head, 0, $N), dif($N, 0).
derivation_uses_fact($D, $Id) :- derivation_depends_on($D, $Id), kb_clause($Id, $Head, 0, 0).

% Una derivazione che ha perso passi non e' una derivazione piu' corta.
derivation_incomplete($D) :- kb_derivation($D, $Goal, 0, incomplete($N)).
derivation_complete($D) :- kb_derivation($D, $Goal, 0, $N), naf(derivation_incomplete($D)).

% Un goal ha piu' di una via: due derivazioni distinte dello stesso goal.
derivation_alternative($Goal, $D1, $D2) :-
    kb_derivation($D1, $Goal, 0, $N1), kb_derivation($D2, $Goal, 0, $N2), dif($D1, $D2).

% La prova nomina il predicato su cui poggia: e' l'identita' a dirlo.
derivation_rests_on($D, $Pred) :- derivation_depends_on($D, content($Pred, $Print)).

% Una prova puo' poggiare su un fatto CONGELATO da una vista: non e' un assioma
% in piu', e' conoscenza vecchia in forma veloce. L'atto lo dice, e la prova
% puo' dirlo di se' — senza che il motore debba nasconderlo o fingerlo.
derivation_rests_on_cache($D) :-
    derivation_depends_on($D, $Id), content_act($Id, derived).
% Un insieme troncato non e' un insieme piu' piccolo: la dipendenza lo dichiara.
derivation_needs_cut_aggregate($D, $G) :-
    derivation_depends_on($D, aggregate_incomplete($G)).

% ─── Quali sostegni VALGONO per questa richiesta (M3, primo passo) ───────────
%
% docs/plans/lettura-della-prosa.md §8: «Non limitarsi a spostare
% `from_premises ? Yes : No` in una tabella: la prova scelta sarebbe ancora
% sbagliata». Il difetto del caso Zelvo non e' il verdetto, e' che si
% giudicava la PRIMA prova trovata invece di cercarne una AMMISSIBILE. Con
% kb_derivation le alternative arrivano col backtracking, quindi la domanda
% giusta si scrive come conoscenza e non come un ramo del motore:
%
%   esiste una derivazione di Goal le cui dipendenze sono tutte ammesse?
%
% Nessun flag globale, nessuna vista ristretta: il mondo resta interrogabile e
% la differenza la fa il SOSTEGNO (mantra #25, one-kb.md §5b).

% Una dipendenza e' fra le premesse del turno se il suo contenuto e' entrato
% ANCHE come supposizione. Un contenuto che il mondo gia' sapeva e che il turno
% ha supposto ha due atti: conta come premessa, perche' la premessa e' stata
% davvero posta.
dependency_supposed($Dep) :- content_act($Dep, hypothetical).

derivation_outside_premises($D) :-
    derivation_depends_on($D, $Dep), naf(dependency_supposed($Dep)).
derivation_only_from_premises($D) :- naf(derivation_outside_premises($D)).

% Il punto: si CERCA una prova ammissibile, non si giudica la prima trovata.
supported_from_premises($Goal) :-
    kb_derivation($D, $Goal, 0, $N), derivation_only_from_premises($D).

% E la distinzione che il verdetto deve conservare: una conclusione puo' essere
% sostenuta dal mondo, dalle premesse, o da entrambi — sono tre cose diverse.
supported_from_world($Goal) :-
    kb_derivation($D, $Goal, 0, $N), naf(derivation_only_from_premises($D)).

% 23 settembre 2026 — da CHE COSA dipende la risposta del piano di turno: la
% legge il trace unico del turno (p0_trace, «plan because …») quando risponde
% `turn_response/2`, cosi' una risposta sbagliata nomina la regola e i fatti che
% l'hanno prodotta invece di lasciarli indovinare.
machinery(turn_response_support).
turn_response_support($Reply, $Dip) :-
    kb_derivation($D, turn_response(current_turn, $Reply), $I, $Dip), dif($I, 0).
% RI-021 (24 settembre 2026) — e la risposta PRIORITARIA del piano, che parla
% prima di ogni facolta' e prima della canonizzazione: «I would like to know the
% working load …» riceveva un consiglio di progetto e il trace diceva soltanto
% «turn_priority_response answers», senza quale delle sue regole.
machinery(turn_priority_support).
turn_priority_support($Reply, $Dip) :-
    kb_derivation($D, turn_priority_response(current_turn, $Reply), $I, $Dip), dif($I, 0).

% ─── La RAGIONE dicibile di una proposizione (27 settembre 2026) ─────────────
%
% docs/plans/train-the-smart-agent.md, iterazione 3: «Why does the RCD trip?»
% riceveva «Yes.», la risposta a un'altra domanda. La proposizione vale per una
% regola, e la regola per un fatto: la ragione e' il fatto su cui poggia la
% STESSA derivazione che ha deciso il «Yes» (non una seconda ricerca), detto in
% lingua. Una catena («it rains» -> «the ground is wet») dice il suo anello di
% partenza. `clause_fact_said/2` legge la forma canonica di `kb_clause/4`.
machinery(proposition_because).
machinery(clause_fact_said).
% un effetto osservato si spiega con la sua legge (isolation.p0, §10), non con
% la frase che lo riporta
proposition_because($P, $T) :- effect_reason($P, $T).
proposition_because($P, $T) :-
    naf(effect_reason_some($P)),
    derivation_of(holds($P), $D), derivation_uses_fact($D, $Id),
    kb_clause($Id, $H, 0, 0), clause_fact_said($H, $T).
clause_fact_said(app($R, cons(atom($A), cons(atom($B), nil))), $T) :-
    words_of($A, $WA), words_of($R, $WR), words_of($B, $WB),
    concat_atoms($WA, " ", $T1), concat_atoms($T1, $WR, $T2),
    concat_atoms($T2, " ", $T3), concat_atoms($T3, $WB, $T).
clause_fact_said(app(holds, cons(atom($P), nil)), $T) :- words_of($P, $T).

% ─── DIMENTICARE UNA PROPOSIZIONE E' UNO STRATO (28 settembre 2026) ─────────
%
% train-the-learning-process.md SA2: «forget that the RCD trips» non ritirava
% `holds(residual_current_device_trips)`. Il ritiro non cancella (l3-upgrade.md
% §19): si aggiunge sopra il fatto un sostegno che lo ritira, con lo strato del
% motore (`read_support/2` + `fact_withheld/1`, contact.p0): il fatto resta in
% KB e diventa invisibile a OGNI lettore (regole, isolamento, domande). Chi lo
% riafferma aggiunge un sostegno piu' recente; vale lo strato piu' recente,
% numerato dal turno (`turn_counter/1`).
machinery(proposition_forget).
machinery(proposition_reaffirm).
machinery(proposition_withdrawn).
machinery(support_forgotten_after).
proposition_forget($P) :-
    holds($P), turn_counter($N),
    assert(read_support, fact(holds, $P, pos), forgotten($N)).
proposition_withdrawn($P) :- read_support(fact(holds, $P, pos), forgotten($N)), fact_withheld(fact(holds, $P, pos)).
proposition_reaffirm($P) :-
    proposition_withdrawn($P), turn_counter($N),
    assert(read_support, fact(holds, $P, pos), said($N)).
read_support_in_force($F) :- read_support($F, said($N)), naf(support_forgotten_after($F, $N)).
support_forgotten_after($F, $N) :- read_support($F, forgotten($M)), gt($M, $N).
% (L4-7, 28 settembre) uno stato del mondo di chi parla che FINISCE (`ended`)
% ritira come un oblio, ma dice un'altra cosa: non «non lo tengo piu'», bensi'
% «non e' piu' cosi'». Ridetto dopo, `said` piu' recente lo riaccende.
support_forgotten_after($F, $N) :- read_support($F, ended($M)), gt($M, $N).

% ─── L4-8 / C7 — LA CONTRADDIZIONE COME STATO, NON COME GUASTO (28 set 2026) ─
%
% l4-upgrade.md §5-bis, F.: «anche per le contraddizioni ci sara' un processo
% che rende quello stato, ingestibile con la coerenza logica, uno stato
% dialettico gestibile». Misurato prima di questa sezione:
%
%   > Espresso is a coffee.          < Learned: espresso is a coffee.
%   > Espresso is not a coffee.      < Learned: espresso is not a coffee.   (muto)
%   > Is espresso a coffee?          < Conflicted.                          (una parola)
%   > What contradicts what?         < (muro)
%   > The kettle leaks current. / The kettle does not leak current.
%   > Does the kettle leak current?  < No.                                  (vince in silenzio)
%
% Il primo incremento di L4-8: un conflitto GROUND (un fatto e la sua
% negazione esplicita, nello stesso rispetto) si collega al contenuto e al
% registro unico dei paradossi; la lezione che lo crea lo dice; la domanda sul
% contenuto mostra le due parti; chi riafferma una parte la fa valere e
% l'altra riceve uno strato (`settled(N)`), non una cancellazione. Il C sapeva
% gia' vedere l'urto (`kb_is_conflicted`): la KB ora lo chiede con
% `kb_fact_neg/2` e lo maneggia.
% ⚠ `turn_scratch`, provato il contrario e ritirato: salvato con il NUMERO DI
% TURNO della sessione, dopo un ripristino i turni ripartono e «riaffermato
% dopo l'urto» decide il falso (persist.p0t). Un turno non e' un tempo
% assoluto. La persistenza dell'urto (C6) resta aperta: serve un ordine che
% sopravviva alla sessione, non un contatore.
machinery(content_clash).
turn_scratch(content_clash).
machinery(content_clash_settled).
turn_scratch(content_clash_settled).
machinery(opposite_held).
opposite_held($P, $A, neg) :- kb_fact($P, $A).
opposite_held($P, $A, pos) :- kb_fact_neg($P, $A).
machinery(clash_known).
clash_known($P, $A) :- content_clash($P, $A, $N).
machinery(clash_settled).
clash_settled($P, $A) :- content_clash_settled($P, $A, $Pol).
machinery(open_clash).
open_clash($P, $A) :- content_clash($P, $A, $N), naf(clash_settled($P, $A)).
% nel registro unico, accanto a budget, cicli, profondita' e tetti: lo dice
% la sonda di /debug (una regola su `paradox_event/4` stesso spegne la via
% rapida dei fatti che il C usa per il registro — misurato su persist.p0t)
debug_paradox(paradox(content, contradiction, $P, clash($A, $N))) :- content_clash($P, $A, $N).
% ⚠ una sola soluzione per contabile e per turno: basta per un urto alla volta
after_reply_bookkeeper(content_clash_note).
turn_after_reply($T, content_clash_note) :-
    kb_turn_act($P, $A, $Pol, $K), naf(machinery($P)), opposite_held($P, $A, $Pol),
    naf(clash_known($P, $A)), turn_counter($N), assert(content_clash, $P, $A, $N).
% L'esito dichiarato: una parte riaffermata dopo l'urto vale, l'altra si ritira
% con uno strato (derivation.p0 sopra: `read_support` + `fact_withheld`).
after_reply_bookkeeper(content_clash_settle).
turn_after_reply($T, content_clash_settle) :-
    kb_turn_act($P, $A, $Pol, $K), content_clash($P, $A, $M), turn_counter($N), gt($N, $M),
    naf(clash_settled($P, $A)), opposite_pol($Pol, $Opp), support_key($P, $A, $Opp, $Key),
    assert(read_support, $Key, settled($N)), assert(content_clash_settled, $P, $A, $Pol).
machinery(opposite_pol).
opposite_pol(pos, neg).  opposite_pol(neg, pos).
machinery(support_key).
support_key($P, cons($S, nil), $Pol, fact($P, $S, $Pol)).
support_key($P, cons($S, cons($O, nil)), $Pol, fact($P, $S, $O, $Pol)).
% le parole di un contenuto: «espresso is a coffee», «kettle leaks current»
machinery(content_said).
content_said($P, cons($S, nil), $T) :-
    words_of($S, $WS), words_of($P, $WP), current_language($L), word_article($L, $WP, $Art),
    concat_atoms($WS, " is ", $A), concat_atoms($A, $Art, $B), concat_atoms($B, " ", $C), concat_atoms($C, $WP, $T).
content_said($P, cons($S, cons($O, nil)), $T) :-
    words_of($S, $WS), words_of($P, $WP), words_of($O, $WO),
    concat_atoms($WS, " ", $A), concat_atoms($A, $WP, $B), concat_atoms($B, " ", $C), concat_atoms($C, $WO, $T).
machinery(content_words_in_turn).
content_words_in_turn(nil).
content_words_in_turn(cons($X, $R)) :- atom_words($X, $W), words_in_turn($W), content_words_in_turn($R).
% (1) la lezione che crea l'urto lo dice, invece di un «Learned» muto
reply_conduct($In, $Out) :-
    kb_turn_act($P, $A, $Pol, $K), naf(machinery($P)), opposite_held($P, $A, $Pol),
    naf(clash_known($P, $A)), content_said($P, $A, $C), current_language($L),
    clash_line($L, created, $X), concat_atoms($In, $X, $Y), concat_atoms($Y, $C, $Z),
    clash_line($L, created_end, $E), concat_atoms($Z, $E, $Out).
% (2) la domanda sul contenuto mostra la tensione con le due parti
machinery(clash_asked).
% Solo la domanda POLARE sulla stessa relazione («Is espresso a coffee?»):
% «What do you know about socrates?» o «Why is socrates a man?» chiedono
% altro, e hanno le loro risposte sulla tensione.
clash_asked($P, $A) :-
    turn_declared_act(current_turn, question), turn_word(current_turn, 0, $W), naf(question_word($W)),
    open_clash($P, $A), content_words_in_turn($A), relation_in_turn($P).
% «Why is socrates a man?» su un urto: non una ragione per una parte sola
% (misurato a HEAD: «Because socrates is a man.»), ma la tensione.
machinery(clash_why_asked).
clash_why_asked($P, $A) :-
    turn_declared_act(current_turn, question), turn_word(current_turn, 0, why),
    open_clash($P, $A), content_words_in_turn($A), relation_in_turn($P).
reply_conduct($In, $Out) :-
    clash_why_asked($P, $A), content_said($P, $A, $C), current_language($L),
    clash_line($L, why, $X), concat_atoms($X, $C, $Y), clash_line($L, why_end, $E), concat_atoms($Y, $E, $Out).
clash_line(en, why, "I have conflicting evidence for that: you told me both that ").
clash_line(en, why_end, " and the opposite, so I have no reason to give until you tell me which holds.").
clash_line(it, why, "Ho prove in conflitto: mi hai detto sia che ").
clash_line(it, why_end, " sia il contrario, quindi non ho una ragione da dare finché non mi dici quale vale.").
reply_conduct($In, $Out) :-
    clash_asked($P, $A), content_said($P, $A, $C), current_language($L),
    clash_line($L, both, $X), concat_atoms($X, $C, $Y), clash_line($L, both_end, $E), concat_atoms($Y, $E, $Out).
% (4) l'esito dichiarato: chi riafferma una parte sa che cosa ha deciso
reply_conduct($In, $Out) :-
    naf(turn_declared_act(current_turn, question)),
    kb_turn_act($P, $A, $Pol, $K), open_clash($P, $A), content_said($P, $A, $C), current_language($L),
    clash_settle_line($L, $Pol, $X), concat_atoms($X, $C, $Y), clash_line($L, settled_end, $E),
    concat_atoms($Y, $E, $Out).
machinery(clash_settle_line).
clash_settle_line($L, pos, $X) :- clash_line($L, settled_pos, $X).
clash_settle_line($L, neg, $X) :- clash_line($L, settled_neg, $X).
clash_line(en, settled_pos, "Settled: ").
clash_line(en, settled_neg, "Settled: it is not true that ").
clash_line(en, settled_end, ". I no longer hold the opposite, and I keep where it came from.").
clash_line(it, settled_pos, "Deciso: ").
clash_line(it, settled_neg, "Deciso: non è vero che ").
clash_line(it, settled_end, ". Non tengo più il contrario, e conservo da dove veniva.").
% (2-ter) una domanda sull'ENTITA' di un urto («What do you know about
% socrates?») rispondeva «Socrates is a man.» come se niente fosse: la
% risposta resta, e porta la tensione in coda.
machinery(clash_mentioned).
clash_mentioned($P, $A) :-
    turn_declared_act(current_turn, question), open_clash($P, cons($S, $R)),
    content_words_in_turn(cons($S, nil)), naf(relation_in_turn($P)), eq_cons($A, $S, $R).
reply_conduct($In, $Out) :-
    clash_mentioned($P, $A), content_said($P, $A, $C), current_language($L),
    clash_line($L, mentioned, $X), concat_atoms($In, $X, $Y), concat_atoms($Y, $C, $Z),
    clash_line($L, mentioned_end, $E), concat_atoms($Z, $E, $Out).
clash_line(en, mentioned, " But I hold a contradiction there: you told me both that ").
clash_line(en, mentioned_end, " and the opposite.").
clash_line(it, mentioned, " Ma lì tengo una contraddizione: mi hai detto sia che ").
clash_line(it, mentioned_end, " sia il contrario.").
% (3) «What contradicts what?»
turn_form(ask_contradictions, 1, text("what contradicts what")).
turn_form_mood(ask_contradictions, question).
turn_form_priority(ask_contradictions, early).
turn_form_act(ask_contradictions, "op(match, open_clashes_answer, [free])").
turn_form_reply(ask_contradictions, open_clashes_reply).
turn_form(ask_contradictions_hold, 1, text("what contradictions do you hold")).
turn_form_mood(ask_contradictions_hold, question).
turn_form_priority(ask_contradictions_hold, early).
turn_form_act(ask_contradictions_hold, "op(match, open_clashes_answer, [free])").
turn_form_reply(ask_contradictions_hold, open_clashes_reply).
response_template(open_clashes_reply, "{result}").
response_template(open_clashes_reply, it, "{result}").
machinery(open_clashes_answer).
machinery(open_clash_said).
open_clashes_answer($Text) :-
    findall($C, open_clash_said($C), cons($C1, $Cs)), current_language($L),
    inversion_phrase_and($L, cons($C1, $Cs), $J), clash_line($L, list, $A),
    concat_atoms($A, $J, $B), concat_atoms($B, ".", $Text).
open_clashes_answer($Text) :-
    naf(any_open_clash), current_language($L), clash_line($L, none, $Text).
machinery(any_open_clash).
any_open_clash :- open_clash($P, $A).
open_clash_said($T) :- open_clash($P, $A), content_said($P, $A, $C), current_language($L),
    clash_line($L, item, $X), concat_atoms($X, $C, $T).
machinery(clash_line).
clash_line(en, created, " But you told me before the opposite of this, so now I hold a contradiction: ").
clash_line(en, created_end, ", and also not. I'll say so if you ask, until you tell me which is right.").
clash_line(en, both, "You told me both that ").
clash_line(en, both_end, " and the opposite, so I can't answer yes or no: tell me which one holds.").
clash_line(en, list, "You told me contradictory things about ").
clash_line(en, item, "whether ").
clash_line(en, none, "Nothing that I know of: no fact I hold is contradicted by another.").
clash_line(it, created, " Ma prima mi avevi detto il contrario, quindi ora tengo una contraddizione: ").
clash_line(it, created_end, ", e anche no. Lo dirò se me lo chiedi, finché non mi dici quale è giusta.").
clash_line(it, both, "Mi hai detto sia che ").
clash_line(it, both_end, " sia il contrario, quindi non posso rispondere sì o no: dimmi quale vale.").
clash_line(it, list, "Mi hai detto cose contraddittorie su ").
clash_line(it, item, "se ").
clash_line(it, none, "Niente che io sappia: nessun fatto che tengo è contraddetto da un altro.").
