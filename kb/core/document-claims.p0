% document-claims.p0 — claim riportate e forza epistemica (SC2-A).
%
% Una frase osservata, la proposition che porta e il commitment di parrot0 sono
% coordinate diverse. Il producer C trova una cue con lo scorer universale,
% copia range e remainder e consegna un record opaco; questa KB decide status,
% attribuzione, contesto e viste. Il contenuto resta deliberatamente una
% proposition di superficie finche' un parser semantico unico non lo normalizza.

:- file_attribute(machinery).

machinery(claim_marker_class).
machinery(claim_status_evidence).
machinery(document_claim_observe).
machinery(document_claim).
machinery(unit_claim).
machinery(claim_marker_observation).
machinery(claim_marker_live).
machinery(claim_status).
machinery(claim_attributed_to).
machinery(claim_source_record).
machinery(claim_source_span).
machinery(claim_context).
machinery(claim_commitment).
machinery(current_document_claim).
machinery(current_document_typed_claim).

% Membri iniziali e case di persistenza delle tre classi. Non sono condizioni
% cablate: il ratchet usa superfici diverse, aggiunte e ritratte a runtime.
hypothesis_report_marker("we hypothesize that").
hypothesis_report_marker("the researchers hypothesize that").
observation_report_marker("the data show that").
simulation_result_marker("the simulations show that").
hypothesis_report_marker("the authors hypothesize that").
observation_report_marker("the evidence shows that").
simulation_result_marker("the model results show that").

% La classe della cue e' aperta. Una superficie nuova entra come membro unario
% parlando; status, contesto, attribuzione ed extent non vengono dedotti da C.
claim_marker_class(
    hypothesis_report_marker,
    reading(hypothesized, reported_belief),
    attribution(document_authors),
    extent(remainder)).
claim_marker_class(
    observation_report_marker,
    reading(observed, reported_belief),
    attribution(document_data),
    extent(remainder)).
claim_marker_class(
    simulation_result_marker,
    reading(simulated, reported_belief),
    attribution(document_simulation),
    extent(remainder)).

claim_status_evidence($Class, $Cue) :-
    claim_marker_class($Class, $Reading, $Attribution, $Extent),
    apply($Class, cons($Cue, nil)).

% Record:
%   ref(Document, Unit, Claim)
%   marker(Class, Cue, range(Start, Length))
%   proposition(surface("..."))
%   provenance(range(Start, Length))
%
% `claim_status/2` non viene materializzato: dipende ancora dalla membership
% viva della cue. Il retract elimina quindi lo status anche sul testo gia'
% osservato senza cancellare frase, proposition, fonte o attribuzione.
document_claim_observe(
    ref($Document, $Unit, $Claim),
    marker($Class, $Cue, $CueRange),
    proposition(surface($Surface)),
    provenance($ContentRange)) :-
    claim_marker_class(
        $Class, reading($Status, $ContextKind), attribution($Agent),
        extent(remainder)),
    assert(document_claim, $Document, $Claim, proposition(surface($Surface))),
    assert(unit_claim, $Unit, $Claim),
    assert(claim_marker_observation, $Claim, $Class,
           marker($Cue, $CueRange)),
    assert(claim_attributed_to, $Claim, $Agent),
    assert(claim_source_record, $Claim, source($Document, $Unit),
           provenance($ContentRange)).

claim_marker_live($Claim, $Class) :-
    claim_marker_observation($Claim, $Class, marker($Cue, $CueRange)),
    apply($Class, cons($Cue, nil)).

claim_status($Claim, $Status) :-
    claim_marker_live($Claim, $Class),
    claim_marker_class(
        $Class, reading($Status, $ContextKind), attribution($Agent), $Extent).

claim_context($Claim, context($Claim)) :-
    claim_marker_live($Claim, $Class).
context(context($Claim), $ContextKind) :-
    claim_marker_live($Claim, $Class),
    claim_marker_class(
        $Class, reading($Status, $ContextKind), attribution($Agent), $Extent).
holds_in(context($Claim), $Proposition) :-
    document_claim($Document, $Claim, $Proposition),
    claim_marker_live($Claim, $Class).

claim_commitment($Claim, $Commitment) :-
    claim_context($Claim, $Context), context_commitment($Context, $Commitment).

claim_source_span($Claim, $Unit, $Range) :-
    claim_source_record($Claim, source($Document, $Unit), provenance($Range)).

current_document_claim($Claim, $Proposition) :-
    current_document($Document), document_claim($Document, $Claim, $Proposition).
current_document_typed_claim($Claim, $Status) :-
    current_document_claim($Claim, $Proposition), claim_status($Claim, $Status).

% ── SC2-B: LA NORMALIZZAZIONE E' UNA FASE PURA E CONTESTUALE ───────────────
%
% SC2-A ha chiuso l'envelope: chi ha riportato che cosa, con quale status, dove
% e sotto quale fonte. Il «che cosa» pero' restava `proposition(surface("..."))`,
% cioe' una quarantena di byte. SC2-B lo normalizza SENZA cambiare chi ci crede.
%
% La separazione e' fra due cose che il motore teneva incollate:
%
%   ANALIZZARE una clausola dichiarativa  ->  candidato semantico  (fase pura)
%   COMMETTERE quel candidato nel mondo   ->  conoscenza di parrot0 (fase impura)
%
% Il reader esegue soltanto la prima, sul remainder della claim, con la stessa
% pipeline che legge una frase normale — non un secondo parser documentale. Che
% cosa possa succedere al candidato non lo decide il parser: lo decide
% `normalization_origin/2`, che e' conoscenza correggibile. Un'origine
% `reported` mette il frame in quarantena dentro il contesto della claim; una
% `asserted` e' la strada del learner normale, che asserisce. Se domani una
% politica editoriale vuole promuovere le osservazioni di una fonte fidata,
% cambia una riga qui, non il lettore.

machinery(normalization_origin).
machinery(normalization_gap_kind).
machinery(normalization_extent_policy).
machinery(claim_reading_extent).
machinery(claim_proposition).
machinery(claim_frame).
machinery(claim_normalization).
machinery(claim_normalized).
machinery(claim_normalization_gap).
machinery(document_claim_normalize).
machinery(document_claim_gap_observe).
machinery(claim_surface).
machinery(claim_document).
machinery(claim_document_source).
machinery(claim_proof).
machinery(current_claim_of_class).
machinery(claim_with_frame).
machinery(claim_frame_status).
machinery(marker_question_form).
machinery(claim_question_evidence).
machinery(claim_status_question_evidence).
machinery(complement_suffix).

normalization_origin(reported, quarantine).
normalization_origin(asserted, world).

% Perche' una normalizzazione non e' avvenuta e' un dato, non un silenzio. Il
% fallimento non cancella mai la claim di superficie gia' osservata.
normalization_gap_kind(no_reading).
normalization_gap_kind(ambiguous_reading).
normalization_gap_kind(unsupported_operator).
normalization_gap_kind(partial_reading).
normalization_gap_kind(modal_operator).
normalization_gap_kind(negated_reading).
normalization_gap_kind(coordinated_reading).
normalization_gap_kind(comparative_reading).

% ── PERCHE' UNA FRASE NON E' STATA LETTA SI LEGGE DALLA FRASE ──────────────
%
% `no_reading` e' vero e inutile: dice che il lettore si e' fermato, non contro
% che cosa. Un residuo tipato invece si conta, si raggruppa e si ordina — e la
% somma dei residui di un corpus e' l'elenco di cio' che parrot0 non sa ancora
% leggere, cioe' il curriculum che oggi scriviamo noi a mano.
%
% Le superfici stanno qui, non nel C, e passano dallo stesso scorer universale
% delle cue epistemiche. Una classe nuova di residuo — apposizione, riferimento,
% condizionale — costa dei fatti; il lettore non cambia. Il match e' a PAROLA
% INTERA (`keyword`) perche' «can» non deve accendersi dentro «scan».
machinery(normalization_gap_evidence).
normalization_gap_evidence(modal_operator, keyword(can)).
normalization_gap_evidence(modal_operator, keyword(may)).
normalization_gap_evidence(modal_operator, keyword(might)).
normalization_gap_evidence(modal_operator, keyword(could)).
normalization_gap_evidence(modal_operator, keyword(should)).
normalization_gap_evidence(modal_operator, keyword(would)).
normalization_gap_evidence(modal_operator, keyword(must)).
normalization_gap_evidence(negated_reading, keyword(not)).
normalization_gap_evidence(negated_reading, keyword(never)).
normalization_gap_evidence(negated_reading, keyword(neither)).
normalization_gap_evidence(coordinated_reading, keyword(and)).
normalization_gap_evidence(coordinated_reading, keyword(or)).
normalization_gap_evidence(coordinated_reading, keyword(both)).
normalization_gap_evidence(comparative_reading, keyword(than)).
normalization_gap_evidence(comparative_reading, keyword(more)).
normalization_gap_evidence(comparative_reading, keyword(less)).

% ── UNA LETTURA CHE NON COPRE LA PROPOSIZIONE NON E' UNA NORMALIZZAZIONE ──
%
% «DART slowed the orbital period of Dimorphos» si lega a
% `slowed(dart, orbital_period)`: lo schema combacia, e perde di CHI sia il
% periodo. Nella chat quella perdita era gia' li' e nessuno la vedeva; su una
% claim riportata sarebbe peggio, perche' una domanda di verifica confronta
% FRAME con FRAME e due proposizioni diverse su due oggetti diversi
% collasserebbero nella stessa. Un si' cosi' e' peggio di un muro.
%
% Quindi la copertura e' una coordinata esplicita e la decisione e' una POLICY.
% Oggi una claim riportata pretende copertura piena; domani una fonte fidata o
% un dominio tollerante puo' avere una riga diversa, senza toccare il lettore.
normalization_extent_policy($Origin, covered($N), of($M), normalized) :-
    normalization_origin($Origin, quarantine), eq($N, $M).
normalization_extent_policy($Origin, covered($N), of($M), partial) :-
    normalization_origin($Origin, quarantine), lt($N, $M).

document_claim_normalize(ref($Document, $Unit, $Claim), origin($Origin),
                         frame($Predicate, $Roles),
                         extent(covered($N), of($M))) :-
    normalization_extent_policy($Origin, covered($N), of($M), normalized),
    assert(claim_proposition, $Claim,
           proposition(frame($Predicate, $Roles))),
    assert(claim_normalization, $Claim, normalized($Origin)),
    assert(claim_reading_extent, $Claim, extent($N, $M)).

document_claim_normalize(ref($Document, $Unit, $Claim), origin($Origin),
                         frame($Predicate, $Roles),
                         extent(covered($N), of($M))) :-
    normalization_extent_policy($Origin, covered($N), of($M), partial),
    assert(claim_normalization, $Claim, gap(partial_reading)),
    assert(claim_reading_extent, $Claim, extent($N, $M)).

document_claim_gap_observe(ref($Document, $Unit, $Claim), gap($Kind)) :-
    normalization_gap_kind($Kind),
    assert(claim_normalization, $Claim, gap($Kind)).

claim_normalized($Claim, $Origin) :-
    claim_normalization($Claim, normalized($Origin)).
claim_normalization_gap($Claim, $Kind) :-
    claim_normalization($Claim, gap($Kind)).

claim_frame($Claim, $Predicate, $Subject, $Object) :-
    claim_proposition($Claim,
                      proposition(frame($Predicate,
                                        roles(subject($Subject),
                                              object($Object))))).
claim_with_frame($Claim, $Frame) :-
    claim_proposition($Claim, proposition($Frame)).

% Il frame normalizzato vive nel contesto della claim, mai nel mondo. E'
% esattamente la stessa vista che SC2-A dava alla superficie: dipende dalla cue
% viva, quindi il retract toglie il contesto e lascia in piedi la proposizione
% attribuita.
holds_in(context($Claim), proposition(frame($Predicate, $Roles))) :-
    claim_proposition($Claim, proposition(frame($Predicate, $Roles))),
    claim_marker_live($Claim, $Class).

claim_surface($Claim, $Surface) :-
    document_claim($Document, $Claim, proposition(surface($Surface))).
claim_document($Claim, $Document) :-
    document_claim($Document, $Claim, $Proposition).
claim_document_source($Claim, $Source) :-
    claim_document($Claim, $Document), document_source($Document, $Source).

% La prova di una risposta non e' il suo testo: e' la catena documento -> unita'
% -> span -> cue viva -> fonte. Se una di queste non c'e', la risposta non e'
% giustificata e questa vista non ha soluzioni.
claim_proof($Claim,
            proof(document($Document, $Source), unit($Unit), span($Range),
                  cue($Class, $Cue))) :-
    claim_source_record($Claim, source($Document, $Unit), provenance($Range)),
    document_source($Document, $Source),
    claim_marker_observation($Claim, $Class, marker($Cue, $CueRange)),
    apply($Class, cons($Cue, nil)).

machinery(current_document_normalized_claim).
current_document_normalized_claim($Claim) :-
    current_document_claim($Claim, $Proposition),
    claim_normalized($Claim, $Origin).

% ── UN MODALE E' UN OPERATORE, NON UNA PAROLA DI TROPPO ───────────────────
%
% Misurato prima di questa riga: «a kinetic impactor CAN shorten an asteroid
% orbit» produceva `shorten(kinetic_impactor_can, asteroid_orbit)`. Il modale
% non faceva fallire la lettura — veniva inghiottito dentro il sintagma del
% soggetto, e la claim usciva come se il testo avesse detto che la cosa
% succede. E' il misclaim peggiore di tutta la catena: non un muro, non un gap,
% ma una proposizione che afferma piu' della sua fonte.
%
% Un modale porta una FORZA, e la forza e' conoscenza. La classe e' aperta:
% un modale nuovo, o una lingua nuova, costa un fatto.
machinery(modal_force).
machinery(modal_force_evidence).
machinery(claim_modal_observation).
machinery(claim_modality).
machinery(claim_asserted_status).
machinery(document_claim_modality_observe).

modal_force(can, possible).
modal_force(could, possible).
modal_force(may, possible).
modal_force(might, possible).
modal_force(must, necessary).
modal_force(should, expected).
modal_force(will, predicted).
modal_force(would, conditional).

% E la classe si apre PARLANDO. Le tre righe seguenti sono il ponte fra la
% forza — che e' una coordinata del motore epistemico — e il modo naturale in
% cui un esperto la nomina: «ought is a necessity marker». Da quel turno il
% lettore stacca `ought` e registra `necessary`, senza ricompilare e senza che
% il teacher sappia che esiste `modal_force/2`.
machinery(possibility_marker).
machinery(necessity_marker).
machinery(expectation_marker).
modal_force($Modal, possible) :- possibility_marker($Modal).
modal_force($Modal, necessary) :- necessity_marker($Modal).
modal_force($Modal, expected) :- expectation_marker($Modal).

% Il match e' a PAROLA INTERA: «can» non deve accendersi dentro «scan», e
% «will» non deve accendersi dentro «Williams».
modal_force_evidence($Modal, keyword($Modal)) :- modal_force($Modal, $Force).

% L'osservazione e' irreversibile (quel testo conteneva quel modale); la FORZA
% e' una vista viva, quindi ritrattare la classe toglie la modalita' e lascia in
% piedi la proposizione, la superficie, la fonte e lo span.
document_claim_modality_observe(ref($Document, $Unit, $Claim), modal($Modal)) :-
    modal_force($Modal, $Force),
    assert(claim_modal_observation, $Claim, $Modal).

claim_modality($Claim, $Force) :-
    claim_modal_observation($Claim, $Modal), modal_force($Modal, $Force).

% Una claim modale non afferma il proprio contenuto: ne afferma la possibilita',
% la necessita' o l'attesa. Lo status della classe dice CHI lo riporta e con
% quale evidenza; la forza dice QUANTO. Le due coordinate non si sommano, e una
% domanda che chiede se una cosa e' accaduta non puo' essere soddisfatta da una
% claim che dice soltanto che potrebbe.
% `naf` va interrogata su un goal senza variabili libere, altrimenti la
% negazione non nega quello che sembra: da qui il predicato ausiliario.
machinery(claim_has_modality).
claim_has_modality($Claim) :- claim_modality($Claim, $Force).
claim_asserted_status($Claim, $Status) :-
    claim_status($Claim, $Status), naf(claim_has_modality($Claim)).

% ── LA PROVA DEVE POTERSI PRONUNCIARE ─────────────────────────────────────
%
% `claim_proof/2` si interrogava e non si diceva: «come lo sai?» dopo una
% risposta su una claim rispondeva che non c'era nessuna prova da condividere.
% Una risposta giustificata la cui giustificazione non e' dicibile e' meta'
% risposta. Queste tre viste danno al registro della prova le coordinate
% separate che la frase deve nominare; la FRASE resta in `response_template`.
machinery(claim_unit).
machinery(claim_span).
machinery(claim_live_cue).

claim_unit($Claim, $Unit) :-
    claim_source_record($Claim, source($Document, $Unit), provenance($Range)).
claim_span($Claim, $Range) :-
    claim_source_record($Claim, source($Document, $Unit), provenance($Range)).
claim_live_cue($Claim, $Cue) :-
    claim_marker_observation($Claim, $Class, marker($Cue, $CueRange)),
    apply($Class, cons($Cue, nil)).

current_claim_of_class($Class, $Claim) :-
    claim_marker_live($Claim, $Class),
    current_document_claim($Claim, $Proposition).

claim_frame_status($Frame, $Status) :-
    claim_with_frame($Claim, $Frame), claim_status($Claim, $Status).

% ── LA DOMANDA E' LA LEZIONE GIA' DATA, SENZA IL COMPLEMENTATORE ───────────
%
% «the investigators predict that» e' la locuzione insegnata; «what did the
% investigators predict?» e' la stessa locuzione senza il complementatore che la
% apre sulla proposizione. Non e' un secondo frasario da insegnare: e' una
% derivazione dalla lezione gia' data, come `answer_frame/2` deriva la porta di
% risposta dal verbo di relazione (kb/core/grammar.p0). Chi insegna un marker
% nuovo domani apre insieme la sua domanda, senza dire una seconda frase.
complement_suffix(" that").

marker_question_form($Cue, $Stem) :-
    complement_suffix($Suffix),
    chars($Suffix, $SuffixChars),
    chars($Cue, $CueChars),
    app($StemChars, $SuffixChars, $CueChars),
    chars($Stem, $StemChars).

claim_question_evidence($Class, $Stem) :-
    claim_status_evidence($Class, $Cue),
    marker_question_form($Cue, $Stem).
claim_question_evidence($Class, $Cue) :-
    claim_status_evidence($Class, $Cue).

% E la verifica di status nomina lo status stesso: «was it observed that X?».
% Lo status non e' una parola scritta qui — e' il primo campo della politica di
% classe, quindi una classe nuova porta con se' la propria domanda di verifica.
claim_status_question_evidence($Status, $Cue) :-
    claim_marker_class($Class, reading($Status, $ContextKind),
                       $Attribution, $Extent),
    complement_suffix($Suffix),
    concat_atoms($Status, $Suffix, $Cue).
