% SC32 — la meta' mancante dell'atto didattico. Una lezione che non si puo'
% togliere non e' una lezione, e il contratto di AGENTS.md la vuole simmetrica.
response_template(taught_form_forgotten, "Forgotten - «{phrase}» is no longer {label}.").
response_template(taught_form_not_held, "I wasn't holding «{phrase}» as {label}.").
response_template(learned_negative_fact, "Learned: not {pred}({arg}).").
response_template(learned_unary_fact, "Learned: {pred}({arg}).").
% La CLASSE si dice in lingua: il sito che la usa sa gia' che il predicato unario
% e' una classe (la sua variabile si chiama `cls`), quindi «{arg} is a {cls}» non
% e' un'ipotesi. Il termine resta per i predicati unari che classi non sono.
response_template(learned_class_fact, "Learned: {arg} is {art} {cls}.").
response_template(learned_binary_fact, "Learned: {pred}({arg1}, {arg2}).").
response_template(learned_facts, "Learned: {facts}.").
% E quando i ruoli sono tre. Senza questa riga il motore annunciava due
% argomenti su tre: il fatto ternario entrava corretto e la frase ne mostrava
% una versione mutila — un misclaim su cio' che aveva appena imparato.
response_template(learned_ternary_fact, "Learned: {pred}({arg1}, {arg2}, {arg3}).").
% La risposta a uno slot lasciato libero da una parola interrogativa. E' la
% meta' che di solito manca: un fatto imparato e non interrogabile e' un fatto
% morto, e a tre ruoli il buco si riapriva identico.
response_template(slot_answer, "{value}.").
% G2 — la descrizione combacia con piu' di un'entita'. Sceglierne una sarebbe
% inventare che cosa intendesse chi parla; tacere butterebbe via il fatto che la
% descrizione l'abbiamo capita. Chiedere quale e' la risposta giusta.
response_template(ambiguous_description, "There is more than one — {options}. Which do you mean?").
response_template(known_unary_fact, "{pred}({arg}) is a known fact.").
response_template(rejected_binary_fact, "Scartato: {pred}({arg1}, {arg2}) non e' fatto di concetti.").
response_template(count_of_answer, "There are {count} {noun}s.").
response_template(learned_properties, "Learned: {facts}.").
response_template(reasoning_steps, "By {steps} step{s} of reasoning: {ex}.").
response_template(induced_rules, "Induced: {rules}.").
response_template(prose_read_page_could_not_open_x, "I could not open {target}.").
response_template(i_couldn_t_store_that_2, "I couldn't store that.").
