% ── Quanto pesa ───────────────────────────────────────────────────────────
relation(weight).
response_template(learned_weight, "Held: {subject} weighs {object}.").
response_template(learned_weight, it, "Tengo: {subject} pesa {object}.").
turn_form(weight_stated, 1, slot(subject)).
turn_form(weight_stated, 2, class(weight_verb)).
turn_form(weight_stated, 3, rest(object)).
turn_form(weight_stated, 4, bind(relation, weight_of)).
turn_form_mood(weight_stated, statement).
turn_form_act(weight_stated, assert_relation).
turn_form_reply(weight_stated, learned_weight).

machinery(weight_verb).
weight_verb(weighs).  weight_verb(weigh).  weight_verb(weighed).
weight_verb(pesa).    weight_verb(pesano).

turn_form(weight_asked, 1, text("how much does")).
turn_form(weight_asked, 2, slot(subject)).
turn_form(weight_asked, 3, class(weight_verb)).
turn_form(weight_asked, 4, bind(relation, weight_of)).
turn_form_mood(weight_asked, question).
turn_form_act(weight_asked, answer_relation).

% «quanto pesa zelnik?» arriva ai lettori canonicalizzato in «how much pesa
% zelnik?»: la forma si dichiara su cio' che il lettore VEDE, non su cio' che
% l'interlocutore ha scritto. Il verbo resta italiano perche' e' contenuto.
turn_form(weight_asked_it, 1, text("how much")).
turn_form(weight_asked_it, 2, class(weight_verb)).
turn_form(weight_asked_it, 3, slot(subject)).
turn_form(weight_asked_it, 4, bind(relation, weight_of)).
turn_form_mood(weight_asked_it, question).
turn_form_act(weight_asked_it, answer_relation).

% ── A che cosa serve ──────────────────────────────────────────────────────
relation(purpose).
response_template(learned_purpose, "Held: {subject} is used for {object}.").
response_template(learned_purpose, it, "Tengo: {subject} serve a {object}.").
turn_form(purpose_stated, 1, slot(subject)).
turn_form(purpose_stated, 2, text("is used for")).
turn_form(purpose_stated, 3, rest(object)).
turn_form(purpose_stated, 4, bind(relation, purpose_of)).
turn_form_mood(purpose_stated, statement).
turn_form_act(purpose_stated, assert_relation).
turn_form_reply(purpose_stated, learned_purpose).

% Le forme italiane di questa famiglia NON si dichiarano qui: «grum serve a
% tagliare» e' gia' letta da chi legge i prerequisiti, e «a cosa serve X?» da un
% altro lettore ancora. Il dispatch e' first-match e le strutture secondarie si
% tengono: sovrascriverle per avere ragione sarebbe ridurre cio' che un pezzo di
% parrot0 vede. Resta come lacuna dichiarata, non come forma vinta a forza.
turn_form(purpose_asked, 1, text("what is")).
turn_form(purpose_asked, 2, slot(subject)).
turn_form(purpose_asked, 3, text("used for")).
turn_form(purpose_asked, 4, bind(relation, purpose_of)).
turn_form_mood(purpose_asked, question).
turn_form_act(purpose_asked, answer_relation).

turn_form(purpose_asked2, 1, text("what is the purpose of")).
turn_form(purpose_asked2, 2, slot(subject)).
turn_form(purpose_asked2, 3, bind(relation, purpose_of)).
turn_form_mood(purpose_asked2, question).
turn_form_act(purpose_asked2, answer_relation).

% ── A che cosa una cosa somiglia ──────────────────────────────────────────
relation(resemblance).
response_template(learned_similar, "Held: {subject} is similar to {object}.").
response_template(learned_similar, it, "Tengo: {subject} somiglia a {object}.").
turn_form(similar_stated, 1, slot(subject)).
turn_form(similar_stated, 2, text("is similar to")).
turn_form(similar_stated, 3, rest(object)).
turn_form(similar_stated, 4, bind(relation, resemblance_of)).
turn_form_mood(similar_stated, statement).
turn_form_act(similar_stated, assert_relation).
turn_form_reply(similar_stated, learned_similar).

turn_form(similar_stated2, 1, slot(subject)).
turn_form(similar_stated2, 2, text("is like")).
turn_form(similar_stated2, 3, rest(object)).
turn_form(similar_stated2, 4, bind(relation, resemblance_of)).
turn_form_mood(similar_stated2, statement).
turn_form_act(similar_stated2, assert_relation).
turn_form_reply(similar_stated2, learned_similar).

turn_form(similar_asked, 1, text("what is")).
turn_form(similar_asked, 2, slot(subject)).
turn_form(similar_asked, 3, text("similar to")).
turn_form(similar_asked, 4, bind(relation, resemblance_of)).
turn_form_mood(similar_asked, question).
turn_form_act(similar_asked, answer_relation).

% ── Che cosa una cosa sa fare ─────────────────────────────────────────────
relation(ability).
response_template(learned_ability, "Held: {subject} can {object}.").
response_template(learned_ability, it, "Tengo: {subject} può {object}.").
turn_form(ability_stated, 1, slot(subject)).
turn_form(ability_stated, 2, class(ability_marker)).
turn_form(ability_stated, 3, rest(object)).
turn_form(ability_stated, 4, bind(relation, ability_of)).
turn_form_mood(ability_stated, statement).
turn_form_act(ability_stated, assert_relation).
turn_form_reply(ability_stated, learned_ability).

machinery(ability_marker).
ability_marker("can").  ability_marker("is able to").  ability_marker("knows how to").

turn_form(ability_asked, 1, text("what can")).
turn_form(ability_asked, 2, slot(subject)).
turn_form(ability_asked, 3, text("do")).
turn_form(ability_asked, 4, bind(relation, ability_of)).
turn_form_mood(ability_asked, question).
turn_form_act(ability_asked, answer_relation).

% ── Quale dei due ─────────────────────────────────────────────────────────
% «which is bigger, zelnik or grum?» non chiede un valore, chiede quale dei due
% sta nel primo posto della relazione: un ATTO diverso, non una forma diversa.
turn_form(choice_asked, 1, text("which is")).
turn_form(choice_asked, 2, relation(relation)).
turn_form(choice_asked, 3, slot(first)).
turn_form(choice_asked, 4, text("or")).
turn_form(choice_asked, 5, rest(second)).
turn_form_mood(choice_asked, question).
turn_form_act(choice_asked, answer_choice).

turn_form(choice_asked_it, 1, text("what is")).
turn_form(choice_asked_it, 2, relation(relation)).
turn_form(choice_asked_it, 3, slot(first)).
turn_form(choice_asked_it, 4, text("or")).
turn_form(choice_asked_it, 5, rest(second)).
turn_form_mood(choice_asked_it, question).
turn_form_act(choice_asked_it, answer_choice).

% ── Che una relazione sia transitiva si DICE ───────────────────────────────
% Percorrere una catena non e' lecito per ogni relazione: «zelnik is next to
% grum» piu' «grum is next to pella» non fanno zelnik vicino a pella. Quindi il
% motore sa percorrere e non sa quando: quando lo dice la conoscenza, e la
% conoscenza si insegna parlando.
machinery(transitive_relation).
response_template(learned_transitive, "Held: {subject} chains -- if a {subject} b and b {subject} c, then a {subject} c.").
response_template(learned_transitive, it, "Tengo: {subject} si concatena — se a {subject} b e b {subject} c, allora a {subject} c.").
% «X is transitive» NON si dichiara qui: quella superficie e' gia' letta da chi
% elenca le relazioni transitive che parrot0 conosce, e il dispatch e'
% first-match. Si tiene la struttura che c'era e si dice la lezione in un modo
% che non ruba il turno a nessuno.
turn_form(transitive_taught, 1, slot(subject)).
turn_form(transitive_taught, 2, text("chains transitively")).
turn_form(transitive_taught, 3, bind(class, transitive_relation)).
turn_form_mood(transitive_taught, statement).
turn_form_act(transitive_taught, assert_unary).
turn_form_reply(transitive_taught, learned_transitive).

turn_form(transitive_taught2, 1, slot(subject)).
turn_form(transitive_taught2, 2, text("chains")).
turn_form(transitive_taught2, 3, bind(class, transitive_relation)).
turn_form_mood(transitive_taught2, statement).
turn_form_act(transitive_taught2, assert_unary).
turn_form_reply(transitive_taught2, learned_transitive).



% ══ gen507/36 — I PIANI SI INSEGNANO PARLANDO ═════════════════════════════
%
% F., 2026-09-10: «fai in modo che i piani siano insegnabili via prompt: alla
% prossima cosa che dovra' essere gestita con un piano di ragionamento tu gli
% potrai dire via prompt "quando ti trovi in questa situazione fai questo,
% questo e questo"».
%
% Un piano e' una SITUAZIONE piu' delle MOSSE in ordine:
%
%     plan_move(Situazione, Ordine, Mossa).
%
% Il motore conosce le MOSSE — sono cose da fare, come gli atti del giro /19 —
% e non sa quali siano ne' in che ordine: legge il piano. L'ordine non si dice,
% e' quello in cui le mosse vengono insegnate, come in una spiegazione a voce.
%
%     > when you have no steps then look at what it is made of
%       Held: in that situation, move 1 is «mi sono chiesto di che cosa e' fatta».
%
% Le PAROLE con cui si nomina una situazione o una mossa sono conoscenza: chi
% insegna non deve conoscere il nome interno, e un modo nuovo di dire la stessa
% situazione e' una riga.
machinery(plan_move).
machinery(situation_cue).
machinery(move_cue).

situation_cue("you have no steps", steps_missing).
situation_cue("you don't have the steps", steps_missing).
situation_cue("you do not have the steps", steps_missing).
situation_cue("you don't know how to make something", steps_missing).
% ⚠ Ogni cue che contiene la parola «steps» e' irraggiungibile in una frase di
% governo: `intent_cue(process_request, "steps")` intercetta il turno e lo legge
% come «come si fa X». Serve almeno un modo di nominare la situazione che non
% usi quella parola.
situation_cue("the recipe is missing", steps_missing).
situation_cue("la ricetta manca", steps_missing).
situation_cue("non hai i passi", steps_missing).
situation_cue("non sai come si fa", steps_missing).

move_cue("look at what it is made of", list_composition).
move_cue("say what it is made of", list_composition).
move_cue("list what it is made of", list_composition).
move_cue("tell me what it is made of", list_composition).
move_cue("guarda di che cosa e' fatta", list_composition).
move_cue("dimmi di che cosa e' fatta", list_composition).
% NB: le cue con «it» dentro vengono prese da un lettore che cerca un numero per
% il pronome («What number should I use for «it»?»), quindi la lezione non
% arriva. Le forme senza pronome sono quelle che passano — e' un limite del
% dispatch, scritto qui perche' chi insegna sappia quale dire.
move_cue("say the purpose", say_purpose).
move_cue("name the purpose", say_purpose).
move_cue("di' lo scopo", say_purpose).
move_cue("say what it is for", say_purpose).
move_cue("tell me what it is for", say_purpose).
move_cue("say what problem it solves", say_purpose).
move_cue("di' a che cosa serve", say_purpose).
move_cue("say you don't know", decline_steps).
move_cue("admit you don't know", decline_steps).
move_cue("di' che non lo sai", decline_steps).

response_template(learned_plan_move, "Held: in that situation, move {order} is «{move}».").
response_template(learned_plan_move, it, "Tengo: in quella situazione, la mossa {order} è «{move}».").

% ══ gen507/38 — INSEGNARE I PASSI DI UNA PROCEDURA ════════════════════════
%
% Fino a qui parrot0 sapeva DICHIARARE di non avere i passi (giro /33) e
% ricavare qualcosa d'altro (/34, /37), ma i passi non si potevano dargli: la
% catena finiva in una lacuna nominata che nessuna frase poteva colmare. Con
% questa forma il cerchio si chiude — il muro dice che cosa manca, e quel che
% manca si insegna parlando.
%
%     > to make a raft you cut logs
%       Held: for raft, 1 is «cut logs».
%     > to make a raft you tie the logs together
%       Held: for raft, 2 is «tie the logs together».
%     > how do i make a raft?
%       1. Cut logs  2. Tie the logs together
%
% L'ordine non si dice: e' quello in cui i passi vengono insegnati, come quando
% si spiega qualcosa a voce. Chiedere a chi insegna di numerare sarebbe
% chiedergli di conoscere lo stato interno.
response_template(learned_ordered_item, "Held: for {subject}, {order} is «{object}».").
response_template(learned_ordered_item, it, "Tengo: per {subject}, {order} è «{object}».").

% ⚠ «to make X you …» NON si usa: quella superficie e' gia' del sintetizzatore
% di artefatti, che la legge come una RICHIESTA di produrre («I understood the
% request — produce «raft you cut logs»»). Non le si ruba il turno: si sceglie
% un'apertura che dichiara di essere una LEZIONE, non una domanda.
turn_form(teach_step, 1, text("step for")).
turn_form(teach_step, 2, slot(key)).
turn_form(teach_step, 3, text("is")).
turn_form(teach_step, 4, rest(text)).
turn_form(teach_step, 5, bind(relation, process_step)).
turn_form_mood(teach_step, statement).
turn_form_act(teach_step, assert_ordered).

turn_form(teach_step2, 1, text("passo per")).
turn_form(teach_step2, 2, slot(key)).
turn_form(teach_step2, 3, text("is")).
turn_form(teach_step2, 4, rest(text)).
turn_form(teach_step2, 5, bind(relation, process_step)).
turn_form_mood(teach_step2, statement).
turn_form_act(teach_step2, assert_ordered).

% ══ gen507/39 — INSEGNARE UNA TRADUZIONE ══════════════════════════════════
%
% `tr/2` e' una delle relazioni piu' cariche di conseguenze in tutta la KB: e'
% quella che porta una parola italiana dentro le classi inglesi, quindi ogni
% riga apre in italiano tutto cio' che quella parola tocca. Ed era l'unica di
% quel peso che si poteva solo scrivere in un file.
%
%     > the italian for raft is zattera
%       Held: raft tr zattera.
%     > quale zattera e piu lunga?   (da qui in avanti l'italiano vede la parola)
%
% ⚠ La superficie NON e' «X in italian is Y»: quella la prende il lettore che
% riconosce una richiesta di lingua («We can chat in either language»). Si
% dichiara un'apertura che e' una lezione, non un cambio di lingua.
response_template(learned_translation, "Held: «{object}» is how {subject} is said in that language.").
response_template(learned_translation, it, "Tengo: «{object}» è come si dice {subject} in quella lingua.").

turn_form(teach_tr, 1, text("the italian for")).
turn_form(teach_tr, 2, slot(subject)).
turn_form(teach_tr, 3, text("is")).
turn_form(teach_tr, 4, rest(object)).
turn_form(teach_tr, 5, bind(relation, tr)).
turn_form_mood(teach_tr, statement).
turn_form_act(teach_tr, assert_relation).
turn_form_reply(teach_tr, learned_translation).

turn_form(teach_tr_it, 1, text("in italiano")).
turn_form(teach_tr_it, 2, slot(subject)).
turn_form(teach_tr_it, 3, text("is")).
turn_form(teach_tr_it, 4, rest(object)).
turn_form(teach_tr_it, 5, bind(relation, tr)).
turn_form_mood(teach_tr_it, statement).
turn_form_act(teach_tr_it, assert_relation).
turn_form_reply(teach_tr_it, learned_translation).

% ══ gen507/40 — INSEGNARE CHE DUE RELAZIONI SONO L'UNA L'INVERSA DELL'ALTRA ══
%
% «smith owner zelnik» e «zelnik belongs smith» sono UN FATTO SOLO detto dai due
% lati, e parrot0 ne teneva uno e non rispondeva sull'altro. Il ponte non e' una
% regola per coppia: e' una proprieta' della coppia, e si dice una volta.
%
%     > owner is the inverse of belongs
%     > smith owner zelnik
%     > does zelnik belongs smith?   ->  Yes.
%
% `inverse_relation/2` si legge nei due sensi, perche' essere l'inverso e'
% simmetrico: chi insegna non deve scegliere l'ordine giusto.
machinery(inverse_relation).
response_template(learned_inverse, "Held: {subject} and {object} are one fact seen from the two sides.").
response_template(learned_inverse, it, "Tengo: {subject} e {object} sono un fatto solo visto dai due lati.").

turn_form(teach_inverse, 1, slot(subject)).
turn_form(teach_inverse, 2, text("is the inverse of")).
turn_form(teach_inverse, 3, rest(object)).
turn_form(teach_inverse, 4, bind(relation, inverse_relation)).
turn_form_mood(teach_inverse, statement).
turn_form_act(teach_inverse, assert_relation).
turn_form_reply(teach_inverse, learned_inverse).

turn_form(teach_inverse2, 1, slot(subject)).
turn_form(teach_inverse2, 2, text("is the other side of")).
turn_form(teach_inverse2, 3, rest(object)).
turn_form(teach_inverse2, 4, bind(relation, inverse_relation)).
turn_form_mood(teach_inverse2, statement).
turn_form_act(teach_inverse2, assert_relation).
turn_form_reply(teach_inverse2, learned_inverse).

% ══ gen507/41 — INSEGNARE CHE UNA RELAZIONE VALE NEI DUE VERSI ════════════
%
% «zelnik somiglia a grum» dice anche che grum somiglia a zelnik. Ma non tutte
% le relazioni si girano — «zelnik e' piu' grande di grum» no — quindi il motore
% sa SCAMBIARE i posti e non sa quando: quando lo dice la conoscenza. Terza
% proprieta' di relazione insegnabile, dopo la transitivita' (/27) e l'inverso
% (/40); insieme coprono le tre domande che si fanno su una relazione nuova.
machinery(symmetric_relation).
response_template(learned_symmetric, "Held: {subject} goes both ways -- if a {subject} b then b {subject} a.").
response_template(learned_symmetric, it, "Tengo: {subject} vale nei due versi — se a {subject} b allora b {subject} a.").

turn_form(teach_symmetric, 1, slot(subject)).
turn_form(teach_symmetric, 2, text("goes both ways")).
turn_form(teach_symmetric, 3, bind(class, symmetric_relation)).
turn_form_mood(teach_symmetric, statement).
turn_form_act(teach_symmetric, assert_unary).
turn_form_reply(teach_symmetric, learned_symmetric).

turn_form(teach_symmetric_it, 1, slot(subject)).
turn_form(teach_symmetric_it, 2, text("vale nei due versi")).
turn_form(teach_symmetric_it, 3, bind(class, symmetric_relation)).
turn_form_mood(teach_symmetric_it, statement).
turn_form_act(teach_symmetric_it, assert_unary).
turn_form_reply(teach_symmetric_it, learned_symmetric).

% ══ gen507/42 — INSEGNARE UN PRIMATO DEL MONDO ════════════════════════════
%
% Il giro /30 ha riempito `world_superlative/3` da 11 a 86 coppie, ma DA FILE:
% un primato nuovo costava un commit. Il motore dei superlativi e' guidato dai
% fatti, quindi bastava aprire la porta.
%
%     > the deepest cave is krubera
%       Held: among cave, the deepest is «krubera».
%     > which cave is the deepest?  ->  krubera.
response_template(learned_superlative, "Held: among {order}, the {subject} is «{object}».").
response_template(learned_superlative, it, "Tengo: fra {order}, il più {subject} è «{object}».").

turn_form(teach_superlative, 1, text("the")).
turn_form(teach_superlative, 2, slot(arg1)).
turn_form(teach_superlative, 3, slot(arg2)).
turn_form(teach_superlative, 4, text("is")).
turn_form(teach_superlative, 5, rest(arg3)).
turn_form(teach_superlative, 6, bind(relation, world_superlative)).
turn_form_mood(teach_superlative, statement).
turn_form_act(teach_superlative, assert_ternary).

% ══ gen507/43 — PROCEDURE COMPLESSE: INSEGNARLE ED ESEGUIRLE ══════════════
%
% F., 2026-09-10: «rendi insegnabili anche procedure complesse — per esempio
% come estrarre le vocali da una parola — tecnicamente lui dovra' storare nella
% KB le procedure: KB-first significa anche procedure e processi nella KB».
%
% Una procedura complessa non e' un operatore complesso: e' una CATENA di
% operatori semplici, ed e' la catena che si insegna.
%
%     > step for vowels is keep vowel
%     > apply vowels to parrot          ->  vowels(parrot) = «ao».
%     > step for shout is keep consonant
%     > step for shout is upper
%     > apply shout to parrot           ->  shout(parrot) = «PRRT».
%
% Gli operatori sono pochi apposta — tenere, togliere, contare, rovesciare,
% tagliare, alzare/abbassare. Quali CARATTERI stiano in una classe e'
% conoscenza: «vocale» non e' scritto nel C, e una classe nuova (le consonanti
% di un'altra lingua, le cifre pari) e' una riga di .p0 e da subito un
% operatore in piu' da comporre.
machinery(proc_step).
machinery(char_class).

char_class(vowel, a). char_class(vowel, e). char_class(vowel, i).
char_class(vowel, o). char_class(vowel, u).
char_class(vowel, "à"). char_class(vowel, "è"). char_class(vowel, "é").
char_class(vowel, "ì"). char_class(vowel, "ò"). char_class(vowel, "ù").
char_class(consonant, b). char_class(consonant, c). char_class(consonant, d).
char_class(consonant, f). char_class(consonant, g). char_class(consonant, h).
char_class(consonant, j). char_class(consonant, k). char_class(consonant, l).
char_class(consonant, m). char_class(consonant, n). char_class(consonant, p).
char_class(consonant, q). char_class(consonant, r). char_class(consonant, s).
char_class(consonant, t). char_class(consonant, v). char_class(consonant, w).
char_class(consonant, x). char_class(consonant, y). char_class(consonant, z).
char_class(digit, 0). char_class(digit, 1). char_class(digit, 2).
char_class(digit, 3). char_class(digit, 4). char_class(digit, 5).
char_class(digit, 6). char_class(digit, 7). char_class(digit, 8).
char_class(digit, 9).

response_template(procedure_result, "{subject}(«{object}») — that is what the steps give.").
response_template(procedure_result, it, "{subject}(«{object}») — è quello che danno i passi.").

% Definire un passo della procedura: la stessa forma dei passi di una ricetta
% (giro /38), con un'altra relazione. Un piano, una ricetta e una procedura sono
% la stessa figura: una chiave e una lista in ordine.
% ⚠ NON «step for X»: e' gia' la superficie dei passi di una RICETTA (giro /38),
% e le due lezioni finivano in relazioni diverse con la stessa frase — chi vince
% dipendeva dall'ordine di enumerazione. La distinzione e' anche giusta nel
% merito: un passo di ricetta e' un'istruzione a una persona, un passo di
% procedura e' una REGOLA di trasformazione che parrot0 esegue.
turn_form(teach_proc, 1, text("rule for")).
turn_form(teach_proc, 2, slot(key)).
turn_form(teach_proc, 3, text("is")).
turn_form(teach_proc, 4, rest(text)).
turn_form(teach_proc, 5, bind(relation, proc_step)).
turn_form_mood(teach_proc, statement).
turn_form_act(teach_proc, assert_ordered).

turn_form(run_proc, 1, text("apply")).
turn_form(run_proc, 2, slot(key)).
turn_form(run_proc, 3, text("to")).
turn_form(run_proc, 4, rest(text)).
turn_form_act(run_proc, run_procedure).

turn_form(run_proc_it, 1, text("applica")).
turn_form(run_proc_it, 2, slot(key)).
turn_form(run_proc_it, 3, text("a")).
turn_form(run_proc_it, 4, rest(text)).
turn_form_act(run_proc_it, run_procedure).

% ══ gen507/44 (forma #7) — DIRE CHE UNA CLASSE E' FINITA ══════════════════
%
% Finche' una classe riceve membri uno alla volta e' APERTA, e il fallimento
% della prova vale «non l'ho derivato», mai «no». Ma certe classi sono chiuse
% per natura, e chi lo sa puo' dirlo:
%
%     > the vowels are a, e, i, o and u
%       Held: those are all 5 vowels there are: a, e, i, o, u.
%     > is a a vowel?   ->  Yes.
%     > is k a vowel?   ->  No.        (guadagnato, non «non so»)
%
% Pone i membri E dichiara che sono tutti, perche' a voce e' una cosa sola.
% Separarle lascerebbe una classe elencata ma ancora aperta — sembra completa e
% risponde «non so», il peggiore dei due mondi.
response_template(learned_closed_extension, "Held: those are all {count} {klass}s there are: {list}. From now on «no» is an answer, not a shrug.").
response_template(learned_closed_extension, it, "Tengo: sono tutti — i {klass} sono {count}: {list}. Da qui in poi «no» è una risposta, non un'alzata di spalle.").

turn_form(teach_closed, 1, text("the")).
turn_form(teach_closed, 2, slot(key)).
turn_form(teach_closed, 3, text("are")).
turn_form(teach_closed, 4, rest(text)).
turn_form_mood(teach_closed, statement).
turn_form_act(teach_closed, assert_closed_extension).

% ══ gen507/45 (forma #2) — UNA RELAZIONE CHE HA UN VALORE SOLO ════════════
% Se `V` ne ammette uno e per quel soggetto se ne tiene un altro, il «no» e'
% guadagnato: non serve elencare il mondo, basta sapere che il posto e'
% occupato. E' cio' che il giro /16 fa per gli attributi, portato a QUALUNQUE
% relazione.
machinery(functional_relation).
response_template(learned_functional, "Held: {subject} has one value -- a second one is a correction, not another fact.").
response_template(learned_functional, it, "Tengo: {subject} ha un valore solo — un secondo valore è una correzione, non un fatto in più.").

turn_form(teach_functional, 1, slot(subject)).
turn_form(teach_functional, 2, text("has one value")).
turn_form(teach_functional, 3, bind(class, functional_relation)).
turn_form_mood(teach_functional, statement).
turn_form_act(teach_functional, assert_unary).
turn_form_reply(teach_functional, learned_functional).

% ══ gen507/46 (forma #3) — UNA RELAZIONE NE IMPLICA UN'ALTRA ══════════════
% «essere madre» implica «essere genitore»: chi tiene la prima risponde anche
% sulla seconda, e nessuno deve ripetere i fatti. L'implicazione ha UN VERSO —
% il contrario non vale — quindi la forma lo dice esplicitamente.
machinery(implies_relation).
response_template(learned_implication, "Held: if a {subject} b then a {object} b -- one way only.").
response_template(learned_implication, it, "Tengo: se a {subject} b allora a {object} b — in un verso solo.").

turn_form(teach_implies, 1, slot(subject)).
turn_form(teach_implies, 2, text("implies")).
turn_form(teach_implies, 3, rest(object)).
turn_form(teach_implies, 4, bind(relation, implies_relation)).
turn_form_mood(teach_implies, statement).
turn_form_act(teach_implies, assert_relation).
turn_form_reply(teach_implies, learned_implication).

% ══ gen507/47 (forma #4) — DUE RELAZIONI CHE NON VALGONO INSIEME ══════════
% «X precede Y» esclude «X segue Y»: chi tiene la prima ha gia' la risposta
% sulla seconda. E' il modo piu' fertile di guadagnare un «no» — una sola
% esclusione risponde per tutte le coppie, presenti e future — e si legge nei
% due sensi, perche' escludersi e' reciproco.
machinery(excludes_relation).
response_template(learned_exclusion_rel, "Held: {subject} and {object} cannot both hold -- one rules the other out.").
response_template(learned_exclusion_rel, it, "Tengo: {subject} e {object} non possono valere insieme — l'una esclude l'altra.").

turn_form(teach_excludes, 1, slot(subject)).
turn_form(teach_excludes, 2, text("rules out")).
turn_form(teach_excludes, 3, rest(object)).
turn_form(teach_excludes, 4, bind(relation, excludes_relation)).
turn_form_mood(teach_excludes, statement).
turn_form_act(teach_excludes, assert_relation).
turn_form_reply(teach_excludes, learned_exclusion_rel).

% ══ gen507/48 (forma #1) — UNA RELAZIONE CHE VALE DI SE' STESSA ═══════════
% «X e' grande almeno quanto X» e' vero senza che nessuno lo dica; «X e' piu'
% grande di X» no. Quale relazione sia riflessiva e' conoscenza.
machinery(reflexive_relation).
response_template(learned_reflexive, "Held: everything {subject} itself.").
response_template(learned_reflexive, it, "Tengo: ogni cosa {subject} se stessa.").

turn_form(teach_reflexive, 1, slot(subject)).
turn_form(teach_reflexive, 2, text("holds of itself")).
turn_form(teach_reflexive, 3, bind(class, reflexive_relation)).
turn_form_mood(teach_reflexive, statement).
turn_form_act(teach_reflexive, assert_unary).
turn_form_reply(teach_reflexive, learned_reflexive).

% ══ gen507/49 (forma #24) — INSEGNARE UN PLURALE IRREGOLARE ═══════════════
% `plural_of/2` decide se una parola e' plurale, e da li' l'accordo, la
% singolarizzazione e mezza dozzina di lettori. Le irregolari si scrivevano in
% un file: ora una parola nuova costa una frase.
%
%     > the plural of mouse is mice
%     > how many mice are there?     (da qui «mice» si riduce a «mouse»)
response_template(learned_plural, "Held: «{subject}» is the plural of «{object}».").
response_template(learned_plural, it, "Tengo: «{subject}» è il plurale di «{object}».").

turn_form(teach_plural, 1, text("the plural of")).
turn_form(teach_plural, 2, slot(object)).
turn_form(teach_plural, 3, text("is")).
turn_form(teach_plural, 4, rest(subject)).
turn_form(teach_plural, 5, bind(relation, plural_of)).
turn_form_mood(teach_plural, statement).
turn_form_act(teach_plural, assert_relation).
turn_form_reply(teach_plural, learned_plural).

% ══ gen507/50 (forma #25) — INSEGNARE UNA FORMA VERBALE IRREGOLARE ════════
% Le regole di suffisso arrivano a «owns» e non a «owned»/«ate»/«went»: quelle
% sono FATTI della lingua. `irregular_verb_form/2` esisteva ed era scrivibile
% solo in un file — e il debito del giro /14 («owns» che non si legava a «own»)
% e' esattamente di questa famiglia.
response_template(learned_verb_form, "Held: «{object}» is another form of «{subject}».").
response_template(learned_verb_form, it, "Tengo: «{object}» è un'altra forma di «{subject}».").

turn_form(teach_verbform, 1, text("the past of")).
turn_form(teach_verbform, 2, slot(subject)).
turn_form(teach_verbform, 3, text("is")).
turn_form(teach_verbform, 4, rest(object)).
turn_form(teach_verbform, 5, bind(relation, irregular_verb_form)).
turn_form_mood(teach_verbform, statement).
turn_form_act(teach_verbform, assert_relation).
turn_form_reply(teach_verbform, learned_verb_form).

turn_form(teach_verbform2, 1, text("another form of")).
turn_form(teach_verbform2, 2, slot(subject)).
turn_form(teach_verbform2, 3, text("is")).
turn_form(teach_verbform2, 4, rest(object)).
turn_form(teach_verbform2, 5, bind(relation, irregular_verb_form)).
turn_form_mood(teach_verbform2, statement).
turn_form_act(teach_verbform2, assert_relation).
turn_form_reply(teach_verbform2, learned_verb_form).

% ══ gen507/53 (forma #44) — INSEGNARE UNA CLASSE DI CARATTERI ═════════════
% Gli operatori delle procedure (giro /43) lavorano su CLASSI di caratteri, e le
% classi erano righe di file: `keep vowel` funzionava, `keep sibilant` no, e non
% c'era modo di dirlo. Ora una classe nuova e' una frase, e da subito e' un
% operatore in piu' da comporre.
%
%     > the sibilant letters are s, z, sh
%     > rule for hiss is keep sibilant
%     > apply hiss to mississippi   ->  ssssss
response_template(learned_many, "Held: {count} more in {klass}: {list}.").
response_template(learned_many, it, "Tengo: {count} in più in {klass}: {list}.").

turn_form(teach_charclass, 1, text("the")).
turn_form(teach_charclass, 2, slot(key)).
turn_form(teach_charclass, 3, text("letters are")).
turn_form(teach_charclass, 4, rest(text)).
turn_form(teach_charclass, 5, bind(relation, char_class)).
turn_form_mood(teach_charclass, statement).
turn_form_act(teach_charclass, assert_many).

% ══ gen507/59-60 (forme #83, #87) — ELENCARE E DISFARE LE PROCEDURE ═══════
% Una procedura insegnata e' conoscenza come un fatto: come un fatto va potuta
% ELENCARE (senza, chi insegna non sa che cosa ha gia' dato) e RITRATTARE (una
% lezione che non si puo' disfare non e' una lezione, e' un vincolo).
response_template(known_keys, "I know how to: {list}.").
response_template(known_keys, it, "So fare: {list}.").
response_template(known_situations, "Situations I have a plan for: {list}.").
response_template(known_situations, it, "Situazioni per cui ho un piano: {list}.").
response_template(forgot_ordered, "Forgotten: all {count} steps of {subject}.").
response_template(forgot_ordered, it, "Dimenticato: tutti i {count} passi di {subject}.").

turn_form(list_procs, 1, text("what procedures do you know")).
turn_form(list_procs, 2, bind(relation, proc_step)).
turn_form_act(list_procs, list_keys).

turn_form(list_procs_it, 1, text("che procedure sai")).
turn_form(list_procs_it, 2, bind(relation, proc_step)).
turn_form_act(list_procs_it, list_keys).

turn_form(forget_proc, 1, text("forget the procedure")).
turn_form(forget_proc, 2, slot(key)).
turn_form(forget_proc, 3, bind(relation, proc_step)).
turn_form_mood(forget_proc, statement).
turn_form_act(forget_proc, retract_ordered).

% ══ gen507/61 (forme #91, #92) — CHIEDERE LA PROPRIA CONDOTTA ═════════════
% Un piano si poteva insegnare (giro /36) e guardare con `/debug`, ma non
% CHIEDERE. Sono due cose diverse: `/debug` e' per chi sviluppa, la domanda e'
% per chi insegna — e chi insegna deve poter verificare che la lezione sia
% arrivata senza aprire uno strumento.
response_template(plan_recited, "When that happens I: {list}.").
response_template(plan_recited, it, "Quando succede: {list}.").

% ⚠ NON «what do you do when …»: quella superficie e' del registro delle
% capacita', che risponde con l'elenco di cio' che parrot0 sa fare. Si dichiara
% un'apertura che chiede una CONDOTTA, non un inventario.
turn_form(ask_plan, 1, text("your plan when")).
turn_form(ask_plan, 2, named(situation_cue, situation)).
turn_form_act(ask_plan, recite_plan).

turn_form(ask_plan_it, 1, text("il tuo piano quando")).
turn_form(ask_plan_it, 2, named(situation_cue, situation)).
turn_form_act(ask_plan_it, recite_plan).

turn_form(list_situations, 1, text("what situations do you know")).
turn_form(list_situations, 2, bind(relation, plan_move)).
turn_form_act(list_situations, list_keys).
turn_form_reply(list_situations, known_situations).

% ══ gen507/62 (forma #66) — LA PRIMA FORMA A COSTO ZERO DI C ══════════════
%
% Da qui un'abilita' nuova e' UNA RIGA. L'atto non e' piu' un'etichetta che il C
% smista in un `case`: e' un TERMINE — un'operazione della KB applicata a una
% lista di argomenti che la forma nomina.
%
%     turn_form_act(Forma, op(Operazione, Predicato, [Argomenti])).
%
% Operazioni: assert · assert_neg · retract · retract_all · match · count.
% Argomenti: il nome di uno slot, oppure `free` (il posto della risposta),
% oppure `next` (il prossimo indice libero, per tutto cio' che e' ordinato).
response_template(forgot_fact, "Forgotten: {subject} {relation} {object}.").
response_template(forgot_fact, it, "Dimenticato: {subject} {relation} {object}.").

turn_form(forget_fact, 1, text("forget that")).
turn_form(forget_fact, 2, slot(subject)).
turn_form(forget_fact, 3, relation(relation)).
turn_form(forget_fact, 4, rest(object)).
turn_form_mood(forget_fact, statement).
turn_form_act(forget_fact, "op(retract, relation, [subject, object])").
turn_form_reply(forget_fact, forgot_fact).

% ══ gen507/63 (forma #8) — DUE NOMI, UNA COSA SOLA ════════════════════════
% «X e Y sono la stessa cosa»: da li' cio' che si dice di uno vale per l'altro,
% perche' il lettore risolve l'alias prima di cercare. Non e' un fatto sul
% mondo, e' un fatto sui NOMI — e finora si poteva solo scrivere in un file.
%
% ⚠ Provato prima con «how many things does X V?»: quella superficie e' gia'
% di un lettore che enumera, e risponde bene. Non gliela si ruba.
response_template(learned_identity, "Held: «{surface}» and «{concept}» name the same thing.").
response_template(learned_identity, it, "Tengo: «{surface}» e «{concept}» nominano la stessa cosa.").

% L'ORDINE DEGLI ARGOMENTI E' PARTE DELLA LEZIONE: `entity_alias(Superficie,
% Concetto)` va dal nome NUOVO a quello che parrot0 gia' conosce. Scritto al
% contrario la riga entra e non serve a niente — ed e' stato il primo tentativo.
turn_form(teach_identity, 1, slot(surface)).
turn_form(teach_identity, 2, text("and")).
turn_form(teach_identity, 3, slot(concept)).
turn_form(teach_identity, 4, text("name the same thing")).
turn_form_mood(teach_identity, statement).
turn_form_act(teach_identity, "op(assert, entity_alias, [surface, concept])").
turn_form_reply(teach_identity, learned_identity).

% ══ gen507/64 (forma #26) — INSEGNARE UNA DEFINIZIONE A PAROLE ════════════
% `means/2` e' la glossa che parrot0 rende quando gli si chiede che cosa sia una
% cosa, e c'erano centinaia di righe scritte a mano e nessun modo di aggiungerne
% una parlando. Il valore si conserva CITATO, perche' una definizione e' testo:
% l'atto lo cita da se' quando l'argomento porta piu' parole.
%
% ⚠ Non «X means Y» (e' del maestro delle costruzioni, «x V y means x W y») e
% NEMMENO «the meaning of X is …», che e' del lettore di analisi letteraria:
% risponde con una lettura ravvicinata. Terza superficie provata, e la regola si
% conferma — quella piu' naturale e' quasi sempre gia' di qualcun altro.
response_template(learned_meaning, "Held: {subject} — {object}.").
response_template(learned_meaning, it, "Tengo: {subject} — {object}.").

turn_form(teach_meaning, 1, slot(subject)).
turn_form(teach_meaning, 2, text("is defined as")).
turn_form(teach_meaning, 3, rest(object)).
turn_form_mood(teach_meaning, statement).
turn_form_act(teach_meaning, "op(assert, means, [subject, object])").
turn_form_reply(teach_meaning, learned_meaning).

% gen507/65 (forma #63) — chi compare in una relazione. Serve a chi insegna:
% dopo una lezione si vuole vedere che cosa c'e' dentro, non solo che il singolo
% fatto risponde.
response_template(relation_subjects, "In {relation} I hold {count}: {result}.").
response_template(relation_subjects, it, "In {relation} ne tengo {count}: {result}.").

turn_form(list_relation, 1, text("who appears in")).
turn_form(list_relation, 2, relation(relation)).
turn_form_mood(list_relation, question).
turn_form_act(list_relation, "op(match, relation, [free, free])").
turn_form_reply(list_relation, relation_subjects).

% ══ gen507/66 (forme #84, #86) — CORREGGERE E TOGLIERE UN PASSO ═══════════
% `rule for X is …` ACCODA: giusto quando si insegna, inutile quando ci si e'
% sbagliati. Senza un modo di correggere, un passo storto costava disfare tutta
% la procedura (giro /60) e rifarla da capo.
response_template(step_replaced, "Held: step {order} of {key} is now «{text}».").
response_template(step_replaced, it, "Tengo: il passo {order} di {key} adesso è «{text}».").
response_template(step_removed, "Removed step {order} of {key}.").
response_template(step_removed, it, "Tolto il passo {order} di {key}.").

turn_form(fix_step, 1, text("step")).
turn_form(fix_step, 2, slot(order)).
turn_form(fix_step, 3, text("of")).
turn_form(fix_step, 4, slot(key)).
turn_form(fix_step, 5, text("is now")).
turn_form(fix_step, 6, rest(text)).
turn_form_mood(fix_step, statement).
% DUE operazioni, in ordine: togliere il passo che c'era e mettere quello
% nuovo. Correggere non e' asserire — con un atto solo il vecchio restava e il
% nuovo non arrivava mai in esecuzione.
turn_form_act(fix_step, "op(retract_all, proc_step, [key, order, free])").
turn_form_act(fix_step, "op(assert, proc_step, [key, order, text])").
turn_form_reply(fix_step, step_replaced).

turn_form(drop_step, 1, text("remove step")).
turn_form(drop_step, 2, slot(order)).
turn_form(drop_step, 3, text("of")).
turn_form(drop_step, 4, slot(key)).
turn_form_mood(drop_step, statement).
turn_form_act(drop_step, "op(retract_all, proc_step, [key, order, free])").
turn_form_reply(drop_step, step_removed).

% ══ gen507/69 (forma #13) — INSEGNARE UNA MISURA SU UNA SCALA ═════════════
%
% `magnitude(Dimensione, Cosa, Numero)` e' la scala su cui parrot0 confronta e
% ordina: e' quella che risponde ai superlativi e ai «quale dei due». Era
% scrivibile solo in un file, quindi una cosa nuova non entrava mai nelle
% classifiche — e le classifiche sono il posto dove la conoscenza si mette in
% relazione con se' stessa invece di stare ferma.
%
%     > krubera has depth 2197
%     > the deepest cave is krubera    (e da qui i confronti funzionano)
response_template(learned_magnitude, "Held: {subject} scores {object} on {order}.").
response_template(learned_magnitude, it, "Tengo: {subject} vale {object} su {order}.").

turn_form(teach_magnitude, 1, slot(subject)).
turn_form(teach_magnitude, 2, text("has")).
turn_form(teach_magnitude, 3, slot(order)).
turn_form(teach_magnitude, 4, rest(object)).
turn_form_mood(teach_magnitude, statement).
turn_form_act(teach_magnitude, "op(assert, magnitude, [order, subject, object])").
turn_form_reply(teach_magnitude, learned_magnitude).

% E la PAROLA del confronto: `compare_cue(Parola, Dimensione, Verso)` mappa
% «piu' profondo» sulla scala e sul verso in cui si legge. Insegnare una misura
% senza poter insegnare la parola che la interroga sarebbe conoscenza muta: la
% scala esisterebbe e nessuna domanda ci arriverebbe.
response_template(learned_compare_cue, "Held: «{subject}» ranks by {order}.").
response_template(learned_compare_cue, it, "Tengo: «{subject}» ordina per {order}.").

turn_form(teach_cmp_max, 1, slot(subject)).
turn_form(teach_cmp_max, 2, text("is the most")).
turn_form(teach_cmp_max, 3, rest(order)).
turn_form_mood(teach_cmp_max, statement).
turn_form_act(teach_cmp_max, "op(assert, compare_cue, [subject, order, max])").
turn_form_reply(teach_cmp_max, learned_compare_cue).

turn_form(teach_cmp_min, 1, slot(subject)).
turn_form(teach_cmp_min, 2, text("is the least")).
turn_form(teach_cmp_min, 3, rest(order)).
turn_form_mood(teach_cmp_min, statement).
turn_form_act(teach_cmp_min, "op(assert, compare_cue, [subject, order, min])").
turn_form_reply(teach_cmp_min, learned_compare_cue).

% gen507/71 (forma #10) — l'OPPOSTO di una cosa. `opposite/2` risponde gia' a
% «what is the opposite of X?» e si poteva solo scrivere in un file.
response_template(learned_opposite, "Held: the opposite of {subject} is {object}.").
response_template(learned_opposite, it, "Tengo: il contrario di {subject} è {object}.").

turn_form(teach_opposite, 1, slot(subject)).
turn_form(teach_opposite, 2, text("is the opposite of")).
turn_form(teach_opposite, 3, rest(object)).
turn_form_mood(teach_opposite, statement).
turn_form_act(teach_opposite, "op(assert, opposite, [subject, object])").
turn_form_act(teach_opposite, "op(assert, opposite, [object, subject])").
turn_form_reply(teach_opposite, learned_opposite).

% ══ gen507/72 (forme #93, #38) — CORREGGERE E DISFARE UN PIANO ════════════
% Un piano si poteva insegnare (giro /36) e leggere (giro /61), non CAMBIARE:
% una mossa sbagliata restava, e l'unico rimedio era insegnare la sua correzione
% in coda — dove non veniva mai eseguita. Stessa cura dei passi di procedura
% (giro /66): togliere e mettere sono due operazioni, e una forma le dichiara
% entrambe.
response_template(move_replaced, "Held: move {order} for {situation} is now «{move}».").
response_template(move_replaced, it, "Tengo: la mossa {order} per {situation} adesso è «{move}».").
response_template(plan_forgotten, "Forgotten: the plan for {situation}.").
response_template(plan_forgotten, it, "Dimenticato: il piano per {situation}.").

turn_form(fix_move, 1, text("move")).
turn_form(fix_move, 2, slot(order)).
turn_form(fix_move, 3, text("for")).
turn_form(fix_move, 4, named(situation_cue, situation)).
turn_form(fix_move, 5, text("is now")).
turn_form(fix_move, 6, named(move_cue, move)).
turn_form_mood(fix_move, statement).
turn_form_act(fix_move, "op(retract_all, plan_move, [situation, order, free])").
turn_form_act(fix_move, "op(assert, plan_move, [situation, order, move])").
turn_form_reply(fix_move, move_replaced).

% ⚠ Non «forget the plan for …»: quella superficie la prende il consulente di
% progettazione, che risponde con una lettura sul disegno di sistemi. Quarta
% volta che la formulazione ovvia e' gia' occupata.
% ⛔ FORMA DICHIARATA E MAI RAGGIUNTA — lasciata scritta con la ragione.
% Tre superfici provate, tre lettori diversi che le prendono prima:
%   «forget the plan for …»      -> il consulente di progettazione (parola «plan»)
%   «unlearn the plan for …»     -> lo stesso
%   «unlearn what you do when …» -> il lettore delle procedure
% La regione di superficie attorno a «piano» e «cosa fai quando» e' satura. Non
% si ruba il turno a nessuno dei tre: la forma resta qui, pronta, e chi trovera'
% una superficie libera dovra' solo cambiare questa riga.
turn_form(forget_plan, 1, text("unlearn what you do when")).
turn_form(forget_plan, 2, named(situation_cue, situation)).
turn_form_mood(forget_plan, statement).
turn_form_act(forget_plan, "op(retract_all, plan_move, [situation, free, free])").
turn_form_reply(forget_plan, plan_forgotten).

% gen507/73 (forma #78) — una proprieta' della SPECIE, che i membri ereditano.
% `has_prop/2` alimenta `inherits/2` (procedures.p0), che risale anche le
% sottoclassi: dirlo una volta della specie vale per ogni membro presente e
% futuro, ed e' la differenza fra insegnare un fatto e insegnare una regola.
response_template(learned_class_prop, "Held: every {subject} is {object} -- and so is each one I meet.").
response_template(learned_class_prop, it, "Tengo: ogni {subject} è {object} — e così ciascuno che incontro.").

turn_form(teach_class_prop, 1, slot(subject)).
turn_form(teach_class_prop, 2, text("are typically")).
turn_form(teach_class_prop, 3, rest(object)).
turn_form_mood(teach_class_prop, statement).
turn_form_act(teach_class_prop, "op(assert, has_prop, [subject, object])").
turn_form_reply(teach_class_prop, learned_class_prop).

% E il ponte che serviva perche' l'ereditarieta' arrivi: `category_member/2`.
% «X e' un Y» pone il predicato unario `Y(X)`, che risponde alle domande di
% classe ma NON entra in `is_a/2`, e quindi non fa scattare `inherits/2`. Le due
% conoscenze sono diverse — una dice a che classe appartiene, l'altra la mette
% nella tassonomia percorribile — e finora la seconda si scriveva solo in un
% file.
response_template(learned_membership, "Held: {object} is one of the {subject} -- it inherits what they have.").
response_template(learned_membership, it, "Tengo: {object} è uno dei {subject} — eredita quello che hanno.").

% Il nome della classe si dice al SINGOLARE, perche' e' la chiave con cui la
% tassonomia e le proprieta' la nominano: «one of the falcons» avrebbe messo il
% membro sotto `falcons` e la proprieta' sotto `falcon`, due mucchi diversi.
turn_form(teach_member, 1, slot(object)).
turn_form(teach_member, 2, text("is a member of")).
turn_form(teach_member, 3, rest(subject)).
turn_form_mood(teach_member, statement).
% Due operazioni: il legame percorribile della tassonomia E il predicato unario
% che risponde alle domande di classe. Sono due conoscenze diverse sullo stesso
% fatto, e a voce si dicono in una frase sola.
turn_form_act(teach_member, "op(assert, category_member, [subject, object])").
turn_form_act(teach_member, "op(assert, subject, [object])").
turn_form_reply(teach_member, learned_membership).

% E la domanda che rende visibile l'eredita': `inherits/2` esisteva come regola
% e nessuna superficie ci arrivava. Una regola che nessuno puo' interrogare e'
% una regola che non si sa di avere.
response_template(inherited_props, "{subject} inherits: {result}.").
response_template(inherited_props, it, "{subject} eredita: {result}.").

turn_form(ask_inherit, 1, text("what does")).
turn_form(ask_inherit, 2, slot(subject)).
% ⚠ non «…from ITS kind»: il pronome manda il turno al lettore che cerca un
% numero («What number should I use for «its»?»). E' la trappola gia' scritta
% nel protocollo, incontrata per la seconda volta.
turn_form(ask_inherit, 3, text("get from the kind")).
turn_form_mood(ask_inherit, question).
turn_form_act(ask_inherit, "op(match, inherits, [subject, free])").
turn_form_reply(ask_inherit, inherited_props).

% gen507/74 (forma #27) — le SIGLE. Una sigla non e' un sinonimo qualsiasi: e'
% la forma corta che nei testi compare piu' spesso del nome esteso, e senza il
% ponte ogni frase che la usa e' un muro.
response_template(learned_abbrev, "Held: «{surface}» is short for «{concept}».").
response_template(learned_abbrev, it, "Tengo: «{surface}» sta per «{concept}».").

turn_form(teach_abbrev, 1, slot(surface)).
turn_form(teach_abbrev, 2, text("is short for")).
turn_form(teach_abbrev, 3, rest(concept)).
turn_form_mood(teach_abbrev, statement).
turn_form_act(teach_abbrev, "op(assert, entity_alias, [surface, concept])").
turn_form_reply(teach_abbrev, learned_abbrev).

% ══ gen507/75 (forma #17) — L'ORDINE NEL TEMPO ════════════════════════════
% «X viene prima di Y» non e' un fatto isolato: e' un fatto piu' due proprieta'
% — la catena si percorre e il verso opposto ha un nome. Dirle ogni volta
% sarebbe chiedere a chi insegna di ricordarsi la meccanica; la forma le
% dichiara insieme al fatto, e riasserirle non fa danno.
response_template(learned_precedes, "Held: {subject} comes before {object} -- and the chain carries.").
response_template(learned_precedes, it, "Tengo: {subject} viene prima di {object} — e la catena si percorre.").

turn_form(teach_before, 1, slot(subject)).
turn_form(teach_before, 2, text("comes before")).
turn_form(teach_before, 3, rest(object)).
turn_form_mood(teach_before, statement).
turn_form_act(teach_before, "op(assert, relation_verb, [precedes])").
turn_form_act(teach_before, "op(assert, relation_verb, [follows])").
turn_form_act(teach_before, "op(assert, transitive_relation, [precedes])").
turn_form_act(teach_before, "op(assert, inverse_relation, [precedes, follows])").
turn_form_act(teach_before, "op(assert, precedes, [subject, object])").
turn_form_reply(teach_before, learned_precedes).

% ══ gen507/76 — TRE FATTI DETTI DAL VERSO IN CUI UNA PERSONA LI DIREBBE ════
%
% `part_of/2`, `causes/2` e `kind_of/2` esistono e rispondono. Ma si potevano
% dire in un verso solo — «X e' parte di Y», «X causa Y» — e la lingua vera usa
% l'altro almeno quanto: si dice «il motore CONTIENE i pistoni» e «l'incendio E'
% CAUSATO da una scintilla». Chi insegna non deve girare la frase nella testa
% per accontentare la KB: l'atto la gira per lui, e i due versi vanno nello
% stesso posto.
response_template(learned_contains, "Held: {object} is part of {subject}.").
response_template(learned_contains, it, "Tengo: {object} fa parte di {subject}.").
response_template(learned_caused_by, "Held: {object} causes {subject}.").
response_template(learned_caused_by, it, "Tengo: {object} causa {subject}.").
response_template(learned_kind, "Held: {subject} is a kind of {object} -- and the chain of kinds carries.").
response_template(learned_kind, it, "Tengo: {subject} è un tipo di {object} — e la catena dei tipi si percorre.").

turn_form(teach_contains, 1, slot(subject)).
turn_form(teach_contains, 2, text("contains")).
turn_form(teach_contains, 3, rest(object)).
turn_form_mood(teach_contains, statement).
turn_form_act(teach_contains, "op(assert, part_of, [object, subject])").
turn_form_reply(teach_contains, learned_contains).

turn_form(teach_caused, 1, slot(subject)).
turn_form(teach_caused, 2, text("is caused by")).
turn_form(teach_caused, 3, rest(object)).
turn_form_mood(teach_caused, statement).
turn_form_act(teach_caused, "op(assert, causes, [object, subject])").
turn_form_reply(teach_caused, learned_caused_by).

turn_form(teach_kind, 1, slot(subject)).
turn_form(teach_kind, 2, text("is a kind of")).
turn_form(teach_kind, 3, rest(object)).
turn_form_mood(teach_kind, statement).
turn_form_act(teach_kind, "op(assert, kind_of, [subject, object])").
turn_form_reply(teach_kind, learned_kind).

% ══ gen507/77 — QUATTRO RELAZIONI DEL MONDO, FINALMENTE DICIBILI ══════════
% `wrote/2`, `borders/2`, `currency_of/2`, `chemical_symbol/2` hanno centinaia
% di fatti e tutti scritti a mano: parrot0 sapeva rispondere e non sapeva
% imparare. E' la forma piu' comune di conoscenza chiusa in questa KB — non una
% capacita' che manca, una porta che non c'e'.
response_template(learned_wrote, "Held: {subject} wrote {object}.").
response_template(learned_wrote, it, "Tengo: {subject} ha scritto {object}.").
response_template(learned_borders, "Held: {subject} and {object} share a border.").
response_template(learned_borders, it, "Tengo: {subject} e {object} confinano.").
response_template(learned_currency, "Held: {subject} pays in {object}.").
response_template(learned_currency, it, "Tengo: {subject} paga in {object}.").
response_template(learned_symbol, "Held: {object} is written {subject}.").
response_template(learned_symbol, it, "Tengo: {object} si scrive {subject}.").

turn_form(teach_wrote, 1, slot(subject)).
turn_form(teach_wrote, 2, text("wrote")).
turn_form(teach_wrote, 3, rest(object)).
turn_form_mood(teach_wrote, statement).
turn_form_act(teach_wrote, "op(assert, wrote, [subject, object])").
turn_form_reply(teach_wrote, learned_wrote).

% Confinare e' reciproco: due operazioni, una frase.
turn_form(teach_borders, 1, slot(subject)).
turn_form(teach_borders, 2, text("borders")).
turn_form(teach_borders, 3, rest(object)).
turn_form_mood(teach_borders, statement).
turn_form_act(teach_borders, "op(assert, borders, [subject, object])").
turn_form_act(teach_borders, "op(assert, borders, [object, subject])").
turn_form_reply(teach_borders, learned_borders).

turn_form(teach_currency, 1, slot(subject)).
turn_form(teach_currency, 2, text("pays in")).
turn_form(teach_currency, 3, rest(object)).
turn_form_mood(teach_currency, statement).
turn_form_act(teach_currency, "op(assert, currency_of, [subject, object])").
turn_form_reply(teach_currency, learned_currency).

turn_form(teach_symbol, 1, slot(subject)).
turn_form(teach_symbol, 2, text("is the symbol for")).
turn_form(teach_symbol, 3, rest(object)).
turn_form_mood(teach_symbol, statement).
turn_form_act(teach_symbol, "op(assert, chemical_symbol, [object, subject])").
turn_form_reply(teach_symbol, learned_symbol).

% ══ gen507/78 — LE ULTIME QUATTRO PORTE DI QUESTO LOTTO ═══════════════════
% Stessa diagnosi delle quattro precedenti: relazioni popolate a mano, risposte
% che funzionano, e nessun modo di aggiungere una riga parlando.
response_template(learned_capital, "Held: the capital of {subject} is {object}.").
response_template(learned_capital, it, "Tengo: la capitale di {subject} è {object}.").
response_template(learned_sound, "Held: a {subject} goes «{object}».").
response_template(learned_sound, it, "Tengo: un {subject} fa «{object}».").
response_template(learned_continent, "Held: {subject} is in {object}.").
response_template(learned_continent, it, "Tengo: {subject} è in {object}.").
response_template(learned_purpose2, "Held: {subject} is for {object}.").
response_template(learned_purpose2, it, "Tengo: {subject} serve a {object}.").

turn_form(teach_capital, 1, slot(object)).
turn_form(teach_capital, 2, text("is the capital of")).
turn_form(teach_capital, 3, rest(subject)).
turn_form_mood(teach_capital, statement).
turn_form_act(teach_capital, "op(assert, capital_of_country, [subject, object])").
turn_form_reply(teach_capital, learned_capital).

turn_form(teach_sound, 1, slot(subject)).
turn_form(teach_sound, 2, text("goes")).
turn_form(teach_sound, 3, rest(object)).
turn_form_mood(teach_sound, statement).
turn_form_act(teach_sound, "op(assert, sound_of, [subject, object])").
turn_form_reply(teach_sound, learned_sound).

turn_form(teach_continent, 1, slot(subject)).
turn_form(teach_continent, 2, text("lies in the continent")).
turn_form(teach_continent, 3, rest(object)).
turn_form_mood(teach_continent, statement).
turn_form_act(teach_continent, "op(assert, continent_of, [subject, object])").
turn_form_reply(teach_continent, learned_continent).

turn_form(teach_purpose2, 1, slot(subject)).
turn_form(teach_purpose2, 2, text("is there to")).
turn_form(teach_purpose2, 3, rest(object)).
turn_form_mood(teach_purpose2, statement).
turn_form_act(teach_purpose2, "op(assert, purpose_of, [subject, object])").
turn_form_reply(teach_purpose2, learned_purpose2).

% ══ gen507/79 — UNA RELAZIONE CON TUTTA LA SUA SCHEDA, IN UNA FRASE ═══════
%
% I giri /27, /40, /41, /45, /46, /48 hanno reso insegnabili le sette proprieta'
% di una relazione, e insieme sono la scheda che conviene compilare su ogni
% relazione nuova. Ma compilarla vuol dire ricordarsi sette frasi, e chi insegna
% non deve conoscere la meccanica: la combinazione piu' frequente — una catena
% con un verso opposto, come «prima/dopo», «sopra/sotto», «antenato/discendente»
% — si dice in una riga sola.
%
%     > ancestor chains with opposite descendant
%       Held: ancestor chains, and its other side is descendant.
%
% Cinque operazioni dietro una frase. E' la stessa mossa del giro /75 su
% `precedes`, resa generale: li' la scheda era cablata in una forma per UNA
% relazione, qui la relazione la nomina chi insegna.
response_template(learned_chain_pair, "Held: {subject} chains, and its other side is {object}.").
response_template(learned_chain_pair, it, "Tengo: {subject} si concatena, e il suo verso opposto è {object}.").

turn_form(teach_chain_pair, 1, slot(subject)).
turn_form(teach_chain_pair, 2, text("chains with opposite")).
turn_form(teach_chain_pair, 3, rest(object)).
turn_form_mood(teach_chain_pair, statement).
turn_form_act(teach_chain_pair, "op(assert, relation_verb, [subject])").
turn_form_act(teach_chain_pair, "op(assert, relation_verb, [object])").
turn_form_act(teach_chain_pair, "op(assert, transitive_relation, [subject])").
turn_form_act(teach_chain_pair, "op(assert, transitive_relation, [object])").
turn_form_act(teach_chain_pair, "op(assert, inverse_relation, [subject, object])").
turn_form_reply(teach_chain_pair, learned_chain_pair).

% ══ gen507/80 (superficie superiore #1) — UNA RELAZIONE E' UN'ALTRA, IN UN
% CONTESTO ════════════════════════════════════════════════════════════════
%
% La prima superficie che non insegna un FATTO ne' una proprieta' di una
% relazione, ma un LEGAME FRA DUE RELAZIONI, valido dentro un contesto:
%
%     > in sport plays stands for belongs
%     > messi plays miami
%     > does messi belongs miami?   ->  Yes.
%
% Chi insegna parla il vocabolario del proprio dominio — «gioca per» — e non
% deve tradurlo in quello di parrot0. Il ponte lo attraversa `holds/3` con
% `apply/2`: il motore non sa quali relazioni si implichino, lo chiede.
response_template(learned_context_alias, "Held: in {order}, «{subject}» is a way of saying «{object}».").
response_template(learned_context_alias, it, "Tengo: in {order}, «{subject}» è un modo di dire «{object}».").

turn_form(teach_ctx_alias, 1, text("in")).
turn_form(teach_ctx_alias, 2, slot(order)).
turn_form(teach_ctx_alias, 3, slot(subject)).
% ⚠ non «means»: e' il pivot del maestro delle costruzioni.
turn_form(teach_ctx_alias, 4, text("stands for")).
turn_form(teach_ctx_alias, 5, rest(object)).
turn_form_mood(teach_ctx_alias, statement).
turn_form_act(teach_ctx_alias, "op(assert, relation_verb, [subject])").
turn_form_act(teach_ctx_alias, "op(assert, relation_verb, [object])").
turn_form_act(teach_ctx_alias, "op(assert, context_alias, [order, subject, object])").
turn_form_reply(teach_ctx_alias, learned_context_alias).

% (superficie superiore #2) — la specializzazione con vincolo di classe.
response_template(learned_scoped_alias, "Held: for a {order}, «{subject}» counts as «{object}».").
response_template(learned_scoped_alias, it, "Tengo: per un {order}, «{subject}» vale come «{object}».").

turn_form(teach_scoped, 1, text("for a")).
turn_form(teach_scoped, 2, slot(order)).
turn_form(teach_scoped, 3, slot(subject)).
turn_form(teach_scoped, 4, text("counts as")).
turn_form(teach_scoped, 5, rest(object)).
turn_form_mood(teach_scoped, statement).
turn_form_act(teach_scoped, "op(assert, relation_verb, [subject])").
turn_form_act(teach_scoped, "op(assert, relation_verb, [object])").
turn_form_act(teach_scoped, "op(assert, class_scoped_alias, [order, subject, object])").
turn_form_reply(teach_scoped, learned_scoped_alias).

% (superficie superiore #3) — una relazione si comporta come un'altra: eredita
% la sua SCHEDA (transitiva, simmetrica, riflessiva, funzionale) senza che
% nessuno la ripeta. Il predicato variabile applicato alle proprieta'.
response_template(learned_relation_like, "Held: «{subject}» behaves like «{object}» -- it takes its properties.").
response_template(learned_relation_like, it, "Tengo: «{subject}» si comporta come «{object}» — ne prende le proprietà.").

turn_form(teach_like, 1, slot(subject)).
turn_form(teach_like, 2, text("behaves like")).
turn_form(teach_like, 3, rest(object)).
turn_form_mood(teach_like, statement).
turn_form_act(teach_like, "op(assert, relation_verb, [subject])").
turn_form_act(teach_like, "op(assert, relation_like, [subject, object])").
turn_form_reply(teach_like, learned_relation_like).

% (superficie superiore #4) — una CLASSE DEFINITA da una relazione, invece che
% elencata. «Un genitore e' chi ha un figlio»: non una lista, una regola.
response_template(learned_class_rule, "Held: anything with a {object} is a {subject}.").
response_template(learned_class_rule, it, "Tengo: chi ha un {object} è un {subject}.").

% ⚠ Ne' «a X is anything that V» ne' «X is anything that V» arrivano: il turno
% e' preso prima da chi registra una parola sconosciuta. La forma si apre con
% una parola che dichiara di essere una definizione.
turn_form(teach_class_rule, 1, text("whoever")).
turn_form(teach_class_rule, 2, slot(object)).
turn_form(teach_class_rule, 3, text("is a")).
turn_form(teach_class_rule, 4, rest(subject)).
turn_form_mood(teach_class_rule, statement).
turn_form_act(teach_class_rule, "op(assert, relation_verb, [object])").
turn_form_act(teach_class_rule, "op(assert, class_from_relation, [subject, object])").
turn_form_reply(teach_class_rule, learned_class_rule).

% (superficie superiore #5) — una RELAZIONE DEFINITA DA DUE: insegnare una
% REGOLA invece di un fatto. E' il mantra #19 applicato alle relazioni: la
% congiunzione si dichiara, non si compila.
response_template(learned_rel_and, "Held: {subject_said} holds wherever both {order_said} and {object_said} hold.").
response_template(learned_rel_and, it, "Tengo: {subject_said} vale dove valgono sia {order_said} sia {object_said}.").

% gen508: gli operandi sono ESPRESSIONI (`expr`), non piu' un token: «mutual
% holds where both likes and flipped likes» annida una costruzione, e «reciprocal
% x holds where both x and flipped x» definisce una costruzione parametrica.
turn_form(teach_rel_and, 1, expr(subject)).
turn_form(teach_rel_and, 2, text("holds where both")).
turn_form(teach_rel_and, 3, expr(order)).
turn_form(teach_rel_and, 4, text("and")).
turn_form(teach_rel_and, 5, expr(object)).
turn_form_mood(teach_rel_and, statement).
turn_form_act(teach_rel_and, "op(assert, relation_verb, [subject])").
turn_form_act(teach_rel_and, "op(assert, relation_and, [subject, order, object])").
turn_form_reply(teach_rel_and, learned_rel_and).

% (superficie superiore #6) — e la disgiunzione.
response_template(learned_rel_or, "Held: {subject_said} holds wherever {object_said} holds.").
response_template(learned_rel_or, it, "Tengo: {subject_said} vale ovunque valga {object_said}.").

turn_form(teach_rel_or, 1, expr(subject)).
turn_form(teach_rel_or, 2, text("holds wherever")).
turn_form(teach_rel_or, 3, expr(object)).
turn_form_mood(teach_rel_or, statement).
turn_form_act(teach_rel_or, "op(assert, relation_verb, [subject])").
turn_form_act(teach_rel_or, "op(assert, relation_or, [subject, object])").
turn_form_reply(teach_rel_or, learned_rel_or).

% (superficie superiore #7) — LA COMPOSIZIONE. «nonno» e' «genitore» seguito da
% «genitore»: due relazioni note ne definiscono una terza che nessuno popola.
response_template(learned_rel_chain, "Held: {subject_said} is {order_said} followed by {object_said}.").
response_template(learned_rel_chain, it, "Tengo: {subject_said} è {order_said} seguito da {object_said}.").

turn_form(teach_rel_chain, 1, expr(subject)).
turn_form(teach_rel_chain, 2, text("is")).
turn_form(teach_rel_chain, 3, expr(order)).
turn_form(teach_rel_chain, 4, text("followed by")).
turn_form(teach_rel_chain, 5, expr(object)).
turn_form_mood(teach_rel_chain, statement).
turn_form_act(teach_rel_chain, "op(assert, relation_verb, [subject])").
turn_form_act(teach_rel_chain, "op(assert, relation_chain, [subject, order, object])").
turn_form_reply(teach_rel_chain, learned_rel_chain).

% (superficie superiore #8) — L'ECCEZIONE DETTA INSIEME ALLA REGOLA, invece di
% una regola falsa che qualcuno correggera' poi.
response_template(learned_rel_unless, "Held: {subject_said} holds where {order_said} holds, except where {object_said} does.").
response_template(learned_rel_unless, it, "Tengo: {subject_said} vale dove vale {order_said}, tranne dove vale {object_said}.").

turn_form(teach_rel_unless, 1, expr(subject)).
turn_form(teach_rel_unless, 2, text("holds where")).
turn_form(teach_rel_unless, 3, expr(order)).
turn_form(teach_rel_unless, 4, text("holds except where")).
turn_form(teach_rel_unless, 5, expr(object)).
turn_form_mood(teach_rel_unless, statement).
turn_form_act(teach_rel_unless, "op(assert, relation_verb, [subject])").
turn_form_act(teach_rel_unless, "op(assert, relation_unless, [subject, order, object])").
turn_form_reply(teach_rel_unless, learned_rel_unless).

% (superficie superiore #9) — LA SCHEDA DI UNA RELAZIONE. Dopo cinque lezioni su
% una relazione si vuole vedere che cosa parrot0 ne ha capito, e finora l'unico
% modo era leggere i file.
response_template(relation_card, "About «{subject}» I hold {count}: {result}.").
response_template(relation_card, it, "Di «{subject}» tengo {count}: {result}.").

turn_form(ask_rel_card, 1, text("tell me about the relation")).
turn_form(ask_rel_card, 2, slot(subject)).
turn_form_act(ask_rel_card, "op(match, relation_note, [subject, free])").
turn_form_reply(ask_rel_card, relation_card).

% (superficie superiore #10) — quali relazioni conosce.
response_template(relation_list, "I hold {count} relations: {result}.").
response_template(relation_list, it, "Tengo {count} relazioni: {result}.").

turn_form(ask_rel_list, 1, text("what relations do you know")).
turn_form(ask_rel_list, 2, bind(relation, relation_verb)).
turn_form_act(ask_rel_list, "op(match, relation, [free])").
turn_form_reply(ask_rel_list, relation_list).

% (superficie superiore #11) — UN FATTO SOSPESO, che vale solo in un contesto.
response_template(learned_ctx_fact, "Held, but only in {order}: {subject} {relation} {object}.").
response_template(learned_ctx_fact, it, "Tengo, ma solo in {order}: {subject} {relation} {object}.").

turn_form(teach_ctx_fact, 1, text("in")).
turn_form(teach_ctx_fact, 2, slot(order)).
turn_form(teach_ctx_fact, 3, slot(subject)).
turn_form(teach_ctx_fact, 4, relation(relation)).
turn_form(teach_ctx_fact, 5, rest(object)).
turn_form_mood(teach_ctx_fact, statement).
turn_form_act(teach_ctx_fact, "op(assert, context_fact, [order, relation, subject, object])").
turn_form_reply(teach_ctx_fact, learned_ctx_fact).

% (superficie superiore #12) — ENTRARE E USCIRE DA UN CONTESTO. Senza questa, i
% fatti sospesi restano sospesi per sempre.
response_template(context_entered, "Now reasoning inside {subject}.").
response_template(context_entered, it, "Adesso ragiono dentro {subject}.").
response_template(context_left, "Out of {subject}.").
response_template(context_left, it, "Fuori da {subject}.").

turn_form(enter_ctx, 1, text("assume")).
turn_form(enter_ctx, 2, rest(subject)).
turn_form_mood(enter_ctx, statement).
turn_form_act(enter_ctx, "op(assert, active_context, [subject])").
turn_form_reply(enter_ctx, context_entered).

turn_form(leave_ctx, 1, text("stop assuming")).
turn_form(leave_ctx, 2, rest(subject)).
turn_form_mood(leave_ctx, statement).
turn_form_act(leave_ctx, "op(retract, active_context, [subject])").
turn_form_reply(leave_ctx, context_left).

% (superficie superiore #13) — TUTTO CIO' CHE SI PUO' DIRE DI UNA COSA: il
% predicato variabile usato per guardarsi intorno invece che per rispondere.
response_template(about_list, "About {subject} I can say {count} things: {result}.").
response_template(about_list, it, "Di {subject} posso dire {count} cose: {result}.").

turn_form(ask_about, 1, text("what can you say about")).
turn_form(ask_about, 2, slot(subject)).
turn_form_act(ask_about, "op(match, about, [subject, free, free])").
turn_form_reply(ask_about, about_list).

% (superficie superiore #14) — che cosa lega due cose.
response_template(between_list, "Between {subject} and {object} I hold {count}: {result}.").
response_template(between_list, it, "Fra {subject} e {object} tengo {count}: {result}.").

turn_form(ask_between, 1, text("what holds between")).
turn_form(ask_between, 2, slot(subject)).
turn_form(ask_between, 3, text("and")).
turn_form(ask_between, 4, rest(object)).
turn_form_act(ask_between, "op(match, between_rel, [subject, object, free])").
turn_form_reply(ask_between, between_list).

% (superficie superiore #15) — la FIRMA di una relazione: dove ha senso.
response_template(learned_signature, "Held: {subject} goes from a {order} to a {object}.").
response_template(learned_signature, it, "Tengo: {subject} va da un {order} a un {object}.").

turn_form(teach_signature, 1, slot(subject)).
turn_form(teach_signature, 2, text("links a")).
turn_form(teach_signature, 3, slot(order)).
turn_form(teach_signature, 4, text("to a")).
turn_form(teach_signature, 5, rest(object)).
turn_form_mood(teach_signature, statement).
turn_form_act(teach_signature, "op(assert, relation_verb, [subject])").
turn_form_act(teach_signature, "op(assert, relation_signature, [subject, order, object])").
turn_form_reply(teach_signature, learned_signature).

% (superficie superiore #16) — la composizione con se' stessa, detta in breve.
response_template(learned_twice, "Held: {subject_said} is {object_said} applied twice.").
response_template(learned_twice, it, "Tengo: {subject_said} è {object_said} applicato due volte.").

turn_form(teach_twice, 1, expr(subject)).
turn_form(teach_twice, 2, text("is")).
turn_form(teach_twice, 3, expr(object)).
turn_form(teach_twice, 4, text("twice")).
turn_form_mood(teach_twice, statement).
turn_form_act(teach_twice, "op(assert, relation_verb, [subject])").
turn_form_act(teach_twice, "op(assert, relation_twice, [subject, object])").
turn_form_reply(teach_twice, learned_twice).

% (superficie superiore #17) — un nome che vale solo dentro un contesto.
response_template(learned_ctx_name, "Held: inside {order}, «{subject}» is {object}.").
response_template(learned_ctx_name, it, "Tengo: dentro {order}, «{subject}» è {object}.").

turn_form(teach_ctx_name, 1, text("inside")).
turn_form(teach_ctx_name, 2, slot(order)).
turn_form(teach_ctx_name, 3, slot(subject)).
turn_form(teach_ctx_name, 4, text("is")).
turn_form(teach_ctx_name, 5, rest(object)).
turn_form_mood(teach_ctx_name, statement).
turn_form_act(teach_ctx_name, "op(assert, context_name, [order, subject, object])").
turn_form_reply(teach_ctx_name, learned_ctx_name).

% (superficie superiore #18) — il verso rovescio dentro `holds/3`, cosi' compone
% con i contesti e le catene.
response_template(learned_reverse, "Held: {subject_said} is {object_said} read backwards.").
response_template(learned_reverse, it, "Tengo: {subject_said} è {object_said} letto al contrario.").

turn_form(teach_reverse, 1, expr(subject)).
turn_form(teach_reverse, 2, text("is")).
turn_form(teach_reverse, 3, expr(object)).
turn_form(teach_reverse, 4, text("read backwards")).
turn_form_mood(teach_reverse, statement).
turn_form_act(teach_reverse, "op(assert, relation_verb, [subject])").
turn_form_act(teach_reverse, "op(assert, relation_reverse, [subject, object])").
turn_form_reply(teach_reverse, learned_reverse).

% (superficie superiore #19) — la FAMIGLIA di una relazione.
response_template(learned_family, "Held: {subject} is a {object} relation.").
response_template(learned_family, it, "Tengo: {subject} è una relazione {object}.").

turn_form(teach_family, 1, slot(subject)).
turn_form(teach_family, 2, text("is a relation of kind")).
turn_form(teach_family, 3, rest(object)).
turn_form_mood(teach_family, statement).
turn_form_act(teach_family, "op(assert, relation_family, [subject, object])").
turn_form_reply(teach_family, learned_family).

% (superficie superiore #20) — DISFARE un legame di ordine superiore. Senza,
% una somiglianza dichiarata per sbaglio resta per sempre, e propaga proprieta'
% che nessuno voleva.
response_template(unlearned_like, "Forgotten: {subject} no longer behaves like {object}.").
response_template(unlearned_like, it, "Dimenticato: {subject} non si comporta più come {object}.").

turn_form(unteach_like, 1, text("forget that")).
turn_form(unteach_like, 2, slot(subject)).
turn_form(unteach_like, 3, text("behaves like")).
turn_form(unteach_like, 4, rest(object)).
turn_form_mood(unteach_like, statement).
turn_form_act(unteach_like, "op(retract, relation_like, [subject, object])").
turn_form_reply(unteach_like, unlearned_like).

% ══ gen508 — LA DEFINIZIONE E' UN'ESPRESSIONE (docs/plans/due-strutture-kb-viva.md §3)
%
% Le superfici #5-#8, #16 e #18 leggono ora ESPRESSIONI (`expr`): ogni operando
% puo' essere un nome, una costruzione applicata («flipped likes») o la
% variabile di una lezione («x», `rule_variable/1`). Qui stanno le superfici
% che il linguaggio chiuso rende possibili: usare una costruzione, chiedere
% una definizione, e disfarla.

% (superficie superiore #21) — USARE UNA COSTRUZIONE. «friendship is reciprocal
% likes»: il nome della costruzione e' un dato (`use/2`), e `construct` tiene
% solo se la cima e' una costruzione gia' definita — «rex is a dog» non passa.
response_template(learned_def_use, "Held: {subject_said} is {object_said}.").
response_template(learned_def_use, it, "Tengo: {subject_said} è {object_said}.").

turn_form(teach_def_use, 1, expr(subject)).
turn_form(teach_def_use, 2, text("is")).
turn_form(teach_def_use, 3, construct(object)).
turn_form_mood(teach_def_use, statement).
turn_form_act(teach_def_use, "op(assert, relation_verb, [subject])").
turn_form_act(teach_def_use, "op(assert, relation_def, [subject, object])").
turn_form_reply(teach_def_use, learned_def_use).

% La stessa lezione con un'apertura che dichiara di essere una definizione:
% «define friendship as reciprocal likes». Come «whoever» per la #4, e' la
% superficie che non puo' essere presa prima da chi registra una parola nuova.
turn_form(teach_def_as, 1, text("define")).
turn_form(teach_def_as, 2, expr(subject)).
turn_form(teach_def_as, 3, text("as")).
turn_form(teach_def_as, 4, expr(object)).
turn_form_mood(teach_def_as, statement).
turn_form_act(teach_def_as, "op(assert, relation_verb, [subject])").
turn_form_act(teach_def_as, "op(assert, relation_def, [subject, object])").
turn_form_reply(teach_def_as, learned_def_use).

% (superficie superiore #22) — CHIEDERE LA DEFINIZIONE, resa per intero.
response_template(relation_definition, "«{subject}» is defined as: {result}.").
response_template(relation_definition, it, "«{subject}» è definita così: {result}.").

turn_form(ask_rel_def, 1, text("how is")).
turn_form(ask_rel_def, 2, slot(subject)).
turn_form(ask_rel_def, 3, text("defined")).
turn_form_act(ask_rel_def, "op(match, relation_def_words, [subject, free])").
turn_form_reply(ask_rel_def, relation_definition).

turn_form(ask_rel_def2, 1, text("what is the definition of")).
turn_form(ask_rel_def2, 2, slot(subject)).
turn_form_act(ask_rel_def2, "op(match, relation_def_words, [subject, free])").
turn_form_reply(ask_rel_def2, relation_definition).

% (superficie superiore #23) — DISFARE UNA DEFINIZIONE, dicendola di nuovo.
% Vale per una relazione concreta e per una costruzione parametrica: tolta la
% lezione «flipped x is x read backwards», ogni «flipped R» smette di valere.
response_template(unlearned_definition, "Forgotten: {subject_said} is no longer defined that way.").
response_template(unlearned_definition, it, "Dimenticato: {subject_said} non è più definita così.").

turn_form(unteach_rel_and, 1, text("forget that")).
turn_form(unteach_rel_and, 2, expr(subject)).
turn_form(unteach_rel_and, 3, text("holds where both")).
turn_form(unteach_rel_and, 4, expr(order)).
turn_form(unteach_rel_and, 5, text("and")).
turn_form(unteach_rel_and, 6, expr(object)).
turn_form_mood(unteach_rel_and, statement).
turn_form_act(unteach_rel_and, "op(retract, relation_and, [subject, order, object])").
turn_form_reply(unteach_rel_and, unlearned_definition).

turn_form(unteach_rel_or, 1, text("forget that")).
turn_form(unteach_rel_or, 2, expr(subject)).
turn_form(unteach_rel_or, 3, text("holds wherever")).
turn_form(unteach_rel_or, 4, expr(object)).
turn_form_mood(unteach_rel_or, statement).
turn_form_act(unteach_rel_or, "op(retract, relation_or, [subject, object])").
turn_form_reply(unteach_rel_or, unlearned_definition).

turn_form(unteach_rel_chain, 1, text("forget that")).
turn_form(unteach_rel_chain, 2, expr(subject)).
turn_form(unteach_rel_chain, 3, text("is")).
turn_form(unteach_rel_chain, 4, expr(order)).
turn_form(unteach_rel_chain, 5, text("followed by")).
turn_form(unteach_rel_chain, 6, expr(object)).
turn_form_mood(unteach_rel_chain, statement).
turn_form_act(unteach_rel_chain, "op(retract, relation_chain, [subject, order, object])").
turn_form_reply(unteach_rel_chain, unlearned_definition).

turn_form(unteach_rel_unless, 1, text("forget that")).
turn_form(unteach_rel_unless, 2, expr(subject)).
turn_form(unteach_rel_unless, 3, text("holds where")).
turn_form(unteach_rel_unless, 4, expr(order)).
turn_form(unteach_rel_unless, 5, text("holds except where")).
turn_form(unteach_rel_unless, 6, expr(object)).
turn_form_mood(unteach_rel_unless, statement).
turn_form_act(unteach_rel_unless, "op(retract, relation_unless, [subject, order, object])").
turn_form_reply(unteach_rel_unless, unlearned_definition).

turn_form(unteach_reverse, 1, text("forget that")).
turn_form(unteach_reverse, 2, expr(subject)).
turn_form(unteach_reverse, 3, text("is")).
turn_form(unteach_reverse, 4, expr(object)).
turn_form(unteach_reverse, 5, text("read backwards")).
turn_form_mood(unteach_reverse, statement).
turn_form_act(unteach_reverse, "op(retract, relation_reverse, [subject, object])").
turn_form_reply(unteach_reverse, unlearned_definition).

turn_form(unteach_twice, 1, text("forget that")).
turn_form(unteach_twice, 2, expr(subject)).
turn_form(unteach_twice, 3, text("is")).
turn_form(unteach_twice, 4, expr(object)).
turn_form(unteach_twice, 5, text("twice")).
turn_form_mood(unteach_twice, statement).
turn_form_act(unteach_twice, "op(retract, relation_twice, [subject, object])").
turn_form_reply(unteach_twice, unlearned_definition).

turn_form(unteach_def_use, 1, text("forget that")).
turn_form(unteach_def_use, 2, expr(subject)).
turn_form(unteach_def_use, 3, text("is")).
turn_form(unteach_def_use, 4, construct(object)).
turn_form_mood(unteach_def_use, statement).
turn_form_act(unteach_def_use, "op(retract, relation_def, [subject, object])").
turn_form_reply(unteach_def_use, unlearned_definition).

% ══ gen508/2 — IL FATTO COME NODO A RUOLI APERTI (docs/plans/due-strutture-kb-viva.md §2)
%
% Le istanze si dicono come membri («sale1 is a sale») e i ruoli con il lettore
% che c'era gia' («the seller of sale1 is anna»); qui stanno le superfici che
% aprono lo SCHEMA, le proiezioni e le viste, e quelle che interrogano cio'
% che un'istanza ha e cio' che le manca.

% (superficie superiore #24) — LO SCHEMA: un ruolo di una relazione/evento.
response_template(learned_role, "Held: a {order} has a {object}.").
response_template(learned_role, it, "Tengo: un {order} ha un {object}.").

turn_form(teach_role, 1, text("a")).
turn_form(teach_role, 2, slot(order)).
turn_form(teach_role, 3, text("involves a")).
turn_form(teach_role, 4, slot(object)).
turn_form_mood(teach_role, statement).
turn_form_act(teach_role, "op(assert, relation_role, [order, object])").
turn_form_reply(teach_role, learned_role).

% (superficie superiore #25) — un ruolo RICHIESTO: senza, l'istanza e' incompleta.
response_template(learned_required_role, "Held: a {order} requires a {object}.").
response_template(learned_required_role, it, "Tengo: un {order} richiede un {object}.").

turn_form(teach_required_role, 1, text("a")).
turn_form(teach_required_role, 2, slot(order)).
turn_form(teach_required_role, 3, text("requires a")).
turn_form(teach_required_role, 4, slot(object)).
turn_form_mood(teach_required_role, statement).
turn_form_act(teach_required_role, "op(assert, relation_role, [order, object])").
turn_form_act(teach_required_role, "op(assert, required_role, [order, object])").
turn_form_reply(teach_required_role, learned_required_role).

% (superficie superiore #26) — LA PROIEZIONE: una relazione binaria che sceglie
% due ruoli di un'istanza. «sold_to links the seller of a sale to its buyer».
response_template(learned_projection, "Held: {subject} links the {role1} of a {order} to its {role2}.").
response_template(learned_projection, it, "Tengo: {subject} lega il {role1} di un {order} al suo {role2}.").

turn_form(teach_projection, 1, slot(subject)).
turn_form(teach_projection, 2, text("links the")).
turn_form(teach_projection, 3, slot(role1)).
turn_form(teach_projection, 4, text("of a")).
turn_form(teach_projection, 5, slot(order)).
turn_form(teach_projection, 6, text("to its")).
turn_form(teach_projection, 7, slot(role2)).
turn_form_mood(teach_projection, statement).
turn_form_act(teach_projection, "op(assert, relation_verb, [subject])").
turn_form_act(teach_projection, "op(assert, relation_projection, [subject, order, role1, role2])").
turn_form_reply(teach_projection, learned_projection).

% (superficie superiore #27) — e la proiezione CONDIZIONATA da un terzo ruolo:
% «sold_house links the seller of a sale to its buyer when its item is a house».
response_template(learned_projection_where, "Held: {subject} links the {role1} of a {order} to its {role2}, when its {role3} is a {class}.").
response_template(learned_projection_where, it, "Tengo: {subject} lega il {role1} di un {order} al suo {role2}, quando il suo {role3} è un {class}.").

turn_form(teach_projection_where, 1, slot(subject)).
turn_form(teach_projection_where, 2, text("links the")).
turn_form(teach_projection_where, 3, slot(role1)).
turn_form(teach_projection_where, 4, text("of a")).
turn_form(teach_projection_where, 5, slot(order)).
turn_form(teach_projection_where, 6, text("to its")).
turn_form(teach_projection_where, 7, slot(role2)).
turn_form(teach_projection_where, 8, text("when its")).
turn_form(teach_projection_where, 9, slot(role3)).
turn_form(teach_projection_where, 10, text("is a")).
turn_form(teach_projection_where, 11, slot(class)).
turn_form_mood(teach_projection_where, statement).
turn_form_act(teach_projection_where, "op(assert, relation_verb, [subject])").
turn_form_act(teach_projection_where, "op(assert, projection_condition, [subject, role3, class])").
turn_form_act(teach_projection_where, "op(assert, relation_projection, [subject, order, role1, role2])").
turn_form_reply(teach_projection_where, learned_projection_where).

% (superficie superiore #28) — UNA VISTA: lo stesso evento da un altro punto di
% vista, con i ruoli rinominati. «a purchase is a view of a sale», poi
% «in a purchase the seller is called the vendor».
response_template(learned_schema_view, "Held: a {subject} is a {object} seen from another side.").
response_template(learned_schema_view, it, "Tengo: un {subject} è un {object} visto da un altro lato.").

turn_form(teach_schema_view, 1, text("a")).
turn_form(teach_schema_view, 2, slot(subject)).
turn_form(teach_schema_view, 3, text("is a view of a")).
turn_form(teach_schema_view, 4, slot(object)).
turn_form_mood(teach_schema_view, statement).
turn_form_act(teach_schema_view, "op(assert, schema_view, [subject, object])").
turn_form_reply(teach_schema_view, learned_schema_view).

response_template(learned_role_alias, "Held: in a {order}, the {object} is called the {subject}.").
response_template(learned_role_alias, it, "Tengo: in un {order}, il {object} si chiama {subject}.").

turn_form(teach_role_alias, 1, text("in a")).
turn_form(teach_role_alias, 2, slot(order)).
turn_form(teach_role_alias, 3, text("the")).
turn_form(teach_role_alias, 4, slot(object)).
turn_form(teach_role_alias, 5, text("is called the")).
turn_form(teach_role_alias, 6, slot(subject)).
turn_form_mood(teach_role_alias, statement).
turn_form_act(teach_role_alias, "op(assert, role_alias, [order, subject, object])").
turn_form_reply(teach_role_alias, learned_role_alias).

% (superficie superiore #29) — LA SCHEDA DI UN'ISTANZA: ruoli noti e mancanti.
response_template(occurrence_card, "About {subject} I hold {count}: {result}.").
response_template(occurrence_card, it, "Di {subject} tengo {count}: {result}.").

turn_form(ask_occurrence, 1, text("describe")).
turn_form(ask_occurrence, 2, slot(subject)).
turn_form_act(ask_occurrence, "op(match, occurrence_note, [subject, free])").
turn_form_reply(ask_occurrence, occurrence_card).

% (superficie superiore #30) — CHE COSA MANCA: lo spazio negativo per ruoli.
response_template(missing_roles, "About {subject} I still miss {count}: {result}.").
response_template(missing_roles, it, "Di {subject} mi mancano ancora {count}: {result}.").

turn_form(ask_missing, 1, text("what is missing about")).
turn_form(ask_missing, 2, slot(subject)).
turn_form_act(ask_missing, "op(match, missing_role, [subject, free])").
turn_form_reply(ask_missing, missing_roles).

% (superficie superiore #31) — LA SCHEDA DI UNO SCHEMA.
response_template(schema_card, "A {subject} I hold {count}: {result}.").
response_template(schema_card, it, "Di un {subject} tengo {count}: {result}.").

turn_form(ask_schema, 1, text("what does a")).
turn_form(ask_schema, 2, slot(subject)).
turn_form(ask_schema, 3, text("involve")).
turn_form_act(ask_schema, "op(match, schema_note, [subject, free])").
turn_form_reply(ask_schema, schema_card).

% (superficie superiore #32) — DISFARE un ruolo o una proiezione.
response_template(unlearned_role, "Forgotten: a {order} no longer involves a {object}.").
response_template(unlearned_role, it, "Dimenticato: un {order} non ha più un {object}.").

turn_form(unteach_role, 1, text("forget that a")).
turn_form(unteach_role, 2, slot(order)).
turn_form(unteach_role, 3, text("involves a")).
turn_form(unteach_role, 4, slot(object)).
turn_form_mood(unteach_role, statement).
turn_form_act(unteach_role, "op(retract, required_role, [order, object])").
turn_form_act(unteach_role, "op(retract, relation_role, [order, object])").
turn_form_reply(unteach_role, unlearned_role).

turn_form(unteach_projection, 1, text("forget that")).
turn_form(unteach_projection, 2, slot(subject)).
turn_form(unteach_projection, 3, text("links the")).
turn_form(unteach_projection, 4, slot(role1)).
turn_form(unteach_projection, 5, text("of a")).
turn_form(unteach_projection, 6, slot(order)).
turn_form(unteach_projection, 7, text("to its")).
turn_form(unteach_projection, 8, slot(role2)).
turn_form_mood(unteach_projection, statement).
turn_form_act(unteach_projection, "op(retract, relation_projection, [subject, order, role1, role2])").
turn_form_reply(unteach_projection, unlearned_definition).

turn_form(unteach_projection_where, 1, text("forget that")).
turn_form(unteach_projection_where, 2, slot(subject)).
turn_form(unteach_projection_where, 3, text("links the")).
turn_form(unteach_projection_where, 4, slot(role1)).
turn_form(unteach_projection_where, 5, text("of a")).
turn_form(unteach_projection_where, 6, slot(order)).
turn_form(unteach_projection_where, 7, text("to its")).
turn_form(unteach_projection_where, 8, slot(role2)).
turn_form(unteach_projection_where, 9, text("when its")).
turn_form(unteach_projection_where, 10, slot(role3)).
turn_form(unteach_projection_where, 11, text("is a")).
turn_form(unteach_projection_where, 12, slot(class)).
turn_form_mood(unteach_projection_where, statement).
turn_form_act(unteach_projection_where, "op(retract, projection_condition, [subject, role3, class])").
turn_form_act(unteach_projection_where, "op(retract, relation_projection, [subject, order, role1, role2])").
turn_form_reply(unteach_projection_where, unlearned_definition).

turn_form(teach_plan, 1, text("when")).
turn_form(teach_plan, 2, named(situation_cue, situation)).
turn_form(teach_plan, 3, text("then")).
turn_form(teach_plan, 4, named(move_cue, move)).
turn_form_mood(teach_plan, statement).
turn_form_act(teach_plan, assert_plan_move).

% La forma italiana si dichiara su cio' che il LETTORE vede (lezione del giro
% /22): «quando» e' una parola funzione e arriva gia' come «when»; «allora» e'
% contenuto e resta. Non e' una forma inglese: e' l'italiano dopo la soglia.
turn_form(teach_plan_it, 1, text("when")).
turn_form(teach_plan_it, 2, named(situation_cue, situation)).
turn_form(teach_plan_it, 3, text("allora")).
turn_form(teach_plan_it, 4, named(move_cue, move)).
turn_form_mood(teach_plan_it, statement).
turn_form_act(teach_plan_it, assert_plan_move).
% ⚠ La forma italiana e' dichiarata ma NON arriva: lo smalltalk prende il turno
% prima. Non le rubo il posto (il dispatch e' first-match e le strutture
% secondarie si tengono): resta una lacuna scritta, non una forma vinta a forza.

% ── IL PIANO CHE IL GIRO /34 AVEVA SCRITTO IN C, ORA DETTO ────────────────
% Era una sequenza dentro una funzione; qui e' conoscenza, e si puo' cambiare
% parlando: togliere una mossa, aggiungerne una, invertirle.
plan_move(steps_missing, 1, list_composition).
% gen507/37 — SECONDA MOSSA, INSEGNATA PARLANDO e poi resa ufficiale.
% Detta in sessione con «when you have no steps then say the purpose», provata,
% e portata qui: cio' che parrot0 impara parlando diventa conoscenza curata, non
% resta in una sessione ([[autolearn-knowledge-is-official]]).
plan_move(steps_missing, 2, say_purpose).
% ⚠ `decline_steps` NON sta nel piano, e la ragione vale per ogni piano futuro:
% arrendersi non e' una mossa che si pianifica, e' quello che succede quando il
% piano si esaurisce — il declino onesto e' gia' li' dopo il ciclo. Metterlo
% dentro lo rendeva l'ULTIMA riga insegnabile: ogni mossa insegnata dopo di lui
% non veniva mai eseguita, perche' lui rispondeva sempre. Un piano che finisce
% con una mossa che non fallisce mai non e' piu' insegnabile.

machinery(why_cue).
why_cue("why").
why_cue("how come").
why_cue("how do you know").
why_cue("perche'").
why_cue("perché").
why_cue("come fai a sapere").
response_template(because_proof, "Because {proof}.").
response_template(because_proof, it, "Perché {proof}.").

machinery(correction_cue).
machinery(turn_correction).
% Un annuncio di correzione e' un'APERTURA di discorso: va sbucciato perche' la
% frase sotto si possa leggere, e va ricordato perche' chi la legge sappia che
% sostituisce invece di aggiungere (il fatto lo posa `99-registry.c`, dove la
% sbucciatura avviene). Sono parole che non hanno un altro mestiere nella
% frase: «no» non e' qui, perche' apre anche «no tool is a weapon».
correction_cue(correction).
% «actually» era gia' un'apertura di discorso E una stopword: veniva tolta due
% volte e nessuno conservava cio' che diceva. Ora che l'annuncio si posa sul
% turno intero, basta dichiararne il mestiere.
correction_cue(actually).
correction_cue(anzi).
correction_cue("i was wrong").
correction_cue("mi correggo").
discourse_opener(correction).
discourse_opener(anzi).
response_template(attribute_corrected, "Corrected: {thing} is {value} now, not {old}.").
response_template(attribute_corrected, it, "Corretto: {thing} è {value}, non {old}.").
% E senza annuncio non si sceglie in silenzio: si dice che le due non stanno
% insieme e si chiede quale vale. Tenere entrambe sarebbe tenere una bugia.
response_template(attribute_clash, "I already hold that {thing} is {old}, and a thing has one {prop}. Say «actually {thing} is {value}» and I will replace it.").
response_template(attribute_clash, it, "Tengo già che {thing} è {old}, e una cosa ha un solo {prop}. Dimmi «anzi {thing} è {value}» e lo sostituisco.").
response_template(enumeration_answer, "{list}.").
response_template(enumeration_empty, "I do not know any {noun} yet.").
response_template(enumeration_empty, it, "Non conosco ancora nessun {noun}.").
response_template(learned_properties, "Learned: {facts}.").
response_template(reasoning_steps, "By {steps} step{s} of reasoning: {ex}.").
response_template(induced_rules, "Induced: {rules}.").
response_template(prose_read_page_could_not_open_x, "I could not open {target}.").
response_template(i_couldn_t_store_that_2, "I couldn't store that.").
response_template(the_judge_ran_it_but_it_did_not_sort_every_ve, "The judge ran it, but it did not sort every vector.").
response_template(no_contract_authorizing_x, "I have no contract authorizing «{tool}».").
response_template(x_needs_one_of_its_authorized_subcommands, "«{tool}» needs one of its authorized subcommands.").
response_template(read_x_inside_the_workspace, "read {file} inside the workspace ({bytes} bytes{trunc})").

% gen491 — il PEZZO di frase per un fatto di classe, senza il portante
% «Learned: …», perche' entra in un elenco («whale is a mammal, whale is an
% animal»). Il portante resta `learned_facts`.
response_template(class_fact_phrase, "{arg} is {art} {cls}").

% Il gap di una lezione condizionale che non si ancora. Dire «Learned rule» per
% una regola le cui variabili di testa non compaiono nel corpo e' un misclaim:
% quella regola non puo' concludere niente di determinato.
response_template(rule_head_variable_unbound, "I could not anchor that rule: the conclusion about {head} talks about something the condition never mentions, so it could never conclude anything definite.").
response_template(rule_head_variable_unbound, it, "Non riesco ad ancorare quella regola: la conclusione su {head} parla di qualcosa che la condizione non nomina mai, quindi non potrebbe concludere niente di determinato.").

% Ritrattare una regola insegnata parlando. La capacita' se ne va; cio' che aveva
% dedotto mentre era viva resta — e' storia, non capacita'.
response_template(rule_forgotten, "Understood: I will no longer conclude {head} that way.").
response_template(rule_forgotten, it, "Capito: non concludero' piu' {head} in quel modo.").
response_template(rule_not_held, "I was not holding that rule about {head}.").
response_template(rule_not_held, it, "Non avevo quella regola su {head}.").

% Il gap di una misura non rispettata. Non e' una scusa: e' la dichiarazione che
% il turno chiedeva una forma che parrot0 non sa ancora produrre. Dirlo e' la
% metacomprensione; emettere comunque un testo che il turno aveva escluso e' il
% suo contrario.
response_template(size_constraint_unmet, "I could not put that in the shape you asked for, so I would rather say I cannot than give you something longer than you wanted.").
response_template(size_constraint_unmet, it, "Non sono riuscito a darlo nella forma che hai chiesto, e preferisco dirlo invece di darti qualcosa di piu' lungo di quanto volevi.").

% Il generatore di storie sa riempire uno schema, non raccontare. Quando il tema
% letto e' un sintagma e non un nome, lo schema lo ripeterebbe in ogni casella:
% dirlo e' l'unica risposta onesta, e raccontare di un personaggio di riserva
% sarebbe peggio — sarebbe un'invenzione al posto della risposta.
response_template(story_subject_unrenderable, "I read what you want the story to be about — {topic} — but I can only compose around a single named character yet, so I would be padding a template instead of telling it.").
response_template(story_subject_unrenderable, it, "Ho letto di che cosa vuoi la storia — {topic} — ma so comporre solo attorno a un personaggio con un nome, quindi riempirei uno schema invece di raccontarla.").

% gen502 — lo strumento di scrittura dice SEMPRE quanto ha scritto e se ha
% sovrascritto: «ho scritto» senza un numero e senza rilettura e' una promessa.
response_template(wrote_file_x_with_y_bytes_verified, "Wrote {name} — {bytes} bytes, verified by reading it back.").
response_template(rewrote_file_x_with_y_bytes_verified, "Rewrote {name} (it already existed) — {bytes} bytes, verified by reading it back.").
response_template(i_could_not_write_x_and_i_do_not_say_i_did, "I could not write {name}, and I will not say that I did.").
