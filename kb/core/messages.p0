% ── gen491: LA CONFERMA E' UNA FRASE, NON UN TERMINE ─────────────────────────
%
% Queste tre righe dicevano «Learned: located_in(book, table).» — e l'audit
% dell'eco (scripts/self_echo_audit.py) ha mostrato che rimandandogliela parrot0
% rispondeva «That looks like a snippet of code»: non riconosceva la propria
% notazione come propria. Due difetti in una riga sola — la risposta principale
% non era LINGUA, e non rientrava.
%
% ⚠ IL TESTO QUI DEVE COMBACIARE COL PATTERN DI LETTURA della stessa relazione
% (`extract_frame("@S is located in @O", located_in)` in grammar.p0). E' un
% accordo fra due righe, quindi e' fragile per natura: le relazioni SENZA una
% riga qui passano invece da `say_frame/2`, che costruisce la frase dal pattern
% stesso e non puo' divergere. Queste tre sono la struttura secondaria piu'
% vecchia; quando daranno fastidio si tolgono e restano solo i frame.
response_template(learned_created_by_x_x_x, "Learned: {subj2} was created by {obj2} ({canon}).").
response_template(learned_located_in_x_x, "Learned: {subj} is located in {obj}.").
response_template(learned_part_of_x_x, "Learned: {subj} is part of {obj}.").
response_template(you_haven_t_told_me_your_x_yet, "You haven't told me your {disp} yet.").
response_template(done_i_ve_let_go_of_your_x, "Done — I've let go of your {slotname}.").
response_template(learned_holds_x, "Learned: holds({slug}).").
