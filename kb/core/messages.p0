response_template(it_hangs_on_one_premise_if_i_learned_that_x, "It hangs on one premise: if I learned that {crit} were false, I'd stop concluding {last_goal_arg} is a {last_goal_pred}.").
response_template(telling_me_which_to_trust_you_ve_claimed_bot, "Telling me which to trust — you've claimed both that {last_goal_arg} is a {last_goal_pred} and that it is not. Retract one and I'd settle on the other.").
