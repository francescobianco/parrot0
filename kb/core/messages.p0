%% Ottava tranche: le frasi che venivano APPESE a un buffer, o il cui snprintf
%% serviva anche per il valore di ritorno. La frase esce in un buffer
%% temporaneo e l'append resta identico: cambia da dove viene il testo.

response_template(unknown_function_x_is_not_a_standard_c_libra, "Unknown function: «{t}» is not a standard C library function. Did you spell it correctly or forget an #include?").

% Gli ultimi messaggi convertiti a mano: la sonda non li prendeva perche' il
% Brain si chiama `tmp`, o perche' l'istruzione stava tutta su una riga dentro
% un `if`.
response_template(entailed_x_is_a_known_fact, "Entailed: {ex}.").
response_template(unknown_entailment, "Unknown.").
response_template(neutral_entailment, "Neutral.").
response_template(contradicted_entailment, "Contradicted.").
response_template(contradiction_entailment, "Contradiction.").
response_template(entailed_explanation, "Entailed: {ex}.").
response_template(learned_quantity, "Learned: {subject} has {amount} {unit}.").
response_template(learned_causal_relation, "Learned: causes({cause}, {effect}).").
% E la risposta a «what causes X?», che prima non esisteva: la forma esisteva
% solo come ASSERZIONE, quindi la domanda diventava un fatto falso.
response_template(cause_answer, "{causes}.").
response_template(learned_same_relation, "Learned: same({left}, {right}).").
response_template(learned_requires, "Learned: requires({goal}, {step}).").
response_template(because_proof, "Because {proof}.").
response_template(because_proof_existing_period, "Because {proof}").
response_template(compile_success, "Yes, it compiles: {path} has no errors.").
response_template(code_not_valid, "Not valid: {findings}.").
response_template(self_identity, "Yes, I am {id}.").
response_template(self_role_named, "I am a {kind} named {name}.").
response_template(self_role_kind, "I am a {kind}.").
response_template(self_role_name, "I am {name}.").
response_template(code_calls_answer, "I read it as code: {function} calls {callees}.").
response_template(self_trait_direct, "Yes, I {verb}.").
response_template(self_trait_general, "Yes, I do — I {verb}.").
response_template(color_answer, "It's {color}.").
response_template(animal_sound_answer, "A {animal} goes \"{sound}\".").
response_template(indefinite_entity_answer, "A {entity}.").
response_template(animal_eats_answer, "A {animal} eats {food}").
response_template(entity_kind_answer, "A {kind} is a {class}.").
response_template(part_of_answer, "Yes, {part} is part of {whole}.").
response_template(forgotten_fact, "Forgotten: {pred}({arg}).").
% SC32 — la meta' mancante dell'atto didattico. Una lezione che non si puo'
% togliere non e' una lezione, e il contratto di AGENTS.md la vuole simmetrica.
response_template(taught_form_forgotten, "Forgotten - «{phrase}» is no longer {label}.").
response_template(taught_form_not_held, "I wasn't holding «{phrase}» as {label}.").
response_template(learned_negative_fact, "Learned: not {pred}({arg}).").
response_template(learned_unary_fact, "Learned: {pred}({arg}).").
% La CLASSE si dice in lingua: il sito che la usa sa gia' che il predicato unario
% e' una classe (la sua variabile si chiama `cls`), quindi «{arg} is a {cls}» non
% e' un'ipotesi. Il termine resta per i predicati unari che classi non sono.
response_template(learned_class_fact, "Learned: {arg} is {art} {cls}.").
response_template(learned_class_fact_negative, "Learned: {arg} is not {art} {cls}.").
response_template(learned_binary_fact, "Learned: {pred}({arg1}, {arg2}).").
response_template(learned_facts, "Learned: {facts}.").
% E quando i ruoli sono tre. Senza questa riga il motore annunciava due
% argomenti su tre: il fatto ternario entrava corretto e la frase ne mostrava
% una versione mutila — un misclaim su cio' che aveva appena imparato.
response_template(learned_ternary_fact, "Learned: {pred}({arg1}, {arg2}, {arg3}).").
% La risposta a uno slot lasciato libero da una parola interrogativa. E' la
% meta' che di solito manca: un fatto imparato e non interrogabile e' un fatto
% morto, e a tre ruoli il buco si riapriva identico.
response_template(slot_answer, "{value}.").
% G2 — la descrizione combacia con piu' di un'entita'. Sceglierne una sarebbe
% inventare che cosa intendesse chi parla; tacere butterebbe via il fatto che la
% descrizione l'abbiamo capita. Chiedere quale e' la risposta giusta.
response_template(ambiguous_description, "There is more than one — {options}. Which do you mean?").
response_template(known_unary_fact, "{pred}({arg}) is a known fact.").
response_template(rejected_binary_fact, "Scartato: {pred}({arg1}, {arg2}) non e' fatto di concetti.").
response_template(count_of_answer, "There are {count} {noun}s.").
% gen507 — CONTARE CIO' CHE SI SA NON E' CONTARE CIO' CHE C'E'.
% `count_of/2` e' un fatto detto: «i continenti sono sette» vale per il mondo.
% Contare i membri che la KB tiene e' un'altra cosa, e dirla con le stesse
% parole sarebbe un inganno — la classe si popola un membro alla volta
% (gen504), quindi sapere due tool non dichiara che i tool siano due. La
% risposta dice quello che e' vero: quanti ne CONOSCE.
response_template(count_known_answer, "I know {count} {noun}s: {list}.").
response_template(count_known_answer, it, "Ne conosco {count}: {list}.").

% gen507 — CHIEDERE UN ELENCO E' UN ATTO, E LE SUE SUPERFICI SONO FATTI.
% «what is a tool?» elencava gia' i membri; «list the tools» no, e la
% differenza non era una capacita' mancante — era una porta non aperta. Una
% formulazione nuova, in qualunque lingua, e' una riga qui.
machinery(enumerate_cue).
enumerate_cue("list the").
enumerate_cue("list all").
enumerate_cue("name the").
enumerate_cue("show me the").
enumerate_cue("tell me the").
enumerate_cue("which are the").
enumerate_cue("elenca i").
enumerate_cue("elenca le").
enumerate_cue("elenca gli").
enumerate_cue("dimmi i").
enumerate_cue("dimmi le").
enumerate_cue("quali sono i").
enumerate_cue("quali sono le").
% gen507 — «what tools do you know?» e' una domanda sulla KB, e riceveva una
% risposta di conversazione («That sounds nice — tell me more about it»). Il
% motore accende solo se la parola che segue e' una classe che ha membri,
% quindi «what is a tool?» e «what colour is zelnik?» non passano di qui.
enumerate_cue("what").
enumerate_cue("which").
enumerate_cue("quali").
% gen507 — chiedere UN esempio e' chiedere un elenco corto. Quanto corto e'
% conoscenza: `enumerate_limit/2` sulla cue, non un secondo motore.
machinery(enumerate_limit).
enumerate_cue("an example of a").
enumerate_cue("an example of").
enumerate_cue("un esempio di").
enumerate_limit("an example of a", 1).
enumerate_limit("an example of", 1).
enumerate_limit("un esempio di", 1).

% gen507 — ELENCARE, CONTARE, ACCERTARE sono tre letture della stessa
% interrogazione di una classe, e si dicono in modo diverso. Il motore e' uno;
% quale lettura chieda una cue e' un fatto. Senza `enumerate_mode/2` una cue
% elenca, cosi' le righe gia' scritte non cambiano comportamento.
machinery(enumerate_mode).
enumerate_cue("how many").
enumerate_cue("count the").
enumerate_cue("quanti").
enumerate_cue("quante").
enumerate_mode("how many", count).
enumerate_mode("count the", count).
enumerate_mode("quanti", count).
enumerate_mode("quante", count).

enumerate_cue("is there a").
enumerate_cue("is there any").
enumerate_cue("are there any").
enumerate_cue("do you know any").
enumerate_cue("esiste un").
enumerate_cue("c'e' un").
enumerate_mode("is there a", exists).
enumerate_mode("is there any", exists).
enumerate_mode("are there any", exists).
enumerate_mode("do you know any", exists).
enumerate_mode("esiste un", exists).
enumerate_mode("c'e' un", exists).
% Accertare non e' elencare: la risposta afferma e porta UN testimone, perche'
% un'esistenza provata si prova nominando chi la prova.
response_template(existence_witness, "Yes -- {witness}, for one.").
response_template(existence_witness, it, "Sì — {witness}, per esempio.").

% gen507 — CORREGGERE UN FATTO PARLANDO.
% Un secondo valore per una proprieta' che ne ha uno solo non e' un fatto in
% piu': e' una correzione o una contraddizione, e sono due cose diverse. Quali
% parole annuncino una correzione e' conoscenza.
% gen507 — «why?» sapeva rispondere, «why is zelnik useful?» no: la stessa
% domanda con dentro il suo bersaglio. Quali parole aprano una richiesta di
% ragione e' conoscenza.
% ── gen507 — LE FORME DI TURNO SI DICHIARANO, NON SI SCRIVONO IN C ─────────
%
% F., 2026-09-10: «ogni forma nuova era un blocco di C … nel C vanno messi
% PUNTI DI INNESCO di interpreti locali basati sulla KB». `turn_pattern/3`
% aveva gia' sciolto la congiunzione (mantra #19) ma decide solo CHE COSA VALE
% un turno; queste righe dicono anche COM'E' FATTO e CHE COSA FARNE.
%
%   turn_form(Forma, Ordine, slot(Nome) | rest(Nome) | class(C) | text("…")
%                            | relation(Nome))
%   turn_form_act(Forma, Atto)        assert_relation | assert_negative
%   turn_form_reply(Forma, Template)
%
% Da qui una forma nuova — in qualunque lingua, per qualunque relazione — e' un
% gruppo di righe .p0 e vale dal turno dopo, senza ricompilare.
machinery(turn_form).
machinery(turn_form_act).
machinery(turn_form_reply).
machinery(turn_form_mood).
machinery(negation_marker).
negation_marker("does not").
negation_marker("do not").
negation_marker("doesn't").
negation_marker("don't").
negation_marker("is not").
negation_marker("non").
response_template(learned_negative_relation, "Held: {subject} does not {rel} {object}.").
response_template(learned_negative_relation, it, "Tengo: {subject} non {rel} {object}.").

% Negare una relazione, come si nega gia' una classe. Prima riga scritta in
% questa lingua: nessun C dedicato.
turn_form(negate_relation, 1, slot(subject)).
turn_form(negate_relation, 2, class(negation_marker)).
turn_form(negate_relation, 3, relation(relation)).
turn_form(negate_relation, 4, rest(object)).
turn_form_mood(negate_relation, statement).
turn_form_act(negate_relation, assert_negative).
turn_form_reply(negate_relation, learned_negative_relation).

% ── Quando una cosa e' stata fatta, e quanto costa ─────────────────────────
% Due muri («zelnik was built in 1990», «how much does zelnik cost?») chiusi
% senza una riga di C: la forma dichiara la relazione che intende con `bind`,
% perche' la frase parla di anni senza mai dire «year».
machinery(creation_verb).
creation_verb(built).  creation_verb(made).   creation_verb(created).
creation_verb(founded). creation_verb(born).  creation_verb(written).
creation_verb(costruito). creation_verb(fatto). creation_verb(fondato).
relation(year).
response_template(learned_year, "Held: {subject} dates from {object}.").
response_template(learned_year, it, "Tengo: {subject} è del {object}.").

turn_form(year_stated, 1, slot(subject)).
turn_form(year_stated, 2, class(past_copula)).
turn_form(year_stated, 3, class(creation_verb)).
turn_form(year_stated, 4, text("in")).
turn_form(year_stated, 5, rest(object)).
turn_form(year_stated, 6, bind(relation, year_of)).
turn_form_mood(year_stated, statement).
turn_form_act(year_stated, assert_relation).
turn_form_reply(year_stated, learned_year).

machinery(past_copula).
past_copula(was).  past_copula(were).  past_copula(era).  past_copula(fu).

turn_form(year_asked, 1, text("when")).
turn_form(year_asked, 2, class(past_copula)).
turn_form(year_asked, 3, slot(subject)).
turn_form(year_asked, 4, class(creation_verb)).
turn_form(year_asked, 5, bind(relation, year_of)).
turn_form_mood(year_asked, question).
turn_form_act(year_asked, answer_relation).

turn_form(year_asked_it, 1, text("quando")).
turn_form(year_asked_it, 2, class(past_copula)).
turn_form(year_asked_it, 3, slot(subject)).
turn_form(year_asked_it, 4, class(creation_verb)).
turn_form(year_asked_it, 5, bind(relation, year_of)).
turn_form_mood(year_asked_it, question).
turn_form_act(year_asked_it, answer_relation).

response_template(learned_price, "Held: {subject} costs {object}.").
