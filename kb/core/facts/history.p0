% history.p0 — Master index for historical facts.
% Organized by era. Each included file covers a specific time period.
% Add new periods by including new files here; facts load in order.

:- include(ancient.p0).
:- include(0001-1400.p0).
:- include(1400s.p0).
:- include(1500s.p0).
:- include(1600s.p0).
:- include(1700s.p0).
:- include(1800s.p0).
:- include(1900s.p0).
:- include(2000s.p0).

% Answer frames — make historical facts queryable.
% Cues are bare atoms matched as SUBSTRINGS in the user's question.
% Use individual words (no underscores, no quotes) — multi-word phrases
% separated by spaces don't match underscored atoms via cue().
answer_frame(sink, sank_in_year).
answer_frame(sank, sank_in_year).
answer_frame(titanic, sank_in_year).
answer_frame(invented, invented_in_year).
answer_frame(discovered, discovered_in_year).
answer_frame(launched, launched_in_year).

% For "born/died in what year", use cues that distinguish from born_in/died_in
answer_frame(born_in_year, born_in_year).
answer_frame(died_in_year, died_in_year).

% For general "happened in what year", match on "what year" via individual words
answer_frame(year, happened_in_year).
answer_frame(founded_in_year, founded_in_year).
answer_frame(built_in_year, built_in_year).

% gen365 — temporal model over the existing historical corpus.
% The era files above already provide the observations; these clauses connect
% them so one operation applies across events, inventions, discoveries, builds,
% launches and sinkings instead of leaving each table as a private island.
happened_in($Event, $Year) :- happened_in_year($Event, $Year).

historical_year($Thing, $Year) :- happened_in_year($Thing, $Year).
historical_year($Thing, $Year) :- invented_in_year($Thing, $Year).
historical_year($Thing, $Year) :- discovered_in_year($Thing, $Year).
historical_year($Thing, $Year) :- founded_in_year($Thing, $Year).
historical_year($Thing, $Year) :- built_in_year($Thing, $Year).
historical_year($Thing, $Year) :- launched_in_year($Thing, $Year).
historical_year($Thing, $Year) :- sank_in_year($Thing, $Year).

% Pure joins retain an inspectable proof; numeric relations use the general
% comparison primitives already supplied by the fixed resolver.
historical_lifespan($Person, $Birth, $Death) :-
    born_in_year($Person, $Birth), died_in_year($Person, $Death).
shared_birth_year($P1, $P2, $Year) :-
    born_in_year($P1, $Year), born_in_year($P2, $Year).
shared_death_year($P1, $P2, $Year) :-
    died_in_year($P1, $Year), died_in_year($P2, $Year).
historical_before($Earlier, $Later) :-
    historical_year($Earlier, $Y1), historical_year($Later, $Y2), lt($Y1, $Y2).
lives_overlap($P1, $P2) :-
    born_in_year($P1, $B1), died_in_year($P1, $D1),
    born_in_year($P2, $B2), died_in_year($P2, $D2),
    le($B1, $D2), le($B2, $D1).
