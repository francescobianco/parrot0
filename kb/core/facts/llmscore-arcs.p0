% gen365 — reasoning graph pulled from the 2026-07-27 LLMSCORE failures.
%
% No question has a stored answer and no paragraph is a predicate payload.
% A prompt selects a strategy and a topic.  The strategy selects a reusable
% plan shape; the topic selects a domain.  Each plan facet is then constructed
% from small subject --relation--> object claims and a reusable relation frame.
%
% The hot prompt path performs these joins mechanically in C because resolving
% an unbound rule over the complete registry exceeded the one-second deadline.
% The equivalent clauses remain queryable here: they state the deduction and
% let kb.explain audit it without putting any vocabulary in C.

reasoning_act_candidate($Act, $Evidence) :-
    strategy_act($Strategy, $Act),
    strategy_cue($Strategy, $Evidence).

reasoning_domain_candidate($Domain, $Act, $Evidence) :-
    reasoning_strategy($Domain, $Strategy),
    strategy_act($Strategy, $Act),
    reasoning_topic($Domain, $Topic),
    topic_evidence($Topic, $Evidence).

reasoning_plan_candidate($Act, $Facet, $Order, $Requirement) :-
    strategy_act($Strategy, $Act),
    strategy_shape($Strategy, $Shape),
    shape_facet($Shape, $Facet, $Order, $Requirement).

reasoning_claim_candidate($Domain, $Facet, $Subject, $Relation, $Object) :-
    reasoning_edge($Domain, $Facet, $Edge),
    claim_edge($Edge, $Subject, $Relation, $Object).

% Short reusable realizers.  These are presentation knowledge, not claims.
relation_frame(is, "{subject} is {object}.").
relation_frame(are, "{subject} are {object}.").
relation_frame(should_use, "{subject} should use {object}.").
relation_frame(should_combine, "{subject} should combine {object}.").
relation_frame(should_preserve, "{subject} should preserve {object}.").
relation_frame(should_test, "{subject} should test {object}.").
relation_frame(causes, "{subject} causes {object}.").
relation_frame(produces, "{subject} produces {object}.").
relation_frame(requires, "{subject} requires {object}.").
relation_frame(require, "{subject} require {object}.").
relation_frame(cannot, "{subject} cannot {object}.").
relation_frame(limits, "{subject} is limited by {object}.").
relation_frame(explains, "{subject} explains {object}.").
relation_frame(explain, "{subject} explain {object}.").
relation_frame(implies, "{subject} implies {object}.").
relation_frame(preserves, "{subject} preserves {object}.").
relation_frame(loses, "{subject} loses {object}.").
relation_frame(retains, "{subject} retains {object}.").
relation_frame(updates, "{subject} updates {object}.").
relation_frame(update, "{subject} update {object}.").
relation_frame(map_to, "{subject} map to {object}.").
relation_frame(support, "{subject} support {object}.").
relation_frame(produce, "{subject} produce {object}.").
relation_frame(provide, "{subject} provide {object}.").
relation_frame(tweet_step, "{subject} {object};").
relation_frame(compare_with, "Compare {subject} with {object}.").
relation_frame(test_by, "Test {subject} by {object}.").
relation_frame(formalized_as, "{subject}: {object}.").
relation_frame(mapped_to, "{subject} maps to {object}.").
relation_frame(supports, "{subject} supports {object}.").
relation_frame(separates, "{subject} separates {object}.").
relation_frame(constrains, "{subject} constrains {object}.").

