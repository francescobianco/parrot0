% ── Atomic domain claims ─────────────────────────────────────────────────────
% Each line pair adds one independently queryable reasoning edge. Long answers
% emerge only because the selected plan joins several edges in facet order.

reasoning_edge(manual_library_retrieval, proposal, library_proposal_1).
claim_edge(library_proposal_1, "Regional request depots", should_combine,
           "a hub-and-spoke physical distribution network").
reasoning_edge(manual_library_retrieval, proposal, library_proposal_2).
claim_edge(library_proposal_2, "The distribution network", should_use,
           "paper catalogues, conveyors, pneumatic tubes, and rail dispatch").
reasoning_edge(manual_library_retrieval, mechanism, library_mechanism_1).
claim_edge(library_mechanism_1, "Requests for the same title", require,
           "batching, scheduled reading sessions, or analog optical projection").
reasoning_edge(manual_library_retrieval, constraints, library_constraint_1).
claim_edge(library_constraint_1, "One unique physical book", cannot,
           "give a million readers simultaneous exclusive possession").
reasoning_edge(manual_library_retrieval, constraints, library_constraint_2).
claim_edge(library_constraint_2, "Physical retrieval", limits,
           "labour, travel time, preservation, and skewed demand").
reasoning_edge(manual_library_retrieval, validation, library_validation_1).
claim_edge(library_validation_1, "The catalogue and routes", should_test,
           "a sudden million-request spike for one title").

reasoning_edge(tricultural_dish, dish, dish_choice_1).
claim_edge(dish_choice_1, "The dish", should_combine,
           "Italian polenta, Oaxacan mole, and Japanese tsukemono").
reasoning_edge(tricultural_dish, components, dish_components_1).
claim_edge(dish_components_1, "The three components", should_preserve,
           "their original ingredients, techniques, names, and regional credit").
reasoning_edge(tricultural_dish, preservation, dish_preservation_1).
claim_edge(dish_preservation_1, "Separate preparation", preserves,
           "each component as something diners can also taste on its own").
reasoning_edge(tricultural_dish, rationale, dish_rationale_1).
claim_edge(dish_rationale_1, "Polenta, mole, and pickles", provide,
           "base, depth and heat, and acidic crunch without erasing identity").

reasoning_edge(mobius_cutting, answer, mobius_answer_1).
claim_edge(mobius_answer_1, "One off-center longitudinal cut", is,
           "enough to make two distinct linked pieces").
reasoning_edge(mobius_cutting, mechanism, mobius_mechanism_1).
claim_edge(mobius_mechanism_1, "A centerline cut", produces,
           "one longer band with two half-twists, not two pieces").
reasoning_edge(mobius_cutting, examples, mobius_example_1).
claim_edge(mobius_example_1, "A cut one third of the width from an edge", produces,
           "a narrow Möbius band linked with a longer two-twist band").
reasoning_edge(mobius_cutting, qualification, mobius_qualification_1).
claim_edge(mobius_qualification_1, "Centerline-only cutting", requires,
           "two cuts, so the allowed cut path must be stated").

reasoning_edge(civilization_compression, artifact, civilization_tweet_1).
claim_edge(civilization_tweet_1, "Hunters", tweet_step, "learned").
reasoning_edge(civilization_compression, artifact, civilization_tweet_2).
claim_edge(civilization_tweet_2, "farmers", tweet_step, "settled").
reasoning_edge(civilization_compression, artifact, civilization_tweet_3).
claim_edge(civilization_tweet_3, "cities", tweet_step, "wrote laws").
reasoning_edge(civilization_compression, artifact, civilization_tweet_4).
claim_edge(civilization_tweet_4, "empires", tweet_step, "traded and fought").
reasoning_edge(civilization_compression, artifact, civilization_tweet_5).
claim_edge(civilization_tweet_5, "science and industry", tweet_step,
           "mapped meaning and mechanized power").
reasoning_edge(civilization_compression, priorities, civilization_priority_1).
claim_edge(civilization_priority_1, "The compression", should_preserve,
           "transitions in food, energy, coordination, knowledge, and moral inclusion").
reasoning_edge(civilization_compression, rationale, civilization_rationale_1).
claim_edge(civilization_rationale_1, "Cooperation and conflict", explain,
           "both civilization's achievements and their human cost").

reasoning_edge(accessible_music_learning, proposal, accessible_music_proposal_1).
claim_edge(accessible_music_proposal_1, "Accessible instruction", should_use,
           "audio models, tactile landmarks, verbal directions, and Braille music").
reasoning_edge(accessible_music_learning, mechanism, accessible_music_mechanism_1).
claim_edge(accessible_music_mechanism_1, "Each passage", requires,
           "separate practice of posture, movement, rhythm, and sound").
reasoning_edge(accessible_music_learning, constraints, accessible_music_constraint_1).
claim_edge(accessible_music_constraint_1, "Sensory substitution", should_preserve,
           "musical standards, consent, and the learner's independence").
reasoning_edge(accessible_music_learning, validation, accessible_music_validation_1).
claim_edge(accessible_music_validation_1, "The method", should_test,
           "transfer to an unpractised passage without teacher prompts").

reasoning_edge(reversing_gravity_city, proposal, gravity_city_proposal_1).
claim_edge(gravity_city_proposal_1, "Streets and interiors", should_use,
           "overhead nets, ceiling handrails, tether points, and refuge bays").
reasoning_edge(reversing_gravity_city, mechanism, gravity_city_mechanism_1).
claim_edge(gravity_city_mechanism_1, "Reversal alarms", should_use,
           "automatic traffic stops, lift locks, and vehicle anchors").
reasoning_edge(reversing_gravity_city, constraints, gravity_city_constraint_1).
claim_edge(gravity_city_constraint_1, "Returning normal gravity", causes,
