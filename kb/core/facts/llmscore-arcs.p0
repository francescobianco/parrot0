reasoning_edge(reversing_gravity_city, validation, gravity_city_validation_1).
claim_edge(gravity_city_validation_1, "The safeguards", should_test,
           "capture injuries, loose debris, warning time, and safe release").

reasoning_edge(personalized_humor_machine, proposal, humor_proposal_1).
claim_edge(humor_proposal_1, "The generator", should_combine,
           "incongruity, misdirection, analogy, exaggeration, and callback").
reasoning_edge(personalized_humor_machine, mechanism, humor_mechanism_1).
claim_edge(humor_mechanism_1, "A contextual bandit", updates,
           "the person's humor model from laughter, ratings, skips, and context").
reasoning_edge(personalized_humor_machine, constraints, humor_constraint_1).
claim_edge(humor_constraint_1, "Personalization", requires,
           "consent, topic boundaries, privacy, novelty, and exploration limits").
reasoning_edge(personalized_humor_machine, validation, humor_validation_1).
claim_edge(humor_validation_1, "Newly generated jokes", should_test,
           "sustained voluntary laughter against generic and random baselines").

reasoning_edge(bayesian_early_bird, answer, early_bird_answer_1).
claim_edge(early_bird_answer_1, "Acting early", supports,
           "a higher prior probability that an opportunity remains available").
reasoning_edge(bayesian_early_bird, mechanism, early_bird_mechanism_1).
claim_edge(early_bird_mechanism_1, "Successes and failures", update,
           "the probability and value of arriving early").
reasoning_edge(bayesian_early_bird, examples, early_bird_example_1).
claim_edge(early_bird_example_1, "Early applications and limited-stock shopping",
           support, "acting before vacancies or goods disappear").
reasoning_edge(bayesian_early_bird, qualification, early_bird_qualification_1).
claim_edge(early_bird_qualification_1, "Late restocking or high waiting costs",
           update, "the decision toward arriving later").

reasoning_edge(beethoven_fifth_palette, palette, beethoven_palette_1).
claim_edge(beethoven_palette_1, "The palette", should_combine,
           "charcoal black, iron gray, dark crimson, steel blue, and white").
reasoning_edge(beethoven_fifth_palette, mapping, beethoven_mapping_1).
claim_edge(beethoven_mapping_1, "The four-note motif", mapped_to,
