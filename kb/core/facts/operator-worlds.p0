product_input(assembled_furniture, furniture_fasteners, component).
product_input(assembled_furniture, anti_tip_hardware, safety_component).
process_satisfies_constraint(flat_pack_furniture, no_diagrams).
process_action(flat_pack_furniture, unpack_and_group_parts).
process_action(flat_pack_furniture, identify_fasteners).
process_action(flat_pack_furniture, assemble_frame_loose).
process_action(flat_pack_furniture, square_furniture_frame).
process_action(flat_pack_furniture, tighten_furniture_frame).
process_action(flat_pack_furniture, install_furniture_panels).
action_requires(unpack_and_group_parts, package_closed).
action_produces(unpack_and_group_parts, parts_grouped).
action_requires(identify_fasteners, parts_grouped).
action_produces(identify_fasteners, fasteners_matched).
action_requires(assemble_frame_loose, fasteners_matched).
action_produces(assemble_frame_loose, frame_loose).
action_requires(square_furniture_frame, frame_loose).
action_produces(square_furniture_frame, frame_square).
action_requires(tighten_furniture_frame, frame_square).
action_produces(tighten_furniture_frame, frame_rigid).
action_requires(install_furniture_panels, frame_rigid).
action_produces(install_furniture_panels, furniture_assembled).
action_semantics(unpack_and_group_parts, arrange, furniture_panels).
action_semantics(identify_fasteners, classify, furniture_fasteners).
action_semantics(assemble_frame_loose, join, furniture_frame_parts).
action_semantics(square_furniture_frame, align, loose_furniture_frame).
action_semantics(tighten_furniture_frame, tighten, furniture_fasteners).
action_semantics(install_furniture_panels, attach, remaining_panels_and_hardware).
action_parameter(unpack_and_group_parts, safety, with_finished_faces_protected).
action_parameter(unpack_and_group_parts, method, by_size_and_hole_pattern).
action_parameter(identify_fasteners, method, by_type_diameter_and_depth).
action_parameter(assemble_frame_loose, control, finger_tight_to_preserve_movement).
action_parameter(square_furniture_frame, control, until_corner_diagonals_match).
action_parameter(tighten_furniture_frame, sequence, gradually_across_opposite_corners).
action_parameter(install_furniture_panels, safety, with_anti_tip_hardware_and_gentle_load_test).
action_consumes(unpack_and_group_parts, furniture_panels).
action_consumes(identify_fasteners, furniture_fasteners).
action_consumes(install_furniture_panels, anti_tip_hardware).

% Evaluation process: home beer brewing, with causal flavor annotations.
process_initial_state(home_beer_brewing, equipment_ready).
process_goal(home_beer_brewing, packaged_beer).
process_product(home_beer_brewing, home_brewed_beer).
product_input(home_brewed_beer, brewing_water, ingredient).
product_input(home_brewed_beer, malted_grain, ingredient).
product_input(home_brewed_beer, hops, ingredient).
product_input(home_brewed_beer, brewing_yeast, ingredient).
product_input(home_brewed_beer, brewing_equipment, equipment).
process_action(home_beer_brewing, sanitize_brewing_equipment).
process_action(home_beer_brewing, mash_grain).
process_action(home_beer_brewing, boil_wort_with_hops).
process_action(home_beer_brewing, cool_wort).
