% gen366 — neutral worlds for reasoning-operator transfer tests.
%
% A property is knowledge about an entity.  A goal preference is knowledge
% about a criterion.  No recommendation or comparison conclusion is stored:
% task_difference/4 and task_goal_match/4 in procedures.p0 derive those.

% Train world A: urban transport.
property(bicycle, emissions, low).
property(bicycle, maneuverability, high).
property(car, emissions, high).
property(car, maneuverability, medium).
goal_prefers(low_emission_urban_trip, emissions, low).
goal_prefers(low_emission_urban_trip, maneuverability, high).

% Train world B: data structures.
property(array, random_access, constant_time).
property(array, mid_sequence_insertion, costly).
property(linked_list, random_access, linear_time).
property(linked_list, mid_sequence_insertion, efficient).
goal_prefers(random_access_workload, random_access, constant_time).

% Frozen held-out world C: protective materials.
property(glass, impact_resistance, low).
property(glass, optical_clarity, high).
property(polycarbonate, impact_resistance, high).
property(polycarbonate, optical_clarity, medium).
goal_prefers(impact_resistant_guard, impact_resistance, high).

% Surface glosses are presentation knowledge, kept separate from the facts.
reasoning_gloss(bicycle, "a bicycle").
reasoning_gloss(car, "a car").
reasoning_gloss(array, "an array").
reasoning_gloss(linked_list, "a linked list").
reasoning_gloss(glass, "glass").
reasoning_gloss(polycarbonate, "polycarbonate").

reasoning_gloss(emissions, "emissions").
reasoning_gloss(maneuverability, "maneuverability").
reasoning_gloss(random_access, "random access").
reasoning_gloss(mid_sequence_insertion, "mid-sequence insertion").
reasoning_gloss(impact_resistance, "impact resistance").
reasoning_gloss(optical_clarity, "optical clarity").

reasoning_gloss(low_emission_urban_trip, "a low-emission urban trip").
reasoning_gloss(random_access_workload, "a random-access workload").
reasoning_gloss(impact_resistant_guard, "an impact-resistant guard").

property_gloss(emissions, low, "low emissions").
property_gloss(emissions, high, "high tailpipe emissions").
property_gloss(maneuverability, high, "high maneuverability").
property_gloss(maneuverability, medium, "moderate maneuverability").
property_gloss(random_access, constant_time, "constant-time indexed access").
property_gloss(random_access, linear_time, "linear-time indexed access").
property_gloss(mid_sequence_insertion, costly, "costly mid-sequence insertion").
property_gloss(mid_sequence_insertion, efficient, "efficient insertion once the position is known").
property_gloss(impact_resistance, low, "low impact resistance").
property_gloss(impact_resistance, high, "high impact resistance").
property_gloss(optical_clarity, high, "high optical clarity").
property_gloss(optical_clarity, medium, "moderate optical clarity").

% R1 open-world concept composition.  None of the compared compound entities
% is registered: task_term_concept/2 decomposes a new span and the same
% effective_property/effective_goal_prefers rules inherit these atomic facts.
property(ceramic, heat_retention, low).
property(thermos, heat_retention, high).
goal_prefers(thermal, heat_retention, high).

property(linen, insulation, low).
property(wool, insulation, high).
goal_prefers(winter, insulation, high).

property(paper, water_resistance, low).
property(plastic, water_resistance, high).
goal_prefers(rain, water_resistance, high).

reasoning_gloss(heat_retention, "heat retention").
reasoning_gloss(insulation, "insulation").
reasoning_gloss(water_resistance, "water resistance").
property_gloss(heat_retention, low, "low heat retention").
property_gloss(heat_retention, high, "high heat retention").
property_gloss(insulation, low, "low thermal insulation").
property_gloss(insulation, high, "high thermal insulation").
property_gloss(water_resistance, low, "low water resistance").
property_gloss(water_resistance, high, "high water resistance").

% ── R4 constraint synthesis worlds ─────────────────────────────────────────
% Candidate features are ordinary objects with properties.  The operator
% derives a covering set; no design answer or ordered list is stored.

% Train A: a quiet notification system.
goal_prefers(notification, alert_delivery, immediate).
goal_prefers(quiet, acoustic_dependency, none).
candidate_for(notification, haptic_pager).
candidate_for(notification, low_intensity_visual_beacon).
property(haptic_pager, alert_delivery, immediate).
property(haptic_pager, acoustic_dependency, none).
property(low_intensity_visual_beacon, alert_delivery, immediate).
property(low_intensity_visual_beacon, acoustic_dependency, none).
action_semantics(haptic_pager, pulse, wearable_pager).
action_parameter(haptic_pager, method, with_distinct_vibration_patterns).
action_produces(haptic_pager, silent_personal_alert).
action_semantics(low_intensity_visual_beacon, display, shielded_status_light).
action_parameter(low_intensity_visual_beacon, control, at_low_glare_near_the_recipient).
action_produces(low_intensity_visual_beacon, silent_shared_alert).

% Train B: a low-power sensor network with intermittent connectivity.
goal_prefers(low_power, energy_use, low).
goal_prefers(intermittent_connectivity, disconnection_tolerance, high).
candidate_for(sensor_network, duty_cycling).
candidate_for(sensor_network, local_buffering).
property(duty_cycling, energy_use, low).
property(local_buffering, disconnection_tolerance, high).
action_semantics(duty_cycling, schedule, sensor_wake_windows).
action_parameter(duty_cycling, method, around_measurement_and_radio_need).
action_produces(duty_cycling, reduced_energy_use).
action_semantics(local_buffering, retain, timestamped_measurements).
action_parameter(local_buffering, sequence, until_a_link_returns_then_replay_in_order).
action_produces(local_buffering, loss_tolerant_data_delivery).

% Frozen held-out C: underwater navigation with low visibility.
goal_prefers(underwater, propagation_medium, acoustic).
goal_prefers(low_visibility, visual_dependency, none).
candidate_for(navigation, acoustic_beacon).
candidate_for(navigation, tactile_heading_indicator).
property(acoustic_beacon, propagation_medium, acoustic).
property(acoustic_beacon, visual_dependency, none).
property(tactile_heading_indicator, visual_dependency, none).
action_semantics(acoustic_beacon, transmit, coded_sound_pulses).
action_parameter(acoustic_beacon, method, with_timing_for_range_and_identity).
action_produces(acoustic_beacon, underwater_position_reference).
action_semantics(tactile_heading_indicator, map, heading_error).
action_parameter(tactile_heading_indicator, method, to_directional_vibration_on_the_body).
action_produces(tactile_heading_indicator, eyes_free_course_correction).

% Evaluation world after cross-domain transfer: magnetic signaling without a
% visual alphabet.  Facts name affordances and requirements, not a response.
goal_prefers(magnetic, signal_channel, magnetic_field).
goal_prefers(no_visual_symbols, visual_dependency, none).
candidate_for(signaling, field_orientation_code).
candidate_for(signaling, field_strength_emphasis).
candidate_for(signaling, timed_polarity_transition).
property(field_orientation_code, signal_channel, magnetic_field).
property(field_orientation_code, visual_dependency, none).
property(field_strength_emphasis, signal_channel, magnetic_field).
property(field_strength_emphasis, visual_dependency, none).
property(timed_polarity_transition, signal_channel, magnetic_field).
property(timed_polarity_transition, visual_dependency, none).
action_semantics(field_orientation_code, map, symbol_classes).
action_parameter(field_orientation_code, method, to_distinct_field_orientations).
action_produces(field_orientation_code, magnetic_symbol_vocabulary).
action_semantics(field_strength_emphasis, map, emphasis_and_urgency).
action_parameter(field_strength_emphasis, method, to_bounded_field_strength_levels).
action_produces(field_strength_emphasis, magnetic_prosody).
action_semantics(timed_polarity_transition, encode, sequence_relations).
action_parameter(timed_polarity_transition, method, as_timed_polarity_transitions).
action_produces(timed_polarity_transition, magnetic_syntax).

