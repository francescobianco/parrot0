reasoning_gloss(release_deployed, "a deployed release").
reasoning_gloss(emergency_kit_ready, "a ready emergency kit").
reasoning_gloss(furniture_assembled, "assembled and safety-checked furniture").
reasoning_gloss(packaged_beer, "packaged, conditioned beer").
reasoning_gloss(three_course_meal_ready, "three finished courses").
reasoning_gloss(preventing_sour_or_medicinal_off_flavors, "whether contamination creates sour, medicinal, or phenolic off-flavors").
