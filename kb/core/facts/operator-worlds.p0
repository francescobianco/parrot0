% ── R3 process worlds ───────────────────────────────────────────────────────
deadline_minutes(minutes_60, 60).
reasoning_gloss(minutes_60, "the one-hour limit").

% Train A: pour-over coffee.
process_initial_state(pour_over_coffee, ingredients_ready).
process_goal(pour_over_coffee, coffee_ready).
process_product(pour_over_coffee, brewed_coffee).
product_input(brewed_coffee, fresh_water, ingredient).
product_input(brewed_coffee, coffee_beans, ingredient).
product_input(brewed_coffee, paper_filter, component).
process_action(pour_over_coffee, heat_coffee_water).
process_action(pour_over_coffee, grind_coffee).
process_action(pour_over_coffee, bloom_coffee).
process_action(pour_over_coffee, pour_coffee).
action_requires(heat_coffee_water, ingredients_ready).
action_produces(heat_coffee_water, water_ready).
action_requires(grind_coffee, water_ready).
action_produces(grind_coffee, grounds_ready).
action_requires(bloom_coffee, grounds_ready).
action_produces(bloom_coffee, coffee_bloomed).
action_requires(pour_coffee, coffee_bloomed).
action_produces(pour_coffee, coffee_ready).
action_semantics(heat_coffee_water, heat, fresh_water).
action_semantics(grind_coffee, grind, coffee_beans).
action_semantics(bloom_coffee, wet, coffee_grounds).
action_semantics(pour_coffee, pour, remaining_water).
action_parameter(heat_coffee_water, control, below_rolling_boil).
action_parameter(grind_coffee, method, to_medium_consistency).
action_parameter(bloom_coffee, sequence, with_little_water_then_wait_30_seconds).
action_parameter(pour_coffee, method, slowly_in_controlled_circles).
action_consumes(heat_coffee_water, fresh_water).
action_consumes(grind_coffee, coffee_beans).
action_consumes(bloom_coffee, paper_filter).
action_duration(heat_coffee_water, 5).
action_duration(grind_coffee, 2).
action_duration(bloom_coffee, 1).
action_duration(pour_coffee, 4).

% Train B: software release.
process_initial_state(software_release, tests_passing).
process_goal(software_release, release_deployed).
process_product(software_release, deployed_release).
product_input(deployed_release, tested_commit, source).
product_input(deployed_release, version_identifier, metadata).
product_input(deployed_release, deployment_configuration, configuration).
process_action(software_release, build_release_artifact).
process_action(software_release, stage_release).
process_action(software_release, deploy_release).
action_requires(build_release_artifact, tests_passing).
action_produces(build_release_artifact, artifact_built).
action_requires(stage_release, artifact_built).
action_produces(stage_release, staging_verified).
action_requires(deploy_release, staging_verified).
action_produces(deploy_release, release_deployed).
action_semantics(build_release_artifact, build, versioned_artifact).
action_semantics(stage_release, deploy, versioned_artifact).
action_semantics(deploy_release, promote, verified_artifact).
action_parameter(build_release_artifact, method, from_tested_commit_with_checksum).
action_parameter(stage_release, control, to_staging_with_smoke_and_migration_checks).
action_parameter(deploy_release, safety, gradually_with_monitoring_and_rollback).
action_consumes(build_release_artifact, tested_commit).
action_consumes(build_release_artifact, version_identifier).
action_consumes(stage_release, deployment_configuration).
action_duration(build_release_artifact, 8).
action_duration(stage_release, 12).
action_duration(deploy_release, 10).

% Frozen held-out C: emergency kit.
process_initial_state(emergency_kit, household_needs_known).
process_goal(emergency_kit, emergency_kit_ready).
process_product(emergency_kit, prepared_emergency_kit).
product_input(prepared_emergency_kit, household_requirements, specification).
product_input(prepared_emergency_kit, emergency_supplies, component).
product_input(prepared_emergency_kit, emergency_information, information).
process_action(emergency_kit, inventory_emergency_supplies).
process_action(emergency_kit, pack_emergency_supplies).
process_action(emergency_kit, document_emergency_contacts).
action_requires(inventory_emergency_supplies, household_needs_known).
action_produces(inventory_emergency_supplies, supply_gaps_known).
action_requires(pack_emergency_supplies, supply_gaps_known).
action_produces(pack_emergency_supplies, supplies_packed).
action_requires(document_emergency_contacts, supplies_packed).
action_produces(document_emergency_contacts, emergency_kit_ready).
action_semantics(inventory_emergency_supplies, inventory, household_requirements).
action_semantics(pack_emergency_supplies, pack, emergency_supplies).
action_semantics(document_emergency_contacts, document, emergency_information).
action_parameter(inventory_emergency_supplies, method, across_medical_water_food_power_and_local_hazards).
action_parameter(pack_emergency_supplies, safety, with_expiry_labels_in_waterproof_container).
action_parameter(document_emergency_contacts, method, with_evacuation_medication_contacts_and_utility_shutoff).
action_consumes(inventory_emergency_supplies, household_requirements).
action_consumes(pack_emergency_supplies, emergency_supplies).
action_consumes(document_emergency_contacts, emergency_information).
action_duration(inventory_emergency_supplies, 15).
action_duration(pack_emergency_supplies, 30).
action_duration(document_emergency_contacts, 10).

% Evaluation process: flat-pack furniture without diagrams.
process_initial_state(flat_pack_furniture, package_closed).
