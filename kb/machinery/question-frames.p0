qa_cue(q_moon_landing_mission, "first").
qa_cue(q_moon_landing_mission, "human").
qa_cue(q_moon_landing_mission, "moon").
qa_cue(q_moon_landing_mission, "astronauts").
qa_reply(q_moon_landing_mission, "The first human Moon landing was in 1969 on Apollo 11. Neil Armstrong and Buzz Aldrin walked on the Moon, while Michael Collins remained in lunar orbit.").
qa_cue(q_printing_reformation, "printing").
qa_cue(q_printing_reformation, "press").
qa_cue(q_printing_reformation, "protestant").
qa_cue(q_printing_reformation, "reformation").
qa_reply(q_printing_reformation, "The printing press helped the Protestant Reformation spread by making pamphlets, Bible translations, and reformers' arguments cheap to copy and fast to circulate, so Luther's ideas could reach towns and lay readers far beyond one pulpit or university.").
qa_cue(q_supply_demand_example, "supply").
qa_cue(q_supply_demand_example, "demand").
qa_cue(q_supply_demand_example, "real-world").
qa_reply(q_supply_demand_example, "Supply and demand means prices tend to rise when many buyers want something that is scarce, and fall when sellers have more than buyers want. For example, if strawberries are abundant in summer, supply rises and prices often drop; after a bad harvest, supply shrinks and prices rise.").
qa_cue(q_mitosis_meiosis, "mitosis").
qa_cue(q_mitosis_meiosis, "meiosis").
qa_cue(q_mitosis_meiosis, "differences").
qa_reply(q_mitosis_meiosis, "Mitosis makes two genetically identical diploid body cells for growth and repair, while meiosis makes four genetically varied haploid sex cells for reproduction through two divisions and chromosome recombination.").
qa_cue(q_samurai_significance, "samurai").
qa_cue(q_samurai_significance, "feudal").
qa_cue(q_samurai_significance, "japan").
qa_reply(q_samurai_significance, "In feudal Japan, samurai were the warrior class who served lords, enforced political order, and became symbols of discipline, loyalty, martial skill, and honor. Their ideals, especially later forms of bushido, shaped Japanese literature, education, memory, and modern cultural identity.").
