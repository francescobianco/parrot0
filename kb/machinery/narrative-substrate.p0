process_step(carbonara_recipe, 1, "Boil 200 g spaghetti in salted water until al dente").
process_step(carbonara_recipe, 2, "Dice 100 g guanciale or pancetta and cook it until crisp").
process_step(carbonara_recipe, 3, "Beat 2 egg yolks with 1 whole egg, 50 g grated Pecorino Romano, and black pepper").
process_step(carbonara_recipe, 4, "Toss the drained pasta with the guanciale off the heat, adding a splash of pasta water").
process_step(carbonara_recipe, 5, "Stir in the egg-cheese mixture until glossy, then serve immediately with more pepper").
process_topic(carbonara_recipe, spaghetti).
process_topic(carbonara_recipe, carbonara).
process_topic(carbonara_recipe, recipe).
process_step(speech_rhythm_transcription, 1, "Record the sentence and mark every syllable onset and stressed syllable").
process_step(speech_rhythm_transcription, 2, "Convert the gaps between onsets into approximate note values at a chosen tempo").
process_step(speech_rhythm_transcription, 3, "Map the speaker's pitch contour to relative notes while preserving the strongest accents").
process_step(speech_rhythm_transcription, 4, "Choose a steady or changing meter, notate articulation from consonants, and compare playback with the recording").
