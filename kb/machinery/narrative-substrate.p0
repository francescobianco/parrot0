process_step(photosynthesis, 1, "Plants take in carbon dioxide from the air through tiny openings in their leaves").
process_step(photosynthesis, 2, "Roots absorb water from the soil and move it up to the leaves").
process_step(photosynthesis, 3, "Chlorophyll captures energy from sunlight").
process_step(photosynthesis, 4, "The plant uses that energy to turn water and carbon dioxide into sugar for food").
process_step(photosynthesis, 5, "Oxygen is released back into the air as a by-product").
