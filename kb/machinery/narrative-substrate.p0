process_step(sensory_balance_recipe, 1, "Whisk white miso, roasted mushroom stock, honey, rice vinegar, and a small spoon of tahini into a glossy sauce").
process_step(sensory_balance_recipe, 2, "Glaze roasted eggplant and shiitake mushrooms with the sauce so miso and mushrooms supply umami while honey rounds their bitterness").
process_step(sensory_balance_recipe, 3, "Add pear slices and toasted sesame for clean sweetness, acidity, aroma, and texture rather than more sugar").
process_step(sensory_balance_recipe, 4, "For a safe metallic hint, serve with iron-rich spinach and a pinch of mineral salt; never add metal or reactive filings to food").
process_step(sensory_balance_recipe, 5, "Taste warm and adjust with vinegar if sweetness dominates or mushroom stock if the metallic mineral note becomes sharp").
process_topic(sensory_balance_recipe, umami).
process_topic(sensory_balance_recipe, sweetness).
process_topic(sensory_balance_recipe, metallic).
process_topic(sensory_balance_recipe, harmonious).
process_step(scavenged_electric_generator, 1, "Salvage insulated copper wire, strong permanent magnets, a steel shaft, bearings or smooth bushings, scrap wood, and a low-voltage LED; never connect the build to mains wiring").
process_step(scavenged_electric_generator, 2, "Wind several hundred neat turns of insulated wire around a cardboard or plastic former, leave two leads, and scrape insulation only from their ends").
process_step(scavenged_electric_generator, 3, "Mount alternating magnet poles on a balanced rotor and support its shaft so the magnets pass close to the stationary coil without touching it").
process_step(scavenged_electric_generator, 4, "Attach a hand crank, bicycle wheel, wind rotor, or water wheel, secure loose parts behind a guard, and spin slowly while measuring the coil with a multimeter").
process_step(scavenged_electric_generator, 5, "Feed the low-voltage output through salvaged rectifier diodes and a capacitor if available, then test an LED; add turns or speed gradually while checking heat and mechanical stability").
process_topic(scavenged_electric_generator, electric).
process_topic(scavenged_electric_generator, generator).
process_topic(scavenged_electric_generator, scavenged).
process_topic(scavenged_electric_generator, materials).
process_step(aged_fermented_dessert, 1, "Combine sour cherries and plums with sugar, cocoa nibs, and a reputable food-safe fermentation starter in a sanitized jar, following the starter maker's salt, temperature, and batch-size limits").
process_step(aged_fermented_dessert, 2, "Keep fruit submerged under a fermentation weight with an airlock, label the date, and ferment in the specified cool range for two to three weeks without opening repeatedly").
process_step(aged_fermented_dessert, 3, "Discard the batch for mold, rot, unsafe acidity, a broken seal, or an odor outside the starter guidance; otherwise refrigerate as soon as the verified endpoint is reached").
process_step(aged_fermented_dessert, 4, "Cook a portion of the tangy fermented fruit into a thick compote with dark chocolate and vanilla, then cool it completely").
process_step(aged_fermented_dessert, 5, "Layer the compote with mascarpone or cultured cashew cream and toasted rye crumbs, using unheated reserved syrup only when the verified starter instructions permit it").
process_topic(aged_fermented_dessert, dessert).
process_topic(aged_fermented_dessert, fermentation).
process_topic(aged_fermented_dessert, ferment).
process_topic(aged_fermented_dessert, weeks).
activity_step(stress_management, 1, "Use slow breathing or a brief walk to lower physical arousal before deciding what to do").
activity_step(stress_management, 2, "Write down the next concrete task so the problem feels bounded instead of endless").
activity_step(stress_management, 3, "Protect sleep, food, and movement, because stress is harder to manage when the body is depleted").
activity_step(stress_management, 4, "Talk to someone trustworthy when the load is too large to hold alone").
activity_topic(stress_management, stress).
activity_topic(stress_management, managing).
activity_topic(stress_management, strategies).
activity_step(mystery_books, 1, "The Hound of the Baskervilles by Arthur Conan Doyle: it has a classic detective structure, eerie atmosphere, and satisfying clue-work").
activity_step(mystery_books, 2, "And Then There Were None by Agatha Christie: it is tightly plotted and built around suspense, misdirection, and a closed circle of suspects").
activity_step(mystery_books, 3, "The Big Sleep by Raymond Chandler: it suits readers who like mystery with sharp dialogue, moral ambiguity, and noir mood").
