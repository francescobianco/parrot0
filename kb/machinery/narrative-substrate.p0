process_step(bread_rise, 1, "Yeast consumes sugars in the dough and releases carbon dioxide gas").
process_step(bread_rise, 2, "Gluten strands trap that gas in small bubbles, stretching the dough").
process_step(bread_rise, 3, "Warmth and time let fermentation continue, so the bubbles expand").
process_step(bread_rise, 4, "During baking, the gas expands further and the crumb sets into a risen loaf").
process_step(flat_tire_change, 1, "Park safely on level ground, turn on the hazard lights, and set the parking brake").
process_step(flat_tire_change, 2, "Place the jack at the vehicle's recommended lift point and loosen the lug nuts before lifting").
process_step(flat_tire_change, 3, "Raise the car, remove the lug nuts and flat tire, then mount the spare tire").
process_step(flat_tire_change, 4, "Hand-tighten the lug nuts, lower the car, tighten them in a star pattern, and check the tire pressure").
process_step(toast_recipe, 1, "Put a slice of bread in the toaster").
