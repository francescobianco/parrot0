creative_text(villain_salvation_monologue, "They will call me monster when the seas boil and the towers fall, but I have watched this world bargain away every tomorrow for one more comfortable hour. I do not destroy it because I hate it; I destroy the fever so something clean can breathe after us. Let history curse my name if it must. A curse is still a kind of memory, and memory is more mercy than extinction.").
creative_text_cue(villain_salvation_monologue, "dramatic monologue").
creative_text_cue(villain_salvation_monologue, "villain").
creative_text_cue(villain_salvation_monologue, "destroying the world").
creative_text_cue(villain_salvation_monologue, "save it").
creative_text_gate(villain_salvation_monologue, "dramatic monologue").
creative_text_gate(villain_salvation_monologue, keyword(villain)).
creative_text(cultural_fusion_holiday, "The Lantern Harvest Feast begins with families lighting floating lamps for their ancestors, then sharing a braided harvest bread at a long communal table, and ends with masked street dancing while neighbors exchange small sweets for good luck. It blends remembrance, thanksgiving for the crop, and carnival renewal into one night of light, food, music, and public joy.").
