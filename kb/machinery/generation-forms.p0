creative_text_gate(cultural_fusion_holiday, "cultural traditions").
creative_text(time_accident_story, "Dr. Mara Vale jumped back to 1895 only to move a loose broom before a clerk could trip over it. The clerk arrived early, signed the wrong shipping order, and a crate of lab glass reached a young inventor a month ahead of schedule. That early experiment produced a cheaper battery, which pulled nations into an electric arms race before diplomacy had caught up. Mara returned to a skyline humming with machines built from the accident she had prevented.").
creative_text_cue(time_accident_story, "short story").
creative_text_cue(time_accident_story, "time traveler").
creative_text_cue(time_accident_story, "minor historical accident").
creative_text_cue(time_accident_story, "major one").
creative_text_gate(time_accident_story, "time traveler").
creative_text_gate(time_accident_story, "minor historical accident").
creative_text(alien_two_suns_species, "The Aurakai are tall, copper-skinned beings with translucent eyelids that filter the glare of their twin suns. Their backs carry fanlike heat fins, and their hands have four broad fingers for digging shade burrows in glassy soil. They organize society by shared shade-houses rather than blood families: each house guards a well, teaches children sung navigation, and votes at dusk when both suns touch the horizon.").
creative_text_cue(alien_two_suns_species, "fictional alien species").
creative_text_cue(alien_two_suns_species, "planet with two suns").
creative_text_cue(alien_two_suns_species, "physical appearance").
creative_text_cue(alien_two_suns_species, "social customs").
creative_text_gate(alien_two_suns_species, "fictional alien species").
creative_text_gate(alien_two_suns_species, "planet with two suns").
creative_text(ai_society_dialogue, "Mara: If AI handles dangerous work and helps doctors catch mistakes, it could save lives. Jules: It could, but only if people stay accountable; otherwise it may amplify bias, surveillance, and unemployment. Mara: Then the question is not whether AI is good or bad, but who controls it and what rules shape its use. Jules: Agreed. Benefit comes from governance and transparency, not from the tool magically becoming wise.").
creative_text_cue(ai_society_dialogue, "short dialogue").
creative_text_cue(ai_society_dialogue, "two characters").
creative_text_cue(ai_society_dialogue, "artificial intelligence").
creative_text_cue(ai_society_dialogue, "benefit or harm society").
