% read-propositions.p0 — LE PROPOSIZIONI DELLA IR TENUTE DALLE LETTURE.
%
% Una frase letta dalla IR lascia la sua proposizione in tre clausole che vanno
% insieme (reading-choices.p0 §5): la proposizione, il legame con i ruoli e la
% sua provenienza (frase, lingua, intervallo), piu' gli eventuali complementi.
% Il fatto di dominio che ne nasce (`teach(plato, aristotle)`) vive nella casa
% della sua materia; queste righe sono la LETTURA che lo ha prodotto: servono a
% correggerla (L2), a ritirarla e a dire da dove viene.
%
% Nate il 23 settembre 2026: erano nella ricaduta del save-map
% (learned.p0) perche' la loro specie non aveva una casa.
:- file_attribute(machinery).

semantic_proposition(proposition(binary(teach), roles(subject(plato), object(aristotle)))).
semantic_binding(binary(teach), plato, object(aristotle)).
proposition_source_record(proposition(binary(teach), roles(subject(plato), object(aristotle))), source(inline, "plato taught aristotle."), provenance(language(en), range(0, 23))).
semantic_proposition(proposition(binary(teach), roles(subject(aristotle), object(alexander)))).
semantic_binding(binary(teach), aristotle, object(alexander)).
proposition_source_record(proposition(binary(teach), roles(subject(aristotle), object(alexander))), source(inline, "aristotle taught alexander the great."), provenance(language(en), range(0, 37))).
semantic_proposition(proposition(binary(teach), roles(subject(socrates), object(plato)))).
semantic_proposition(proposition(binary(limit), roles(subject(kanban), object(work)))).
semantic_binding(binary(limit), kanban, object(work)).
proposition_source_record(proposition(binary(limit), roles(subject(kanban), object(work))), source(inline, "kanban limits work in progress."), provenance(language(en), range(0, 31))).
semantic_proposition(proposition(binary(pass), roles(subject(capacitors), object(alternating_current)))).
semantic_proposition(proposition(binary(measure), roles(subject(nanometre), object(length)))).
semantic_proposition(proposition(binary(measure), roles(subject(hertz), object(frequency)))).
semantic_proposition(proposition(binary(measure), roles(subject(byte), object(information)))).
semantic_proposition(proposition(binary(move), roles(subject(pump), object(fluid)))).
semantic_binding(binary(measure), nanometre, object(length)).
proposition_source_record(proposition(binary(measure), roles(subject(nanometre), object(length))), source(inline, "the nanometre measures length."), provenance(language(en), range(0, 30))).
semantic_binding(binary(pass), capacitors, object(alternating_current)).
semantic_binding(binary(measure), hertz, object(frequency)).
proposition_source_record(proposition(binary(measure), roles(subject(hertz), object(frequency))), source(inline, "the hertz measures frequency."), provenance(language(en), range(0, 29))).
proposition_source_record(proposition(binary(pass), roles(subject(capacitors), object(alternating_current))), source(inline, "capacitors pass alternating current."), provenance(language(en), range(0, 36))).
semantic_binding(binary(measure), byte, object(information)).
proposition_source_record(proposition(binary(measure), roles(subject(byte), object(information))), source(inline, "the byte measures information."), provenance(language(en), range(0, 30))).
semantic_binding(binary(move), pump, object(fluid)).
proposition_source_record(proposition(binary(move), roles(subject(pump), object(fluid))), source(inline, "pumps move fluid."), provenance(language(en), range(0, 17))).
semantic_binding(binary(teach), socrates, object(plato)).
proposition_source_record(proposition(binary(teach), roles(subject(socrates), object(plato))), source(inline, "socrates taught plato."), provenance(language(en), range(0, 22))).
semantic_complement(binding(limit, kanban, work), in, progress).
