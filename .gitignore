# build artifacts
/obj/
/bin/

# agent harness state (subagent worktrees, local settings)
/.claude/

# generated session knowledge (base.p0 is curated & tracked)
/kb/core/session.p0

# gen321: the build stamp is generated into the build dir (obj/version_stamp.h,
# already covered by /obj/). src/version.h is now a stable TRACKED declaration —
# keeping a generated header under src/ is what made every commit rebuild the
# whole brain (forge plan §15 row 7).
# editor / OS noise
*.o
*.out
.DS_Store
*.swp
/.idea/
# local Python benchmark dependencies
/.venv/
/.cache/
__pycache__/

# llmscore hidden tail generated by the remote batch judge between fast loops
/.llmscore_tail.json

# savemap.tsv is a deprecated inspection dump — the live routing table is
# regenerated from the kb/ tree on every save (kb_save_routed). Not a cache/source.
/kb/savemap.tsv

# env
.env

# gen200: parrot0-written candidate patch copies
*.p0fix

# gen261: parrot0-emitted vocabulary fact files (the emit_facts plan primitive)
*.cues.p0

# gen270: files created by the produce-artifact ratchets (tests/run.sh pre-cleans)
/p0tmp_*

# longtalk per-session transcript logs (generated by make longtalk-bench)
tests/longtalk-sessions/
LONGTALK.md

# parrotbench release measurements (the corpus is tracked; live progress and
# histogram output are local state, intentionally not source or regression data)
tests/parrotbench/results/

# gen278: per-process code-oracle temp files (parallel-safe)
.p0_*

# gen411: i registri di lavoro del processo autonomo — agenda e ponti indotti,
# non conoscenza curata. Si rigenerano, e non vanno versionati.
kb/learning/gaps.p0
kb/learning/bridges.p0

# gen436 — di Wikipedia non si conserva niente: nessuna pagina, mai piu'.
# Cio' che resta e' la conoscenza che parrot0 ha IMPARATO leggendo, nella KB.
kb/learning/pages/

# python bytecode dei banchi di gara
__pycache__/
*.pyc
p0t_write_probe.c

# gen503: log di cattura estemporanea, non un artefatto del progetto
/err.log
# gen503: le MISURE della sonda si rigenerano; il banco e i suoi item no
/var/probe/results/
