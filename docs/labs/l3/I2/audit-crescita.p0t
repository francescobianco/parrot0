# Audit 25 settembre: contratti avversari del §14, fissati PRIMA della cura.
# KB agi completa; nessun ponte preesistente rimosso. Le query diagnosticano;
# il maestro comunica solo in lingua naturale. Tempi non certificati qui.

[mock live]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/profiles/agi.p0
!set PARROT0_LANG=en
!reset

[test contatto e trasferimento reale]
!timeout 0
> Einstein was born in Ulm, so his Geburtsort is Ulm.
!query contact_support(geburtsort, born_in, 1)
> What is the Geburtsort of Napoleon?
<~ Reading
<~ ajaccio

[test uso della stessa ipotesi non e conferma indipendente]
!timeout 0
> The Geburtsort of Kant is Konigsberg, so his Geburtsort is Konigsberg.
!query contact_support(geburtsort, born_in, 1)
> What is the Geburtsort of Galileo Galilei?
<~ Reading
<~ pisa

[test il ritiro deve sospendere anche la conseguenza senza fonte indipendente]
!timeout 0
!assert contact_bridge_withdrawn(geburtsort, born_in)
!query! relation_noun(born_in, geburtsort)
!query! born_in(kant, konigsberg)
!query born_in(einstein, ulm)


# Aggiunti il 25 settembre, DURANTE la cura della provenienza (§14.6): non
# fissati prima. Il primo era rosso nella prova di persistenza (make chat).
[mock live]
!set PARROT0_SESSION=
!set PARROT0_PROFILE=kb/profiles/agi.p0
!set PARROT0_LANG=en
!reset

[test il controesempio letto col ponte non nega il fatto vero]
!timeout 0
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> Marie Curie was born in Warsaw, but Warsaw is not her Geburtsort.
!query contact_counter(geburtsort, born_in, $E)
!query read_support(fact(born_in, marie_curie, warsaw, neg), hypothesis(geburtsort, born_in))
!query! read_support(fact(born_in, marie_curie, warsaw, pos), $V)
!query born_in(marie_curie, warsaw)
> Where was Marie Curie born?
<~ arsaw

[test un fatto gia noto ripetuto con la parola nuova non dipende da lei]
!timeout 0
!reset
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> The Geburtsort of Napoleon is Ajaccio.
!query! read_support(fact(born_in, napoleon, ajaccio, pos), $V)
!assert contact_bridge_withdrawn(geburtsort, born_in)
!query born_in(napoleon, ajaccio)

[test un atto diretto tiene in vita il fatto letto col ponte]
!timeout 0
!reset
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> The Geburtsort of Kant is Konigsberg.
> Kant was born in Konigsberg.
!query read_support(fact(born_in, kant, konigsberg, pos), hypothesis(geburtsort, born_in))
!query read_support(fact(born_in, kant, konigsberg, pos), direct)
!assert contact_bridge_withdrawn(geburtsort, born_in)
!query born_in(kant, konigsberg)

# §19.3 — «perche' non lo sai piu'?» (25 settembre, scritti con la cura)
[test il fatto sospeso dice perche: controesempio, e la maniglia lo ridà]
!timeout 0
!reset
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> The Geburtsort of Kant is Konigsberg.
> Marie Curie was born in Warsaw, but Warsaw is not her Geburtsort.
> Where was Kant born?
<~ I no longer hold «kant was born in konigsberg»
<~ only through «geburtsort»
<~ counterexample: «marie curie was born in warsaw»
<! I don't understand
> What is the Geburtsort of Kant?
<~ I no longer hold
> Where was Einstein born?
<~ ulm
<! no longer
> Kant was born in Konigsberg.
> Where was Kant born?
<~ konigsberg
<! no longer

[test il fatto sospeso dice perche: letture concorrenti]
!timeout 0
!reset
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> The Geburtsort of Kant is Konigsberg.
> Steel is made of iron, so iron is its Geburtsort.
> Where was Kant born?
<~ competing readings
<~ tell me in other words

[test la parola che non legge piu dice perche, e come chiedere]
!timeout 0
!reset
> Einstein was born in Ulm, so his Geburtsort is Ulm.
> Marie Curie was born in Warsaw, but Warsaw is not her Geburtsort.
> What is the Geburtsort of Napoleon?
<~ I no longer read «geburtsort» as «was born in»
<~ counterexample
<~ ask me with «was born in»
<! ajaccio
> Where was Napoleon born?
<~ jaccio
