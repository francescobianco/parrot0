# Gen446 — il medesimo stato KB attraversa dialogo, crescita e piano.

[mock core]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=docs/labs/autocrescita-v3/gen446-state-cycle.p0
!set PARROT0_WORLD_FACTS=0
!set PARROT0_LANG=en
!reset

[ciclo pronto]
!query campaign_promote(campaign_alpha, claim_1, learned_surface)
!query compensation_plan_complete(plan_alpha)
!query live_cycle(cycle_alpha, ask_clarification, campaign_alpha, plan_alpha)
!query live_cycle_ready(cycle_alpha)
!query live_cycle_language(cycle_alpha, it, en, it)

[ablazione della crescita spegne il ciclo]
!forget campaign_replay(campaign_alpha, claim_1, learned_surface)
!query! campaign_promote(campaign_alpha, claim_1, learned_surface)
!query! live_cycle_ready(cycle_alpha)
