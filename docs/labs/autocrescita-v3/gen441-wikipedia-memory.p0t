# GEN441 — WIKIPEDIA MIRATA IN MEMORIA, NON DEPOSITO OPACO.

[mock core]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=docs/labs/autocrescita-v3/gen441-wikipedia-memory.p0
!set PARROT0_WORLD_FACTS=0
!set PARROT0_LANG=it
!reset

[test source selection preserves provenance and replays only requested frame]
!query source_candidate(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), height, measure, 1200)
!query source_supported(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), height, measure, 1200)
!query source_replay(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), height, measure, 1200)
!query source_provenance(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), range(10, 18), en)
!query! source_replay(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), climate, summary, irrelevant)

[test unsupported frame never replays]
!query! source_supported(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), mass, measure, 80)
!query! source_replay(address(en, wikipedia, "Blue Mountain", revision(20260827, geography)), mass, measure, 80)
