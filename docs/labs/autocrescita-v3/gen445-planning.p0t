# Gen445 — prova del planner con fonte, azione informativa e replanning.

[mock core]
!set PARROT0_BASE=kb/core/base.p0
!set PARROT0_SESSION=
!set PARROT0_PROFILE=docs/labs/autocrescita-v3/gen445-planning.p0
!set PARROT0_WORLD_FACTS=0
!set PARROT0_LANG=it
!reset

[fonte e piano multilingue]
!query source_address(water_gate, address(en, wikipedia, "Water_gate", revision(2026, operation)))
!query source_candidate(address(en, wikipedia, "Water_gate", revision(2026, operation)), causal, gate_open, source_read)
!query source_replay(address(en, wikipedia, "Water_gate", revision(2026, operation)), causal, gate_open, source_read)
!query compensation_plan(445_water, goal(level, safe), $Plan)
!query compensation_plan_step(445_water, 1, step(read_source, unknown, source_read, meta(1, wikipedia_revision(2026, water_gate))))
!query compensation_plan_step(445_water, 2, step(open_gate, source_read, level_safe, meta(2, local)))

[replanning dopo ritiro del passo]
!query compensation_plan_complete(445_blocked)
!forget compensation_step(445_blocked, 2, step(open_gate, source_read, level_safe, 2))
!query! compensation_plan_complete(445_blocked)
!query compensation_stop(445_blocked, missing_dependency(1, 2))
!query compensation_alternative_valid(445_blocked, 445_fallback, goal(level, safe))

[seconda famiglia: piano naturale senza riusare il dominio scacchi]
% Il planner riceve una richiesta conversazionale in italiano. Il dominio
% job_onboarding viene scelto soltanto da goal_cue/2 nella KB e attraversa la
% stessa macchina causale: nessun ramo C conosce "lavoro" o i nomi dei passi.
> fai un piano per iniziare un nuovo lavoro
< Il mio piano derivato per job onboarding: [costo totale 6, tempo totale 2w] 1) apprendere aspettative e criteri di successo del gruppo [needs role_offer]; 2) mantenere piccoli impegni e registrarne i risultati [needs expectations_known]; 3) costruire fiducia comunicando chiaramente e mantenendo continuità [needs reliable_record].

[fonte interlinguistica: dialogo italiano, sorgente inglese]
% Il piano è richiesto in italiano ma l'azione informativa conserva la fonte
% Wikipedia inglese. Il renderer non traduce né perde la genealogia della
% proposizione: la lingua del turno e quella della fonte sono coordinate diverse.
!query action_source(read_wikipedia, wikipedia)
!query action_source(check_claim, wikipedia)
> fai un piano per rispondere con fonti
< Il mio piano derivato per grounded answer: 1) leggere la voce Wikipedia pertinente e conservarne lo span citato [wikipedia] [needs topic_question]; 2) riprodurre la claim contro la domanda e lo span della fonte [wikipedia] [needs source_notes]; 3) comporre la risposta con provenienza e incertezza [needs checked_claim].

[replica della stessa macchina in inglese]
!query plan_goal(job_onboarding, trusted_contributor)
!query plan_budget(job_onboarding, 6, 2w)
!query compensation_plan_same_semantics(onboarding_it, onboarding_en)
> make a plan to start a new job
< My derived plan for job onboarding: [total cost 6, total time 2w] 1) learn the team's expectations and success criteria [needs role_offer]; 2) complete small commitments reliably and record the results [needs expectations_known]; 3) build trust by communicating clearly and delivering consistently [needs reliable_record].
